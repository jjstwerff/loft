// fizzbuzz.loft — the classic interview puzzle.
//
// For each number from 1 to 20: print "Fizz" if divisible by 3,
// "Buzz" if divisible by 5, "FizzBuzz" if divisible by both, and
// the number otherwise.
//
// Demonstrates: `for x in 1..=N` range iteration, `if`/`else if`
// chains, the `%` modulo operator, string interpolation.

fn main() {
  for n in 1..=20 {
    if n % 15 == 0 {
      print("FizzBuzz\n");
    } else if n % 3 == 0 {
      print("Fizz\n");
    } else if n % 5 == 0 {
      print("Buzz\n");
    } else {
      print("{n}\n");
    }
  }
}
