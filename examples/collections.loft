// collections.loft — vector + hash side-by-side.
//
// Demonstrates: `vector<T>` literals + iteration, `hash<T[key]>`
// lookup, and the same records held in both views.  The empty
// collection literal is `[]` (NOT `{}` — that is an empty block).
//
// The hash key (`text`) must be UNIQUE across the records — a hash holds
// one record per key, so feed it distinct keys.

struct Word {
  text: text,
  count: integer,
}

struct Counter {
  // A vector preserves insertion order.
  ordered: vector<Word>,
  // A hash gives O(1) lookup by the `text` field.
  by_text: hash<Word[text]>,
}

fn main() {
  c = Counter { ordered: [], by_text: [] };
  // Add three words with distinct keys; both views hold the records.
  for w in [Word { text: "apple", count: 3 },
            Word { text: "banana", count: 5 },
            Word { text: "cherry", count: 2 }] {
    c.ordered += [w];
    c.by_text += w;
  }
  // Vector iteration walks in insertion order.
  print("In insertion order:\n");
  for entry in c.ordered {
    print("  {entry.text} (count {entry.count})\n");
  }
  // Hash lookup is by key — `by_text["banana"]` is O(1).
  print("Hash lookup of 'banana': count {c.by_text[\"banana\"].count}\n");
}
