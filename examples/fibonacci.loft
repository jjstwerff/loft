// fibonacci.loft — recursive and iterative fibonacci side-by-side.
//
// Demonstrates: function declarations, recursion, while loops, and
// the `assert` builtin (used here to confirm both definitions agree).

fn fib_recursive(n: integer) -> integer {
  if n < 2 { n } else { fib_recursive(n - 1) + fib_recursive(n - 2) }
}

fn fib_iterative(n: integer) -> integer {
  a = 0;
  b = 1;
  i = 0;
  while i < n {
    next = a + b;
    a = b;
    b = next;
    i += 1;
  }
  a
}

fn main() {
  // Print the first ten Fibonacci numbers.
  i = 0;
  while i < 10 {
    print("{fib_iterative(i)} ");
    i += 1;
  }
  print("\n");
  // Cross-check: the two definitions agree on small inputs.
  i = 0;
  while i < 10 {
    assert(fib_recursive(i) == fib_iterative(i), "fib mismatch at {i}");
    i += 1;
  }
}
