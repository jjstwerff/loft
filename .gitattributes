# Enforce LF line endings for all text files so that include_str! returns \n
# on every platform and loft --format-check is stable across OSes.
* text=auto eol=lf
*.loft text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Tell GitHub Linguist to render `.loft` files using Rust syntax
# highlighting on the web UI.  Loft is Rust-influenced enough that
# Rust highlighting covers ~80% of the syntax correctly (keywords,
# comments, strings, doc comments, struct/enum/fn/match constructs).
# The remaining mismatches (`text`/`integer` types render as
# identifiers, `not null` modifier and `#rust"..."` annotations
# render as strings, string interpolation `{expr}` doesn't nest)
# are visually minor.
#
# Real GitHub-wide highlighting needs an upstream contribution to
# `github-linguist/linguist` adding loft as a first-class language;
# Linguist's policy requires ~200 public repos using the language
# before they accept new entries.  When loft hits that adoption
# threshold (post-0.9.0 / 1.0.0) we can submit the PR and remove
# this override.
*.loft linguist-language=Rust

# Mark auto-generated and vendored content so it doesn't skew the
# repository's language-statistics bar at the top of the GitHub page.
# `linguist-generated=true` excludes from stats AND collapses by
# default in PR diffs (good for noisy generated content); `linguist-
# documentation=true` excludes from stats but keeps searchable.

# Auto-generated test artefacts
tests/dumps/**       linguist-generated=true
tests/generated/**   linguist-generated=true

# Lock files
*.lock               linguist-generated=true

# wasm-pack build output checked in for GitHub Pages deploy
doc/pkg/**           linguist-generated=true

# Documentation
doc/**.md            linguist-documentation=true
*.md                 linguist-documentation=true

# JSON / YAML grammar files are tooling, not application content
syntaxes/**.json     linguist-detectable=false
editors/**.json      linguist-detectable=false
