#
# Issue-trailer check.  `fixed-pending-merge` is applied by a push workflow that reads
# `Fixes|Closes|Resolves #N` out of the commit message, so an issue referenced any other
# way is fixed on a branch and never labelled — invisible to anyone reading the tracker.
#
# The rule was already in CLAUDE.md, ISSUE_TRACKING.md and two skills when a session
# shipped three fixes under `Refs #N` anyway: prose does not fire at the moment you type
# the message.  This does.
#
# It never BLOCKS.  It cannot tell a fix from a mention — a commit may legitimately
# discuss an issue it does not resolve (this hook's own commit does) — and per the
# repo's two-tier rule a diagnostic gates only when ignoring it yields a wrong result.
# So it reports, and the choice stays the author's.
#
# Install: `make hooks` (sets core.hooksPath).

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# Strip comments and the diff `git commit -v` appends.
body=$(sed -e '/^#/d' -e '/^diff --git /,$d' "$msg_file")

# `@`-prefixed tracker tags (@P259, @PLN3) are deliberately not `#`, so `#N` is
# unambiguously a GitHub issue reference.
mentions=$(printf '%s' "$body" | grep -oE '#[0-9]+' | tr -d '#' | sort -u)
[ -n "$mentions" ] || exit 0

closes=$(printf '%s' "$body" | grep -oiE '\<(fixes|closes|resolves) #[0-9]+' | grep -oE '[0-9]+' | sort -u)
refs=$(printf '%s' "$body" | grep -oiE '\<refs #[0-9]+' | grep -oE '[0-9]+' | sort -u)

bare=""
deliberate=""
for n in $mentions; do
  if printf '%s\n' $closes | grep -qx "$n"; then continue; fi
  if printf '%s\n' $refs | grep -qx "$n"; then deliberate="$deliberate $n"; continue; fi
  bare="$bare $n"
done

if [ -n "$bare" ]; then
  echo "commit-msg: issue mention with no trailer:$bare" >&2
  echo "  Add \`Fixes #N\` if this commit resolves it (the push workflow labels it" >&2
  echo "  fixed-pending-merge), or \`Refs #N\` if it deliberately does not." >&2
fi

if [ -n "$deliberate" ]; then
  echo "commit-msg: using \`Refs\` for:$deliberate — these stay UNLABELLED." >&2
  echo "  That is right only if the issue is not fully resolved here.  If it is," >&2
  echo "  amend to \`Fixes #N\` so it gets fixed-pending-merge and closes on merge." >&2
fi

# The `contract:` axis (.github/LABELS.md) records whether closing a bug had to MOVE the
# written standard.  That is not knowable when the bug is filed — it is what the fix turned
# out to need — so the one moment it can be written is this one, in the commit that says
# `Fixes #N`.  Ask for it HERE for the same reason the check above exists: prose in four
# documents does not fire at the moment you type the message.
#
# Reports, never blocks — a judgement the author has not made yet is not a wrong result,
# and an unjudged issue is counted as unjudged rather than guessed (the axis says absence
# means NOT JUDGED, never "settled").
if [ -n "$closes" ] && ! printf '%s' "$body" | grep -qiE '^[[:space:]]*Contract:[[:space:]]*(settled|strained)\>'; then
  echo "commit-msg: \`Fixes #\` with no \`Contract:\` trailer — this fix is counted UNJUDGED." >&2
  echo "  Add \`Contract: settled — <why>\` if the formal rules and existing tests already" >&2
  echo "  gave the right answer and the fix just makes that promise hold; \`Contract: strained" >&2
  echo "  — <why>\` if closing it extended a rule, changed a documented surface, or needed a" >&2
  echo "  design call.  It is the convergence statistic the contract-1 decision reads." >&2
fi

exit 0
