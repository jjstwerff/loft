//
// GOLDEN FIXTURE (not a gallery example — no NN- prefix).  Pins ONE library
// part in isolation: the Canvas integer pixel buffer + `save_png` round-trip
// (0xAARRGGBB).  A 16×16 image with a handful of exactly-known pixels and one
// filled block; the gold test compares at max_abs=0 (exact), so any
// truncation / sign / stride regression in the pixel-storage or encode path
// changes a pixel and fails — independent of any other drawing primitive.
// Headless, deterministic — software rasterizer only, no GL.
use graphics;

fn main() {
  cv = graphics::canvas(16, 16, 0xFF101018);   // opaque dark background
  cv.fill_rect(4, 4, 8, 8, 0xFF808040);        // a known olive block
  cv.set_pixel(0, 0, 0xFFFF0000);              // red   corner
  cv.set_pixel(15, 0, 0xFF00FF00);             // green corner
  cv.set_pixel(0, 15, 0xFF0000FF);             // blue  corner
  cv.set_pixel(15, 15, 0xFFFFFFFF);            // white corner
  cv.set_pixel(8, 8, 0xFF00FFEE);              // cyan, inside the block
  if !graphics::save_png(cv, "gold-pixels.png") {
    println("gold-pixels: save_png FAILED");
  }
}
