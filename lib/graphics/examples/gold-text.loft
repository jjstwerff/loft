//
// GOLDEN FIXTURE — pins the text path in isolation: `gl_load_font` +
// `draw_text` (font rasterize + glyph placement → Canvas → save_png).  The
// gold test copies DejaVuSans-Bold.ttf into the run dir so the bare relative
// path resolves.  Small tolerance (font AA is float-ish), not exact.
use graphics;
fn main() {
  cv = graphics::canvas(96, 32, 0xFF101018);
  font = graphics::gl_load_font("DejaVuSans-Bold.ttf");
  if font < 0 {
    println("gold-text: font load FAILED");
    return;
  }
  cv.draw_text(font, "Ag1", 22.0, 4, 4, 0xFFE0E0F0);
  if !graphics::save_png(cv, "gold-text.png") { println("gold-text: save FAILED"); }
}
