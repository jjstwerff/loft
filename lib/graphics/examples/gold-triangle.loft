// GOLDEN FIXTURE — pins `fill_triangle` (scanline; the fill the crystal CANVAS
// render uses) in isolation.  Exact (max_abs=0).  Headless.
use graphics;
fn main() {
  cv = graphics::canvas(32, 32, 0xFF101018);
  cv.fill_triangle(16, 3, 3, 28, 29, 28, 0xFF30C0A0);
  if !graphics::save_png(cv, "gold-triangle.png") { println("gold-triangle: save FAILED"); }
}
