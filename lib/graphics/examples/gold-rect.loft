// GOLDEN FIXTURE — pins `fill_rect` in isolation (solid-fill bounds + colour).
// Exact (max_abs=0).  Headless software rasterizer.
use graphics;
fn main() {
  cv = graphics::canvas(32, 32, 0xFF101018);
  cv.fill_rect(2, 2, 10, 6, 0xFFCC4040);
  cv.fill_rect(14, 8, 12, 16, 0xFF40CC60);
  cv.fill_rect(20, 2, 8, 8, 0xFF4060CC);
  if !graphics::save_png(cv, "gold-rect.png") { println("gold-rect: save FAILED"); }
}
