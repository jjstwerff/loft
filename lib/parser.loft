use lexer;
use logger;
use code;
struct SourceFile {
  path: text,
  done: boolean
}

struct Operator {
  op: text,
  prio: u16
}

struct Parser {
  file: vector < SourceFile >,
  lexer: lexer::Lexer,
  log: logger::Log,
  code: code::Code,
  cur_file: integer = 0,
  operators: hash < Operator[op] >
}

struct FormatSpec {
  token: text = "0",
  special_layout: boolean,
  dir: i16 = 2,
  plus: boolean,
  is_float: boolean,
  radix: u8 = 10,
  size: i8 = -1,
  decimals: i8 = -1
}

// Parse `s` as a Loft source file named `name`, and answer how many errors it
// contained — `0` for a snippet that parsed cleanly.
//
// The count is the only thing a caller can check: parsing writes its diagnostics to
// the log as it goes, and the parser itself is internal.  Returning it is what lets a
// caller (or a doc page) assert that a snippet is valid rather than merely watch the
// call not crash.
// Example: @PAR-001
pub fn parse(name: text, s: text) -> integer {
  p = Parser { };
  p.operators =[
 {op: "*", prio: 1 }, {op: "/", prio: 1 }, {op: "%", prio: 1 },
 {op: "+", prio: 2 }, {op: "-", prio: 2 },
 {op: "<<", prio: 3 }, {op: ">>", prio: 3 }, {op: ">>>", prio: 3 },
 {op: "&", prio: 4 },
 {op: "^", prio: 5 },
 {op: "|", prio: 6 },
 {op: "==", prio: 7 }, {op: "!=", prio: 7 },
 {op: "<", prio: 7 }, {op: "<=", prio: 7 }, {op: ">", prio: 7 }, {op: ">=", prio: 7 },
 {op: "&&", prio: 8 }, {op: "and", prio: 8 },
 {op: "||", prio: 9 }, {op: "or", prio: 9 },
 {op: "??", prio: 10 },
 {op: "..", prio: 11 }, {op: "..=", prio: 11 },
 {op: "=", prio: 12 }, {op: "+=", prio: 12 }, {op: "-=", prio: 12 },
 {op: "*=", prio: 12 }, {op: "/=", prio: 12 }, {op: "%=", prio: 12 }
  ];
  // `??` is the LOOSEST binary operator in Loft (@FR-G-Prec, @FR-G-Post-Default): a
  // default-fallback binds after everything it might supply a default for, so it sits
  // one step looser than `||`.  Listing it as a TOKEN is what makes @FR-G-Lex-Coal hold
  // — the scanner prefers the longest token starting with `?`, so a `??` never arrives
  // as two `?`, and the postfix `?` in `suffixes` cannot claim half of one.
  p.lexer.set_tokens(["+=", "*=", "-=", "<=", ">=", "!=", "==", ">>", "<<", "->", "=>", ">>>", "..", "..=", "&&", "||", "??"]);
  p.lexer.set_keywords([
  "for", "in", "if", "else", "fn", "pub", "use", "struct", "enum", "match", "and", "or", "true", "false", "null"
  ]);
  p.lexer.parse_file("default/01_code.lav");
  p.cur_file += 1;
  parse_file(p);
  p.lexer.parse_string(name, s);
  p.cur_file += 1;
  parse_file(p);
  p.log.errors
}
// <file> ::= { 'use' <identifier> ';' } { 'pub' ( <structure> | <def_enumerate> | <def_type> | <function> | <constant> ) }

fn parse_file(self: Parser) {
  for u in 0..100 {
    if !self.lexer.matches("use") {
      u# break;
    }
    self.lexer.identifier();
    self.expect(";");
  }
  for x in 0..1000 {
    if self.log.level == Fatal {
      x# break;
    }
    at = self.lexer.offset();
    public = self.lexer.matches("pub");
    if self.structure(public) {
      x# continue;
    }
    if self.def_enumerate(public) {
      x# continue;
    }
    if self.def_type(public) {
      x# continue;
    }
    if self.function(public) {
      x# continue;
    }
    if self.constant(public) {
      x# continue;
    }
    // Nothing here is a definition.  Without this the loop turned a thousand times over
    // the same token and answered `0` errors for a file it never read.
    if self.stalled(at) {
      x# break;
    }
  }
}
// <structure> :: 'struct' <identifier> '{' { <identifier> ':' <type> [ '=' <value> ] [ ',' ] } '}'

fn structure(self: Parser, public: boolean) -> boolean {
  if !self.lexer.matches("struct") {
    return false;
  }
  id = self.lexer.identifier();
  struct_nr = self.code.define(public, id, code::Struct, (self.cur_file & 65535) as u16, self.lexer.get_line() as i32);
  self.expect("{{");
  for parameter in 0..256 {
    if self.lexer.test("}}") {
      parameter# break;
    }
    at = self.lexer.offset();
    arg = self.lexer.identifier();
    self.expect(":");
    self.type_def(true);
    self.code.cur_def = struct_nr;
    self.code.argument(arg, 0);
    if self.lexer.matches("=") {
      self.value();
    }
    self.lexer.matches(",");
    if self.stalled(at) {
      parameter# break;
    }
  }
  self.expect("}}");
  true
}
// <def_enumerate> :: 'enum' <identifier> '{' { <identifier> [ '{' { <identifier> ':' <type> [ '=' <value ] [ ',' ] } '}' ] [ ',' ] } '}'

fn def_enumerate(self: Parser, _public: boolean) -> boolean {
  if !self.lexer.matches("enum") {
    return false;
  }
  self.lexer.identifier();
  self.expect("{{");
  for parameter in 0..256 {
    at_variant = self.lexer.offset();
    self.lexer.identifier();
    if self.lexer.matches("{{") {
      for field in 0..256 {
        at = self.lexer.offset();
        self.lexer.identifier();
        self.expect(":");
        self.type_def(true);
        if self.lexer.matches("=") {
          self.value();
        }
        // Loft separates enum-variant fields with `,`, exactly as it separates struct
        // fields — see `structure` above.  Accepting only `;` meant a variant with a
        // SECOND field never parsed: `Rectangle {{ w: float, h: float }}` stopped at the
        // comma.  The page documenting this rule claimed struct variants were
        // recognised and asserted nothing, so the claim went unchecked (@PLN121 E2).
        if self.lexer.matches(",") || self.lexer.matches(";") {
          field# continue;
        }
        if self.lexer.test("}}") {
          field# break;
        }
        if self.stalled(at) {
          field# break;
        }
      }
      self.expect("}}");
    }
    if !self.lexer.matches(",") {
      parameter# break;
    }
    if self.lexer.test("}}") {
      parameter# break;
    }
    if self.stalled(at_variant) {
      parameter# break;
    }
  }
  self.expect("}}");
  true
}
// <def_type> :: 'type' <identifier> '=' <type_def> [ 'size' '(' <integer> ')' ]

fn def_type(self: Parser, _public: boolean) -> boolean {
  if !self.lexer.matches("type") {
    return false;
  }
  self.lexer.identifier();
  if self.lexer.matches("=") {
    self.type_def(false);
  }
  if self.lexer.matches("size") {
    self.expect("(");
    self.lexer.int();
    self.expect(")");
  }
  self.expect(";");
  true
}
// <function> ::= 'fn' <identifier> '(' { <parameter> [ ',' ] } ')' [ '->' <type_def> ] <block>

// @LEX-001 — drive a grammar rule off the lexer cursor: matches() consumes a
// token only when it equals the argument (gate the rule on `matches("fn")`),
// test() checks WITHOUT consuming (peek for `)` to spot an empty list), and
// identifier() takes the next name. matches vs test is the distinction to get
// right — one advances, one does not.
fn function(self: Parser, _public: boolean) -> boolean {
  if !self.lexer.matches("fn") {
    return false;
  }
  self.lexer.identifier();
  self.expect("(");
  for parameter in 0..256 {
    if self.lexer.test(")") {
      parameter# break;
    }
    self.parameter();
    if !self.lexer.matches(",") {
      parameter# break;
    }
  }
  self.expect(")");
  if self.lexer.matches("->") {
    self.type_def(false);
  }
  if self.lexer.matches(";") {
    if self.lexer.matches("#") && self.lexer.matches("rust") {
      self.lexer.constant_text();
    }
  } else {
    self.block();
  }
  true
}
// <block> ::= '{' { ( <for_statement> | <return_statement> | <expression> ) [ ';' ] } '}'

fn block(self: Parser) -> boolean {
  if !self.lexer.matches("{{") {
    return false;
  }
  for statement in 0..10000 {
    if self.log.level == Fatal {
      statement# break;
    }
    at = self.lexer.offset();
    // A statement that ends in its own BLOCK carries no trailing `;` — `for i in xs {{
    // … }}` is complete at its closing brace.  Demanding one broke the enclosing block
    // out of its loop, so the tail expression after a `for` was never read and the body
    // failed with `Expected }`: `fn sum(n) {{ t = 0; for i in 1..=n {{ … }} t }}` did
    // not parse (@PLN121 E2 — the page claiming it did asserted nothing).
    block_ended = self.for_statement();
    if !block_ended and !self.return_statement() {
      self.expression();
    }
    // The closing brace is tested on BOTH sides of the separator, because a body can
    // end either way and each test alone breaks the other: before it, so a TAIL
    // EXPRESSION (`… ; t }}`) ends the block; after it, so a trailing SEMICOLON
    // (`… t = 0; }}`) does too.  Checking only after loses the tail; only before runs
    // `expression()` on the closing brace itself.
    if self.lexer.test("}}") {
      statement# break;
    }
    if !block_ended and !self.lexer.matches(";") {
      statement# break;
    }
    if self.lexer.test("}}") {
      statement# break;
    }
    if self.stalled(at) {
      statement# break;
    }
  }
  self.expect("}}");
  true
}
// <for_statement> :: = 'for' <identifier> 'in' <expression> <block>

fn for_statement(self: Parser) -> boolean {
  if !self.lexer.matches("for") {
    return false;
  }
  self.lexer.identifier();
  self.lexer.matches("in");
  self.expression();
  self.block();
  true
}
// <return_statement> :: 'return' [ <expression> ]

fn return_statement(self: Parser) -> boolean {
  if !self.lexer.matches("return") {
    return false;
  }
  self.expression();
  true
}
// <expression> ::= <list> | <if_statement> | <object> | <block> | <do_operators>

fn expression(self: Parser) -> boolean {
  t = self.list();
  if t {
    return true;
  }
  t = self.if_statement();
  if t {
    return true;
  }
  t = self.object();
  if t {
    return true;
  }
  t = self.block();
  if t {
    return true;
  }
  self.do_operators()
}
// <list> ::= '[' ( <for_list> | { <expression> [ ',' ] } [ ';' <expression> ] ) ']'

fn list(self: Parser) -> boolean {
  if !self.lexer.matches("[") {
    return false;
  }
  l = self.for_list();
  if l {
    self.expect("]");
    return true;
  }
  for element in 0..10000 {
    if self.lexer.test("]") || self.lexer.test(";") {
      element# break;
    }
    at = self.lexer.offset();
    l = self.expression();
    if self.lexer.matches(",") {
      element# continue;
    }
    if self.stalled(at) {
      element# break;
    }
  }
  if self.lexer.matches(";") {
    self.expression();
  }
  self.expect("]");
  true
}
// <for_list> ::= 'for' <identifier> 'in' <expression> <block>

fn for_list(self: Parser) -> boolean {
  if !self.lexer.matches("for") {
    return false;
  }
  self.lexer.identifier();
  self.lexer.matches("in");
  self.expression();
  self.block();
  true
}
// <if_statement> ::= 'if' <expression> <block> [ 'else' <block> ]

fn if_statement(self: Parser) -> boolean {
  if !self.lexer.matches("if") {
    return false;
  }
  self.expression();
  self.block();
  if self.lexer.matches("else") {
    self.block();
  }
  true
}
// <object> ::= '{' { <identifier> ':' <expression> [ ';' ] } '}'

// @LEX-002 — speculative parse with backtracking: anchor() captures the cursor
// BEFORE an ambiguous rule is attempted, and revert() rewinds to that exact spot
// when the shape turns out not to match, so another rule can retry the same
// tokens. Here `{ … }` is attempted as an object literal; the instant a field
// fails to be `identifier ':'`, revert(before) unwinds every token consumed and
// object() reports no match, leaving the block for a different rule to claim.
fn object(self: Parser) -> boolean {
  before = self.lexer.anchor();
  if !self.lexer.matches("{{") {
    return false;
  }
  for field in 0..255 {
    i = self.lexer.identifier();
    if !i or !self.lexer.matches(":") {
      self.lexer.revert(before);
      return false;
    }
    self.expression();
    if !self.lexer.matches(",") {
      field# break;
    }
    if self.lexer.test("}}") {
      field# break;
    }
  }
  self.expect("}}");
  true
}
// <do_operators> ::= <single_part> [ 'as' <type> ] { <operator> <single_part> [ 'as' <type> ] }

fn do_operators(self: Parser) -> boolean {
  if !self.single_part() {
    return false;
  }
  if self.lexer.matches("as") {
    self.type_def(false);
  }
  for do in 0..255 {
    o = self.operators[self.lexer.peek()];
    if !o {
      do# break;
    }
    // CONSUME the operator before reading the right operand.  `peek` only looks — it is
    // `matches` that advances — so without this the operator token was still current
    // when `single_part` ran, and `single_part` tried to read `=` (or `+`, or `==`) as a
    // value.  The effect was that NO binary operator parsed at all: `t = 0`, `t += 1`,
    // `t == 0` and `t + 1` each failed at the operator, while a bare `t;` was fine
    // (loft#1092).
    self.lexer.matches(o.op);
    self.single_part();
    if self.lexer.matches("as") {
      self.type_def(false);
    }
  }
  true
}
// <single_part> ::= [ '-' | '!' ] ('(' <expression> ')' | <id> | <value>) <suffixes>

fn single_part(self: Parser) -> boolean {
  if self.lexer.matches("-") {
  } else if self.lexer.matches("!") {
  }
  if self.lexer.matches("(") {
    self.expression();
    self.expect(")");
  } else if !self.id() {
    self.value();
  }
  self.suffixes();
  true
}
// <suffixes> ::= { <fn_call> | <field> | <index> | '?' }

// The postfix chain a PRIMARY carries: a call, a field, an index, and the
// default-discharge `?`.  @FR-G-Post-Default puts `?` here rather than on the operator
// ladder — it binds tighter than every binary operator, alongside `.` and `[]`, and the
// four chain left to right, so `points[i]?.x` reads as `((points[i])?).x`.
//
// One home for all four, because the chain is the same whichever primary it follows:
// `(a + b).x`, `name[0]` and `"abc".len()` are all Loft.

fn suffixes(self: Parser) {
  for part in 0..255 {
    if self.fn_call() {
      part# continue;
    }
    if self.field() {
      part# continue;
    }
    if self.index_def() {
      part# continue;
    }
    if self.lexer.matches("?") {
      part# continue;
    }
    part# break;
  }
}
// <id> ::= <identifier> [ '#' ( 'break' | 'continue' | 'count' | 'index' ) | <object> ]

fn id(self: Parser) -> boolean {
  name = self.lexer.identifier();
  if !name {
    return false;
  }
  if self.lexer.matches("#") {
    if self.lexer.matches("break") {
      return true;
    }
    if self.lexer.matches("continue") {
      return true;
    }
    if self.lexer.matches("count") {
      return true;
    }
    if self.lexer.matches("index") {
      return true;
    }
  } else {
    self.object();
  }
  true
}
// <fn_call> ::= '(' { <expression> [ ',' ] } ')'

fn fn_call(self: Parser) -> boolean {
  if !self.lexer.matches("(") {
    return false;
  }
  for argument in 0..255 {
    if self.lexer.test(")") {
      argument# break;
    }
    at = self.lexer.offset();
    self.expression();
    if !self.lexer.matches(",") {
      argument# break;
    }
    if self.stalled(at) {
      argument# break;
    }
  }
  self.expect(")");
  true
}
// <field> ::= '.' <identifier>

fn field(self: Parser) -> boolean {
  if !self.lexer.matches(".") {
    return false;
  }
  self.lexer.identifier();
  true
}
// <index> ::= '[' { <expression> [ ',' ] } ']'

fn index_def(self: Parser) -> boolean {
  if !self.lexer.matches("[") {
    return false;
  }
  for key in 0..255 {
    at = self.lexer.offset();
    self.expression();
    if !self.lexer.matches(",") {
      key# break;
    }
    if self.lexer.test("]") {
      key# break;
    }
    if self.stalled(at) {
      key# break;
    }
  }
  self.expect("]");
  true
}
// <constant> :: <identifier> '=' <expression> ';'

fn constant(self: Parser, _public: boolean) -> boolean {
  n = self.lexer.identifier();
  if !n {
    return false;
  }
  self.expect("=");
  self.expression();
  self.expect(";");
  true
}
// <parameter> ::= <identifier> ':' [ 'const' | '&' ] <type> [ '=' <value> ]

fn parameter(self: Parser) {
  p = self.lexer.identifier();
  self.expect(":");
  if self.lexer.matches("const") {
  }
  self.lexer.matches("&");
  self.type_def(false);
  if self.lexer.matches("=") {
    self.value();
  }
}
// <type_def> ::= <identifier> [ '<' { <type_def> [ '[' { [ '-' ] <identifier> [ ',' ] } ']'] [ ',' ] } '>' ] [ 'limit' '(' { <integer> [ ',' ] } ')' ]

// The `[a, -b]` key list a keyed collection's element type carries: `hash<P[a,b]>`,
// `sorted<P[-a]>`.  It contributes two things at once — a fragment of the type id, which it
// answers, and the field names the definition is built from, which it appends to `flds`.
// Absent, it answers the empty fragment and leaves `flds` alone.

fn key_fields(self: Parser, flds: &vector<text>) -> text {
  if !self.lexer.matches("[") {
    return "";
  }
  id = "[";
  for field in 0..256 {
    at = self.lexer.offset();
    desc = self.lexer.matches("-");
    f = "";
    if desc {
      f = "-";
    }
    f += self.lexer.identifier() ?? "";
    id += f;
    flds +=[f];
    if !self.lexer.matches(",") {
      field# break;
    }
    id += ",";
    if self.stalled(at) {
      field# break;
    }
  }
  self.expect("]");
  id += "]";
  id
}

fn type_def(self: Parser, define: boolean) -> u16 {
  id = self.lexer.identifier() ?? "";
  parameters =[];
  flds: vector<text> = [];
  if self.lexer.matches("<") {
    id += "<";
    for parameter in 0..256 {
      at = self.lexer.offset();
      p = self.type_def(false);
      parameters +=[p];
      id += self.code.type_name(p) ?? "";
      id += self.key_fields(flds);
      if !self.lexer.matches(",") {
        parameter# break;
      }
      id += ",";
      if self.at_generic_close() {
        parameter# break;
      }
      if self.stalled(at) {
        parameter# break;
      }
    }
    self.close_generic();
    id += ">";
  }
  if self.lexer.matches("limit") {
    self.expect("(");
    from = self.lexer.int() ?? 0;
    self.expect(",");
    till = self.lexer.int() ?? 0;
    self.expect(")");
    id += "{from}..{till}";
  }
  // A trailing `?` makes the type NULLABLE, and `integer` and `integer?` are two
  // different types — so the `?` belongs in the id the code table is keyed by.  It
  // suffixes the whole type expression, which is why it is read after the generic
  // arguments and after the `limit` range rather than between them.
  if self.lexer.matches("?") {
    id += "?";
  }
  t = self.code.get_type(id);
  if !t && define {
    self.code.define(false, id, code::TypeDef, (self.cur_file & 65535) as u16, self.lexer.get_line() as i32);
    for param in parameters {
      self.code.field(null, param);
    }
    for fld in flds {
      self.code.field(fld, 65535);
    }
    self.code.finish_define();
    return self.code.get_type(id);
  }
  return t;
}
// <value> ::= 'true' | 'false' | 'null' | <integer> | <float> | <single> | <constant_text> [ <formatting> ] | <character>

// Is the cursor at the `>` that closes a generic argument list?
//
// Maximal munch scans the `>>` ending `vector<vector<integer>>` as the SHIFT token, so the
// closer is not always a token of its own.  This asks the question the grammar means, and
// `close_generic` consumes exactly one `>` whichever way the scanner read it.

fn at_generic_close(self: Parser) -> boolean {
  self.lexer.test(">") || self.lexer.test(">>") || self.lexer.test(">>>")
}
// Consume the single `>` that closes a generic argument list, splitting a `>>` or `>>>`
// token when maximal munch merged this closer with the next.  Reports through `expect` when
// there is no `>` here at all, so a genuinely malformed type still says so.

fn close_generic(self: Parser) {
  if !self.lexer.test(">") && self.at_generic_close() {
    self.lexer.split_token();
  }
  self.expect(">");
}

fn value(self: Parser) -> boolean {
  v = self.lexer.peek();
  // `true`, `false` and `null` are KEYWORDS, so `identifier()` refuses them and only this
  // arm can claim one.  Recognising is not enough — an unconsumed token leaves the
  // enclosing block re-reading it until the loop bound.
  if v == "true" || v == "false" || v == "null" {
    self.lexer.matches(v);
    return true;
  }
  if self.lexer.int() {
    return true;
  }
  if self.lexer.long_int() {
    return true;
  }
  if self.lexer.get_float() {
    return true;
  }
  if self.lexer.get_single() {
    return true;
  }
  if self.lexer.constant_text() {
    self.formatting();
    return true;
  }
  if self.lexer.constant_character() {
    return true;
  }
  false
}
// <formatting> :: { [ 'for' <id> 'in' <expression> [ 'if' <expression> ] | <expression> ] [ <flags> ] <constant_text> }

fn formatting(self: Parser) {
  for part in 0..256 {
    if !self.lexer.is_formatting() {
      return;
    }
    at = self.lexer.offset();
    self.lexer.set_formatting(false);
    if self.lexer.matches("for") {
      self.lexer.identifier();
      self.lexer.matches("in");
      self.expression();
      if self.lexer.matches("if") {
        self.expression();
      }
      self.block();
    } else {
      self.expression();
    }
    self.flags();
    self.lexer.set_formatting(true);
    // force scanning of the next constant text
    self.expect("}}");
    c = self.lexer.constant_text();
    if !c {
      return;
    }
    if self.stalled(at) {
      part# break;
    }
  }
}

fn flags(self: Parser) {
  format = FormatSpec { };
  if !self.lexer.matches(":") {
    return;
  }
  n = self.lexer.peek();
  if n == "0" or n == "-" or n == "_" or n == "^" {
    format.token = n;
  }
  if self.lexer.matches("<") {
    format.dir = -1;
  } else if self.lexer.matches(">") {
    format.dir = 1;
  } else if self.lexer.matches("^") {
    format.dir = 0;
  }
  if self.lexer.matches("+") {
    format.plus = true;
  }
  if self.lexer.matches("#") {
    format.special_layout = true;
  }
  s = self.lexer.int();
  if s {
    format.size = (s & 127) as i8;
  }
  if self.lexer.matches(".") {
    format.is_float = true;
  }
  d = self.lexer.int();
  if d {
    format.decimals = (d & 127) as i8;
  }
  if self.lexer.matches("x") || self.lexer.matches("X") {
    format.radix = 16;
  }
  if self.lexer.matches("b") {
    format.radix = 2;
  }
  if self.lexer.matches("o") {
    format.radix = 8;
  }
  if self.lexer.matches("e") {
    format.radix = 1;
  }
}
// TODO <text_value> ::= <text_part>  { ( <for_list> | <expression> ) <text_part> }

// Did a round of a repetition consume anything?  `at` is the cursor offset the round
// started at.
//
// A loop that repeats a construct has to tell "one more item" from "the same token again".
// When a round ends where it began, the grammar could not claim what is there and going
// round again can only repeat the diagnostic it just wrote: `struct S {{ n: limit(0, 10) }}`
// reported one bad field 256 times, once per turn of the loop bound.  Stopping keeps the
// error count meaning what a caller reads it as — how many distinct things went wrong.

fn stalled(self: Parser, at: integer) -> boolean {
  self.lexer.offset() == at
}

fn expect(self: Parser, value: text) {
  if !self.lexer.matches(value) {
    self.log.error("Expected {value}{self.lexer.at()}");
  }
}
