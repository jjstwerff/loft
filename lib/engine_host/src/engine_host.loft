//
// @PLN18 — the engine-host kernel: loft surface over the in-binary natives
// (src/engine_host.rs).  The host-boundary principle: the natives carry ALL
// mechanics (non-blocking pump with the peek pattern, event queue, drift-free
// ticks, send/broadcast); this library carries the loop SKELETON and nothing
// else — user code supplies meaning as closures:
//
//   use engine_host;
//   fn main() {
//     world = World { ... };
//     engine_host::run(18083, 33333,
//       fn(ev: engine_host::Event) { ...world... },
//       fn() { ...world... });
//   }
//
// Closures are passed as ARGUMENTS (not struct fields) per the probed crash
// boundary in loft-lang/loft#313.

// One pumped event.  kind: 0 = connect, 1 = message, 2 = disconnect.
pub struct Event {
  cid:     integer not null,
  kind:    integer not null,
  payload: text not null,
}

fn kernel_listen(port: integer, tick_interval_us: integer) -> boolean;
#native

fn kernel_pump() -> integer;
#native

fn kernel_next_event() -> boolean;
#native

fn kernel_event_cid() -> integer;
#native

fn kernel_event_kind() -> integer;
#native

fn kernel_event_payload() -> text;
#native

fn kernel_tick_due() -> boolean;
#native

// Send a text frame to one client.  False = the client is gone (a disconnect
// event is queued for it).
pub fn send(cid: integer, msg: text) -> boolean;
#native "n_kernel_send"

// Broadcast a text frame to every live client; returns the delivery count.
pub fn broadcast(msg: text) -> integer;
#native "n_kernel_broadcast"

fn kernel_idle(max_us: integer);
#native

// Live connection count (diagnostics).
pub fn clients() -> integer;
#native "n_kernel_clients"

// ── 05a — the state-sync UDP channel (events + bulk stay on WS) ─────────────
//
// The kernel binds a UDP socket on the SAME port as the WS listener.  A native
// client earns the fast path with a cookie handshake: read the cookie with
// `udp_cookie(cid)`, deliver it inside YOUR protocol (cookie transport is
// meaning), and have the client echo it in a `H:<cookie>` datagram; the kernel
// binds the source address and acks `A:<cid>`.  After that, `sync_send` rides
// UDP for that client; phones that never hello simply keep receiving WS
// frames from the same call.

// Text-returning natives keep the `kernel_` def name (the dest-passing route
// in `is_text_dest_native` keys on it — the `n_kernel_event_payload` pattern);
// the pub wrappers carry the surface names.
fn kernel_udp_cookie(cid: integer) -> text;
#native

// The client's UDP handshake cookie ("" when UDP is unavailable).
pub fn udp_cookie(cid: integer) -> text {
  kernel_udp_cookie(cid)
}

// Does this client currently have a live UDP path?
pub fn udp_bound(cid: integer) -> boolean;
#native "n_kernel_udp_bound"

// Send a latest-value state frame: a seq-stamped datagram when the client's
// UDP path is bound, else a plain WS frame.  False = dropped (no such client,
// dead socket, or an oversized datagram — state frames must stay ≤ ~1200 B).
pub fn sync_send(cid: integer, msg: text) -> boolean;
#native "n_kernel_sync_send"

// Drain the inbound conflation slots: each call loads the NEWEST unread state
// from one client (stale/reordered datagrams were already discarded by the
// kernel).  Drain inside `on_tick` — that reads the freshest data that arrived
// before the tick (late-latch by construction).
pub fn sync_next() -> boolean;
#native "n_kernel_sync_next"

pub fn sync_cid() -> integer;
#native "n_kernel_sync_cid"

pub fn sync_seq() -> integer;
#native "n_kernel_sync_seq"

fn kernel_sync_payload() -> text;
#native

pub fn sync_payload() -> text {
  kernel_sync_payload()
}

// The kernel loop: pump → budgeted event drain → tick when due → idle.
// Never returns.  `on_event` and `on_tick` are the user's meaning; their
// captures (the world) live in the caller's frame, which stays alive because
// this fn never returns.
pub fn run(port: integer, tick_interval_us: integer,
           on_event: fn(Event), on_tick: fn()) {
  ok = kernel_listen(port, tick_interval_us);
  if !ok {
    println("engine_host: cannot listen on port {port}");
    return;
  }
  println("engine_host: listening on ws://0.0.0.0:{port}/ (tick every {tick_interval_us} us)");
  while true {
    work = kernel_pump();
    // Budgeted drain (the ENGINE_HOST drain rule): events to a bounded count
    // per turn, so the tick check below is never starved by a flood.
    for _ in 0..256 {
      more = kernel_next_event();
      if !more { break; }
      ev = Event {
        cid:     kernel_event_cid(),
        kind:    kernel_event_kind(),
        payload: kernel_event_payload(),
      };
      on_event(ev);
      work = work + 1;
    }
    if kernel_tick_due() {
      on_tick();
      work = work + 1;
    }
    if work == 0 {
      kernel_idle(2000);
    }
  }
}
