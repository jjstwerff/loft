// Coroutine runtime types (CO1.1).
// Loaded after 04_stacktrace.loft.

// ---  Coroutines  ---

/// Lifecycle state of a coroutine frame.
/// Transitions: Created -> Running -> Suspended -> Running -> ... -> Exhausted.
pub enum CoroutineStatus {
  Created,
  Suspended,
  Running,
  Exhausted,
}

/// CO1.6: Returns true if the coroutine has finished producing values.
pub fn exhausted(gen: reference) -> boolean {
  OpCoroutineExhausted(gen)
}
// Plan-06 phase 5a: #pure — read-only flag inspection.  Under
// D2.0 (read-only-parent) workers may read parent coroutine
// state without locking; the operation has no side effects and
// no parent-store writes.
#pure
