// --- File System ---
// Types and functions for reading and writing files.
// A File value is obtained via file() and carries the path, format, and an internal reference.
// An environment variable as a name/value pair.
// Capability groups (@PLN86) — the fs/env split a sandbox profile grants via
// `fs#read` / `fs#update` / `env#read`; the functions below link in their signature.
capability fs
capability env

pub struct EnvVariable {
  name: text,
  value: text
}
// Describes how a file is opened.
// TextFile: read or write as UTF-8 text (default).
// LittleEndian: binary mode, least-significant byte first.
// BigEndian: binary mode, most-significant byte first.
// Directory: represents a directory path.
// NotExists: no file or directory exist.

pub enum Format {
  TextFile,
  LittleEndian,
  BigEndian,
  Directory,
  NotExists
}
// Result of a filesystem-mutating operation (delete, move, mkdir).
// Use ok() to get a simple boolean, or match on specific variants for
// detailed error handling.

pub enum FileResult {
  Ok,
  NotFound,
  PermissionDenied,
  IsDirectory,
  NotDirectory,
  Other
}

// True when the result is `FileResult.Ok`. Use to test a file op for success.
pub fn ok(self: FileResult) -> boolean {
  self == FileResult.Ok
}
#pure
// A handle to a filesystem entry.
// Fields: path (full path), size (file size in bytes), format (open mode),
// current (byte position after last read), next (byte position to read next).

pub struct File {
  path: text,
  // 24
  size: integer,
  // 0
  format: Format,
  // 32
  ref: i32,
  // 28
  current: integer,
  // 8
  next: integer  // 16
}

fn OpGetFile(file: File) -> boolean fs#read;
#rust"stores.get_file(&@file)"
fn OpGetDir(path: text, result: vector < File >) -> boolean fs#read;
#rust"stores.get_dir(@path, &@result)"
fn OpGetFileText(file: File, content:  & text) fs#read;
fn OpWriteFile(file: File, val: reference, db_tp: const u16) fs#update;
fn OpReadFile(file: File, val: reference, bytes: integer, db_tp: const u16) fs#read;
fn OpSeekFile(file: File, pos: integer) fs#read;
fn OpSizeFile(file: File) -> integer fs#read;
fn OpDelete(path: text) -> boolean fs#update;
#rust"codegen_runtime::fs_delete(&s.database.resolve_path(@path))"
fn OpMoveFile(from: text, to: text) -> boolean fs#update;
#rust"codegen_runtime::fs_move(&s.database.resolve_path(@from), &s.database.resolve_path(@to))"
fn OpTruncateFile(self: File, size: integer) -> boolean fs#update;
fn OpSyncFile(self: File) -> boolean fs#update;
// Dynamic dispatch through a runtime function reference (fn-ref variable).
// Placed here — after all file-I/O operators — so that it receives op_code 252 without
// renumbering the operators defined earlier in this file.  Logically it beintegers near
// OpCall in 01_code.loft; relocate it there if the operator numbering is ever rebuilt.
// fn_var  — byte distance from the current stack top to the i32 d_nr slot.
// arg_size — total byte size of the already-pushed arguments.
fn OpCallRef(fn_var: const u16, arg_size: const u16);
#rust"s.fn_call_ref(@fn_var, @arg_size);"
fn OpMkdir(path: text) -> boolean fs#update;
#rust"codegen_runtime::fs_mkdir(&s.database.resolve_path(@path))"
fn OpMkdirAll(path: text) -> boolean fs#update;
#rust"codegen_runtime::fs_mkdir_all(&s.database.resolve_path(@path))"
// Reads the entire file as a UTF-8 text value.
// Use for small configuration files or scripts.

pub fn content(self: File) -> text fs#read {
  result = "";
  txt = "";
  OpGetFileText(self, txt);
  result += txt;
  result
}
// Par-safe: reads the file into a worker-local store; the host bridge
// serialises filesystem access.
#impure(io)
// Reads the file and splits it into lines.
// Strips trailing '\r' so CRLF files (Windows) and LF files (Unix) produce
// identical results. Use when processing line-by-line (logs, CSV, etc.).

pub fn lines(self: File) -> vector < text > fs#read {
  result =[];
  c = self.content();
  p = 0;
  prev_cr = false;
  for ch in c {
    if ch == '\n' {
      e = ch#index;
      if prev_cr {
        result +=[c[p..e - 1]];
      } else {
        result +=[c[p..e]];
      }
      p = ch#next;
    }
    prev_cr = ch == '\r';
  }
  if p < c.len() {
    result +=[c[p..c.len()]];
  }
  result
}
// Par-safe filesystem read (via content()).
#impure(io)
// --- Text ---
// Splits self on every occurrence of separator and returns the parts as a vector.
// Use to parse CSV lines or space-separated tokens.

pub fn split(self: text, separator: character) -> vector < text > {
  result =[];
  p = 0;
  for c in self {
    if c == separator {
      result +=[self[p..c#index]];
      p = c#next;
    }
  }
  // Always append the trailing segment when the input is non-empty, including
  // the case where no separator was found at all.  Without this, "hello".split(',')
  // returned [] instead of ["hello"].  An empty input returns [] (no segments).
  if self.len() > 0 {
    result +=[self[p..self.len()]];
  }
  result
}
#pure
// Split on a multi-character text separator.  `"a, b, c".split_text(", ")`
// returns `["a", "b", "c"]`.  Edge cases:
//   - empty self → empty result
//   - empty separator → returns `[self]` unchanged (no infinite-split)
//   - separator never matches → returns `[self]`
//   - separator at start / end → produces empty boundary entries
//
// Named `split_text` (not an overload of `split`) because loft does not
// overload by non-self parameter type.

pub fn split_text(self: text, separator: text) -> vector < text > {
  out: vector<text> = [];
  n = self.len();
  if n == 0 { return out; }
  sl = separator.len();
  if sl == 0 { out += [self]; return out; }
  p = 0;
  i = 0;
  while i + sl <= n {
    if self[i..i + sl] == separator {
      out += [self[p..i]];
      p = i + sl;
      i = p;
    } else {
      i = i + 1;
    }
  }
  out += [self[p..n]];
  out
}
#pure
// --- File System ---
// Returns the platform path separator character: '\' on Windows, '/' elsewhere.
// Detected once at startup from the runtime filesystem.

pub fn path_sep() -> character;
// Plan-06 phase 5a: #impure(host_io) — reads a host-detected
// constant.  Could be #pure once detected (it's invariant for
// the lifetime of a process), but the runtime caches it inside
// Stores so the access is observable.
#impure(host_io)
// Returns true if path stays within the project directory (no net upward traversal).
// Accepts both '/' and '\' as separators so loft programs can use either style.
fn valid_path(path: text) -> boolean {
  depth = 0;
  start = 0;
  for c in path {
    if c == '/' || c == '\\' {
      part = path[start..c#index];
      start = c#next;
      if part == ".." {
        depth -= 1;
        if depth < 0 {
          return false;
        }
      } else if part != "." && part.len() > 0 {
        depth += 1;
      }
    }
  }
  if start < path.len() {
    part = path[start..path.len()];
    if part == ".." {
      depth -= 1;
    }
  }
  depth >= 0
}
#pure
// Use as the entry point for all file I/O.
// Paths outside the project directory are treated as NotExists without touching the filesystem.

pub fn file(path: text) -> File fs#read {
  result = File {path: path, ref: null };
  if valid_path(path) {
    OpGetFile(result);
  } else {
    result.format = Format.NotExists;
  }
  result
}
// Stat-equivalent filesystem read; par-safe.
#impure(io)
// Use to check whether a path is accessible before reading or writing it.
// Paths outside the project directory are always absent.

pub fn exists(path: text) -> boolean fs#read {
  file(path).format != Format.NotExists
}
// Filesystem stat (via file()); par-safe.
#impure(io)
// Method form: f = file("path"); if f.exists() { ... }
// Also callable as exists(file_obj) via the 'both' parameter name.
pub fn exists(both: File) -> boolean fs#read {
  both.format != Format.NotExists
}
#pure
// Use to remove a file after processing or as a cleanup step.
// Returns FileResult.Ok on success, FileResult.NotFound when the file did
// not exist or is outside the project directory.

pub fn delete(path: text) -> FileResult fs#update {
  if !exists(path) { return FileResult.NotFound }
  if OpDelete(path) { return FileResult.Ok }
  FileResult.Other
}
// Par-safe filesystem write; the host bridge serialises mutations.
#impure(io)
// Use to rename or relocate a file within the project.
// Both paths must stay within the project directory; the destination must
// not already exist.

pub fn move(from: text, to: text) -> FileResult fs#update {
  if !valid_path(to) || !valid_path(from) { return FileResult.NotFound }
  if !exists(from) { return FileResult.NotFound }
  if exists(to) { return FileResult.Other }
  if OpMoveFile(from, to) { return FileResult.Ok }
  FileResult.Other
}
#impure(io)
// Create a single directory level. Returns FileResult.NotFound if the path
// is outside the project directory.

pub fn mkdir(path: text) -> FileResult fs#update {
  if !valid_path(path) { return FileResult.NotFound }
  if OpMkdir(path) { return FileResult.Ok }
  FileResult.Other
}
#impure(io)
// Create a directory and all missing parents (like Unix mkdir -p).
// Returns FileResult.NotFound if the path is outside the project directory.

pub fn mkdir_all(path: text) -> FileResult fs#update {
  if !valid_path(path) { return FileResult.NotFound }
  if OpMkdirAll(path) { return FileResult.Ok }
  FileResult.Other
}
#impure(io)
// Returns true if `path` exists and is a directory.
// Use to branch on a path's kind before descending into / reading it.
pub fn is_dir(path: text) -> boolean fs#read;
#rust"codegen_runtime::fs_is_dir(&s.database.resolve_path(@path))"
#impure(io)
// Returns true if `path` exists and is a regular file.
// Use to confirm a directory entry is a readable file before opening it.
pub fn is_file(path: text) -> boolean fs#read;
#rust"codegen_runtime::fs_is_file(&s.database.resolve_path(@path))"
#impure(io)
// Lists the entry NAMES of directory `path` (base names, not full paths),
// sorted.  Returns an empty vector when `path` is not a readable directory.
// Use to enumerate a directory; join with `path` to build full child paths.
pub fn list_dir(path: text) -> vector < text > fs#read;
#rust"stores.fs_list_dir(@path)"
#impure(io)
// Reads the whole file `path` as raw bytes.  Returns an empty vector on a
// missing file or IO error.  Binary-exact (round-trips with write_bytes);
// use for non-UTF-8 data — for text prefer `file(path).content()`.
pub fn read_bytes(path: text) -> vector < u8 > fs#read;
#rust"stores.fs_read_bytes(@path)"
#impure(io)
// Writes `bytes` to file `path`, truncating any existing content.  Returns
// true on success.  The inverse of read_bytes; the pair round-trips a
// non-UTF-8 blob byte-for-byte.
pub fn write_bytes(path: text, bytes: vector < u8 >) -> boolean fs#update;
#rust"stores.fs_write_bytes(@path, @bytes)"
#impure(io)
// Truncate or extend the file to exactly `size` bytes.
// Truncating removes bytes beyond `size`; extending fills with null bytes.
// Returns FileResult.NotFound if the file does not exist; FileResult.IsDirectory
// if the path is a directory; FileResult.Other if size is negative.

// Modification time of `path` as Unix epoch SECONDS (integer —
// same i64 representation as file.size).  Returns 0 on missing
// file / IO error / pre-epoch dates — caller treats 0 as
// "unknown" (matches scan.sh's `stat -c %Y || echo 0` fallback).
// Takes a path string rather than a File handle so the native +
// interp dispatch both use the same `n_mtime` registration.
// Use for date-window filters: convert the returned seconds to YYYY-MM-DD and
// compare lexicographically against `ymd_days_ago(N)`.
pub fn mtime(path: text) -> integer fs#read;
#rust"Stores::os_mtime_native(@path)"
#impure(host_io)

// Durable-store integrity check.  Returns true
// iff the `.dmeta` sidecar at `<path>.dmeta` validates against the
// main file at `<path>` (signature, header CRC, payload length,
// payload CRC, tier_id all OK).  Returns false on any failure or
// missing file.  Pair with `store_durable_seal` after a clean
// write session to record the new state.
pub fn store_durable_check(path: text) -> boolean fs#read;
#rust"crate::store::Store::durable_check(std::path::Path::new(@path))"
#impure(io)

// Write a fresh `.dmeta` sidecar capturing the
// current main-file's byte length + CRC32 + a clean-close timestamp.
// Returns true on success, false on any I/O error.  Call this after
// finishing a write session; if the program crashes between the
// last write and the seal, the sidecar stays stale and the next
// `store_durable_check` returns false → caller rebuilds.
pub fn store_durable_seal(path: text) -> boolean fs#update;
#rust"crate::store::Store::durable_seal(std::path::Path::new(@path))"
#impure(io)

// "The hash IS the file."  Re-root the Store backing the
// given reference at a file path so mutations are durable via mmap
// without any explicit save/load loop.
//
// First call on a path that does NOT yet exist: serialises the
// current in-memory Store at the reference's slot to disk (padded to
// a valid ≥1024-word image with a tail free block), then mmaps it
// back.  Caller's existing DbRefs into that slot remain valid.
//
// Call on a path that DOES exist: opens the file via mmap; the
// caller's prior in-memory contents at that slot are dropped in
// favour of the on-disk image.  This is the load-on-startup path,
// assumes the on-disk layout matches the declared type.
//
// Both modes return `true` on success, `false` on any I/O / format
// error (no panic — the binding is fail-soft, callers fall back to
// JSON or rebuild-from-source).
//
// Typical dryopea-style pattern:
//   pw = PaintedWorld { painted: hash<PaintedHex[q, r]>::new() }
//   store_persist_bind(pw.painted, "dryopea_world.store")
//   // …mutations to pw.painted now hit mmap'd bytes…
pub fn store_persist_bind(r: hash, path: text) -> boolean fs#update;
#rust"stores.bind_path((@r).store_nr, std::path::Path::new(@path))"
#impure(io)

// Truncates or extends the file to `size` bytes. Returns FileResult.Ok, or an
// error variant (IsDirectory / NotFound / Other).
pub fn set_file_size(self: File, size: integer) -> FileResult fs#update {
  if self.format == Format.Directory { return FileResult.IsDirectory }
  if self.format == Format.NotExists { return FileResult.NotFound }
  if size < 0 { return FileResult.Other }
  if OpTruncateFile(self, size) { return FileResult.Ok }
  FileResult.Other
}
#impure(io)
// Flushes buffered bytes for self to the underlying storage so that the
// preceding writes are durable. Use between log records or block
// boundaries to guarantee that earlier appends have landed on disk
// before later ones are issued.

pub fn sync(self: File) -> boolean fs#update {
  if self.format == Format.Directory { return false }
  if self.format == Format.NotExists { return false }
  OpSyncFile(self)
}
#impure(io)
// Returns the entries inside a directory.
// The File must have format == Format.Directory.
// Use to iterate over all files in a folder.

pub fn files(self: File) -> vector < File > fs#read {
  result =[];
  if self.format == Format.Directory {
    OpGetDir(self.path, result);
  }
  result
}
#impure(io)
// Writes v as UTF-8 text to the file. Overwrites existing content.

pub fn write(self: File, v: text) fs#update;
#rust"{{ let __wf_v = @v; stores.write_file(&@self, __wf_v); }}"
#impure(io)
