// @F40 — file & directory I/O (catalogue anchor, @PLN92)
// --- File System ---
// Types and functions for reading and writing files.
// A File value is obtained via file() and carries the path, format, and an internal reference.
// An environment variable as a name/value pair.
// Capability groups (@PLN86) — the fs/env split a sandbox profile grants via
// `fs#read` / `fs#update` / `env#read`; the functions below link in their signature.
capability fs
capability env

pub struct EnvVariable {
  name: text,
  value: text,
}
// Describes how a file is opened.
// TextFile: read or write as UTF-8 text (default).
// LittleEndian: binary mode, least-significant byte first.
// BigEndian: binary mode, most-significant byte first.
// Directory: represents a directory path.
// NotExists: no file or directory exist.

pub enum Format {
  TextFile,
  LittleEndian,
  BigEndian,
  Directory,
  NotExists,
}
// Result of a filesystem-mutating operation (delete, move, mkdir).
// Use ok() to get a simple boolean, or match on specific variants for
// detailed error handling.  Every variant can actually be produced: Ok on
// success, NotFound for a missing / out-of-project path, PermissionDenied when
// the OS refuses access, IsDirectory when a file op targets a directory
// (e.g. deleting a directory with delete()), and Other for anything else.
// (--native and --interpret classify from the OS error; the wasm host reports
// only Ok / Other, and NotFound still comes from the loft-level existence check.)
pub enum FileResult {
  Ok,
  NotFound,
  PermissionDenied,
  IsDirectory,
  Other,
}

// True when the result is `FileResult.Ok`. Use to test a file op for success.
pub fn ok(self: FileResult) -> boolean {
  self == FileResult.Ok
}
#pure
// Maps a runtime FS_* result code (from OpDelete / OpMoveFile / OpMkdir / OpMkdirAll)
// to a FileResult variant. The codes are fixed in codegen_runtime.rs (shared by
// both backends); an unknown code falls through to Other.
fn fs_result(code: integer) -> FileResult {
  match code {
    0 => FileResult.Ok,
    1 => FileResult.NotFound,
    2 => FileResult.PermissionDenied,
    3 => FileResult.IsDirectory,
    _ => FileResult.Other,
  }
}
#pure
// A handle to a filesystem entry.
// Fields: path (full path), size (file size in bytes), format (open mode),
// current (byte position after last read), next (byte position to read next).

pub struct File {
  path: text,
  // 24
  size: integer,
  // 0
  format: Format,
  // 32
  ref: i32?,
  // 28
  current: integer,
  // 8
  next: integer, // 16
}

fn OpGetFile(file: File) -> boolean fs#read;
#rust"stores.get_file(&@file)"
fn OpGetDir(path: text, result: vector<File>) -> boolean fs#read;
#rust"stores.get_dir(@path, &@result)"
fn OpGetFileText(file: File, content: &text) fs#read;
fn OpWriteFile(file: File, val: reference, db_tp: const u16) fs#update;
fn OpReadFile(file: File, val: reference, bytes: integer, db_tp: const u16) fs#read;
fn OpSeekFile(file: File, pos: integer) fs#read;
fn OpSizeFile(file: File) -> integer fs#read;
fn OpDelete(path: text) -> integer fs#update;
#rust"codegen_runtime::fs_delete(&s.database.resolve_path(@path))"
fn OpMoveFile(from: text, to: text) -> integer fs#update;
#rust"codegen_runtime::fs_move(&s.database.resolve_path(@from), &s.database.resolve_path(@to))"
fn OpTruncateFile(self: File, size: integer) -> boolean fs#update;
fn OpSyncFile(self: File) -> boolean fs#update;
// @PLN105 Phase 1 — deliver a live value's descriptor handle to the host.
// LOOPBACK host (both backends): reconstruct the value via its layout descriptor
// (@PLN105 Phase 0) + print a deterministic line, so interpret == native. The value
// is passed BY VALUE (its code, not an OpCreateStack ref) so `@val` is the record
// DbRef on both backends — one `#rust` body serves both. `deliver(tag, value)` is
// lowered in the parser's `dispatch_call`, which fills `db_tp` from the value's
// static type.
fn OpDeliver(tag: integer, val: reference, db_tp: const u16) fs#update;
#rust"stores.deliver_reconstruct(@tag, @val, @db_tp);"
// @PLN105 Phase 3 — expose/release: a LONG-LIVED deliver whose borrow spans frames.
// `expose(tag, value)` hands the host the same descriptor handle as `deliver` but PINS
// the value's store (read-only lock) so its wasm-memory addresses stay stable across
// frames, until `release(tag, value)` unpins it. Browser-only surface; both lowered in
// `dispatch_call` (which fills `db_tp`). On non-browser targets they just lock / unlock.
fn OpExpose(tag: integer, val: reference, db_tp: const u16) fs#update;
#rust"stores.expose_value(@tag, @val, @db_tp);"
fn OpRelease(tag: integer, val: reference, db_tp: const u16) fs#update;
#rust"stores.release_value(@tag, @val, @db_tp);"
// Dynamic dispatch through a runtime function reference (fn-ref variable).
// Placed here — after all file-I/O operators — so that it receives op_code 252 without
// renumbering the operators defined earlier in this file.  Logically it beintegers near
// OpCall in 01_code.loft; relocate it there if the operator numbering is ever rebuilt.
// fn_var  — byte distance from the current stack top to the i32 d_nr slot.
// arg_size — total byte size of the already-pushed arguments.
fn OpCallRef(fn_var: const u16, arg_size: const u16);
#rust"s.fn_call_ref(@fn_var, @arg_size);"
fn OpMkdir(path: text) -> integer fs#update;
#rust"codegen_runtime::fs_mkdir(&s.database.resolve_path(@path))"
fn OpMkdirAll(path: text) -> integer fs#update;
#rust"codegen_runtime::fs_mkdir_all(&s.database.resolve_path(@path))"
// Reads the entire file as a UTF-8 text value.
// Use for small configuration files or scripts.

pub fn content(self: File) -> text?fs#read {
  // @PLN102 H4 — a MISSING file reads as null, distinct from an EMPTY file (""),
  // so a missing config is not silently indistinguishable from an empty one.
  if self.format == Format.NotExists { return null }
  result = "";
  txt = "";
  OpGetFileText(self, txt);
  result += txt;
  result
}
// Par-safe: reads the file into a worker-local store; the host bridge
// serialises filesystem access.
#impure(io)
// Reads the file and splits it into lines.
// Strips trailing '\r' so CRLF files (Windows) and LF files (Unix) produce
// identical results. Use when processing line-by-line (logs, CSV, etc.).

pub fn lines(self: File) -> vector<text> fs#read {
  result = [];
  // @PLN102 H4 — content() is now `text?`; a missing file has no lines.
  c = self.content() ?? "";
  p = 0;
  prev_cr = false;
  for ch in c {
    if ch == '\n' {
      e = ch#index;
      if prev_cr { result += [c[p..e - 1]]; } else { result += [c[p..e]]; }
      p = ch#next;
    }
    prev_cr = ch == '\r';
  }
  if p < c.size() { result += [c[p..c.size()]]; }
  result
}
// Par-safe filesystem read (via content()).
#impure(io)
// --- Text ---
// Splits self on every occurrence of separator and returns the parts as a vector.
// Use to parse CSV lines or space-separated tokens.

pub fn split(self: text, separator: character) -> vector<text> {
  result = [];
  p = 0;
  for c in self {
    if c == separator {
      result += [self[p..c#index]];
      p = c#next;
    }
  }
  // Always append the trailing segment when the input is non-empty, including
  // the case where no separator was found at all.  Without this, "hello".split(',')
  // returned [] instead of ["hello"].  An empty input returns [] (no segments).
  if self.len() > 0 { result += [self[p..self.size()]]; }
  result
}
#pure
// Split on a multi-character text separator.  `"a, b, c".split_text(", ")`
// returns `["a", "b", "c"]`.  Edge cases:
//   - empty self → empty result
//   - empty separator → returns `[self]` unchanged (no infinite-split)
//   - separator never matches → returns `[self]`
//   - separator at start / end → produces empty boundary entries
//
// Named `split_text` (not an overload of `split`) because loft does not
// overload by non-self parameter type.

pub fn split_text(self: text, separator: text) -> vector<text> {
  out: vector<text> = [];
  n = self.size();
  if n == 0 { return out; }
  sl = separator.size();
  if sl == 0 {
    out += [self]; return out;
  }
  p = 0;
  i = 0;
  while i + sl <= n {
    if self[i..i + sl] == separator {
      out += [self[p..i]];
      p = i + sl;
      i = p;
    } else { i = i + 1; }
  }
  out += [self[p..n]];
  out
}
#pure
// --- File System ---
// Returns the platform path separator character: '\' on Windows, '/' elsewhere.
// Detected once at startup from the runtime filesystem.

pub fn path_sep() -> character;
// Plan-06 phase 5a: #impure(host_io) — reads a host-detected
// constant.  Could be #pure once detected (it's invariant for
// the lifetime of a process), but the runtime caches it inside
// Stores so the access is observable.
#impure(host_io)
// Returns true if path stays within the project directory (no net upward traversal).
// Accepts both '/' and '\' as separators so loft programs can use either style.
fn valid_path(path: text) -> boolean {
  depth = 0;
  start = 0;
  for c in path {
    if c == '/' || c == '\\' {
      part = path[start..c#index];
      start = c#next;
      if part == ".." {
        depth -= 1;
        if depth < 0 { return false; }
      } else if part != "." && part.len() > 0 { depth += 1; }
    }
  }
  if start < path.size() {
    part = path[start..path.size()];
    if part == ".." { depth -= 1; }
  }
  depth >= 0
}
#pure
// Use as the entry point for all file I/O.
// Paths outside the project directory are treated as NotExists without touching the filesystem.

pub fn file(path: text) -> File fs#read {
  result = File { path: path, ref: null };
  if valid_path(path) { OpGetFile(result); } else { result.format = Format.NotExists; }
  result
}
// Stat-equivalent filesystem read; par-safe.
#impure(io)
// Use to check whether a path is accessible before reading or writing it.
// Paths outside the project directory are always absent.

pub fn exists(path: text) -> boolean fs#read {
  file(path).format != Format.NotExists
}
// Filesystem stat (via file()); par-safe.
#impure(io)
// Method form: f = file("path"); if f.exists() { ... }
// Also callable as exists(file_obj) via the 'both' parameter name.
pub fn exists(both: File) -> boolean fs#read {
  both.format != Format.NotExists
}
#pure
// Use to remove a file after processing or as a cleanup step.
// Returns FileResult.Ok on success, FileResult.NotFound when the file did
// not exist or is outside the project directory.

pub fn delete(path: text) -> FileResult fs#update {
  if!exists(path) { return FileResult.NotFound }
  fs_result(OpDelete(path))
}
// Par-safe filesystem write; the host bridge serialises mutations.
#impure(io)
// Use to rename or relocate a file within the project.
// Both paths must stay within the project directory; the destination must
// not already exist.

pub fn move(from: text, to: text) -> FileResult fs#update {
  if!valid_path(to) || !valid_path(from) { return FileResult.NotFound }
  if!exists(from) { return FileResult.NotFound }
  if exists(to) { return FileResult.Other }
  fs_result(OpMoveFile(from, to))
}
#impure(io)
// Create a single directory level. Returns FileResult.NotFound if the path
// is outside the project directory.

pub fn mkdir(path: text) -> FileResult fs#update {
  if!valid_path(path) { return FileResult.NotFound }
  fs_result(OpMkdir(path))
}
#impure(io)
// Create a directory and all missing parents (like Unix mkdir -p).
// Returns FileResult.NotFound if the path is outside the project directory.

pub fn mkdir_all(path: text) -> FileResult fs#update {
  if!valid_path(path) { return FileResult.NotFound }
  fs_result(OpMkdirAll(path))
}
#impure(io)
// Returns true if `path` exists and is a directory.
// Use to branch on a path's kind before descending into / reading it.
pub fn is_dir(path: text) -> boolean fs#read;
#rust"codegen_runtime::fs_is_dir(&s.database.resolve_path(@path))"
#impure(io)
// Returns true if `path` exists and is a regular file.
// Use to confirm a directory entry is a readable file before opening it.
pub fn is_file(path: text) -> boolean fs#read;
#rust"codegen_runtime::fs_is_file(&s.database.resolve_path(@path))"
#impure(io)
// Lists the entry NAMES of directory `path` (base names, not full paths),
// sorted.  @PLN102 H4 — a MISSING / non-directory path lists as NULL (distinct
// from an EMPTY directory, `[]`); discharge with `?? []` to keep the old shape.
// Use to enumerate a directory; join with `path` to build full child paths.
pub fn list_dir(path: text) -> vector<text> ?fs#read;
#rust"stores.fs_list_dir(@path)"
#impure(io)
// Reads the whole file `path` as raw bytes.  @PLN102 H4 — a MISSING / unreadable
// file reads as NULL (distinct from an EMPTY file, `[]`); discharge with `?? []`
// to keep the old shape.  Binary-exact (round-trips with write_bytes); use for
// non-UTF-8 data — for text prefer `file(path).content()`.
pub fn read_bytes(path: text) -> vector<u8> ?fs#read;
#rust"stores.fs_read_bytes(@path)"
#impure(io)
// Writes `bytes` to file `path`, truncating any existing content.  Returns
// true on success.  The inverse of read_bytes; the pair round-trips a
// non-UTF-8 blob byte-for-byte.
pub fn write_bytes(path: text, bytes: vector<u8>) -> boolean fs#update;
#rust"stores.fs_write_bytes(@path, @bytes)"
#impure(io)
// Truncate or extend the file to exactly `size` bytes.
// Truncating removes bytes beyond `size`; extending fills with null bytes.
// Returns FileResult.NotFound if the file does not exist; FileResult.IsDirectory
// if the path is a directory; FileResult.Other if size is negative.

// Modification time of `path` as Unix epoch SECONDS (integer —
// same i64 representation as file.size).  Returns 0 on missing
// file / IO error / pre-epoch dates — caller treats 0 as
// "unknown" (matches scan.sh's `stat -c %Y || echo 0` fallback).
// Takes a path string rather than a File handle so the native +
// interp dispatch both use the same `n_mtime` registration.
// Use for date-window filters: convert the returned seconds to YYYY-MM-DD and
// compare lexicographically against `ymd_days_ago(N)`.
pub fn mtime(path: text) -> integer fs#read;
#rust"Stores::os_mtime_native(@path)"
#impure(host_io)

// Durable-store integrity check.  Returns true
// iff the `.dmeta` sidecar at `<path>.dmeta` validates against the
// main file at `<path>` (signature, header CRC, payload length,
// payload CRC, tier_id all OK).  Returns false on any failure or
// missing file.  Pair with `store_durable_seal` after a clean
// write session to record the new state.
pub fn store_durable_check(path: text) -> boolean fs#read;
#rust"crate::store::Store::durable_check(std::path::Path::new(@path))"
#impure(io)

// Write a fresh `.dmeta` sidecar capturing the
// current main-file's byte length + CRC32 + a clean-close timestamp.
// Returns true on success, false on any I/O error.  Call this after
// finishing a write session; if the program crashes between the
// last write and the seal, the sidecar stays stale and the next
// `store_durable_check` returns false → caller rebuilds.
pub fn store_durable_seal(path: text) -> boolean fs#update;
#rust"crate::store::Store::durable_seal(std::path::Path::new(@path))"
#impure(io)

// "The collection IS the file."  Re-root the Store backing the
// given reference at a file path so mutations are durable via mmap
// without any explicit save/load loop.
//
// Works for any store-rooted collection — `hash`, `sorted`, `ordered`,
// `index` (each keyed local/field is a dedicated Store).  `hash` carries
// its bucket seed in its own record and `sorted`/`ordered`/`index` are
// comparison-based (no per-process state), so the persisted image is
// portable: a different process (a restart, or a remote reader) both
// iterates AND key-looks-up correctly.  A reference that is NOT its own
// Store root fails soft (returns `false`), same as any I/O error.
//
// First call on a path that does NOT yet exist: serialises the
// current in-memory Store at the reference's slot to disk (padded to
// a valid ≥1024-word image with a tail free block), then mmaps it
// back.  Caller's existing DbRefs into that slot remain valid.
//
// Call on a path that DOES exist: opens the file via mmap; the
// caller's prior in-memory contents at that slot are dropped in
// favour of the on-disk image.  This is the load-on-startup path,
// assumes the on-disk layout matches the declared type.
//
// Both modes return `true` on success, `false` on any I/O / format
// error (no panic — the binding is fail-soft, callers fall back to
// JSON or rebuild-from-source).
//
// Typical dryopea-style pattern:
//   pw = PaintedWorld { painted: [] }   // painted's declared type is hash<PaintedHex[q, r]>
//   store_persist_bind(pw.painted, "dryopea_world.store")
//   // …mutations to pw.painted now hit mmap'd bytes…
// `r` is any store-rooted collection — `hash`, `sorted`, `index`, `spatial`
// (each keyed local/field is its own dedicated Store).  A bare `reference`
// parameter accepts them all; `bind_path` is collection-agnostic (it
// snapshots the whole Store's bytes).  `hash` carries its bucket seed in its
// own record and the comparison-based kinds hold no per-process state, so
// every persisted image is portable across processes.
pub fn store_persist_bind(r: reference, path: text) -> boolean fs#update;
#rust"stores.bind_path((@r).store_nr, std::path::Path::new(@path))"
#impure(io)

// Load a persisted store IMAGE fully into memory, populating the empty
// store-rooted collection `r` so it can be queried like any in-memory
// collection.  The portable, read-only counterpart of `store_persist_bind`:
// it HEAP-COPIES the file (no mmap), so it works on EVERY backend — including
// wasm, which has no mmap — but is NOT durable (writes stay in memory and
// never reach the file).  Use it to open a snapshot for querying where
// `store_persist_bind` can't run (a browser / wasm target) or where a durable
// live binding isn't wanted.  Returns `false` on a missing / truncated /
// wrong-format file (no panic; assumes the on-disk layout matches `r`'s
// declared type).  @PLN97 arc G Phase 1 — the whole-file load the browser
// working-set path builds on (loft#522).
//   h: hash<Rec[id]> = []
//   store_load(h, "world.store")   // h now holds the file's records
pub fn store_load(r: reference, path: text) -> boolean fs#read;
#rust"stores.load_path((@r).store_nr, std::path::Path::new(@path))"
#impure(io)

// Load a persisted store IMAGE over HTTP(S) from a TRUSTED source, establishing
// authenticity BEFORE the bytes are adopted: fetch the whole image at `url`,
// verify its SHA-256 against the caller-pinned `sha256` (lowercase hex), and only
// on a match heap-load it into `r` — the bytes never touch disk. A fetch error or
// a hash mismatch REFUSES the load (returns false, loads nothing). The
// fetch→verify→trust discipline the registry install uses, bridged onto the store
// loader; `url` may be `http(s)://` or `file://`. Whole-file counterpart of the
// paged `store_load_key(s)`/`store_load_range` loaders. @PLN97 arc G Phase 0.
//   h: hash<Rec[id]> = []
//   store_load_url(h, "https://cdn.example/world.store", "<sha256-hex>")
pub fn store_load_url(r: reference, url: text, sha256: text) -> boolean fs#read;
#rust"stores.load_url_verified((@r).store_nr, @url, @sha256)"
#impure(io)

// Load a whole store IMAGE over HTTP(S)/file:// from a TRUSTED source into `r` —
// the INSTANT counterpart of store_load_url: skips the SHA-256 pin (you trust the
// origin) for a fast read, but is still structurally validated, so a corrupt or
// malformed image is rejected (false), never adopted. Use store_load_url for an
// untrusted source. @PLN97 arc G Phase 0.
//   world: hash<Rec[id]> = []
//   store_load_url_trusted(world, "https://cdn.internal/world.store")
pub fn store_load_url_trusted(r: reference, url: text) -> boolean fs#read;
#rust"stores.load_url((@r).store_nr, @url)"
#impure(io)

// Load a store IMAGE from a local file that may be UNTRUSTED into `r` — the
// structurally-validated counterpart of store_load. Reads the file and validates
// its block structure BEFORE adoption, so a crafted or corrupt file cannot hang
// (0-size block) or drive a heap over-read; it is rejected (false). store_load is
// faster (validates only in debug) for a file you produced yourself; use this for
// a file whose provenance you don't control. @PLN97 arc G Phase 2.
//   h: hash<Rec[id]> = []
//   if !store_load_untrusted(h, "downloaded.store") { /* rejected — malformed */ }
pub fn store_load_untrusted(r: reference, path: text) -> boolean fs#read;
#rust"stores.load_path_untrusted((@r).store_nr, std::path::Path::new(@path))"
#impure(io)

// Structural integrity check of a store-rooted collection's heap graph: verify
// every internal pointer targets a live record — no dangling / out-of-bounds /
// cyclic edge. Returns true when sound, false (with a reason on stderr) when
// not. The verifier behind the working-set loader's confidence: after any
// `store_load*`, `store_verify(local)` proves the (partial) copy produced a
// structurally valid heap, not one with a pointer left aimed at the source.
//   h: hash<Rec[id]> = []
//   store_load_key(h, "block.store", 42)
//   assert(store_verify(h))   // the load produced a sound heap
pub fn store_verify(r: reference) -> boolean;
#rust"stores.verify_graph_ok(&(@r))"

// Working-set load: fetch ONE integer-keyed entry from a persisted HASH image
// into the empty local hash `local`, reading only the pages the lookup touches
// — not the whole file. The bounded-fetch counterpart of `store_load`, for when
// `local` should hold only the entries actually asked for (a phone pulling the
// few map tiles a route needs from a large block). Returns false when the key
// is absent, the file is unreadable, or the collection is not an integer-keyed
// hash of a FLAT (scalar-field) struct. @PLN97 arc G (loft#522).
//   tiles: hash<Tile[id]> = []
//   store_load_key(tiles, "block.store", 42)   // tiles now holds entry 42 only
pub fn store_load_key(local: reference, path: text, key: integer) -> boolean fs#read;
#rust"stores.load_key(&(@local), @path, @key)"
#impure(io)

// Text-keyed form of `store_load_key`: fetch ONE entry from a persisted
// `hash<T[textkey]>` (a place-name / string-id index) into `local`, reading only
// the pages the lookup touches. Returns false when the key is absent or the
// collection isn't a copyable text-keyed hash. @PLN97 arc G (loft#522).
//   places: hash<Place[name]> = []
//   store_load_key_text(places, "gazetteer.store", "Amsterdam")
pub fn store_load_key_text(local: reference, path: text, key: text) -> boolean fs#read;
#rust"stores.load_key_text(&(@local), @path, @key)"
#impure(io)

// Plural form of `store_load_key`: fetch the given integer keys' entries into
// `local` in one call (the paged reader is opened once and its cache reused),
// returning how many were found. Keys absent from the remote are skipped. Same
// FLAT-struct restriction. @PLN97 arc G (loft#522).
//   tiles: hash<Tile[id]> = []
//   got = store_load_keys(tiles, "block.store", [7, 13, 42])   // got == 3
pub fn store_load_keys(local: reference, path: text, keys: vector<integer>) -> integer fs#read;
#rust"stores.load_keys_vec(&(@local), @path, &(@keys))"
#impure(io)

// Range form: fetch every entry whose integer key is in [lo, hi] from a
// persisted `sorted<T[k]>` into `local`, reading only the pages the range walk
// touches — the ordered-collection counterpart of `store_load_keys` (a phone
// pulling the corridor of map tiles a route crosses). Returns the count loaded.
// @PLN97 arc G (loft#522).
//   tiles: sorted<Tile[tkey]> = []
//   store_load_range(tiles, "block.store", lo_cell, hi_cell)
pub fn store_load_range(local: reference, path: text, lo: integer, hi: integer) -> integer fs#read;
#rust"stores.load_range(&(@local), @path, @lo, @hi)"
#impure(io)

// Truncates or extends the file to `size` bytes. Returns FileResult.Ok, or an
// error variant (IsDirectory / NotFound / Other).
pub fn set_file_size(self: File, size: integer) -> FileResult fs#update {
  if self.format == Format.Directory { return FileResult.IsDirectory }
  if self.format == Format.NotExists { return FileResult.NotFound }
  if size < 0 { return FileResult.Other }
  if OpTruncateFile(self, size) { return FileResult.Ok }
  FileResult.Other
}
#impure(io)
// Flushes buffered bytes for self to the underlying storage so that the
// preceding writes are durable. Use between log records or block
// boundaries to guarantee that earlier appends have landed on disk
// before later ones are issued.

pub fn sync(self: File) -> boolean fs#update {
  if self.format == Format.Directory { return false }
  if self.format == Format.NotExists { return false }
  OpSyncFile(self)
}
#impure(io)
// Returns the entries inside a directory.
// The File must have format == Format.Directory.
// Use to iterate over all files in a folder.

pub fn files(self: File) -> vector<File> fs#read {
  result = [];
  if self.format == Format.Directory { OpGetDir(self.path, result); }
  result
}
#impure(io)
// Raw text write returning whether the OS write succeeded — internal; `write`
// wraps it in a FileResult.
fn write_text_raw(file: File, v: text) -> boolean fs#update;
#rust"{{ let __wf_v = @v; stores.write_file(&@file, __wf_v) }}"
#impure(io)
// Writes v as UTF-8 text to the file, overwriting existing content.  Returns
// FileResult.Ok on success and FileResult.Other on an OS write failure (disk
// full, permission denied, a bad path) — a failed write is OBSERVABLE, not
// silently swallowed.  Discarding callers (`f.write(s)` as a statement) are
// unaffected; check with `f.write(s).ok()` or match the result.
pub fn write(self: File, v: text) -> FileResult fs#update {
  if write_text_raw(self, v) { FileResult.Ok } else { FileResult.Other }
}
#impure(io)
// --- Environment ---
// Returns all environment variables as a vector of EnvVariable records (fields: name, value).
// Use to inspect or forward the full environment.

pub fn env_variables() -> vector<EnvVariable> env#read;
#rust"stores.os_variables()"
#impure(host_io)
// Returns the value of the environment variable name, or null if it is not set.
// Use to read configuration from the shell environment.
pub fn env_variable(name: text) -> text env#read;
#rust"stores.os_variable(@name)"
#impure(host_io)
// Pops the next pending host message as one text; empty when there is none.
// The source is per-target: stdin (read once, to EOF) on native and
// --native-wasm (WASI); the JS host's input QUEUE on --html — seed it with
// globalThis.loftInput before loft_start, and push live messages any time
// with globalThis.loftPush(msg) (e.g. fetch() completions).  Use for a
// headless compute module or a polled input loop — the inbound mirror of
// host_output.  The engine only moves opaque bytes; the program parses them.
pub fn host_input() -> text;
#rust"stores.host_input_native()"
#impure(host_io)
// Sends one STRUCTURED message to the host shell — the outbound mirror of
// host_input, distinct from user-facing print.  Per target: a line on stderr
// (native and WASI — the invoking process can script it); the page's
// globalThis.loftOutput(msg) handler on --html.  The browser pattern for
// loft-initiated work: host_output a request (e.g. "fetch <url>"), the JS
// shell acts on it, and pushes the completion back via loftPush for
// host_input to pop — JS owns the network, loft stays pure compute.
pub fn host_output(msg: text);
#rust"stores.host_output_native(@msg)"
#impure(host_io)
// --- Time ---
// Returns the current wall-clock time as milliseconds since the Unix epoch
// (00:00 UTC on 1 Jan 1970). Use for timestamps and logging.
pub fn now() -> integer;
#impure(host_io)
// Returns microseconds elapsed since program start (monotonic clock).
// Unaffected by system clock adjustments. Use for benchmarks and frame timing.
pub fn ticks() -> integer;
#impure(host_io)
// --- Memory diagnostics ---
// Returns a multi-line snapshot of all LIVE stores' internal memory
// utilisation: total capacity vs actual claimed data vs free space,
// record + free-block counts, mergeable adjacent-free pairs (free
// neighbours that should have coalesced), and the largest stores by
// capacity with their creation site (`bc:<pos>` — a bytecode position on
// the interpreter; 0 on --native) and type name.  Use to watch memory
// growth in a running program.
pub fn store_memory() -> text;
#rust"stores.memory_report()"
#impure(host_io)

// --- Vector operations (T2-8, T2-5) ---
// reverse(v) and sort(v) are compiler special-cased in parse_call.
fn OpReverseVector(r: vector, size: const u16);
#rust"vector::reverse_vector(&@r, u32::from(@size), &mut s.database.allocations);"
fn OpSortVector(r: vector, db_tp: const u16);
#rust"{{ let t = @db_tp; if stores.is_text_type(t) {{ vector::sort_text_vector(&@r, &mut stores.allocations); }} else {{ let elem_size = stores.size(t); let is_float = t == 2 || t == 3; vector::sort_vector(&@r, elem_size, is_float, &mut stores.allocations); }} }}"

// CO1.2: Coroutine opcodes
fn OpCoroutineCreate(d_nr: const integer, args_size: const u16, to: const integer);
#rust"s.coroutine_create(@d_nr as u32, u32::from(@args_size), @to as u32);"
fn OpCoroutineNext(value_size: const u16);
#rust"s.coroutine_next(u32::from(@value_size & 0xFF));"

// CO1.3a: Coroutine return — exhaust frame, push null, return to consumer
fn OpCoroutineReturn(value_size: const u16);
#rust"s.coroutine_return(u32::from(@value_size));"

// CO1.3b: Yield — suspend generator, return value to consumer
fn OpCoroutineYield(value_size: const u16);
#rust"s.coroutine_yield(u32::from(@value_size));"

// CO1.6: Coroutine stdlib opcodes
fn OpCoroutineExhausted(gen: reference) -> boolean;
#rust"s.coroutine_exhausted(&@gen)"

// A5.6-1: Push 20-byte fn-ref slot (d_nr + closure DbRef) from frame variable at pos.
// WARNING (C40): declared as `text` (16B Str) but actually holds [d_nr:i64 8B][closure:DbRef 12B] = 20B post-2c.
// The C30 guard in src/state/debug.rs:log_step prevents SIGSEGV when the debug logger
// tries to display this attribute.  Do NOT remove that guard without fixing this type.
// @PLAN53 cluster 4: move the slot as MaybeUninit bytes, NOT [u8; 20].  The closure
// DbRef's 2-byte tail padding (slot bytes 18..20) is never written by the typed DbRef
// store, so reading the slot as a [u8; 20] integer array is UB (Miri: uninit at [18]).
// MaybeUninit copies the bytes without requiring them initialised — byte-identical.
fn OpVarFnRef(pos: const u16) -> text;
#rust"*s.get_var::<[std::mem::MaybeUninit<u8>; 20]>(@pos)"
// A5.6-1: Pop 20-byte fn-ref value from stack into frame variable at pos.
// WARNING (C40): same type mismatch as OpVarFnRef above — see C30 guard.
// @PLAN53 cluster 4: MaybeUninit, not [u8; 20] — see OpVarFnRef above.
fn OpPutFnRef(pos: const u16, _fnref: text);
#rust"{{ let v = *s.get_stack::<[std::mem::MaybeUninit<u8>; 20]>(); s.put_var(@pos, v); }}"
// Push a pre-built constant's DbRef from the constant store.
// `s.const_ref_at(...)` (vs raw `s.const_refs[...]` indexing) lets the
// native-codegen substitution rename to `stores.const_ref_at_runtime(`,
// which breaks the substring chain that would otherwise let nested
// templates accumulate `stor` prefixes when this op is composed inside
// another (e.g. OpGetVector wrapping OpConstRef).  @P275 fix.
fn OpConstRef(d_nr: const integer) -> reference;
#rust"s.const_ref_at(@d_nr as usize)"
// Push a Str pointing into the constant store for integer string literals.
fn OpConstStoreText(rec: const integer, pos: const integer) -> text;
#rust"s.string_from_const_store(@rec as u32, @pos as u32)"

// ── Path helpers (moved from 03_text.loft so they're available
//    before file-I/O code that wants to compose them) ─────────
//
// loft treats paths as plain text; this group adds the most-needed path
// operations (dir_of / basename / resolve_relative) as methods on text.
// Pure-loft, slash-separated; Windows backslash normalisation is out of scope.
// `starts_with` / `ends_with` are dependencies of `join` /
// `resolve` so they also live here (was 03_text.loft).

// Returns true if self begins with value. Use for prefix matching (e.g., protocol detection).
pub fn starts_with(self: text, value: text) -> boolean;
#rust"@self.starts_with(@value)"
#pure
// Returns true if self ends with value. Use for suffix matching (e.g., file extension checks).
pub fn ends_with(self: text, value: text) -> boolean;
#rust"@self.ends_with(@value)"
#pure

// Directory part of a path — strips the trailing `/<segment>`.
//   "doc/claude/PROBLEMS.md".dir() → "doc/claude"
//   "CLAUDE.md".dir()              → ""   (no `/`)
//   "/etc/passwd".dir()            → "/etc"
//   "".dir()                        → ""
pub fn dir(self: text) -> text {
  n = self.size();
  i = n;
  while i > 0 {
    if self[i - 1] == '/' { return self[0..i - 1]; }
    i = i - 1;
  }
  ""
}
#pure
// Last segment of a path — the part after the trailing `/`.
//   "doc/claude/PROBLEMS.md".basename() → "PROBLEMS.md"
//   "CLAUDE.md".basename()              → "CLAUDE.md"
//   "/foo/".basename()                   → ""    (trailing slash)
//   "".basename()                        → ""
pub fn basename(self: text) -> text {
  n = self.size();
  i = n;
  while i > 0 {
    if self[i - 1] == '/' { return self[i..n]; }
    i = i - 1;
  }
  self
}
#pure
// Join two paths — `self/other` with a single `/` separator.
// Special cases:
//   - other starts with `/` (absolute) → return other unchanged
//   - self is empty                     → return other
//   - self ends with `/`                → no extra separator inserted
pub fn join(self: text, other: text) -> text {
  if other.starts_with("/") { return other; }
  if self == "" { return other; }
  if self.ends_with("/") { return "{self}{other}"; }
  "{self}/{other}"
}
#pure
// Resolve `target` against `self` (where self is a base directory).
// Strips leading `./` repeatedly; each `../` segment trims the last
// component from `self`.  Mirrors scan.loft's `resolve_link_path`.
//   "doc/claude".resolve("../README.md")     → "doc/README.md"
//   "doc/claude".resolve("./PROBLEMS.md")    → "doc/claude/PROBLEMS.md"
//   "a/b/c".resolve("../../x")               → "a/x"
//   "".resolve("foo")                        → "foo"
pub fn resolve(self: text, target: text) -> text {
  base = self;
  t = target;
  // Strip leading `./` repeatedly.
  while t.size() >= 2 && t[0] == '.' && t[1] == '/' { t = t[2..t.size()]; }
  // Apply `../` segments — each one walks up the base dir.
  while t.size() >= 3 && t[0] == '.' && t[1] == '.' && t[2] == '/' {
    bn = base.size();
    cut = bn;
    walked = false;
    while cut > 0 {
      if base[cut - 1] == '/' {
        cut = cut - 1;
        walked = true;
        break;
      }
      cut = cut - 1;
    }
    if walked { base = base[0..cut]; } else { base = ""; }
    t = t[3..t.size()];
  }
  if base == "" { return t; }
  "{base}/{t}"
}
#pure
