// Benchmark 6: Newton's method square root (1 million calls)
fn newton_sqrt(x: float) -> float {
  guess = x / 2.0;
  for _ in 0..50 {
    // `guess` is a variable divisor, so `x / guess` is `float?` (C80) and storing it
    // back into a non-null `float` is refused.  Discharge at the division, where the
    // null is produced: `guess` is seeded at `x / 2.0` and only ever averaged with a
    // positive quotient, so it is never zero and the default never fires (loft#859).
    guess = (guess + (x / guess)?) / 2.0;
  }
  guess
}

fn main() {
  n = 1000000;
  t0 = ticks();
  acc = 0.0;
  for nw_j in 0..n {
    acc += newton_sqrt((nw_j + 1) as float);
  }
  ms = (ticks() - t0) / 1000;
  println("result: {round(acc)}  time: {ms}ms");
}
