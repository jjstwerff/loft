// Generate doc/examples.js from tests/docs/*.loft and examples/*.loft.
// Run: loft scripts/build-playground-examples.loft
//
// Three artefacts feed the playground site:
//   EXAMPLES         — { key: source-code } map (consumed by playground.html)
//   EXAMPLE_LIST     — flat [{ key, name, desc }] list (back-compat)
//   EXAMPLE_GROUPS   — [{ group, items: [{ key, name, desc }] }] for the
//                      examples.html and docs.html landing pages.
//
// Examples (examples/*.loft) come first; doc tests (tests/docs/*.loft) follow.

// @PLN9: this is a repo-root build tool — its file() paths (`examples/`,
// `tests/docs/`, `doc/examples.js`) are relative to the working directory it is
// run from (the repo root), not to the script's own location.  `#cwd` opts out
// of the program-relative default so those paths resolve against the cwd.
#cwd

fn json_escape(s: text) -> text {
  r = "";
  for c in s {
    if c == '\\' { r += "\\\\"; }
    else if c == '"' { r += "\\\""; }
    else if c == '\n' { r += "\\n"; }
    else if c == '\t' { r += "\\t"; }
    else { r += "{c}"; }
  }
  r
}

fn pretty_example_name(base: text) -> text {
  // examples/*.loft don't carry @NAME headers — the filename is the
  // identity, but the playground dropdown reads better with a few
  // human-friendly labels.
  if base == "hello" { return "Hello world"; }
  if base == "fibonacci" { return "Fibonacci"; }
  if base == "fizzbuzz" { return "FizzBuzz"; }
  if base == "structs" { return "Structs"; }
  if base == "collections" { return "Collections"; }
  if base == "match" { return "Pattern matching"; }
  if base == "files" { return "File I/O"; }
  base
}

// @FTR-082 — the doc pages turned into the artefact the site serves, generated from the
// same `tests/docs/*.loft` files CI runs, so a page and its example cannot disagree
fn main() {
  out = file("doc/examples.js");
  // `+=` is append-only — truncate explicitly so re-runs do not pile
  // up successive copies of the JSON map.
  //
  // Every block below ends its last content line with an explicit `\n`.  A backtick
  // block drops its closing line when that line holds only whitespace, so the newline
  // between two appends has to be WRITTEN — it is not layout.  Until loft#990 a block
  // containing a `{…}` kept its closing line verbatim and this file inherited the
  // newlines from it, which is why they were not here.
  out.set_file_size(0);
  out += `
    // Auto-generated — regenerate with: loft scripts/build-playground-examples.loft
    export const EXAMPLES = {{\n
  `;

  // Pass 1 — examples/.  Builds source-code JSON pairs into out, and
  // the [{key,name,desc}] list separately so EXAMPLE_GROUPS can
  // reference each pass independently below.
  examples_list = "";
  examples_count = 0;
  for f in file("examples").files() {
    path = "{f.path}";
    if !path.ends_with(".loft") or path.ends_with("/.loft") { continue; }
    base = path[path.find("/") + 1..path.len() - 5];
    if base.find("/") >= 0 { base = base[base.find("/") + 1..]; }
    name = pretty_example_name(base);
    code = "";
    desc = "";
    for line in f.lines() {
      // Build the description from the leading prose-comment block,
      // skipping the "<file>.loft — short title" header-line and any
      // metadata.  This is independent of the source preserved in
      // `code` — every line of the file (including the comments)
      // ends up in the editor so the playground matches what the
      // user sees on GitHub.
      if desc.len() < 200 and line.len() > 3 and line.starts_with("// ") {
        body = line[3..];
        if !body.contains(".loft —") and !body.starts_with("@") and !body.contains("Copyright") and !body.contains("SPDX") {
          if desc.len() == 0 {
            desc = body;
          } else if desc.len() < 200 {
            desc += " ";
            desc += body;
          }
        }
      }
      if code.len() > 0 { code += "\n"; }
      code += line;
    }
    key = "ex_{base.to_lowercase().replace(" ", "_")}";
    out += `
      "{key}": "{json_escape(code)}",\n
    `;
    examples_list += `
      {{ key: "{key}", name: "{name}", desc: "{json_escape(desc)}" }},\n
    `;
    examples_count += 1;
  }

  // Pass 2 — tests/docs/.  Same shape but reads @NAME: from the
  // header block, falls back to basename, and uses the @TITLE:
  // line as the description (or the first prose line below if
  // @TITLE: is missing).
  docs_list = "";
  docs_count = 0;
  for f in file("tests/docs").files() {
    path = "{f.path}";
    if !path.ends_with(".loft") or path.ends_with("/.loft") { continue; }
    base = path[path.find("/") + 1..path.len() - 5];
    if base.find("/") >= 0 { base = base[base.find("/") + 1..]; }
    name = base;
    code = "";
    desc = "";
    for line in f.lines() {
      np = line.find("@NAME:");
      if np >= 0 { name = line[np + 7..]; }
      tp = line.find("@TITLE:");
      if tp >= 0 { desc = line[tp + 8..]; }
      // Fallback description: first prose line after the metadata.
      if desc.len() == 0 and line.len() > 3 and line.starts_with("// ") {
        body = line[3..];
        if !body.starts_with("@") and !body.contains("Copyright") and !body.contains("SPDX") {
          desc = body;
        }
      }
      // Strip the test-fixture boilerplate from the editor source —
      // Copyright + SPDX + every `@FIELD:` directive.  Everything
      // else (prose comments, code) is preserved so the playground
      // matches what's at tests/docs/ on GitHub.
      if line.contains("Copyright") or line.contains("SPDX-License-Identifier") { continue; }
      if line.starts_with("// @") { continue; }
      if code.len() > 0 { code += "\n"; }
      code += line;
    }
    key = name.to_lowercase().replace(" ", "_");
    out += `
      "{key}": "{json_escape(code)}",\n
    `;
    docs_list += `
      {{ key: "{key}", name: "{name}", desc: "{json_escape(desc)}" }},\n
    `;
    docs_count += 1;
  }

  out += `
    }};
    export const EXAMPLE_LIST = [\n
  `;
  out += examples_list;
  out += docs_list;
  out += `
    ];
    // EXAMPLE_GROUPS shape consumed by examples.html, docs.html,
    // and playground.html — one entry per category.  "Examples"
    // first so first-time visitors land on the friendly tour.
    export const EXAMPLE_GROUPS = [
      {{ group: "Examples", items: [\n
  `;
  out += examples_list;
  out += `
      ] }},
      {{ group: "Documentation", items: [\n
  `;
  out += docs_list;
  out += `
      ] }},\n
    ];\n
  `;
  println("Generated doc/examples.js — {examples_count} examples + {docs_count} doc tests");
}
