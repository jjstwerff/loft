// Generate doc/gallery-examples.js from tools/<dir>/*.loft entrypoints.
// Run: loft scripts/build-gallery-examples.loft
//
// Each gallery example lives in its own `tools/<name>/` subdir with a
// loft.toml and an entrypoint .loft file (the gallery showpiece —
// `tools/brick-buster/25-brick-buster.loft` — is the canonical case).
// The script scans `tools/*/` for `*.loft` files; the basename (minus
// `.loft`) becomes the gallery key, which gallery.html bins into
// ranges by leading numeric prefix.
//
// Per-file extraction:
//   Line 2  →  title (strips "// " prefix)
//   "// Demonstrates:" or "// Features:" line  →  short description
//   Full source becomes the gallery preview.

// @PLN9: this is a repo-root build tool — its file() paths (`tools/`,
// `doc/gallery-examples.js`) are relative to the working directory it is run
// from (the repo root), not to the script's own location.  `#cwd` opts out of
// the program-relative default so those paths resolve against the cwd.
#cwd

fn escape_js(s: text) -> text {
  r = "";
  for c in s {
    if c == '\\' { r += "\\\\"; }
    else if c == '"' { r += "\\\""; }
    else if c == '\n' { r += "\\n"; }
    else if c == '\r' { r += ""; }
    else if c == '\t' { r += "\\t"; }
    else { r += "{c}"; }
  }
  r
}

fn extract_title(line: text) -> text {
  if !line.starts_with("// ") { return line; }
  line[3..]
}

fn basename_noext(path: text) -> text {
  result = path;
  for c in path {
    if c == '/' { result = path[c#next..]; }
  }
  if result.ends_with(".loft") { result = result[..result.len() - 5]; }
  result
}

fn main() {
  parent = file("tools");
  out = file("doc/gallery-examples.js");

  keys: vector<text> = [];
  titles: vector<text> = [];
  descs: vector<text> = [];
  sources: vector<text> = [];

  for sub in parent.files() {
    if sub.format != Format.Directory { continue; }
    for ef in sub.files() {
      if !ef.path.ends_with(".loft") { continue; }
      key = basename_noext(ef.path);
      // Gallery convention: only files whose basename starts with `<digits>-`
      // are gallery entries.  This filters out misc dev tools under
      // tools/<name>/ (servers, probes, helpers) that aren't showpieces.
      if key.len() < 3 { continue; }
      if key[0] < '0' || key[0] > '9' { continue; }

      lines = ef.lines();
      title = key;
      desc = "";
      source = "";

      for li in 0..len(lines) {
        line = lines[li];
        if li == 0 && line.starts_with("#!") { continue; }
        if li == 1 { title = extract_title(line); }
        if line.starts_with("// Demonstrates:") { desc = trim(line[17..]); }
        else if line.starts_with("// Features:") && desc == "" { desc = trim(line[13..]); }
        source += line + "\n";
      }

      keys += [key];
      titles += [title];
      descs += [desc];
      sources += [source];
    }
  }

  nl = "\n";
  result = "// Auto-generated by: loft scripts/build-gallery-examples.loft" + nl;
  result += "export const GALLERY_EXAMPLES = {{" + nl;

  for i in 0..len(keys) {
    if i > 0 { result += "," + nl; }
    k = keys[i];
    s = escape_js(sources[i]);
    result += "  \"{k}\": \"{s}\"";
  }
  result += nl + "}};" + nl + nl + "export const GALLERY_LIST = [" + nl;

  for i in 0..len(keys) {
    t = titles[i];
    d = escape_js(descs[i]);
    k = keys[i];
    if i > 0 { result += "," + nl; }
    result += "  {{ key: \"{k}\", name: \"{t}\", desc: \"{d}\" }}";
  }
  result += nl + "];" + nl;

  out.write(result);
  println("Generated doc/gallery-examples.js with {len(keys)} examples");
}
