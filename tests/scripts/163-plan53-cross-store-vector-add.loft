// 163 — @PLAN53 cluster 3: regression guard for the cross-store aliasing UB.
//
// Bug (fixed in commit c7755122): `vector_add` (and three sibling sites in
// `claim_child_rec` / `vector_add_array` / `copy_claims::ChildRec`) formed a
// shared `&[Store]` (from_ref) AND a `&mut [Store]` (from_mut) over the same
// `self.allocations` slice simultaneously, keeping both live across
// `copy_block_between`.  This is UB even though the two borrows target
// distinct store indices — Miri's Stacked Borrows rejects the overlapping
// whole-slice borrows.
//
// Trigger (cluster 3a — vector_add cross-store):
// Two distinct instances of the same struct type each live in their own
// store.  Appending one instance's vector field to the other's (`c1.data +=
// c2.data`) calls `Stores::vector_add(v_r=c1.data, v_other=c2.data, ...)`.
// Since `v_r.store_nr != v_other.store_nr`, the `else` branch executes the
// `copy_block_cross_store` helper (post-fix) instead of the aliasing
// reborrow (pre-fix).
//
// Guard: on the pre-fix code, Miri aborts with a Stacked-Borrows violation.
// On the fixed code (`get_disjoint_mut`), this runs cleanly.

struct Bag {
  data: vector<integer>,
}

fn main() {
  c1 = Bag { data: [1, 2, 3] };
  c2 = Bag { data: [40, 50] };

  // Cross-store vector append: c1 lives in store A, c2 in store B.
  // vector_add sees v_r.store_nr != v_other.store_nr -> cross-store path.
  c1.data += c2.data;

  assert(len(c1.data) == 5, "len after cross-store append: got {len(c1.data)}, want 5");
  assert(c1.data[0] == 1, "c1.data[0]={c1.data[0]}, want 1");
  assert(c1.data[2] == 3, "c1.data[2]={c1.data[2]}, want 3");
  assert(c1.data[3] == 40, "c1.data[3]={c1.data[3]}, want 40");
  assert(c1.data[4] == 50, "c1.data[4]={c1.data[4]}, want 50");

  // c2 must be undisturbed (the append must not consume c2's data).
  assert(len(c2.data) == 2, "c2 len after append: got {len(c2.data)}, want 2");
  assert(c2.data[0] == 40, "c2.data[0]={c2.data[0]}, want 40");
  assert(c2.data[1] == 50, "c2.data[1]={c2.data[1]}, want 50");

  // Second cross-store append to exercise the path again.
  c3 = Bag { data: [100, 200] };
  c1.data += c3.data;
  assert(len(c1.data) == 7, "len after 2nd append: got {len(c1.data)}, want 7");
  assert(c1.data[5] == 100, "c1.data[5]={c1.data[5]}, want 100");
  assert(c1.data[6] == 200, "c1.data[6]={c1.data[6]}, want 200");

  println("163-plan53-cross-store-vector-add PASSED");
}
