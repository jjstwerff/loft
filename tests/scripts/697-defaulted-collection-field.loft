//
// Regression (loft#697): a struct field of COLLECTION type carrying a default, omitted
// from a literal, corrupted the record.
//
// A field MENTIONED in a literal is primed first — the mentioned-field path emits
// `OpSetInt4(pos, 0)` to zero the collection's 4-byte header before anything writes
// through it (`sinks.vector_headers`, #437).  A field left to its DEFAULT never reached
// that code, so its header kept whatever bytes the record happened to hold, and the first
// read of ANY field followed a garbage rec number.  `object_init` now primes it too.
//
// The empty default `= []` also has to STOP there: it parses to `Insert([Null])`, and
// letting that through emitted `OpAppendVector(field, null)` — appending the Null as an
// element, which is the garbage the reader then walked.  The zeroed header already IS the
// empty collection.
//
// The symptom moved around, which is why the axes below matter more than any one case:
// a panic with an index that CHANGED RUN TO RUN (`len is 3 but the index is 56020`, then
// 25588, then 12148), a SIGSEGV one struct deeper, and on `--native` a generated-code type
// error (`expected &DbRef, found &()`) rather than a crash.
//
// Axes: the collection KIND (vector, hash), whether another collection field exists,
// nesting DEPTH (the defaulted field one struct down), and the controls — a field the
// literal SUPPLIES, and a defaulted `text`, which was never affected because it is not
// header-shaped.
//
// Not covered here, because it is refused at compile time: a NON-EMPTY collection default
// (`= [1, 2]`).  Its building block carries work-refs numbered in the var space the
// DEFAULT was parsed in, not the one it is replayed in, so applying it re-allocated the
// struct mid-construction.  `tests/scripts/102-expected-errors.loft` pins the refusal.

struct It697  { it_a: integer, it_b: integer }
struct Kv697  { kv_k: integer, kv_a: integer }

// The reported shape: a defaulted vector beside another vector field.
struct Bag697 { bg_x: integer, bg_items: vector<It697>, bg_ids: vector<integer> = [] }

// The defaulted collection is the ONLY collection — no second vector to blame.
struct Solo697 { so_x: integer, so_ids: vector<integer> = [] }

// A KEYED collection default failed identically.
struct Keyed697 { ky_x: integer, ky_h: hash<Kv697[kv_k]> = [] }

// The defaulted field one struct DOWN — this one SIGSEGV'd rather than panicking.
struct Inner697 { in_q: integer, in_ids: vector<integer> = [] }
struct Outer697 { ou_x: integer, ou_inner: Inner697 }

// Two defaulted collections in one record, so the priming of one cannot be reading
// the other's header.
struct Two697 { tw_x: integer, tw_a: vector<integer> = [], tw_b: vector<integer> = [] }

// A defaulted collection declared BEFORE the supplied one — field order is not the axis,
// but the report raised it, so pin it.
struct Order697 { or_ids: vector<integer> = [], or_x: integer, or_items: vector<It697> }

// Controls: `text` is not header-shaped and never broke; a defaulted scalar likewise.
struct Ctl697 { ct_x: integer, ct_s: text = "d", ct_n: integer = 7 }

fn main() {
  // The reported repro: omitting `bg_ids` must leave the OTHER fields readable.
  b = Bag697 { bg_x: 1, bg_items: [It697 { it_a: 7, it_b: 40 }] };
  assert(b.bg_items[0].it_a == 7, "sibling field a survives, got {b.bg_items[0].it_a}");
  assert(b.bg_items[0].it_b == 40, "sibling field b survives, got {b.bg_items[0].it_b}");
  assert(b.bg_x == 1, "scalar field survives, got {b.bg_x}");
  assert(len(b.bg_ids) == 0, "the defaulted vector is EMPTY, got {len(b.bg_ids)}");

  // …and it must still be usable as a vector afterwards, not merely readable.
  b.bg_ids += [5];
  assert(len(b.bg_ids) == 1, "the defaulted vector accepts an append, got {len(b.bg_ids)}");
  assert(b.bg_ids[0] == 5, "and holds what was appended, got {b.bg_ids[0]}");

  // Supplying the same field explicitly is the control — this always worked.
  c = Bag697 { bg_x: 2, bg_items: [It697 { it_a: 8, it_b: 50 }], bg_ids: [] };
  assert(c.bg_items[0].it_a == 8, "control, supplied []: got {c.bg_items[0].it_a}");
  assert(len(c.bg_ids) == 0, "control, supplied [] is empty");

  // No second collection field to blame.
  s = Solo697 { so_x: 3 };
  assert(s.so_x == 3, "solo scalar survives, got {s.so_x}");
  assert(len(s.so_ids) == 0, "solo defaulted vector is empty, got {len(s.so_ids)}");

  // A keyed collection default.
  k = Keyed697 { ky_x: 4 };
  assert(k.ky_x == 4, "keyed: scalar survives, got {k.ky_x}");
  k.ky_h += Kv697 { kv_k: 1, kv_a: 9 };
  kr = k.ky_h[1];
  assert(kr != null, "keyed: the defaulted hash accepts an insert");
  assert(kr.kv_a == 9, "keyed: and reads back, got {kr.kv_a}");

  // One struct deeper — the SIGSEGV shape.
  o = Outer697 { ou_x: 5, ou_inner: Inner697 { in_q: 6 } };
  assert(o.ou_x == 5, "nested: outer scalar survives, got {o.ou_x}");
  assert(o.ou_inner.in_q == 6, "nested: inner scalar survives, got {o.ou_inner.in_q}");
  assert(len(o.ou_inner.in_ids) == 0, "nested: defaulted vector is empty");

  // Two defaulted collections in one record.
  t = Two697 { tw_x: 7 };
  assert(t.tw_x == 7, "two: scalar survives, got {t.tw_x}");
  assert(len(t.tw_a) == 0 && len(t.tw_b) == 0, "two: both defaulted vectors are empty");
  t.tw_a += [1];
  assert(len(t.tw_a) == 1 && len(t.tw_b) == 0, "two: they are separate collections");

  // The defaulted field declared first.
  r = Order697 { or_x: 8, or_items: [It697 { it_a: 9, it_b: 60 }] };
  assert(r.or_x == 8, "order: scalar survives, got {r.or_x}");
  assert(r.or_items[0].it_b == 60, "order: supplied vector survives, got {r.or_items[0].it_b}");
  assert(len(r.or_ids) == 0, "order: leading defaulted vector is empty");

  // Controls that were never affected.
  w = Ctl697 { ct_x: 9 };
  assert(w.ct_x == 9, "control scalar, got {w.ct_x}");
  assert(w.ct_s == "d", "control defaulted text, got {w.ct_s}");
  assert(w.ct_n == 7, "control defaulted scalar, got {w.ct_n}");

  println("697-defaulted-collection-field ok");
}
