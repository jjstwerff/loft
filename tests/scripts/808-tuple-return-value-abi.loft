// loft#808 — a pure-value tuple RETURN keeps Rust's tuple ABI; only a par worker's is
// boxed into the synthetic `__tuple<…>` record.  Boxing every tuple return made the
// SAME arithmetic ~5.6x slower for crossing a function boundary, because each call
// claimed and freed a store record to carry three floats home.
//
// The cells below are the boundary this rests on: which element kinds survive the
// unboxed round-trip, which tail shapes deliver a value on both branches, where the
// tuple is consumed, and which shapes must still be boxed.  Values are distinctive so
// a shifted element reads as a wrong number rather than a plausible one.

// --- element kinds -------------------------------------------------------------
fn e_int() -> (integer, integer) { (7, 14) }
fn e_float() -> (float, float) { (1.5, 3.0) }
fn e_mixed() -> (integer, float) { (7, 7.5) }
fn e_bool() -> (boolean, boolean) { (true, false) }
// Character and payload-less Enum are the two `emit_tuple_null_init` was missing:
// boxed, the return never became a tuple LOCAL, so null-init never saw them.
fn e_char() -> (character, character) { ('a', 'z') }
enum E808Colour { E808Red, E808Green, E808Blue }
fn e_enum() -> (E808Colour, E808Colour) { (E808Colour.E808Red, E808Colour.E808Blue) }
// Narrow ints: the `+1`-sentinel encodings that once read `(1,2)` back as `(1,3)`.
fn e_narrow() -> (u8, i32) { (200 as u8, -5 as i32) }
// A bare `null` element needs the declared element type's sentinel op.  Shape-only
// tuple conversion emitted NO op for it, so the slot kept stack residue (read 8051).
fn e_optnull() -> (integer?, integer) { (null, 2) }
fn e_optval() -> (integer?, integer) { (9, 2) }

// --- arity and nesting ---------------------------------------------------------
fn a_f3() -> (float, float, float) { (1.0, 2.0, 3.0) }
fn a_i4() -> (integer, integer, integer, integer) { (1, 2, 3, 4) }
fn a_nest_l() -> ((integer, integer), integer) { ((5, 6), 7) }
fn a_nest_r() -> (integer, (float, boolean)) { (1, (2.5, true)) }

// --- tail shapes (the P236 class: every branch must deliver the value) ----------
fn t_if(c: boolean) -> (integer, integer) { if c { (11, 12) } else { (21, 22) } }
fn t_match(n: integer) -> (integer, integer) {
  match n { 0 => (31, 32), 1 => (41, 42), _ => (51, 52) }
}
fn t_block() -> (integer, integer) { x = 61; (x, x + 1) }
fn t_early(c: boolean) -> (integer, integer) {
  if c { return (71, 72); }
  (81, 82)
}

// --- consumer positions ---------------------------------------------------------
struct P808Box { t: (integer, integer) }
fn c_takes(t: (integer, integer)) -> integer { t.0 * 100 + t.1 }
fn c_onward() -> (integer, integer) { t_block() }

// --- shapes that must STAY boxed (`has_lifetime_concern`) -----------------------
struct P808Point { x: integer, y: integer }
fn k_text() -> (integer, text) { (5, "five") }
fn k_ref() -> (P808Point, integer) { (P808Point { x: 3, y: 4 }, 9) }
fn k_vec() -> (vector<integer>, integer) { ([1, 2, 3], 9) }

// --- par workers: still boxed, because par dispatch has no route for a wide tuple -
struct P808Score { value: integer }
fn w_two(s: const P808Score) -> (integer, integer) { (s.value, s.value * 2) }
fn w_three(s: const P808Score) -> (integer, integer, integer) {
  (s.value, s.value * 2, s.value * 3)
}
fn w_nested(s: const P808Score) -> ((integer, integer), integer) {
  ((s.value, s.value * 2), s.value * 3)
}
fn w_plain(s: const P808Score) -> integer { s.value * 10 }

// --- generics -------------------------------------------------------------------
fn g_pair<T>(x: T) -> (T, T) { (x, x) }

fn main() {
  (i0, i1) = e_int();
  assert(i0 == 7 && i1 == 14, "int elems: {i0} {i1}");
  (f0, f1) = e_float();
  assert(f0 == 1.5 && f1 == 3.0, "float elems: {f0} {f1}");
  (m0, m1) = e_mixed();
  assert(m0 == 7 && m1 == 7.5, "mixed elems: {m0} {m1}");
  (b0, b1) = e_bool();
  assert(b0 && !b1, "bool elems: {b0} {b1}");
  (c0, c1) = e_char();
  assert(c0 == 'a' && c1 == 'z', "character elems: {c0} {c1}");
  (u0, u1) = e_enum();
  assert(u0 == E808Colour.E808Red && u1 == E808Colour.E808Blue, "enum elems: {u0} {u1}");
  (n0, n1) = e_narrow();
  assert(n0 == 200 && n1 == -5, "narrow elems: {n0} {n1}");
  (o0, o1) = e_optnull();
  assert((o0 ?? -1) == -1 && o1 == 2, "bare null elem: {o0 ?? -1} {o1}");
  (p0, p1) = e_optval();
  assert((p0 ?? -1) == 9 && p1 == 2, "present nullable elem: {p0 ?? -1} {p1}");

  (g0, g1, g2) = a_f3();
  assert(g0 == 1.0 && g1 == 2.0 && g2 == 3.0, "3-arity: {g0} {g1} {g2}");
  (h0, h1, h2, h3) = a_i4();
  assert(h0 == 1 && h1 == 2 && h2 == 3 && h3 == 4, "4-arity: {h0} {h1} {h2} {h3}");
  nl = a_nest_l();
  assert(nl.0.0 == 5 && nl.0.1 == 6 && nl.1 == 7, "nested left: {nl.0.0} {nl.0.1} {nl.1}");
  nr = a_nest_r();
  assert(nr.0 == 1 && nr.1.0 == 2.5 && nr.1.1, "nested right: {nr.0} {nr.1.0} {nr.1.1}");

  (q0, q1) = t_if(true);
  assert(q0 == 11 && q1 == 12, "if-then tail: {q0} {q1}");
  (r0, r1) = t_if(false);
  assert(r0 == 21 && r1 == 22, "if-else tail: {r0} {r1}");
  (s0, s1) = t_match(0);
  assert(s0 == 31 && s1 == 32, "match arm 0: {s0} {s1}");
  (v0, v1) = t_match(1);
  assert(v0 == 41 && v1 == 42, "match arm 1: {v0} {v1}");
  (w0, w1) = t_match(9);
  assert(w0 == 51 && w1 == 52, "match default arm: {w0} {w1}");
  (x0, x1) = t_block();
  assert(x0 == 61 && x1 == 62, "block tail: {x0} {x1}");
  (y0, y1) = t_early(true);
  assert(y0 == 71 && y1 == 72, "early return: {y0} {y1}");
  (z0, z1) = t_early(false);
  assert(z0 == 81 && z1 == 82, "tail after early return: {z0} {z1}");

  whole = t_block();
  assert(whole.0 == 61 && whole.1 == 62, "whole-tuple local: {whole.0} {whole.1}");
  assert(t_block().0 == 61, "field off the call: {t_block().0}");
  bx = P808Box { t: t_block() };
  assert(bx.t.0 == 61 && bx.t.1 == 62, "tuple struct field: {bx.t.0} {bx.t.1}");
  assert(c_takes(t_block()) == 6162, "tuple as argument: {c_takes(t_block())}");
  (oo0, oo1) = c_onward();
  assert(oo0 == 61 && oo1 == 62, "returned onward: {oo0} {oo1}");
  // A hot loop is where a per-call store claim would show up as a leak.
  loop_sum = 0;
  for i in 0..1000 { (l0, l1) = t_if(i % 2 == 0); loop_sum += l0 + l1; }
  assert(loop_sum == 33000, "1000-call loop: {loop_sum}");

  (ka, kb) = k_text();
  assert(ka == 5 && kb == "five", "boxed text elem: {ka} {kb}");
  (kc, kd) = k_ref();
  assert(kc.x == 3 && kc.y == 4 && kd == 9, "boxed ref elem: {kc.x} {kc.y} {kd}");
  (ke, kf) = k_vec();
  assert(len(ke) == 3 && ke[1] == 2 && kf == 9, "boxed vector elem: {len(ke)} {kf}");

  sl: vector<P808Score> = [P808Score { value: 1 }, P808Score { value: 2 }, P808Score { value: 3 }];
  pa = 0;
  for s in sl par(r = w_two(s), 4) { pa += r.0 + r.1; }
  assert(pa == 18, "par 2-tuple worker: {pa}");
  pb = 0;
  for s in sl par(r = w_three(s), 4) { pb += r.0 + r.1 + r.2; }
  assert(pb == 36, "par 3-tuple worker: {pb}");
  pc = 0;
  for s in sl par(r = w_nested(s), 4) { pc += r.0.0 + r.0.1 + r.1; }
  assert(pc == 36, "par nested-tuple worker: {pc}");
  pd = 0;
  for s in sl par(r = w_plain(s), 4) { pd += r; }
  assert(pd == 60, "par non-tuple worker: {pd}");
  // The same worker called normally: one signature serves both call sites.
  (dc0, dc1) = w_two(P808Score { value: 5 });
  assert(dc0 == 5 && dc1 == 10, "worker called directly: {dc0} {dc1}");

  (ga, gb) = g_pair(3);
  assert(ga == 3 && gb == 3, "generic pair at integer: {ga} {gb}");
  (gc, gd) = g_pair(2.5);
  assert(gc == 2.5 && gd == 2.5, "generic pair at float: {gc} {gd}");
  (ge, gf) = g_pair("hi");
  assert(ge == "hi" && gf == "hi", "generic pair at text: {ge} {gf}");

  println("808-tuple-return-value-abi ok");
}
