//
// @PLN25 #465 root — a vector element type that is FORWARD-REFERENCED (the
// element struct/enum is declared after its use, incl. recursive enums) must
// resolve to the SAME density as a backward-reference: dense for `vector<S>`,
// nullable for `vector<S?>`. The dense flip updated the parse-time chokepoint
// (`e2_nullable_elem`) but the deferred forward-ref resolver
// (`copy_unknown_fields`) still wrapped EVERY forward-ref element in
// `__nullable<S>`. So a `vector<S>` FIELD went nullable (stride 40) while its
// construction stayed dense (stride 32) — an element-stride mismatch that
// corrupted enum-discriminant reads (interp wrong result) and over-freed the
// subject's store (native crash).
//
// Fix: `copy_unknown_fields` resolves a forward-ref element DENSE; the `?`
// opt-in is carried through the forward reference by `e2_nullable_elem`
// registering the `__nullable<S>` synth eagerly (its `Some` payload is
// `Reference(S)`, resolved with S later). Both backends.

// Forward-referenced, recursive, DENSE element (the #465 shape).
enum V {
  CNull, CInt { value: integer }, CMap { entries: vector<Entry> }
}
struct Entry {
  key: V,
  value: integer,
}

fn first_key(m: V) -> integer {
  match m {
    CMap { entries } => {
      match entries[0].key {
        CInt { value } => { value }, _ => { -1 }
      }
    },
    _ => -2,
  }
}

// Forward-referenced, DENSE struct-field element.
struct Holder {
  items: vector<Item>,
}
struct Item {
  v: integer,
}
fn first_item(h: Holder) -> integer {
  h.items[0].v
}

// Forward-referenced, NULLABLE struct-field element (`?` carried through fwd-ref).
struct NHolder {
  nitems: vector<NItem?>,
}
struct NItem {
  v: integer,
}

fn main() {
  es: vector<Entry> = [];
  es += [
    Entry {
      key: CInt { value: 1 },
      value: 9,
    },
  ];
  assert(first_key(CMap { entries: es }) == 1, "fwd-ref dense enum-field element reads correctly");

  xs: vector<Item> = [];
  xs += [
    Item { v: 7 },
  ];
  assert(
    first_item(Holder { items: xs }) == 7,
    "fwd-ref dense struct-field element reads correctly"
  );

  ns: vector<NItem?> = [
    NItem { v: 7 },
    null,
  ];
  nh = NHolder { nitems: ns };
  assert(nh.nitems[0].v == 7, "fwd-ref nullable element: present value intact");
  assert(
    nh.nitems[1] == null,
    "fwd-ref nullable element: null preserved (the `?` survived the fwd-ref)"
  );
}
