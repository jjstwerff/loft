//
// #255 / @PLN9 Phase 0 — `source_dir()` is populated for EVERY execution path
// via the single parser-level home (`Parser::parse`), not per-runner ad-hoc
// code.  Before the fix the wrap/test runners left it empty, so source-relative
// asset resolution (the point of @PLN9) had no anchor under test.
//
// Interpreter-scoped: the `--native` exe-dir anchor and the wasm anchor are
// @PLN9 Phase 1 — until those land, native `source_dir()` returns "" (see
// `Stores::source_dir_native`), so this file is in SCRIPTS_NATIVE_SKIP and
// WASM_SKIP.  Remove it from both when Phase 1 ships the per-backend anchor.
fn main() {
    sd = source_dir();
    assert(sd != "", "source_dir() must be populated under the test runner (was empty)");
    assert(sd.ends_with("scripts"), "source_dir() should be the test file's directory, got [{sd}]");
    print("source_dir=[{sd}]\n");
}
