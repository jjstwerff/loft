//
// A tuple's elements keep their own types through every operation the language offers.
//
// The Tuples chapter opens with "a fixed number of values of possibly different types" and now
// shows a mixed tuple in each operation it teaches. It stops there because the page is read by
// someone meeting tuples for the first time.
//
// This is where the rest lives, and the axis is worth sweeping completely because it is the one
// a tuple corpus reliably misses. Every cell on the chapter used to be `(integer, integer)`, and
// `formal/tuples.md` records the same blind spot in its own oracle — its `OPEN: 0` read clean
// while loft#1004 and loft#1005 were live, because the oracle is all-integer and carries no
// `text`. Its deviations section states the lesson directly: a conformance entry that names one
// member of a family is a claim about that member, not the family.
//
// So the rows below vary the ELEMENT TYPES and hold the operation fixed, which is the opposite
// of how a tuple suite is usually written.
//
// Not covered here, deliberately:
//   - reading a text element of a tuple parameter — `1005-tuple-text-parameter.loft` owns it;
//   - `&` tuples and their refused element types — `1006-reference-tuple-element-types.loft`
//     and `102-expected-errors.loft` own those;
//   - WRITING a text element of a value parameter, which does not compile on --native
//     (loft#1278); the local-copy form that does is below;
//   - YIELDING a tuple with a text element, which --native refuses by design because such a
//     tuple has no transport channel (COROUTINE.md CL-8). An all-scalar tuple yield works on
//     both backends and is what the cell below uses.
//
// @falsified-at: none — this guard states what a boundary IS, and the behaviour has been in
//   this place for as long as the corpus records; there is no build on which it fails, which
//   makes it a LOCK rather than a regression test. Checked by hand in both directions: every
//   assert below was inverted one at a time and each one failed, naming its own row.

struct Holder {
  pair: (integer, text),
}

fn labelled(n: integer) -> (text, integer) {
  if n >= 50 { ("pass", n) } else { ("fail", n) }
}

// An all-scalar tuple yield: a text element has no native transport channel (CL-8).
fn scalar_pairs() -> iterator<(integer, integer)> {
  yield (1, 2);
  yield (3, 4);
}

fn deep() -> (integer, (text, float)) {
  (1, ("inner", 2.5))
}

// Writes to its own copy of a SCALAR element. The text twin of this is loft#1278.
fn doubles_first(p: (integer, integer)) -> integer {
  p.0 = p.0 * 2;
  p.0
}

fn flips(p: (boolean, character)) -> boolean {
  p.0 = !p.0;
  p.0
}

fn scales(p: (float, integer)) -> float {
  p.0 = p.0 * 2.0;
  p.0
}

// The loft#1278 workaround, kept here so the chapter's advice is measured rather than asserted:
// copy the parameter into a local and write the local.
fn renames(p: (integer, text)) -> text {
  q = p;
  q.1 = "changed";
  q.1
}

// --- Construct and project, across element types -------------------------------------------

fn every_element_type_reads_back_as_itself() {
  a = (1, "one");
  assert(a.0 == 1 && a.1 == "one", "integer + text: {a.0},{a.1}");
  b = ("l", "r");
  assert(b.0 == "l" && b.1 == "r", "text + text: {b.0},{b.1}");
  c = (1.5, true);
  assert(c.0 == 1.5 && c.1, "float + boolean: {c.0},{c.1}");
  d = ('x', 7);
  assert(d.0 == 'x' && d.1 == 7, "character + integer: {d.0},{d.1}");
  e = ("x", 2.5, 7);
  assert(e.0 == "x" && e.1 == 2.5 && e.2 == 7, "three kinds: {e.0},{e.1},{e.2}");
}

fn a_tuple_element_may_be_a_tuple() {
  n = (1, (2, 3));
  assert(n.1.0 == 2 && n.1.1 == 3, "nested integers: {n.1.0},{n.1.1}");
  m = ((1, "a"), ("b", 2.5));
  assert(m.0.1 == "a" && m.1.0 == "b" && m.1.1 == 2.5, "nested mixed: {m.0.1},{m.1.0},{m.1.1}");
  d = deep();
  assert(d.1.0 == "inner" && d.1.1 == 2.5, "returned nested mixed: {d.1.0},{d.1.1}");
}

// --- Modify -----------------------------------------------------------------------------------

fn writing_one_element_leaves_the_others_alone() {
  t = (1, "one", 2.5);
  t.0 = 99;
  assert(t.0 == 99 && t.1 == "one" && t.2 == 2.5, "after writing .0: {t.0},{t.1},{t.2}");
  t.1 = "changed";
  assert(t.0 == 99 && t.1 == "changed" && t.2 == 2.5, "after writing .1: {t.0},{t.1},{t.2}");
  t.2 = 9.5;
  assert(t.0 == 99 && t.1 == "changed" && t.2 == 9.5, "after writing .2: {t.0},{t.1},{t.2}");
}

// --- Value parameters are copies ---------------------------------------------------------------

fn a_value_parameter_is_a_copy_for_every_scalar_element_type() {
  a = (10, 20);
  assert(doubles_first(a) == 20, "the callee doubled its own copy: {doubles_first(a)}");
  assert(a.0 == 10, "and the caller's integer is untouched: {a.0}");
  b = (false, 'k');
  assert(flips(b), "the callee flipped its own copy to true: {flips(b)}");
  assert(!b.0, "and the caller's boolean is still false: {b.0}");
  c = (1.5, 3);
  assert(scales(c) == 3.0, "the callee scaled its own copy: {scales(c)}");
  assert(c.0 == 1.5, "and the caller's float is untouched: {c.0}");
}

fn the_local_copy_form_writes_a_text_element_and_still_does_not_reach_the_caller() {
  u = (1, "orig");
  assert(renames(u) == "changed", "the local copy took the write: {renames(u)}");
  assert(u.1 == "orig", "and the caller's text is untouched: {u.1}");
}

// --- Return, destructure, compare ---------------------------------------------------------------

fn a_mixed_tuple_survives_return_and_destructuring() {
  g = labelled(72);
  assert(g.0 == "pass" && g.1 == 72, "returned mixed: {g.0},{g.1}");
  (name, score) = labelled(20);
  assert(name == "fail" && score == 20, "destructured mixed: {name},{score}");
  (a, b, c) = ("x", 2.5, 7);
  assert(a == "x" && b == 2.5 && c == 7, "destructured three kinds: {a},{b},{c}");
}

fn comparison_is_lexicographic_and_reaches_every_element_type() {
  assert((1, 9) < (2, 0), "the first element decides");
  assert((1, 9) < (1, 10), "it ties, so the second decides");
  assert(!((1, 9) < (1, 9)), "identical is not strictly less");
  assert((1, 9) <= (1, 9), "but it is less-or-equal");
  assert((1, "abc") == (1, "abc"), "text compares by value");
  assert((1, "abc") != (1, "abd"), "and differing text is not equal");
  assert(("a", 2) < ("b", 1), "a text FIRST element decides too");
  assert((1.5, "a") < (1.5, "b"), "a float ties and the text breaks it");
  assert(('a', 1) < ('b', 0), "characters order as characters");
}

// --- Where a mixed tuple can live -----------------------------------------------------------

fn a_mixed_tuple_lives_in_a_collection_a_field_and_a_generator() {
  v: vector<(integer, text)> = [];
  v += [(1, "a")];
  v += [(2, "b")];
  assert(len(v) == 2, "two elements: {len(v)}");
  assert(v[1].0 == 2 && v[1].1 == "b", "vector element: {v[1].0},{v[1].1}");

  h = Holder { pair: (7, "seven") };
  assert(h.pair.0 == 7 && h.pair.1 == "seven", "struct field: {h.pair.0},{h.pair.1}");

  n = 0;
  for p in scalar_pairs() {
    n += p.0 + p.1;
  }
  assert(n == 10, "generator yield of an all-scalar tuple: {n}");
}

// --- Arity ------------------------------------------------------------------------------------

fn arity_beyond_three_reaches_its_last_element() {
  q = (1, 2, 3, 4);
  assert(q.3 == 4, "four: {q.3}");
  o = (1, 2, 3, 4, 5, 6, 7, 8);
  assert(o.7 == 8, "eight: {o.7}");
  m = (1, "two", 3.5, true, 'e', 6, "seven", 8.5);
  assert(m.6 == "seven" && m.7 == 8.5, "eight, mixed, last two: {m.6},{m.7}");
}
