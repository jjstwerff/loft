//
// @PLN25 DN6 (N-Join) — an INFERRED local first assigned a bare `null`, then a
// non-null scalar `τ`, widens to `Null ⊔ τ = τ?` (the ergonomic escape valve)
// instead of erroring.  `var_tp == null` is inherently the inferred-from-null case
// (a variable cannot be ANNOTATED `null`), so this never overrides an explicit
// non-null contract — the reject twins (annotated `a: integer = null; a = 5`, and
// laundering a widened `τ?` into a non-null slot) live in 102-expected-errors.loft.
//
// The canonical idiom: a value that starts absent and is conditionally filled in.

// Conditional assign TAKEN — `a` widens to `integer?`, holds the assigned value.
fn nj_cond_taken() -> integer {
  a = null;
  if 1 < 2 { a = 4; }
  a ?? -1
}

// Conditional assign NOT taken — `a` stays `null`, discharges to the default.
fn nj_cond_untaken() -> integer {
  a = null;
  if 1 > 2 { a = 4; }
  a ?? -1
}

// The widened value is genuinely nullable: it is a real `integer?` downstream.
fn nj_use_after_widen() -> integer {
  a = null;
  if 1 < 2 { a = 7; }
  (a ?? 0)+10
}

// float / character widen too (all INLINE scalars share the Null slot).
fn nj_float() -> float {
  f = null;
  if 1 < 2 { f = 2.5; }
  f ?? 0.0
}

fn nj_char() -> character {
  c = null;
  if 1 < 2 { c = 'z'; }
  c ?? ' '
}

// NOTE: `text` is deliberately OUT of DN6's scope — it is the one heap-backed scalar,
// and the Null slot cannot be retroactively widened to a text? heap-ref slot.  A text
// null-start must annotate `s: text? = null` (see the reject twin in 102-expected-errors).

fn main() {
  assert(nj_cond_taken() == 4, "cond taken -> 4");
  assert(nj_cond_untaken() == -1, "cond untaken -> null -> -1");
  assert(nj_use_after_widen() == 17, "use after widen -> 17");
  assert(nj_float() == 2.5, "float widen -> 2.5");
  assert(nj_char() == 'z', "char widen -> z");
  print("25-null-join ok\n");
}
