//
// Comparing a COLLECTION FIELD with `null` must not free the record it was read out of.
//
// `vector == null` tests the null sentinel through `OpVectorIsNull`, which reads only the
// sentinel and discards the vector — so a heap-owning TEMP consumed by the test would be
// orphaned. `parse_compare` therefore captures a non-`Var` operand in a work-ref precisely so
// scope exit frees it (the `f() != null` leak, loft#938's caller half).
//
// "Non-`Var`" was standing in for "a temp that owns its store", and a FIELD READ is non-`Var`
// too. `h.vec == null` captured `OpGetField(h, …)` — a DbRef pointing INTO `h`'s record — and
// freed it, taking the holder's storage with it:
//
//     x = { __ref_1 = OpGetField(h, 0, 21); OpVectorIsNull(__ref_1); OpFreeRef(__ref_1); }
//
// The type said so all along: the field read is `optional(vector(…, deps { items: [0] }))`,
// and a non-empty dep list means BORROWS. The fix asks the type instead of inferring
// ownership from the value's shape.
//
// What it cost (loft#920): the nightly UB/sanitizer gate died of it for three sessions. Under
// `LOFT_POISON=1` the freed record reads back `0xDEADBEEF`, so the next read of the same field
// produced a garbage DbRef and `len()` dereferenced it — SIGSEGV. That is how it was found,
// but it is NOT how this file catches it, because a crash needs a flag and a silent wrong
// answer does not:
//
// c1 lets the freed slot be RECYCLED by the next allocation and then reads the field again.
// Before the fix it answered the FILLER's length — one variable reading another's storage,
// on both backends, with no flag set and no diagnostic. Hand-computed: `h.vec` holds three
// elements and `filler` holds eight, so a correct run says 3 and the defect says 8.
//
// This is deliberately NOT a fix for loft#938. That one is the opposite case and still open:
// an OWNING and a BORROWING nullable-collection RETURN are both spelled with empty deps, so
// no predicate here can separate them. c5 pins that a call result keeps its work-ref.

struct H920 { vec: vector<integer>?, tag: integer }
struct Plain920 { vec: vector<integer>, tag: integer }

fn n920_gives(n: integer) -> vector<integer>? { if n != 0 { [n] } else { null } }

fn main() {
  // c1 — the guard proper: compare the field with `null`, let the freed slot be reused, then
  //      read the field again. Answered 8 (the filler's length) before the fix.
  c1 = H920 { vec: [71, 82, 93], tag: 7 };
  c1n = c1.vec == null;
  c1f: vector<integer> = [11, 22, 33, 44, 55, 66, 77, 88];
  assert(len(c1.vec ?? []) == 3, "c1 len = {len(c1.vec ?? [])}, want 3 (8 = read the filler)");
  assert(len(c1f) == 8, "c1 filler = {len(c1f)}, want 8");
  assert(!c1n, "c1 a collection field never reads back as null (loft#917)");
  assert(c1.tag == 7, "c1 tag = {c1.tag}, want 7 — the holder record must still be intact");

  // c2 — the same through `!=`, which takes the identical path.
  c2 = H920 { vec: [71, 82], tag: 8 };
  c2n = c2.vec != null;
  c2f: vector<integer> = [11, 22, 33, 44, 55];
  assert(len(c2.vec ?? []) == 2, "c2 len = {len(c2.vec ?? [])}, want 2");
  assert(c2n, "c2 != null is true for the same reason c1 == null is false");
  assert(len(c2f) == 5, "c2 filler = {len(c2f)}, want 5");

  // c3 — twice in a row, so a per-evaluation free shows up as a second corruption.
  c3 = H920 { vec: [71, 82, 93, 104], tag: 9 };
  c3a = c3.vec == null;
  c3b = c3.vec == null;
  c3f: vector<integer> = [11, 22];
  assert(len(c3.vec ?? []) == 4, "c3 len = {len(c3.vec ?? [])}, want 4");
  assert(!c3a && !c3b, "c3 both tests answer present");
  assert(len(c3f) == 2, "c3 filler = {len(c3f)}, want 2");

  // c4 (control) — a NON-nullable collection field compared with null goes down a different
  //       path and was never affected; it must stay correct.
  c4 = Plain920 { vec: [71, 82, 93], tag: 10 };
  c4f: vector<integer> = [11, 22, 33, 44, 55, 66];
  assert(len(c4.vec) == 3, "c4 len = {len(c4.vec)}, want 3");
  assert(len(c4f) == 6, "c4 filler = {len(c4f)}, want 6");
  assert(c4.tag == 10, "c4 tag = {c4.tag}, want 10");

  // c5 (control) — an unbound CALL result compared with null. This one still needs its
  //       work-ref, and keeping it is what stops the fix from spilling into loft#938.
  //       Evaluated ONCE, not in a loop: the loop form is loft#938 itself and orphans one
  //       store per iteration, which the suite's leak gate would (rightly) fail. One
  //       evaluation leaves the work-ref holding its live value, freed at scope exit.
  c5 = 0;
  if n920_gives(1) != null { c5 += 1; }
  if n920_gives(0) != null { c5 += 10; }
  assert(c5 == 1, "c5 = {c5}, want 1 — present arm counts, null arm does not");

  // c6 (control) — a LOCAL nullable collection compared with null (a `Var` operand, which
  //       never took the work-ref path at all).
  c6: vector<integer> = [71, 82];
  c6f: vector<integer> = [11, 22, 33, 44];
  assert(len(c6) == 2, "c6 len = {len(c6)}, want 2");
  assert(len(c6f) == 4, "c6 filler = {len(c6f)}, want 4");

  println("920 ok");
}
