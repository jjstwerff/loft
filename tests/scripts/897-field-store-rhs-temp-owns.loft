//
// The temp a vector-FIELD replacement builds for its right-hand side owns that
// side's storage, so the scope-end free releases it.
//
// `s.v = <expr>` lowers to `Set(tmp, expr); Clear(s.v); Append(s.v, tmp)`. The temp
// was created with the DESTINATION FIELD's type, so it inherited the field's deps,
// read as a borrow of the struct, and never earned an `OpFreeRef`. An RHS that
// ALLOCATES then leaked its store for the whole run: `b.d = f#read(8) as
// vector<single>` interns the bytes into a store of its own and nothing freed it.
// Binding the same expression to a local first was clean, because a user local has
// no such dep — which is why the leak looked like a property of the cast rather than
// of the temp. The sibling arm (a borrowed-Var RHS) already built its temp dep-free;
// this is that same choice on the general arm.
//
// The rows below assert VALUES as well as absence of a leak: a temp that stopped
// owning its store would still append the right bytes, so a leak-only guard and a
// value-only guard each pass on half the defect. `tests/wrap.rs` fails the file on a
// store-leak warning at exit, which is the other half of this test.
//
// Not covered here: the same expression consumed with NO binding at all — as a call
// argument, a struct-literal field, or straight into `len` / `for..in`. That still
// leaks, and through `len` it silently reads ONE element starting at the SECOND
// (loft#899). c5 pins the shape that works so the two stay told apart.

struct B { d: vector<single> }
struct T { s: vector<text> }

fn r897_sum(v: vector<single>) -> single {
  t = 0.0f;
  for e in v { t += e; }
  t
}

fn main() {
  // c1 — the filed shape: an allocating RHS stored straight into a vector field.
  //      Two singles, distinct values, so a short read is visible in the sum.
  { f = file("r897a.bin"); f#format = LittleEndian; f += 1.5f; f += 2.5f; }
  b1 = B { d: [] };
  { f = file("r897a.bin"); f#format = LittleEndian;
    b1.d = f#read(8) as vector<single>; }
  assert(len(b1.d) == 2, "c1 len = {len(b1.d)}, want 2");
  assert(r897_sum(b1.d) == 4.0f, "c1 sum = {r897_sum(b1.d)}, want 4.0");

  // c2 — replacing a field that already holds data. The clear must still happen,
  //      so this is a replace and not an append, and the old store must not linger.
  b2 = B { d: [9.0f, 8.0f, 7.0f] };
  { f = file("r897a.bin"); f#format = LittleEndian;
    b2.d = f#read(8) as vector<single>; }
  assert(len(b2.d) == 2, "c2 len = {len(b2.d)}, want 2");
  assert(r897_sum(b2.d) == 4.0f, "c2 sum = {r897_sum(b2.d)}, want 4.0");

  // c3 — the same store-into-a-field shape with a non-file RHS that allocates: a
  //      text split. The temp's ownership is the point, not what produced the value.
  t3 = T { s: [] };
  t3.s = "a,b,c".split(',');
  assert(len(t3.s) == 3, "c3 len = {len(t3.s)}, want 3");

  // c4 — assigned twice in a row, so a temp that leaked would leak once per
  //      assignment rather than once per program.
  b4 = B { d: [] };
  { f = file("r897a.bin"); f#format = LittleEndian;
    b4.d = f#read(8) as vector<single>; }
  { f = file("r897a.bin"); f#format = LittleEndian;
    b4.d = f#read(8) as vector<single>; }
  assert(len(b4.d) == 2, "c4 len = {len(b4.d)}, want 2");
  assert(r897_sum(b4.d) == 4.0f, "c4 sum = {r897_sum(b4.d)}, want 4.0");

  // c5 — CONTROL: via a local, which was always leak-free. A fix that only made the
  //      local path work would still pass this row, so it cannot stand alone.
  b5 = B { d: [] };
  { f = file("r897a.bin"); f#format = LittleEndian;
    v = f#read(8) as vector<single>;
    b5.d = v; }
  assert(len(b5.d) == 2, "c5 len = {len(b5.d)}, want 2");
  assert(r897_sum(b5.d) == 4.0f, "c5 sum = {r897_sum(b5.d)}, want 4.0");

  // c6 — CONTROL: a plain vector-to-field copy from an owned local takes the direct
  //      arm (no temp at all) and must keep working.
  b6 = B { d: [] };
  src: vector<single> = [1.5f, 2.5f];
  b6.d = src;
  assert(len(b6.d) == 2, "c6 len = {len(b6.d)}, want 2");
  assert(r897_sum(b6.d) == 4.0f, "c6 sum = {r897_sum(b6.d)}, want 4.0");

  delete("r897a.bin");
  println("ok");
}
