//
// Regression: a `text` payload of a struct-enum, mutated through a match binding,
// was silently discarded on BOTH backends — no recursion, no call, no diagnostic
// (loft#673).  A `vector` payload in the identical shape propagated correctly, so
// the payload TYPE decided whether the write survived and nothing in the source
// said so.
//
// A heap payload binding holds a DbRef INTO the subject's record, so `items += …`
// reaches the subject for free.  A text payload binding is an owned copy of the
// characters (`_mv_items = OpGetText(subj, off)`), so the same line updated the
// copy and left the enum untouched.  The ruling is that a match binding is a
// borrowed VIEW of its subject whatever the payload type — which is what the
// vector, ref and struct-enum payloads already are — so a write through a text
// binding is now mirrored straight back with `OpSetText(subj, off, binding)`.
// A binding that is only read emits no mirror, so read-only code is unchanged.

enum R673 { NoneH, Holder { items: text } }
enum R673Two { NoneP, Pair { a: text, b: text } }
enum R673Inner { NoneL, Leaf { items: text } }
enum R673Outer { None, Wrap { inner: R673Inner } }
enum R673Vec { NoneB, Bytes { items: vector<u8> } }
struct R673Box { e: R673 }

// The multi-pattern arm runs a CLONE of the one arm body against each listed
// variant, and here the two variants put `items` at DIFFERENT offsets (`Pre`
// carries a text field ahead of it).  The write-back must follow the offset the
// branch actually read from, not the first pattern's.
enum R673Multi { Pre { head: text, items: text }, Bare { items: text } }

fn r673_bump(e: R673) {
  match e { Holder { items } => { items += "y"; }, _ => { } };
}

fn r673_read(e: R673) -> text {
  match e { Holder { items } => { return items; }, _ => { return "NIL"; } };
}

// Recursion is not needed to trigger the defect, but it must keep working: each
// level appends one character to the value the level below returned.
fn r673_deep(n: integer) -> R673 {
  if n <= 0 { return Holder { items: "x" }; }
  e = r673_deep(n - 1);
  match e { Holder { items } => { items += "y"; }, _ => { } };
  return e;
}

fn test_match_text_payload_write() {
  // The filed reproducer: one function, no recursion, no call.
  e = Holder { items: "x" };
  match e { Holder { items } => { items += "y"; }, _ => { } };
  assert(r673_read(e) == "xy", "append through a text payload binding: {r673_read(e)}");

  // A whole `=` replace, not just the compound append.
  match e { Holder { items } => { items = "zz"; }, _ => { } };
  assert(r673_read(e) == "zz", "assign through a text payload binding: {r673_read(e)}");

  // A read INSIDE the arm sees the write immediately (the mirror runs per write,
  // not at arm exit).
  seen = "";
  match e { Holder { items } => { items += "!"; seen = items; }, _ => { } };
  assert(seen == "zz!", "the arm sees its own write: {seen}");
  assert(r673_read(e) == "zz!", "and the subject carries it: {r673_read(e)}");

  // Two text payloads in one variant must not cross-write.
  p = Pair { a: "1", b: "2" };
  match p { Pair { a, b } => { a += "A"; b += "B"; }, _ => { } };
  match p { Pair { a, b } => {
    assert(a == "1A", "first of two text payloads: {a}");
    assert(b == "2B", "second of two text payloads: {b}");
  }, _ => { } };

  // A nested sub-pattern binds through the same path.
  o = Wrap { inner: Leaf { items: "x" } };
  match o { Wrap { inner: Leaf { items } } => { items += "y"; }, _ => { } };
  match o { Wrap { inner } => {
    match inner { Leaf { items } => { assert(items == "xy", "nested sub-pattern: {items}"); }, _ => { } };
  }, _ => { } };

  // The subject is a struct FIELD rather than a bare local.
  b = R673Box { e: Holder { items: "x" } };
  match b.e { Holder { items } => { items += "y"; }, _ => { } };
  assert(r673_read(b.e) == "xy", "field subject: {r673_read(b.e)}");

  // The write happens in a callee — the caller must see it, exactly as it would
  // for a vector payload.
  c = Holder { items: "x" };
  r673_bump(c);
  assert(r673_read(c) == "xy", "write through a parameter: {r673_read(c)}");

  // A vector ELEMENT subject writes only its own element.
  v = [Holder { items: "x" }, Holder { items: "q" }];
  match v[0] { Holder { items } => { items += "y"; }, _ => { } };
  assert(r673_read(v[0] ?? NoneH) == "xy", "vector element subject: {r673_read(v[0] ?? NoneH)}");
  assert(r673_read(v[1] ?? NoneH) == "q", "the sibling element is untouched: {r673_read(v[1] ?? NoneH)}");

  // Repeated writes in a loop accumulate.
  l = Holder { items: "x" };
  for i in 0..3 {
    match l { Holder { items } => { items += "{i}"; }, _ => { } };
  }
  assert(r673_read(l) == "x012", "writes accumulate across a loop: {r673_read(l)}");

  // Recursion: depth 2 appends twice on top of the base case.
  assert(r673_read(r673_deep(2)) == "xyy", "recursive: {r673_read(r673_deep(2))}");

  // Multi-pattern arm — `Bare` reads `items` at its own offset and must write it
  // back there.  Sharing the first pattern's offset wrote `Bare`'s value into the
  // slot `Pre` uses, so the append vanished (and landed in a foreign field).
  m1 = Pre { head: "H", items: "a" };
  m2 = Bare { items: "b" };
  match m1 { Pre { items }, Bare { items } => { items += "1"; } };
  match m2 { Pre { items }, Bare { items } => { items += "2"; } };
  match m1 { Pre { head, items } => {
    assert(items == "a1", "multi-pattern, first listed variant: {items}");
    assert(head == "H", "the neighbouring field is untouched: {head}");
  }, Bare { items } => { assert(false, "wrong variant"); } };
  match m2 { Pre { items }, Bare { items } => {
    assert(items == "b2", "multi-pattern, second listed variant: {items}");
  } };

  // Control: a `vector` payload already aliased the subject and must stay that way.
  bv = Bytes { items: [120] };
  match bv { Bytes { items } => { items += [121]; }, _ => { } };
  match bv { Bytes { items } => {
    assert(text_from_bytes(items) == "xy", "vector payload still aliases: {text_from_bytes(items)}");
  }, _ => { } };

  // Control: a binding that is only READ leaves the subject alone.
  ro = Holder { items: "x" };
  match ro { Holder { items } => { assert(len(items) == 1, "read-only binding: {items}"); }, _ => { } };
  assert(r673_read(ro) == "x", "a read-only binding does not write: {r673_read(ro)}");
}
