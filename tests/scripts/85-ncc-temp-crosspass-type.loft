// @PLN85 / routing feedback (2026-07-02): the two-pass parser can MATERIALISE a different
// set of `??` temps per pass (a `??` that stays trivial in pass 1 becomes a `__ncc_N`
// temp in pass 2), so the `__ncc_N` counter denotes DIFFERENT sites per pass.  The
// variable-table reuse then handed pass-2 code a temp carrying pass-1's TYPE: here the
// `txs as integer ?? -1` temp kept a `ref(Img)` type from the pass-1 numbering of the
// LATER `make_img(..) ?? Img { }` discharge.  Native emitted `parse().. as DbRef`
// (rustc E0605); interp silently read a WRONG VALUE (tx became 0).  Fixed by the
// pass-2-wins re-type on generated (`__`-prefixed) temp reuse in variables/mod.rs.
// The shape needs: a void fn, early returns, text `??` discharges feeding `as integer`
// parses, AND a later heap-typed `??` in the same fn (the type that collided).

struct Img { width: integer, height: integer }

fn make_img(ok: boolean) -> Img? {
  if ok { return Img { width: 256, height: 256 }; }
  null
}

fn add_tile(acc: &vector<integer>, key: text) {
  parts = key.split('/');
  if len(parts) != 3 { return; }
  txs = parts[1] ?? "";
  tys = parts[2] ?? "";
  tx = txs as integer ?? -1;
  ty = tys as integer ?? -1;
  if tx < 0 || ty < 0 { return; }
  img = make_img(true) ?? Img { };
  if img.width != 256 { return; }
  acc += [tx, ty];
}

fn main() {
  acc: vector<integer> = [];
  add_tile(acc, "12/34/56");
  assert(len(acc) == 2, "acc len {len(acc)}");
  assert((acc[0] ?? -1) == 34, "tx {acc[0] ?? -1} (expect 34 — a 0 here is the cross-pass temp-type corruption)");
  assert((acc[1] ?? -1) == 56, "ty {acc[1] ?? -1} (expect 56)");
  // NOTE deliberately ONE call: a second (early-returning) call surfaces a PRE-EXISTING
  // heap-`??`-discharge × call-churn leak (Img×1, reproduces on loft 2026.6.0, gate-ON
  // too) — a separate open @PLN85 class member, tracked in the plan's over-free map,
  // NOT the cross-pass temp-type bug this script guards.
  println("ncc-crosspass ok {acc[0] ?? -1} {acc[1] ?? -1}");
}
