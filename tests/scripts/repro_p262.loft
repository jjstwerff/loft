// P262 minimal reproducer — native codegen omits the `&*` deref
// when a text-returning USER function call is passed inline as
// the argument of another text-typed function call.  rustc rejects
// the generated source with E0308 (expected `&str`, found `Str`).
// Surfaced 2026-05-13 by plan-35 phase 01 building the viewer's
// HTML body via `body += "<h1>{escape(rel)}</h1>"`-shaped chains.
// CLOSED 2026-05-13 in `src/generation/calls.rs::user_fn_call_body`:
// the `needs_deref` check matched against `Value::Call(d, _)` without
// unspanning, missing the case where the IR wraps the inline call in
// `Value::Span` for source-position tracking.  Fix: `v.unspan()`
// before the matches!() pattern, mirroring line 95's existing pattern.
// Without the deref the generated Rust looks like
// `n_println(cell, n_upper(cell, n_greet(cell, "x", ...)))`;
// after the fix it becomes
// `n_println(cell, &*(n_upper(cell, &*(n_greet(cell, "x", ...)))))`.
fn p262_greet(p262_n: text) -> text {
  "hi {p262_n}"
}
fn p262_upper(p262_s: text) -> text {
  p262_s.to_uppercase()
}

fn p262_text_call_chain_compiles_under_native() {
  p262_out = p262_upper(p262_greet("x"));
  assert(p262_out == "HI X", "p262: out={p262_out}");
}
