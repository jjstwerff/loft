//
// Regression: a SELF-recursive function returning a struct-enum, whose payload is
// mutated in place through a match binding before the value is returned, SIGSEGVed
// on the interpreter (two `#306` refused-frees and a `#405` out-of-range free came
// first); `--native` computed the right answer, so the backends disagreed
// (loft#666).
//
// The binding's borrow dep named a variable nothing had written.  It came from the
// TYPE HINT: parsing a bare name inside a block installs the block's expected result
// type as the enum-resolution context, and for a function body that expected type is
// the fn's `returned` — whose deps are ATTRIBUTE indices.  The vector-literal path
// then re-tagged those indices as caller FRAME variables, so `items` borrowed frame
// var 1, which in a recursive `-> E` function is the retired `__retbuf` placeholder.
// Scope cleanup null-inited and freed it, reading garbage as a DbRef.  Non-recursive
// callees have no attr dep on their return, which is why only recursion tripped it.
// A hint carries a SHAPE, never a lifetime, so the hint accessors now hand out a
// dep-free type.
//
// Second fault, exposed once the bogus dep was gone: a payload bound through a
// NESTED sub-pattern (`Wrap { inner: Holder { items } }`) reads from
// `OpGetField(w, …)`, not from a bare variable, and the borrow source only
// recognised a bare variable.  Dep-free reads as "owns its store", so the append
// allocated a fresh backing and repointed the local — the write vanished, silently,
// on both backends, with or without recursion.  A getter chain still borrows from
// the variable it is rooted at, so the source now walks to that root.

enum R666 { Nil, Holder { items: vector<u8> } }
enum R666W { None, Wrap { inner: R666 } }

// The filed reproducer: recursion is required for this one.
fn r666_deep(n: integer) -> R666 {
  if n <= 0 { return Holder { items: [120] }; }        // 'x'
  e = r666_deep(n - 1);
  match e { Holder { items } => { items += [121]; assert(len(items) > 1, "append landed"); }, _ => { } };   // 'y'
  return e;
}

// MUTUAL recursion: `r666_a` calls a function declared after it.
fn r666_a(n: integer) -> R666 {
  if n <= 0 { return Holder { items: [120] }; }
  e = r666_b(n - 1);
  match e { Holder { items } => { items += [121]; assert(len(items) > 1, "a appended"); }, _ => { } };
  return e;
}
fn r666_b(n: integer) -> R666 {
  if n <= 0 { return Holder { items: [122] }; }        // 'z'
  e = r666_a(n - 1);
  match e { Holder { items } => { items += [119]; assert(len(items) > 1, "b appended"); }, _ => { } };   // 'w'
  return e;
}

// FORWARD-declared callee, no recursion — the control that always worked.
fn r666_forward() -> R666 {
  e = r666_seed();
  match e { Holder { items } => { items += [121]; assert(len(items) == 2, "forward appended"); }, _ => { } };
  return e;
}
fn r666_seed() -> R666 { return Holder { items: [120] }; }

// The nested sub-pattern, through recursion.
fn r666_nested(n: integer) -> R666W {
  if n <= 0 { return Wrap { inner: Holder { items: [120] } }; }
  w = r666_nested(n - 1);
  match w { Wrap { inner: Holder { items } } => { items += [121]; assert(len(items) > 1, "nested appended"); }, _ => { } };
  return w;
}

fn r666_read(e: R666) -> text {
  match e { Holder { items } => { text_from_bytes(items) }, _ => { "NIL" } }
}

fn r666_read_w(w: R666W) -> text {
  match w { Wrap { inner } => { r666_read(inner) }, _ => { "NONE" } }
}

fn test_recursive_enum_payload_mutation() {
  // Depth 1 already crashed; depth 3 proves every level's append survives.
  assert(r666_read(r666_deep(1)) == "xy", "depth 1: {r666_read(r666_deep(1))}");
  assert(r666_read(r666_deep(3)) == "xyyy", "depth 3: {r666_read(r666_deep(3))}");
  // Recursion not taken — the base case must be untouched.
  assert(r666_read(r666_deep(0)) == "x", "depth 0: {r666_read(r666_deep(0))}");

  // a(2) = b(1) + 'y' = (a(0) + 'w') + 'y' = "xwy"
  assert(r666_read(r666_a(2)) == "xwy", "mutual recursion: {r666_read(r666_a(2))}");

  assert(r666_read(r666_forward()) == "xy", "forward-declared callee: {r666_read(r666_forward())}");

  // The nested sub-pattern binding must reach the payload it was bound from.  This
  // one lost its write with NO recursion too, so check both.
  assert(r666_read_w(r666_nested(2)) == "xyy", "nested sub-pattern, recursive: {r666_read_w(r666_nested(2))}");
  flat = Wrap { inner: Holder { items: [120] } };
  match flat { Wrap { inner: Holder { items } } => { items += [121]; assert(len(items) == 2, "flat nested appended"); }, _ => { } };
  assert(r666_read_w(flat) == "xy", "nested sub-pattern, no recursion: {r666_read_w(flat)}");

  // A struct-enum payload of `text` through the same recursion (the loft#673 twin).
  assert(r666_read(r666_deep(2)) == "xyy", "depth 2: {r666_read(r666_deep(2))}");
}
