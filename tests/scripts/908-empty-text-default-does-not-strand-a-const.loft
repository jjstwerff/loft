//
// A value is pushed on the eval stack if and only if an op consumes it.
//
// Appending the EMPTY literal to a text variable is a no-op — the variable has
// just been cleared — so `set_var`'s put dispatch skipped `OpAppendText` for it.
// But it skipped only the op, after the value had already been generated: a
// 16-byte const stayed on the stack with nothing to take it off, and
// `stack.position` ran high for the rest of the statement.
//
// That is invisible until the statement is one ARM of an `if`/`else`, which
// `?? ""` over a CALL always is (the nullable result goes into a work-ref, and
// the presence test branches on it).  The arms then disagreed in height, and
// `gen_if`'s arm-height equaliser "corrected" the taller one with an
// `OpFreeStack` whose discard walked past the frame's eval base into the LOCALS
// — overwriting a live text descriptor.  Freeing that at scope exit aborted the
// interpreter with `free(): invalid pointer` (loft#908).
//
// Reported as "a function that reads a missing file and returns a struct
// double-frees", and it needed all four of: the nullable text from a CALL, the
// call actually answering null, an EMPTY default, and an aggregate return (whose
// hidden return buffer is what puts a live local under the over-discard).  None
// of that is the defect — the file is not even needed.  Rows here move one axis
// each, so a regression says which half came back.
//
// `--native` was always correct, so every row asserts a value rather than merely
// running: on the backend that never had the bug an inert row would read as a pass.

struct Box { n: integer }

fn none() -> text? { null }
fn some() -> text? { "abc" }

// The reported shape, minus the file: an empty default over a call that answers
// null, inside a function returning a struct.
fn from_none() -> Box { fn_x = none() ?? ""; Box { n: len(fn_x) } }

// Same shape, call answers a value — the default is not taken, so the arm that
// stranded the const never runs.  Pins that the fix did not cost the live path.
fn from_some() -> Box { fs_x = some() ?? ""; Box { n: len(fs_x) } }

// A NON-empty default: the arm emitted `OpAppendText`, the heights matched, and
// no equaliser fired.  This is what the broken row was compared against.
fn from_none_nonempty() -> Box { fe_x = none() ?? "zz"; Box { n: len(fe_x) } }

// The empty literal as a plain reassignment, not a `??` arm — the write must
// still land, or "skip the push" would have become "skip the assignment".
fn cleared(c: boolean) -> text {
  cl_x = "seed";
  if c { cl_x = "abc"; } else { cl_x = ""; }
  cl_x
}

// The empty default reaching a text return rather than a struct one: no return
// buffer, so nothing live sat under the over-discard and it never aborted.  It
// was still emitting the stranded const, so keep it asserted.
fn text_return() -> text { tr_x = none() ?? ""; tr_x }

fn main() {
  assert(from_none().n == 0, "empty default over a null call must give an empty text, got {from_none().n}");
  assert(from_some().n == 3, "a present value must survive the empty default, got {from_some().n}");
  assert(from_none_nonempty().n == 2, "a non-empty default must still be taken, got {from_none_nonempty().n}");

  assert(len(cleared(false)) == 0, "assigning \"\" must clear the variable, got {len(cleared(false))}");
  assert(len(cleared(true)) == 3, "the other arm must still assign, got {len(cleared(true))}");

  assert(len(text_return()) == 0, "empty default in a text-returning fn, got {len(text_return())}");

  // The reported program itself: read a MISSING file's content and build a
  // struct in one function.  Kept because it is the shape a consumer wrote, and
  // because it exercises the early `return` the reduction dropped.
  assert(load("908-no-such-file.json").n == 0, "a missing file must answer an empty text");
}

fn load(p: text) -> Box {
  ld_t = file(p).content() ?? "";
  if ld_t == "" { return Box { n: 0 }; }
  Box { n: len(ld_t) }
}
