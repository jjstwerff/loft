//
// A tail `if`/`match` whose arms EACH own a store: one wins at runtime, and the losers
// must be freed — without the winner's store being destroyed on the way out.
//
// `fn pick(c) -> S { w = S { a: 7 }; if c { S { a: 9 } } else { w } }` promotes `w` onto
// the hidden return buffer (NRVO), so the `else` arm delivers the buffer and the `if` arm
// delivers a different store.  On the arm that does NOT deliver `w`, the store `w` minted
// was returned by nobody and freed by nobody: ONE orphan per call, invisible in a single
// call and fatal in a loop — `loft_planet` reached ~16,000 retained records per planet and
// four planets exhausted the 65,535-entry `store_nr` table.  The cure is the leg loft#688
// and loft#1022 each added for their own shape: the promoted buffer is the one argument a
// callee really owns, so the multi-source join hoists to `__ret_N` and emits
// `OpFreeRefIfDistinct(w, __ret_N)` — the runtime decides which arm won.
//
// Two more defects sat one axis away, and both answered WRONG rather than leaking.  Moving
// the arm from a function TAIL to a binding (`r = if c { … } else { w }; r`) and moving the
// other arm from a literal to a second LOCAL are the axes the filed report held fixed:
//
//   * TWO local arms — the first is renamed onto the buffer, and the second's `Bind` copy
//     leg then emits `OpDatabase(buf); OpCopyRecord(<tail that reads buf>, buf)`.  The
//     re-mint destroys the store the copy is about to read, so the renamed arm answered a
//     zeroed record.  A three-arm `match` broke only its FIRST arm, which is the tell.
//   * The BOUND form is loft#848's class one arm over: the pass-2-only object-literal mint
//     in `parser/objects.rs` still drew from the shared `__ref_N` counter, so on pass 2 it
//     was handed the name pass 1 had left on the return buffer — the arm's record and the
//     return destination became one slot, and the fresh arm answered `0`.
//
// Both wrong answers were silent and identical on BOTH backends, so neither backend could
// witness the other.  The values below are therefore the primary assertion and the
// harness's leak check is the second; a fix that silences the leak by freeing the DELIVERED
// store fails the values, which is the over-free this shape sits one step away from.

struct S1078 { a: integer = 3 }
struct H1078 { inner: S1078 }

fn mk1078(n: integer) -> S1078 { S1078 { a: n } }

// The filed shape: a fresh LITERAL arm against a named local.
fn pick1078(c: boolean) -> S1078 {
  w = S1078 { a: 7 };
  if c { S1078 { a: 9 } } else { w }
}

// The same with the fresh arm spelled as a CALL — the filed report measured both and they
// leaked alike, so both stay pinned.
fn pick_call1078(c: boolean) -> S1078 {
  w = S1078 { a: 7 };
  if c { mk1078(9) } else { w }
}

// TWO owned locals: the first is the one renamed onto the buffer, so it is the one that
// answered zero.
fn pick_two_locals1078(c: boolean) -> S1078 {
  u = S1078 { a: 5 };
  w = S1078 { a: 7 };
  if c { u } else { w }
}

// Three arms, three locals — only the first arm was wrong, which is what named the buffer
// rename as the mechanism rather than the join.
fn pick_three_locals1078(k: integer) -> S1078 {
  u = S1078 { a: 5 };
  w = S1078 { a: 7 };
  x = S1078 { a: 8 };
  match k { 0 => u, 1 => w, _ => x }
}

// BOUND, then returned — not a tail join at all.  This is the pass-2 work-ref collision.
fn pick_bound1078(c: boolean) -> S1078 {
  w = S1078 { a: 7 };
  r = if c { S1078 { a: 9 } } else { w };
  r
}

// A `match` at the tail behaves as the `if` does.
fn pick_match1078(k: integer) -> S1078 {
  w = S1078 { a: 7 };
  match k { 0 => w, _ => S1078 { a: 9 } }
}

// Nested — the local sits in the INNER else.
fn pick_nested1078(c: boolean, d: boolean = true) -> S1078 {
  w = S1078 { a: 7 };
  if c { if d { S1078 { a: 9 } } else { w } } else { S1078 { a: 1 } }
}

// ── the cells that were ALWAYS clean and must stay clean ────────────────────────────────
fn pick_param1078(p: S1078, c: boolean) -> S1078 { if c { mk1078(9) } else { p } }
fn pick_velem1078(v: vector<S1078>, c: boolean) -> S1078 { if c { mk1078(9) } else { v[0] } }
fn pick_field1078(c: boolean) -> S1078 {
  h = H1078 { inner: S1078 { a: 7 } };
  if c { S1078 { a: 9 } } else { h.inner }
}
fn pick_both_fresh1078(c: boolean) -> S1078 {
  w = S1078 { a: 7 };
  if c { S1078 { a: 9 } } else { S1078 { a: w.a } }
}

fn test_the_fresh_arm_does_not_orphan_the_promoted_buffer() {
  // The buffer is minted on EVERY call, so 40 calls that never take the local arm left 40
  // orphans.  The count is high enough that a per-call orphan is unmistakable in the leak
  // report and low enough to stay cheap.
  t = 0;
  for i in 0..40 { p = pick1078(i >= 0); t += p.a; }
  assert(t == 360, "forty fresh-arm calls each answer 9, got {t}");
}

fn test_a_call_shaped_fresh_arm_is_the_same_shape() {
  t = 0;
  for i in 0..40 { p = pick_call1078(i >= 0); t += p.a; }
  assert(t == 360, "forty call-arm calls each answer 9, got {t}");
}

fn test_the_local_arm_still_delivers_its_own_store() {
  // The over-free neighbour: the arm that DOES deliver the buffer must keep it.
  t = 0;
  for i in 0..40 { p = pick1078(i < 0); t += p.a; }
  assert(t == 280, "forty local-arm calls each answer 7, got {t}");
}

fn test_both_arms_in_one_run_answer_their_own_value() {
  s = "";
  for i in 0..6 { p = pick1078(i % 2 == 0); s = "{s}{p.a},"; }
  assert(s == "9,7,9,7,9,7,", "each arm answers its own value, got {s}");
}

fn test_two_owned_locals_each_answer_their_own_record() {
  // The renamed-onto-the-buffer arm is the FIRST one; it answered 0 because the copy leg
  // re-minted its destination before reading it.
  s = "";
  for i in 0..4 { p = pick_two_locals1078(i % 2 == 0); s = "{s}{p.a},"; }
  assert(s == "5,7,5,7,", "two local arms answer 5 and 7, got {s}");
}

fn test_three_owned_locals_answer_in_arm_order() {
  s = "";
  for i in 0..3 { p = pick_three_locals1078(i); s = "{s}{p.a},"; }
  assert(s == "5,7,8,", "three local arms answer in order, got {s}");
}

fn test_a_bound_join_returned_afterwards_keeps_both_arms() {
  // Not a tail join — the value is bound first.  This is the pass-2 work-ref collision,
  // and it answered 0 on the FRESH arm while the local arm was correct.
  s = "";
  for i in 0..6 { p = pick_bound1078(i % 2 == 0); s = "{s}{p.a},"; }
  assert(s == "9,7,9,7,9,7,", "the bound form answers each arm, got {s}");
}

fn test_a_match_tail_carries_the_same_join() {
  s = "";
  for i in 0..4 { p = pick_match1078(i % 2); s = "{s}{p.a},"; }
  assert(s == "7,9,7,9,", "the match form answers each arm, got {s}");
}

fn test_a_nested_join_reaches_the_inner_local_arm() {
  s = "";
  for i in 0..40 { p = pick_nested1078(i >= 0, true); s = "{p.a}"; }
  assert(s == "9", "the nested fresh arm answers 9, got {s}");
  a = pick_nested1078(true, false);
  b = pick_nested1078(false, true);
  assert(a.a == 7, "the inner local arm answers 7, got {a.a}");
  assert(b.a == 1, "the outer fresh arm answers 1, got {b.a}");
}

fn test_the_arms_that_were_always_clean_stay_clean() {
  // A PARAMETER arm and a vector-ELEMENT arm are what loft#1029 and loft#1019 cover; both
  // were measured clean on this shape and must not start leaking or copying wrong.
  p0 = S1078 { a: 1 };
  t = 0;
  for i in 0..20 { r = pick_param1078(p0, i % 2 == 0); t += r.a; }
  assert(t == 100, "parameter-arm calls alternate 9 and 1, got {t}");

  v: vector<S1078> = [S1078 { a: 2 }];
  u = 0;
  for i in 0..20 { r = pick_velem1078(v, i % 2 == 0); u += r.a; }
  assert(u == 110, "element-arm calls alternate 9 and 2, got {u}");

  // A FIELD of a local is the fourth "what does the arm name" cell.
  f = 0;
  for i in 0..20 { r = pick_field1078(i % 2 == 0); f += r.a; }
  assert(f == 160, "field-arm calls alternate 9 and 7, got {f}");

  // Both arms fresh — the workaround the filed report verified.  Nothing is borrowed, so
  // nothing can be orphaned; it must keep answering.
  g = 0;
  for i in 0..20 { r = pick_both_fresh1078(i % 2 == 0); g += r.a; }
  assert(g == 160, "both-fresh calls alternate 9 and 7, got {g}");
}
