// @P347 regression: ORDERING compares (< <= > >=) on a `vector<text>` element
// vs another text value must compile + run under --native (was E0308/E0277:
// the indexed element is `&str` from get_str, the other operand `&String`,
// which `PartialOrd` won't unify — `==` worked but ordering didn't).  Routed
// through `ops::op_lt_text` / `op_le_text`, which coerce both sides to `&str`.
fn main() {
  days: vector<text> = ["2026-03-30", "2026-03-22", "2026-03-24"];
  start = "2026-03-24";

  // elem vs hoisted var (>=)
  ge_count = 0;
  for di in 0..len(days) {
    if days[di] >= start { ge_count += 1; }
  }
  assert(ge_count == 2, "elem >= var: {ge_count}");

  // elem vs literal (>) and (<)
  gt_count = 0;
  lt_count = 0;
  for ki in 0..len(days) {
    if days[ki] > "2026-03-23" { gt_count += 1; }
    if days[ki] < "2026-03-25" { lt_count += 1; }
  }
  assert(gt_count == 2, "elem > literal: {gt_count}");
  assert(lt_count == 2, "elem < literal: {lt_count}");

  // two indexed elements (<=)
  le_count = 0;
  for ji in 0..len(days) {
    if days[0] <= days[ji] { le_count += 1; }
  }
  assert(le_count == 1, "elem <= elem: {le_count}");

  // equality still works
  assert(days[2] == start, "elem == var");

  print("ok");
}
