// #553 — slicing a nested vector `a[lo..hi]` where `a: vector<vector<T>>` used to SIGSEGV
// (interpret) / E0308 (native): the slice-materialise read a `vector<T>` element as a scalar
// (OpGetField→OpSetInt4), storing a 12-byte vector DbRef as a 4-byte int.  Now it deep-copies
// the whole element (OpCopyRecord), matching the `s += [a[i]]` append.  Both backends.
fn intslice() -> integer {
  a = [[1, 2], [3, 4], [5, 6]];
  s = a[0..2];
  assert(s.len() == 2, "len 2");
  assert(s[0][0] == 1 && s[0][1] == 2, "s[0] == [1,2]");
  assert(s[1][0] == 3 && s[1][1] == 4, "s[1] == [3,4]");
  m = a[1..3];
  assert(m.len() == 2 && m[0][0] == 3 && m[1][1] == 6, "mid slice");
  s[0][0] + m[1][1]
}
fn textslice() -> text {
  t = [["a"], ["b"], ["c"]];
  ts = t[0..2];
  assert(ts.len() == 2 && ts[0][0] == "a" && ts[1][0] == "b", "text nested slice");
  ts[0][0]
}
fn main() {
  assert(intslice() == 7, "intslice");
  assert(textslice() == "a", "textslice");
  print("553 nested-vector slice ok\n");
}
