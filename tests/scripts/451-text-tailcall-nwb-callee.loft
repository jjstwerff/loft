// Routing feedback 2026-07-02 — a `-> text` fn whose TAIL EXPRESSION calls a
// text fn with a HEAP param miscompiled on native: the callee is bufferless
// (returns an owned String), and the tail-position Return reached emit.rs as
// `Span(Call(..))`, which the bare `Value::Call` probes missed — so the nwb
// scratch/buffer route was skipped and `return Str::new(<String>)` failed
// E0308.  An explicit `return helper();` (parse_return carries the call
// unspanned) never reproduced, which is what hid it.  Fixed by unspanning
// both call-shape probes; this pins the tail-position shape.

fn ttc_pick_field(obj: JsonValue, name: text) -> text {
  v = obj.field(name);
  if v.kind() == "JString" { v.as_text() } else { "" }
}

fn ttc_tail(root: JsonValue) -> text {
  nm = ttc_pick_field(root, "a");
  if nm != "" { return nm; }
  ttc_pick_field(root, "b")
}

fn ttc_explicit(root: JsonValue) -> text {
  nm = ttc_pick_field(root, "a");
  if nm != "" { return nm; }
  return ttc_pick_field(root, "b");
}

fn test_tail_call_of_heap_param_callee() {
  tt_r = json_parse("{{\"b\":\"world\"}}");
  assert(ttc_tail(tt_r) == "world", "tail: got {ttc_tail(tt_r)}");
  assert(ttc_explicit(tt_r) == "world", "explicit: got {ttc_explicit(tt_r)}");
}

fn test_present_first_key_unchanged() {
  tp_r = json_parse("{{\"a\":\"hello\",\"b\":\"world\"}}");
  assert(ttc_tail(tp_r) == "hello", "first key: got {ttc_tail(tp_r)}");
}
