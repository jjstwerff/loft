// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Regression: a `-> text?` function with two or more returns whose value is a
// CALL handed back corrupted bytes on `--native`, silently. `--interpret` was
// correct, and the two backends compile from byte-identical bytecode — the
// divergence was entirely in the native generator.
//
// Only the LAST return delivered through the caller-owned `___tret` buffer:
//
//   text     return { let _tmp = (&var___ret_1).to_string();
//                     *var____tret_1 = _tmp; Str::new(&*var____tret_1) }
//   text?    return Str::new(&var___ret_1)      <- borrows a local that drops
//
// Every non-final return bound its value to a `__ret_N` local `String` and
// returned a `Str` borrowing it, so the frame dropped the backing buffer before
// the caller read it. `needs_p205_scratch`'s `returns_local_text` guard — the
// one that routes exactly this shape through the work buffer — matched the
// un-peeled `Type::Text(_)`, and a `text?` local is `Type::Optional(Text)`.
// Its sibling guard `returns_text` in the same expression already peeled with
// `.base()` for the same reason.
//
// Non-null `text` was unaffected, which is why this stayed hidden: the working
// member hid the omission. So every cell below carries a non-null twin.
//
// The cells vary ONE axis each — nullability, how many call-returns, whether
// the callee is itself nullable — and pin the selected branch by value, so a
// fix that merely stops the corruption while returning the wrong arm fails here.

fn lo(n: integer) -> text? { return "lo{n}"; }
fn hi(n: integer) -> text? { return "hi{n}"; }
fn lo_n(n: integer) -> text { return "lo{n}"; }
fn hi_n(n: integer) -> text { return "hi{n}"; }

// The filed shape: nullable, TWO returns of call results. The early return is
// the corrupted one.
fn two(which: boolean, n: integer) -> text? {
  if !which { return lo(n) }
  return hi(n);
}

// THREE returns, so the fix is not an off-by-one that happens to work at two:
// on the broken binary BOTH non-final returns came back as garbage.
fn three(k: integer, n: integer) -> text? {
  if k == 0 { return lo(n) }
  if k == 1 { return hi(n) }
  return lo(n + 100);
}

// Nullable caller, NON-NULL callee — the trigger is the caller's return type,
// not the callee's, so this must be covered too.
fn two_nn_callee(which: boolean, n: integer) -> text? {
  if !which { return lo_n(n) }
  return hi_n(n);
}

// Non-null twin of `two`: the member that always worked. It has to keep
// working — the fix widens a guard, and a widened guard can capture a shape it
// should have left alone.
fn two_plain(which: boolean, n: integer) -> text {
  if !which { return lo_n(n) }
  return hi_n(n);
}

// Nullable with one CALL return and one LITERAL return: only the call mints a
// work buffer, so the return sites are asymmetric.
fn mixed(which: boolean, n: integer) -> text? {
  if !which { return lo(n) }
  return "beta";
}

// Nullable, one return, branches assigning a local — the documented workaround
// shape. It was correct before and must stay correct.
fn via_local(which: boolean, n: integer) -> text? {
  out: text? = null;
  if !which { out = lo(n) } else { out = hi(n) }
  return out;
}

// A tail expression rather than an explicit `return`, reached after an early
// call-return: the same local-`String` delivery through a different path.
fn early_then_tail(which: boolean, n: integer) -> text? {
  if !which { return lo(n) }
  out: text? = hi(n);
  out
}

// A returning branch that actually yields null, so the widened guard is proven
// against the null sentinel rather than only against content.
fn maybe_null(which: boolean, n: integer) -> text? {
  if !which { return null }
  return hi(n);
}

fn main() {
  // Two call-returns: the EARLY branch is the one that corrupted.
  assert(two(false, 1) == "lo1", "nullable text, early call-return");
  assert(two(true, 1) == "hi1", "nullable text, final call-return");

  // Three call-returns: both non-final branches.
  assert(three(0, 1) == "lo1", "three call-returns, first branch");
  assert(three(1, 1) == "hi1", "three call-returns, second branch");
  assert(three(2, 1) == "lo101", "three call-returns, final branch");

  // A corrupted `Str` borrows a dropped buffer, so its LENGTH is as wrong as
  // its content. Assert it separately — an equality check alone can be
  // satisfied by a fix that returns the right bytes with a stale length.
  assert(size(two(false, 1) ?? "") == 3, "early call-return has the right size");
  assert(size(three(0, 1) ?? "") == 3, "three-return first branch has the right size");

  assert(two_nn_callee(false, 1) == "lo1", "non-null callee, early call-return");
  assert(two_nn_callee(true, 1) == "hi1", "non-null callee, final call-return");

  assert(two_plain(false, 1) == "lo1", "non-null return, early call-return");
  assert(two_plain(true, 1) == "hi1", "non-null return, final call-return");

  assert(mixed(false, 1) == "lo1", "mixed call/literal returns, call arm");
  assert(mixed(true, 1) == "beta", "mixed call/literal returns, literal arm");

  assert(via_local(false, 1) == "lo1", "single return via a local, first branch");
  assert(via_local(true, 1) == "hi1", "single return via a local, second branch");

  assert(early_then_tail(false, 1) == "lo1", "early call-return before a tail");
  assert(early_then_tail(true, 1) == "hi1", "tail after an early call-return");

  assert(maybe_null(false, 1) == null, "a returning branch that yields null");
  assert(maybe_null(true, 1) == "hi1", "call-return beside a null return");

  // Two calls live in ONE expression: the second must not overwrite the first
  // through a shared buffer, which is the failure a per-call fix would leave.
  assert("{two(false, 1) ?? "?"}|{two(true, 1) ?? "?"}" == "lo1|hi1",
    "two nullable text returns in one interpolation");

  println("nullable text multi-return ok");
}
