//
// loft#983 — `1.0 / 0.0` gives ONE answer, wherever the value goes.
//
// It gave two. Inline it was `inf`; bound to a local, declared `float?`, or handed back
// from a function it was `null` — the same expression, both backends, nothing reported.
// Two ops sat behind one operator: `OpDivFloat` forced NaN on a zero divisor, and the
// `OpDivFloatNullable` peer did raw IEEE, emitted at "defended" sites. Which one you got
// depended on the DESTINATION, which is not something an author can see.
//
// The model is IEEE with **NaN as the one float null** (`doc/23-safety`: "NaN (Not a
// Number) is null"), so `0.0 / 0.0` is null and `1.0 / 0.0` is `inf` — a representable
// value, not a missing one. Three things say so and all three now agree:
//
//   * float OVERFLOW is the sibling: `1.0e308 * 10.0` is `inf` in EVERY position and
//     always was, though it produces the identical IEEE value that division does. That
//     asymmetry is what named the defect.
//   * `??` was self-defeating: at a `a / b ?? 0.0` site the peer that never yields null
//     was chosen, so the idiom every numeric library uses to defend a divide guarded
//     nothing. `mesh3d::normalize3` is written that way and was sound only by accident
//     (a zero-length vector makes the numerator zero too, so it really is `0.0 / 0.0`).
//   * an unguarded zero divisor still logs its Warn and still CONTINUES (C80 / E-Report).
//     Only the value changed; no runtime error was added or removed.
//
// The cells below drive each shape through every destination a value can reach.

struct F983Box { v: float }

fn f983_ret(a: float, b: float) -> float? { a / b }
fn f983_take(v: float?) -> text {
  if !v { "null" } else { if v > 1.0e308 { "inf" } else { "finite" } }
}
fn f983_ret_single(a: single, b: single) -> single? { a / b }

fn main() {
  fz: float = 0.0;
  one: float = 1.0;
  neg: float = -1.0;

  // ── `1.0 / 0.0` is `inf` in every destination ──────────────────────────────────────
  assert(one / fz > 1.0e308, "inline: {one / fz}");
  assert(one / fz > 1.0, "inline compare");
  x = one / fz;
  assert(x > 1.0e308, "bound to an inferred local: {x}");
  assert(x > 1.0, "and it compares as a number, not as null");
  y: float? = one / fz;
  assert(y > 1.0e308, "bound to a declared `float?`: {y}");
  assert(f983_take(one / fz) == "inf", "as a call argument: {f983_take(one / fz)}");
  assert(f983_take(f983_ret(one, fz)) == "inf", "through a return: {f983_take(f983_ret(one, fz))}");
  b983 = F983Box { v: one / fz };
  assert(b983.v > 1.0e308, "into a struct field: {b983.v}");
  v983: vector<float> = [one / fz];
  assert(v983[0] > 1.0e308, "into a vector element: {v983[0]}");
  assert(one / fz + 1.0 > 1.0e308, "summed inline");
  assert(neg / fz < -1.0e308, "the negative side is -inf: {neg / fz}");

  // ── `0.0 / 0.0` is null in every destination — NaN is the float null ───────────────
  assert(!(fz / fz), "NaN inline is null: {fz / fz}");
  n = fz / fz;
  assert(!n, "NaN bound is null: {n}");
  assert(f983_take(fz / fz) == "null", "NaN as an argument is null");
  assert(f983_take(f983_ret(fz, fz)) == "null", "NaN through a return is null");

  // ── `??` fires on the null and NOT on the value, which is the whole point ──────────
  assert((fz / fz ?? -1.0) == -1.0, "`??` discharges the NaN: {fz / fz ?? -1.0}");
  assert((one / fz ?? -1.0) > 1.0e308, "`??` leaves `inf` alone: {one / fz ?? -1.0}");

  // ── The sibling that named the defect: overflow, in both positions ─────────────────
  assert(1.0e308 * 10.0 > 1.0e308, "overflow inline is inf");
  ov = 1.0e308 * 10.0;
  assert(ov > 1.0e308, "overflow bound is inf — division must agree with it: {ov}");

  // ── `%` by zero is NaN by IEEE, so it is null in both positions ────────────────────
  assert(!(one % fz), "modulo by zero inline is null: {one % fz}");
  m = one % fz;
  assert(!m, "modulo by zero bound is null: {m}");

  // ── `single` mirrors `float` ──────────────────────────────────────────────────────
  szf: single = 0.0f;
  sone: single = 1.0f;
  assert(sone / szf > 1.0e38f, "single inline is inf: {sone / szf}");
  sx = sone / szf;
  assert(sx > 1.0e38f, "single bound is inf: {sx}");
  assert(f983_ret_single(sone, szf) > 1.0e38f, "single through a return is inf");
  assert(!(szf / szf), "single NaN is null");

  // ── A non-zero divisor is untouched ───────────────────────────────────────────────
  two: float = 2.0;
  assert(one / two == 0.5, "an ordinary divide still divides: {one / two}");
  assert(f983_ret(one, two) == 0.5, "through a return too");

  print("983 float divide OK\n");
}
