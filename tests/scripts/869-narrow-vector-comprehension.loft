//
// loft#869 — a comprehension into a vector of a NARROW integer type.
//
// `narrow_elm_set` picks the store op for an element's own width, and its contract is
// that every site BUILDING a vector routes through it. The comprehension did not: it
// went straight to `set_field`, which dispatches on the element DEF, and a narrow
// integer is an ALIAS of `integer` — so a 4-byte slot got the wide 8-byte `OpSetInt`.
// Every element overwrote the next, and once the writes passed the initial allocation
// they reached the vector's own bookkeeping and `vector_add` stopped terminating:
// `[for i in 0..13 { i as i32 }]` hung, while `0..12` returned instantly. The `+=`
// append loop was already routed correctly, which is why it was unaffected at any
// size, and `vector<integer>` never showed it because there 8 bytes is the right width.
//
// The guard checks ELEMENTS, not just the length: a store that clobbers its
// neighbours can leave the count right while the values are wrong, and the original
// report's own `r.len()` probe could not have told the difference. Sizes straddle the
// 12/13 boundary and go past the initial allocation in every width.

fn nvc_check_i32(n: integer) {
  nvc_r: vector<i32> = [for i in 0..n { i as i32 }];
  assert(len(nvc_r) == n, "i32 len n={n}");
  nvc_s: integer = 0;
  for e in nvc_r { nvc_s += e; }
  assert(nvc_s == n * (n - 1) / 2, "i32 sum n={n} got {nvc_s}");
  assert(nvc_r[0] == 0 as i32, "i32 first n={n}");
  assert(nvc_r[n - 1] == (n - 1) as i32, "i32 last n={n}");
}

fn main() {
  // 12 was the last size that worked; everything from 13 up hung.
  nvc_check_i32(1);
  nvc_check_i32(11);
  nvc_check_i32(12);
  nvc_check_i32(13);
  nvc_check_i32(14);
  nvc_check_i32(17);
  nvc_check_i32(33);
  nvc_check_i32(500);

  // The other widths, each past its own boundary (i8/u8 turned at 17, the 2- and
  // 4-byte ones at 13). Values stay distinct so a neighbour-clobbering write cannot
  // pass by writing the same number everywhere. The UNSIGNED targets mask rather than
  // take a remainder: `i % 100` types as `integer(-99, 99)`, which no unsigned type
  // accepts. Every expected value below is hand-computed (`299 & 63 == 43`).
  nvc_8: vector<i8> = [for i in 0..100 { (i % 100) as i8 }];
  assert(len(nvc_8) == 100, "i8 len");
  assert(nvc_8[0] == 0 as i8 && nvc_8[17] == 17 as i8 && nvc_8[99] == 99 as i8, "i8 elems");

  nvc_u8: vector<u8> = [for i in 0..300 { (i & 63) as u8 }];
  assert(len(nvc_u8) == 300, "u8 len");
  assert(nvc_u8[13] == 13 as u8 && nvc_u8[299] == 43 as u8, "u8 elems");

  nvc_16: vector<i16> = [for i in 0..300 { (i % 100) as i16 }];
  assert(len(nvc_16) == 300, "i16 len");
  assert(nvc_16[13] == 13 as i16 && nvc_16[299] == 99 as i16, "i16 elems");

  nvc_u16: vector<u16> = [for i in 0..300 { (i & 255) as u16 }];
  assert(len(nvc_u16) == 300, "u16 len");
  assert(nvc_u16[13] == 13 as u16 && nvc_u16[299] == 43 as u16, "u16 elems");

  nvc_u32: vector<u32> = [for i in 0..300 { (i & 255) as u32 }];
  assert(len(nvc_u32) == 300, "u32 len");
  assert(nvc_u32[13] == 13 as u32 && nvc_u32[299] == 43 as u32, "u32 elems");

  // The full-width control: 8 bytes into an 8-byte slot always worked.
  nvc_i64: vector<integer> = [for i in 0..300 { i }];
  assert(len(nvc_i64) == 300 && nvc_i64[299] == 299, "integer elems");

  println("done");
}
