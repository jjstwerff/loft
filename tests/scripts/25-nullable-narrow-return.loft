// SPDX-License-Identifier: LGPL-3.0-or-later
// @PLN25 — a function returning a nullable NARROW integer (`u8?`/`u16?`/`i8?`/`i16?`).
// A nullable narrow int is carried FULL-WIDTH (i64) as a value — the narrow packing is
// store-only. That is a REPRESENTATION fact and decides nothing about the type: `u8?`'s range
// excludes its sentinel wherever the value is KEPT (@FR-N-Reserve), so 255 is null in a return
// too, and reading the type off the carrier is what let a local disagree with a field
// (loft#1249). The native generator used to lower the
// RETURN TYPE to the narrow base (`-> u8`) while the body returned the i64 value, so `rustc`
// rejected it (E0308) — the fn compiled on --interpret but failed to build on --native. The
// fix: `rust_type(Optional(Integer), _)` is `i64` (src/generation/mod.rs), matching the value.
// This is a both-backend guard; it must run identically on --interpret and --native.
fn ret_u8(i: integer) -> u8? {
  r = i as u8?; r
}
fn lit_u8() -> u8? {
  200
}
fn ret_u16(i: integer) -> u16? {
  r = i as u16?; r
}
fn ret_i16(i: integer) -> i16? {
  r = i as i16?; r
}

fn main() {
  // The reserved edge is null; the value below it is carried whole, which is what the
  // full-width carrier this file was written for actually buys.
  assert(ret_u8(255) == null, "255 is the null of a u8?, got {ret_u8(255)}");
  assert(ret_u8(254) == 254, "254 is a u8? value, got {ret_u8(254)}");
  // out of the u8 range -> null (the honest nullable result).
  assert(ret_u8(300) == null, "ret_u8(300) should be null");
  // a plain literal in a nullable-narrow return.
  assert(lit_u8() == 200, "lit_u8={lit_u8()}");
  // u16 (2-byte) — the same, one width up.
  assert(ret_u16(65535) == null, "65535 is the null of a u16?, got {ret_u16(65535)}");
  assert(ret_u16(65534) == 65534, "65534 is a u16? value, got {ret_u16(65534)}");
  assert(ret_u16(70000) == null, "ret_u16(70000) should be null");
  // A SIGNED narrow spends its BOTTOM code, so its top stays a value.
  assert(ret_i16(-5) == -5, "ret_i16(-5)={ret_i16(-5)}");
  assert(ret_i16(-32768) == null, "-32768 is the null of an i16?, got {ret_i16(-32768)}");
  assert(ret_i16(32767) == 32767, "an i16? keeps its top value, got {ret_i16(32767)}");
  assert(ret_i16(999999) == null, "ret_i16(999999) should be null");
}
