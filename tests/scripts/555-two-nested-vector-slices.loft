//
// #555 — TWO nested-vector slices `a[lo..hi]` in the SAME function desynced: the second slice's
// first element silently read null.  Root cause: `type_def_nr(vector<T>)` collapses EVERY vector
// to the one generic `vector` source def, so `unique_elm_var` gave every slice's element var a
// SHARED inner type (last write wins).  Fix: the element var keeps its OWN `vector<T>` type.
// (Surfaced once #553 made a single nested slice work; the filed "differently-typed only" scope
// was too narrow — SAME-typed two slices desynced too.)  Both backends.

// same element type, two slices from two sources — the second used to read null.
fn same_typed() -> integer {
  a = [[1, 2], [3, 4]];
  s = a[0..2];
  b = [[9, 8]];
  w = b[0..1];
  assert(s[0][0] == 1 && s[1][1] == 4, "first int slice");
  assert(w[0][0] == 9 && w[0][1] == 8, "second int slice not null");
  s[0][0] + w[0][0]                     // 1 + 9 = 10
}

// DIFFERENTLY-typed slices in one function (the originally-reported shape).
fn diff_typed() -> text {
  a = [[1, 2]];
  s = a[0..1];
  t = [["k"], ["m"]];
  u = t[0..2];
  assert(s[0][0] == 1, "int slice value");
  assert(u[0][0] == "k" && u[1][0] == "m", "text slice — first elem not null");
  "{s[0][0]}/{u[0][0]}/{u[1][0]}"       // 1/k/m
}

// three slices, mixed order — every element of every slice must survive.
fn three_way() -> integer {
  a = [[1, 2], [3, 4]];       sa = a[0..2];
  t = [["p"], ["q"], ["r"]];  st = t[0..3];
  b = [[5, 6, 7]];            sb = b[0..1];
  assert(sa[1][0] == 3, "sa");
  assert(st[2][0] == "r", "st last");
  assert(sb[0][2] == 7, "sb");
  sa[0][0] + sb[0][2]                    // 1 + 7 = 8
}

fn main() {
  assert(same_typed() == 10, "same_typed: {same_typed()}");
  assert(diff_typed() == "1/k/m", "diff_typed: {diff_typed()}");
  assert(three_way() == 8, "three_way: {three_way()}");
  print("555 two-nested-vector-slices ok\n");
}
