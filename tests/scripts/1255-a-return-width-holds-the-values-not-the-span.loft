//
// The Rust type a narrow integer RETURN is given must hold the range's VALUES, not count them
// (loft#1255).
//
// `rust_type`'s Result arms and `narrow_int_cast` both read the SPAN — `range() - 1 <= 255` —
// and answered `u8` for `integer limit(300, 400)`: 101 values, which fit a byte only
// OFFSET-encoded.  The store layer does encode that way; a register does not.  So a body of
// `350` came back as `94` on `--native` and `350` on `--interpret`, with no diagnostic, on
// every build back to the 2026-08-29 release.
//
// `formal/layout.md` is why the answer is the values: the packed form is a STORAGE fact
// (@FR-L-Narrow), so the span belongs to `bytes_for_range` and never to a register.  A value
// in flight is its plain number, which is what the interpreter's i64 slot already did — the
// two backends disagreed because only one of them was reading the layout as a value fact.
//
// The two predicates are one home now.  They had to agree already — the signature and the
// cast at the return site are the same decision written twice — and being two copies is how
// they came to share the defect rather than catch it.
//
// @falsified-at: ae97ca58 — native exit 1 -> 0, native 1 assertion failures -> 0; interpret
//   INERT (expected for a backend-divergence guard — only one side can move).  The interpret
//   side being INERT is what makes it the control: every cell reads the same on both trees
//   there, because the interpreter never used the narrow width.  A guard whose two backends
//   BOTH moved would not be measuring a divergence.  The count is 1 rather than 3 because a
//   run stops at the first failing assertion in a function.

fn r_narrow_span_high() -> integer limit(300, 400)     { 350 }
fn r_wide_span_high()   -> integer limit(200, 400)     { 350 }
fn r_far_from_zero()    -> integer limit(70000, 70100) { 70050 }
fn r_fits_a_byte()      -> integer limit(0, 255)       { 200 }
fn r_needs_two_bytes()  -> integer limit(0, 300)       { 290 }
fn r_alias_u8()         -> u8                          { 200 }
fn r_alias_i16()        -> i16                         { 0 - 30000 }
fn r_signed_small()     -> integer limit(-5, 5)        { 0 - 3 }
fn r_plain()            -> integer                     { 5000000000 }

fn test_a_range_that_does_not_start_at_zero_returns_its_value() {
  // The filed cell and its neighbour.  Both are 101 and 201 values wide — narrow by SPAN —
  // and both hold values a byte cannot carry.
  assert(r_narrow_span_high() == 350, "limit(300,400) returns 350, got {r_narrow_span_high()}");
  assert(r_wide_span_high() == 350, "limit(200,400) returns 350, got {r_wide_span_high()}");

  // The cell that shows this is not a u8-vs-u16 boundary question: a 101-wide range picked
  // `u8` for a FIVE-DIGIT number, so the width was being derived from the wrong quantity
  // altogether.  Without this cell, "use u16 instead of u8" satisfies the two above.
  assert(r_far_from_zero() == 70050, "limit(70000,70100) returns 70050, got {r_far_from_zero()}");
}

fn test_the_ranges_that_already_worked_are_unchanged() {
  // The controls, and they are the reason the defect stayed invisible: where `min == 0` the
  // span and the maximum coincide, so the wrong quantity gives the right answer.  Every
  // range anyone writes by hand starts at zero.
  assert(r_fits_a_byte() == 200, "limit(0,255) returns 200, got {r_fits_a_byte()}");
  assert(r_needs_two_bytes() == 290, "limit(0,300) returns 290, got {r_needs_two_bytes()}");

  // The ALIASES are the other reason: their bounds match their storage width by construction,
  // so no alias can exhibit this — only the `limit(lo, hi)` spelling can.
  assert(r_alias_u8() == 200, "a u8 return is 200, got {r_alias_u8()}");
  assert(r_alias_i16() == 0 - 30000, "an i16 return is -30000, got {r_alias_i16()}");

  // A signed range small enough for `i8`, to hold the sign arm of the predicate.
  assert(r_signed_small() == 0 - 3, "limit(-5,5) returns -3, got {r_signed_small()}");

  // And plain `integer`, which takes no narrow width at all — the negative control that fails
  // if the predicate ever narrows something it should not.
  assert(r_plain() == 5000000000, "a plain integer return is not narrowed, got {r_plain()}");
}
