//
// H2 step 5 (DEPS_INVENTORY § step 5) — the EXPLICIT-return closure
// factory: `return add;` reaches scope analysis with an empty
// block-result dep list, so the closure record's survival rests solely
// on the declared return type's callee-frame note (now a TAGGED dep
// entry, `Deps::callee_frame1`; decoded by `Deps::entries`).  The
// implicit-return form is covered by 56-closures / docs 26-closures;
// this cell guards the tagged-note read paths in `scopes.rs`
// (`get_free_vars`' fn-ref arm + the declared-return decode).

fn make_adder(base: integer) -> fn(integer) -> integer {
  add = fn(x: integer) -> integer {
    x + base
  };
  return add;
}

fn main() {
  a5 = make_adder(5);
  a10 = make_adder(10);
  // Distinct closure records: the second factory call must not reuse
  // the first record's store (the H2 step-3 bisect symptom).
  assert(a5(1) == 6, "a5 sees base=5, got {a5(1)}");
  assert(a10(1) == 11, "a10 sees base=10, got {a10(1)}");
  // The first record is still alive after the second was created.
  assert(a5(2) == 7, "a5 alive after a10, got {a5(2)}");
}
