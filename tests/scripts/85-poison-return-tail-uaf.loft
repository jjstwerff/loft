// @PLN85 poison-green worklist — the return-tail UAF family LOFT_POISON exposed
// (silent stale reads without it).  Root: return-site frees ran BEFORE the tail
// expression evaluated.  Fixes: (1) the B5-L3 hoist extended into block tails
// (scopes::insert_free — Set(__ret_N, tail); frees; Return(__ret_N)) for value
// AND text results; (2) a RefVar-typed Var tail derefs its place DbRef at the
// Return, so it hoists too (the free_vars fast-path exclusion); (3) a fn-ref
// FIELD READ bound to a local (`c = k.cb`) is a BORROWED fn-ref — marked
// skip_free so scope exit never frees the caller's closure record through the
// alias (get_free_vars' Function arm frees unconditionally otherwise).
//
// Run under LOFT_POISON=1 to make a regression loud; the values assert either way.

// (1a) scalar closure-field capture (p213): the fn-ref field call is the tail.
struct BoxCb { cb: fn(integer) -> integer }
fn t1_scalar_tail(n: integer) -> integer {
  b = BoxCb { cb: fn(x: integer) -> integer { x + n } };
  b.cb(10)
}

// (1b) text closure-field capture (p227): the text-result variant of the hoist.
struct G { fmt: fn(integer) -> text }
fn t2_text_tail() -> text {
  label = "z";
  g = G { fmt: fn(n: integer) -> text { "{label}: {n}" } };
  g.fmt(42)
}

// (2) &-place tails (pln87 L3/L4): returning the ref derefs AFTER the frees.
struct S { a: integer, b: integer }
fn t3_field_ref() -> integer {
  s = S { a: 3, b: 7 };
  r = &s.b;
  s.b = 5;
  r
}
fn t4_elem_ref() -> integer {
  v = [10, 20];
  c = &v[0];
  v[0] = 5;
  c
}

// (3) borrowed fn-ref binder across fns (issue_313): freeing `c`'s closure
// through the alias killed the CALLER's record before the second call.
struct Counter { n: integer not null }
struct K { cb: fn(text) }
fn t5_fire(k: K, p: text) { c = k.cb; c(p); }
fn t5_fire_direct(k: K, p: text) { k.cb(p); }
fn t5_cross_fn() -> integer {
  w = Counter { n: 0 };
  k = K { cb: fn(p: text) { w.n = w.n + 1; } };
  t5_fire(k, "a");
  t5_fire_direct(k, "b");
  w.n
}

fn main() {
  assert(t1_scalar_tail(5) == 15, "t1: {t1_scalar_tail(5)}");
  assert(t2_text_tail() == "z: 42", "t2: {t2_text_tail()}");
  assert(t3_field_ref() == 5, "t3: {t3_field_ref()}");
  assert(t4_elem_ref() == 5, "t4: {t4_elem_ref()}");
  assert(t5_cross_fn() == 2, "t5: {t5_cross_fn()}");
  println("poison-return-tail-uaf ok");
}
