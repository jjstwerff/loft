//
// Assigning a fn-ref INTO a place that already holds one — a struct field or a vector
// element (loft#1072).
//
// `formal/closures.md`'s `L-Escape` says a closure is a value that may be stored in a
// variable or a struct field. It said nothing about the slot being fresh, and every
// destination that shipped was one being INITIALISED — so `h.f = inc` and `v[0] = inc`
// were refused on both backends, and refused by the wrong rule: a fn-ref READ lowers to a
// `fn_ref_field_read` Block (@PLN114's split layout takes two reads to assemble the
// 20-byte pair), which is neither the `Call` getter nor the `Var` the assignment
// dispatcher recognises as a place. Not being recognised as writing ANYWHERE, it fell
// through to *"Not implemented operation = for type function(…)"* — a message about the
// `=` operator, contradicted by the same field accepting the same value in a literal one
// line earlier.
//
// The fix hands each destination to the writer the LITERAL already uses — a struct field
// to `set_field`, a vector element to `fn_ref_slot_dnr` — so the two positions cannot come
// to different conclusions about what a fn-ref source may be. That is why the REFUSALS are
// asserted here beside the values: `test_a_non_inline_source_is_refused` and
// `fnas_capturing_into_a_vector_element` are not gaps in the fix, they are the shipped
// P215/@P213 and #247 decisions, now reached by the assignment as well.
//
// Three things a slot that already holds a value needs that a fresh one does not, each
// measured failing before the fix:
//
//   * **The closure half must be released.** Writing a non-capturing source into a SPLIT
//     field (one some capturing lambda gave a `__closure_rec` half) left the previous
//     closure record in place, so the field read back as the NEW function paired with the
//     OLD closure — and `fn_call_ref` pushes a non-null closure as the hidden argument, so
//     the callee is entered with an argument it does not declare. Not a stale value but a
//     corrupt frame: the call returned with the stack misaligned and the next read of an
//     unrelated field (`h.tag`) faulted in `get_int`. Assigning a CAPTURING source instead
//     orphaned the old record in the host's store — a leak that grows with the loop.
//     Both are closed by one `OpClearKeyed` against the `child_rec<…>` field, the same
//     `remove_claims` cascade that frees it when the host dies.
//   * **Pass 1 must record a capturing source.** An attribute only gets the split layout
//     because `assigned_lambda_d_nr` was set while pass 1 parsed the write, and the byte
//     offset the read carries is `u16::MAX` on pass 1 (the struct has no layout yet). A
//     pass-2-only recording emitted a write into a `__closure_rec` half that was never
//     registered — the interpreter faulted and `--native` refused the generated schema.
//   * **The host may be a `&` parameter.** `h.f = inc` inside `fn f(h: &Holder)` is the
//     same write through a `RefVar(Reference)` rather than a `Reference`; reading only the
//     second shape sent it to the four-byte path, which is the first bullet's crash again.
//
// ⚠ Every cell CALLS what it stored, and the ones that matter read a plain field beside
// it. A probe that assigns and never reads passes vacuously: the pre-fix failure was a
// clean compile-time refusal for the plain cases and a runtime fault for the split ones,
// so only reading back tells the two apart.
//
// (Measured on a pristine tree at 655ff4dd: every assignment cell below was
// *"Not implemented operation = for type function(…)"* on BOTH backends. The tuple-member
// destination already worked and is pinned next door in
// `fn-ref-reassignment-tops-up-the-pair.loft`.)

// The `FnasCap*` structs exist so each CAPTURING cell has a holder of its own, and the
// duplication is the shipped rules speaking rather than clutter.  A capturing lambda
// anywhere in the program gives that attribute the split layout for the whole program and
// makes the struct one that "holds a capturing closure" — after which a non-capturing
// LOCAL source is refused (P215) and a vector of the struct is refused (#318).  A SECOND
// capturing lambda at the same attribute is refused again, by the one-capture-shape-per-
// field rule.  All three apply to the literal exactly as to the assignment, so sharing one
// struct would test those rules instead of testing the assignment.
struct FnasHolder { f: fn(integer) -> integer, tag: integer }
struct FnasCap1 { f: fn(integer) -> integer, tag: integer }
struct FnasCap2 { f: fn(integer) -> integer, tag: integer }
struct FnasCap3 { f: fn(integer) -> integer, tag: integer }
struct FnasTwo { a: fn(integer) -> integer, b: fn(integer) -> integer, tag: integer }
struct FnasBox { fs: vector<fn(integer) -> integer>, tag: integer }
struct FnasEnt { name: text, f: fn(integer) -> integer }

fn fnas_dbl(x: integer) -> integer { x * 2 }
fn fnas_inc(x: integer) -> integer { x + 1 }
fn fnas_trip(x: integer) -> integer { x * 3 }
fn fnas_get() -> fn(integer) -> integer { fnas_inc }
fn fnas_apply(h: FnasHolder) -> integer { h.f(3) }
// The `&` is the POINT of `test_writing_through_a_reference_parameter`, not an oversight:
// the host arrives typed `RefVar(Reference)` rather than `Reference`, and reading only the
// second shape is what sent this write to the four-byte path.  The advice is right that a
// plain parameter would do the same job faster — it is declared, not followed.
// #warn only slows it down here
fn fnas_write_through(h: &FnasHolder) { h.f = fnas_inc; }

fn test_a_bare_name_into_a_struct_field() {
  h: FnasHolder = FnasHolder { f: fnas_dbl, tag: 7 };
  assert(h.f(3) == 6, "before the assignment: got {h.f(3)}");
  h.f = fnas_inc;
  assert(h.f(3) == 4, "after assigning a bare name: got {h.f(3)}");
  assert(h.tag == 7, "the field beside it: got {h.tag}");
}

fn test_an_inline_lambda_into_a_struct_field() {
  h: FnasHolder = FnasHolder { f: fnas_dbl, tag: 7 };
  h.f = |x| { x + 1 };
  assert(h.f(3) == 4, "after assigning an inline lambda: got {h.f(3)}");
  assert(h.tag == 7, "the field beside it: got {h.tag}");
}

fn test_a_non_capturing_local_into_a_struct_field() {
  g = fnas_inc;
  h: FnasHolder = FnasHolder { f: fnas_dbl, tag: 7 };
  h.f = g;
  assert(h.f(3) == 4, "after assigning a non-capturing local: got {h.f(3)}");
  assert(h.tag == 7, "the field beside it: got {h.tag}");
}

fn test_the_right_field_of_two() {
  // `fnas_attr_at` resolves the attribute from the write's byte offset; with two fn-ref
  // fields in one struct, picking the wrong one is a silent wrong answer, not an error.
  t: FnasTwo = FnasTwo { a: fnas_dbl, b: fnas_dbl, tag: 9 };
  t.b = fnas_inc;
  assert(t.a(3) == 6, "the field NOT assigned: got {t.a(3)}");
  assert(t.b(3) == 4, "the field assigned: got {t.b(3)}");
  assert(t.tag == 9, "the field beside them: got {t.tag}");
}

fn test_a_bare_name_into_a_vector_element() {
  v: vector<fn(integer) -> integer> = [fnas_dbl, fnas_dbl];
  v[0] = fnas_inc;
  assert(v[0](3) == 4, "the element assigned: got {v[0](3)}");
  assert(v[1](3) == 6, "the element beside it: got {v[1](3)}");
}

fn test_a_local_and_a_call_into_a_vector_element() {
  g = fnas_inc;
  v: vector<fn(integer) -> integer> = [fnas_dbl, fnas_dbl, fnas_dbl];
  v[1] = g;
  v[2] = fnas_get();
  assert(v[0](3) == 6, "the untouched element: got {v[0](3)}");
  assert(v[1](3) == 4, "assigned from a local: got {v[1](3)}");
  assert(v[2](3) == 4, "assigned from a call: got {v[2](3)}");
}

fn test_an_element_index_is_evaluated_once() {
  // The write addresses the element through the SAME expression the read did; an index
  // that does work must still do it once.
  c: vector<integer> = [0];
  v: vector<fn(integer) -> integer> = [fnas_dbl, fnas_dbl, fnas_dbl];
  v[fnas_bump(c)] = fnas_inc;
  assert(v[0](3) == 4, "the element the single evaluation chose: got {v[0](3)}");
  assert(v[1](3) == 6, "the element beside it: got {v[1](3)}");
  assert(c[0] == 1, "the index expression ran {c[0]} times, not once");
}

fn fnas_bump(c: vector<integer>) -> integer { c[0] = c[0] + 1; c[0] - 1 }

fn test_a_field_of_a_vector_element() {
  vs: vector<FnasHolder> = [FnasHolder { f: fnas_dbl, tag: 1 }, FnasHolder { f: fnas_dbl, tag: 2 }];
  vs[0].f = fnas_inc;
  assert(vs[0].f(3) == 4, "the element's field assigned: got {vs[0].f(3)}");
  assert(vs[1].f(3) == 6, "the element beside it: got {vs[1].f(3)}");
  assert(vs[0].tag == 1, "the field beside it: got {vs[0].tag}");
}

fn test_a_vector_field_element() {
  b: FnasBox = FnasBox { fs: [fnas_dbl, fnas_dbl], tag: 5 };
  b.fs[0] = fnas_inc;
  assert(b.fs[0](3) == 4, "the field's element assigned: got {b.fs[0](3)}");
  assert(b.fs[1](3) == 6, "the element beside it: got {b.fs[1](3)}");
  assert(b.tag == 5, "the field beside it: got {b.tag}");
}

fn test_a_keyed_collection_value_field() {
  // A keyed collection's element is a record like any other, reached by key rather than by
  // index — so the write lands in `set_field` through a different address expression.
  es: hash<FnasEnt[name]> = [FnasEnt { name: "a", f: fnas_dbl }];
  es["a"].f = fnas_inc;
  assert(es["a"].f(3) == 4, "a fn field of a keyed element: got {es["a"].f(3)}");
  assert(es["a"].name == "a", "the key beside it: got {es["a"].name}");
}

fn test_writing_through_a_reference_parameter() {
  h: FnasHolder = FnasHolder { f: fnas_dbl, tag: 7 };
  fnas_write_through(h);
  assert(h.f(3) == 4, "the write through a `&` parameter: got {h.f(3)}");
  assert(h.tag == 7, "the field beside it: got {h.tag}");
}

fn test_a_capturing_lambda_into_a_struct_field() {
  // The field is initialised NON-capturing, so this assignment is what gives the
  // attribute its split layout — which only works because pass 1 records it.
  k = 100;
  h: FnasCap1 = FnasCap1 { f: fnas_dbl, tag: 7 };
  assert(h.f(3) == 6, "before the assignment: got {h.f(3)}");
  h.f = fn(x: integer) -> integer { x + k };
  assert(h.f(3) == 103, "after assigning a capturing lambda: got {h.f(3)}");
  assert(h.f(1) == 101, "the capture survives a second call: got {h.f(1)}");
  assert(h.tag == 7, "the field beside it: got {h.tag}");
}

fn test_a_bare_name_over_a_capturing_lambda() {
  // The reverse order, and the cell that faulted worst: the field has a closure record,
  // and the incoming function declares no closure parameter.  Reading `h.tag` AFTER the
  // call is what caught it — the fault was in the frame, not in the value.
  k = 100;
  h: FnasCap2 = FnasCap2 { f: fn(x: integer) -> integer { x + k }, tag: 7 };
  assert(h.f(3) == 103, "the capturing lambda: got {h.f(3)}");
  h.f = fnas_dbl;
  assert(h.f(3) == 6, "after assigning a bare name over it: got {h.f(3)}");
  assert(h.tag == 7, "the field beside it, read AFTER the call: got {h.tag}");
}

fn test_reassignment_in_a_loop_does_not_grow() {
  // Each capturing assignment claims a fresh closure record in the host's store and the
  // previous one must be released, or the store grows with the iteration count.
  k = 100;
  h: FnasCap3 = FnasCap3 { f: fnas_dbl, tag: 7 };
  n = 0;
  for _i in 0..200 {
    h.f = fn(x: integer) -> integer { x + k };
    n = n + h.f(1);
  }
  assert(n == 20200, "200 capturing reassignments: got {n}");
  assert(h.f(3) == 103, "the last one still answers: got {h.f(3)}");
}

fn test_alternating_bare_names_in_a_loop() {
  h: FnasHolder = FnasHolder { f: fnas_dbl, tag: 7 };
  n = 0;
  for _i in 0..100 {
    h.f = fnas_inc;
    n = n + h.f(1);
    h.f = fnas_trip;
    n = n + h.f(1);
  }
  assert(n == 500, "100 alternating reassignments: got {n}");
  assert(h.f(3) == 9, "the last one still answers: got {h.f(3)}");
}

fn test_the_value_still_travels() {
  // A field written by assignment is not a special kind of field: the whole struct still
  // copies into a call the way a constructed one does.
  h: FnasHolder = FnasHolder { f: fnas_dbl, tag: 7 };
  h.f = fnas_trip;
  assert(fnas_apply(h) == 9, "the assigned field through a call: got {fnas_apply(h)}");
}

fn main() {
  test_a_bare_name_into_a_struct_field();
  test_an_inline_lambda_into_a_struct_field();
  test_a_non_capturing_local_into_a_struct_field();
  test_the_right_field_of_two();
  test_a_bare_name_into_a_vector_element();
  test_a_local_and_a_call_into_a_vector_element();
  test_an_element_index_is_evaluated_once();
  test_a_field_of_a_vector_element();
  test_a_vector_field_element();
  test_a_keyed_collection_value_field();
  test_writing_through_a_reference_parameter();
  test_a_capturing_lambda_into_a_struct_field();
  test_a_bare_name_over_a_capturing_lambda();
  test_reassignment_in_a_loop_does_not_grow();
  test_alternating_bare_names_in_a_loop();
  test_the_value_still_travels();
}
