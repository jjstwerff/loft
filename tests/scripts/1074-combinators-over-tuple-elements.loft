//
// loft#1074 — every vector combinator, over a TUPLE element.
//
// `xs.map(|t| { t.0 * 10 })` on a `vector<(integer, integer)>` answered
// `343597383710` — a packed DbRef read as an integer, with no diagnostic — `filter`
// SIGSEGV'd once a member was `text`, `any`/`all` answered `null`, and `--native` refused
// to compile any of it (`expected (i64, i64), found DbRef`).
//
// ONE cause behind all of it.  `for_type`'s P189b block types a tuple loop variable as
// `Reference(__tuple<…>)`, because iteration yields a DbRef pointing at the element's
// inline bytes in the vector record.  That is RIGHT for a `for` BODY, where `t.0` reads
// through the reference at the stored field offsets.  A callback is a CALL, and a
// `fn(t: (…))` parameter is by VALUE everywhere else in the language — so the callee was
// handed twelve bytes of DbRef and read them as the tuple's own members.
//
// The four spellings that ALWAYS worked are what located it, and they are cells here so
// the fix cannot be mistaken for a change in their meaning: a `for` body, a
// comprehension, an index, and a direct call taking the same by-value tuple parameter.
//
// A STRUCT element is the control that explains the shape.  It was never broken, because
// a struct IS a DbRef — the two representations coincide there, and the tuple is the one
// element type where they do not.  `vector<text>`, `vector<fn(…)>` and `vector<integer?>`
// were measured clean too and are kept below, so a repair that over-reaches gets caught.
//
// All four combinators decide with ONE helper, `callback_element_arg`, which answers the
// value AND the type together so they cannot drift apart.  Three copies of a tuple
// element list disagreeing is what loft#1006 was, in this same area.
//
// ⚠ Falsifying this file needs TWO runs, and the reason is worth knowing before you
// conclude a half of it is vacuous.  On a pre-fix tree the `reduce` cells fail at PARSE
// time ("No matching operator '+' on '(integer, integer)' and 'integer'"), which halts the
// whole file before the map/filter/any cells ever run — so a single run shows only the
// reduce half failing and says nothing about the rest.  Strip the two reduce cells and run
// again to see the others: `map` then fails `assertion failed: first member: got
// 343597383710` on `--interpret` and E0308 on `--native`.  Both halves were proven that
// way against a pristine tree at 554b1111.
//
// `reduce` needed a second, separate fix.  Its `("reduce", 2)` hint typed BOTH lambda
// parameters as the element, on the reasoning that sum/max/min/count keep accumulator and
// element in one numeric domain.  True — and it makes `U != T` unusable: with an
// `integer` init over a tuple vector, `acc` was typed as the TUPLE and `acc + t.0` was
// refused outright.  The declared signature is `fn(U, T) -> U`, so the accumulator now
// takes the INIT's type.  `test_reduce_with_a_heterogeneous_accumulator` is that cell.

struct S1074 { n: integer, tag: text }

fn dbl1074(x: integer) -> integer { x * 2 }
fn inc1074(x: integer) -> integer { x + 1 }
fn takes1074(t: (integer, integer)) -> integer { t.0 * 10 }

fn test_map_over_an_all_integer_tuple() {
  xs: vector<(integer, integer)> = [(1, 7), (2, 8)];
  ys = xs.map(|t| { t.0 * 10 });
  assert(ys[0] == 10, "first member: got {ys[0]}");
  assert(ys[1] == 20, "second element: got {ys[1]}");
  // The OTHER member, because reading `.1` picked up a different wrong value than `.0`.
  zs = xs.map(|t| { t.1 * 10 });
  assert(zs[0] == 70, "the second member: got {zs[0]}");
  assert(zs[1] == 80, "the second member again: got {zs[1]}");
}

fn test_map_over_a_tuple_with_a_text_member() {
  xs: vector<(integer, text)> = [(1, "a"), (2, "b")];
  ys = xs.map(|t| { t.0 * 10 });
  assert(ys[0] == 10, "integer member beside a text: got {ys[0]}");
  assert(ys[1] == 20, "integer member beside a text: got {ys[1]}");
  // The source is unchanged — I-Comp, and the text members still read.
  assert(xs[0].1 == "a", "source text member: got {xs[0].1}");
  assert(xs[1].1 == "b", "source text member: got {xs[1].1}");
}

fn test_map_over_an_all_text_tuple() {
  // This shape SIGSEGV'd: the DbRef's bytes were dereferenced as a text descriptor.
  xs: vector<(text, text)> = [("a", "x"), ("b", "y")];
  ys = xs.map(|t| { t.0 + "!" });
  assert(ys[0] == "a!", "text member: got {ys[0]}");
  assert(ys[1] == "b!", "text member: got {ys[1]}");
}

fn test_map_with_an_annotated_lambda_parameter() {
  // Not an inference problem: an explicitly annotated parameter failed identically.
  xs: vector<(integer, text)> = [(1, "a"), (2, "b")];
  ys = xs.map(fn(t: (integer, text)) -> integer { t.0 * 10 });
  assert(ys[0] == 10, "annotated parameter: got {ys[0]}");
  assert(ys[1] == 20, "annotated parameter: got {ys[1]}");
}

fn test_filter_over_tuple_elements() {
  xs: vector<(integer, text)> = [(1, "a"), (2, "b"), (3, "c")];
  ys = xs.filter(|t| { t.0 >= 2 });
  assert(len(ys) == 2, "kept count: got {len(ys)}");
  // The VALUES, not just the count: the predicate and the COLLECTED element are two
  // separate reads of the element and each needed the unboxing.  A length-only assert
  // would pass with the collected elements still wrong.
  assert(ys[0].0 == 2, "kept element member: got {ys[0].0}");
  assert(ys[0].1 == "b", "kept element text: got {ys[0].1}");
  assert(ys[1].0 == 3, "kept element member: got {ys[1].0}");
  assert(ys[1].1 == "c", "kept element text: got {ys[1].1}");
}

fn test_any_and_all_over_tuple_elements() {
  xs: vector<(integer, text)> = [(1, "a"), (2, "b")];
  // Both polarities: answering a constant would satisfy only one of each pair.
  assert(any(xs, |t| { t.0 == 2 }), "any, present");
  assert(!any(xs, |t| { t.0 == 9 }), "any, absent");
  assert(all(xs, |t| { t.0 > 0 }), "all, holds");
  assert(!all(xs, |t| { t.0 > 1 }), "all, does not hold");
}

fn test_reduce_over_tuple_elements() {
  xs: vector<(integer, integer)> = [(1, 7), (2, 8)];
  assert(xs.reduce(0, |a, t| { a + t.0 }) == 3, "fold over the first member");
  assert(xs.reduce(0, |a, t| { a + t.1 }) == 15, "fold over the second member");
}

fn test_reduce_with_a_heterogeneous_accumulator() {
  // `U != T`: an integer and a text accumulator over a tuple element.  The old hint typed
  // the accumulator as the ELEMENT, so both of these were refused before they could run.
  xs: vector<(integer, text)> = [(1, "a"), (2, "b")];
  assert(xs.reduce(0, |a, t| { a + t.0 }) == 3, "integer accumulator over a tuple element");
  assert(xs.reduce("", |a, t| { a + t.1 }) == "ab", "text accumulator over a tuple element");
}

fn test_the_four_spellings_that_always_worked() {
  // Controls.  These located the defect by working while the combinators did not, so a
  // repair that changed THEM would be the wrong repair.
  xs: vector<(integer, integer)> = [(1, 7), (2, 8)];
  s = 0;
  for t in xs { s += t.0; }
  assert(s == 3, "a for body: got {s}");
  ys = [for t in xs { t.0 * 10 }];
  assert(ys[0] == 10 && ys[1] == 20, "a comprehension: got {ys[0]} {ys[1]}");
  n = 0;
  for i in 0..len(xs) { n += xs[i].0; }
  assert(n == 3, "an index: got {n}");
  assert(takes1074(xs[0]) == 10, "a direct call: got {takes1074(xs[0])}");
}

fn test_other_element_types_are_unchanged() {
  // Controls for over-reach: every one of these was measured CLEAN before the fix.
  ts: vector<text> = ["a", "bb", "ccc"];
  m = ts.map(|s| { s + "!" });
  assert(m[0] == "a!" && m[2] == "ccc!", "text elements: got {m[0]} {m[2]}");
  assert(ts.reduce("z", |a, s| { a + s }) == "zabbccc", "text fold keeps its direction");
  ss: vector<S1074> = [S1074 { n: 1, tag: "a" }, S1074 { n: 2, tag: "b" }];
  sm = ss.map(|p| { p.n * 10 });
  assert(sm[0] == 10 && sm[1] == 20, "struct elements: got {sm[0]} {sm[1]}");
  fs: vector<fn(integer) -> integer> = [dbl1074, inc1074];
  fm = fs.map(|f| { f(3) });
  assert(fm[0] == 6 && fm[1] == 4, "fn-ref elements: got {fm[0]} {fm[1]}");
  ns: vector<integer?> = [1, null, 3];
  nm = ns.map(|v| { (v ?? 0) + 100 });
  assert(nm[0] == 101 && nm[1] == 100 && nm[2] == 103, "nullable elements");
}

fn main() {
  test_map_over_an_all_integer_tuple();
  test_map_over_a_tuple_with_a_text_member();
  test_map_over_an_all_text_tuple();
  test_map_with_an_annotated_lambda_parameter();
  test_filter_over_tuple_elements();
  test_any_and_all_over_tuple_elements();
  test_reduce_over_tuple_elements();
  test_reduce_with_a_heterogeneous_accumulator();
  test_the_four_spellings_that_always_worked();
  test_other_element_types_are_unchanged();
}
