//
// Store-lifetime coverage for loop-local hidden-buffer vectors.
//
// The CORRUPTING shape — a heap local assigned CONDITIONALLY inside a NESTED
// loop whose result is UNUSED — is tracked in loft-lang/loft#405 (it frees an
// uninitialised stack-NRVO dep slot).  It is NOT included here: it crashes until
// #405 is fixed.  These are the adjacent SOUND shapes a fix must keep passing —
// the coverage gap that let #405 ship on a fully-green suite.

fn enc(n: integer) -> vector<u8> { b: vector<u8> = []; b += [(n & 255) as u8]; return b; }

fn main() {
  // reused buffer (allocated ONCE outside the loop, grown inside) — must NOT be
  // confined/freed per iteration
  {
    acc: vector<u8> = [];
    for i in 0..4 { acc += [(i & 255) as u8]; }
    assert(len(acc) == 4, "reused buffer grows across iterations");
    assert(acc[3] == 3, "reused buffer last element");
  }
  // loop-local aliased by a variable that OUTLIVES the loop — must not free early
  {
    out: vector<u8> = [9 as u8];
    for i in 0..3 { tmp: vector<u8> = []; tmp += [(i & 255) as u8]; out = tmp; }
    assert(out[0] == 2, "alias to last loop-local survives the loop");
  }
  // fresh buffer ESCAPES via return — must not free at block exit
  {
    v = enc(7);
    assert(len(v) == 1, "returned buffer length");
    assert(v[0] == 7, "returned buffer value");
  }
  // UNconditional fresh buffer in a nested loop, result USED
  {
    s = 0;
    for t in 0..3 { for i in 0..3 { ki = enc(i); x = ki; s = s + len(x); } }
    assert(s == 9, "unconditional nested, used");
  }
  // UNconditional fresh buffer in a nested loop, result UNUSED
  {
    c = 0;
    for t in 0..3 { for i in 0..3 { ki = enc(i); x = ki; c = c + 1; } }
    assert(c == 9, "unconditional nested, unused");
  }
  println("390: loop-local buffer-lifetime coverage ok");
}
