//
// loft#733 — a `text?` interface method reached through a bounded generic.
//
// It returned EMPTY on `--interpret` (exit 0, no diagnostic) and did not compile
// on `--native`: a silent wrong answer on one backend and a hard failure on the
// other, which is the worst pair a divergence can be.
//
// Two causes, and the first one hid the second:
//
// 1. the parametric stub was not given the hidden `__work_1` text buffer,
//    because the I9-text arm matched `Type::Text(_)` without peeling `Optional`
//    — so the stub carried one attribute fewer than the impl substituted in;
// 2. `do_if_acc` promotes each branch arm into an accumulator but never
//    INTRODUCED it at the enclosing scope. Non-generic code hid that: there,
//    `text_return` promotes the accumulator to the hidden `&text` PARAMETER, so
//    there is no local to misplace. A generic MONOMORPH re-runs promotion, binds
//    its own `__tret` and promotes that instead — leaving the accumulator
//    declared inside the `ncc` block and read after it.
//
// The shapes below are the ones that separated the two: a `text?` method with
// and without arguments (arity was never involved), a plain `text` method whose
// impl builds a promoted buffer (worked throughout — proves the fix did not just
// disable the promotion), and a non-generic `??` (worked throughout).

interface I733Named {
  fn i733_maybe(self: Self) -> text?
  fn i733_maybe_at(self: Self, i: integer) -> text?
  fn i733_built(self: Self) -> text
}

struct I733Rec { tag: text }

fn i733_maybe(self: I733Rec) -> text? { return self.tag; }
fn i733_maybe_at(self: I733Rec, i: integer) -> text? {
  if i < 0 { return null }
  return self.tag;
}
// A promoted local work buffer behind a plain `text` return.
fn i733_built(self: I733Rec) -> text { t = "a"; t += self.tag; return t; }

// The failing shapes: a `??` discharge on a generic call's `text?` result.
fn i733_coalesce <T: I733Named> (t: T) -> text { return t.i733_maybe() ?? "-"; }
fn i733_coalesce_at <T: I733Named> (t: T, i: integer) -> text { return t.i733_maybe_at(i) ?? "-"; }
// The shape that always worked, kept so the fix cannot regress it.
fn i733_plain <T: I733Named> (t: T) -> text { return t.i733_built(); }

// Non-generic, for the same reason.
fn i733_direct(r: I733Rec) -> text { return r.i733_maybe() ?? "-"; }

fn main() {
  r = I733Rec { tag: "zz" };
  assert(i733_coalesce(r) == "zz", "733: text? through a generic yields its value");
  assert(i733_coalesce_at(r, 0) == "zz", "733: same with an argument");
  assert(i733_coalesce_at(r, -1) == "-", "733: and the null arm still discharges");
  assert(i733_plain(r) == "azz", "733: a built text return still works");
  assert(i733_direct(r) == "zz", "733: the non-generic path is unchanged");
}
