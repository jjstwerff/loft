//
// A fn-ref written into a place that is ALREADY LIVE arrives as the whole pair.
//
// A fn-ref slot is the PAIR — an 8-byte d_nr plus a 12-byte closure DbRef — while a
// NON-CAPTURING source (a bare `inc`, or a lambda that captures nothing) lowers to the
// d_nr alone.  Every destination has to top that up with the null-closure sentinel, and
// loft#1069 fixed the tuple LITERAL after finding the same eight-versus-twenty mismatch
// there.  What that left behind was the axis its corpus never varied: every cell wrote
// into a place being INITIALISED.
//
// Assigning to a place that already holds a fn-ref took the other path, and the mismatch
// was still there.  `g = inc` on a live `g` popped twenty bytes where eight were pushed,
// running twelve into whatever sat beneath — so `--interpret` panicked
// `fn_call_ref: fn_var=16 < 20` while `--native` ran the same program correctly.  A
// backend split, not a shared refusal, which is why no single-backend run could see it.
//
// `t.0 = inc` was worse on the other side: `--interpret` took the same panic, and
// `--native` emitted `var_t.0 = 711_i64;` against a `(u32, DbRef)` slot and handed the
// user a raw rustc E0308 for a program that is perfectly good loft.
//
// The source SPELLING is what decides it, and that is what makes the cells below the ones
// worth keeping: a CAPTURING lambda already pushes the pair (its closure block's type IS
// the function), and so does a source that is another fn-typed variable.  Those two
// worked before the fix and must keep working — they are the controls that catch a repair
// which double-wraps instead of topping up.
//
// The fix is the same decision in all three places, made where the destination is known:
// the interpreter routes a `Function` destination's push through `gen_fn_ref_value`
// (`set_var`, and the new `IrNode` sibling for `TuplePut`), and the native emitter opens
// `fn_ref_context` for a `Function` tuple element — the same channel its `Set` arm already
// used, which is what makes the if-VALUED source come out right, since the pair is then
// built inside EACH BRANCH rather than wrapped around the whole `if`.
//
// The native run also needed the reachability walk taught about `TuplePut`: a function
// reachable ONLY through a member assignment was pruned and left with no arm in the fn-ref
// dispatch, so the call panicked `invalid fn-ref: 711`.  That is the third symptom
// loft#1069 hit through the tuple literal, reached here through the assignment.

fn rea_dbl(x: integer) -> integer { x * 2 }
fn rea_inc(x: integer) -> integer { x + 1 }

fn test_a_live_local_reassigned_from_a_bare_name() {
  g: fn(integer) -> integer = rea_dbl;
  assert(g(3) == 6, "the first value: got {g(3)}");
  g = rea_inc;
  assert(g(3) == 4, "after reassignment from a bare name: got {g(3)}");
}

fn test_a_live_local_reassigned_from_a_long_form_lambda() {
  g: fn(integer) -> integer = rea_dbl;
  assert(g(3) == 6, "the first value: got {g(3)}");
  g = fn(x: integer) -> integer { x + 1 };
  assert(g(3) == 4, "after reassignment from a long-form lambda: got {g(3)}");
}

fn test_a_live_local_reassigned_from_a_capturing_lambda() {
  // Control: a capturing source ALREADY pushed the pair, so this cell passed before the
  // fix and must keep passing — a repair that wraps unconditionally would double-wrap it.
  k = 1;
  g: fn(integer) -> integer = rea_dbl;
  assert(g(3) == 6, "the first value: got {g(3)}");
  g = fn(x: integer) -> integer { x + k };
  assert(g(3) == 4, "after reassignment from a capturing lambda: got {g(3)}");
  assert(g(5) == 6, "the capture survives a second call: got {g(5)}");
}

fn test_a_live_local_reassigned_from_another_fn_local() {
  // Control: the source is already a full pair, so nothing needs topping up.
  h: fn(integer) -> integer = rea_inc;
  g: fn(integer) -> integer = rea_dbl;
  assert(g(3) == 6, "the first value: got {g(3)}");
  g = h;
  assert(g(3) == 4, "after reassignment from another fn local: got {g(3)}");
}

fn test_a_live_local_reassigned_from_an_if() {
  // The branch-valued source: the pair has to be built INSIDE each arm, so both reach the
  // join with the same stack delta.
  c = true;
  g: fn(integer) -> integer = rea_inc;
  assert(g(3) == 4, "the first value: got {g(3)}");
  g = if c { rea_dbl } else { rea_inc };
  assert(g(3) == 6, "after reassignment from an if: got {g(3)}");
}

fn test_a_tuple_member_reassigned_from_a_bare_name() {
  t: (fn(integer) -> integer, integer) = (rea_dbl, 1);
  assert(t.0(3) == 6, "the first value: got {t.0(3)}");
  t.0 = rea_inc;
  assert(t.0(3) == 4, "after member reassignment: got {t.0(3)}");
  // The member BESIDE it is the reading that named loft#1069's blast radius: an
  // under-pushed fn member moves every later member's offset and the tuple's own base.
  assert(t.1 == 1, "the integer member beside it: got {t.1}");
}

fn test_a_tuple_member_reassigned_from_an_if() {
  c = true;
  t: (fn(integer) -> integer, integer) = (rea_inc, 9);
  assert(t.0(3) == 4, "the first value: got {t.0(3)}");
  t.0 = if c { rea_dbl } else { rea_inc };
  assert(t.0(3) == 6, "after member reassignment from an if: got {t.0(3)}");
  assert(t.1 == 9, "the integer member beside it: got {t.1}");
}

fn test_a_tuple_member_reassigned_from_a_capturing_lambda() {
  // Control, the tuple half: this spelling already emitted the pair.
  k = 1;
  t: (fn(integer) -> integer, integer) = (rea_dbl, 9);
  assert(t.0(3) == 6, "the first value: got {t.0(3)}");
  t.0 = fn(x: integer) -> integer { x + k };
  assert(t.0(3) == 4, "after member reassignment from a capturing lambda: got {t.0(3)}");
  assert(t.1 == 9, "the integer member beside it: got {t.1}");
}

fn test_a_reassigned_member_is_reachable_for_the_native_dispatch() {
  // `rea_only_here` is named NOWHERE else — its one mention is the member assignment
  // below.  Before the reachability walk learned `TuplePut`, it was pruned and the call
  // panicked `invalid fn-ref` on `--native` while `--interpret` ran it.
  t: (fn(integer) -> integer, integer) = (rea_dbl, 3);
  t.0 = rea_only_here;
  assert(t.0(3) == 33, "a fn reachable only through a member assignment: got {t.0(3)}");
  assert(t.1 == 3, "the integer member beside it: got {t.1}");
}

fn rea_only_here(x: integer) -> integer { x + 30 }

fn test_a_plain_tuple_member_assignment_is_unchanged() {
  // Control: the fix keys on a `Function` element, so a tuple without one must take
  // exactly the path it always did.
  t: (integer, text) = (5, "a");
  t.0 = 7;
  assert(t.0 == 7, "plain integer member: got {t.0}");
  assert(t.1 == "a", "plain text member: got {t.1}");
}

fn main() {
  test_a_live_local_reassigned_from_a_bare_name();
  test_a_live_local_reassigned_from_a_long_form_lambda();
  test_a_live_local_reassigned_from_a_capturing_lambda();
  test_a_live_local_reassigned_from_another_fn_local();
  test_a_live_local_reassigned_from_an_if();
  test_a_tuple_member_reassigned_from_a_bare_name();
  test_a_tuple_member_reassigned_from_an_if();
  test_a_tuple_member_reassigned_from_a_capturing_lambda();
  test_a_reassigned_member_is_reachable_for_the_native_dispatch();
  test_a_plain_tuple_member_assignment_is_unchanged();
}
