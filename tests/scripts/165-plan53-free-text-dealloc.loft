// 165 — @PLAN53 cluster 5: regression guard for the free_text buffer leak.
//
// Bug (fixed in commit e0e094f7): `free_text` did `string_mut(pos).shrink_to(0)`
// to release a String's heap buffer, but the preceding `clear()` ran ONLY
// under `debug_assertions`.  In release builds — and under Miri, where the
// crate disables debug-assertions — a non-empty String reached `shrink_to(0)`,
// which only shrinks capacity down to `len` (never below), so the backing
// buffer survived and LEAKED.  The store holds the String as raw bytes and
// never runs its Drop; `free_text` is the sole deallocation point.  Miri's
// leak checker caught it during p213 teardown.
//
// Fix: run `clear()` unconditionally before `shrink_to(0)` — `len=0` lets
// `shrink_to(0)` drop capacity to 0 and free the buffer.
//
// Trigger: assign a non-empty text variable, then reassign it or let it go
// out of scope.  Each reassignment (or scope exit) calls `free_text` on the
// old String.  On the pre-fix code Miri's LeakSanitizer flags a retained
// 20-byte (or more) allocation; on the fixed code the buffer is freed.
//
// The assert-based verification here checks CORRECTNESS only (that the
// new value is correct after the old one is freed).  The leak-freedom
// guarantee comes from the Miri leak-check invocation in the CI gate.

fn greet(name: text) -> text {
  "Hello, {name}!"
}

fn main() {
  // Basic reassignment: first value ("world") is freed by free_text before
  // the slot is overwritten.
  msg = "world";
  msg = "loft";
  assert(msg == "loft", "after reassign: got {msg}");

  // Repeated reassignment in a loop: exercises free_text on each iteration.
  acc = "";
  for i in 0..5 {
    old = acc; // old is freed at end of iteration
    acc = "{acc}{i}";
  }
  assert(acc == "01234", "loop acc: got {acc}");

  // Return-value text: greet() creates a String; the caller frees it.
  g = greet("world");
  assert(g == "Hello, world!", "greet: got {g}");

  // Empty string — shrink_to(0) on an already-empty String should be a no-op
  // (len=0 means shrink_to(0) is identity even without the clear() fix).
  // Included to guard against a regression that accidentally breaks the
  // empty case.
  e = "";
  e = "non-empty now";
  assert(e == "non-empty now", "empty->nonempty: got {e}");

  // Multiple text vars going out of a nested block — exercises free emission
  // at block exit for all live text variables.
  total = 0;
  for j in 1..4 {
    inner = "item {j}";
    total += len(inner);
  }
  // "item 1"=6, "item 2"=6, "item 3"=6 -> 18
  assert(total == 18, "block-exit free: total={total}, want 18");

  println("165-plan53-free-text-dealloc PASSED");
}
