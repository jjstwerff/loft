//
// A TUPLE-ELEMENT argument must be nameable by the call site, so a call whose return may
// BORROW it can decide borrow-vs-owned instead of falling back to a copy (loft#1104).
//
// The @P290 bracket decides that split at runtime, and it protects a store by naming it
// through a variable whose VALUE is a `DbRef`. `view_root_slots` walks a projection chain to
// that variable, recognising a projection with `is_projection_op` — which is keyed on
// `OpGetField` and `OpGetVector`. A tuple element is a projection too and is NEITHER: it is
// `Value::TupleGet`, not a `Call`. So the witness set read incomplete, the caller kept the
// conservative never-free answer, copied the returned store and orphaned the one the callee
// minted — one record per call, on both backends, with the VALUES correct throughout.
//
// Two cures do not work and the third is what this file pins. Widening the op list cannot
// reach a shape that is not a `Call` at all. Naming the TUPLE cannot work either: the bracket
// protects the store a `DbRef` variable points at, and a tuple is not a `DbRef` — its element
// carries the store, and (today) aliases whatever it was given. So the argument is BOUND to a
// temp, which is exactly the hand-written spelling that was always clean (`e = t.0;
// pick(e, …)`) and emits the same code. The temp takes the tuple ELEMENT's own type, deps and
// all, so it reads as the borrow it is and nothing frees it here.
//
// ⚠ THE ASSERTIONS BELOW DO NOT SCORE THIS FIX — the wrap harness's LEAK GATE does. Every
// value was already correct before it; only the store accounting moved. Measured on a control
// binary built at `9c1a0e4e`, the two record-element cells run 25 rounds each and report
// `not freed at program exit: kt=78 S1104×50` while answering exactly the same numbers. Note
// that `loft --tests <file>` will NOT show that, even with `LOFT_STRICT_STORES=1`: the guard
// is scored by `tests/wrap.rs::run_test`, so falsifying it means `cargo test --test wrap`.

struct S1104 { a: integer = 3 }
struct B1104 { s: S1104 }

fn mk1104() -> S1104 { S1104 { a: -1 } }

// `returns_borrowed_view`: the return names a visible parameter on one path and mints its own
// store on the other. That is the split the bracket exists to decide, and the only shape where
// an unnameable argument costs anything.
fn pick1104(s: S1104, c: boolean) -> S1104 { if c { s } else { mk1104() } }
fn pickv1104(v: vector<integer>, c: boolean) -> vector<integer> { if c { v } else { [9, 9] } }

// A callee that does NOT return a borrowed view — it answers a scalar, so there is no store to
// decide about and the argument is left exactly as it was.
fn reads1104(s: S1104, c: boolean) -> integer { if c { s.a } else { 0 } }

fn from_tuple(c: boolean) -> integer { s = S1104 { a: 7 }; t = (s, 9); r = pick1104(t.0, c); r.a }
fn from_tuple_second(c: boolean) -> integer { s = S1104 { a: 7 }; t = (9, s); r = pick1104(t.1, c); r.a }
fn from_tuple_vector(c: boolean) -> integer {
  v: vector<integer> = [7, 7];
  t = (v, 9);
  r = pickv1104(t.0, c);
  len(r)
}

// The reported shape. Both arms are exercised, because the leak is the arm where the callee
// MINTS its own store: the caller copied that store and orphaned it.
fn test_a_tuple_element_argument_leaks_nothing() {
  t = 0;
  for i in 0..25 { t = t + from_tuple(true) + from_tuple(false); }
  assert(t == 150, "25 rounds of 7 + -1, got {t}");
}

// The element's POSITION in the tuple is not the axis — a projection is a projection. This cell
// is what says the fix reads the tuple's element type rather than assuming index 0.
fn test_the_second_tuple_element_leaks_nothing() {
  t = 0;
  for i in 0..25 { t = t + from_tuple_second(true) + from_tuple_second(false); }
  assert(t == 150, "25 rounds of 7 + -1, got {t}");
}

// A COLLECTION element, not a record: the same bracket serves both, so both must be nameable.
fn test_a_tuple_vector_element_leaks_nothing() {
  t = 0;
  for i in 0..25 { t = t + from_tuple_vector(true) + from_tuple_vector(false); }
  assert(t == 100, "25 rounds of two 2-element vectors, got {t}");
}

// ---- controls: the spellings that were already clean and must stay so ----

// A bare local, a struct FIELD and a vector ELEMENT are the three spellings `view_root_slots`
// already walked. They are what says this fix is about the SPELLING a projection takes, not
// about borrowed-view calls.
fn from_var(c: boolean) -> integer { q = S1104 { a: 7 }; r = pick1104(q, c); r.a }
fn from_field(c: boolean) -> integer { b = B1104 { s: S1104 { a: 7 } }; r = pick1104(b.s, c); r.a }
fn from_elem(c: boolean) -> integer { v: vector<S1104> = [S1104 { a: 7 }]; r = pick1104(v[0], c); r.a }

fn test_the_already_nameable_spellings_are_untouched() {
  a = 0;
  for i in 0..25 { a = a + from_var(true) + from_var(false); }
  assert(a == 150, "bare local, got {a}");

  b = 0;
  for i in 0..25 { b = b + from_field(true) + from_field(false); }
  assert(b == 150, "struct field, got {b}");

  c = 0;
  for i in 0..25 { c = c + from_elem(true) + from_elem(false); }
  assert(c == 150, "vector element, got {c}");
}

// The hand-written spelling the fix makes the inline one emit. It was always clean, and it is
// the target the cure is measured against.
fn from_bound(c: boolean) -> integer {
  s = S1104 { a: 7 };
  t = (s, 9);
  e = t.0;
  r = pick1104(e, c);
  r.a
}

fn test_the_hand_written_binding_still_works() {
  t = 0;
  for i in 0..25 { t = t + from_bound(true) + from_bound(false); }
  assert(t == 150, "25 rounds of 7 + -1, got {t}");
}

// A SCALAR tuple element carries no store, so there is no witness to complete and nothing to
// bind. It is the cell that fails if the hoist is applied to every tuple element.
fn from_scalar(c: boolean) -> integer { s = S1104 { a: 7 }; t = (s, 9); x = t.1; if c { x } else { 0 } }

fn test_a_scalar_tuple_element_is_untouched() {
  t = 0;
  for i in 0..25 { t = t + from_scalar(true) + from_scalar(false); }
  assert(t == 225, "25 rounds of 9 + 0, got {t}");
}

// A callee whose return does NOT borrow needs no bracket, so its argument is left alone —
// binding it would reorder an argument for nothing.
fn from_nonview(c: boolean) -> integer { s = S1104 { a: 7 }; t = (s, 9); reads1104(t.0, c) }

fn test_a_non_borrowing_callee_is_untouched() {
  t = 0;
  for i in 0..25 { t = t + from_nonview(true) + from_nonview(false); }
  assert(t == 175, "25 rounds of 7 + 0, got {t}");
}
