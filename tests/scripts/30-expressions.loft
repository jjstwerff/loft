// Expression evaluation: arithmetic, function calls, control flow, recursion.

// @EXPECT_WARNING: Division by constant zero
fn test_div_by_const_zero() {
  r = 2 / 0 ?? null;
}

// @EXPECT_WARNING: Modulo by constant zero
fn test_rem_by_const_zero() {
  r = 5 % 0 ?? null;
}

fn append_ch(ch: character) -> text {
  "abc_de" + ch
}

fn test_append_fn() {
  // Uses text + character (workaround for #90: text first)
  assert(append_ch('x') == "abc_dex", "append fn");
}

fn append_str(ch: character) -> text {
  s = "abc_de";
  s += ch;
  s
}

fn test_append_str() {
  assert(append_str('x') == "abc_dex", "append str");
}

fn routine() -> integer {
  b = 0;
  for a in 0..10 {
    if a == 2 { continue }
    if a > 5 { return b }
    b += a;
  }
  b
}

fn test_continue_loop() {
  assert(routine() == 13, "continue loop");
}

// @EXPECT_WARNING: Parameter a is never read
fn void_routine(a: integer) {
  return;
}

// @FTR-025 — the labelled loop forms: which loop `i#break` and `i#continue` name
//
// A bare `break` / `continue` acts on the nearest enclosing loop; the `#` forms name an
// OUTER one by its loop variable, which is why the expected string below is triangular.
// `i#continue` abandons the rest of the inner loop AND the rest of the outer body, so
// each row stops at j == i; `i#break` leaves both loops at once.
//
// Labelling names a loop VARIABLE, so a `while` — which has none — cannot be named.
// It can still be escaped: see the companion below.
fn test_inner_loop() {
  s = "";
  for i in 0..10 {
    for j in 0..10 {
      if j > i { i#continue }
      s += "{i}{j},";
      if len(s) > 100 { i#break }
    }
  }
  assert(
    s == "00,10,11,20,21,22,30,31,32,33,40,41,42,43,44,50,51,52,53,54,55,60,61,62,63,64,65,66,70,71,72,73,74,75,",
    "inner loop"
  );
}

fn test_labelled_break_leaves_a_while() {
  // A `while` cannot be NAMED by a labelled form (it has no loop variable), but a
  // labelled break crosses one on its way out of the `for` that encloses it.
  found = "";
  for i in 1..=3 {
    k = 0;
    while k < 3 {
      k += 1;
      if i * k == 4 { found = "{i}x{k}"; i#break }
    }
  }
  assert(found == "2x2", "labelled break leaves the for from inside a while: {found}");

  // And a plain break / continue inside a `while` acts on that while.
  j = 0; t = 0;
  while j < 10 { j += 1; if j == 3 { continue }; if j == 6 { break }; t += j }
  assert(t == 12, "continue skipped 3 and break stopped at 6: {t}");
  assert(j == 6, "the while's own variable stops where break left it: {j}");
}

enum ExState {
  ExStart,
  ExOngoing,
  ExHalt,
}

fn first(s: ExState, c: integer) -> integer {
  if s == ExStart { s = ExOngoing; } else if c > 10 { s = ExHalt; }
  second(s, c)
}

fn second(s: ExState, c: integer) -> integer {
  if s != ExHalt { first(s, c + 1) } else { 1 + c }
}

fn test_recursion() {
  assert(first(ExStart, 0) == 12, "recursion");
}
