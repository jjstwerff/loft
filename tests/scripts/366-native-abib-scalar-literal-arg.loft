// Native ABI-B deep-copy call path must coerce scalar literal arguments the
// same way the normal call path does.  Issue #366: a callee with a Reference
// (struct) parameter that ALSO returns a struct goes through the ABI-B path
// (the caller pre-allocates a result buffer and `OpCopyRecord`s into it).  Its
// argument emission used to be re-derived locally, dropping the boolean->u8
// coercion — so a `true`/`false` literal emitted Rust `true`/`false` against a
// `u8` parameter and tripped rustc E0308.  Argument emission is now shared with
// the normal path (`emit_call_arg`), so boolean / character / enum literals all
// reach an ABI-B callee correctly.  The interpreter was always correct; this
// guards the native backend (and the interp/native parity).
enum Color {
  Red,
  Green,
  Blue,
}
struct S { x: integer }
struct Box {
  y: integer,
  hit: boolean,
}

fn with_bool(s: S, c: boolean) -> Box {
  Box { y: s.x, hit: c }
}
fn with_char(s: S, c: character) -> Box {
  Box { y: s.x, hit: c == 'Z' }
}
fn with_enum(s: S, c: Color) -> Box {
  Box { y: s.x, hit: c == Color.Green }
}

pub fn main() {
  a = S { x: 7 };

  // boolean literal — the exact #366 reproducer (both polarities).
  bt = with_bool(a, true);
  assert(bt.y == 7, "bool-true literal arg: struct field copied");
  assert(bt.hit, "bool-true literal arg: value delivered");
  bf = with_bool(a, false);
  assert(!bf.hit, "bool-false literal arg: value delivered");

  // character literal — a sub-i64 param on the same path.
  bc = with_char(a, 'Z');
  assert(bc.y == 7, "char literal arg: struct field copied");
  assert(bc.hit, "char literal arg: value delivered");

  // enum literal — emits as `_u8`; must still match the `u8` param.
  be = with_enum(a, Color.Green);
  assert(be.y == 7, "enum literal arg: struct field copied");
  assert(be.hit, "enum literal arg: value delivered");
}
