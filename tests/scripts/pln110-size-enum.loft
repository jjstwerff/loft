//
// @PLN110 sub-arc (enums) — `size` on enum and enum-variant values.
//
//   * A SIMPLE enum (no data-carrying variant) is a 1-byte inline discriminant
//     (scalar-like): size = 1.
//   * A DATA enum, referred to by the ENUM type, occupies its record = a 1-byte
//     tag + the MAX variant's packed fields.  A `Shape` slot therefore reports
//     the same size for every variant (it must hold any of them).
//   * A BARE VARIANT value (`Circle { r: 2.0 }`) has the VARIANT's own type — a
//     struct-like record — so size reports that variant's own packed record,
//     which is ≤ the enum's max-variant record.
//
// Values verified against both backends (interpret + native) during Phase 1.

enum Direction {
  North,
  East,
  South,
  West,
}
enum Shape {
  Circle { r: float },
  Rect { w: float, h: float },
}

fn shape_size(s: Shape) -> integer {
  size(s)
}

fn main() {
  // simple enum: 1-byte inline discriminant
  d = Direction.North;
  assert(size(d) == 1, "simple enum = 1-byte discriminant: {size(d)}");

  // data enum via the ENUM type: the record = 1-byte tag + the MAX variant's
  // fields.  Rect (2 floats) dominates Circle (1 float), so a Shape slot is 24
  // regardless of which variant it currently holds.
  cs: Shape = Circle { r: 2.0 };
  rs: Shape = Rect { w: 3.0, h: 4.0 };
  assert(size(cs) == 24, "Shape-typed = max-variant record (24): {size(cs)}");
  assert(size(rs) == 24, "Shape-typed = max-variant record, any variant: {size(rs)}");
  assert(shape_size(Circle { r: 1.0 }) == 24, "via Shape param = 24");

  // bare variant value: its OWN record (tag + that variant's fields)
  bc = Circle { r: 2.0 };
  br = Rect { w: 3.0, h: 4.0 };
  assert(size(bc) == 16, "bare Circle = its own record (tag + 1 float): {size(bc)}");
  assert(size(br) == 24, "bare Rect = its own record (tag + 2 floats): {size(br)}");
  assert(size(bc) < size(cs), "bare Circle (16) < Shape slot (24): {size(bc)} < {size(cs)}");
}
