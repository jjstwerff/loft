//
// @PLN85 / #416 — regression guard: a vector match-return delivered as the
// IMPLICIT block tail (`{ match … }`, no `return`). Sibling of probe 05's explicit
// `return match`. Before the fix the implicit case typed as `Vector` (not `Never`),
// bypassed the materialize gate, and promoted ONE arm's `__vdb` as the return param
// while leaking the sibling arms' buffers on the interpreter (correct values, store
// leak). Fix: the materialize gate now also fires for `t = Vector` match/if tails
// (still branch-tail gated) AND skips a nullable return (a DIRECT `null` arm, e.g.
// `{ if b { […] } else { null } }`, which native cannot deliver into __retbuf).
// Guards: correct values + no leak, BOTH backends.

enum CV { CN, CI { value: integer } }

fn enc(c: CV) -> vector<u8> { match c { CN => [0 as u8], CI { value } => [(value & 255) as u8] } }

fn main() {
  a = enc(CI { value: 1 });
  b = enc(CI { value: 3 });
  assert((a[0] ?? 9) == 1, "a == 1");
  assert((b[0] ?? 9) == 3, "b == 3 (independent of a)");
}
