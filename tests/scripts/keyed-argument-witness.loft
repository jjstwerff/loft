//
// A callee whose return may BORROW an argument decides borrow-vs-owned at RUNTIME: the @P290
// bracket marks each argument's store and `OpCopyRecord`'s source-free is refused for a marked
// one, taken for a callee-minted one.  The gate that arms it asks whether the bracket covers
// EVERY argument that carries a store, and a KEYED COLLECTION was outside the emit's type list
// — so `fn take(h: hash<KS[k]>, n) -> KS { h[n] ?? mk() }` read as uncovered, the caller kept
// the conservative never-free answer, and the record `mk()` minted was orphaned.  One per call,
// both backends, unbounded in a loop.
//
// ⚠ This is loft#981's hole from the OTHER side, and the direction matters.  Back then the
// keyed argument was neither protected NOR counted, so the set read complete while protecting
// nothing and the free it licensed took a hash parameter's element out from under the caller
// (`tests/scripts/882-…` went red under poison with `rec=0xDEADBEEF`).  Making it INCOMPLETE was
// the right cure for the use-after-free and left the leak.  Protecting it is what closes both:
// `protect_store_frees` marks `allocations[r.store_nr]` and reaches it through the argument's
// own `DbRef`, which every keyed collection variable holds — the emit could always do this.
//
// So the BORROW cells here are not decoration.  A cure that widened the count without widening
// the bracket would pass every leak assert in this file and fail these: the container is read
// AFTER the call, by length and by value, on both keys.  Run under `LOFT_POISON=1` they are
// what tells a live record from freed bytes that still look right.

struct KSw { k: integer, a: integer, t: text = "" }

fn mkw() -> KSw { KSw { k: 0, a: -1, t: "fresh" } }

fn takeh(h: hash<KSw[k]>, n: integer) -> KSw { h[n] ?? mkw() }
fn takes(h: sorted<KSw[k]>, n: integer) -> KSw { h[n] ?? mkw() }
fn takei(h: index<KSw[k]>, n: integer) -> KSw { h[n] ?? mkw() }

fn test_a_hash_argument_is_a_witness_for_its_own_store() {
  v: hash<KSw[k]> = [];
  v += KSw { k: 1, a: 7, t: "one" };
  v += KSw { k: 2, a: 8, t: "two" };

  // The MISS arm mints a record the caller must end up owning.
  m = takeh(v, 99);
  assert(m.a == -1, "the miss arm answers the fresh record, got {m.a}");
  assert(m.t == "fresh", "with its own text, got {m.t}");

  // The HIT arm hands back a record living in `v`'s store — nothing may free it.
  b = takeh(v, 1);
  assert(b.a == 7, "the hit arm answers the element, got {b.a}");
  assert(b.t == "one", "with the element's text, got {b.t}");

  // And the container is read AFTER both calls: this is the half that fails if the count
  // is widened without the bracket.
  assert(len(v) == 2, "the hash still holds both entries, got {len(v)}");
  assert(v[1].a == 7, "entry one reads unchanged, got {v[1].a}");
  assert(v[2].t == "two", "entry two reads unchanged, got {v[2].t}");
}

fn test_a_sorted_argument() {
  v: sorted<KSw[k]> = [];
  v += KSw { k: 1, a: 7, t: "one" };
  m = takes(v, 99);
  assert(m.a == -1, "the miss arm answers fresh, got {m.a}");
  b = takes(v, 1);
  assert(b.a == 7, "the hit arm answers the element, got {b.a}");
  assert(len(v) == 1, "the sorted collection is intact, got {len(v)}");
  assert(v[1].t == "one", "and reads unchanged, got {v[1].t}");
}

fn test_an_index_argument() {
  v: index<KSw[k]> = [];
  v += KSw { k: 1, a: 7, t: "one" };
  m = takei(v, 99);
  assert(m.a == -1, "the miss arm answers fresh, got {m.a}");
  b = takei(v, 1);
  assert(b.a == 7, "the hit arm answers the element, got {b.a}");
  assert(len(v) == 1, "the index is intact, got {len(v)}");
  assert(v[1].t == "one", "and reads unchanged, got {v[1].t}");
}

fn test_it_does_not_scale_with_the_iteration_count() {
  // One orphaned record per call is what makes this matter.
  v: hash<KSw[k]> = [];
  v += KSw { k: 1, a: 7 };
  total = 0;
  for i in 0..32 {
    total += takeh(v, 1).a + takeh(v, i + 99).a;
  }
  assert(total == 192, "32 iterations of (7 + -1), got {total}");
  assert(len(v) == 1, "and the hash never grew or lost an entry, got {len(v)}");
  assert(v[1].a == 7, "its one entry reads unchanged, got {v[1].a}");
}
