// Expected-error tests extracted from mixed files so normal tests
// in those files can run.  Each error fn has @EXPECT_ERROR before it.

// ── Shared definitions needed by error fns ──────────────────────

enum Direction { North, East, South, West }

enum Shape {
  Circle { radius: float },
  Rect { width: float, height: float },
  Square { side: float }
}

fn vec_sum(r: vector<integer>) -> integer {
  total = 0;
  for vs_e in r { total += vs_e; }
  total
}

// ── L11 digit-separator placement errors ───────────────────────

// @EXPECT_ERROR: Misplaced '_' in number literal
fn test_digit_separator_doubled() {
  x = 1__0;
  assert(x == 10, "unreached");
}

// @EXPECT_ERROR: Misplaced '_' in number literal
fn test_digit_separator_trailing() {
  x = 1_ + 0;
  assert(x == 1, "unreached");
}

// @EXPECT_ERROR: Misplaced '_' in number literal
fn test_digit_separator_after_hex_prefix() {
  x = 0x_F;
  assert(x == 15, "unreached");
}

// ── Empty comprehension body (was a compiler panic — control.rs:624 underflow
//    + data.rs:4453 Unknown-definition; now a clean diagnostic) ──────────────

// @EXPECT_ERROR: comprehension body must produce a value
fn test_empty_comprehension_body() {
  v = [for i in 0..3 {}];
  assert(len(v) == 0, "unreached");
}

// ── From 06-structs.loft ────────────────────────────────────────

// @EXPECT_ERROR: vector concatenation in an expression creates a temporary
fn test_vector_argument() {
  assert(vec_sum([1,2,3,4,5]) + 100 * vec_sum([1,2,3] + [4,5]) == 1515, "vector argument");
}

// @EXPECT_ERROR: vector concatenation in an expression creates a temporary
// @P395 — a `.method()` on an inline vector-concat receiver must error (was a
// silent 8-byte stack drift: `len 4` read back as 8589934592, escalating to a
// `codegen.rs:2669` panic).  The concat had reused the outer LHS as its
// accumulator; bind it first instead: `w = v + [9]; w.len()`.
fn test_vector_concat_method_receiver() {
  v = [1, 2, 3];
  assert((v + [9]).len() == 4, "concat method receiver");
}

// @EXPECT_ERROR: cannot replace a `&` vector parameter
// A `&vector` ref grows the caller's vector in place; reassigning it to a concat
// (`out = a + x`) used to silently DROP the first operand `a` (appending only the
// trailing parts).  Now rejected — append with `out += …` instead.
fn ref_vector_replace(out: & vector < integer >, a: vector<integer>, x: vector<integer>) {
  out = a + x;
}

// ── From 10-match.loft ──────────────────────────────────────────

// @EXPECT_ERROR: match on Direction is not exhaustive
fn test_plain_missing_arm() {
  d = Direction.North;
  match d { North => "N", East => "E", South => "S" };
}

// @EXPECT_ERROR: match on Shape is not exhaustive
fn test_struct_missing_arm() {
  s = Circle { radius: 1.0 };
  match s { Circle { radius } => radius, Rect { width, height } => width * height };
}

// @EXPECT_ERROR: cannot unify: text and integer
fn test_match_type_mismatch() {
  d = Direction.North;
  match d { North => "text", _ => 42 };
}

// @EXPECT_ERROR: match on Direction is not exhaustive
fn test_match_duplicate_arm() {
  d = Direction.North;
  match d { North => "first", North => "second", _ => "other" };
}

// @EXPECT_ERROR: guard must be boolean, got integer
fn test_guard_non_bool() {
  s = Circle { radius: 3.0 };
  match s { Circle { radius } if 42 => radius, _ => 0.0 };
}

// ── From 38-parse-warnings.loft ─────────────────────────────────

// @EXPECT_ERROR: Format specifier has no effect on text
fn test_hex_on_text() {
  t = "hello";
  assert("{t:x}" == "hello", "text with hex");
}

// @EXPECT_ERROR: Zero-padding has no effect on text
fn test_zero_pad_on_text() {
  t = "hello";
  assert("{t:05}" == "hello", "text with zero-pad");
}

// ── From 70-struct-methods.loft ─────────────────────────────────

// @EXPECT_ERROR: vector concatenation in an expression creates a temporary
// @EXPECT_ERROR: vector concatenation in an expression creates a temporary
fn smb_vec_sum(r: vector<integer>) -> integer {
  total = 0;
  for smb_e in r {
    total += smb_e;
  }
  total
}

fn test_struct_method_vec() {
  assert(smb_vec_sum([1,2] + [3]) + 100 * smb_vec_sum([1,2,3] + [4,5]) == 1506, "struct method vec");
}

// ── From 90-immutability.loft ───────────────────────────────────

// @EXPECT_ERROR: Parameter 'a' has & but is never modified
fn ref_read_only(a: &integer) -> integer { a }

// @EXPECT_ERROR: Cannot modify const parameter 'a'
fn const_bad(a: const integer) { a = 42 }

// @EXPECT_ERROR: Cannot modify const parameter 'a'
fn const_ref_bad(a: & const integer) { a = 42 }

// @EXPECT_ERROR: Cannot modify const variable 'x'
fn test_const_local_int_reassigned() {
  const x = 5;
  x = 10;
}

// @EXPECT_ERROR: Cannot modify const variable 'x'
fn test_const_local_int_augmented() {
  const x = 5;
  x += 1;
}

// @EXPECT_ERROR: Cannot modify const variable 't'
fn test_const_local_text_reassigned() {
  const t = "hello";
  t = "world";
}

// @EXPECT_ERROR: Cannot modify const variable 'c'
fn test_const_local_ref_reassigned() {
  const c = Direction.North;
  c = South;
}

// ── @PLN40 const-model phase 1 step 3 — value-const (`: const T`) NEGATIVES ──
// A value-const binding is a read-only borrow: every mutation THROUGH it is rejected
// (append / element / field / nested), while a rebind that re-points the slot is
// allowed (see the positives in 90-immutability.loft).  Binding-const compound
// append (`const v: vector`, `const t: text` + `+=`) is legal and lives there too.

struct VcRec { x: integer }

// @EXPECT_ERROR: Cannot modify const parameter 'p'
fn vc_param_append(p: const vector<integer>) { p += [3] }

// @EXPECT_ERROR: Cannot modify const parameter 'p'
fn vc_param_element(p: const vector<integer>) { p[0] = 9 }

// @EXPECT_ERROR: Cannot modify const parameter 'p'
fn vc_param_field(p: const VcRec) { p.x = 9 }

// @EXPECT_ERROR: Cannot modify const parameter 'p'
fn vc_param_text_append(p: const text) { p += "z" }

// @EXPECT_ERROR: Cannot modify const variable 'x'
fn vc_local_append() {
  x: const vector<integer> = [1];
  x += [2];
}

// @EXPECT_ERROR: Cannot modify const variable 'x'
fn vc_local_element() {
  x: const vector<integer> = [1, 2];
  x[0] = 9;
}

// ── @PLAN48 P2 / @P370 — implicit integer→i32 narrowing is an error ──

// @EXPECT_ERROR: cannot implicitly narrow
fn test_integer_to_i32_assign() {
  n: integer = 5;
  x: i32 = n;   // narrowing (non-literal) — requires `as i32`
  assert(x == 5, "unreachable");
}

fn p370_takes_i32(x: i32) -> i32 { x }

// @EXPECT_ERROR: cannot implicitly narrow
fn test_integer_to_i32_arg() {
  n: integer = 5;
  assert(p370_takes_i32(n) == 5, "unreachable");   // narrowing arg — requires `as i32`
}

// ── @PLN22 Phase 1 — a bare variant defining an untyped variable is an error ──
enum PLN22Dir { PLN22North, PLN22South }

// @EXPECT_ERROR: bare variant 'PLN22North' has no type here
fn test_pln22_bare_variant_no_context() {
  d = PLN22North;   // no type context — must write `PLN22Dir.PLN22North`
  assert(d is PLN22North, "unreachable");
}

// ── @PLN22 Phase 2 — prelude shadowing allows `enum E` etc., but a built-in
// type-keyword (`integer`, `vector`, …) is NEVER shadowable: it stays a hard
// error so the language's own types can't be silently re-pointed. ──
// @EXPECT_ERROR: conflicts with a type
struct integer { pln22_field: i32 }

// A bodyless stdlib forward-decl (`type iterator;`) is `DefType::Type` with an
// Unknown returned type.  Before the adopt-branch `DefType::Unknown` guard,
// `struct iterator` was silently swallowed (adopted) instead of rejected.
// @EXPECT_ERROR: conflicts with a type
struct iterator { pln22_field: i32 }

// `enum`/`type` reusing a keyed-collection keyword used to PANIC in
// `complete_definition` (re-`set_returned` on an already-typed builtin) because
// the completion call ran on `self.first_pass` without the `!conflict` guard.
// (The keyed-collection keywords are lowercase, so the camel-case check also
// fires first — annotate both diagnostics.)
// @EXPECT_ERROR: Expect enum definitions to be in camel case style
// @EXPECT_ERROR: conflicts with a type
enum hash { Pln22A, Pln22B }

// @EXPECT_ERROR: Expect type definitions to be in camel case style
// @EXPECT_ERROR: conflicts with a type
type sorted = integer;

// @PLN25 DN3: integer `/` types `integer?` (the divisor may be zero → null at runtime), so an
// UNDEFENDED result stored into a non-null return is a violation — the developer must guard
// (`if b != 0`), discharge (`a / b ?? d`), or declare the return `integer?`. The accept twins
// live in 25-division-nullable.loft.
// @EXPECT_ERROR: nullable `integer?` cannot be stored
fn test_undefended_division_into_nonnull(a: integer, b: integer) -> integer {
  a / b
}

// @PLN25 index flip: `v[i]` types `τ?` (OOB → null) for a not-provably-fit index, so an
// UNDEFENDED element stored into a non-null return is a violation — the developer must guard
// (`if i < len(v)`), discharge (`v[i] ?? d`), or declare the return `integer?`. The accept twins
// (const / iter-var / guard / `??` / honest `τ?`) live in 25-index-nullable.loft.
// @EXPECT_ERROR: nullable `integer?` cannot be stored
fn test_undefended_index_into_nonnull(v: vector<integer>, i: integer) -> integer {
  v[i]
}

// @PLN25 (N-Store) tuples: a tuple stores ELEMENT-WISE, so an un-discharged `τ?` (or a
// bare `null`) element cannot slip into a non-null element slot of a tuple RETURN (the
// synthetic `__tuple<…>` rewrite) or a tuple FIELD. The accept twins (discharged /
// declared-`τ?`-element / nested) live in 25-tuple-nstore.loft.
// @EXPECT_ERROR: nullable `integer?` cannot be stored into element 0 of the return value
fn test_tuple_return_undischarged_elem(s: text) -> (integer, integer) {
  tr_q = s as integer;
  (tr_q, 1)
}

// @EXPECT_ERROR: `null` cannot be stored into element 0 of the return value
fn test_tuple_return_null_elem() -> (integer, integer) {
  (null, 2)
}

struct TupleFieldBox { t: (integer, integer) }

// @EXPECT_ERROR: nullable `integer?` cannot be stored into element 0 of the field
fn test_tuple_field_undischarged_elem(s: text) -> integer {
  tf_q = s as integer;
  tf_b = TupleFieldBox { t: (tf_q, 1) };
  tf_b.t.1
}

// @EXPECT_ERROR: cannot be stored into element 0 of element 0 of the return value
fn test_tuple_nested_undischarged_elem(s: text) -> ((integer, integer), integer) {
  tn_q = s as integer;
  ((tn_q, 1), 2)
}

// @PLN25 DN6 (N-Join): the inferred null-start widen (`a = null; a = 5` ⇒ `integer?`,
// accepted — see 25-null-join.loft) applies ONLY to an INFERRED local (`var_tp == null`
// is the inferred marker). An ANNOTATED non-null scalar still REJECTS a stored `null` —
// the explicit non-null contract wins; declare it `integer?` to allow null.
// @EXPECT_ERROR: cannot hold both `null` and the non-null scalar
fn test_annotated_nonnull_rejects_null() {
  a: integer = null;
  a = 5;
  assert(a == 5, "unreached");
}

// @PLN25 DN6 soundness boundary: the widen is INLINE-scalar only. `text` is the one
// heap-backed scalar — its Null slot cannot be retroactively widened to a text? heap-ref
// slot — so an inferred text null-start is NOT widened; it must annotate `s: text? = null`.
// (Guard: if `Text` were ever added to the DN6 widen set this would start ACCEPTING.)
// @EXPECT_ERROR: cannot hold both `null` and the non-null scalar
fn test_inferred_text_null_start_not_widened() {
  s = null;
  s = "hi";
  assert(s == "hi", "unreached");
}

// @PLN25/DN1: a NON-null return with a missing code path is a compile error — the else path
// yields void, and a non-null `text` return requires a value. Formerly a `-> text not null` fn
// got a lenient "may return null" WARNING; with `not null` retired (scalars non-null by
// default) that leniency is gone (moved here from 38-parse-warnings.loft's `pe_classify`).
// @EXPECT_ERROR: got void on return from block
fn pe_missing_return_path(n: integer) -> text {
  if n > 0 { return "pos"; }
}
