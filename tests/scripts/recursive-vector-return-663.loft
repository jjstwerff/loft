//
// Regression: a function returning a vector, whose value comes from a callee the
// parser could not resolve on pass 1 — a SELF-recursive, MUTUALLY-recursive, or
// merely FORWARD-declared function — silently dropped everything the callee
// produced.  `r = f(n-1); r += [x]; return r` returned just `[x]` (loft#663,
// both backends, no diagnostic).
//
// A vector return is delivered through the callee's hidden `__retbuf`, and the
// result's dep names the buffer the call site allocated for it.  But a function's
// returned type is not re-promoted until its body finishes, so a call into a
// function that has not finished parsing this pass reads EMPTY deps.  The
// receiving local then looked like a vector owning nothing, so `vector_db` gave
// it a fresh backing store and REPOINTED it — discarding the value the call had
// just written into the buffer.  Fixed by falling back to the buffer the call
// site allocated: a body-carrying vector-returning function always delivers
// through it, so when the declared deps are silent that IS where the value lives.
//
// Second fault, exposed once the value survived: the element WIDTH was lost.
// `is_equal` collapses every integer width to one type, so the pass-1 element
// type (no declared width, because the callee was unresolved) won over the `u8`
// pass 2 resolved.  Appending then wrote 8-byte elements into a 1-byte-strided
// store and they read back as 0 (`x` followed by NUL instead of `xy`).  An
// integer-element vector's width is the store's stride, so a declared width now
// wins over an undeclared one.

// SELF-recursive.
fn r663_self(n: integer) -> vector<u8> {
  if n <= 0 { return [120]; }         // 'x'
  r = r663_self(n - 1);
  r += [121];                          // 'y'
  return r;
}

// FORWARD-declared callee, no recursion at all — the same defect.  `r663_seed` is
// declared BELOW, so pass 1 cannot resolve it here.
fn r663_forward() -> vector<u8> {
  r = r663_seed();
  r += [121];
  return r;
}
fn r663_seed() -> vector<u8> { return [122]; }      // 'z'

// BACKWARD-declared callee — the control that always worked.
fn r663_backward() -> vector<u8> {
  r = r663_seed();
  r += [121];
  return r;
}

// MUTUAL recursion: `r663_a` calls a function declared after it.
fn r663_a(n: integer) -> vector<u8> {
  if n <= 0 { return [120]; }
  r = r663_b(n - 1);
  r += [121];
  return r;
}
fn r663_b(n: integer) -> vector<u8> {
  if n <= 0 { return [122]; }
  r = r663_a(n - 1);
  r += [123];                          // '{'
  return r;
}

// A non-narrow element type: the dep half of the fix without the width half.
fn r663_text(n: integer) -> vector<text> {
  if n <= 0 { return ["x"]; }
  r = r663_text(n - 1);
  r += ["y"];
  return r;
}

fn test_recursive_vector_return() {
  // 'x' then three appends of 'y' — the whole recursion must survive.
  assert(text_from_bytes(r663_self(3)) == "xyyy", "self-recursive: {text_from_bytes(r663_self(3))}");
  // depth 1 is already enough to lose the base case
  assert(text_from_bytes(r663_self(1)) == "xy", "self-recursive depth 1: {text_from_bytes(r663_self(1))}");
  assert(text_from_bytes(r663_forward()) == "zy", "forward-declared callee: {text_from_bytes(r663_forward())}");
  assert(text_from_bytes(r663_backward()) == "zy", "backward-declared callee: {text_from_bytes(r663_backward())}");
  // a(1) = b(0) + 'y' = 'z' + 'y'
  assert(text_from_bytes(r663_a(1)) == "zy", "mutual recursion: {text_from_bytes(r663_a(1))}");
  // The appended byte must keep its u8 WIDTH — an 8-byte write into a 1-byte
  // stride read back as 0, so the length was right while the value was NUL.
  bytes = r663_self(1);
  assert(len(bytes) == 2, "element count: {len(bytes)}");
  assert((bytes[1] ?? 0) == 121, "appended element keeps its u8 width: {bytes[1] ?? 0}");

  v = r663_text(3);
  assert(len(v) == 4, "recursive vector<text>: {len(v)}");
}
