// Native deep-copy self-assignment must not clobber the destination before the
// RHS reads it.  Surfaced while investigating @P290 (a sibling hash
// store-lifetime fault).
//
// For `x = f(x)` where `f` takes a Reference param and returns its argument
// (a borrowed view), native codegen used to emit `OpDatabase(x)` — which clears
// x's store IN PLACE — BEFORE the call that reads `x` as an argument.  The
// callee therefore saw an emptied destination, so a struct with a non-empty
// `hash<…>` / `vector<…>` field came back empty (find → null, len → 0).
// `--interpret` compiled the same source to a plain pointer pass-through and
// was always correct; the fix makes native evaluate the call first, then
// pointer-pass-through when the result already lives in the destination's store.
struct CornerRef {
  rk: text,
  x: integer,
}
struct G {
  look: hash<CornerRef[rk]>,
}
struct V {
  items: vector<CornerRef>,
}

fn id_g(g: G) -> G {
  return g;
}
fn id_v(v: V) -> V {
  return v;
}
fn add_g(g: G, k: text, x: integer) -> G {
  g.look += [
    CornerRef { rk: k, x: x },
  ]; return g;
}

pub fn main() {
  // 1) pure round-trip — a non-empty hash field must survive `g = id_g(g)`.
  g = G { look: [] };
  g.look += [
    CornerRef { rk: "a", x: 1 },
  ];
  g = id_g(g);
  assert(g.look.len() == 1, "hash len after round-trip");
  assert(g.look["a"] != null, "key a survives self-assign round-trip");
  assert(g.look["a"].x == 1, "key a value preserved");

  // 2) deep-copy-in then add, repeatedly — each `g = add_g(g, …)` copies the
  //    growing hash through a by-value param and must keep every earlier key.
  i = 0;
  while i < 6 {
    g = add_g(g, "k{i}", i * 10);
    i = i + 1;
  }
  assert(g.look["a"] != null, "original key still present after 6 self-assign adds");
  j = 0;
  while j < 6 {
    r = g.look["k{j}"];
    assert(r != null, "k{j} present");
    assert(r.x == j * 10, "k{j} value");
    j = j + 1;
  }

  // 3) vector field through the same self-assign shape.
  v = V { items: [] };
  v.items += [
    CornerRef { rk: "p", x: 5 },
  ];
  v.items += [
    CornerRef { rk: "q", x: 6 },
  ];
  v = id_v(v);
  assert(v.items.len() == 2, "vector field length after self-assign round-trip");
  assert(v.items[0].x == 5, "vector item 0 preserved");
  assert(v.items[1].x == 6, "vector item 1 preserved");
}
