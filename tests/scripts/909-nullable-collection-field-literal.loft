//
// A field's STORAGE decides how a literal reaches it, and `τ?` stores like `τ`.
//
// `parse_object_field` asks whether a field carries a record-pointer header, and
// answered that by matching the declared type against the collection formers —
// without peeling the `Optional` marker.  So a nullable collection field was not
// recognised as a collection: instead of building the literal in place, the parser
// minted a standalone `_vec_N` temp.  That temp was created with a dep on the
// struct it sits in, which is exactly the condition under which `build_vector_list`
// skips `vector_db` — so nothing ever assigned it, it reached codegen with no live
// interval and no stack slot, and the compiler ABORTED with
// `Incorrect var _vec_1[65535]` (loft#909).
//
// Both halves were needed: a non-nullable field took the in-place path, and an
// EMPTY literal on a nullable field returned early before the temp was minted.
// A keyed nullable field failed one step earlier still, refusing the literal with
// "Cannot assign vector<R> to field of type optional(hash(...))".
//
// Rows move one axis each — nullability, emptiness, element type, container kind,
// and how the value arrives (literal / variable / call).  Every row asserts a
// CONTENT value: the bug was an abort, so a row that merely compiles proves
// nothing about the vector it built.

struct Inner { z: integer }
struct Row { k: integer, v: integer }

struct Opt {
  vi: vector<integer>?,
  vt: vector<text>?,
  vs: vector<Inner>?,
  h: hash<Row[k]>?,
  t: integer,
}

// The non-nullable sibling, which always worked — the row the broken one is
// compared against, so a regression says which of the two paths moved.
struct Plain {
  vi: vector<integer>,
  vs: vector<Inner>,
  t: integer,
}

struct OneOpt { m: vector<integer>?, t: integer }

fn mk() -> vector<integer> { [7, 8] }

fn main() {
  // The reported shape: a non-empty literal initialising a nullable collection
  // field, for every element kind and both container kinds.
  o = Opt {
    vi: [5, 6],
    vt: ["a", "bc"],
    vs: [Inner { z: 9 }, Inner { z: 11 }],
    h: [Row { k: 1, v: 2 }],
    t: 3,
  };
  assert(o.t == 3, "the sibling scalar field must still land, got {o.t}");
  assert(len(o.vi ?? []) == 2, "nullable vector<integer> length, got {len(o.vi ?? [])}");
  assert((o.vi ?? [])[0] == 5 && (o.vi ?? [])[1] == 6, "nullable vector<integer> contents, got {o.vi}");
  assert(len(o.vt ?? []) == 2, "nullable vector<text> length, got {len(o.vt ?? [])}");
  assert((o.vt ?? [])[1] == "bc", "nullable vector<text> contents, got {o.vt}");
  assert(len(o.vs ?? []) == 2, "nullable vector<Inner> length, got {len(o.vs ?? [])}");
  assert((o.vs ?? [])[0].z == 9 && (o.vs ?? [])[1].z == 11, "nullable vector<Inner> contents");
  assert(o.h[1].v == 2, "nullable hash field must hold its literal row, got {o.h[1].v}");

  // The non-nullable path, unchanged.
  p = Plain { vi: [5, 6], vs: [Inner { z: 9 }], t: 3 };
  assert(len(p.vi) == 2 && p.vi[1] == 6, "plain vector<integer> field, got {p.vi}");
  assert(p.vs[0].z == 9, "plain vector<Inner> field, got {p.vs[0].z}");

  // The EMPTY literal, which rescued the bug by returning before the temp was
  // minted — it must still build an empty collection, not skip the field.
  e = OneOpt { m: [], t: 4 };
  assert(len(e.m ?? []) == 0, "an empty literal must leave the field empty, got {len(e.m ?? [])}");
  assert(e.t == 4, "the sibling field after an empty literal, got {e.t}");

  // The documented workaround, which must keep working: construct null, assign after.
  w = OneOpt { m: null, t: 5 };
  w.m = [5];
  assert(len(w.m ?? []) == 1 && (w.m ?? [])[0] == 5, "assign-after-null, got {w.m}");

  // A nullable collection field fed from a VARIABLE rather than a literal.  This
  // path always worked, and it routes through the same classification — the
  // deep copy must survive, so mutating the source must not reach the field.
  src = [1, 2];
  fv = OneOpt { m: src, t: 6 };
  src += [9];
  assert(len(fv.m ?? []) == 2, "a field built from a variable must be an independent copy, got {fv.m}");
  assert(len(src) == 3, "the source vector must still take its own append, got {src}");

  // ...and from a CALL, the other non-literal source through the same site.
  fc = OneOpt { m: mk(), t: 7 };
  assert(len(fc.m ?? []) == 2 && (fc.m ?? [])[1] == 8, "a field built from a call, got {fc.m}");
}
