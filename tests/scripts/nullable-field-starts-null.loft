//
// A nullable value in a field is null at the start — `formal/types.md` (D-Opt).
//
// The default of `τ?` is τ's null SENTINEL, not τ's zero.  The distinction is invisible
// for a base whose zero already IS its null (an enum's 0, a reference's null pointer) and
// load-bearing for every other: `integer?` starting at `0` means an absent field reads
// back as a VALUE, and `0` is a legitimate integer.
//
// Both spellings of "no value given" answer the same way — an omitted field and an
// explicit `= null` default — and both agree with what the runtime store-init path
// (`Stores::set_default_value_nullable`) writes when a record arrives from a `#read`.
//
// The narrow widths are the sharp cells: each has its OWN null code (i16's raw 0, i32's
// i32::MIN, the byte's 255), so a single stack sentinel has to encode per width.

struct NfsNullable { a: i8?, b: u8?, c: i16?, d: u16?, e: i32?, f: integer?, g: float?, h: single?, i: boolean?, j: text? }
struct NfsExplicit { a: integer? = null, b: boolean? = null, c: text? = null }
struct NfsNonNull { a: integer, b: boolean, c: float, d: text }
enum NfsColour { Red, Green, Blue }
struct NfsInner { n: integer }
struct NfsRefs { c: NfsColour?, r: NfsInner?, v: vector<integer> }

fn test_every_nullable_width_starts_null() {
  n = NfsNullable {};
  assert(n.a == null, "i8? omitted: {n.a}");
  assert(n.b == null, "u8? omitted: {n.b}");
  assert(n.c == null, "i16? omitted: {n.c}");
  assert(n.d == null, "u16? omitted: {n.d}");
  assert(n.e == null, "i32? omitted: {n.e}");
  assert(n.f == null, "integer? omitted: {n.f}");
  assert(n.g == null, "float? omitted: {n.g}");
  assert(n.h == null, "single? omitted: {n.h}");
  assert(n.i == null, "boolean? omitted: {n.i}");
  assert(n.j == null, "text? omitted: {n.j}");
}

// The stated escape hatch has to work too: before this rule was enforced, an explicit
// `= null` default answered the base ZERO exactly as an omitted field did, so the
// documented way to ask for null did not produce null either.
fn test_explicit_null_default_matches_omission() {
  e = NfsExplicit {};
  assert(e.a == null, "explicit = null on integer?: {e.a}");
  assert(e.b == null, "explicit = null on boolean?: {e.b}");
  assert(e.c == null, "explicit = null on text?: {e.c}");
}

// The CONTROL: a non-null field still takes its type's zero.  D-Opt moves the nullable
// case only, and a fix that made every field null would pass every cell above.
fn test_non_null_fields_still_take_their_zero() {
  z = NfsNonNull {};
  assert(z.a == 0, "integer: {z.a}");
  assert(z.b == false, "boolean: {z.b}");
  assert(z.c == 0.0, "float: {z.c}");
  assert(z.d == "", "text: '{z.d}'");
}

// Bases whose zero already IS their null keep answering null — the cells where the old
// base-zero shortcut was indistinguishable from the rule, and so must not regress.
fn test_enum_reference_and_collection_bases() {
  r = NfsRefs {};
  assert(r.c == null, "Colour? omitted: {r.c}");
  assert(r.r == null, "Inner? omitted: {r.r}");
  assert(len(r.v) == 0, "vector omitted: {len(r.v)}");
}

// A present value must survive, and a write back to null must still read null — the
// round-trip half, which is what kept the narrow encodings honest before this change.
fn test_value_and_re_null_round_trip() {
  n = NfsNullable {};
  n.c = 5; n.e = 7; n.f = 9;
  assert(n.c == 5, "i16? set: {n.c}");
  assert(n.e == 7, "i32? set: {n.e}");
  assert(n.f == 9, "integer? set: {n.f}");
  n.c = null; n.e = null; n.f = null;
  assert(n.c == null, "i16? re-null: {n.c}");
  assert(n.e == null, "i32? re-null: {n.e}");
  assert(n.f == null, "integer? re-null: {n.f}");
}

// A partial literal: the named field keeps its value, the omitted nullable is null.
fn test_partial_literal_leaves_named_fields_alone() {
  p = NfsNullable { c: 3, j: "hi" };
  assert(p.c == 3, "named i16?: {p.c}");
  assert(p.j == "hi", "named text?: '{p.j}'");
  assert(p.a == null, "omitted beside named: {p.a}");
  assert(p.f == null, "omitted beside named: {p.f}");
}
