//
// @PLN25 copy-vs-borrow differential — validates the USE-analysis verdicts
// DYNAMICALLY, in pure loft, with no codegen change and no risk: a borrow is
// semantically the INLINED field access, so for every shape the analysis marks
// Borrow we run both the copy-form (`t = s.f; … t[i]`) and the borrow-form
// (`… s.f[i]`) and assert identical results. The control mutates the source so
// the two forms DIVERGE, proving the differential is not vacuous AND that the
// analysis (which calls the control "Copy — source mutated") refuses borrow
// exactly where copy != borrow. Both backends.
//
// See doc/claude/plans/25-nullable-sequences/materialization-algorithm-design.md
// (the copy oracle) and use-analysis-prework-design.md.

struct Grid { cells: vector<integer>, edges: vector<integer> }

// ── SAFE shapes (analysis verdict: Borrow) — copy-form ≡ borrow-form ──────────

// plain read
fn read_copy(g: Grid, i: integer) -> integer { c = g.cells; c[i] ?? -1 }
fn read_borrow(g: Grid, i: integer) -> integer { g.cells[i] ?? -1 }

// length-guarded read (the tile_at / edge_wall_raw shape)
fn guarded_copy(g: Grid, i: integer) -> integer {
  c = g.cells;
  if i >= 0 && i < len(c) { c[i] ?? -1 } else { -7 }
}
fn guarded_borrow(g: Grid, i: integer) -> integer {
  if i >= 0 && i < len(g.cells) { g.cells[i] ?? -1 } else { -7 }
}

// sum over the whole borrowed view
fn sum_copy(g: Grid) -> integer {
  c = g.cells;
  acc = 0;
  for k in 0..len(c) { acc += c[k] ?? 0; }
  acc
}
fn sum_borrow(g: Grid) -> integer {
  acc = 0;
  for k in 0..len(g.cells) { acc += g.cells[k] ?? 0; }
  acc
}

// ── CONTROL (analysis verdict: Copy — source mutated) — forms DIVERGE ─────────
fn ctl_copy(g: Grid, i: integer) -> integer { t = g.cells; g.cells[0] = 99; t[i] ?? -1 }
fn ctl_borrow(g: Grid, i: integer) -> integer { g.cells[0] = 99; g.cells[i] ?? -1 }

fn main() {
  g = Grid { cells: [10, 20, 30, 40], edges: [1, 2, 3] };

  // For every Borrow shape, the copy and inlined-borrow forms must agree on
  // every index (in-bounds and out-of-bounds) — i.e. borrowing is observably
  // identical to copying, which is exactly what the verdict claims.
  for i in -2..7 {
    assert(read_copy(g, i) == read_borrow(g, i), "read: copy != borrow at {i}");
    assert(guarded_copy(g, i) == guarded_borrow(g, i), "guarded: copy != borrow at {i}");
  }
  assert(sum_copy(g) == sum_borrow(g), "sum: copy != borrow");

  // The control DIVERGES — the snapshot keeps the pre-mutation value, the live
  // read sees the mutation. This proves the differential can fail, so the
  // agreements above are real evidence (and the analysis calls this shape Copy).
  // Fresh grids per call: the control mutates its arg's field, which (structs
  // alias in loft) writes back to the caller — so reusing one grid would corrupt
  // the second call.
  gc = Grid { cells: [10, 20, 30, 40], edges: [1] };
  gd = Grid { cells: [10, 20, 30, 40], edges: [1] };
  cv = ctl_copy(gc, 0);
  dv = ctl_borrow(gd, 0);
  assert(cv != dv, "control must diverge (copy snapshot vs live read)");
  assert(cv == 10, "control copy keeps the snapshot");
  assert(dv == 99, "control borrow sees the mutation");

  println("borrow-elision differential ok");
}
