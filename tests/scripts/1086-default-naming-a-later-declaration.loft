//
// A default that names a constant declared LATER in the file (loft#1086).
//
// Declaration order is not meant to matter — the parser is two-pass. But pass 1 is the
// pass that RECORDS definitions, so a name declared later is genuinely absent while pass
// 1 parses the default, and the default becomes a fresh variable of unknown type. Two
// things then went wrong, and only one of them was loud:
//
//   * a default that reads as "needs a temporary" is lowered into a function of its own,
//     minted in pass 1. Pass 2 resolved the name, read the same default as "replayable",
//     and declined to re-mint — leaving that function holding a variable no frame ever
//     allocated. Codegen aborted with `Incorrect var NAME[65535]`, an internal error on a
//     program whose only fault was the order of two declarations.
//   * a PARAMETER default is parsed and stored ONCE, in pass 1, and every call site
//     replays what was stored; the pass-2 re-parse is discarded. So a default whose
//     pass-1 reading COLLAPSED was frozen: `b: integer = a + LATER` stored just `a`, and
//     the call answered the argument where the sum was written. No error, no warning.
//
// So the cells assert VALUES from calls that take the default, and each shape appears
// twice — once with the declaration above and once below — because the pair is the
// claim. A cell that only ran the "below" half could pass on a fix that broke the half
// that always worked.

const ABOVE_TOL = 0.02;
const ABOVE_N = 10;

struct DlAbove { dl_tol: float = ABOVE_TOL }
struct DlBelow { dl_tol: float = BELOW_TOL }
struct DlBelowComputed { dl_n: integer = BELOW_N * 2 + 1 }
struct DlBelowSum { dl_n: integer = 1 + BELOW_N }

struct DlBox { dl_v: integer }

// `$` selecting a field declared BELOW it — the same divergence reached without a
// constant at all: pass 1 cannot resolve `dl_wide`, so the default read as "reads
// nothing" and was lowered into a function; pass 2 read it as "reads the record" and left
// that function holding a `$` no frame ever allocated.
struct DlRecord { dl_area: integer = $.dl_wide * 3, dl_wide: integer }

fn dl_above_p(a: integer, b: integer = a + ABOVE_N) -> integer { b }
fn dl_below_p(a: integer, b: integer = a + BELOW_N) -> integer { b }
fn dl_below_leading(a: integer, b: integer = BELOW_N + a) -> integer { b }
fn dl_below_only(x: integer = BELOW_N) -> integer { x }
fn dl_below_two(a: integer = BELOW_N, b: integer = BELOW_M) -> integer { a * 100 + b }
fn dl_below_text(a: text, b: text = a + BELOW_T) -> text { b }
fn dl_scale(self: DlBox, k: integer = BELOW_M) -> integer { self.dl_v * k }

const BELOW_TOL = 0.02;
const BELOW_N = 10;
const BELOW_M = 3;
const BELOW_T = "!";

fn main() {
  // c1 (control) — the declaration ABOVE its use, the order that always worked. Red here
  //     means the fix broke the path it was meant to leave alone.
  dl_a = DlAbove {};
  assert(dl_a.dl_tol == 0.02, "c1 = {dl_a.dl_tol}, want 0.02");

  // c2 — the filed shape: a struct field default naming a constant declared below. It
  //     aborted the compiler; the value it should carry is the control's.
  dl_b = DlBelow {};
  assert(dl_b.dl_tol == 0.02, "c2 = {dl_b.dl_tol}, want 0.02");
  assert(dl_b.dl_tol == dl_a.dl_tol, "c2 {dl_b.dl_tol} vs c1 {dl_a.dl_tol}");

  // c3 — ARITHMETIC over the later constant, so the fold has more than a bare name to
  //     carry across the pass boundary.
  dl_c = DlBelowComputed {};
  assert(dl_c.dl_n == 21, "c3 = {dl_c.dl_n}, want 21");

  // c4 — the later constant on the RIGHT of the operator. Operand order decided which
  //     symptom appeared, so both orders are cells.
  dl_d = DlBelowSum {};
  assert(dl_d.dl_n == 11, "c4 = {dl_d.dl_n}, want 11");

  // c5 (control) — a parameter default reading an earlier PARAMETER plus a constant
  //     declared above. This is the shape c6 must match.
  assert(dl_above_p(5) == 15, "c5 = {dl_above_p(5)}, want 15");

  // c6 — the SILENT half: the same default with the constant declared below. It answered
  //     5 — the argument, with `+ BELOW_N` dropped — and nothing said so. Checked against
  //     an explicit argument too, because passing one bypasses the default entirely and
  //     would make a broken default look fine.
  assert(dl_below_p(5) == 15, "c6 = {dl_below_p(5)}, want 15");
  assert(dl_below_p(5, 99) == 99, "c6 explicit = {dl_below_p(5, 99)}, want 99");

  // c7 — the constant FIRST and the parameter second. This ordering aborted the compiler
  //     rather than answering quietly wrong, so it is a separate cell from c6.
  assert(dl_below_leading(5) == 15, "c7 = {dl_below_leading(5)}, want 15");

  // c8 — a parameter default that reads NO earlier parameter, only the later constant.
  assert(dl_below_only() == 10, "c8 = {dl_below_only()}, want 10");

  // c9 — TWO defaults in one signature, each naming a different later constant, and one
  //     supplied at the call. A per-parameter fix that shared state across them fails
  //     here rather than in a program.
  assert(dl_below_two() == 1003, "c9 = {dl_below_two()}, want 1003");
  assert(dl_below_two(2) == 203, "c9 partial = {dl_below_two(2)}, want 203");

  // c10 — a TEXT default, which is built in a work buffer rather than written as a
  //     value, so it reaches the replay decision by a different route.
  assert(dl_below_text("x") == "x!", "c10 = {dl_below_text(\"x\")}, want x!");

  // c11 — a METHOD's parameter default. A default that reads `self` is itself keyed by
  //     the receiver, so the function pass 1 minted is not where the plain name looks —
  //     this cell was still an internal error when every cell above had gone green.
  dl_box = DlBox { dl_v: 7 };
  assert(dl_box.dl_scale() == 21, "c11 = {dl_box.dl_scale()}, want 21");
  assert(dl_box.dl_scale(2) == 14, "c11 explicit = {dl_box.dl_scale(2)}, want 14");

  // c12 — a `$`-reading default that names a field declared LATER. It compiles now; the
  //     VALUE it must carry is the one declaration order gives, because defaults are
  //     applied in that order and a supplied field is already written when the omitted
  //     one's default runs. Supplied here, so `$.dl_wide` reads 4 and not the zero.
  dl_rec = DlRecord { dl_wide: 4 };
  assert(dl_rec.dl_area == 12, "c12 = {dl_rec.dl_area}, want 12");

  println("1086 ok");
}
