// An ABSENT nullable field reads back null — at every width.
//
// A record's slots are pre-filled with each field's default, and that writer spelled the
// null differently per width.  Two of the spellings were not the null at all:
//
//   * `Parts::Short` (the nullable 2-byte encoding) was handed the VALUE `65535`, but its
//     encoding is `val - min + 1` with the raw code 0 reserved for null — so 65535 does not
//     fit, the setter took its out-of-range branch, and the slot got the DEFAULT (raw 1).
//     A `u16?` therefore read back `0` and an `i16?` read back `-32767`.
//   * a nullable `boolean` got `false`, though @PLN17 C73 gives it a tri-state slot whose
//     `255` IS its null — the one nullable base type whose absence read back as a VALUE
//     while the integer, float and text arms beside it all wrote their sentinel.
//
// Both were silent, and `to_json` hid the 2-byte one: it used to serialise a null `u16?`
// as `-2147483648`, which the parser read back AS null, so the round-trip looked right for
// the wrong reason.  Now the JSON omits the absent field, and the field is null on both
// sides of it.
struct S {
  keep: text,
  b: u8?, s: u16?, i: i16?, r: integer limit(10,255)?, w: integer?,
  f: float?, t: text?, o: boolean?,
  plain: integer, flag: boolean,
}

fn main() {
  // Parsed from JSON that names none of the nullable fields.
  x = S.parse(`{{"keep":"k"}}`);
  assert(x.b == null && x.s == null && x.i == null, "absent narrow fields are null");
  assert(x.r == null && x.w == null, "absent ranged and wide integers are null");
  assert(x.f == null && x.t == null && x.o == null, "absent float, text and boolean are null");
  // A non-null field keeps its zero — absence is not null where the type cannot hold one.
  assert(x.plain == 0 && !x.flag, "non-null fields keep the type's zero");

  // An explicit JSON `null` is the other spelling of the same thing.
  y = S.parse(`{{"keep":"k","s":null,"i":null,"o":null}}`);
  assert(y.s == null && y.i == null && y.o == null, "explicit JSON null reads back null");

  // NOT asserted here, deliberately: a struct LITERAL that omits a nullable field takes
  // the type's ZERO (`u16?` → 0, `boolean?` → false), except `limit(lo,hi)?`, which gives
  // null.  That is a third spelling of "absent" and it disagrees with these two — but it
  // is loft#914's documented omitted-field-zero behaviour, so changing it is a design
  // call, not a fix.  Recorded in QUALITY.md; pinning it here would freeze one side of an
  // open question.

  // And the round-trip, which is where the two halves have to agree: a field absent from
  // the input is absent from the output, and still absent when read back.  It starts from
  // a PARSE, not a literal — a literal that omits a nullable field gives the type's zero
  // (the open question noted above), so building the case that way would test the other
  // path and pass for the wrong reason.
  c = S.parse(`{{"keep":"k","i":-300,"plain":1,"flag":true}}`);
  j = c.to_json();
  assert(j == `{{"keep":"k","i":-300,"plain":1,"flag":true}}`,
         "absent fields stay absent, the present narrow value is exact");
  back = S.parse(j);
  assert(back.i == -300 && back.s == null && back.o == null && back.keep == "k",
         "round-trip keeps the value and the absence");
}
