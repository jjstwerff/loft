// Probe 47 — Cluster V practical shape: chained `??` lookup
//    `x = lookup1(k) ?? lookup2(k) ?? "default";` — the common
//    "first available, else fallback chain" idiom for config / cache /
//    multi-tier lookup.
//
// Both `lookup1(k)` and `lookup2(k)` return text from internal data.
// The outer `??` builds on top of the inner — if the inner pushes a
// dangling Str, the outer comparison may read it correctly OR corrupt.
//
// Pairing: diff against 06 (nested literal-default `??`).
// Status: cluster V practical-pattern probe.

struct Cache {
  items: hash<Entry[name]>,
}
struct Entry {
  name: text,
  value: text,
}

fn lookup(c: Cache, k: text) -> text {
  return c.items[k].value; // null if missing
}

fn main() {
  primary = Cache { items: [] };
  primary.items["theme"] = Entry { name: "theme", value: "dark" };
  secondary = Cache { items: [] };
  secondary.items["lang"] = Entry { name: "lang", value: "en" };

  a = lookup(primary, "theme") ?? lookup(secondary, "theme") ?? "fallback";
  assert(a == "dark", "probe 47a: got '{a}', want 'dark'");

  b = lookup(primary, "lang") ?? lookup(secondary, "lang") ?? "fallback";
  assert(b == "en", "probe 47b: got '{b}', want 'en'");

  c = lookup(primary, "missing") ?? lookup(secondary, "missing") ?? "fallback";
  assert(c == "fallback", "probe 47c: got '{c}', want 'fallback'");

  println("probe 47 PASSED");
}
