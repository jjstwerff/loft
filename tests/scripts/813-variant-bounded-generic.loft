// SPDX-License-Identifier: LGPL-3.0-or-later
// A value whose static type is a struct-enum VARIANT, passed where a bounded generic
// wants the enum, answered the return type's EMPTY value instead of calling the
// method — with no diagnostic (loft#813).  `--native` emitted a `todo!()` stub for a
// method on the type PARAMETER and panicked; `--interpret` returned "" and continued.
//
// The two halves of the generic disagreed.  `check_satisfaction` resolves the bound
// against `def(variant).returned()`, and for a variant that IS the parent enum, so the
// bound passed on `Any`'s method.  `re_resolve_call` then bound `S` to the VARIANT and
// looked for `t_3AsA_one`, which does not exist, so the call stayed on `S`.
//
// It is settled by what the language already does: a variant dispatches its enum's
// methods on the DIRECT path (`parser/fields.rs` method-on-parent-enum), so `c1(v)`
// must answer what `v.one()` answers.  The enum lookup is a FALLBACK, tried only after
// the variant's own — which is what keeps a per-variant impl winning, exactly as on
// the direct path.
//
// The shapes are all here because every one of them failed identically once the
// argument was variant-typed, so the defect was in the call resolution and not in any
// consumer of the result.  Two generic hops are included because that composition
// turned the empty answer into a SIGSEGV on the interpreter.

interface Src { fn one(self: Self) -> text }

struct A { nm: text }
fn one(self: A) -> text { return self.nm; }

enum Any { AsA { a: A }, Nowt { why: text } }
fn one(self: Any) -> text {
  match self {
    AsA { a } => a.one(),
    Nowt => "",
  }
}

struct Box { t: text }

// The five shapes from the issue's boundary table.
fn s_ret    <S: Src> (s: S) -> text { return s.one(); }
fn s_interp <S: Src> (s: S) -> text { return "[{s.one()}]"; }
fn s_vec    <S: Src> (s: S) -> text { v: vector<text> = []; v += [s.one()]; return v[0]; }
fn s_field  <S: Src> (s: S) -> text { b = Box { t: s.one() }; return b.t; }
fn s_vecf   <S: Src> (s: S) -> text { w: vector<Box> = []; w += [Box { t: s.one() }]; return w[0].t; }

// Two hops on the same receiver — the SIGSEGV composition.
fn hop2 <S: Src> (s: S) -> text { return s.one(); }
fn hop1 <S: Src> (s: S) -> text { return hop2(s); }

// A second enum whose VARIANT carries its own impl, so the fallback cannot be allowed
// to hijack it.
interface Named { fn tag(self: Self) -> text }
enum Two { First { x: integer }, Second { y: integer } }
fn tag(self: Two) -> text {
  match self {
    First => "ENUM-first",
    Second => "ENUM-second",
  }
}
fn tag(self: First) -> text { return "VARIANT-{self.x}"; }
fn t1 <T: Named> (t: T) -> text { return t.tag(); }

fn main() {
  v = AsA { a: A { nm: "ada" } };        // variant-typed — the reported shape
  e: Any = AsA { a: A { nm: "eve" } };   // enum-typed — the documented workaround

  // A variant-typed argument answers what the direct call answers ...
  assert(v.one() == "ada", "variant direct: {v.one()}");
  assert(s_ret(v) == "ada", "variant via generic return: {s_ret(v)}");
  assert(s_interp(v) == "[ada]", "variant via interpolation: {s_interp(v)}");
  assert(s_vec(v) == "ada", "variant via vector append: {s_vec(v)}");
  assert(s_field(v) == "ada", "variant via struct field: {s_field(v)}");
  assert(s_vecf(v) == "ada", "variant via struct in vector: {s_vecf(v)}");
  assert(hop1(v) == "ada", "variant through two generic hops: {hop1(v)}");

  // ... and the enum-typed form is unchanged.
  assert(e.one() == "eve", "enum direct: {e.one()}");
  assert(s_ret(e) == "eve", "enum via generic return: {s_ret(e)}");
  assert(s_interp(e) == "[eve]", "enum via interpolation: {s_interp(e)}");
  assert(s_vec(e) == "eve", "enum via vector append: {s_vec(e)}");
  assert(s_field(e) == "eve", "enum via struct field: {s_field(e)}");
  assert(s_vecf(e) == "eve", "enum via struct in vector: {s_vecf(e)}");
  assert(hop1(e) == "eve", "enum through two generic hops: {hop1(e)}");

  // A plain struct never went through the fallback and must not start.
  p = A { nm: "pat" };
  assert(s_ret(p) == "pat", "plain struct via generic: {s_ret(p)}");

  // The enum lookup is a FALLBACK: a variant's own impl still wins, on both the
  // direct path and through the generic.
  f = First { x: 1 };
  assert(f.tag() == "VARIANT-1", "per-variant impl, direct: {f.tag()}");
  assert(t1(f) == "VARIANT-1", "per-variant impl, via generic: {t1(f)}");
  g: Two = Second { y: 2 };
  assert(t1(g) == "ENUM-second", "enum impl via generic: {t1(g)}");

  println("813-variant-bounded-generic ok");
}
