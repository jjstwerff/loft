//
// Checked narrowing cast with a fallback: `e as N ?? d` and `e as N? ?? d`
// (N a narrow integer, d a value that fits N) are checked-narrow-with-fallback
// expressions of type N — the value when it fits N's range, else the default d.
// The natural form `e as N ?? d` (no `?`) is accepted the same as `e as N? ?? d`.
//
// Before this, a bare `e as N` was rejected outright ("may not fit"), and the
// `?`-form discharged with `?? d` widened the result back to `integer`, so a `u8`
// field / return / local could not accept it without a second `as u8`. The
// discharge point now types the result as N's RANGE (a full-width integer whose
// range fits N) — so no null escapes and a narrow slot accepts it directly.
//
// @PLN25 DN4 family (the checked-cast lowering). Runs on BOTH backends.

struct S { b: u8 }

fn ret_natural(x: integer) -> u8 { return x as u8 ?? 0 }   // no `?`
fn ret_qmark(x: integer)   -> u8 { return x as u8? ?? 0 }  // `?`
fn field_natural(x: integer) -> S { return S { b: x as u8 ?? 0 } }

fn test_return_position() {
  assert(ret_natural(200) == 200, "ret 200 -> {ret_natural(200)} (expect 200)");
  assert(ret_natural(511) == 0,   "ret 511 -> {ret_natural(511)} (expect 0, out of range)");
  assert(ret_natural(255) == 255, "ret 255 -> {ret_natural(255)} (expect 255, boundary)");
  assert(ret_natural(256) == 0,   "ret 256 -> {ret_natural(256)} (expect 0)");
  assert(ret_natural(-5) == 0,    "ret -5 -> {ret_natural(-5)} (expect 0, negative)");
  // `?`-form is equivalent.
  assert(ret_qmark(200) == 200, "ret? 200 -> {ret_qmark(200)} (expect 200)");
  assert(ret_qmark(511) == 0,   "ret? 511 -> {ret_qmark(511)} (expect 0)");
}

fn test_struct_field() {
  assert(field_natural(200).b == 200, "field 200 -> {field_natural(200).b} (expect 200)");
  assert(field_natural(511).b == 0,   "field 511 -> {field_natural(511).b} (expect 0)");
  // `?`-form directly in a literal.
  z = 300;
  assert(S { b: z as u8? ?? 0 }.b == 0, "field? 300 -> {S { b: z as u8? ?? 0 }.b} (expect 0)");
}

fn test_local_and_default() {
  x1 = 50;  b1: u8 = x1 as u8 ?? 0; assert(b1 == 50, "local 50 -> {b1} (expect 50)");
  x2 = 999; b2: u8 = x2 as u8 ?? 0; assert(b2 == 0,  "local 999 -> {b2} (expect 0)");
  // Non-zero default that fits N.
  x3 = 700; assert((x3 as u8 ?? 7) == 7,  "def7 700 -> {x3 as u8 ?? 7} (expect 7)");
  x4 = 40;  assert((x4 as u8 ?? 7) == 40, "def7 40 -> {x4 as u8 ?? 7} (expect 40)");
}

fn test_vector_element() {
  z = 700;
  v: vector<u8> = [z as u8 ?? 0, 9 as u8 ?? 0, 255 as u8 ?? 0];
  assert(v[0] == 0,   "vec[0] -> {v[0]} (expect 0)");
  assert(v[1] == 9,   "vec[1] -> {v[1]} (expect 9)");
  assert(v[2] == 255, "vec[2] -> {v[2]} (expect 255)");
}

fn main() {
  test_return_position();
  test_struct_field();
  test_local_and_default();
  test_vector_element();
  println("504 cast-coalesce-narrow ok\n");
}
