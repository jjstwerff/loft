// #429 regression: a struct-enum-returning fn whose body returns a BORROWED
// view of an argument (`match m { CMap { entries } => { r = entries[i].value;
// return r } }`) was mis-classified OWNED, so the caller's `acl = get_field(m)`
// bind adopted the view and `OpFreeRef(acl)` at scope exit whole-store-freed the
// subject's record.  Interp-only corruption (native's runtime adopt-or-copy
// guard already copied); allocation pressure after the free recycled the freed
// store, corrupting the Holder's tag/n.  Two coordinated fixes:
//   1. a match-arm HEAP field binding now carries a borrow dep on the subject
//      (control.rs parse_match_enum_field_bindings) so `ref_return`'s transitive
//      walk reaches the parameter and classifies the fn as returning a borrow;
//   2. the interp call-bind copy-or-adopt split (gen_set_first_at_tos) now also
//      fires for a struct-enum (`Type::Enum(_, true, _)`) binding, not only
//      `Type::Reference`, so it deep-copies a borrowed-view return.
enum CborValue {
  CNull,
  CInt { value: integer },
  CBytes { value: vector<u8> },
  CText { value: text },
  CArray { items: vector<CborValue> },
  CMap { entries: vector<CborEntry> },
}
struct CborEntry {
  key: CborValue,
  value: CborValue,
}
struct Holder {
  tag: text,
  fields: CborValue,
  n: integer,
}

fn ent(k: integer, v: CborValue) -> CborEntry {
  return CborEntry {
    key: CInt { value: k },
    value: v,
  };
}
fn cnull() -> CborValue {
  return CNull;
}

// returns a BORROWED VIEW of `m` (r = entries[i].value) — the over-free shape.
fn get_field(m: CborValue, key: integer) -> CborValue {
  match m {
    CMap { entries } => {
      for i in 0..len(entries) {
        e = entries[i];
        match e.key {
          CInt { value } => {
            if value == key {
              r = e.value; return r;
            }
          }, _ => {}
        }
      }
      CNull
    },
    _ => CNull,
  }
}
fn field_text(m: CborValue, key: integer) -> text {
  match get_field(m, key) {
    CText { value } => { return "{value}"; }, _ => {}
  }
  return "";
}
fn walk(fields: CborValue) -> boolean {
  acl = get_field(fields, 3); // a view into `fields`; freeing it must NOT free fields' store
  match acl {
    CArray { items } => {
      for i in 0..len(items) {
        e = items[i] ?? cnull();
        if field_text(e, 1) == "individual" { return true; }
      }
      return false;
    },
    _ => { return false; },
  }
}
// allocation pressure: same-shaped CMap allocations that recycle a freed store slot.
fn make_filler(n: integer) -> CborValue {
  es: vector<CborEntry> = [];
  for j in 0..n { es += [ent(j * 7 + 1, CText { value: "RECYCLE-FILL-{j}" })]; }
  return CMap { entries: es };
}
fn fill_depth(c: CborValue) -> integer {
  match c {
    CMap { entries } => { return len(entries); }, _ => { return 0; }
  }
}
fn mk_holder() -> Holder {
  acle: vector<CborEntry> = [];
  acle += [ent(1, CText { value: "individual" })];
  acls: vector<CborValue> = [];
  acls += [
    CMap { entries: acle },
  ];
  pfe: vector<CborEntry> = [];
  pfe += [ent(3, CArray { items: acls })];
  return Holder {
    tag: "TAG-VALUE-12345",
    fields: CMap { entries: pfe },
    n: 99,
  };
}
fn main() {
  h = mk_holder();
  found = false;
  for k in 0..20 {
    ok = walk(h.fields);
    if ok { found = true; }
    // allocation pressure AFTER walk frees the subject's store, BEFORE re-reading h:
    // recycle the just-freed slot so an over-free corrupts the Holder.
    acc = 0;
    for f in 0..6 { acc += fill_depth(make_filler(4)); }
    assert(acc == 24, "filler allocation churn ran");
    assert(
      h.tag == "TAG-VALUE-12345",
      "Holder tag intact after walk (no over-free of borrowed view)"
    );
    assert(h.n == 99, "Holder n intact after walk");
  }
  assert(found, "walk found the 'individual' entry through the borrowed view");
  println("enum-match-borrowed-view-overfree ok: tag={h.tag} n={h.n}");
}
