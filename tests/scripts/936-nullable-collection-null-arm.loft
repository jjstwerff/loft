//
// A `null` branch arm of a COLLECTION-valued `if` delivers the null sentinel (loft#936).
//
// `if n == 0 { null } else { [n] }` answered a GARBAGE `DbRef` on `--interpret`: the
// `== null` test read `false`, the store-safety guard refused a free of an out-of-range
// store (`rec=` differed between runs, so the reference was uninitialised rather than
// stale), and one store leaked.  `--native` answered correctly, so the two backends
// disagreed.  Swapping the arms was enough to avoid it, which is what made the shape look
// cosmetic.
//
// Two independent faults met here, and the file pins both:
//
//  1. THE VALUE.  A branch arm parsed BEFORE its sibling has no type yet, so `parse_if`
//     back-patches it once the sibling names one.  That back-patch asked `null()` — the
//     helper that also supplies a VARIABLE's default-init, whose catch-all answers a bare
//     `Value::Null`.  For a scalar that is right; for a collection it pushes NOTHING,
//     where the branch join reads a 12-byte `DbRef`.  The join then read an uninitialised
//     slot as a live reference.  `null_value` (loft#793's `null_return`, renamed for the
//     position it serves) is the one that has an answer for the collection family, and the
//     merge is a value position exactly as a `return` is.  Arm ORDER decided it only
//     because the SECOND arm is parsed with the first one's type already in hand.
//
//  2. THE LEAK, which is separate and was there in BOTH orderings.  A collection return
//     source is a VIEW into a backing record (`vector<T>["__vdb_N"]`), and scope analysis
//     suppresses the backing var's free because the caller adopts that store.  That is
//     true only on the arm that delivers it: on the null arm the caller gets the sentinel
//     and the entry-allocated backing record is owned by nobody — one orphan per CALL.
//     `null_arm_record_sources` already routes exactly this runtime join for a RECORD
//     source through `OpFreeRefIfDistinct`; collections now take the same leg.  The
//     `store_nr` comparison is what makes it safe: a view shares its backing record's
//     store, so the delivering arm still transfers it untouched.
//
// The whole-suite leak gate (`SCRIPTS_LEAK_ALLOW`, empty) is what holds fault 2 — this
// file leaked 1 store per call before the fix, so `many_calls_do_not_accumulate_stores`
// below would exhaust the 65,535-slot store table rather than merely report.

fn maybe_null_first(n: integer) -> vector<integer>? {
  if n == 0 { null } else { [n] }
}

fn maybe_null_last(n: integer) -> vector<integer>? {
  if n != 0 { [n] } else { null }
}

fn maybe_chain(n: integer) -> vector<integer>? {
  if n == 0 { null } else if n == 1 { null } else { [n] }
}

fn maybe_match_null_first(n: integer) -> vector<integer>? {
  match n { 0 => null, _ => [n] }
}

fn maybe_match_null_last(n: integer) -> vector<integer>? {
  match n { 5 => [n], _ => null }
}

// The four spellings of the same decision must agree — the filed defect was that they
// did NOT, and only the one whose `null` came first was wrong.
fn nc_null_arm_answers_null() {
  assert(maybe_null_first(0) == null, "if, null arm first");
  assert(maybe_null_last(0) == null, "if, null arm last");
  assert(maybe_chain(0) == null, "else-if chain, first arm");
  assert(maybe_chain(1) == null, "else-if chain, middle arm");
  assert(maybe_match_null_first(0) == null, "match, null arm first");
  assert(maybe_match_null_last(0) == null, "match, null arm last");
}

// The other arm still delivers its value: a fix that answered null everywhere would pass
// the block above and be useless.
fn nc_value_arm_still_delivers() {
  a = maybe_null_first(7) ?? [];
  assert(len(a) == 1, "null-first: value arm length");
  assert(a[0] == 7, "null-first: value arm element");

  b = maybe_null_last(8) ?? [];
  assert(len(b) == 1, "null-last: value arm length");
  assert(b[0] == 8, "null-last: value arm element");

  c = maybe_chain(9) ?? [];
  assert(len(c) == 1, "chain: value arm length");
  assert(c[0] == 9, "chain: value arm element");

  d = maybe_match_null_first(3) ?? [];
  assert(len(d) == 1, "match: value arm length");
  assert(d[0] == 3, "match: value arm element");
}

// The second face of the same back-patch, which the issue did not name: the `if` bound
// to a LOCAL rather than returned.  It answered `false` with no guard report and no leak
// warning at all — a silently wrong value, which is worse than the reported one.
fn nc_local_bind_reads_null() {
  n = 0;
  x: vector<integer>? = if n == 0 { null } else { [n] };
  assert(x == null, "local bind, null arm first");

  m = 4;
  y: vector<integer>? = if m == 0 { null } else { [m] };
  assert(y != null, "local bind, value arm");
  assert(len(y ?? []) == 1, "local bind, value arm length");
}

// Fault 2's shape: the orphan is per CALL, so it is invisible at one call and fatal in a
// loop.  200 calls down the null arm held 200 stores before the fix, and the suite-wide
// leak gate is what reports it.
//
// The value-arm call is BOUND to a local rather than tested inline, and that is not
// incidental: `if f(i) != null` where `f -> vector<T>?` captures the unbound result in a
// per-comparison work-ref whose free is emitted once at SCOPE exit, so a loop overwrites
// the slot and orphans every earlier store.  That is a caller-side defect of its own
// (loft#938), present on released 2026.8.0, and this file must not stand on it — it pins
// the callee side.
fn nc_many_calls_do_not_accumulate_stores() {
  nulls = 0;
  values = 0;
  for i in 0..200 {
    if maybe_null_first(0) == null { nulls += 1; }
    if maybe_null_last(0) == null { nulls += 1; }
    if maybe_match_null_first(0) == null { nulls += 1; }
    v = maybe_null_first(i + 1);
    if v != null { values += 1; }
  }
  assert(nulls == 600, "every null-arm call answered null");
  assert(values == 200, "every value-arm call answered a vector");
}

// The scalar-heap and scalar controls: these were correct before the fix and must stay so,
// because `null_value` peels to `null()` for everything outside the collection family.
fn nc_scalar_returns_are_unchanged() {
  assert(text_or_null(0) == null, "text?, null arm first");
  assert(text_or_null(1) == "x", "text?, value arm");
  assert(int_or_null(0) == null, "integer?, null arm first");
  assert(int_or_null(5) == 5, "integer?, value arm");
}

fn text_or_null(n: integer) -> text? {
  if n == 0 { null } else { "x" }
}

fn int_or_null(n: integer) -> integer? {
  if n == 0 { null } else { n }
}

fn main() {
  nc_null_arm_answers_null();
  nc_value_arm_still_delivers();
  nc_local_bind_reads_null();
  nc_many_calls_do_not_accumulate_stores();
  nc_scalar_returns_are_unchanged();
  println("936 ok");
}
