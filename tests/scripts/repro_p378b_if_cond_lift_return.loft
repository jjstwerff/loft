//
// @P378(b) regression — a heap-returning function whose tail is
// `if <condition that lifts a ref-temp> { … } else { … }` returned the null
// DbRef sentinel under --native (panic at src/keys.rs:251 in the caller),
// because the condition's `__lift_N = call()` hoist pushed the if/else out of
// the enclosing Return, so scopes emitted Return(Null).  Interpret read the
// value off eval-stack-top (worked); native dropped it.  Fixed by preserving
// Return(If(...)): the condition is evaluated to a bool temp and the lift is
// freed BEFORE the `return if (bool_tmp) {…} else {…}`.
// vector (not hash) keeps this distinct from the keyed @P378(a) crash.

struct Ent { q: integer, r: integer }
struct Bag { items: vector<Ent> }
fn bag_empty() -> Bag { Bag { items: [] } }
fn mk_ent(n: integer) -> Ent { Ent { q: n, r: n } }

// the if-CONDITION calls a struct-returning fn → lifts a ref-temp.
fn pick(n: integer) -> Bag {
  if mk_ent(n).q == 0 { bag_empty() } else { bag_empty() }
}

fn main() {
  b1 = pick(1);
  assert(len(b1.items) == 0, "P378b: pick(1) returned a valid Bag (len={len(b1.items)})");
  b0 = pick(0);
  assert(len(b0.items) == 0, "P378b: pick(0) returned a valid Bag (len={len(b0.items)})");
  print("ok");
}
