// loft#1036 — a `vector<integer limit(lo, hi)>` element must store at the width its
// RANGE needs, exactly as the `size(N)` alias spelling of the same range does.
//
// formal/layout.md settles which width: (L-Narrow) stores a range-annotated integer in
// the smallest width that holds its range, and (L-Ref) makes a collection's element
// stride `width(element)` — so the two spellings are ONE layout, not two.  While the
// stride + schema were keyed on `size(N)` alone, the element READ already decoded 1 byte
// plus the `- min` offset, so every element of a non-zero-`lo` range read back exactly
// `lo` too high (12 stored → 22 returned) while a struct FIELD of the identical type was
// correct.  The whole-vector render read the OTHER layout and printed the raw slot.
type Small = integer limit(10, 255) size(1);

struct Field { f: integer limit(10, 255) }
struct Holder { xs: vector<integer limit(10, 255)> }

fn main() {
  // The element read, at both ends of the range and at index 0 (where a stride
  // mismatch hides — every following index is where it shows).
  a: vector<integer limit(10, 255)> = [12, 200, 10];
  assert(a[0] == 12 && a[1] == 200 && a[2] == 10, "limit element round-trip");
  assert(len(a) == 3, "limit element count");

  // The whole-vector render walks the SCHEMA, so it is the other half of the layout:
  // it and the element read have to answer the same value.
  assert("{a}" == "[12,200,10]", "limit vector renders through the schema");

  // The claim of the fix: the `limit(...)` and `size(N)` spellings of one range agree.
  s: vector<Small> = [12, 200, 10];
  assert("{s}" == "{a}", "limit spelling == size(N) alias spelling");
  assert(s[0] == a[0] && s[1] == a[1] && s[2] == a[2], "both spellings read alike");

  // lo == 0 is the spelling that always looked fine (the offset is the identity).
  b: vector<integer limit(0, 255)> = [0, 255];
  assert(b[0] == 0 && b[1] == 255 && "{b}" == "[0,255]", "lo == 0 element");

  // A range needing 2 bytes, and one needing the wide 8 (unchanged).
  c: vector<integer limit(10, 1000)> = [10, 999];
  assert(c[0] == 10 && c[1] == 999 && "{c}" == "[10,999]", "2-byte range element");
  d: vector<integer limit(0, 70000)> = [69995, 3];
  assert(d[0] == 69995 && d[1] == 3 && "{d}" == "[69995,3]", "wide range element");

  // Regressions: the plain and alias spellings keep their storage.
  e: vector<integer> = [12, -7];
  assert(e[0] == 12 && e[1] == -7 && "{e}" == "[12,-7]", "plain integer element");
  g: vector<u8> = [12, 255];
  h: vector<i16> = [-30000, 30000];
  assert("{g}" == "[12,255]" && "{h}" == "[-30000,30000]", "alias elements");

  // A FIELD of the same type was always correct — it must stay so — and a struct
  // holding such a vector takes the same element layout as a local does.
  k = Field {}; k.f = 12;
  assert(k.f == 12, "field of the same range");
  m = Holder { xs: [12, 200] };
  assert(m.xs[0] == 12 && m.xs[1] == 200 && "{m.xs}" == "[12,200]", "vector field of a struct");

  // Append, element assignment, slice and iteration all walk the same stride.
  a += [77];
  a[0] = 250;
  assert("{a}" == "[250,200,10,77]", "append + element assignment");
  n = a[1..3];
  assert("{n}" == "[200,10]", "slice keeps the element width");
  t = 0;
  for x in a { t += x; }
  assert(t == 537, "iteration reads the stored elements");
}
