//
// @PLN102 arc-E E2 Tier-0: accessing a field of a NULL struct reference must
// yield the field type's null (read) or silently drop (write) — never crash.
// Before the fix, a field read/write on a `T? = null` receiver reached
// `store()`/`store_mut()` with the null sentinel `store_nr` (65535) and panicked
// with an out-of-bounds `allocations` index on BOTH backends.  The scalar field
// ops (`OpGetText`/`OpGetSingle`/`OpGetFloat`/… and every `OpSet*`) now guard
// `rec == 0` exactly as `OpGetInt`/`OpGetCharacter` always have (C80: an absent
// value reads null / a write to it is a no-op).
//
// Null reads are checked by their RENDERED form (`"{f}" == "null"`) rather than
// `f == null`: a `field == null` literal check tangles with a separate static
// nullability-analysis issue (a non-nullable field typed `not null`), which is
// out of scope for this crash fix.  The write side asserts only *no crash* — the
// writes drop silently, and reaching the CONTROL section proves none panicked.

enum Color {
  Red,
  Green,
  Blue,
}
struct Inner {
  tag: text,
}
struct Wide {
  t: text,
  i: integer,
  f: float,
  s: single,
  b: boolean,
  col: Color,
  small: integer limit(0, 200),
  med: integer limit(0, 60000),
  inner: Inner?,
}

fn test() {
  // --- READ: every field kind of a null struct renders null, no crash ---
  w: Wide? = null;
  assert("{w.t}" == "null", "null-struct text field reads null");
  assert("{w.i}" == "null", "null-struct integer field reads null");
  assert("{w.f}" == "null", "null-struct float field reads null");
  assert("{w.s}" == "null", "null-struct single field reads null");
  assert("{w.b}" == "null", "null-struct boolean field reads null");
  assert("{w.col}" == "null", "null-struct enum field reads null");
  assert("{w.small}" == "null", "null-struct u8-limited field reads null");
  assert("{w.med}" == "null", "null-struct u16-limited field reads null");

  // nested read through a null receiver: `w.inner` is null, so `.tag` reads
  // through the null DbRef — must render null, not crash.
  assert("{w.inner.tag}" == "null", "nested field through null receiver reads null");

  // --- WRITE: writing a field of a null struct drops silently, no crash.
  //     Reaching the CONTROL section below proves none of these panicked. ---
  w.t = "hi";
  w.i = 42;
  w.f = 3.5;
  w.s = 1.0 as single;
  w.b = true;
  w.col = Color.Green;

  // --- CONTROL: a present struct still round-trips normally ---
  v: Wide? = Wide {
    t: "ok",
    i: 7,
    f: 1.0,
    s: 2.0 as single,
    b: false,
    col: Color.Blue,
    small: 9,
    med: 300,
    inner: null,
  };
  v.i = 99;
  assert(v.t == "ok", "present struct text field round-trips");
  assert(v.i == 99, "present struct integer field write round-trips");
  assert(v.col == Color.Blue, "present struct enum field round-trips");
  assert(v.med == 300, "present struct u16-limited field round-trips");
  assert(v.small == 9, "present struct u8-limited field round-trips");
}
