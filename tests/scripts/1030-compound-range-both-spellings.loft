//
// A compound assignment is bounded by the range its target DECLARES, whatever the
// spelling and whatever kind of target it is (loft#1030, loft#1031).
//
// `tests/scripts/1009-width-type-bounds.loft` is the sibling: it pins the narrow ALIAS
// spelling in a LOCAL.  Commit 447564a1 recorded two residuals it deliberately did not
// fold in, and these are those two:
//
//   loft#1030 — `integer limit(0,255)` reached no guard on the compound path, so it kept
//     260 where the `u8` spelling of that identical range clamped to 0.  The guard tested
//     `forced_size`, which only an ALIAS sets.  formal/types.md `(C-Int)` puts width
//     inside the conversion relation — "an integer flows into another integer iff its
//     range fits", no separate width authority — so the two spellings are one range and
//     a guard keyed on the spelling could only ever disagree with itself.
//
//   loft#1031 — a `u32` FIELD wrapped to 2^32-5 where the `u32` LOCAL beside it clamped
//     to 0.  The store layer bounds a field, but only at 1 and 2 bytes: `set_byte` and
//     `set_short` carry a `min` operand, while the 4-byte setters take no range and
//     truncate.  `i32` was wrong the same way; the issue only noticed `u32`.
//
// Both are now one guard on the COMPOSED value, at the one seam every compound assignment
// passes through before the store-op dispatch — so the local, the field and the element
// cannot disagree.  The cells are therefore written as triples: any fix that reaches one
// target kind and not the others fails here.
//
// Not covered, because they are not this: a `limit` element with a NON-ZERO `lo` reads
// back `lo` too high (loft#1036) and a `limit` span wider than 4 bytes cannot hold its own
// values (loft#1037).  Both are plain write-then-read with no arithmetic at all.

struct S1030 { a: integer limit(0,255), b: u32, c: i32, d: integer limit(0,70000) }

fn test_the_limit_spelling_bounds_a_compound_assignment() {
  // The filed cell: the two spellings of ONE range must agree.
  l: integer limit(0,255) = 250;
  l += 10;
  u: u8 = 250;
  u += 10;
  assert(l == 0, "a limit(0,255) local past 255, got {l}");
  assert(l == u, "limit(0,255) {l} and u8 {u} spell one range");

  // Under the low end, where `lo` is not zero — the default is the range's LOW end, so
  // this must not answer 0 and must not answer 7.
  m: integer limit(10,255) = 12;
  m -= 5;
  assert(m == 10, "a limit(10,255) local below 10, got {m}");

  // A range whose span needs four bytes: every target kind was wrong here before, so
  // this cell is the one that fails if the fix only reaches the local.
  w = S1030 { a: 0, b: 0, c: 0, d: 69995 };
  w.d += 10;
  n: integer limit(0,70000) = 69995;
  n += 10;
  assert(n == 0, "a limit(0,70000) local past 70000, got {n}");
  assert(w.d == 0, "a limit(0,70000) field past 70000, got {w.d}");
}

fn test_a_four_byte_alias_bounds_a_field_and_an_element() {
  // loft#1031: the local clamped and the field wrapped, for the same write.
  s = S1030 { a: 0, b: 5, c: 0, d: 0 };
  s.b -= 10;
  b: u32 = 5;
  b -= 10;
  assert(b == 0, "a u32 local below 0, got {b}");
  assert(s.b == 0, "a u32 field below 0, got {s.b}");
  assert(s.b == b, "u32 field {s.b} and local {b} agree");

  // The same at the top of the range.
  t = S1030 { a: 0, b: 4294967290, c: 0, d: 0 };
  t.b += 10;
  assert(t.b == 0, "a u32 field past 4294967295, got {t.b}");

  // `i32` is the other four-byte alias and wrapped in a field the same way; 447564a1
  // recorded a field answering `null` where the narrower four answer their minimum.
  // Clamping happens before the store now, so `i32::MIN` is never written and the two
  // positions agree.
  c = S1030 { a: 0, b: 0, c: 2147483647, d: 0 };
  c.c += 10;
  k: i32 = 2147483647;
  k += 10;
  assert(k == -2147483647, "an i32 local past 2147483647, got {k}");
  assert(c.c == -2147483647, "an i32 field past 2147483647, got {c.c}");
  assert(c.c == k, "i32 field {c.c} and local {k} agree");

  // A vector ELEMENT is the third target kind, which neither issue named.
  v: vector<u32> = [5];
  v[0] -= 10;
  assert(v[0] == 0, "a u32 element below 0, got {v[0]}");
}

fn test_the_narrower_aliases_are_unchanged() {
  // The four that already agreed in both positions.  They are here as the control: a fix
  // that moved them would be changing settled behaviour, not closing a gap.
  a = S1030 { a: 250, b: 0, c: 0, d: 0 };
  a.a += 10;
  assert(a.a == 0, "a u8 field past 255, got {a.a}");

  e: i8 = 120;   e += 10;    assert(e == -128, "an i8 past 127, got {e}");
  f: u16 = 65530; f += 10;   assert(f == 0, "a u16 past 65535, got {f}");
  g: i16 = 32760; g += 10;   assert(g == -32768, "an i16 past 32767, got {g}");
}

fn test_in_range_arithmetic_is_untouched() {
  // The guard fires on the VALUE, so everything inside the range is unaffected — in every
  // spelling and every target kind.
  l: integer limit(0,255) = 100;  l += 10;   assert(l == 110, "in-range limit local, got {l}");
  b: u32 = 100;                   b += 10;   assert(b == 110, "in-range u32 local, got {b}");
  s = S1030 { a: 100, b: 100, c: 100, d: 100 };
  s.a += 10;  s.b += 10;  s.c += 10;
  assert(s.a == 110, "in-range u8 field, got {s.a}");
  assert(s.b == 110, "in-range u32 field, got {s.b}");
  assert(s.c == 110, "in-range i32 field, got {s.c}");
  v: vector<u32> = [100];  v[0] += 10;  assert(v[0] == 110, "in-range u32 element, got {v[0]}");
}

fn test_plain_integer_is_still_not_clamped() {
  // The negative control, carried over from 1009: plain `integer` is EIGHT bytes and
  // declares no range, so it must keep running past the 4-byte one.  Without this cell a
  // guard that clamped every integer would satisfy every assertion above.
  p: integer = 2147483647;
  p += 1;
  assert(p == 2147483648, "a plain integer local is not clamped, got {p}");

  q: integer = 5000000000;
  q += 1;
  assert(q == 5000000001, "and stays past the 4-byte range, got {q}");
}
