//
// Worked examples for stdlib text functions (@PLN141).  Each test is a
// real, runnable use of a function whose correct call shape is NOT obvious
// from its signature — the kind of function a reader (often an AI agent)
// knows exists yet cannot use without seeing it in action.  The function's
// doc comment in default/03_text.loft cites the tag here via
// `// Example: @STD-00N`, and `scripts/check_doc_drift.sh examples` fails
// if a citation goes dangling (no test carries the tag).

// @STD-001 — is a token present at a given BYTE offset? (scanner idiom)
fn test_starts_with_at_scans_a_token() {
  line = "  let x = 5";
  // starts_with_at asks "does `prefix` sit at byte `pos`?" without slicing.
  assert(line.starts_with_at(2, "let"), "'let' begins at byte 2");
  assert(!line.starts_with_at(0, "let"), "byte 0 is a space, not 'let'");
  // Past the end is false, never an error.
  assert(!line.starts_with_at(20, "five"), "past the end is false, not a crash");
}

// @STD-002 — build text from a Unicode CODE POINT (decode an escape / entity)
fn test_chr_builds_text_from_a_code_point() {
  // chr is the inverse of `ch as integer`: a number in, its character out.
  assert(chr(65) == "A", "U+0041 is 'A'");
  assert(chr(233) == "é", "U+00E9 is e-acute");
  assert(chr(20013) == "中", "U+4E2D");
  // A code point that names no character yields the empty text, never a crash.
  assert(chr(-1) == "", "negative code point is empty text");
}

// @STD-003 — join vector<text> with a separator (build a delimited line)
fn test_join_builds_a_delimited_line() {
  parts: vector<text> = ["usr", "local", "bin"];
  assert(parts.join("/") == "usr/local/bin", "path segments joined by '/'");
  empty: vector<text> = [];
  assert(empty.join(",") == "", "empty vector joins to empty text");
}

// @STD-004 — smallest / largest of a vector, NULL when empty (guard with ??)
fn test_min_of_max_of_are_null_on_empty() {
  v: vector<integer> = [3, 1, 4, 1, 5];
  assert((min_of(v) ?? 0) == 1, "min of a non-empty vector");
  assert((max_of(v) ?? 0) == 5, "max of a non-empty vector");
  // Empty is NOT zero — it is null, so choose the fallback explicitly with ??.
  empty: vector<integer> = [];
  assert((min_of(empty) ?? -1) == -1, "min of empty is null → the ?? fallback");
}

// @STD-005 — sum with a caller-supplied identity (works for any Addable type)
fn test_sum_takes_an_identity() {
  ints: vector<integer> = [10, 20, 12];
  assert(sum(ints, 0) == 42, "integer sum starts from the 0 identity");
  // The identity fixes the element type AND the empty-vector answer.
  floats: vector<float> = [1.5, 2.5];
  assert(sum(floats, 0.0) == 4.0, "float sum starts from 0.0");
  none: vector<integer> = [];
  assert(sum(none, 0) == 0, "empty sum is the identity");
}
