// Compile-time error detection tests — the PASS-2 half.
//
// `Parser::parse` runs pass 2 only when pass 1 finished clean, and every diagnostic here
// is emitted by `!first_pass` code.  A single pass-1 error in this file would silence all
// of them and their annotations would assert nothing — which is exactly what happened for
// 24 of them (loft#929).  The pass-1 errors that used to share this file live in
// 36b-pass1-parse-errors.loft.  Keep the split: nothing here may report during pass 1.

// --- Argument / return / branch type errors ---
//
// The message shape is `expected <wanted>, got <actual> on <where>` — it names the type
// that arrived, which the older "should be <wanted> on <where>" wording did not.

// @EXPECT_ERROR: expected integer, got boolean on argument 1 of call to pe_def
fn test_wrong_parameter() {
  pe_def(true);
}
fn pe_def(i: integer) {}

// @EXPECT_ERROR: expected integer, got text on return
fn pe_wrong_ret(a: integer) -> integer {
  if a > 4 { return "a" }
  2
}

// @EXPECT_ERROR: Expect expression after return
fn pe_empty_ret(a: integer) -> integer {
  if a > 4 { return }
  1
}

// @EXPECT_ERROR: expected integer, got text on else
fn test_wrong_if() {
  if 1 > 0 { 2 } else { "a" };
}

// --- Unknown names ---

// @EXPECT_ERROR: Unknown variable 'a'
fn test_unknown_var() {
  a == 1;
}

// @EXPECT_ERROR: Unknown variable 'cound'
fn test_typo_var_name() {
  count = 0;
  cound + 1;
}

// @EXPECT_ERROR: Unknown variable 'a'
fn test_use_before_define() {
  if a == 1 { panic("x"); }
  a = 1;
}

enum PEType {
  PEV1,
}

// @EXPECT_ERROR: Unknown cast
fn test_wrong_cast() {
  PEType.PEV1 as float;
}

// --- Boolean/enum argument errors ---

enum PEEType {
  PEVal,
}
enum PENext {
  PEVal2,
}

// @EXPECT_ERROR: expected PEEType, got boolean on argument 1 of call to pe_typed_fn
fn test_wrong_boolean() {
  pe_typed_fn(true);
}
fn pe_typed_fn(t: PEEType) {}

// @EXPECT_ERROR: expected PENext, got PEEType on argument 1 of call to pe_next_fn
fn test_mixed_enums() {
  pe_next_fn(PEEType.PEVal);
}
fn pe_next_fn(v: PENext) -> PENext {
  v
}

// --- Key errors ---

struct PEKeyT {
  n: text,
  v: u16,
}
struct PEKeyN {
  d: vector<PEKeyT>,
  h: hash<PEKeyT[n]>,
}

// @EXPECT_ERROR: Cannot write to key field
fn test_key_field() {
  s = PEKeyN { d: [
    PEKeyT { n: "a", v: 12 },
  ] };
  s.d[0].v = 13;
  s.d[0].n = "b";
}

// An undefined name on the right of a comparison earns NO diagnostic of its own: the
// only thing reported is the arity check that fires downstream, and it names an internal
// opcode and a parameter the program never wrote.  Nothing says `PEUnknown`.  Pinned as
// it stands so the wording cannot rot unnoticed, and filed as loft#934 — the fix is a
// root report naming the name, with this line suppressed as its cascade.
// @EXPECT_ERROR: missing argument for parameter 'v1' of `OpLtInt`
fn test_undefined_enum() {
  v: PEEType = PEVal;
  v > PEUnknown;
}

// `sizeof` needs a variable or a type name — two ways to get that wrong, and only the
// empty one used to report.  A name still unresolved after pass 2 is a typo (a real
// forward reference resolves and gets its size), but it was accepted silently and
// `sizeof` answered `null` (loft#933).
// @EXPECT_ERROR: Expect a variable or type after sizeof
fn test_unknown_sizeof() {
  sizeof();
}

// @EXPECT_ERROR: Undefined type PEUnknownType — sizeof needs a variable or a declared type
fn test_sizeof_undeclared_name() {
  sizeof(PEUnknownType);
}

// `type_name` reads its argument the same way and was silent in the same case, rendering
// `null` as if that were the name of a type.
// @EXPECT_ERROR: Undefined type PEUnknownName — type_name needs a variable or a declared type
fn test_type_name_undeclared_name() {
  type_name(PEUnknownName);
}

// --- Loop mutation guards ---

// @EXPECT_ERROR: Cannot add elements
fn test_add_to_iterated_vector() {
  v = [1, 2, 3];
  for _e in v { v += [4]; }
}

// @EXPECT_ERROR: Cannot add elements
fn test_add_to_outer_loop() {
  v = [1, 2, 3];
  for _e in v {
    for n in 1..3 { v += [n]; }
  }
}

// --- If-expression errors ---

// @EXPECT_ERROR: If-expression produces a value but has no else
fn test_if_expr_without_else() {
  x = if true { 42 };
  println("{x}");
}

// --- Yield inside par() rejected (P2-R6) ---

fn pe_par_double(pe_x: integer) -> integer {
  pe_x * 2
}

// @EXPECT_ERROR: yield is not allowed inside a par
fn pe_yield_in_par(items: vector<integer>) -> iterator < integer > {
  for pe_a in items par(pe_b = pe_par_double(pe_a), 1) { yield pe_b; }
}

// --- Partial-key null assignment ---

struct PEIdxElm {
  pe_id: integer,
  pe_cat: text,
  pe_score: integer,
}
struct PEIdxDb {
  pe_map: index<PEIdxElm[pe_id, -pe_cat]>,
}

// Two diagnostics, one statement: the assignment is refused, and the partial-key READ
// it was written against is separately named as a for-loop iterator rather than a value.
// @EXPECT_ERROR: Cannot assign null to a partial-key lookup
// @EXPECT_ERROR: a keyed partial-key match is a `for`-loop iterator, not a value
fn test_partial_key_null_assign() {
  db = PEIdxDb { pe_map: [
    PEIdxElm { pe_id: 1, pe_cat: "a", pe_score: 10 },
  ] };
  db.pe_map[1] = null;
}

// --- L4: literal passed to & parameter ---

fn pe_ref_fill(pe_rv: &vector<integer>) {
  pe_rv += [1];
}

// @EXPECT_ERROR: Cannot pass a literal or expression to a '&' parameter
fn test_literal_to_ref_param() {
  pe_ref_fill([]);
}

// --- P85c: struct / enum / named fn inside a function body ---

// @EXPECT_ERROR: 'struct' definitions must be at file scope
fn test_p85c_struct_inside_fn() {
  struct PeInner {
    pe_v: integer,
  }
  pe_x = 5;
}

// @EXPECT_ERROR: 'enum' definitions must be at file scope
fn test_p85c_enum_inside_fn() {
  enum PeInner {
    PeA,
    PeB,
  }
  pe_x = 5;
}

// @EXPECT_ERROR: 'fn' definitions must be at file scope
fn test_p85c_named_fn_inside_fn() {
  fn pe_inner() -> integer {
    5
  }
  pe_x = 5;
}

// Regression: lambda expressions must NOT trigger the file-scope diagnostic.
fn test_p85c_lambda_still_works() {
  pe_f = fn(x: integer) -> integer {
    x * 2
  };
  assert(pe_f(5) == 10, "lambda works inside fn");
}

// --- Parallel for-loop clause errors ---

fn pe_double(x: integer) -> integer {
  return x * 2;
}
struct PeParS {
  a: integer,
}

// @P270 regression: par() error recovery used to hang the parser —
// skip_to_parallel_body looped forever on the `,` it could not consume.
// A non-iterable par input drains through that recovery path (the remaining
// `, 2)` tokens), so this both pins the diagnostic AND guards against the
// hang (a regressed guard would time the suite out here).  Ranges and other
// iterables are now materialised and run, so they are NOT errors — covered
// by tests/scripts/22c-par-sources.loft.
// A second diagnostic follows the refusal: `s` is not iterable, so the loop variable `x`
// never gets a type and the body's `x.a` reads an unresolved name.
// @EXPECT_ERROR: par(...) requires a vector
// @EXPECT_ERROR: Unknown variable 'x'
fn test_par_over_non_iterable() {
  s = PeParS { a: 1 };
  for x in s par(r = pe_double(x.a), 2) { print("{r}"); }
}

// A par worker returning a CAPTURING closure is rejected with a clear message
// (the captured state can't cross the thread boundary) instead of the raw
// dangling-ref panic.  A non-capturing fn-ref return is fine (see 22c).
fn pe_capturing(x: integer) -> fn(integer) -> integer {
  return fn(n: integer) -> integer {
    return n + x;
  };
}
// The refusal is the first line; the body's `f(10)` then reads a worker binding that was
// never established, which is the cascade.
// @EXPECT_ERROR: cannot return a capturing closure
// @EXPECT_ERROR: Field of unknown variable
fn test_par_capturing_closure() {
  for i in 0..3 par(f = pe_capturing(i), 2) { print("{f(10)}"); }
}
