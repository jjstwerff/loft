// P58: Variables with unknown type (typos) should be detected at compile time.
// One mistake earns one diagnostic: the name is what the reader mistyped, so
// `Unknown variable` is the whole report — there is no second "unknown type"
// line naming the variable it was assigned to.
// @EXPECT_ERROR: Unknown variable 'unknown_thing'

fn test_p58_typo_detected() {
  y = unknown_thing;
}
