//
// @PLAN37 phase 10.12 — module-scope `const vector<T>` must
// work under both backends.  Pre-fix `--native` (the default)
// crashed at `stores.const_refs[<d_nr>]` because
// `output_native` skipped `emit_const_vectors`; only
// `output_native_reachable` (`--native-release`) called it.
// @P275.

const NUMS: vector<integer> = [10, 20, 30];
const TAGS: vector<text> = ["alpha", "beta", "gamma"];
// vector<float> iteration is blocked by a separate bug (@P284 —
// for-loop over `vector<float>` doesn't terminate, applies to both
// const and local).  Re-add a `const FLOATS` case once @P284 lands.

fn test_int_const() {
  sum = 0;
  for n in NUMS { sum += n; }
  assert(sum == 60, "sum of NUMS");
  assert(NUMS.len() == 3, "NUMS length");
  assert(NUMS[0] == 10, "NUMS[0]");
  assert(NUMS[2] == 30, "NUMS[2]");
}

fn test_text_const() {
  joined = "";
  for t in TAGS { joined = joined + t; }
  assert(joined == "alphabetagamma", "concat TAGS");
  assert(TAGS.len() == 3, "TAGS length");
  assert(TAGS[1] == "beta", "TAGS[1]");
}

fn main() {
  test_int_const();
  test_text_const();
  println("const-vector: ok");
}
