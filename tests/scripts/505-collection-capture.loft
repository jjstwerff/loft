//
// @PLN93 (#511) — a bare collection (hash / vector / sorted / index) captured into a
// closure is BORROWED as a shared 12-byte DbRef (the same representation a captured
// struct Reference uses), so the closure can look up elements by key / index and read
// them.  The outer scope keeps sole ownership (Parts::DbRef is a non-owning leaf).
//
// Scope of this phase: READ / LOOKUP only.  Mutation and iteration through a bare
// capture are rejected at parse time (see 506-collection-capture-errors.loft) — a
// capture is read-only, and iteration has an unfixed native-codegen defect.  Mutating
// a collection WRAPPED IN A STRUCT field works (a struct capture is an lvalue) and is
// guarded here too.  Runs on BOTH backends.

struct K { id: integer, v: integer }

fn c0(cb: fn() -> integer) -> integer { cb() }
fn c1(cb: fn(integer) -> integer, a: integer) -> integer { cb(a) }

fn test_hash_lookup() {
  h: hash<K[id]> = [];
  h += K { id: 1, v: 42 };
  h += K { id: 2, v: 99 };
  assert(c1(fn(k: integer) -> integer { (h[k] ?? K { id: 0, v: 0 }).v }, 1) == 42, "hash[1]");
  assert(c1(fn(k: integer) -> integer { (h[k] ?? K { id: 0, v: 0 }).v }, 2) == 99, "hash[2]");
  assert(c1(fn(k: integer) -> integer { (h[k] ?? K { id: 0, v: 0 }).v }, 9) == 0, "hash miss");
}

fn test_vector_lookup() {
  xs: vector<integer> = [10, 20, 30];
  assert(c1(fn(i: integer) -> integer { xs[i] ?? -1 }, 0) == 10, "vec[0]");
  assert(c1(fn(i: integer) -> integer { xs[i] ?? -1 }, 2) == 30, "vec[2]");
}

fn test_sorted_index_lookup() {
  s: sorted<K[id]> = [];
  s += K { id: 3, v: 30 };
  s += K { id: 1, v: 10 };
  assert(c1(fn(k: integer) -> integer { (s[k] ?? K { id: 0, v: 0 }).v }, 3) == 30, "sorted[3]");
  idx: index<K[id]> = [];
  idx += K { id: 8, v: 80 };
  assert(c1(fn(k: integer) -> integer { (idx[k] ?? K { id: 0, v: 0 }).v }, 8) == 80, "index[8]");
}

fn test_multi_capture() {
  base = 100;
  h: hash<K[id]> = [];
  h += K { id: 1, v: 7 };
  // capture a scalar AND a collection in the same closure
  assert(c0(fn() -> integer { base + (h[1] ?? K { id: 0, v: 0 }).v }) == 107, "scalar + hash capture");
}

// Guard: mutating a collection that lives in a STRUCT FIELD (a struct capture is an
// lvalue) works through the capture — the event-loop pattern that serves a bound store.
struct State { tiles: hash<K[id]>, hits: integer }
fn run(n: integer, cb: fn(integer) -> integer) -> integer {
  tot = 0;
  for i in 0..n { tot = tot + cb(i); }
  tot
}
fn test_struct_field_mutation_through() {
  st = State { tiles: [], hits: 0 };
  st.tiles += K { id: 2, v: 200 };
  st.tiles += K { id: 5, v: 500 };
  got = run(7, fn(i: integer) -> integer {
    st.hits = st.hits + 1;
    (st.tiles[i] ?? K { id: 0, v: 0 }).v
  });
  assert(got == 700, "struct-field capture sum={got} (expect 700 — keys 2,5)");
  assert(st.hits == 7, "struct-field mutation-through hits={st.hits} (expect 7)");
}

fn main() {
  test_hash_lookup();
  test_vector_lookup();
  test_sorted_index_lookup();
  test_multi_capture();
  test_struct_field_mutation_through();
  println("505 collection-capture (lookup) ok\n");
}
