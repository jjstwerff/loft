//
// @PLN130 F2 — a view whose container is RESHAPED while it is live is materialised.
//
// `remove` renumbers the positions inside a vector's store, and an element view is a `DbRef`
// pinned to a position — so a view live across one silently started naming a different
// element. A pure READ answered `44/444` where its element held `33/333`, and a write tore a
// live record (`99/444`: n from the stray write, tag from the real element). Nothing saw it:
// no store is freed and the pointer stays valid, so no leak or UAF detector could fire.
//
// Ownership information cannot fix that — the defect is identity, not who frees. The binding
// gets its own copy instead, and the author is told (`advice: … was copied out of …`),
// because the alias it asked for is genuinely gone.
//
// The other half of the contract is asserted here too: a view in a function that never
// reshapes KEEPS its alias and still writes through. That is the documented `c = v[i]`
// behaviour (loft#774) and the fix must not take it away.

struct Box { n: integer, tag: integer = 0 }

fn reshaped() -> integer {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
  c = boxes[2];
  boxes.remove(0);
  boxes += [Box { n: 44, tag: 444 }];
  c.n = 99;
  // `c` is an independent copy of the element it named: it kept 333, took the write, and
  // the container is intact — in particular the appended element is NOT torn.
  assert(c.n == 99 && c.tag == 333, "145 c {c.n}/{c.tag} want 99/333");
  assert(len(boxes) == 3, "145 len {len(boxes)} want 3");
  assert(boxes[0].n == 22 && boxes[0].tag == 222, "145 e0 {boxes[0].n}/{boxes[0].tag} want 22/222");
  assert(boxes[1].n == 33 && boxes[1].tag == 333, "145 e1 {boxes[1].n}/{boxes[1].tag} want 33/333");
  assert(boxes[2].n == 44 && boxes[2].tag == 444, "145 e2 {boxes[2].n}/{boxes[2].tag} want 44/444");
  return boxes[2].n;
}

// The in-loop `#remove` spelling is the same reshape.
fn reshaped_loop() -> integer {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
  c = boxes[2];
  for b in boxes {
    if b.n == 11 {
      b#remove;
    }
  }
  c.n = 99;
  assert(len(boxes) == 2, "145 loop len {len(boxes)} want 2");
  assert(boxes[1].n == 33, "145 loop e1 {boxes[1].n} want 33");
  assert(c.n == 99 && c.tag == 333, "145 loop c {c.n}/{c.tag} want 99/333");
  return boxes[1].n;
}

// A view several levels down is reached by peeling the whole accessor chain.
fn reshaped_nested() -> integer {
  outs = [Box { n: 1 }, Box { n: 2 }, Box { n: 3 }];
  w = outs[2];
  outs.remove(0);
  w.n = 99;
  assert(len(outs) == 2, "145 nested len {len(outs)} want 2");
  assert(outs[1].n == 3, "145 nested e1 {outs[1].n} want 3");
  assert(w.n == 99, "145 nested w {w.n} want 99");
  return outs[1].n;
}

// NO reshape in this function: the view keeps its dep and still writes through.
fn not_reshaped() -> integer {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }];
  c = boxes[1];
  c.n = 99;
  assert(boxes[1].n == 99, "145 alias boxes[1].n {boxes[1].n} want 99 (alias must survive)");
  return boxes[1].n;
}

fn main() {
  assert(reshaped() == 44, "145 reshaped");
  assert(reshaped_loop() == 33, "145 reshaped_loop");
  assert(reshaped_nested() == 3, "145 reshaped_nested");
  assert(not_reshaped() == 99, "145 not_reshaped");
  println("145 PASSED");
}
