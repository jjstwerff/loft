//
// @PLN153 phase 1 — the HOLD half of every N rule's pair, in one program: each cell is the
// rule's own example, asserting the VALUE `types.md` promises.  The REFUSE halves are the
// `153-n-*-refused*.loft` files beside this one, because a refusal is a per-file
// expectation.  A rule with a cell here and a cell there has a measured pair, which is what
// its `@FR-N-*` citation at its home waits for; a rule with only a citation would be the
// B6u failure and does not count.
//
// @falsified-at: none — pins rules the compiler already keeps; every cell was measured
//   against the rule's own text on both backends before the citation was added.
struct P { n: integer }
enum E { A, B }

fn div(a: integer, b: integer) -> integer? { return a / b; }     // N-Div: `/` types integer?
fn add(a: integer, b: integer) -> integer { return a + b; }      // N-Arith: non-null in, non-null out
fn prop(n: integer?) -> integer? { return n + 5; }               // N-Prop: null rides through
fn coal(n: integer?) -> integer { return n ?? -1; }              // N-Coal: discharged to integer
fn dflt(n: integer?) -> integer { return n?; }                   // N-Default: the type's own default
fn mtch(n: integer?) -> integer { match n { null => { return -7; }, x => { return x * 2; } } }  // N-Match
fn intro(x: integer) -> integer? { return x; }                    // N-Intro: τ ⤳ τ?
fn dom(y: float) -> float? { return sqrt(y); }                    // N-Domain: partial op types τ?

fn main() {
  // N-Opt — every type kind admits `?` and holds null.
  a: integer? = null; b: u8? = null; c: float? = null; d: boolean? = null; e: character? = null;
  t: text? = null; p: P? = null; v: vector<integer>? = null;
  assert(a == null && b == null && c == null && d == null && e == null && t == null && p == null && v == null, "N-Opt: every ? holds null");

  // N-Dense — a vector<τ> element is non-null; a vector<τ?> element may be null.
  dv: vector<integer> = [1, 2];
  nv: vector<integer?> = [1, null];
  assert(dv[1] == 2 && nv[1] == null, "N-Dense: dense reads its value, nullable holds absence");

  // N-Index — out of bounds is null, not a fault.
  assert(dv[9] == null, "N-Index: OOB is null");

  // N-Div — divide by zero is null; a provably non-zero divisor stays non-null typed.
  assert(div(7, 0) == null && div(7, 2) == 3, "N-Div: ÷0 null, otherwise the quotient");
  q: integer = 9 / 3;
  assert(q == 3, "N-Div: provably non-zero divisor types integer");

  // N-Arith — non-null operands give a non-null result.
  assert(add(2, 3) == 5, "N-Arith");

  // N-Prop — null propagates through arithmetic.
  assert(prop(null) == null && prop(4) == 9, "N-Prop");

  // N-Cast / N-Cast? / N-Parse — assertion cast vs checked cast.
  assert(("12" as integer ?? 0) == 12, "N-Cast: the assert-or-default form is the licensed bare parse (types.md:325)");
  assert(("x" as integer?) == null && (300 as u8?) == null && (7 as u8?) == 7, "N-Cast?: checked cast is null when it does not fit");

  // N-Coal / N-Default / N-Match — the three discharges.
  assert(coal(null) == -1 && coal(5) == 5, "N-Coal");
  assert(dflt(null) == 0 && dflt(5) == 5, "N-Default: integer's default is 0");
  assert(mtch(null) == -7 && mtch(5) == 10, "N-Match");

  // N-Intro — τ into τ? is silent.
  assert(intro(4) == 4, "N-Intro");

  // N-Join — an inferred local widens to optional across assignments.  The index is a
  // plain local, not a constant: a constant index is trusted by contract (@PLN102 D1) and
  // reads non-null, so `j = dv[9]` never widened anything and the assert below passed on
  // the in-band sentinel alone.  With `ix` the write is a `τ?`, which a DECLARED `integer`
  // reports and an inferred one absorbs — so this line compiling at all is the receipt.
  ix = 9;
  j = 2; j = dv[ix];
  assert(j == null, "N-Join: inferred local widened to integer?");

  // N-Domain — sqrt of a negative is null, of a square is its root.
  assert(dom(-1.0) == null && dom(9.0) == 3.0, "N-Domain");

  // N-Reserve — a nullable narrow alias reserves its top value for null (u8? holds 254, not 255).
  r: u8? = 254;
  assert(r == 254, "N-Reserve: 254 is a value");

  println("n rules hold");
}
