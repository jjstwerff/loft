//
// Regression: a struct field whose type is declared LATER in the file made a
// correctly-typed assignment fail — "Cannot assign ref(T) to field S.f of type
// unknown(N)", the two sides being the same type (loft#661, both backends).
//
// `parse_field` stores a field's type on the FIRST pass only, and forward-reference
// stubs are not bound to their real definitions until `actual_types_deferred` runs
// at the END of that pass.  So for all of pass 1 the field reads as
// `Type::Unknown(stub)`.  The field-store check tolerated an unknown on the VALUE
// side (@P279) but not on the FIELD side, so it errored — and a pass-1 error aborts
// before pass 2, which re-checks against the now-resolved type and passes.
//
// Reordering cannot dodge this: two mutually-referential types mean whichever is
// declared first names the other before it exists.

// The filed shape — struct field of an enum declared after it.
struct F661Box { item: F661Thing }
enum F661Thing { F661Empty, F661Named { value: text } }

// A forward-declared STRUCT is the same defect (the filed scope said "enum").
struct F661Outer { inner: F661Inner }
struct F661Inner { value: text }

// Mutually referential: the entry struct names the enum, the enum names the entry.
struct F661Entry { key: text, val: F661Val }
enum F661Val { F661VNull, F661VStr { value: text }, F661VObj { entries: vector<F661Entry> } }

fn f661_mk() -> F661Thing { return F661Named { value: "x" }; }

fn f661_first_key(entries: vector<F661Entry>) -> text {
  for e in entries { return e.key; }
  return "NONE";
}

fn test_forward_declared_field_type() {
  t = f661_mk();
  b = F661Box { item: t };
  it = b.item;
  match it {
    F661Named { value } => { got = value; assert(got == "x", "forward enum field: {got}"); },
    _ => { assert(false, "wrong arm for a forward-declared enum field"); },
  };

  inner = F661Inner { value: "y" };
  o = F661Outer { inner: inner };
  assert(o.inner.value == "y", "forward struct field: {o.inner.value}");

  e = F661Entry { key: "k", val: F661VStr { value: "v" } };
  obj = F661VObj { entries: [e] };
  match obj {
    F661VObj { entries } => {
      assert(len(entries) == 1, "mutually-referential types: {len(entries)}");
      k = f661_first_key(entries);
      assert(k == "k", "entry key round-trips: {k}");
    },
    _ => { assert(false, "wrong arm for the object variant"); },
  };
}
