//
// loft#1385's controls — the shapes the refusal must NOT cross.  Its own cell is the
// `@EXPECT_ERROR` twin, `1385-a-group-cannot-hold-one-element-two-ways.loft`; a refusal is
// only as good as the programs it still accepts, and each of these differs from the refused
// one by exactly one thing.
//
// @falsified-at: none — every shape here compiled and answered the same before the refusal;
// this file exists to pin what the refusal must NOT reject, so it is INERT by construction and
// the falsifier says so.  Its defect twin is `1385-a-group-cannot-hold-one-element-two-ways`.
struct E { k: integer, n: integer }

// No KEYED member, so no group forms at all — `(Col-Group)`'s last sentence — and a dense and
// a nullable vector side by side are simply two independent collections.
struct NoKey { a: vector<E>, b: vector<E?> }
// Every member nullable: one record set, one representation, nothing to disagree about.
struct AllNull { b: vector<E?>, h: hash<E[k]> }
// Every member dense: the loft#1375 shape.
struct AllDense { a: vector<E>, c: vector<E>, h: hash<E[k]> }
// The `?` a MEMBER carries on itself is not the axis — `(Col-Group)` says so in as many words,
// and it is the element's nullability that the refusal is about.
struct OptMember { b: vector<E?>, h: hash<E[k]>? }

fn two_vectors_with_no_keyed_member_are_independent() {
  n = NoKey { a: [], b: [] };
  n.a += [E { k: 1, n: 1 }];
  assert(len(n.a) == 1 && len(n.b) == 0, "control: no keyed member, so no group and no refusal");
}

fn an_all_nullable_group_is_one_set() {
  g = AllNull { b: [], h: [] };
  g.b += [E { k: 1, n: 5 }];
  assert(len(g.b) == 1 && len(g.h) == 1, "control: every member nullable, so one set");
  assert((g.h[1].n ?? -1) == 5, "control: and the record reads back through the other route");
}

fn an_all_dense_group_is_one_set() {
  g = AllDense { a: [], c: [], h: [] };
  g.a += [E { k: 1, n: 5 }];
  assert(len(g.a) == 1 && len(g.c) == 1 && len(g.h) == 1, "control: every member dense, so one set");
  assert(g.c[0].n == 5, "control: and the record reads back through the other vector");
}

fn a_members_own_nullability_is_not_the_axis() {
  g = OptMember { b: [], h: [] };
  g.b += [E { k: 1, n: 5 }];
  assert(len(g.b) == 1 && g.h != null, "control: a nullable MEMBER still joins its group");
}

fn main() {
  two_vectors_with_no_keyed_member_are_independent();
  an_all_nullable_group_is_one_set();
  an_all_dense_group_is_one_set();
  a_members_own_nullability_is_not_the_axis();
  println("ok");
}
