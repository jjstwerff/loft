//
// @PLAN48 P2 / @P370 regression — the ALLOWED integer-width conversions.
// `integer` is 64-bit; `i32` is an explicit 4-byte int.  Narrowing
// (`integer` → `i32`) needs an explicit `as` (see 102-expected-errors.loft),
// but these three forms must keep working WITHOUT a cast:
//   - a constant integer literal that fits the narrow target (exemption),
//   - widening `i32` → `integer` (lossless, implicit),
//   - an explicit `as i32` cast of a non-constant integer.

fn takes_i32(x: i32) -> i32 {
  x
}

fn main() {
  // literal exemption
  lit: i32 = 5;
  assert(lit == 5, "literal fits i32 implicitly");
  assert(takes_i32(200) == 200, "literal arg fits i32 param");

  // widening i32 -> integer (implicit, lossless)
  w: integer = lit;
  assert(w == 5, "i32 widens to integer implicitly");

  // explicit `as i32` is the sanctioned narrowing of a non-constant integer
  n: integer = 99;
  c: i32 = n as i32;
  assert(c == 99, "explicit `as i32` narrows");
  assert(takes_i32(n as i32) == 99, "explicit `as i32` arg");

  print("ok");
}
