// @PLN85 D-own-1 leak cells L1-L3, graduated from the promotion corpus.
//
// L1 — a fn-ref/lambda call's result type used to carry the CALLEE's
// attr-space deps verbatim; a grown hidden-buffer index misread in the caller
// as `__retbuf` faked "already delivered", so the store `fn_call_ref`
// allocates at runtime leaked (both backends).  `fnref_result_type` now maps
// visible-param deps through the actual args and drops hidden indices.
fn l1_lambda(n: integer) -> vector<integer> {
  f = fn(x: integer) -> vector<integer> {
    q = [x, x + 1];
    q
  };
  f(n)
}

// L2 — the native fn-ref dispatch pre-allocated ONE `__vc_hbuf` before the
// candidate match; every taken arm without a hidden buffer leaked it (native
// only).  The buffer now allocates INSIDE each arm that needs it, and an arm
// whose candidate does not RETURN the buffer frees it after the call.
fn l2_lambda(n: integer) -> vector<integer> {
  g = fn(x: integer) -> vector<integer> {
    q = [x];
    q += [x + 1];
    q
  };
  g(n)
}

// L3 — a match-return vector delivered via the join_own pre-pass lost its
// `{__retbuf}` return dep to ref_return's stale-`ret` finalization clobber:
// callers typed the result OWNED (double-freeing the delivered buffer), and a
// caller-side `v[i] ?? <literal>` discharge made scan_set's dep-prefix
// null-init allocate an entry store the call assignment then orphaned.
struct E7 {
  hp: integer not null,
  name: text,
}
enum Cell7 {
  Nil,
  Filled7 { items: vector<E7> },
}
fn l3_jo(c: Cell7) -> vector<E7> {
  match c {
    Filled7 { items } => { items },
    _ => { [] },
  }
}

fn main() {
  a = l1_lambda(2);
  assert(len(a) == 2 && a[1] == 3, "l1: {a}");
  b = l2_lambda(2);
  assert(len(b) == 2 && b[1] == 3, "l2: {b}");
  g0 = l3_jo(Filled7 { items: [E7 { hp: 5, name: "a" }, E7 { hp: 6, name: "b" }] });
  g0e = g0[1] ?? E7 { hp: 0, name: "" };
  assert(len(g0) == 2 && g0e.hp == 6, "l3 value: {g0e.hp}");
  gm = l3_jo(Nil);
  gme = gm[0] ?? E7 { hp: 0, name: "" };
  assert(len(gm) == 0 && gme.hp == 0, "l3 nil: {gme.hp}");
  // Loop the L3 shape — the double-free this also fixed was allocation-order
  // sensitive; churn would recycle a wrongly-freed slot.
  for i in 0..5 {
    r = l3_jo(Filled7 { items: [E7 { hp: i, name: "x{i}" }] });
    re = r[0] ?? E7 { hp: -1, name: "" };
    assert(re.hp == i, "l3 churn {i}: {re.hp}");
  }
  println("fnref-lambda-return-ownership ok");
}
