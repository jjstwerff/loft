//
// A generic instantiated at a struct that takes part in a reference CYCLE used to kill the
// process — SIGSEGV, exit 139, no diagnostic and no partial output, on both backends.
//
// `Parser::type_element_size` sums a struct's fields because a struct-typed vector element is
// stored INLINE.  A field whose type reaches BACK to a struct already being measured cannot
// be inline — nothing contains itself — so it is a stored reference and measures as a
// `DbRef`.  Without that stop the walk followed `Node { next: reference<Node>? }` around its
// own cycle until the stack ran out.
//
// The filed scope was narrower than the defect: the issue's variant table recorded the DENSE
// `-> T` return as working, and it crashes too (a3 below).  Neither the nullable return nor
// the DIRECTNESS of the self-reference is required — a mutual `A -> B -> A` crashes the same
// way.  What is required is the GENERIC: the non-generic twin never reaches this walk.
//
// The sibling cell is the boundary from the other side, and it is why the stop is a PATH and
// not a visited-set: the same struct twice as siblings is not a cycle and must still measure
// both.  A visited-set would under-count the second one — a wrong SIZE rather than a crash,
// which is the worse failure, so the cell reads every field of both siblings.
//
// @falsified-at: 964bab93 — interpret exit 139 -> 0, native exit 139 -> 0 (the parent build
//   segfaults with no output on every cycle cell below).

struct Node1378 { value: integer, next: reference<Node1378>? }
struct Tree1378 { value: integer, l: reference<Tree1378>?, r: reference<Tree1378>? }
struct A1378 { v: integer, b: reference<B1378>? }
struct B1378 { w: integer, a: reference<A1378>? }
struct In1378 { a: integer, b: integer }
struct Out1378 { p: In1378, q: In1378 }

fn id_g<T>(v: T) -> T? { v }
fn dense_g<T>(v: T) -> T { v }

fn main() {
  // A DIRECT self-reference, nullable generic return — the filed repro.
  n = Node1378 { value: 1, next: null };
  gn: Node1378? = id_g(n);
  assert((gn.value ?? -1) == 1, "direct self-reference, nullable generic return");

  // The same struct through a DENSE generic return.  The issue recorded this as working; it
  // crashed identically, because the return's nullability was never the axis.
  dn: Node1378 = dense_g(n);
  assert(dn.value == 1, "direct self-reference, dense generic return");

  // TWO self-referential fields on one struct.
  t = Tree1378 { value: 5, l: null, r: null };
  gt: Tree1378? = id_g(t);
  assert((gt.value ?? -1) == 5, "two self-referential fields");

  // A MUTUAL cycle: the self-reference need not be direct.
  x = A1378 { v: 3, b: null };
  gx: A1378? = id_g(x);
  assert((gx.v ?? -1) == 3, "mutual A -> B -> A cycle");

  // NO cycle, the same struct twice as SIBLINGS — every field read, so an under-counted
  // stride shows as a wrong value rather than passing quietly.
  o = Out1378 { p: In1378 { a: 6, b: 7 }, q: In1378 { a: 8, b: 9 } };
  go: Out1378? = id_g(o);
  assert((go.p.a ?? -1) == 6, "siblings: p.a={go.p.a ?? -1}");
  assert((go.p.b ?? -1) == 7, "siblings: p.b={go.p.b ?? -1}");
  assert((go.q.a ?? -1) == 8, "siblings: q.a={go.q.a ?? -1}");
  assert((go.q.b ?? -1) == 9, "siblings: q.b={go.q.b ?? -1}");

  // A cycle struct as a VECTOR element, which reaches the same measurement another way.
  v: vector<Node1378> = [Node1378 { value: 4, next: null }, Node1378 { value: 8, next: null }];
  assert(len(v) == 2 && v[0].value == 4 && v[1].value == 8, "cycle struct as a vector element");

  println("1378 OK");
}
