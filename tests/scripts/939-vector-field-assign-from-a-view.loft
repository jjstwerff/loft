//
// The temp a vector-FIELD replacement builds for its right-hand side is a VIEW when
// the right-hand side is one, so the scope-end free must not release it.
//
// `s.v = <expr>` lowers to `Set(tmp, expr); Clear(s.v); Append(s.v, tmp)`. That
// `Set` is synthetic — built after the right-hand side was already parsed — so it
// bypasses the parse-time vector deep-copy lowering and ALIASES whatever `expr`
// names. For `cs.items = src.items` that is `src`'s record, and freeing the temp at
// scope exit freed `src`'s store: the caller's argument, while the caller was still
// holding it. Nothing wrote the caller's struct and nothing faulted — the store slot
// was simply handed to the next allocation, so a field the program never assigned
// read back as another record's data.
//
// loft#939 filed the `const` parameter shape. It was never about `const`, and never
// about parameters: the plain and `&` parameter forms are the same defect, and so is
// a LOCAL struct read from an inner scope that exits before the local does. The
// sibling loft#897 is this same temp in the opposite direction — an RHS that
// ALLOCATES and therefore must be freed — which is why the two cannot share one
// blanket answer and the temp's ownership has to follow its right-hand side.
//
// Each row asserts the SOURCE survives and that the copy actually copied. Both
// halves are needed: c4 shows the premature free also LOST data (iterations after
// the first copied nothing), so a source-only guard passes on half the defect, and
// a copy-only guard passes on the other half. `tests/wrap.rs` fails this file on a
// store-leak warning at exit, which is what holds the controls honest — a fix that
// simply stopped freeing everything would leak c7 and c9.

struct Holder { mark: integer, items: vector<integer> }
struct Elem   { id: integer }
struct Box    { tag: integer, elems: vector<Elem> }
struct Play   { wave: Holder }
struct Run    { play: Play }

fn r939_fresh() -> Holder {
  Holder { mark: 987654321987, items: [11, 22, 33] }
}

// Hand a wrongly-freed slot to the next allocation and write over it. Without this
// the defect is a dangling read that still happens to answer the old bytes, and
// every row below passes while the store is already free.
fn r939_churn() -> integer {
  n = 0;
  for i in 0..40 {
    h = Holder { mark: 555000 + i, items: [i, i + 1, i + 2, i + 3] };
    n = n + len(h.items) + h.mark;
  }
  n
}

fn r939_const(src: const Holder) -> integer {
  c = Holder { mark: 0, items: [] };
  c.items = src.items;
  len(c.items)
}

fn r939_plain(src: Holder) -> integer {
  c = Holder { mark: 0, items: [] };
  c.items = src.items;
  len(c.items)
}

fn r939_struct_elems(src: const Box) -> integer {
  c = Box { tag: 0, elems: [] };
  c.elems = src.elems;
  len(c.elems)
}

fn main() {
  // c1 — the filed shape: a `const` parameter's vector field.
  a1 = r939_fresh();
  n1 = r939_const(a1);
  r939_churn();
  assert(n1 == 3, "c1 copied {n1}, want 3");
  assert(a1.mark == 987654321987, "c1 source mark = {a1.mark}, want 987654321987");
  assert(len(a1.items) == 3, "c1 source len = {len(a1.items)}, want 3");

  // c2 — a PLAIN by-value parameter. Same defect; the filed scope named only `const`.
  a2 = r939_fresh();
  n2 = r939_plain(a2);
  r939_churn();
  assert(n2 == 3, "c2 copied {n2}, want 3");
  assert(a2.mark == 987654321987, "c2 source mark = {a2.mark}, want 987654321987");
  assert(len(a2.items) == 3, "c2 source len = {len(a2.items)}, want 3");

  // The `&` parameter form failed identically before the fix and is deliberately
  // NOT a row here: a struct parameter already propagates a field write to the
  // caller, so loft advises against writing `&` on one at all, and the three
  // parameter kinds reach this statement as the same borrow. c2 stands for them.

  // c4 — no call at all: a LOCAL struct, read in a loop body whose scope exits once
  //      per iteration while the local outlives all of them. The same statement in
  //      the local's OWN scope cannot fail — the temp and the local die together —
  //      so a row written that way looks like a control and asserts nothing.
  a4 = r939_fresh();
  n4 = 0;
  for i4 in 0..3 {
    c4 = Holder { mark: i4, items: [] };
    c4.items = a4.items;
    n4 = n4 + len(c4.items);
  }
  r939_churn();
  assert(n4 == 9, "c4 copied {n4} over 3 iterations, want 9");
  assert(a4.mark == 987654321987, "c4 source mark = {a4.mark}, want 987654321987");
  assert(len(a4.items) == 3, "c4 source len = {len(a4.items)}, want 3");

  // c5 — a STRUCT element type rather than a scalar one.
  a5 = Box { tag: 987654321987,
             elems: [Elem { id: 11 }, Elem { id: 22 }, Elem { id: 33 }] };
  n5 = r939_struct_elems(a5);
  r939_churn();
  assert(n5 == 3, "c5 copied {n5}, want 3");
  assert(a5.tag == 987654321987, "c5 source tag = {a5.tag}, want 987654321987");
  assert(len(a5.elems) == 3, "c5 source len = {len(a5.elems)}, want 3");

  // c6 — the argument is a CHAINED field of a struct the caller keeps, which is the
  //      shape the consumer reported (`crop_keys(…, run.play.wave, …)`).
  a6 = Run { play: Play { wave: r939_fresh() } };
  n6 = r939_const(a6.play.wave);
  r939_churn();
  assert(n6 == 3, "c6 copied {n6}, want 3");
  assert(a6.play.wave.mark == 987654321987,
         "c6 source mark = {a6.play.wave.mark}, want 987654321987");
  assert(len(a6.play.wave.items) == 3,
         "c6 source len = {len(a6.play.wave.items)}, want 3");

  // c7 — CONTROL: the RHS is a CALL RESULT, which owns its storage. Its free has to
  //      STAY, and the leak gate is what proves it did: a fix that stopped freeing
  //      the temp outright would pass every row above and leak this one.
  c7 = Holder { mark: 0, items: [] };
  c7.items = r939_fresh().items;
  r939_churn();
  assert(len(c7.items) == 3, "c7 copied {len(c7.items)}, want 3");

  // c8 — CONTROL: a BORROWED local var takes the sibling arm, which builds its temp
  //      by element-append into fresh storage and correctly frees it.
  a8 = r939_fresh();
  w8 = a8.items;
  c8 = Holder { mark: 0, items: [] };
  c8.items = w8;
  r939_churn();
  assert(len(c8.items) == 3, "c8 copied {len(c8.items)}, want 3");
  assert(a8.mark == 987654321987, "c8 source mark = {a8.mark}, want 987654321987");

  // c9 — CONTROL: a literal owns its storage; its free stays, and the leak gate
  //      checks that it does.
  c9 = Holder { mark: 0, items: [] };
  c9.items = [11, 22, 33];
  r939_churn();
  assert(len(c9.items) == 3, "c9 copied {len(c9.items)}, want 3");

  // c10 — CONTROL: a LOCAL destination rather than a struct field is a different
  //       lowering, and was always correct. It pins that the fix did not reach it.
  a10 = r939_fresh();
  v10 = a10.items;
  r939_churn();
  assert(len(v10) == 3, "c10 copied {len(v10)}, want 3");
  assert(a10.mark == 987654321987, "c10 source mark = {a10.mark}, want 987654321987");

  println("ok");
}
