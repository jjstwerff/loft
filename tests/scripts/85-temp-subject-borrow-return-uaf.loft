// @PLN90 W1 / @PLN85 A1b regression: a `-> vector` function whose tail is a
// buffer-ABI call returning a BORROW of a TEMPORARY subject the function itself
// constructs must not dangle. `h` builds a temporary `Filled`, `g` returns a
// borrow of its `items`, and `h` returns that borrow — the temporary is freed at
// `h`'s scope end, so a naive lowering returns a view into freed memory (UAF:
// interp read empty/garbage, native panicked; loud under LOFT_POISON).
//
// The old `one_buffer_chain` collapsed three roles — the subject store, `g`'s
// return buffer, and `h`'s `__retbuf` — onto ONE work-ref (the subject built into
// `__retbuf` via a Rename + a Bind{substitute} merge), so the caller's materialise
// reallocated the store the borrow pointed into. The fix (classify_ret_promotion,
// default on, LOFT_NO_A1B opts out) keeps the three stores DISTINCT: the subject
// work-ref is skipped (kept a local, freed after the copy) and the buffer work-ref
// materialises an owned copy into a separate `__retbuf`. Pins both backends.
struct E { hp: integer, name: text }
enum Cell { Empty, Filled { items: vector<E> } }
fn g(e: Cell) -> vector<E> { match e { Filled { items } => { items }, _ => { [] } } }
fn h(seed: integer) -> vector<E> {
  inner: vector<E> = [];
  for k in 0..3 { inner += [E{hp: seed + k, name: "e"}]; }
  g(Filled { items: inner })
}
fn main() {
  a = h(10);
  assert(len(a) == 3, "len: {len(a)}");
  assert(a[0].hp == 10 && a[1].hp == 11 && a[2].hp == 12, "values corrupted");
  // allocation churn AFTER the escaped return, to reuse the freed store if it leaked
  j: vector<E> = []; for q in 0..20 { j += [E{hp: q, name: "x"}]; }
  assert(a[0].hp == 10, "UAF: a corrupted after churn");
  print("pln90-w1 ok\n");
}
