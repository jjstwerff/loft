//
// `field = null` RELEASES what a collection field holds — for every collection kind,
// and whether or not the field is spelled with a `?`.
//
// It used to be a silent no-op: no clear, no write, no diagnostic. The field kept its
// records and its length, so the line looked like it had worked (loft#922). Only the
// `vector<T>?` spelling cleared, which split ONE type's behaviour in two — under the
// null model just the SCALAR default flips to non-null, so a heap type stays nullable
// and `vector<T>` and `vector<T>?` are the same type with the same layout.
//
// The kinds are why this file lists all five keyed forms. The field-replace path named
// `sorted` / `hash` / `index` only, so `spatial` and `trie` fields ALSO kept the older
// whole-assign defect that path exists to fix (loft#895): `=` meant `+=` there, and
// `= []` did nothing at all. Both are asserted below beside the three kinds that were
// already correct.
//
// NOT asserted, deliberately: `s.xs == null` after `s.xs = null`. A collection field
// holds a record id / claim pointer where `0` already means "no records", with nothing
// left to mean *absent* rather than *empty* — the reader half is a representation
// change and keeps loft#917 open. Every assertion here is about the VALUE the field
// holds, which is answerable today.

struct E { k: integer, v: integer }
struct P { x: integer, y: integer, v: integer }
struct W { name: text, v: integer }

// One element type PER keyed field, which is what keeps the five fields of `S`
// five independent collections. Two keyed collections over ONE element type in
// one struct are auto-linked into a linked group — two routes to a single record
// set — and this section is about each kind on its own; the group has its own
// section further down, with its own struct.
//
// `h` / `so` / `ix` shared `E` until loft#924. Each member zeroed its own header
// at its own position in the literal, so the later fills silently truncated away
// what the earlier ones had put in the shared record set and the three read as
// independent. They are three views of six records if the element type is shared.
struct ESorted { k: integer, v: integer }
struct EIndex { k: integer, v: integer }

struct S {
  xs: vector<integer>,
  ys: vector<integer>?,
  h: hash<E[k]>,
  so: sorted<ESorted[k]>,
  ix: index<EIndex[k]>,
}

struct G {
  sp: spatial<P[x, y]>,
  tr: trie<W[name]>,
}

// Two routes to ONE record set: `lookup` is a view over `data`'s records.
struct GRP {
  data: vector<E>,
  lookup: hash<E[k]>,
}

fn fresh() -> S {
  S {
    xs: [7, 8],
    ys: [7, 8],
    h: [E { k: 1, v: 10 }, E { k: 2, v: 20 }],
    so: [ESorted { k: 1, v: 10 }, ESorted { k: 2, v: 20 }],
    ix: [EIndex { k: 1, v: 10 }, EIndex { k: 2, v: 20 }],
  }
}

fn fresh_g() -> G {
  G {
    sp: [P { x: 1, y: 2, v: 10 }, P { x: 3, y: 4, v: 20 }],
    tr: [W { name: "aa", v: 10 }, W { name: "bb", v: 20 }],
  }
}

fn main() {
  // Every kind, one `= null` each: the field is empty afterwards.
  s = fresh();
  s.xs = null;
  assert(len(s.xs) == 0, "vector field after `= null` has len {len(s.xs)}, want 0");
  s.ys = null;
  assert(len(s.ys ?? []) == 0, "vector? field after `= null` has len {len(s.ys ?? [])}, want 0");
  s.h = null;
  assert(len(s.h) == 0, "hash field after `= null` has len {len(s.h)}, want 0");
  s.so = null;
  assert(len(s.so) == 0, "sorted field after `= null` has len {len(s.so)}, want 0");
  s.ix = null;
  assert(len(s.ix) == 0, "index field after `= null` has len {len(s.ix)}, want 0");

  g = fresh_g();
  g.sp = null;
  assert(len(g.sp) == 0, "spatial field after `= null` has len {len(g.sp)}, want 0");
  g.tr = null;
  assert(len(g.tr) == 0, "trie field after `= null` has len {len(g.tr)}, want 0");

  // A cleared field is still a usable collection — `+=` after the clear adds one.
  s2 = fresh();
  s2.xs = null;
  s2.xs += [3];
  assert(len(s2.xs) == 1, "append after clear left len {len(s2.xs)}, want 1");
  s2.h = null;
  s2.h += [E { k: 9, v: 90 }];
  assert(len(s2.h) == 1, "hash append after clear left len {len(s2.h)}, want 1");
  g2 = fresh_g();
  g2.sp = null;
  g2.sp += [P { x: 9, y: 9, v: 90 }];
  assert(len(g2.sp) == 1, "spatial append after clear left len {len(g2.sp)}, want 1");
  g2.tr = null;
  g2.tr += [W { name: "zz", v: 90 }];
  assert(len(g2.tr) == 1, "trie append after clear left len {len(g2.tr)}, want 1");

  // `= [items]` REPLACES on every kind — `spatial` and `trie` are the two that
  // appended instead, so a one-element literal over two elements read back as three.
  g3 = fresh_g();
  g3.sp = [P { x: 5, y: 6, v: 50 }];
  assert(len(g3.sp) == 1, "spatial `= [one]` over two left len {len(g3.sp)}, want 1");
  g3.tr = [W { name: "cc", v: 50 }];
  assert(len(g3.tr) == 1, "trie `= [one]` over two left len {len(g3.tr)}, want 1");
  s3 = fresh();
  s3.h = [E { k: 5, v: 50 }];
  assert(len(s3.h) == 1, "hash `= [one]` over two left len {len(s3.h)}, want 1");
  s3.so = [ESorted { k: 5, v: 50 }];
  assert(len(s3.so) == 1, "sorted `= [one]` over two left len {len(s3.so)}, want 1");
  s3.ix = [EIndex { k: 5, v: 50 }];
  assert(len(s3.ix) == 1, "index `= [one]` over two left len {len(s3.ix)}, want 1");

  // `= []` empties on every kind — the empty literal is the same statement as `= null`
  // reaches, and `spatial` / `trie` used to drop it too.
  g4 = fresh_g();
  g4.sp = [];
  assert(len(g4.sp) == 0, "spatial `= []` left len {len(g4.sp)}, want 0");
  g4.tr = [];
  assert(len(g4.tr) == 0, "trie `= []` left len {len(g4.tr)}, want 0");

  // `+=` must still APPEND — this is about `=`, and the other must not have moved.
  s5 = fresh();
  s5.xs += [9];
  assert(len(s5.xs) == 3, "vector `+=` left len {len(s5.xs)}, want 3");
  s5.h += [E { k: 3, v: 30 }];
  assert(len(s5.h) == 3, "hash `+=` left len {len(s5.h)}, want 3");
  g5 = fresh_g();
  g5.sp += [P { x: 7, y: 8, v: 70 }];
  assert(len(g5.sp) == 3, "spatial `+=` left len {len(g5.sp)}, want 3");
  g5.tr += [W { name: "cc", v: 70 }];
  assert(len(g5.tr) == 3, "trie `+=` left len {len(g5.tr)}, want 3");

  // The values survive the clear+refill, not just the counts: a clear that left the
  // spine naming freed records would still count right and read wrong.
  s6 = fresh();
  s6.so = null;
  s6.so += [ESorted { k: 4, v: 44 }];
  tot = 0;
  for e in s6.so { tot += e.v; }
  assert(tot == 44, "sorted refilled after clear holds {tot}, want 44");

  // A LINKED group — two routes to one record set. An operation spelled through ANY member
  // acts on the group (loft#898), so `= null` has to release those records exactly once,
  // through their owner, and reset the other route to them: a view left holding its old
  // spine reports a length over memory that is now free.
  //
  // Filled with `+=` rather than by a literal on purpose, so this section keeps testing the
  // CLEAR and nothing else: an empty view has nothing to reset, and a literal used to leave
  // one empty whenever the primary was written first (loft#924, now fixed and guarded by
  // `924-group-literal-field-order.loft`).
  gp = GRP { data: [] };
  gp.data += [E { k: 1, v: 10 }, E { k: 2, v: 20 }];
  assert(len(gp.data) == 2, "the group's primary starts at {len(gp.data)}, want 2");
  assert(len(gp.lookup) == 2, "the group's view starts at {len(gp.lookup)}, want 2");

  gp.lookup = null;
  assert(len(gp.lookup) == 0, "`= null` through the view left it at {len(gp.lookup)}, want 0");
  assert(len(gp.data) == 0, "`= null` through the view left the primary at {len(gp.data)}, want 0");
  gp.data += [E { k: 3, v: 30 }];
  assert(len(gp.data) == 1, "refill after the view clear left primary {len(gp.data)}, want 1");
  assert(len(gp.lookup) == 1, "refill after the view clear left view {len(gp.lookup)}, want 1");
  assert(gp.lookup[3].v == 30, "the refilled record reads {gp.lookup[3].v} through the view, want 30");

  gp.data = null;
  assert(len(gp.data) == 0, "`= null` through the primary left it at {len(gp.data)}, want 0");
  assert(len(gp.lookup) == 0, "`= null` through the primary left the view at {len(gp.lookup)}, want 0");
  gp.data += [E { k: 4, v: 40 }];
  assert(gp.lookup[4].v == 40, "after the primary clear the view reads {gp.lookup[4].v}, want 40");

  // Clear and refill in a loop: the field must not grow, and must not leak.
  s7 = fresh();
  g7 = fresh_g();
  for i in 0..20 {
    s7.xs = null;
    s7.xs += [i];
    s7.h = null;
    s7.h += [E { k: i, v: i }];
    g7.sp = null;
    g7.sp += [P { x: i, y: i, v: i }];
  }
  assert(len(s7.xs) == 1, "20 clear+append cycles left vector len {len(s7.xs)}, want 1");
  assert(len(s7.h) == 1, "20 clear+append cycles left hash len {len(s7.h)}, want 1");
  assert(len(g7.sp) == 1, "20 clear+append cycles left spatial len {len(g7.sp)}, want 1");

  println("922 ok");
}
