//
// Regression: REASSIGNING an owned heap ref must free its previous store.
// The interpreter's Set emits a pre-free; native codegen did a plain DbRef
// assignment, so every loop iteration orphaned the previous call's fresh
// store — the `sweep`/`hexn` tuple leak that exhausted the 65535-store table
// in the crawler (cavetest) and blocked #354.  The native leak gate
// (`tests/native.rs` + LOFT_NATIVE_LEAK_CHECK) catches the leak half; the
// asserts here guard the values.  Probe matrix:
// /tmp/p_followups/tuple_loop/ (2026-06-12 session).

fn hexn(q: integer, r: integer, dir: integer) -> (integer, integer) {
  if (r & 1) == 0 {
    if dir == 0 { return (q + 1, r); }
    return (q, r + 1);
  }
  if dir == 0 { return (q + 1, r); }
  (q + 1, r + 1)
}

// Tuple destructure from a hidden-buffer fn, reassigned across a nested
// loop — the exact crawler shape (witness work-ref `__ref_N = call(...)`).
fn test_tuple_destructure_loop() {
  acc = 0;
  for k in 0..4 {
    for d in 0..2 {
      (nq, nr) = hexn(k & 31, (k / 32) & 31, d);
      acc = acc + nq + nr;
    }
  }
  assert(acc == 20, "tuple loop acc={acc} expect 20");
}

// Whole-tuple local reassigned per iteration.
fn test_tuple_whole_loop() {
  acc = 0;
  for k in 0..4 {
    t = hexn(k, k, k % 2);
    (nq, nr) = t;
    acc = acc + nq + nr;
  }
  assert(acc == 18, "whole-tuple acc={acc} expect 18");
}

struct R3 { v: integer }

fn mk_r3(n: integer) -> R3 { s = R3 { v: n }; s }

fn pick_r3(c: integer) -> R3 {
  if c == 0 { return mk_r3(100); }
  mk_r3(200)
}

// #360 — self-referencing reassignment `s = f(s)` in a loop: the RHS call
// must evaluate against s's OLD store before the destination re-init runs
// (interp read null from iteration 1; with the s1 tightening alone, from
// iteration 0).  The text field guards the claims handling of the in-place
// destination reuse.
fn grow_r3(x: R3) -> R3 { s = R3 { v: x.v + 1 }; s }

struct N3 { name: text, v: integer }

fn grow_n3(x: N3) -> N3 { t = N3 { name: x.name + "x", v: x.v + 1 }; t }

fn test_self_arg_reassign_loop() {
  s = R3 { v: 0 };
  for _k in 0..4 { s = grow_r3(s); }
  assert(s.v == 4, "self-arg v={s.v} expect 4");
  n = N3 { name: "a", v: 0 };
  for _k2 in 0..4 { n = grow_n3(n); }
  assert(n.v == 4 && n.name == "axxxx", "claims name={n.name} v={n.v}");
}

// Struct locals reassigned per iteration — adopting (single-site NRVO) and
// multi-site (one-buffer chained) callees.
fn test_struct_reassign_loop() {
  acc = 0;
  for k in 0..4 {
    s = mk_r3(k);
    acc = acc + s.v;
  }
  assert(acc == 6, "adopt acc={acc} expect 6");
  acc2 = 0;
  for k in 0..4 {
    s2 = pick_r3(k % 2);
    acc2 = acc2 + s2.v;
  }
  assert(acc2 == 600, "multisite acc={acc2} expect 600");
}
