//
// Clearing one member of a linked collection group empties the group, and frees its
// shared records exactly once.
//
// Two or more keyed collections over one element type in one struct are auto-linked
// into several routes to a SINGLE record set (`Field.other_indexes`, loft#843) —
// filling either one fills both, by design. The clear did not have an owner for those
// shared records, so EVERY member freed them: whichever was cleared first took the
// other's elements down with it, and the survivor kept reporting its old length over
// freed memory (a key reading 4294967296, a text reading null). Identical on both
// backends and on the published 2026.8.0.
//
// The ownership answer is in the schema: `types.rs` marks the later-declared members
// as VIEWS of the records the first one holds. A view contributes only its SPINE (its
// hash table, its ordered slot list, or — for `index` — nothing at all, since a
// b-tree's nodes ARE the element records and zeroing the root is the whole teardown);
// the primary contributes the records. So a clear resets every view's spine and frees
// through the primary, whichever member it was spelled through.
//
// That it applies whichever member is named is NOT a choice made here: an operation
// spelled through a view already acts on the group — `h.view += [e]` appends to every
// member, and has since loft#843. Rows d1/d2 pin that, because it is the fact the
// whole model rests on. Letting a view be emptied alone cannot be made coherent for a
// non-empty literal: the elements still go into the group, so the view would hold `e`
// while the primary held `e` plus everything it had before, and no operation repairs
// an index that silently does not index the records.
//
// The controls carry the weight. b1/b2 pin that a LONE keyed collection and a lone
// vector still free what they own, since a fix that made every clear unlink-only would
// leak silently rather than fail. b3 pins a two-vector struct, which must NOT link at
// all — only index-typed fields are auto-linked, and widening that would make two
// independent vectors alias.

struct E { k: integer, n: text }
struct HS { keyed: hash<E[k]>, ord: sorted<E[k]>, tag: integer }
struct VH { v: vector<E>, by_k: hash<E[k]> }
struct VI { v: vector<E>, by_k: index<E[k]> }
struct Three { keyed: hash<E[k]>, ord: sorted<E[k]>, idx: index<E[k]> }
struct Inner { pad: integer, v: vector<E>, by_k: hash<E[k]> }
struct Outer { tag: text, inner: Inner }
struct LoneH { h: hash<E[k]>, tag: integer }
struct LoneV { v: vector<E>, tag: integer }
struct TwoVec { a: vector<E>, b: vector<E> }

// Every cell checks CONTENTS as well as length: the length survives the free, so it is
// what a record reads back as — a key of 4294967296, a text of null — that separates a
// live record set from a freed one.
fn main() {
  // ---- a1: clear through the VIEW of a hash+sorted group ------------------------
  // The records belong to `keyed`, so `ord` frees nothing itself — but the assignment
  // is to the group, so both members end up empty and agreeing.
  a1 = HS { keyed: [], ord: [], tag: 0 };
  a1.keyed = [E{k:1,n:"alpha"}, E{k:2,n:"beta"}];
  assert(len(a1.ord) == 2, "a1 setup: view len = {len(a1.ord)}, want 2 (filling either fills both)");
  a1.ord = [];
  assert(len(a1.keyed) == 0, "a1 primary len = {len(a1.keyed)}, want 0");
  assert(len(a1.ord) == 0, "a1 view len = {len(a1.ord)}, want 0");

  // ---- a2: clear the PRIMARY of the same group ---------------------------------
  // Frees the records once, and must reset the view rather than leave it naming them.
  a2 = HS { keyed: [], ord: [], tag: 0 };
  a2.keyed = [E{k:1,n:"alpha"}, E{k:2,n:"beta"}];
  a2.keyed = [];
  assert(len(a2.keyed) == 0, "a2 primary len = {len(a2.keyed)}, want 0");
  assert(len(a2.ord) == 0, "a2 view len = {len(a2.ord)}, want 0 (a stale view names freed records)");

  // ---- a3: vector + hash, the shape DATABASE.md documents by name --------------
  // "A SECONDARY index is a second route to records the primary owns, and may
  // neither move nor free them."  Here the owner is unambiguous: the vector.
  a3 = VH { v: [], by_k: [] };
  a3.v += [E{k:1,n:"alpha"}];
  a3.v += [E{k:2,n:"beta"}];
  assert(len(a3.by_k) == 2, "a3 setup: index len = {len(a3.by_k)}, want 2");
  a3.by_k = [];
  assert(len(a3.v) == 0, "a3 vector len = {len(a3.v)}, want 0");
  assert(len(a3.by_k) == 0, "a3 index len = {len(a3.by_k)}, want 0");

  // ---- a4: clear the vector PRIMARY, index must follow -------------------------
  // The other direction of a3, and the one the report did not name.
  a4 = VH { v: [], by_k: [] };
  a4.v += [E{k:1,n:"alpha"}];
  a4.v += [E{k:2,n:"beta"}];
  a4.v = [];
  assert(len(a4.v) == 0, "a4 vector len = {len(a4.v)}, want 0");
  assert(len(a4.by_k) == 0, "a4 index len = {len(a4.by_k)}, want 0 (a stale view names freed records)");

  // ---- a5: an `index` view -----------------------------------------------------
  // The awkward member: a b-tree's nodes ARE the element records, so it has no spine
  // block to free — zeroing the root is its whole teardown.
  a5 = VI { v: [], by_k: [] };
  a5.v += [E{k:1,n:"alpha"}];
  a5.v += [E{k:2,n:"beta"}];
  assert(len(a5.by_k) == 2, "a5 setup: index len = {len(a5.by_k)}, want 2");
  a5.by_k = [];
  assert(len(a5.v) == 0, "a5 vector len = {len(a5.v)}, want 0");
  assert(len(a5.by_k) == 0, "a5 index len = {len(a5.by_k)}, want 0");

  // ---- a6: THREE members -------------------------------------------------------
  // Two members cannot show an order dependence between siblings; three can.
  a6 = Three { keyed: [], ord: [], idx: [] };
  a6.keyed = [E{k:1,n:"alpha"}, E{k:2,n:"beta"}];
  assert(len(a6.ord) == 2, "a6 setup: ord len = {len(a6.ord)}, want 2");
  assert(len(a6.idx) == 2, "a6 setup: idx len = {len(a6.idx)}, want 2");
  a6.ord = [];
  assert(len(a6.keyed) == 0, "a6 primary len = {len(a6.keyed)}, want 0");
  assert(len(a6.idx) == 0, "a6 other view len = {len(a6.idx)}, want 0 (all three are one set)");
  // and refilling through the third member brings every route back
  a6.idx = [E{k:7,n:"eta"}];
  assert(len(a6.keyed) == 1, "a6 primary after refill = {len(a6.keyed)}, want 1");
  assert(len(a6.ord) == 1, "a6 ord after refill = {len(a6.ord)}, want 1");
  assert(len(a6.idx) == 1, "a6 idx after refill = {len(a6.idx)}, want 1");

  // ---- a7: the group one level down --------------------------------------------
  // The field offsets a clear rewrites are relative to the struct that HOLDS the
  // group, so a nested base must resolve to `Inner`, not to the outermost variable.
  // Reading the site off the base EXPRESSION resolved only a bare variable and left
  // this shape on the unsafe clear.
  a7 = Outer { tag: "t", inner: Inner { pad: 7, v: [], by_k: [] } };
  a7.inner.v += [E{k:1,n:"alpha"}];
  a7.inner.v += [E{k:2,n:"beta"}];
  a7.inner.by_k = [];
  assert(len(a7.inner.v) == 0, "a7 nested vector len = {len(a7.inner.v)}, want 0");
  assert(len(a7.inner.by_k) == 0, "a7 nested index len = {len(a7.inner.by_k)}, want 0");

  // ---- a8: a copy of a struct holding a group -----------------------------------
  // Each copy owns its own records; clearing one must not reach into the other.
  a8 = VH { v: [], by_k: [] };
  a8.v += [E{k:1,n:"alpha"}];
  a8.v += [E{k:2,n:"beta"}];
  a8b = a8;
  assert(len(a8b.v) == 2, "a8 copy vector len = {len(a8b.v)}, want 2");
  assert(len(a8b.by_k) == 2, "a8 copy index len = {len(a8b.by_k)}, want 2");
  a8.v = [];
  assert(len(a8b.v) == 2, "a8 copy vector after source clear = {len(a8b.v)}, want 2");
  s = ""; for e in a8b.v { s += "{e.k}:{e.n} "; }
  assert(s.trim() == "1:alpha 2:beta", "a8 copy contents = [{s.trim()}], want [1:alpha 2:beta]");

  // ---- d1: `+=` through a VIEW appends to the whole group ------------------------
  // Unchanged behaviour, pinned here because it is what the clear's model rests on:
  // an operation spelled through a view acts on the group. If this ever became
  // view-only, the clear above would be the wrong rule and this row says so.
  d1 = VH { v: [], by_k: [] };
  d1.v += [E{k:1,n:"alpha"}];
  d1.by_k += [E{k:2,n:"beta"}];
  assert(len(d1.v) == 2, "d1 vector len = {len(d1.v)}, want 2 (append through the view fills both)");
  assert(len(d1.by_k) == 2, "d1 index len = {len(d1.by_k)}, want 2");
  s = ""; for e in d1.v { s += "{e.k}:{e.n} "; }
  assert(s.trim() == "1:alpha 2:beta", "d1 vector contents = [{s.trim()}], want [1:alpha 2:beta]");

  // ---- d2: a NON-EMPTY assign through a VIEW replaces the group's set -------------
  // The row that decides the model. Emptying a view on its own is coherent; assigning
  // `[gamma]` to one is not, because the element goes into the group either way — so
  // a view-only clear would leave `by_k` holding gamma while `v` held alpha, beta AND
  // gamma, an index that does not index two of the three records it is over.
  d2 = VH { v: [], by_k: [] };
  d2.v += [E{k:1,n:"alpha"}];
  d2.v += [E{k:2,n:"beta"}];
  d2.by_k = [E{k:3,n:"gamma"}];
  assert(len(d2.v) == 1, "d2 vector len = {len(d2.v)}, want 1");
  assert(len(d2.by_k) == 1, "d2 index len = {len(d2.by_k)}, want 1");
  s = ""; for e in d2.v { s += "{e.k}:{e.n} "; }
  assert(s.trim() == "3:gamma", "d2 vector contents = [{s.trim()}], want [3:gamma]");
  t = ""; for e in d2.by_k { t += "{e.k}:{e.n} "; }
  assert(t == s, "d2 members disagree: vector [{s.trim()}] vs index [{t.trim()}]");

  // ---- b1 CONTROL: a LONE keyed field still frees what it owns -------------------
  // A fix that made every clear unlink-only would leak here and report a length that
  // is right, so only a refill can show it.
  b1 = LoneH { h: [], tag: 0 };
  b1.h = [E{k:1,n:"alpha"}, E{k:2,n:"beta"}];
  b1.h = [];
  assert(len(b1.h) == 0, "b1 len after clear = {len(b1.h)}, want 0");
  b1.h = [E{k:9,n:"zeta"}];
  assert(len(b1.h) == 1, "b1 len after refill = {len(b1.h)}, want 1");
  s = ""; for e in b1.h { s += "{e.k}:{e.n} "; }
  assert(s.trim() == "9:zeta", "b1 refill contents = [{s.trim()}], want [9:zeta]");

  // ---- b2 CONTROL: a LONE vector field still replaces ---------------------------
  b2 = LoneV { v: [], tag: 0 };
  b2.v = [E{k:1,n:"alpha"}, E{k:2,n:"beta"}];
  b2.v = [E{k:3,n:"gamma"}];
  assert(len(b2.v) == 1, "b2 len = {len(b2.v)}, want 1");
  s = ""; for e in b2.v { s += "{e.k}:{e.n} "; }
  assert(s.trim() == "3:gamma", "b2 contents = [{s.trim()}], want [3:gamma]");

  // ---- b3 CONTROL: two plain vectors are NOT a group -----------------------------
  // Only index-typed fields are auto-linked. If that widened, these two would alias
  // and filling one would fill the other.
  b3 = TwoVec { a: [], b: [] };
  b3.a = [E{k:1,n:"alpha"}, E{k:2,n:"beta"}];
  assert(len(b3.a) == 2, "b3 a len = {len(b3.a)}, want 2");
  assert(len(b3.b) == 0, "b3 b len = {len(b3.b)}, want 0 (two vectors must not link)");
  b3.b = [E{k:3,n:"gamma"}];
  assert(len(b3.a) == 2, "b3 a len after b filled = {len(b3.a)}, want 2");
  assert(len(b3.b) == 1, "b3 b len = {len(b3.b)}, want 1");

  println("ok");
}
