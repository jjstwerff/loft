// A struct-returning call used INLINE must still free the temp it returned into.
//
// loft#722 gave a lift temp minted inside a value-producing block to the ENCLOSING
// scope and dropped its block-exit free, because the block's RESULT could be a
// borrow pointing into that temp. Which results actually borrow is decided by
// `borrow_root`, and it asked the wrong question: it matched every `OpGet*` by name
// prefix.
//
// `run() -> integer { make2().n }` lowers to `OpGetInt(__lift_1, 0)` — an integer
// copied out of the record, which cannot point into it. Treating that as a borrow
// hoisted the temp and dropped its free, so the call's store was never freed: one
// leaked record per inline struct-returning call, on both backends, and invisible
// in a normal run because a leak is only a warning. The debug-assertions gate turns
// it into a panic, which is where it surfaced.
//
// The stdlib declarations already say which getters borrow — `OpGetField(v1, fld)
// -> reference[v1]` and `OpGetVector(r, …) -> reference[r]` name the argument they
// read into, while `OpGetInt(v1, fld) -> integer` names nothing — so the predicate
// now asks what the getter RETURNS.
//
// This file is the leak guard: `wrap.rs`'s Part B gate fails on any store left
// unfreed at exit, so the assertions below are only half of what it checks. Both
// directions matter, so a reference result is exercised too — over-correcting
// would stop hoisting those and bring loft#722 straight back.

struct IsrCell {
  n: integer,
  label: text,
}

struct IsrBox {
  items: vector<IsrCell>,
}

fn isr_make(n: integer) -> IsrCell {
  IsrCell { n: n, label: "cell-{n}" }
}

fn isr_box() -> IsrBox {
  IsrBox { items: [IsrCell { n: 7, label: "boxed" }] }
}

fn isr_take(c: IsrCell) -> integer {
  c.n
}

// THE leaking shape, and the reason it needs its own function: the hoist only runs
// for a value-producing block, so the call has to be the RESULT of one. The same
// expression written as a statement (`a = isr_make(2).n` inside `main`) sits in a
// Void block, never reaches the hoist, and never leaked — a guard built only from
// that form passes on the broken binary.
fn isr_scalar_result(n: integer) -> integer {
  isr_make(n).n
}

// The same shape returning TEXT — a borrow of the temp rather than a copy, so the
// hoist must still fire here and the value must survive the block it was built in.
fn isr_text_result(n: integer) -> text {
  isr_make(n).label
}

fn main() {
  // The leaking shape: a SCALAR read off an inline call, as a function's result.
  a = isr_scalar_result(2);
  assert(a == 2, "scalar field of an inline call result: {a}");

  // In a loop, so a per-call leak accumulates rather than staying at one record.
  s = 0;
  for i in 0..40 { s += isr_scalar_result(i) }
  assert(s == 780, "forty inline calls, each freed: {s}");

  // A text result is a borrow of the temp, not a copy — the other side of the
  // predicate, and it has to keep reading correctly.
  t = isr_text_result(5);
  assert(t == "cell-5", "text field of an inline call result: {t}");

  // The same read written as a statement, in a Void block: never took the hoist,
  // and must stay correct.
  b = isr_make(3).n;
  assert(b == 3, "scalar field read at statement level: {b}");

  // The result passed straight into another call, never bound.
  assert(isr_take(isr_make(9)) == 9, "inline call result as an argument");

  // A REFERENCE result really does point into the temp, so this is the case the
  // hoist exists for: loft#722's own shape, which must keep working.
  held = isr_box().items[0] ?? IsrCell { n: 0, label: "" };
  assert(held.n == 7, "element bound out of a returned temporary: {held.n}");
  assert(held.label == "boxed", "and its text: {held.label}");

  // A result discarded ENTIRELY — `for i in 0..8 { isr_make(i) }` — is deliberately
  // not here. It leaks one record per call, but it leaks identically on the released
  // 2026.7.2 binary, so it is a separate pre-existing fault with its own cause: with
  // no binding at all there is no variable for the free to attach to. Including it
  // would make this guard fail for a reason it is not about.
}
