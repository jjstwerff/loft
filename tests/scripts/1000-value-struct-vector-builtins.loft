//
// loft#1000 — every vector builtin that ended its loop on a NULL ELEMENT never terminated
// over a `value struct`, and `any` answered from a phantom element read one past the end.
//
// Two correct-in-isolation mechanisms met. The builtins emitted
// `Set(elm, iter_next)` + `if !bool(elm) { break }`, relying on `OpGetVectorNullable`
// answering null past the end. @PLN101's `value_struct_copy` rewrites exactly that bind: a
// `value struct` reaching a user callback is deep-copied so the local OWNS its record —
// and a freshly minted record is never null, so the break could not fire. `map`, `filter`,
// `reduce`, `all`, `count_if` and the comprehension hung forever; `any` stopped only
// because its predicate happened to answer true on the out-of-bounds read, which is where
// the phantom `x=5695106865` came from.
//
// The `for` STATEMENT had the mirror defect (a null ELEMENT ending the loop early) and was
// cured by terminating on LENGTH — which is why it was the one correct row in the report.
// The six null-sentinel lowerings now route through `vector_loop_break`, so "how the loop
// ends" is one decision rather than seven.
//
// The element count is not the axis: an EMPTY vector hung too, and it is a cell here.

value struct V1000 { x: integer }

fn v1000_tenx(v: V1000) -> integer { return v.x * 10; }

fn v1000_pair() -> vector<V1000> {
  return [V1000 { x: 1 }, V1000 { x: 2 }];
}

fn test_1000_map() {
  m = map(v1000_pair(), |v| { v.x * 10 });
  assert(len(m) == 2, "map yielded {len(m)} elements, want 2");
  assert(m[0] == 10 && m[1] == 20, "map values {m[0]},{m[1]}");
}

fn test_1000_filter() {
  f = filter(v1000_pair(), |v| { v.x > 1 });
  assert(len(f) == 1, "filter yielded {len(f)}, want 1");
}

fn test_1000_reduce() {
  r = reduce(v1000_pair(), 0, |acc, v| { acc + v.x });
  assert(r == 3, "reduce {r}, want 3");
}

fn test_1000_all() {
  assert(all(v1000_pair(), |v| { v.x > 0 }), "all over a value struct");
}

fn test_1000_count_if() {
  c = count_if(v1000_pair(), |v| { v.x > 0 });
  assert(c == 2, "count_if {c}, want 2");
}

/// The one that TERMINATED and lied: it stopped on a phantom element past the end, whose
/// field answered the predicate. `false` is the truth for this vector.
fn test_1000_any_does_not_see_a_phantom_element() {
  assert(!any(v1000_pair(), |v| { v.x > 999999 }), "any saw an element past the end");
}

fn test_1000_comprehension() {
  cp = [for v in v1000_pair() { v1000_tenx(v) }];
  assert(len(cp) == 2, "comprehension yielded {len(cp)}, want 2");
  assert(cp[0] == 10 && cp[1] == 20, "comprehension values {cp[0]},{cp[1]}");
}

/// The control the report identified: the `for` STATEMENT was always right, because it
/// already ended on LENGTH. It must stay right.
fn test_1000_for_statement_control() {
  s = 0;
  for v in v1000_pair() { s += v1000_tenx(v); }
  assert(s == 30, "for statement {s}, want 30");
}

/// An EMPTY vector hung too — the callback ran forever with nothing to read. Nothing to do
/// with the element count, which is the point of the cell.
fn test_1000_empty_vector() {
  none: vector<V1000> = [];
  m = map(none, |v| { v.x });
  assert(len(m) == 0, "empty map yielded {len(m)}");
  assert(reduce(none, 7, |acc, v| { acc + v.x }) == 7, "empty reduce lost its init");
  assert(!any(none, |v| { v.x > 0 }), "empty any");
  assert(all(none, |v| { v.x > 0 }), "empty all is vacuously true");
}

/// A longer vector, so "2" is not accidentally the rule.
fn test_1000_five_elements() {
  five: vector<V1000> = [];
  for i in 1..=5 { five += [V1000 { x: i }]; }
  assert(len(map(five, |v| { v.x })) == 5, "map over five");
  assert(reduce(five, 0, |acc, v| { acc + v.x }) == 15, "reduce over five");
}

/// A plain `struct` was correct in every cell — `value` was the only axis, and it must
/// stay correct now that both share one termination rule.
struct P1000 { x: integer }

fn test_1000_plain_struct_control() {
  ps = [P1000 { x: 1 }, P1000 { x: 2 }];
  m = map(ps, |v| { v.x * 10 });
  assert(len(m) == 2 && m[0] == 10 && m[1] == 20, "plain struct map");
  assert(reduce(ps, 0, |acc, v| { acc + v.x }) == 3, "plain struct reduce");
}

/// A vector holding a real NULL element is the OTHER shape that shares the out-of-bounds
/// sentinel — length-based termination must walk past it rather than stop there.
fn test_1000_scalar_vector_still_walks() {
  ns: vector<integer> = [1, 2, 3];
  assert(reduce(ns, 0, |acc, n| { acc + n }) == 6, "scalar reduce");
  assert(len(map(ns, |n| { n * 2 })) == 3, "scalar map");
}
