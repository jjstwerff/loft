// @PLN35 slice 1 (L3.4) — SCALAR type-annotated slice captures on a `vector<Scalar>`:
//   • `name:Type`      — a single element, type-as-match (always holds for the element type).
//   • `name:Type*`/`+` — a bare-postfix repetition (no parens) collected into a FRESH
//     `vector<Type>`.  The scalar type matches every element, so the run takes exactly the
//     middle (`end = len - tail_len`); a fixed literal head / tail pins the ends.  `*` =
//     zero-or-more, `+` requires a non-empty run.  Graduated from the golden
//     `doc/claude/plans/35-match-peg/probes/g-p6-repetition.loft`.  Cross-mode + leak-checked.

// The golden: head literal + `*` repetition, and a single `name:Type` capture in a sibling arm.
fn dispatch(v: vector<integer>) -> text {
  match v {
    [1, args: integer *] => "call/{args.len()}",
    [0, one: integer] => "set {one}",
    _ => "unknown",
  }
}

// No head, `*` — collect the whole vector (matches even when empty).
fn whole(v: vector<integer>) -> integer {
  match v { [xs: integer *] => xs.len(), _ => -1 }
}

// `+` requires at least one element.
fn plus(v: vector<integer>) -> integer {
  match v { [xs: integer +] => xs.len(), _ => -1 }
}

// `*` with a fixed literal tail: the run is the middle, the last element must be 99.
fn midtail(v: vector<integer>) -> integer {
  match v { [xs: integer *, 99] => xs.len(), _ => -1 }
}

// Head literal + `*` + literal tail: `[ 1, xs*, 9 ]`.
fn wrapped(v: vector<integer>) -> integer {
  match v { [1, xs: integer *, 9] => xs.len(), _ => -1 }
}

// Value + order: the collected run holds the right elements (read via a nested slice match).
fn firsttwo(v: vector<integer>) -> integer {
  match v {
    [7, xs: integer *] => match xs { [a, b, ..] => a * 10 + b, _ => -1 },
    _ => -9,
  }
}

fn main() {
  // golden matrix
  assert(dispatch([1, 5, 6, 7]) == "call/3", "dispatch call3: {dispatch([1, 5, 6, 7])}");
  assert(dispatch([1]) == "call/0", "dispatch call0: {dispatch([1])}");
  assert(dispatch([0, 42]) == "set 42", "dispatch set: {dispatch([0, 42])}");
  assert(dispatch([9]) == "unknown", "dispatch none -> _: {dispatch([9])}");

  // whole / plus
  assert(whole([1, 2, 3]) == 3, "whole 3: {whole([1, 2, 3])}");
  assert(whole([]) == 0, "whole empty: {whole([])}");
  assert(plus([5]) == 1, "plus 1: {plus([5])}");
  assert(plus([]) == -1, "plus empty -> _: {plus([])}");

  // literal tail
  assert(midtail([1, 2, 99]) == 2, "midtail run2: {midtail([1, 2, 99])}");
  assert(midtail([99]) == 0, "midtail run0: {midtail([99])}");
  assert(midtail([1, 2, 3]) == -1, "midtail no 99 -> _: {midtail([1, 2, 3])}");

  // head + tail
  assert(wrapped([1, 5, 6, 9]) == 2, "wrapped run2: {wrapped([1, 5, 6, 9])}");
  assert(wrapped([1, 9]) == 0, "wrapped run0: {wrapped([1, 9])}");
  assert(wrapped([2, 9]) == -1, "wrapped bad head -> _: {wrapped([2, 9])}");
  assert(wrapped([1, 5]) == -1, "wrapped bad tail -> _: {wrapped([1, 5])}");

  // value + order
  assert(firsttwo([7, 3, 4, 5]) == 34, "firsttwo: {firsttwo([7, 3, 4, 5])}");
  assert(firsttwo([7, 3]) == -1, "firsttwo short run: {firsttwo([7, 3])}");
  assert(firsttwo([2, 3, 4]) == -9, "firsttwo bad head: {firsttwo([2, 3, 4])}");

  print("35f-repetition: PASS");
}
