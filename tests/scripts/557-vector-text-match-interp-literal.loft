//
// #557 (a #552 sibling) — a match on a `vector<text>` subject with one arm returning an
// interpolation (owned `String`) and another a bare literal (`&str`) failed to compile on native
// (`E0308: expected &str, found String`).  Root cause: the vector-match on a `vector<text>`
// appends an `OpFreeText` to free its bound element, so `output_block` materialises the block's
// tail as an owned `String` (`let _ret = …; free; _ret.to_string()`) — but the `Str::new(<block>)`
// return wrapper expects `&str`.  Fix: the return path detects a text block whose tail
// materialises a `String` (`block_tail_materialises_string`) and routes it through the work
// buffer, exactly like the `??`/ncc case.  Both backends.

fn tag(v: vector<text>) -> text {
  match v {
    [ x ]    => "one:{x}",   // interpolation -> owned String
    [ x, y ] => "two:{x}{y}",
    _        => "none",      // bare literal -> &str
  }
}

// literal arm first, interpolation second (order-independent).
fn first_lit(v: vector<text>) -> text {
  match v { [ x ] => "lit", [ x, y ] => "z{x}{y}", _ => "w" }
}

fn main() {
  assert(tag(["a"]) == "one:a", "one:a — {tag([\"a\"])}");
  assert(tag(["a", "b"]) == "two:ab", "two:ab — {tag([\"a\", \"b\"])}");
  assert(tag([]) == "none", "none — {tag([])}");

  assert(first_lit(["m"]) == "lit", "lit — {first_lit([\"m\"])}");
  assert(first_lit(["m", "n"]) == "zmn", "zmn — {first_lit([\"m\", \"n\"])}");
  assert(first_lit([]) == "w", "w — {first_lit([])}");

  print("557 vector<text> match interp/literal ok\n");
}
