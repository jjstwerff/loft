//
// Regression: the one-buffer vector return ABI must DELIVER at every return
// site, and a delivery REPLACES the buffer's content (#355 fallout: the
// 93-vsort suite leak, plus loop-accumulation wrong results that predate it).
// Probe matrix: /tmp-era cells from the 2026-06-12 session — callee shape
// {bare wrapper, named-local mid + call tail, call mid + local tail, all-call}
// × consumption {assign, nested-arg, loop, forward-caller}, plus the nested
// `vector<vector<T>>` element-stride family (`vector_add` strode rows by the
// 4-byte field-slot size instead of the read path's clamped content size).

fn mk(a: integer) -> vector<integer> {
  lit = [a, a + 1]; lit
}

fn vsum(v: vector<integer>) -> integer {
  t = 0; for x in v { t = t + x; } t
}

// Named-local mid-return + call-chain tail (the vsort shape).
fn f_b(n: integer) -> vector<integer> {
  if n == 0 {
    base = [7, 8]; return base;
  }
  mk(n)
}

// Call-chain mid-return + named-local tail (the #355 shape).
fn f_c(n: integer) -> vector<integer> {
  if n == 0 { return mk(9); }
  lit = [n, n]; lit
}

// All sites call-chain.
fn f_d(n: integer) -> vector<integer> {
  if n == 0 { return mk(9); }
  mk(n)
}

// Bare wrapper (#120 shape).
fn f_a(n: integer) -> vector<integer> {
  mk(n)
}

// A call inside a loop reuses the caller's fn-scoped hidden buffer: without
// the clear-on-entry each iteration's delivery piled onto the previous one
// (acc read 39/207/246/255 instead of these values — on BOTH backends, and
// the a/b shapes were wrong on main before #355 too).
fn test_loop_delivery_replaces() {
  acc_a = 0;
  for k in 0..6 { acc_a = acc_a + vsum(f_a(k % 2)); }
  assert(acc_a == 12, "a/loop acc={acc_a} expect 12");
  acc_b = 0;
  for k in 0..6 { acc_b = acc_b + vsum(f_b(k % 2)); }
  assert(acc_b == 54, "b/loop acc={acc_b} expect 54");
  acc_c = 0;
  for k in 0..6 { acc_c = acc_c + vsum(f_c(k % 2)); }
  assert(acc_c == 63, "c/loop acc={acc_c} expect 63");
  acc_d = 0;
  for k in 0..6 { acc_d = acc_d + vsum(f_d(k % 2)); }
  assert(acc_d == 66, "d/loop acc={acc_d} expect 66");
}

// Non-loop consumption shapes stay value-correct.
fn test_assign_and_arg_delivery() {
  v1 = f_b(0);
  v2 = f_b(3);
  assert(vsum(v1) == 15 && vsum(v2) == 7, "b/assign {vsum(v1)} {vsum(v2)}");
  s = vsum(f_c(0))+vsum(f_c(3));
  assert(s == 25, "c/arg s={s} expect 25");
}

// The 93-vsort shape: a recursive vector-returning fn whose tail call
// consumes two nested call results.  Leaked 15 intermediate stores when the
// tail chained into a non-delivering callee (the wrap-suite leak gate
// catches the leak half; this guards the values).
fn vb_merge(lp: vector<integer>, rp: vector<integer>) -> vector<integer> {
  out = [for mg_i in 0..0 { mg_i }];
  li = 0; ri = 0;
  ll = len(lp); rl = len(rp);
  for _mg_step in 0.. (ll + rl) {
    if li >= ll && ri >= rl { break; }
    if li >= ll {
      out += [rp[ri]]; ri += 1;
    }
    else if ri >= rl {
      out += [lp[li]]; li += 1;
    }
    else if lp[li] <= rp[ri] {
      out += [lp[li]]; li += 1;
    }
    else {
      out += [rp[ri]]; ri += 1;
    }
  }
  out
}

fn vb_sort(arr: vector<integer>, lo: integer, hi: integer) -> vector<integer> {
  sz = hi - lo;
  if sz <= 1 {
    base = [for ms_i in 0..0 { ms_i }];
    if sz == 1 { base += [arr[lo]]; }
    return base;
  }
  mid = lo + sz / 2;
  vb_merge(vb_sort(arr, lo, mid), vb_sort(arr, mid, hi))
}

fn test_recursive_tail_consumers() {
  data = [3, 1, 4, 1, 5, 9, 2, 6];
  out = vb_sort(data, 0, 8);
  assert(out[0] == 1 && out[3] == 3 && out[7] == 9, "sort {out[0]} {out[3]} {out[7]}");
}

// Nested vector<vector<T>> concat — `vector_add` must stride rows by the
// read path's element size and deep-copy each row's inner claims (rows were
// silently corrupted on every nested `+=` before).
fn test_nested_concat() {
  a: vector<vector<integer>> = [[9]];
  a += [[1], [2]];
  assert(
    len(a) == 3 && a[0][0] == 9 && a[1][0] == 1 && a[2][0] == 2,
    "int rows {a[0][0]} {a[1][0]} {a[2][0]}"
  );
  t: vector<vector<text>> = [["q"]];
  t += [["ab"], ["cd"]];
  assert(len(t) == 3 && t[1][0] == "ab" && t[2][0] == "cd", "text rows {t[1][0]} {t[2][0]}");
  bv: vector<vector<boolean>> = [[true]];
  bv += [[false, true]];
  assert(len(bv) == 2 && !bv[1][0] && bv[1][1], "bool rows");
  s: vector<vector<single>> = [[1.0f]];
  s += [[2.5f], [3.5f]];
  assert(len(s) == 3 && s[1][0] == 2.5f && s[2][0] == 3.5f, "single rows");
  d3: vector<vector<vector<integer>>> = [[[7]]];
  d3 += [[[1, 2], [3]]];
  assert(
    len(d3) == 2 && d3[1][0][0] == 1 && d3[1][0][1] == 2 && d3[1][1][0] == 3,
    "depth-3 rows {d3[1][0][0]} {d3[1][1][0]}"
  );
}

// A REASSIGNED nested local at the body tail copy-delivers through the same
// `vector_add` path (the 173-reassign-return `nested()` shape that surfaced
// the stride bug).
fn re_nested() -> vector<vector<integer>> {
  z: vector<vector<integer>> = [[9]];
  z = [[1], [2]];
  z
}

fn test_nested_redelivery() {
  d = re_nested();
  assert(len(d) == 2 && d[0][0] == 1 && d[1][0] == 2, "redeliver {d[0][0]} {d[1][0]}");
}

// FORWARD caller (parsed before its callee) of a multi-return-site vector
// fn — the original #355 wrong-element shape.  A forward caller can only
// consult the callee's signature, which is why delivery must be
// signature-derivable for every loft-bodied vector fn.
fn use_pickv(json: text) -> vector<integer> {
  pickv(json)
}

fn pickv(json: text) -> vector<integer> {
  if json == "" { return mkv(1); }
  result = mkv(2);
  if json == "bad" { return mkv(3); }
  result
}

fn mkv(n: integer) -> vector<integer> {
  v: vector<integer> = []; v += [n]; v
}

fn test_forward_caller_elements() {
  a = use_pickv("");
  b = use_pickv("x");
  c = use_pickv("bad");
  assert(a[0] == 1 && b[0] == 2 && c[0] == 3, "forward {a[0]} {b[0]} {c[0]} expect 1 2 3");
  assert(len(a) == 1 && len(b) == 1 && len(c) == 1, "forward lens");
}
