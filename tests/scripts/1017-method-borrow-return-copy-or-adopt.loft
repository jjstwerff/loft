//
// The `--native` copy-or-adopt guard was gated on a NAME, so a METHOD never got it.
//
// A callee whose return may be a BORROW of an argument cannot have its result aliased into a
// caller local: the local's own `OpFreeRef` would then whole-store-free the caller's receiver.
// `dispatch.rs` handles that — it emits the @P290 protect bracket around the call and a
// copy-or-adopt guard after it (`_src` aliases the receiver → deep copy; `_src` is
// callee-minted → adopt).  The gate read `name().starts_with("n_")`, so a `t_` METHOD, with a
// byte-identical body and the same `return_adopts_fresh_store()` verdict, fell through to a
// plain alias with no bracket and no copy.
//
// Measured on the pre-fix binary, over the accessor shape loft#1017 reports:
//
//     i=0 x=1.5   i=1 x=3.5   i=2 x=0   i=3 x=0   i=4 x=0   i=5 x=0
//                                        ^^^ every read after the FRESH arm ran
//
// The borrow arm's read is correct, THEN its store is freed; the fresh arm's next allocation
// recycles that slot and overwrites the receiver's records.  In `stage` the recycled slot was a
// canvas, so the record number read back as the clear colour `0xFF000000`.
//
// Both halves of the boundary are asserted, because either alone passes: the fresh arm must be
// reached AND the borrow arm must be read afterwards.  The identical body written as a FREE
// function was correct throughout, which is what named the gate (loft#1017).

struct V1017 { x: float, y: float, w: integer, h: integer }
struct St1017 { vs: vector<V1017> }

// A bounds guard answering a FRESH record, a tail answering a BORROW of an element.
fn view_at1017(self: const St1017, i: integer) -> V1017 {
  if i < 0 or i >= len(self.vs) { return V1017 { x: 0.0, y: 0.0, w: 0, h: 0 }; }
  self.vs[i] ?? V1017 { x: 0.0, y: 0.0, w: 0, h: 0 }
}

// The same body as a FREE function — correct on both backends throughout, so it pins that the
// method spelling was the axis and nothing else.
fn view_free1017(st: St1017, i: integer) -> V1017 {
  if i < 0 or i >= len(st.vs) { return V1017 { x: 0.0, y: 0.0, w: 0, h: 0 }; }
  st.vs[i] ?? V1017 { x: 0.0, y: 0.0, w: 0, h: 0 }
}

// Two fields rather than a collection: the borrow source does not have to be an element.
struct Pair1017 { a: V1017, b: V1017 }
fn pick1017(self: const Pair1017, i: integer) -> V1017 {
  if i < 0 or i > 1 { return V1017 { x: 0.0, y: 0.0, w: 0, h: 0 }; }
  if i == 0 { self.a } else { self.b }
}

fn stage1017() -> St1017 {
  St1017 { vs: [V1017 { x: 1.5, y: 2.5, w: 4, h: 5 },
                V1017 { x: 3.5, y: 4.5, w: 6, h: 7 }] }
}

fn test_a_method_borrow_survives_the_fresh_arm_running() {
  s = stage1017();
  // i % 3 cycles borrow, borrow, FRESH — so the second round reads what the fresh arm's
  // allocation would have recycled.  1.5 + 3.5 + 0 twice.
  t = 0.0;
  for i in 0..6 { t += view_at1017(s, i % 3).x; }
  assert(t == 10.0, "the receiver survives the fresh arm, got {t}");
}

fn test_the_reads_are_right_one_by_one() {
  // The sum alone would also pass if two errors cancelled.  Name the cell that moved.
  s = stage1017();
  assert(view_at1017(s, 0).x == 1.5, "first borrow");
  assert(view_at1017(s, 1).x == 3.5, "second borrow");
  assert(view_at1017(s, 2).x == 0.0, "the guard answers the fresh record");
  assert(view_at1017(s, 0).x == 1.5, "the borrow AFTER the fresh arm — the cell that read 0");
  assert(view_at1017(s, 1).x == 3.5, "and the second one");
}

fn test_the_result_bound_to_a_local_behaves_the_same() {
  // Inline-read versus bound was NOT the axis; assert it so a narrower fix cannot pass.
  s = stage1017();
  t = 0.0;
  for i in 0..6 { v = view_at1017(s, i % 3); t += v.x; }
  assert(t == 10.0, "bound to a local, got {t}");
}

fn test_a_borrowed_field_rather_than_an_element() {
  p = Pair1017 { a: V1017 { x: 1.5, y: 2.5, w: 4, h: 5 },
                 b: V1017 { x: 3.5, y: 4.5, w: 6, h: 7 } };
  t = 0.0;
  for i in 0..6 { t += pick1017(p, i % 3).x; }
  assert(t == 10.0, "a field borrow, got {t}");
}

fn test_the_free_function_spelling_is_unchanged() {
  s = stage1017();
  t = 0.0;
  for i in 0..6 { t += view_free1017(s, i % 3).x; }
  assert(t == 10.0, "the free-function control, got {t}");
}

fn test_the_borrow_arm_alone_is_untouched() {
  // Never reaching the fresh arm must keep answering the elements — a fix that copies too
  // eagerly would still pass the cells above and break this one's identity.
  s = stage1017();
  t = 0.0;
  for i in 0..6 { t += view_at1017(s, i % 2).x; }
  assert(t == 15.0, "borrow arm only, got {t}");
}
