//
// #354 — three native-codegen shapes from crawler's sim/terrain code.
// Cross-mode: the interpreter treats locals as function-scoped frame
// slots; native must not lose them to Rust block scoping.
//
// 1. SCOPE HOIST: a local first WRITTEN inside one `if` block and read
//    in a SIBLING `if` block later — native emitted the `let` inside
//    the first block (E0425 "cannot find value" at the second).
// 2. DISCARD LOOP VAR: `_` shares one variable-table entry across all
//    loops, so a float-typed first loop made a later integer-range
//    loop yield i64 into an f64 `let` (E0308).
// 3. NCC BOOL BLOCK: `(v[i] ?? false)` inside an `&&` chain — the ncc
//    Block arm casts itself to u8 while the `false` else-arm stayed
//    `bool` (E0308 "if and else have incompatible types").

struct Probe {
  p_flags: vector<boolean>,
}

fn classify(depth: integer, w: integer) -> integer {
  total = 0;
  if depth == 0 {
    intown = w > 2;
    nhouse = 3 + w * 2;
    scale = 1.5 * w as float;
    for r in 0..w {
      for q in 0..w { total = total + r * q; }
    }
    if intown { total = total + nhouse; }
    total = total + scale as integer;
  }
  // The sibling block: reads the locals the first block wrote.
  if depth == 0 {
    intown2 = w > 2;
    if intown2 { total = total + 1000; }
  }
  if depth == 0 {
    // re-read across yet another boundary
    for k in 0..2 { total = total + k; }
  }
  total
}

fn float_then_int_loops(vals: vector<float>) -> integer {
  n = 0;
  for _ in vals { n = n + 1; }
  for _ in 0..5 { n = n + 10; }
  n
}

fn ncc_bool_gate(p: Probe, idx: integer, lim: integer) -> integer {
  hits = 0;
  for i in 0..lim {
    if 0 <= idx && idx < lim && (p.p_flags[idx] ?? false) { hits = hits + 1; }
  }
  hits
}

fn main() {
  a = classify(0, 4);
  // 0..4×0..4 products sum = 36; intown(4>2) → +11; scale 6.0 → +6;
  // sibling +1000; third block +1.
  assert(a == 36 + 11 + 6 + 1000 + 1, "scope hoist: {a}");
  b = classify(1, 4);
  assert(b == 0, "depth!=0 path: {b}");

  fv: vector<float> = [];
  fv += [1.5]; fv += [2.5]; fv += [3.5];
  c = float_then_int_loops(fv);
  assert(c == 3 + 50, "discard loop var: {c}");

  pr = Probe { p_flags: [] };
  pr.p_flags += [true]; pr.p_flags += [false]; pr.p_flags += [true];
  d = ncc_bool_gate(pr, 0, 3);
  e = ncc_bool_gate(pr, 1, 3);
  assert(d == 3 && e == 0, "ncc bool block: {d} {e}");

  println("300-native-scope-hoist ok");
}
