//
// A join whose arms disagree about OWNERSHIP leaked the OWNING arm's record — once per
// evaluation, unbounded in a loop, on both backends.
//
// `formal/ownership.md` settles the shape: such a join is classified conservatively as a
// VIEW, and that is correct *"because the OWNED arm is materialised into the return buffer
// whose own lifetime frees it"*.  The materialisation was the half that did not exist.  It
// was fixed for `??` at its own site (loft#1013); a plain `if`, an `else if` chain and every
// `match` form still handed back a store owned by no frame while the consumer read the join
// as a borrow and freed nothing (loft#1019).
//
// The harness's leak check is what this file asserts; the values are here so a fix that
// silences the leak by dropping an arm would fail too.  The cells below are the axes that
// moved independently in the boundary matrix — which SIDE owns, how many arms, `if` vs
// `match`, and a free function vs a METHOD (a name-shaped gate covered `mk()` and left
// `bx.make()` leaking, the same mistake loft#1017 was).

struct S1019 { a: integer }
struct B1019 { q: integer }

fn mk1019() -> S1019 { S1019 { a: -1 } }
fn mk1019b() -> S1019 { S1019 { a: -2 } }
fn make(self: B1019) -> S1019 { S1019 { a: self.q } }

// A callee answering a borrowed VIEW of its argument allocated nothing — this frame may
// free none of what it points at, so the fix must leave this arm alone.
fn view1019(s: S1019) -> S1019 { s }

fn test_an_owning_else_arm_is_freed() {
  v: vector<S1019> = [S1019 { a: 7 }];
  n = 5;
  m = if n < len(v) { v[n] } else { mk1019() };
  assert(m.a == -1, "the else arm answers the fresh record");
}

fn test_an_owning_then_arm_is_freed() {
  // The mirror cell: which SIDE owns is not the axis.
  v: vector<S1019> = [S1019 { a: 7 }];
  n = 5;
  m = if n > len(v) { mk1019() } else { v[0] };
  assert(m.a == -1, "the then arm answers the fresh record");
}

fn test_it_does_not_scale_with_the_iteration_count() {
  // Five iterations leaked four records before — one per run of the owning arm.
  v: vector<S1019> = [S1019 { a: 7 }];
  t = 0;
  for i in 0..5 {
    m = if i < len(v) { v[i] } else { mk1019() };
    t += m.a;
  }
  assert(t == 3, "one hit and four misses, got {t}");
}

fn test_an_else_if_chain_frees_every_owning_arm() {
  v: vector<S1019> = [S1019 { a: 7 }];
  t = "";
  for i in 0..3 {
    m = if i == 0 { v[0] } else if i == 1 { mk1019() } else { mk1019b() };
    t = "{t}{m.a},";
  }
  assert(t == "7,-1,-2,", "each arm answers its own value, got {t}");
}

fn test_a_match_join_frees_its_owning_arm() {
  // `match` lowers to the same tree of `if`s, so it carries the same disagreement.
  v: vector<S1019> = [S1019 { a: 7 }];
  n = 5;
  m = match n { 0 => v[0], _ => mk1019() };
  assert(m.a == -1, "the wildcard arm answers the fresh record");
}

fn test_a_method_arm_is_freed_too() {
  // A METHOD is stored as `t_<LEN><Type>_<method>`, so a gate shaped on the `n_` prefix
  // cured the free function and left this one leaking.
  bx = B1019 { q: -4 };
  v: vector<S1019> = [S1019 { a: 7 }];
  n = 5;
  m = if n < len(v) { v[n] } else { bx.make() };
  assert(m.a == -4, "the method arm answers the fresh record");
}

fn test_the_cells_that_were_always_clean_stay_clean() {
  // A fix must not start freeing the ELEMENT the borrow arm delivers (the hit path), nor
  // double-free the literal's own work-ref, nor claim a store a callee only VIEWS.
  v: vector<S1019> = [S1019 { a: 7 }];
  h = if 0 < len(v) { v[0] } else { mk1019() };
  assert(h.a == 7, "the hit path answers the element, not the default");
  l = if 5 < len(v) { v[5] } else { S1019 { a: -3 } };
  assert(l.a == -3, "a literal arm still answers");
  keep = S1019 { a: 8 };
  w = if 5 < len(v) { v[5] } else { view1019(keep) };
  assert(w.a == 8, "a view-returning callee still answers");
  assert(keep.a == 8, "and what it viewed is untouched");
}

fn test_a_join_whose_arms_all_own_still_delivers_owned() {
  // Every arm owned means the join is owned and the CONSUMER frees it — a buffer here
  // would free the one store twice.
  n = 5;
  m = if n < 3 { mk1019() } else { mk1019b() };
  assert(m.a == -2, "an all-owning join answers its taken arm");
}

fn test_the_join_escaping_its_frame_is_not_freed_underneath_the_caller() {
  // The owning arm is materialised into a buffer THIS frame frees, so a join returned
  // from a function must not hand the caller a released store.
  v: vector<S1019> = [S1019 { a: 7 }];
  p = pick1019(v, 5);
  assert(p.a == -1, "the escaped miss still reads its value");
  h = pick1019(v, 0);
  assert(h.a == 7, "and the escaped hit still reads the element");
}

fn pick1019(v: vector<S1019>, n: integer) -> S1019 {
  if n < len(v) { v[n] } else { mk1019() }
}
