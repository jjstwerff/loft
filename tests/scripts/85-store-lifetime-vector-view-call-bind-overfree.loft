// @PLN85 step-6 / Cluster-A A.3 regression — a call that returns a BORROWED
// VECTOR-element view (`fn pick(t: vector<M>) -> M { t[i] }`), bound to a local
// and later freed, must NOT whole-store-free the caller's vector.
//
// Native re-derived the own-vs-borrow fact from a coarse type-shape proxy
// ("callee has a visible Reference/Enum param") and so MISSED this shape: `t` is
// a `vector<M>` param, not a Reference param, yet the return aliases it.  The
// bound local was adopted as owned; its scope-exit `OpFreeRef` then freed the
// vector's store, which allocation pressure recycled — corrupting the table.
// Interp was correct (it reads the canonical `return_adopts_fresh_store()`
// fact); the fix routes native through the SAME fact.
//
// Distinct from 150-i306 (which masks the bug behind a `best = cand` reassignment
// deep-copy): here the local is freed at plain scope exit, no reassignment — the
// universal first-bind form.  Dense-element vectors (`vector<M>`) only — the
// shape the proxy never covered.

struct M { hp: integer, depth: integer, name: text }

fn m_none() -> M { M { hp: 0, depth: 0, name: "" } }

// returns a borrowed view of a vector-element (no Reference/Enum param)
fn pick(table: vector<M>, idx: integer) -> M {
  chosen = table[idx] ?? m_none();
  chosen
}

// allocation pressure: same-shaped allocations that recycle a freed slot.
fn filler(n: integer) -> integer {
  es: vector<M> = [];
  for j in 0..n { es += [M { hp: j, depth: j, name: "RECYCLE-{j}" }]; }
  return len(es);
}

fn main() {
  t: vector<M> = [];
  t += [M { hp: 5, depth: 3, name: "rat" }];
  t += [M { hp: 8, depth: 5, name: "bat" }];

  for i in 0..6 {
    a = pick(t, i % 2 ?? 0);          // a := borrowed view of t[idx]
    // recycle the slot the scope-exit free of `a` would wrongly release:
    acc = 0;
    for f in 0..6 { acc += filler(4); }
    assert(acc == 24, "iter {i}: filler churn ran");
    assert(len(t) == 2, "iter {i}: len(t)={len(t)} (expect 2 — no over-free)");
    assert(a.depth == 3 || a.depth == 5, "iter {i}: a.depth={a.depth}");
    first = t[0] ?? m_none();
    assert(first.name == "rat", "iter {i}: t[0] intact, got '{first.name}'");
  }
  println("vector-view-call-bind-overfree ok");
}
