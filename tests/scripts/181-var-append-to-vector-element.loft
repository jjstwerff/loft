//
// Regression (GitHub #261): appending a vector VARIABLE to a vector ELEMENT
// (`c[i] += other`) failed NATIVE compilation with E0499 — the default
// OpAppendVector template inlined the element-read target (which borrows
// `*stores` via vec_get_or_raise) into the `vector_add(&mut stores)` call,
// double-borrowing `*stores`. The fix hoists both operands into `let` temps
// first (mirrors clear_vector). Runs through interp + native + wasm.

fn main() {
  // var-append to a vector element
  c: vector<vector<integer>> = [[1]];
  add: vector<integer> = [4, 5];
  c[0] += add;
  assert(len(c[0]) == 3 && c[0][2] == 5, "c[0]={c[0]}");

  // repeated var-append + source that is ITSELF an inline element read
  d: vector<integer> = [9];
  c[0] += d;
  src: vector<vector<integer>> = [[7], [8]];
  c[0] += src[1];
  assert(len(c[0]) == 5 && c[0][3] == 9 && c[0][4] == 8, "c[0]={c[0]}");

  // plain-local var-append still works (no regression)
  v: vector<integer> = [1];
  a: vector<integer> = [2, 3];
  v += a;
  assert(len(v) == 3 && v[2] == 3, "v={v}");

  println("var-append-to-vector-element ok");
}
