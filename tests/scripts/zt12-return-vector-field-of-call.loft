// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Regression: `return f().field` where the field is a heap VECTOR returned a value
// backed by a freed store (zero-trust § 12).
//
// The inline call is lifted to a `__lift_N` temp that the function frees on the way
// out, so returning a vector field of it hands the caller a view into freed memory.
// On `--native` the result is EMPTY from the start; the consumer met it on the
// interpreter as a value that a LATER store-allocating call in the caller transiently
// clobbered to length 0 — a one-line accessor silently corrupting its result.
//
// This is the THIRD sibling of one defect. `#425` fixed the struct-field form, `H12`
// the vector-element form, and the explicit-return VECTOR arm still selected its
// buffer with a Var-only predicate (`#488`), so a projection rooted at a CALL
// temporary fell through: the field read was emitted as a discarded statement and the
// function returned an empty buffer. All three now route through
// `return_projects_into_local`, and the emitted shape is the one the working `l = f();
// return l.lines` form already produced — clear the caller's buffer, append the
// elements into it, return the buffer.
//
// The boundary is narrow, which is why the controls matter. Only the EXPLICIT return
// of a projection ONE hop off the call was broken: the implicit tail (c3) already went
// through `block_result`'s #437 intercept, and a CHAINED projection (c7) was already
// delivered through a materialised work-ref. Element width is NOT an axis — struct,
// `integer` and `u8` elements all failed identically, which is what distinguishes this
// from the width faults in the same family.
//
// Every cell must read 2 on BOTH backends. c2 and c6-c9 were already correct before
// the fix and must stay so: without them, a change that copies every vector return
// into the buffer would pass — and that would break the fresh-local return (c9), whose
// construction block cannot sit in `OpAppendVector`'s argument position.

struct Line { n: integer }
struct Inner { lines: vector<Line> }
struct Flow {
  lines: vector<Line>,
  nums: vector<integer>,
  bytes: vector<u8>,
  inner: Inner,
}
struct Holder { copy: vector<Line> }

fn mk() -> Flow {
  v: vector<Line> = [];
  v += [Line { n: 7 }];
  v += [Line { n: 9 }];
  ns: vector<integer> = [];
  ns += [41];
  ns += [43];
  bs: vector<u8> = [];
  bs += [5 as u8? ?? 0];
  bs += [6 as u8? ?? 0];
  iv: vector<Line> = [];
  iv += [Line { n: 21 }];
  iv += [Line { n: 23 }];
  Flow { lines: v, nums: ns, bytes: bs, inner: Inner { lines: iv } }
}

// 1 — the reported shape: explicit return of a vector field of an inline call.
fn c1() -> vector<Line> { return mk().lines; }
// 2 — CONTROL: bind the struct to a local first.  The consumer's own workaround, and
//     the shape whose emitted IR is the spec the fix reproduces.
fn c2() -> vector<Line> { l = mk(); return l.lines; }
// 3 — CONTROL: the implicit tail was already correct (#437 tail intercept).
fn c3() -> vector<Line> { mk().lines }
// 4 — scalar element type: the fault is the projection, not the element width.
fn c4() -> vector<integer> { return mk().nums; }
// 5 — narrow element type, the width axis that mattered elsewhere in this family.
fn c5() -> vector<u8> { return mk().bytes; }
// 6 — CONTROL: argument-rooted.  The CALLER owns that store, so the view outlives the
//     call and must keep its existing dep-driven delivery.
fn c6(f: Flow) -> vector<Line> { return f.lines; }
// 7 — CONTROL: a CHAINED projection, already delivered via a materialised work-ref.
fn c7() -> vector<Line> { return mk().inner.lines; }
// 8 — CONTROL: the projection inside a struct literal, which never tripped this (it is
//     why the consumer's per-box render path was unaffected while one accessor broke).
fn c8() -> Holder { return Holder { copy: mk().lines }; }
// 9 — CONTROL: a fresh local vector (#437).  Must keep its NRVO delivery.
fn c9() -> vector<Line> {
  o: vector<Line> = [];
  o += [Line { n: 7 }];
  o += [Line { n: 9 }];
  return o;
}

/// A store-allocating call, to reproduce the consumer's transient-clobber axis: the
/// returned view was live until an allocation in the caller recycled the freed region.
fn churn() -> vector<integer> {
  v: vector<integer> = [];
  for i in 0..40 { v += [i]; }
  v
}

fn main() {
  a = c1();
  assert(len(a) == 2, "c1 vector field of an inline call: {len(a)}");
  assert((a[0] ?? Line { n: 0 }).n == 7, "c1 first element by value");
  assert((a[1] ?? Line { n: 0 }).n == 9, "c1 second element by value");

  b = c2();
  assert(len(b) == 2, "c2 bound-first control: {len(b)}");
  c = c3();
  assert(len(c) == 2, "c3 implicit-tail control: {len(c)}");
  d = c4();
  assert(len(d) == 2, "c4 vector<integer> field: {len(d)}");
  assert((d[1] ?? 0) == 43, "c4 element by value");
  e = c5();
  assert(len(e) == 2, "c5 vector<u8> field: {len(e)}");
  assert((e[1] ?? 0) == 6, "c5 element by value");

  g = mk();
  h = c6(g);
  assert(len(h) == 2, "c6 argument-rooted control: {len(h)}");
  i = c7();
  assert(len(i) == 2, "c7 chained-projection control: {len(i)}");
  assert((i[0] ?? Line { n: 0 }).n == 21, "c7 reads the INNER vector, not the outer");
  j = c8();
  assert(len(j.copy) == 2, "c8 struct-literal control: {len(j.copy)}");
  k = c9();
  assert(len(k) == 2, "c9 fresh-local control: {len(k)}");

  // The transient axis: an allocation in the caller must not disturb an earlier result.
  z = churn();
  assert(len(z) == 40, "churn allocated");
  assert(len(a) == 2, "c1 survives a later allocating call: {len(a)}");
  assert((a[0] ?? Line { n: 0 }).n == 7, "c1 still reads its own elements after churn");
  println("zt12 ok");
}
