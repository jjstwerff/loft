// Float format with PRECISION ZERO (`{m:1.0}`) — was a parser ICE
// (Option::unwrap on the absent fraction: the dotted spec parses into a
// float whose Display drops the trailing `.0`).  Reported by the routing
// consumer (docs/loft-feedback.md, 2026-07-02).

fn test_precision_zero_rounds() {
  fz_m = 850.5;
  fz_s = "{fz_m:1.0}";
  assert(fz_s == "850" || fz_s == "851", "precision 0: {fz_s}");
  fz_t = "{fz_m:6.0}";
  assert(len(fz_t) == 6, "width 6 precision 0: '{fz_t}'");
}

fn test_nonzero_precision_unchanged() {
  fn_m = 850.5;
  assert("{fn_m:1.1}" == "850.5", "precision 1: {fn_m:1.1}");
  assert("{fn_m:4.2}" == "850.50", "precision 2: {fn_m:4.2}");
}
