// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Regression (loft#695): a closure that mutates a captured scalar freed that scalar's
// backing cell when the CLOSURE's scope ended, not the captured variable's.  Put the
// closure in any nested block and read the variable afterwards, and the read landed on
// freed memory.
//
// `scopes.rs` always emits `OpFreeRef` for a fn-ref at ITS scope exit, and that free is
// what triggers the closure record's capture cascade.  The design is deliberate — the
// frame's own free of a captured cell is suppressed (`captured_ref`) so the cascade is
// its single owner, which is what lets an escaping factory closure outlive its frame
// (#323).  The unstated assumption was that the fn-ref is never scoped TIGHTER than what
// it captures.  A closure in a nested block is exactly that:
//
//     b          fn    scope=2    <- the binding, freed at the block's end
//     ___clos_1  ref   scope=1    <- the record, its own free at function exit
//     __bx_n     ref   scope=1    <- the cell, frame-suppressed, cascade-owned
//
// The record already carries its own outer-scope free that runs at the right time, so the
// fn-ref no longer frees through a record that outlives it.
//
// **This file only fails under `LOFT_POISON=1`.**  Without poison the freed record still
// holds the right bytes and every assertion below passes on the BROKEN compiler — that is
// what let the defect merge.  The guard is the poison gate sweeping this script
// (`LOFT_POISON=1 cargo nextest run --lib --test issues --test wrap --test strings
// --test frame_vars`), not the values on their own.
//
// Axes: WHERE the closure sits (top level as the control, bare block, `if`, `for` body,
// two levels deep), WHAT is captured (a parameter, a local), the scalar TYPE (integer,
// float, boolean, character), and WHERE the variable is read (inside the block as the
// second control, after it, and both).

// ── controls: these were correct before the fix and must stay correct ─────────

// The closure sits at the function-body top level — same scope as the cell.
fn c695_top_level(n: integer) -> integer {
  b = fn(k: integer) { n = n + k; };
  b(1);
  n + 4
}

// The read happens INSIDE the block, before the fn-ref's scope ends.
fn c695_read_inside(n: integer) -> integer {
  r = 0;
  { b = fn(k: integer) { n = n + k; }; b(1); r = n + 4; }
  r
}

// ── the reported shape and its siblings ──────────────────────────────────────

fn c695_bare_block(n: integer) -> integer {
  { b = fn(k: integer) { n = n + k; }; b(1); }
  n + 4
}

// The captured variable is a LOCAL, not a parameter — this is why the defect is
// wider than #685, where it surfaced.
fn c695_local(x: integer) -> integer {
  n = x;
  { b = fn(k: integer) { n = n + k; }; b(1); }
  n + 4
}

fn c695_if_block(n: integer) -> integer {
  if n > 0 { b = fn(k: integer) { n = n + k; }; b(1); }
  n + 4
}

fn c695_two_levels(n: integer) -> integer {
  { { b = fn(k: integer) { n = n + k; }; b(1); } }
  n + 4
}

fn c695_for_body(n: integer) -> integer {
  for i in 0..1 { b = fn(k: integer) { n = n + k + i; }; b(1); }
  n + 4
}

// Read on BOTH sides of the block: the inside read must not be disturbed by the
// outside one still being live.
fn c695_read_both(n: integer) -> integer {
  inside = 0;
  { b = fn(k: integer) { n = n + k; }; b(1); inside = n; }
  inside + n
}

// ── the other scalar types that take a `__cell_<T>` ──────────────────────────

fn c695_float(n: float) -> float {
  { b = fn(k: float) { n = n + k; }; b(1.0); }
  n + 4.0
}

fn c695_bool(n: boolean) -> boolean {
  { b = fn() { n = !n; }; b(); }
  n
}

fn c695_char(n: character) -> character {
  { b = fn() { n = 'z'; }; b(); }
  n
}

// NOTE: two closures over the SAME mutated variable is a designed refusal (C74 —
// "sharing a mutable variable between closures is not supported"), which is part of
// why the cascade can assume a single owner.  So the two-closure shape is not a gap
// here; it cannot be written.

fn main() {
  assert(c695_top_level(10) == 15, "control, top level: got {c695_top_level(10)}");
  assert(c695_read_inside(10) == 15, "control, read inside: got {c695_read_inside(10)}");

  assert(c695_bare_block(10) == 15, "bare block: got {c695_bare_block(10)}");
  assert(c695_local(10) == 15, "captured LOCAL: got {c695_local(10)}");
  assert(c695_if_block(10) == 15, "if block: got {c695_if_block(10)}");
  assert(c695_two_levels(10) == 15, "two levels: got {c695_two_levels(10)}");
  assert(c695_for_body(10) == 15, "for body: got {c695_for_body(10)}");
  assert(c695_read_both(10) == 22, "read both sides: 11+11, got {c695_read_both(10)}");

  assert(c695_float(10.0) == 15.0, "float cell: got {c695_float(10.0)}");
  assert(c695_bool(false) == true, "boolean cell: got {c695_bool(false)}");
  assert(c695_char('a') == 'z', "character cell: got {c695_char('a')}");

  // Repeat calls: the cell is re-minted per call, so a stale free would show as a
  // value that drifts between invocations rather than a constant wrong answer.
  assert(c695_bare_block(10) == 15, "bare block, second call");
  assert(c695_bare_block(20) == 25, "bare block, different argument");

  println("695-closure-in-nested-block-capture ok");
}
