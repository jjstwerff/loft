// @P321d regression: nested vector indexing `m.a[0].b[2]` must not emit two
// simultaneous `&mut stores` borrows under --native (E0499).  The OpGetVector /
// OpVectorRef `#rust` templates bind the vector ref to a local before the call.
struct Hex { h_height: integer }
struct Chunk { ck_hexes: vector<Hex> }
struct Map { m_chunks: vector<Chunk> }

fn main() {
  hexes: vector<Hex> = [];
  hexes += [Hex { h_height: 32 }];
  hexes += [Hex { h_height: 33 }];
  hexes += [Hex { h_height: 34 }];
  m = Map { m_chunks: [] };
  m.m_chunks += [Chunk { ck_hexes: hexes }];
  assert(m.m_chunks[0].ck_hexes[2].h_height == 34, "nested index value");
  assert(len(m.m_chunks[0].ck_hexes) == 3, "nested index len");
  print("ok");
}
