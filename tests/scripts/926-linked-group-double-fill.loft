//
// loft#926 — two keyed collections over one element type are auto-linked into a group:
// two routes to a SINGLE record set, where filling either fills both. That is documented
// and deliberate, and a program that means it fills ONE member and reads through both.
//
// What was silent is the literal that fills a SECOND member. Giving each member its own
// records only makes sense for independent collections, and these are not — so the author
// who writes it gets one set holding everything, which is correct behaviour and completely
// unlike what the code says. Three of loft's own fixtures had written exactly that and
// were relying on loft#924's defect to hide it; two of the three meant them independent.
//
// This file pins the VALUES the group produces. Whether the advice line appears is pinned
// by `tests/e1_code_set.rs`, which owns the code as a frozen handle.

struct E { k: integer, v: integer }

// The group: two keyed members over one element type.
struct HS { by_k: hash<E[k]>, by_v: sorted<E[v]> }
// Different element types, so no group forms and the two stay independent.
struct D1 { k: integer, v: integer }
struct D2 { k: integer, v: integer }
struct Indep { ones: hash<D1[k]>, twos: sorted<D2[v]> }

fn main() {
  // Filling BOTH members is the shape the advice names. The RESULT is one record set of
  // two, reachable through either route — which is what makes the silence expensive:
  // nothing about `by_k` holding `by_v`'s record is visible at the literal.
  both = HS { by_k: [E { k: 1, v: 10 }], by_v: [E { k: 2, v: 20 }] };
  assert(len(both.by_k) == 2, "both.by_k reads {len(both.by_k)}, want 2");
  assert(len(both.by_v) == 2, "both.by_v reads {len(both.by_v)}, want 2");

  // The idiom the advice must stay quiet on: every member written `[]`. A member given no
  // records cannot surprise anyone about which set they landed in, and this is how a group
  // is constructed, so speaking here would be noise on correct code.
  built = HS { by_k: [], by_v: [] };
  built.by_k += [E { k: 3, v: 30 }];
  assert(len(built.by_k) == 1, "built.by_k reads {len(built.by_k)}, want 1");
  assert(len(built.by_v) == 1, "built.by_v reads {len(built.by_v)}, want 1");

  // Filling ONE member is the deliberate use, and reads back through both.
  once = HS { by_k: [E { k: 4, v: 40 }, E { k: 5, v: 50 }] };
  assert(len(once.by_k) == 2, "once.by_k reads {len(once.by_k)}, want 2");
  assert(len(once.by_v) == 2, "once.by_v reads {len(once.by_v)}, want 2");

  // The negative cell: different element types are not a group, so filling both members
  // gives two collections of one — and the advice has nothing to say.
  ind = Indep { ones: [D1 { k: 1, v: 10 }], twos: [D2 { k: 2, v: 20 }] };
  assert(len(ind.ones) == 1, "ind.ones reads {len(ind.ones)}, want 1");
  assert(len(ind.twos) == 1, "ind.twos reads {len(ind.twos)}, want 1");

  println("ok");
}
