//
// Companion to #432 (data-correctness guard lives in
// 432-untyped-vector-literal-arg.loft).  Here: an untyped integer-vector literal
// whose element is OUT OF RANGE for the `vector<u8>` parameter must be REJECTED
// at compile time — exactly as the typed local `b: vector<u8> = [10, 999, 20]`
// already is — never a silent truncation or zero-fill.  This is the "rejected
// with a type error" half of #432's expected resolution.
//
// Dual guard: the `@EXPECT_ERROR` matches the compile error.  If the fix ever
// regresses so the out-of-range literal silently coerces instead of erroring,
// the file compiles and EXECUTES `main`, where the value is not 231 (= 999 & 0xFF)
// and the assert fails — so the regression is caught either way.

fn sink_u8(v: vector<u8>) -> integer { v[1] }

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn main() {
  assert(sink_u8([10, 999, 20]) == 231, "out-of-range u8 literal arg must be rejected at compile time");
}
