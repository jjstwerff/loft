// #319 + #320 regressions.
//
// #319 — a comprehension of STRUCT literals leaked the parse-internal
// `Rewritten(...)` wrapper into the vector's element type; any later
// `qs[i] ?? …` on the result lost its dep chain and stack slot and panicked
// codegen ("Incorrect var __ncc_N[65535]").
//
// #320 — reassigning a struct's vector field from a captured+appended copy
// (`w = s.v; w += [x]; s.v = w`) EMPTIED the field: the borrow and the field
// share one store, and the replace lowering cleared the store before reading
// it.  Borrowed RHS vars now materialise through an owned temp.
//
// Also pins the temp-name counter fix: `unique()` is per-prefix, so a
// second-pass-only lowering temp cannot shift `__ncc_N` numbering between
// passes (a shifted name re-resolved to a pass-1 INTEGER temp, popping 8 of
// a DbRef's 12 bytes — frame drift downstream of an integer `??` followed
// by a struct `??`, which the mixed asserts below exercise).

struct P {
  x: integer,
  t: text,
}
struct S {
  v: vector<integer>,
  ps: vector<P>,
}
struct Q {
  n: integer,
}

fn main() {
  // #319: struct-literal comprehension + struct ?? reads (literal + call fallback).
  qs = [for i in 0..4 {
    Q { n: i + 10 }
  }];
  q2 = qs[2] ?? Q { n: -1 };
  assert(len(qs) == 4 && q2.n == 12, "i319: len={len(qs)} q2={q2.n}");

  // #320: capture-append-reassign on both an integer-vector and a
  // struct-vector field, with mixed ?? reads in between.
  s = S { v: [7], ps: [
    P { x: 1, t: "a" },
  ] };
  w = s.v;
  w += [43];
  s.v = w;
  assert(len(s.v) == 2 && (s.v[1] ?? -1) == 43, "i320 int: {len(s.v)}");
  wp = s.ps;
  wp += [
    P { x: 2, t: "b" },
  ];
  s.ps = wp;
  p1 = s.ps[1] ?? P { x: -1, t: "?" };
  assert(len(s.ps) == 2 && p1.x == 2 && p1.t == "b", "i320 struct: {len(s.ps)} {p1.x} {p1.t}");

  // Owned RHS still replaces; direct append and self-assign unaffected.
  own: vector<integer> = [];
  own += [100, 200, 300];
  s.v = own;
  s.v += [400];
  s.v = s.v;
  assert(len(s.v) == 4 && (s.v[3] ?? -1) == 400, "owned/append: {len(s.v)}");

  println("i319+i320: ok");
}
