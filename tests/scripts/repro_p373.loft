//
// @P373 regression (dryopea-surfaced) — `text as Struct` corrupted the
// field IMMEDIATELY BEFORE an empty `[]` array.  The empty-array branch
// in walk_parsed_into wrote the collection's default to the struct BASE
// (field 0) instead of the collection field's slot, zeroing the previous
// field.  Fixed by routing the default through field_ref(to, rec_tp, field),
// exactly as the non-empty path does via record_new.

struct Item {
  x: integer,
}
struct Box {
  name: text,
  items: vector<Item>,
}
struct IntBox {
  name: text,
  nums: vector<integer>,
}

fn main() {
  // field-then-empty-[] — the broken shape
  b = `{{"name":"b","items":[]}}`as Box;
  assert(b.name == "b", "name preserved before empty vector<Struct>");
  assert(b.items.len() == 0, "items empty");

  // vector<integer> flavour (dryopea saw `name` come back as " ")
  ib = `{{"name":"hi","nums":[]}}`as IntBox;
  assert(ib.name == "hi", "name preserved before empty vector<integer>");
  assert(ib.nums.len() == 0, "nums empty");

  // controls that always worked — must still work
  before = `{{"items":[],"name":"c"}}`as Box;
  assert(before.name == "c", "empty-[]-then-field still ok");
  nonempty = `{{"name":"d","items":[{{"x":7}}]}}`as Box;
  assert(nonempty.name == "d", "non-empty array still ok");
  assert(nonempty.items[0].x == 7, "non-empty element");

  print("ok");
}
