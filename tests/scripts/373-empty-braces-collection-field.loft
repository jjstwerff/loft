//
// Regression — an empty `{}` as a COLLECTION-typed struct field value.
//
// `{}` is an empty Void BLOCK, not a collection literal (loft's empty
// collection literal is `[]`).  Before the fix, `Counter { by: {} }` lowered
// the `{}` to a 0-byte block that UNDER-FILLED the struct record, so a sibling
// field landed at the wrong offset → SIGSEGV (interpreter) / E0308 (native).
// Surfaced by `examples/collections.loft`.  Fix (`src/parser/objects.rs`
// `parse_object_field`): accept `{}` in a collection-field position as the
// already-primed empty collection and WARN toward the canonical `[]`.
//
// The hash-key field (`text`) must be UNIQUE — a hash holds one record per key.

struct Word {
  text: text,
  count: integer,
}
struct H {
  by: hash<Word[text]>,
}
struct V {
  v: vector<integer>,
}
struct Counter {
  ordered: vector<Word>,
  by_text: hash<Word[text]>,
}

// `{}` for a HASH field — works as an empty hash (warns toward `[]`).
// @EXPECT_WARNING: empty `{}` is not a collection literal
fn test_empty_braces_hash_field() {
  c = H {
    by: {}
  };
  c.by += Word { text: "a", count: 7 };
  c.by += Word { text: "b", count: 9 };
  assert(
    c.by["a"].count == 7 && c.by["b"].count == 9,
    "hash braces-init: a={c.by[\"a\"].count} b={c.by[\"b\"].count}"
  );
}

// `{}` for a VECTOR field — works as an empty vector (warns toward `[]`).
// @EXPECT_WARNING: empty `{}` is not a collection literal
fn test_empty_braces_vector_field() {
  s = V {
    v: {}
  };
  s.v += [3];
  s.v += [4];
  assert(len(s.v) == 2 && s.v[0] == 3 && s.v[1] == 4, "vector braces-init: {s.v[0]},{s.v[1]}");
}

// The vector + hash secondary-index pattern (the collections.loft shape) with
// the canonical `[]` and DISTINCT keys works on both backends.
fn test_vector_plus_hash_distinct_keys() {
  c = Counter { ordered: [], by_text: [] };
  for w in[
    Word { text: "apple", count: 3 },
    Word { text: "banana", count: 5 },
    Word { text: "cherry", count: 2 },
  ] {
    c.ordered += [w];
    c.by_text += w;
  }
  total = 0;
  for e in c.ordered { total = total + e.count; }
  assert(total == 10, "ordered total={total} (expect 10)");
  assert(c.by_text["banana"].count == 5, "lookup banana={c.by_text[\"banana\"].count}");
  assert(
    c.ordered[0].text == "apple" && c.ordered[2].text == "cherry",
    "order: [0]={c.ordered[0].text} [2]={c.ordered[2].text}"
  );
}
