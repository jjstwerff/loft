// @P387 / @P383 regression: a VALUE-returning fn (text / struct / vector) used
// as a first-class `fn` value must work on BOTH backends.  Before: a named text
// fn SIGSEGV'd (interp) or hit an arity error (the synthetic return buffer leaked
// into the fn-ref type); a struct/vector fn hit the same arity error; a capturing
// text lambda as a fn-value crashed (out-of-context captured-var marking).
pub struct S { v: integer }

fn mk_lit(_n: integer) -> text {
  "z"
}
fn mk_fmt(n: integer) -> text {
  "v{n}"
}
fn mk_struct(n: integer) -> S {
  s = S { v: n }; s
}
fn mk_vec(n: integer) -> vector<integer> {
  [n, n + 1]
}

fn run_t(f: fn(integer) -> text, x: integer) -> text {
  f(x)
}
fn run_s(f: fn(integer) -> S, x: integer) -> S {
  f(x)
}
fn run_v(f: fn(integer) -> vector<integer>, x: integer) -> vector<integer> {
  f(x)
}

fn main() {
  // #387 — text fns as fn-values, all body shapes.  A literal body has NO
  // promotable local (0 work-buffers); a format/local body carries one.  The
  // fn-ref dispatch is adaptive: the interpreter pops the spuriously-injected
  // work-buffer for a no-buffer callee (literal / forward / param-return), so
  // every shape dispatches correctly on both backends.
  assert(run_t(mk_lit, 1) == "z", "lit: {run_t(mk_lit, 1)}");
  assert(mk_lit(0) == "z", "lit direct: {mk_lit(0)}");
  assert(run_t(mk_fmt, 1) == "v1", "fmt: {run_t(mk_fmt, 1)}");
  g = mk_fmt;
  assert(run_t(g, 7) == "v7", "local: {run_t(g, 7)}");
  assert(mk_fmt(3) == "v3", "direct: {mk_fmt(3)}");

  // #383 — struct- and vector-returning fns as fn-values (the @PLAN59 __retbuf
  // is renamed to the returned local, so the buffer is excluded via the return
  // type's deps, not by name).
  rs = run_s(mk_struct, 41);
  assert(rs.v == 41, "struct: {rs.v}");
  rv = run_v(mk_vec, 5);
  assert(rv[0] == 5 and rv[1] == 6, "vector: {rv}");

  // @P387 — a CAPTURING text lambda as a fn-value (was a crash).
  pre = "v";
  mk = fn(n: integer) -> text {
    "{pre}{n}"
  };
  assert(run_t(mk, 9) == "v9", "capturing lambda: {run_t(mk, 9)}");
}
