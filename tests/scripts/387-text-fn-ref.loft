// @P387 regression: a named text-returning fn used as a first-class `fn` value
// must work on BOTH backends (was SIGSEGV on --interpret for a no-work-buffer
// body, arity-error on both for a formatting body — named text fns weren't
// normalized to the uniform work-buffer ABI).
fn mk_lit(_n: integer) -> text { "z" }
fn mk_fmt(n: integer) -> text { "v{n}" }
fn run(f: fn(integer) -> text, x: integer) -> text { f(x) }

fn main() {
  // literal body (the SIGSEGV case)
  assert(run(mk_lit, 1) == "z", "lit fn-ref: {run(mk_lit, 1)}");
  // formatting body (the arity-leak case)
  assert(run(mk_fmt, 1) == "v1", "fmt fn-ref: {run(mk_fmt, 1)}");
  // via a local variable holding the fn-ref
  g = mk_fmt;
  assert(run(g, 7) == "v7", "local fn-ref: {run(g, 7)}");
  // direct call still works alongside the fn-ref use
  assert(mk_fmt(3) == "v3", "direct call: {mk_fmt(3)}");
}
