// @PLN10 (retire `stores.scratch`) Phase 1 — non-null `#rust`-template producers
// ride the chokepoint.
//
// `ymd_days_ago` and `store_memory` are always-non-null text producers.  They
// gained `_dest` variants and were added to `is_text_dest_native`, so the
// synth-temp chokepoint routes their value-position calls away from
// `stores.scratch` (proven scratch-free under `LOFT_SCRATCH_TRIP`).  This locks
// correctness on every backend.
fn took(s: text) -> integer {
  len(s)
}

fn main() {
  d = ymd_days_ago(0);

  // value position: argument (YYYY-MM-DD is 10 chars)
  assert(took(ymd_days_ago(0)) == 10, "ymd arg len");

  // value position: comparison (self-consistent; yesterday differs)
  assert(ymd_days_ago(0) == d, "ymd compare self");
  assert(ymd_days_ago(1) != d, "ymd yesterday differs");

  // value position: format interpolation
  assert("[{ymd_days_ago(0)}]" == "[{d}]", "ymd format");

  // value position: concat
  assert(ymd_days_ago(0)+"!" == d + "!", "ymd concat");

  // loop, value position — no accumulation across iterations
  for _ in 0..3 { assert(len(ymd_days_ago(0)) == 10, "ymd loop no-accumulate"); }

  // store_memory in value positions (non-empty report)
  assert(took(store_memory()) > 0, "store_memory arg");
  assert(len(store_memory()) > 0, "store_memory len");

  println("phase1 ymd/store_memory dest: all shapes ok");
}
