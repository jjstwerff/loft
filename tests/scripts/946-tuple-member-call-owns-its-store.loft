//
// A CALL used as a tuple member gets an owner for the store it answers (loft#946).
//
// A heap-returning callee allocates its OWN store and returns it — the hidden `__retbuf` the
// caller passes is not what comes back, and `n_mk` opens with its own `OpDatabase`. What owns
// that store is a BINDING: `q = mk(); (71, q)` frees it at scope exit. A member of a tuple
// LITERAL is not a binding, so `(71, mk())` dropped it: one store per evaluation.
//
// The count scales with the loop that runs it — c4 leaked 25 of 25 before the fix — which is
// the unbounded shape of loft#688, not a one-off.
//
// The cure is to give the value the binding it needs, which is exactly what the working
// spelling does by hand. Same cure as loft#941, for the same reason: the value outlives the
// expression that produced it, so it needs a name that dies at the right time.
//
// The predicate needs BOTH halves, and the controls are what say so:
//
//   * a CALL — c7's literal member builds into a work-ref the scope already frees, and c6's
//     variable member is owned by its own binding. Stashing either would be a second owner.
//   * OWNED, i.e. empty deps — c8 returns a view of its parameter, and giving that a second
//     owner frees the caller's collection underneath it.
//
// c9/c10 pin the shapes that were already correct and must stay so: a tuple RETURN deep-copies
// into the caller's buffer, and the callee frees its own temps.

struct Q946 { n: integer }
struct Big946 { a: integer, b: integer, c: integer }

fn mk946(k: integer) -> Q946 { Q946 { n: k } }
fn mkbig946(k: integer) -> Big946 { Big946 { a: k, b: k + 1, c: k + 2 } }
fn mktext946(k: integer) -> text { "t{k}" }
fn mkvec946(k: integer) -> vector<integer> { [k, k + 1] }
fn view946(v: vector<integer>) -> vector<integer> { v }
fn mkpair946(k: integer) -> (integer, Q946) { (k, mk946(k + 1)) }

fn main() {
  // c1 — the filed shape: a call as the SECOND member.
  c1: (integer, Q946) = (71, mk946(82));
  assert(c1.0 == 71, "c1 first = {c1.0}, want 71");
  assert(c1.1.n == 82, "c1 member = {c1.1.n}, want 82");

  // c2 — as the FIRST member, and with BOTH members calls. Position is not the axis, and two
  //      calls leaked two stores.
  c2: (Q946, integer) = (mk946(93), 71);
  assert(c2.0.n == 93, "c2 = {c2.0.n}, want 93");
  c2b: (Q946, Q946) = (mk946(11), mk946(22));
  assert(c2b.0.n == 11 && c2b.1.n == 22, "c2b = {c2b.0.n}/{c2b.1.n}, want 11/22");

  // c3 — three members, and an inferred tuple type. Neither arity nor the declaration is the
  //      axis; the producer is.
  c3: (integer, Q946, integer) = (71, mk946(82), 93);
  assert(c3.1.n == 82, "c3 = {c3.1.n}, want 82");
  c3i = (71, mk946(104));
  assert(c3i.1.n == 104, "c3i = {c3i.1.n}, want 104");

  // c4 — the reason this is not a one-off: in a loop the count scales with the iterations.
  s4 = 0;
  for i in 0..25 { p = (i, mk946(i + 1)); s4 = s4 + p.1.n; }
  assert(s4 == 325, "c4 sum = {s4}, want 325");

  // c5 — a bigger record, so the leak is not an artefact of a one-field struct.
  c5: (integer, Big946) = (71, mkbig946(10));
  assert(c5.1.c == 12, "c5 = {c5.1.c}, want 12");

  // c6 (control) — a VARIABLE member. Already owned by its own binding; a second owner would
  //       free it twice.
  q6 = mk946(82);
  c6: (integer, Q946) = (71, q6);
  assert(c6.1.n == 82, "c6 = {c6.1.n}, want 82");

  // c7 (control) — a LITERAL member. Builds into a work-ref the scope already frees.
  c7: (integer, Q946) = (71, Q946 { n: 82 });
  assert(c7.1.n == 82, "c7 = {c7.1.n}, want 82");

  // c8 (control) — a call answering a BORROWED view of its argument. Empty deps is what says
  //       "owned"; this one's are not, and giving it an owner frees `base` underneath it.
  base8: vector<integer> = [71, 82, 93];
  c8: (integer, vector<integer>) = (71, view946(base8));
  assert(len(c8.1) == 3, "c8 view = {len(c8.1)}, want 3");
  assert(len(base8) == 3 && base8[0] == 71, "c8 base survived = {len(base8)}, want 3");

  // c9 (control) — text and vector members from calls. Both were already correct: a text
  //       return is a caller-owned buffer and a vector return delivers into `__retbuf`.
  c9: (integer, text) = (71, mktext946(82));
  assert(c9.1 == "t82", "c9 text = {c9.1}, want t82");
  c9v: (integer, vector<integer>) = (71, mkvec946(82));
  assert(len(c9v.1) == 2, "c9 vector = {len(c9v.1)}, want 2");

  // c10 (control) — a tuple RETURN whose member is a call. Deep-copied into the caller's
  //        buffer, with the callee freeing its own temps; correct before and after.
  c10 = mkpair946(71);
  assert(c10.0 == 71 && c10.1.n == 72, "c10 = {c10.0}/{c10.1.n}, want 71/72");
  s10 = 0;
  for i in 0..20 { p = mkpair946(i); s10 = s10 + p.1.n; }
  assert(s10 == 210, "c10 loop = {s10}, want 210");

  println("946 ok");
}
