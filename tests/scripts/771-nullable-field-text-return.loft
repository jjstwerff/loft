//
// Regression (loft#771) — returning a TEXT FIELD read off a struct local never
// freed that struct's record.
//
// The returned text's type named the local (`text["v"]`), so `text_return`
// PROMOTED the local to a visible parameter to keep the borrow alive past the
// return.  But promotion makes it an ARGUMENT, and an argument is the caller's
// to free — while the caller was never handed the store: a promoted slot is
// filled with `null` unless the callee writes into it, which a fresh allocation
// does not.  So every call orphaned one record, without bound: the filed repro
// retained 5000 records over 5000 calls, and a server that calls such a helper
// leaks for as long as it runs.
//
// The promotion is unnecessary here because a text return is delivered by COPY
// into the caller's `&text` buffer.  A local that OWNS its store therefore keeps
// its dep out of the return type and is freed at scope exit, like every
// neighbouring cell below already was.
//
// `--interpret` is where this is VISIBLE (native has no store-leak check), but
// the retention came from the parser's dep propagation, which both backends
// share — so the values are asserted on both, and `tests/nullable_text_leak.rs`
// runs the loop under the interpreter's leak gate.

struct Id771 { const nm: text, n: integer }
struct Plain771 { const nm: text, n: integer }

fn nullable(s: text) -> Id771? {
  if s == "" { return null }
  return Id771 { nm: s, n: 7 };
}

fn plain(s: text) -> Plain771 { return Plain771 { nm: s, n: 7 }; }

// The two shapes that leaked: a text field of a NULLABLE struct in RETURN
// position, with and without the `??`.
fn a1_coalesced(s: text) -> text { v = nullable(s); return v.nm ?? "?"; }
fn a3_nullable_ret(s: text) -> text? { v = nullable(s); return v.nm; }

// The neighbours that always freed — each varies ONE axis, and each must stay
// correct, because the fix drops a dep and the over-free direction is the
// dangerous one.
fn a2_via_local(s: text) -> text { v = nullable(s); x = v.nm ?? "?"; return x; }
fn a4_unused(s: text) -> text { v = nullable(s); x = v.nm ?? "?"; return "K{x.len()}"; }
fn a5_rebuilt(s: text) -> text { v = nullable(s); return "{v.nm ?? "?"}"; }
fn a6_non_null(s: text) -> text { v = plain(s); return v.nm; }
fn a7_integer(s: text) -> integer { v = nullable(s); return v.n ?? 0; }

// The null path still answers the default rather than reading a freed record.
fn a8_null_input() -> text { v = nullable(""); return v.nm ?? "gone"; }

fn main() {
  // Enough iterations that a retained record per call is unmistakable, and each
  // answer distinct so a stale read cannot pass as a fresh one.
  last1 = "";
  last2: text? = "";
  last3 = "";
  last5 = "";
  last6 = "";
  total = 0;
  for i in 0..300 {
    last1 = a1_coalesced("row{i}");
    last2 = a3_nullable_ret("nr{i}");
    last3 = a2_via_local("lc{i}");
    last5 = a5_rebuilt("rb{i}");
    last6 = a6_non_null("nn{i}");
    total = total + a7_integer("in{i}");
  }
  assert(last1 == "row299", "a1 coalesced return: {last1}, want row299");
  assert(last2 == "nr299", "a3 nullable return: {last2}, want nr299");
  assert(last3 == "lc299", "a2 via local: {last3}, want lc299");
  assert(last5 == "rb299", "a5 rebuilt: {last5}, want rb299");
  assert(last6 == "nn299", "a6 non-null struct: {last6}, want nn299");
  assert(total == 2100, "a7 integer field: {total}, want 2100");

  k = a4_unused("zz");
  assert(k == "K2", "a4 unused field: {k}, want K2");

  g = a8_null_input();
  assert(g == "gone", "a8 null input: {g}, want gone");

  println("771 nullable-field text return OK");
}
