// A TUPLE as a keyed collection's key — `hash`, `sorted` and `index`.
//
// A tuple key is a compound key that happens to be spelled as one field, so
// `sorted<Cell[pos]>` with `pos: (integer, integer)` must behave exactly as
// `sorted<Cell[x, y]>` does: element 0 orders, element 1 breaks its ties.
//
// The cells that matter are the TIES. Before the key field expanded into one descriptor per
// element, only element 0 was ever compared: three cells at `(1,9)`, `(2,0)` and `(1,2)`
// left TWO in the collection, because the two sharing an element 0 collapsed into one — a
// silent loss, with a correct-looking `len` and no diagnostic. Every `len(…) == 3` below is
// that fact; every order string is the second half of it.
//
// The other half is ARITY. The comparison descriptors and the lookup's stack arity were
// derived separately, so a lookup pushed one key value where the collection expected two,
// and `get_stack::<DbRef>()` then read the leftover key AS the collection (`h[(3, 4)]`
// looked up in store #4). That is loft#720's failure exactly, one collection kind later, so
// the lookup cells are as load-bearing as the ordering ones.

struct Cell { pos: (integer, integer), name: text }
struct Wide { k: (integer, integer, integer), name: text }
struct Mixed { k: (integer, text), name: text }
struct Fl { k: (float, integer), name: text }
struct Nest { k: ((integer, integer), integer), name: text }
struct Two { k: (integer, integer), tag: text, name: text }

fn main() {
  // Ordering — `(1,9)` and `(1,2)` share an element 0, so they are the pair that collapsed.
  s: sorted<Cell[pos]> = [
    Cell { pos: (1, 9), name: "c" },
    Cell { pos: (2, 0), name: "d" },
    Cell { pos: (1, 2), name: "a" },
  ];
  assert(len(s) == 3, "sorted keeps all three: {len(s)}");
  order = "";
  for c in s { order = order + c.name; }
  assert(order == "acd", "sorted lexicographic order: {order}");

  i: index<Cell[pos]> = [
    Cell { pos: (1, 9), name: "c" },
    Cell { pos: (2, 0), name: "d" },
    Cell { pos: (1, 2), name: "a" },
  ];
  assert(len(i) == 3, "index keeps all three: {len(i)}");

  h: hash<Cell[pos]> = [
    Cell { pos: (1, 9), name: "c" },
    Cell { pos: (2, 0), name: "d" },
    Cell { pos: (1, 2), name: "a" },
  ];
  assert(len(h) == 3, "hash keeps all three: {len(h)}");

  // Lookup by a tuple literal — including the element that shares an element 0 with another,
  // which is what proves the whole tuple is being matched and not just its head.
  assert(h[(1, 9)].name == "c", "hash lookup by a literal");
  assert(h[(1, 2)].name == "a", "the element sharing element 0");
  assert(s[(1, 9)].name == "c", "sorted lookup by a literal");
  assert(i[(2, 0)].name == "d", "index lookup by a literal");

  // Lookup by a tuple held in a local, and by a `vector<(…)>` loop variable — the STORED
  // spelling, which has to be unboxed before its elements can be handed over as key values.
  k = (2, 0);
  assert(h[k].name == "d", "hash lookup by a local");
  assert(s[k].name == "d", "sorted lookup by a local");
  probes: vector<(integer, integer)> = [(1, 2), (2, 0)];
  seen = "";
  for p in probes { seen = seen + h[p].name; }
  assert(seen == "ad", "lookup by a stored-spelling loop variable: {seen}");

  // A miss is null, not a record read out of some other store.
  assert(!h[(9, 9)], "a hash miss is null");
  assert(!s[(9, 9)], "a sorted miss is null");

  // Arity 3, so the expansion is not a two-element special case: `(1,2,4)` and `(1,2,3)` tie
  // on their first TWO elements.
  w: sorted<Wide[k]> = [
    Wide { k: (1, 2, 4), name: "b" },
    Wide { k: (1, 2, 3), name: "a" },
    Wide { k: (1, 3, 0), name: "c" },
  ];
  assert(len(w) == 3, "an arity-3 tuple key keeps all three: {len(w)}");
  worder = "";
  for e in w { worder = worder + e.name; }
  assert(worder == "abc", "arity-3 lexicographic order: {worder}");
  assert(w[(1, 2, 4)].name == "b", "arity-3 lookup");

  // A heap element inside the key: the two entries tie on element 0 and are told apart by
  // their TEXT, which the descriptor has to pop as a string rather than as eight bytes.
  m: hash<Mixed[k]> = [
    Mixed { k: (1, "aa"), name: "a" },
    Mixed { k: (1, "bb"), name: "b" },
  ];
  assert(len(m) == 2, "an (integer, text) key keeps both: {len(m)}");
  assert(m[(1, "bb")].name == "b", "lookup on a text element");
  assert(m[(1, "aa")].name == "a", "and its sibling");

  // A float leads, so the widths in the key differ from one another.
  f: sorted<Fl[k]> = [
    Fl { k: (1.5, 2), name: "b" },
    Fl { k: (1.5, 1), name: "a" },
    Fl { k: (0.5, 9), name: "z" },
  ];
  assert(len(f) == 3, "a (float, integer) key keeps all three: {len(f)}");
  forder = "";
  for fe in f { forder = forder + fe.name; }
  assert(forder == "zab", "float-keyed lexicographic order: {forder}");
  assert(f[(1.5, 2)].name == "b", "lookup on a float element");

  // A NESTED tuple flattens to the same comparison order all the way down.
  n: sorted<Nest[k]> = [
    Nest { k: ((1, 2), 9), name: "b" },
    Nest { k: ((1, 2), 3), name: "a" },
    Nest { k: ((0, 9), 0), name: "z" },
  ];
  assert(len(n) == 3, "a nested tuple key keeps all three: {len(n)}");
  norder = "";
  for ne in n { norder = norder + ne.name; }
  assert(norder == "zab", "nested-tuple lexicographic order: {norder}");
  assert(n[((1, 2), 9)].name == "b", "lookup on a nested tuple key");

  // A tuple key BESIDE a plain key field — the expansion has to leave the other field's
  // position alone, and the lookup spells both.
  t: hash<Two[k, tag]> = [
    Two { k: (1, 2), tag: "x", name: "a" },
    Two { k: (1, 2), tag: "y", name: "b" },
  ];
  assert(len(t) == 2, "a tuple key plus a plain field keeps both: {len(t)}");
  assert(t[(1, 2), "y"].name == "b", "lookup across both key fields");

  // `-` on a tuple key reverses the WHOLE tuple, which is what the spelling reads as.
  d: sorted<Cell[-pos]> = [
    Cell { pos: (1, 9), name: "c" },
    Cell { pos: (2, 0), name: "d" },
    Cell { pos: (1, 2), name: "a" },
  ];
  assert(len(d) == 3, "a descending tuple key keeps all three: {len(d)}");
  dorder = "";
  for c in d { dorder = dorder + c.name; }
  assert(dorder == "dca", "descending lexicographic order: {dorder}");
}
