//
// A struct LITERAL that builds a linked collection group gives the same answer
// whichever order its fields are written in.
//
// It did not. A group is several routes to ONE record set, so `OpFinishRecord`
// through whichever member the author wrote indexes the record into the siblings
// too — and each collection field then zeroed its own 4-byte header at its own
// position in the literal. A member written AFTER the one holding the records
// dropped the spine it had just been handed, and an OMITTED member was zeroed
// later still, by the default-init that runs once the body is read. So
// `S { data: […], lookup: [] }` left `lookup` empty while `data` held the
// records: every keyed lookup answered null for a record that was there, and
// nothing at the call site said the field order had decided it (loft#924).
//
// The rule now is that a group's headers are zeroed as ONE block, before any
// member's fill — the treatment #437 already gave plain vector fields, for the
// same reason. Which member the author names first is not a fact the result may
// depend on.
//
// Every cell asserts the VALUE a lookup reaches as well as the length. A length
// alone cannot tell an index that holds the records from one whose spine names
// memory that was freed — both count.

struct E { k: integer, v: integer }

// The pairing DATABASE.md documents by name: a vector holds the records, a keyed
// field is a second route to them. The vector is declared first, so it is the
// group's PRIMARY and `look` is the VIEW.
struct VH { data: vector<E>, look: hash<E[k]> }
struct VS { data: vector<E>, look: sorted<E[k]> }
struct VI { data: vector<E>, look: index<E[k]> }

// Two KEYED members over one element type — neither spelling is privileged, and
// the first-declared one owns the records (loft#843 / loft#898).
struct HS { by_k: hash<E[k]>, by_v: sorted<E[v]> }

// A group one level down: the field ORDER question is about the literal, and a
// nested literal is still a literal.
struct Outer { tag: integer, inner: VH }

// Two plain vectors are NOT a group — inserting into one must not reach the
// other. The control that keeps the fix from over-reaching into every struct
// that merely holds two collections.
struct TwoVec { p: vector<integer>, q: vector<integer> }

// A keyed field with NO sibling over its element type stands alone beside a real
// group in the same struct.
struct W { name: text, n: integer }
struct Mixed { data: vector<E>, look: hash<E[k]>, other: hash<W[name]> }

fn make_omitted() -> VH { VH { data: [E { k: 1, v: 10 }, E { k: 2, v: 20 }] } }

fn check_vh(s: VH, where: text) {
  assert(len(s.data) == 2, "{where}: primary holds {len(s.data)}, want 2");
  assert(len(s.look) == 2, "{where}: view holds {len(s.look)}, want 2");
  assert(s.look[1].v == 10, "{where}: view reads {s.look[1].v} at key 1, want 10");
  assert(s.look[2].v == 20, "{where}: view reads {s.look[2].v} at key 2, want 20");
}

fn main() {
  // ---- vector primary + hash view: the four ways to fill it, all one answer.
  check_vh(VH { data: [E { k: 1, v: 10 }, E { k: 2, v: 20 }] }, "view omitted");
  check_vh(VH { data: [E { k: 1, v: 10 }, E { k: 2, v: 20 }], look: [] }, "view last");
  check_vh(VH { look: [], data: [E { k: 1, v: 10 }, E { k: 2, v: 20 }] }, "view first");
  check_vh(make_omitted(), "returned from a fn");

  d = VH { data: [] };
  d.data += [E { k: 1, v: 10 }, E { k: 2, v: 20 }];
  check_vh(d, "filled by `+=`");

  // ---- the other two kinds a view can take.
  vs_last = VS { data: [E { k: 1, v: 10 }], look: [] };
  vs_first = VS { look: [], data: [E { k: 1, v: 10 }] };
  assert(len(vs_last.look) == 1, "sorted view written last holds {len(vs_last.look)}, want 1");
  assert(len(vs_first.look) == 1, "sorted view written first holds {len(vs_first.look)}, want 1");
  assert(vs_last.look[1].v == 10, "sorted view reads {vs_last.look[1].v}, want 10");

  vi_last = VI { data: [E { k: 1, v: 10 }], look: [] };
  vi_first = VI { look: [], data: [E { k: 1, v: 10 }] };
  assert(len(vi_last.look) == 1, "index view written last holds {len(vi_last.look)}, want 1");
  assert(len(vi_first.look) == 1, "index view written first holds {len(vi_first.look)}, want 1");
  assert(vi_last.look[1].v == 10, "index view reads {vi_last.look[1].v}, want 10");

  // ---- two keyed members. Records through the PRIMARY reach the view…
  p_last = HS { by_k: [E { k: 1, v: 10 }], by_v: [] };
  p_first = HS { by_v: [], by_k: [E { k: 1, v: 10 }] };
  assert(len(p_last.by_v) == 1, "view after primary holds {len(p_last.by_v)}, want 1");
  assert(len(p_first.by_v) == 1, "view before primary holds {len(p_first.by_v)}, want 1");

  // …and records through the VIEW reach the primary, which is the same rule read
  // the other way round: an operation spelled through any member acts on the group.
  v_last = HS { by_v: [E { k: 1, v: 10 }], by_k: [] };
  v_first = HS { by_k: [], by_v: [E { k: 1, v: 10 }] };
  assert(len(v_last.by_k) == 1, "primary after view holds {len(v_last.by_k)}, want 1");
  assert(len(v_first.by_k) == 1, "primary before view holds {len(v_first.by_k)}, want 1");
  assert(v_last.by_k[1].v == 10, "primary reads {v_last.by_k[1].v} after a view fill, want 10");

  // ---- BOTH members given records: the group holds two, and both routes see two.
  // This is the cell where the truncation was visible without any empty `[]` at
  // all — each member kept only what was written at or after its own position.
  both_a = HS { by_k: [E { k: 1, v: 10 }], by_v: [E { k: 2, v: 20 }] };
  both_b = HS { by_v: [E { k: 2, v: 20 }], by_k: [E { k: 1, v: 10 }] };
  assert(len(both_a.by_k) == 2, "k-first: by_k holds {len(both_a.by_k)}, want 2");
  assert(len(both_a.by_v) == 2, "k-first: by_v holds {len(both_a.by_v)}, want 2");
  assert(len(both_b.by_k) == 2, "v-first: by_k holds {len(both_b.by_k)}, want 2");
  assert(len(both_b.by_v) == 2, "v-first: by_v holds {len(both_b.by_v)}, want 2");
  assert(both_a.by_k[2].v == 20, "k-first: the record written through the view reads {both_a.by_k[2].v}, want 20");
  assert(both_b.by_k[1].v == 10, "v-first: the record written through the primary reads {both_b.by_k[1].v}, want 10");

  // ---- a group one level down.
  o_last = Outer { tag: 7, inner: VH { data: [E { k: 1, v: 10 }], look: [] } };
  o_first = Outer { inner: VH { look: [], data: [E { k: 1, v: 10 }] }, tag: 7 };
  assert(len(o_last.inner.look) == 1, "nested view written last holds {len(o_last.inner.look)}, want 1");
  assert(len(o_first.inner.look) == 1, "nested view written first holds {len(o_first.inner.look)}, want 1");
  assert(o_last.inner.look[1].v == 10, "nested view reads {o_last.inner.look[1].v}, want 10");
  assert(o_last.tag == 7, "the sibling scalar reads {o_last.tag}, want 7");

  // ---- the spine is real, not a count: clear the group through the view and
  // refill it. A view that had merely been left counting its primary's records
  // would answer here with memory the clear released.
  r = VH { data: [E { k: 1, v: 10 }, E { k: 2, v: 20 }] };
  r.look = null;
  assert(len(r.data) == 0, "clear through the view left the primary at {len(r.data)}, want 0");
  assert(len(r.look) == 0, "clear through the view left the view at {len(r.look)}, want 0");
  r.data += [E { k: 5, v: 50 }];
  assert(len(r.look) == 1, "refill after the clear left the view at {len(r.look)}, want 1");
  assert(r.look[5].v == 50, "the refilled record reads {r.look[5].v} through the view, want 50");

  // ---- CONTROL: two plain vectors are not a group and never were. If the group
  // prelude ever primed a field that has no sibling sharing its records, this is
  // the cell that says so.
  tv_pq = TwoVec { p: [1, 2], q: [3] };
  tv_qp = TwoVec { q: [3], p: [1, 2] };
  assert(len(tv_pq.p) == 2, "p written first holds {len(tv_pq.p)}, want 2");
  assert(len(tv_pq.q) == 1, "q written last holds {len(tv_pq.q)}, want 1");
  assert(len(tv_qp.p) == 2, "p written last holds {len(tv_qp.p)}, want 2");
  assert(len(tv_qp.q) == 1, "q written first holds {len(tv_qp.q)}, want 1");
  assert(tv_qp.p[1] == 2, "p reads {tv_qp.p[1]}, want 2");

  // ---- CONTROL: an UNGROUPED keyed field beside a group keeps its own records,
  // and the group beside it still behaves.
  m = Mixed {
    data: [E { k: 1, v: 10 }, E { k: 2, v: 20 }],
    other: [W { name: "a", n: 1 }],
  };
  assert(len(m.data) == 2, "mixed: primary holds {len(m.data)}, want 2");
  assert(len(m.look) == 2, "mixed: view holds {len(m.look)}, want 2");
  assert(len(m.other) == 1, "mixed: the ungrouped field holds {len(m.other)}, want 1");
  assert(m.look[2].v == 20, "mixed: the view reads {m.look[2].v}, want 20");
  assert(m.other["a"].n == 1, "mixed: the ungrouped field reads {m.other["a"].n}, want 1");

  // ---- build the same group many times: a header primed in the wrong place
  // shows up as growth or as a leak across repeats, not in a single construction.
  total = 0;
  for i in 0..20 {
    s = VH { data: [E { k: i, v: i * 10 }], look: [] };
    assert(len(s.look) == 1, "repeat {i}: view holds {len(s.look)}, want 1");
    total += s.look[i].v;
  }
  assert(total == 1900, "20 repeats summed {total} through the view, want 1900");

  println("924 ok");
}
