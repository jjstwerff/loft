// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Regression: returning a LOCAL that views a payload-enum field of another local
// handed the caller a pointer into a store the function had already freed
// (loft#651).  `--native` only; the interpreter read the stale bytes and, above a
// ~54-byte payload, died with no message at all.
//
// The shape a consumer met it in was `pluginabi`'s `pa_get` — the single read
// primitive under every plugin frame accessor — so the whole plugin dispatch path
// crashed for any realistic payload.  It stayed invisible because every test used
// sub-threshold data: a green suite over a broken path.
//
// The mechanism is one missing delivery leg.  `parse_return`'s `Type::Reference`
// arm has carried three since #306: the returned expression projects into a local
// (copy it), the returned value's DEPS view a local (copy it), otherwise rename
// the work-ref onto `__retbuf`.  The `Type::Enum(_, true, _)` arm — a payload enum
// — had only the first and the last.  So:
//
//     return e.value;              // an expression that projects → copied, correct
//     r = e.value; return r;       // a bare `Var` whose DEPS view `e` → renamed
//
// and the rename put the caller's return buffer on `e`'s store:
//
//     var_r = DbRef { ..var_e, pos: var_e.pos + 16 };   // an alias, never a copy
//     return var_r
//
// where the correct form materialises first (`OpCopyRecord(<e+16>, __ref_1)`).
//
// The report framed this as a `match` bug, which it is not: cells c3/c4 below drop
// both `match`es and still failed before the fix.  What is load-bearing is the
// THREE things c1 combines, each isolated by one cell:
//
//   * the callee has TWO `return` statements (c5 has one plus a tail expression
//     and was always correct — a single return does not take the rename path);
//   * the returned local is bound from a projection (c2 returns the field
//     directly and was always correct);
//   * the caller consumes the result as a TEMPORARY (c6 binds it first, which is
//     the workaround the consumer found, and was always correct).
//
// c7 is the control that named the root: the same shape returning a STRUCT was
// always correct, because the `Reference` arm already had the leg the `Enum` arm
// was missing.  Keep it — without it a fix that copies every enum return would
// pass, and that would pessimise every owned return in the language.
//
// The payload must exceed ~54 bytes: below that the value sits where the stale
// pointer still happens to read correctly, so a small-payload test proves nothing.
// 8 stays as the sub-threshold cell, 100 is the one that used to die.

enum Val { VNull, VInt { value: integer }, VBytes { value: vector<u8> } }
struct Entry { key: Val, value: Val }

struct Payload { bytes: vector<u8> }
struct Entry2 { key: integer, value: Payload }

fn big(n: integer) -> vector<u8> {
  v: vector<u8> = [];
  for i in 0..n { v += [ (i & 255) as u8 ]; }
  return v;
}

fn entries(sz: integer) -> vector<Entry> {
  return [
    Entry { key: VInt { value: 1 }, value: VInt { value: 1 } },
    Entry { key: VInt { value: 2 }, value: VBytes { value: big(sz) } },
  ];
}

// 1 — the reported shape, reduced: two returns, a local bound from a projection,
//     consumed by the caller as a temporary.
fn c1_get(es: vector<Entry>) -> Val {
  for i in 0..len(es) {
    e = es[i] ?? Entry { key: Val.VNull, value: Val.VNull };
    match e.key { VInt { value } => { if value == 2 { r = e.value; return r; } }, _ => {} }
  }
  return Val.VNull;
}
fn c1(sz: integer) -> integer {
  match c1_get(entries(sz)) { VBytes { value } => { return len(value); }, _ => {} }
  return 0 - 1;
}

// 2 — CONTROL: return the projection ITSELF.  `return_projects_into_local` reads
//     the expression, so this arm always copied.  It is the working IR the fix
//     makes cell 1 produce.
fn c2_get(es: vector<Entry>) -> Val {
  if len(es) > 1 { e = es[1] ?? Entry { key: Val.VNull, value: Val.VNull }; return e.value; }
  return Val.VNull;
}
fn c2(sz: integer) -> integer {
  match c2_get(entries(sz)) { VBytes { value } => { return len(value); }, _ => {} }
  return 0 - 1;
}

// 3 — no `match` anywhere in the callee: the report blamed a statement-form
//     `match`, and this cell failed identically without one.
fn c3_get(es: vector<Entry>) -> Val {
  if len(es) > 1 { e = es[1] ?? Entry { key: Val.VNull, value: Val.VNull }; r = e.value; return r; }
  return Val.VNull;
}
fn c3(sz: integer) -> integer {
  match c3_get(entries(sz)) { VBytes { value } => { return len(value); }, _ => {} }
  return 0 - 1;
}

// 4 — `if`/`else` with a return in BOTH arms.  No fall-through past the branch,
//     so what matters is having two `return` STATEMENTS, not reaching the end.
fn c4_get(es: vector<Entry>) -> Val {
  if len(es) > 1 {
    e = es[1] ?? Entry { key: Val.VNull, value: Val.VNull };
    r = e.value;
    return r;
  } else {
    return Val.VNull;
  }
}
fn c4(sz: integer) -> integer {
  match c4_get(entries(sz)) { VBytes { value } => { return len(value); }, _ => {} }
  return 0 - 1;
}

// 5 — CONTROL: one `return` plus a tail EXPRESSION.  Always correct, and it must
//     stay that way — its delivery is the one a "materialise everything" fix would
//     needlessly pessimise.
fn c5_get(es: vector<Entry>) -> Val {
  if len(es) > 1 { e = es[1] ?? Entry { key: Val.VNull, value: Val.VNull }; r = e.value; return r; }
  Val.VNull
}
fn c5(sz: integer) -> integer {
  match c5_get(entries(sz)) { VBytes { value } => { return len(value); }, _ => {} }
  return 0 - 1;
}

// 6 — CONTROL: the caller BINDS the result before matching it.  The workaround the
//     consumer found; it must keep working, and it hid the bug for them.
fn c6(sz: integer) -> integer {
  x = c1_get(entries(sz));
  match x { VBytes { value } => { return len(value); }, _ => {} }
  return 0 - 1;
}

// 7 — CONTROL: the identical shape returning a STRUCT rather than a payload enum.
//     Always correct, because the `Reference` arm already had the missing leg —
//     which is how the root was located.
fn c7_get(es: vector<Entry2>) -> Payload {
  if len(es) > 0 { e = es[0] ?? Entry2 { key: 0, value: Payload { bytes: [] } }; r = e.value; return r; }
  return Payload { bytes: [] };
}
fn c7(sz: integer) -> integer {
  es: vector<Entry2> = [ Entry2 { key: 1, value: Payload { bytes: big(sz) } } ];
  return len(c7_get(es).bytes);
}

fn check(sz: integer) {
  assert(c1(sz) == sz, "c1 reported shape at {sz}: {c1(sz)}");
  assert(c2(sz) == sz, "c2 direct-projection control at {sz}: {c2(sz)}");
  assert(c3(sz) == sz, "c3 no match at {sz}: {c3(sz)}");
  assert(c4(sz) == sz, "c4 if/else both return at {sz}: {c4(sz)}");
  assert(c5(sz) == sz, "c5 tail-expression control at {sz}: {c5(sz)}");
  assert(c6(sz) == sz, "c6 caller-binds control at {sz}: {c6(sz)}");
  assert(c7(sz) == sz, "c7 struct control at {sz}: {c7(sz)}");
}

fn main() {
  // 8 is below the threshold and passed even when broken — it is the control that
  // shows the harness runs, not evidence of a fix.  54/55 straddle the boundary
  // exactly; 100 and 500 are what the consumer actually hit.
  check(8);
  check(54);
  check(55);
  check(100);
  check(500);
  println("651 ok");
}
