//
// P6 — `Store` free-block coalescing.  `delete` only merged FORWARD, so
// repeated free/realloc churn left adjacent free blocks uncoalesced and
// the store grew unboundedly instead of reusing freed space.  The lazy
// `coalesce_free` sweep (run by `claim` before it would grow, reusing
// the contiguous block chain + the existing free tree — no new index)
// merges them so freed space is reused.  This is a cross-mode smoke test
// (the shared `Store` fixes both backends): heavy mixed allocate/drop
// churn must run correctly and keep capacity BOUNDED.  The precise
// guarantee (mergeable-pairs → 0, reuse without grow) is the Rust unit
// test `coalesce_free_merges_adjacent_and_reuses_space` in src/store.rs.

struct Box {
  tag: integer,
  data: vector<integer>,
}

// build a Box whose vector has `n` elements, return its checksum (forces
// the vector to be materialised), then let it drop at the call boundary.
fn churn(n: integer) -> integer {
  b: vector<integer> = [];
  i = 0;
  while i < n {
    b += [i * 2 + n]; i += 1;
  }
  s = 0;
  for x in b { s += x; }
  s
}

fn free_blocks_digits(report: text) -> integer {
  marker = "free-blocks ";
  pos = report.find(marker);
  assert(pos >= 0, "free-blocks marker present");
  rest = report[pos + len(marker)..len(report)];
  d = 0;
  for c in rest {
    if c.is_numeric() { d += 1; } else { break; }
  }
  d
}

fn main() {
  // Churn vectors of VARYING sizes many times.  Each call's vector is
  // freed at scope exit; the next (different-size) allocation must reuse
  // the coalesced freed space rather than growing the store unboundedly.
  total = 0;
  round = 0;
  while round < 400 {
    total += churn(10 + round % 50); // sizes cycle 10..59
    round += 1;
  }
  assert(total != 0, "churn produced a checksum");

  // After heavy churn the store must not have fragmented into a huge
  // free list (pre-P6 symptom).  free-blocks stays a small number.
  report = store_memory();
  d = free_blocks_digits(report);
  assert(d <= 3, "store stays coalesced after churn: free-blocks has {d} digits");

  println("126-store-coalesce ok");
}
