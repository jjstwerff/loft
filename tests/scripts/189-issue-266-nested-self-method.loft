//
// Regression for issue #266 — a `&self` method that calls ANOTHER `&self`
// method on the same receiver (a nested `self.advance()` inside `tick(&self)`).
// On the INTERPRETER the inner method's writes through `self` used to NOT
// persist: the nested receiver was wrapped in an extra `OpCreateStack`, giving
// it a DbRef pointing at the BORROWING frame's slot instead of the struct, so
// the callee's single `OpGetStackRef` deref landed in the stack store.  The
// inner write hit (and clobbered) the stack instead of the heap struct, and a
// later read saw stale state (or crashed).  `--native` always passed (it
// forwards the reference by the Rust ABI).
//
// Root cause (interpreter-only): `convert`'s `&`-wrap step re-wrapped a receiver
// whose declared var type was already `RefVar(_)` (a borrowed `&self` param) in
// `OpCreateStack`, double-borrowing it.  Fix: forward an already-borrowed
// non-text reference var to a `&`-parameter by value (no `OpCreateStack`) — it
// already holds the live borrow.  src/parser/mod.rs `convert`.
//
// Covers the whole class the boundary matrix surfaced: scalar / vector-element /
// whole-vector-reassign / nested-struct-field writes, 2- and 3-level nesting,
// non-zero field offsets, inner-takes-args, value-returning inner, the
// free-function (explicit-receiver) form, and a re-borrowed nested-struct field.

struct St { s_nw: vector<boolean>, s_pv: vector<boolean> }

fn st_new() -> St {
  a: vector<boolean> = [];
  bb: vector<boolean> = [];
  for _ in 0..8 { a += [false]; bb += [false]; }
  St{ s_nw: a, s_pv: bb }
}

fn snap(k: integer) -> vector<boolean> {
  v: vector<boolean> = [];
  for i in 0..8 { if i == k { v += [true]; } else { v += [false]; } }
  v
}

// The original #266 shape: nested `&self` call writing vector elements.
fn advance(self: &St) {
  for i in 0..8 { self.s_pv[i] = self.s_nw[i]; self.s_nw[i] = false; }
}
fn tick(self: &St, keys: vector<boolean>) {
  self.advance();                       // nested &self call — inner writes must persist
  for i in 0..8 { self.s_nw[i] = keys[i]; }
}

// Scalar field shape (the minimal repro).
struct Sc { a: integer, b: integer, c: integer }
fn sc_advance(self: &Sc) { self.b = self.a; self.a = 0; self.c = 99; }
fn sc_tick(self: &Sc, k: integer) { self.sc_advance(); self.a = k; }

// 3-level nesting + nested-struct field.
struct Inner { x: integer }
struct Deep { inr: Inner, n: integer }
fn d_deep(self: &Deep) { self.inr.x = 300; }
fn d_advance(self: &Deep) { self.d_deep(); self.n = 50; }
fn d_tick(self: &Deep) { self.d_advance(); self.n = self.n + 1; }

// Re-borrow a nested-struct field as a fresh `&self` receiver.
fn bump(self: &Inner) { self.x = 999; }
fn d_field_reborrow(self: &Deep) { self.inr.bump(); self.n = 7; }

// Inner takes args + returns a value.
fn v_advance(self: &Sc, base: integer) -> integer { self.a = base; self.b = base + 1; self.a }
fn v_tick(self: &Sc, base: integer) -> integer { x = self.v_advance(base); x + self.b }

fn main() {
  // ── vector-element through nested &self (cross-tick: pv carries last nw) ──
  s = st_new();
  s.tick(snap(3));
  assert(s.s_nw[3], "tick1 nw[3]");
  assert(!s.s_pv[3], "tick1 pv[3] still false");
  s.tick(snap(5));
  for i in 0..8 {
    assert(s.s_nw[i] == (i == 5), "tick2 nw[{i}]");
    assert(s.s_pv[i] == (i == 3), "tick2 pv[{i}] carries last nw");
  }

  // ── scalar field, nested + non-zero offset (b@8, c@16) ──
  sc = Sc{ a: 0, b: 0, c: 0 };
  sc.sc_tick(7);
  assert(sc.a == 7, "sc1 a==7");
  assert(sc.b == 0, "sc1 b==0 first tick");
  assert(sc.c == 99, "sc1 c==99 nonzero offset");
  sc.sc_tick(9);
  assert(sc.a == 9, "sc2 a==9");
  assert(sc.b == 7, "sc2 b==7 (carried sc.a from the previous tick)");

  // ── 3-level nesting + nested-struct field ──
  d = Deep{ inr: Inner{ x: 0 }, n: 0 };
  d.d_tick();
  assert(d.inr.x == 300, "deep inr.x==300 (3 levels down)");
  assert(d.n == 51, "deep n==51");

  // ── re-borrow a nested-struct field ──
  d2 = Deep{ inr: Inner{ x: 0 }, n: 0 };
  d2.d_field_reborrow();
  assert(d2.inr.x == 999, "field-reborrow inr.x==999");
  assert(d2.n == 7, "field-reborrow n==7");

  // ── inner takes args + returns a value ──
  v = Sc{ a: 0, b: 0, c: 0 };
  r = v.v_tick(40);
  assert(v.a == 40, "value-inner a==40");
  assert(v.b == 41, "value-inner b==41");
  assert(r == 81, "value-inner return==81");

  // ── free-function (explicit-receiver) form of the nested call ──
  sc2 = Sc{ a: 1, b: 1, c: 1 };
  sc_advance(sc2);
  assert(sc2.b == 1, "free-fn form b==1 (was a)");
  assert(sc2.a == 0, "free-fn form a==0");
  assert(sc2.c == 99, "free-fn form c==99");

  print("issue-266 nested &self method writes persist: ok\n");
}
