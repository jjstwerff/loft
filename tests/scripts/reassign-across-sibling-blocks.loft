// A local reassigned across SIBLING conditional blocks answers the same thing however the
// stores behind it are managed.
//
// This is plan-57 cluster III's shared-block variant.  Reassigning a local inside sibling
// `if` / `else if` / `match` arms leaves every arm's store pinned to scope exit, so the
// store watermark grows with the NUMBER OF REASSIGNMENT SITES — not with how many of them
// actually run.  Measured 2026-08-21, one call, only ever one arm taken:
//
//     sites          2      4      8     16
//     peak stores    6      8     12     20        (default)
//     peak stores    5      5      5      5        (LOFT_CONF_RECOVER=1)
//
// It is a watermark cost, not a leak — every store is freed, and the run is exit-safe.
// `LOFT_CONF_RECOVER=1` gates the Route 2 experiment that confines each block's store to
// its block, turning O(sites) into O(1).  It is OFF by default and un-gating it is an owner
// decision, because the analysis is soundness-delicate: the first gate design was REFUTED
// by the `not_taken` case below, which returned the wrong element when a confined block
// store was freed while the local still held it.
//
// This file is the VALUE half, and it is written to pass under BOTH settings — that is the
// point.  Run it with the gate on before changing the default:
//
//     LOFT_CONF_RECOVER=1 cargo nextest run --release --test wrap
//
// A watermark cannot be asserted from inside loft, so the numbers above are recorded here
// rather than checked; what is checked is that confinement never changes an ANSWER.

fn main() {
  // ── the confinable shape: the local is consumed INSIDE each block, never read after ──
  assert(consumed_in_block(0) == 1, "arm 0 consumed in block");
  assert(consumed_in_block(1) == 3, "arm 1 consumed in block");
  assert(consumed_in_block(9) == 9, "else arm consumed in block");

  // ── the post-block READ: confinement must decline here, or the read is a use-after-free
  //    on the branch that did NOT run.  This is the shape that refuted the first design. ──
  assert(read_after_block(true) == 2, "branch taken, read after the block");
  assert(read_after_block(false) == 7, "branch NOT taken, read after the block");

  // ── the same across match arms rather than if/else ───────────────────────────────────
  assert(match_arm_reassign(0) == 0, "match arm 0");
  assert(match_arm_reassign(2) == 2, "match arm 2");
  assert(match_arm_reassign(5) == 9, "match wildcard arm");

  // ── straight-line reassignment, which last-use freeing already made O(1) — kept so a
  //    change that breaks the SHIPPED half is caught beside the gated one ───────────────
  assert(straight_line() == 10, "straight-line reassignment");
}

fn consumed_in_block(k: integer) -> integer {
  total = 0;
  z = [k, k];
  if k == 0 { z = [1, k]; total += z[0]; }
  else if k == 1 { z = [3, k]; total += z[0]; }
  else { z = [k, k]; total += z[1]; }
  total
}

fn read_after_block(c: boolean) -> integer {
  z = [0, 7];
  if c { z = [1, 2]; }
  z[1]
}

fn match_arm_reassign(k: integer) -> integer {
  x = [0, 0];
  match k { 0 => { x = [0, 0]; }, 1 => { x = [1, 1]; }, 2 => { x = [2, 2]; }, _ => { x = [9, 9]; } }
  x[1]
}

fn straight_line() -> integer {
  v = [0, 1];
  v = [5, 6];
  v = [10, 11];
  v[0]
}
