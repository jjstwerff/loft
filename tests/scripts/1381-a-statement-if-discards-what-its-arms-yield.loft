//
// loft#1381 — an `if` in STATEMENT position discards what its arms yield, and the work still
// runs.  `(F-Block)` in `formal/calls.md`: a block's value "is discarded only where the BLOCK
// itself is a statement — a `;`-terminated one, a loop body, or the body a function drops by
// F-Drop", and `(F-Drop)` says in as many words that "the tail still RUNS — the discard is of
// the value, not of the work".
//
// The interpreter has always done that.  The native emitter rendered each arm as a Rust
// EXPRESSION, so `if c { println("x") } else { 5 }` handed rustc a `()` arm beside an `i64`
// one and the user got a raw `error[E0308]: `if` and `else` have incompatible types` for a
// program loft accepts — a compiler error escaping to someone who wrote no Rust.  The `else if`
// chain failed the same way.
//
// The discriminator is a VOID arm beside a non-void one, and it is exact rather than a proxy:
// an `if` read as a VALUE has arms the parser already made agree, and a void arm could not be
// read.  `emit.rs::output_if_inner` gives that shape `{ <arm>; }` on both sides, which is what
// a statement means.
//
// Measured while writing this guard and filed apart (loft#1382): the MIRROR statement
// `if c { 5 } else { println("x") };` is REFUSED at parse time with "expected integer, got
// void on else", so the language accepts one order of a statement `if` and not the other.
// `(F-Block)` discards either, so the refusal is the odd one out.
//
// @falsified-at: 50f87d36 — native exit 1 -> 0; interpret INERT, which is the honest answer
// for a backend-divergence guard: the interpreter accepted this program before the fix and
// accepts it after, so only one side can move.
fn side(n: integer) -> integer { n * 2 }

fn a_statement_if_with_a_value_else_arm_runs_both_arms() {
  log: vector<integer> = [];
  k = 2;
  if k == 1 { log += [1] } else { log += [2]; 5 };
  assert(len(log) == 1 && log[0] == 2, "the else arm's work runs and its value is discarded");
  // The MIRROR — a value in the THEN arm beside a void else — is REFUSED at parse time
  // ("expected integer, got void on else"), on both backends, and that asymmetry predates this
  // fix: one order of the same statement is accepted and the other is not, while `(F-Block)`
  // discards either.  Recorded here rather than asserted, because a guard cannot pin a program
  // the parser will not accept; loft#1382 carries it.
}

fn an_else_if_chain_discards_every_arm() {
  log: vector<integer> = [];
  k = 2;
  if k == 1 { log += [1] } else if k == 2 { log += [2]; 5 } else { log += [3]; 6 };
  assert(len(log) == 1 && log[0] == 2, "the chain takes one arm, runs it, discards its value");
}

fn a_discarded_call_still_happens() {
  log: vector<integer> = [];
  k = 0;
  if k == 1 { log += [1] } else { log += [side(21)] };
  assert(len(log) == 1 && log[0] == 42, "a call in a discarded arm is still called");
}

// CONTROL — an `if` read as a VALUE keeps both arms' values, and its arms agree by
// construction.  A fix that discarded every arm would fail here.
fn a_value_if_still_yields_its_arm() {
  k = 2;
  v = if k == 1 { 10 } else { 20 };
  assert(v == 20, "control: a value if yields the arm it took");
  t = if k == 1 { "a" } else { "b" };
  assert(t == "b", "control: and the same for text");
  w = if k == 1 { 10 } else if k == 2 { 20 } else { 30 };
  assert(w == 20, "control: a value else-if chain yields its arm");
}

// CONTROL — both arms void, which is what a statement `if` usually looks like.
fn a_wholly_void_statement_if_is_unchanged() {
  log: vector<integer> = [];
  k = 1;
  if k == 1 { log += [1] } else { log += [2] };
  assert(len(log) == 1 && log[0] == 1, "control: a void statement if is unaffected");
  if k == 9 { log += [9] };
  assert(len(log) == 1, "control: an if with no else is unaffected");
}

fn main() {
  a_statement_if_with_a_value_else_arm_runs_both_arms();
  an_else_if_chain_discards_every_arm();
  a_discarded_call_still_happens();
  a_value_if_still_yields_its_arm();
  a_wholly_void_statement_if_is_unchanged();
  println("ok");
}
