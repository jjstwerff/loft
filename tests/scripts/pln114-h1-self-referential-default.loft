//
// Regression: a self-referential `??` default (`c = t[k] ?? c`) used to SIGSEGV the
// COMPILER — `--interpret`, `--native` and even `--interpret --check` (compile-only,
// never runs `main`) died with no diagnostic.  Reported by the crawler consumer
// (LOFT-HANDOFF H1) on toolchain 2026.7.2.
//
// Cause: `use_analysis::Ownership::classify` resolves a var by classifying its RHSs,
// and a self-referential default puts the var inside its own RHS — unbounded
// recursion until the stack overflowed.  The function-level guard (`visiting`) had no
// var-level twin; it does now.
//
// The crash needed a REFERENCE-typed target: the scalar forms below always worked,
// and they are kept so a future fix cannot narrow the guard to structs only.

struct D { k: text, lvl: integer }

fn test_self_referential_default_struct() {
  t: vector<D> = [];
  t += [D { k: "rat", lvl: 1 }];
  c = D { k: "none", lvl: 0 };
  c = t[0] ?? c;
  assert(c.k == "rat" && c.lvl == 1, "self-referential ?? default on a struct");
}

fn test_self_referential_default_in_loop() {
  t: vector<D> = [];
  t += [D { k: "bat", lvl: 2 }];
  c = D { k: "none", lvl: 0 };
  for i in 0..len(t) { c = t[i] ?? c; }
  assert(c.k == "bat", "self-referential ?? default inside a loop");
}

fn test_self_referential_default_scalar() {
  v: vector<integer> = [7];
  x = 0;
  x = v[0] ?? x;
  assert(x == 7, "self-referential ?? default on an integer");
}

fn test_self_referential_plain_nullable() {
  n: integer? = 5;
  y = 0;
  y = n ?? y;
  assert(y == 5, "self-referential ?? default on a plain nullable");
}
