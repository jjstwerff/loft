//
// loft#1207's CONTROL half.  A keyed LOCAL still refuses a bare vector source, and the `?` on
// the declaration does not change that.
//
// The fix for loft#1207 peels the optional inside `is_collection`, so a `vector<τ>?` stops
// being the one collection that predicate denied.  The risk a peel carries is reaching FURTHER
// than the defect, and this file is where that would show: dense and nullable AGREE here that
// `+= [elem]` is the documented spelling for a keyed local, so a cell that starts COMPILING
// means the peel admitted a shape the language refuses on purpose, not one it was dropping.
//
// In its own file because a firing `@EXPECT_ERROR` stops a file before it runs; the positive
// half — every cell the fix is FOR — is
// `1207-a-nullable-collection-appends-a-non-literal-source.loft`.
//
// @falsified-at: 484c5831 — MEASURED, and the channel is `check_diagnostics`, not the exit.
//   Both cells report the same diagnostic on the parent commit as on the fixed build, which is
//   the POINT of a control: it is the cell that must not move, so a guard that only passed
//   after the fix would be measuring the wrong thing.  What makes it falsifiable is the
//   opposite build — with the peel widened to admit a keyed local, both `@EXPECT_ERROR` lines
//   go unmatched and `tests/wrap.rs` fails the file.

struct Ek1207b { k: integer, nm: text }

// A DENSE keyed local: `+= <vector value>` is refused, and has been throughout.
// @EXPECT_ERROR: cannot change type from hash
fn test_1207b_dense_keyed_local_refuses_a_vector_source() {
  src1207b: vector<Ek1207b> = [Ek1207b { k: 1, nm: "one" }];
  h1207b: hash<Ek1207b[k]> = [];
  h1207b += src1207b;
  assert(len(h1207b) == 1, "unreached");
}

// The NULLABLE twin one `?` over: the peel must not make this one compile.
// @EXPECT_ERROR: cannot change type from hash
fn test_1207b_nullable_keyed_local_refuses_a_vector_source() {
  src1207c: vector<Ek1207b> = [Ek1207b { k: 2, nm: "two" }];
  h1207c: hash<Ek1207b[k]>? = [];
  h1207c += src1207c;
  assert(len(h1207c?) == 1, "unreached");
}
