//
// @PLN102 C93 — a `par(worker, n)` worker may only READ; the loop ELEMENT it
// receives is a per-worker clone, so WRITING it (directly or via a helper) is a
// lost write / would-be data race.  loft DISALLOWS it (a clean COMPILE error at
// the par-safety check) rather than run it — no runtime errors, ever.  (Captured
// context REFERENCES are disallowed outright by pln102-c93-par-captured-ref.loft;
// this file covers writing the reference ELEMENT.)  Reads + pure folds are fine.
//
// @EXPECT_ERROR: worker writeit writes captured `e`
// @EXPECT_ERROR: worker writevec writes captured `v`
// @EXPECT_ERROR: worker outer → bump writes captured `s`

struct S { n: integer }
fn writeit(e: S) -> integer { e.n = 5; e.n }                 // writes the struct element
fn writevec(v: vector<integer>) -> integer { v[0] = 9; 0 }  // writes the vector element
fn bump(s: S) { s.n = s.n + 1; }
fn outer(e: S) -> integer { bump(e); e.n }                  // transitive element write

fn use_direct() { rows: vector<S> = [S { n: 1 }, S { n: 2 }]; for e in rows par(r = writeit(e), 2) { } }
fn use_vec() { vv: vector<vector<integer>> = [[1], [2]]; for v in vv par(r = writevec(v), 2) { } }
fn use_indirect() { rows: vector<S> = [S { n: 1 }, S { n: 2 }]; for e in rows par(r = outer(e), 2) { } }

fn main() { }
