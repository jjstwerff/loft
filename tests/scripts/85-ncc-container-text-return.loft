// @PLN85 corpus text-leak class 2 — a `??` (null-coalesce) whose subject is a
// text element of a container, returned from a fn.  The coalesce wraps its
// selecting `if` in an "ncc" block; `if_tail_yields_text` (control.rs) must see
// THROUGH that block so the return takes the per-arm `__acc` buffer promotion.
// Before the fix the ncc classified `Plain`, got no buffer, and the owned
// element copy (`OpGetText`) orphaned on the interpreter (native RAII-drops it).
// The bare `tv[0]` twin (no `??`) always delivered through the buffer and was
// leak-free — this is the ncc matching that proven shape.  Graduated from
// probes/corpus-optional-text/ (p356_* / idx_noncc / ncc_argvec).

// `??` over a LOCAL vector<text> (the container is freed before return, so the
// element must be copied out — owned delivery through the caller buffer).
fn coalesce_local(idx: integer, fb: text) -> text {
  tv: vector<text> = ["a", "b"];
  return tv[idx] ?? fb;
}

// `??` over an ARGUMENT vector<text> (caller owns the container).
fn coalesce_arg(tv: vector<text>, fb: text) -> text {
  return tv[idx_of()] ?? fb;
}
fn idx_of() -> integer { return 0; }

// `?? null` over a local vector<text> — the fallback is the null-text sentinel.
fn coalesce_null(idx: integer) -> text? {
  tv: vector<text> = ["x", "y"];
  return tv[idx] ?? null;
}

// The proven twin: a bare element return, no coalesce (always leak-free).
fn index_only() -> text {
  tv: vector<text> = ["a", "b"];
  return tv[0];
}

fn main() {
  assert(coalesce_local(0, "fb") == "a", "present arm: {coalesce_local(0, \"fb\")}");
  assert(coalesce_local(9, "fb") == "fb", "fallback arm (OOB): {coalesce_local(9, \"fb\")}");
  args: vector<text> = ["p", "q"];
  assert(coalesce_arg(args, "fb") == "p", "arg-container present arm");
  assert(coalesce_null(1) == "y", "null-fallback present arm");
  assert(coalesce_null(9) == null, "null-fallback OOB arm is null");
  assert(index_only() == "a", "proven twin: bare element return");
  println("ncc-container-text-return ok");
}
