// A `trie<T[k]>` text-keyed collection: declare, insert, exact lookup, key-order
// iteration, PREFIX slice, and free — on BOTH backends, against hand-computed
// values.  The design gate for doc/claude/plans/text-keyed-trie.md step 6.
//
// A `sorted<T[k]>` control carries the same six words alongside, so a regression
// cannot hide in "both answers are empty": every count below is asserted against
// the control's, and the control's own numbers are written out by hand.
//
// The cell that matters is "kerx".  It sorts BETWEEN `kerkweg` and `lonneker`, so
// a seek for that prefix lands on `lonneker`; a missing stop-check would answer
// that record instead of nothing.
struct TWord {
  w: text,
  n: integer,
}
struct TBox {
  words: trie<TWord[w]>,
}

fn main() {
  t: trie<TWord[w]> = [];
  c: sorted<TWord[w]> = [];
  t += [
    TWord { w: "kerkweg", n: 2 },
  ];
  c += [
    TWord { w: "kerkweg", n: 2 },
  ];
  t += [
    TWord { w: "aap", n: 5 },
  ];
  c += [
    TWord { w: "aap", n: 5 },
  ];
  t += [
    TWord { w: "kerk", n: 1 },
  ];
  c += [
    TWord { w: "kerk", n: 1 },
  ];
  t += [
    TWord { w: "lonneker", n: 4 },
  ];
  c += [
    TWord { w: "lonneker", n: 4 },
  ];
  t += [
    TWord { w: "kerkstraat", n: 3 },
  ];
  c += [
    TWord { w: "kerkstraat", n: 3 },
  ];

  assert(t.len() == 5, "len counts every inserted word");
  assert(t.len() == c.len(), "trie and sorted hold the same five words");

  // Key order is BYTE order, and the terminator sorts before any byte — which is
  // why `kerk` precedes `kerkstraat`, and `kerkstraat` precedes `kerkweg` ('s' <
  // 'w').  Written out by hand: aap, kerk, kerkstraat, kerkweg, lonneker.
  order: text = "";
  for x in t { order += "{x.w}," }
  assert(
    order == "aap,kerk,kerkstraat,kerkweg,lonneker,",
    "in-order walk is key order",
  );
  corder: text = "";
  for x in c { corder += "{x.w}," }
  assert(order == corder, "trie order matches the sorted control");

  // Exact lookup, present and absent.  An absent key is null, never a neighbour.
  hit = t["kerkweg"];
  assert(hit != null, "exact lookup finds the key");
  assert(hit.n == 2, "exact lookup returns that key's record");
  assert(t["kerx"] == null, "an absent key is null, not its neighbour");
  assert(t["kerk"].n == 1, "a key that is a PREFIX of another is found itself");

  // The prefix slice — the capability `sorted` cannot offer without a successor
  // string.  `kerk` bears three: kerk, kerkstraat, kerkweg.  `lonneker` must not
  // leak in, and `aap` sorts before the seek so it cannot.
  pre: text = "";
  pre_n: integer = 0;
  for x in t["kerk"..] {
    pre += "{x.w},";
    pre_n += 1;
  }
  assert(pre_n == 3, "the prefix slice yields exactly the three kerk* words");
  assert(pre == "kerk,kerkstraat,kerkweg,", "prefix results come in key order");

  // The absent-prefix cell.  A seek for `kerx` lands on `lonneker`; the stop-check
  // is what makes this empty rather than one wrong record.
  absent_n: integer = 0;
  for x in t["kerx"..] { absent_n += 1; }
  assert(absent_n == 0, "an absent prefix yields nothing, not its neighbour");

  // A prefix that is a whole key and bears nothing further.
  leaf_n: integer = 0;
  leaf_w: text = "";
  for x in t["lonneker"..] {
    leaf_n += 1;
    leaf_w += "{x.w},";
  }
  assert(leaf_n == 1, "a leaf prefix yields just its own record");
  assert(leaf_w == "lonneker,", "and it is the right one");

  // An empty prefix begins every key, so it is the whole collection.
  every_n: integer = 0;
  for x in t[""..] { every_n += 1; }
  assert(every_n == 5, "the empty prefix is every record");

  // The cap takes the FIRST n in key order.
  cap_n: integer = 0;
  cap_w: text = "";
  for x in t["kerk"..:2] {
    cap_n += 1;
    cap_w += "{x.w},";
  }
  assert(cap_n == 2, "a capped prefix slice stops at n");
  assert(cap_w == "kerk,kerkstraat,", "and takes the first n in key order");

  // A trie as a STRUCT FIELD — laid out, filled, read, and torn down with its
  // container.  The runner's leak check is the real assertion here.
  b = TBox { words: [] };
  b.words += [
    TWord { w: "zon", n: 9 },
  ];
  b.words += [
    TWord { w: "zonnebloem", n: 10 },
  ];
  b.words += [
    TWord { w: "maan", n: 11 },
  ];
  assert(b.words.len() == 3, "struct-field trie len");
  field_n: integer = 0;
  for x in b.words["zon"..] { field_n += 1; }
  assert(field_n == 2, "struct-field trie answers a prefix slice");
  assert(b.words["maan"].n == 11, "struct-field trie answers an exact lookup");

  print("trie ok\n");
  // `t`, `c` and `b` fall out of scope here; remove_claims frees the tree and
  // every element record with no leak.
}
