//
// The Parallel execution chapter's guarantees, across the shapes it shows one of.
//
// The chapter has to stay a first read, so it demonstrates one source, one thread count and
// one return type.  Every claim it makes is broader than its cells: order holds for every
// ordered source and every N, and a hash is the stated exception.  None of that was checked
// anywhere — the chapter asserted a three-element vector doubled on four threads, which
// passes on a build where `par` ignores N and runs everything sequentially.
//
// What each group is for:
//
//   * ORDER.  Uneven work, so a run that delivered COMPLETION order rather than source order
//     visibly reorders — the low indices burn the most.  A three-element vector of trivial
//     workers cannot fail that way, which is why the chapter's own cells could not.
//   * N IS NOT SEMANTIC (`C-Det`).  The same source at four thread counts must give one
//     answer.  Without this an implementation that silently ran everything on one thread
//     would satisfy every other cell here.
//   * THE HASH EXCEPTION (`C-Order`).  A hash flattens in storage order, so its ORDER is
//     deliberately undefined and its multiset is not.  Asserting the multiset is the only
//     honest form: pinning the order would pin a value measured to change between runs — the
//     same eight elements came back `12,6,10,0,…` and `14,10,0,12,…` on two runs of one
//     binary, against a key-ordered `0,2,4,…` from the sequential loop.
//
// The chapter's REFUSALS live next door in
// `the-reference-par-refuses-the-two-shapes-it-warns-about.loft`, deliberately not in this
// file.  A file holding both kinds can only be verified through the Rust suite: the
// documented `loft --tests <file>` CLI path SKIPS every running cell in a file that carries
// an `@EXPECT_ERROR`, so a broken assertion here still reported `ok` — and a multi-cell
// refusal file credits every declaration after a firing one without matching (loft#1261).
// Split, each half is checkable with a direct run.
//
// @falsified-at: none — a LOCK.  Every cell states a guarantee the language already keeps,
//   so no build in this repo's history fails it; what it catches is a future `par` that
//   stops keeping one.
//
//   Checked by hand instead: each cell's expected value was replaced in turn by one the
//   language does not produce, and each failed.  The order cell was additionally run with
//   its comparison inverted, so it is comparing what it claims to.
//
//   The one guarantee NOT pinned anywhere is the chapter's third worker rule — no shared
//   state, no I/O.  `(C-Impure)` makes that the author's contract rather than the
//   compiler's, so there is no refusal to expect and no defined answer to assert: a worker
//   appending to a file leaves one line of three, and which one changes per run.  A test
//   asserting any of that would be asserting undefined behaviour.

struct PS { value: integer }
struct PRow { k: text, n: integer }
struct PLabel { label: text, n: integer }

// ── ORDER ────────────────────────────────────────────────────────────────────────────────

// Deliberately uneven: element 0 does the most work, so completion order is the reverse of
// source order and a run that delivered it would fail on the first element.
fn p_slow(p_r: const PS) -> integer {
  p_acc = 0;
  for p_i in 0..((200 - p_r.value) * 300) { p_acc += p_i % 7; }
  p_r.value + (p_acc % 1)
}

fn a_par_over_a_vector_delivers_source_order() {
  p_v: vector<PS> = [];
  for p_i in 0..200 { p_v += [ PS { value: p_i } ]; }
  p_seen = 0;
  p_ok = true;
  for p_a in p_v par(p_b = p_slow(p_a), 8) {
    if p_b != p_seen { p_ok = false; }
    p_seen += 1;
  }
  assert(p_seen == 200, "every element reached the body: {p_seen}");
  assert(p_ok, "results arrived out of source order");
}

fn p_double(p_n: integer) -> integer { p_n * 2 }

fn a_par_over_a_range_delivers_source_order() {
  p_ord = "";
  for p_i in 0..6 par(p_d = p_double(p_i), 4) { p_ord += "{p_d},"; }
  assert(p_ord == "0,2,4,6,8,10,", "range order: {p_ord}");
}

fn p_one(p_c: character) -> integer { if p_c == ' ' { 0 } else { 1 } }

fn a_par_over_a_text_visits_every_character() {
  p_n = 0;
  for p_c in "hello" par(p_x = p_one(p_c), 4) { p_n += p_x; }
  assert(p_n == 5, "text source: {p_n}");
}

fn p_row_double(p_r: const PRow) -> integer { p_r.n * 2 }

// `sorted` keeps its order under `par`, which is what makes it the answer when a keyed
// source has to be ordered.
fn a_par_over_a_sorted_delivers_key_order() {
  p_s: sorted<PRow[k]> = [];
  p_s += PRow { k: "c", n: 3 };
  p_s += PRow { k: "a", n: 1 };
  p_s += PRow { k: "b", n: 2 };
  p_ord = "";
  for p_a in p_s par(p_b = p_row_double(p_a), 4) { p_ord += "{p_b},"; }
  assert(p_ord == "2,4,6,", "sorted keeps key order under par: {p_ord}");
}

// ── N IS A SPEED KNOB, NOT A SEMANTIC ONE ────────────────────────────────────────────────

fn a_thread_count_never_changes_the_answer() {
  p_v: vector<PS> = [];
  for p_i in 0..40 { p_v += [ PS { value: p_i } ]; }
  p_one_t = 0;
  for p_a in p_v par(p_b = p_thrice(p_a), 1) { p_one_t += p_b; }
  p_two_t = 0;
  for p_a in p_v par(p_b = p_thrice(p_a), 2) { p_two_t += p_b; }
  p_four_t = 0;
  for p_a in p_v par(p_b = p_thrice(p_a), 4) { p_four_t += p_b; }
  p_many_t = 0;
  for p_a in p_v par(p_b = p_thrice(p_a), 16) { p_many_t += p_b; }
  // 3 * (0 + 1 + … + 39)
  assert(p_one_t == 2340, "N=1: {p_one_t}");
  assert(p_one_t == p_two_t, "N=2 disagreed with N=1: {p_two_t}");
  assert(p_one_t == p_four_t, "N=4 disagreed with N=1: {p_four_t}");
  assert(p_one_t == p_many_t, "N=16 disagreed with N=1: {p_many_t}");
}

fn p_thrice(p_r: const PS) -> integer { p_r.value * 3 }

// ── THE HASH EXCEPTION ───────────────────────────────────────────────────────────────────

// A hash flattens in storage order, so only the MULTISET is defined.  Summing is the
// order-independent reading of "every element was worked exactly once", and it is what the
// chapter now tells a reader to rely on for a hash.
fn a_par_over_a_hash_works_every_element_exactly_once() {
  p_h: hash<PRow[k]> = [];
  for p_i in 0..8 { p_h += PRow { k: "k{p_i}", n: p_i }; }
  p_sum = 0;
  p_count = 0;
  for p_a in p_h par(p_b = p_row_double(p_a), 4) {
    p_sum += p_b;
    p_count += 1;
  }
  // 2 * (0 + 1 + … + 7)
  assert(p_count == 8, "hash source visited {p_count} of 8");
  assert(p_sum == 56, "hash source total: {p_sum}");
}

// ── RETURN TYPES ─────────────────────────────────────────────────────────────────────────

fn p_ret_text(p_r: const PS) -> text { "v{p_r.value}" }
fn p_ret_char(p_r: const PS) -> character { if p_r.value > 0 { 'x' } else { 'o' } }
fn p_ret_bool(p_r: const PS) -> boolean { p_r.value > 1 }
fn p_ret_float(p_r: const PS) -> float { p_r.value * 1.5 }
fn p_ret_struct(p_r: const PS) -> PLabel { PLabel { label: "v{p_r.value}", n: p_r.value } }
fn p_ret_vector(p_r: const PS) -> vector<integer> { [p_r.value, p_r.value] }

fn every_documented_return_type_survives_the_worker() {
  p_v: vector<PS> = [ PS { value: 1 }, PS { value: 2 } ];
  p_t = "";
  for p_a in p_v par(p_b = p_ret_text(p_a), 2) { p_t += "{p_b},"; }
  assert(p_t == "v1,v2,", "text return: {p_t}");

  p_c = "";
  for p_a in p_v par(p_b = p_ret_char(p_a), 2) { p_c += "{p_b}"; }
  assert(p_c == "xx", "character return: {p_c}");

  p_bl = "";
  for p_a in p_v par(p_b = p_ret_bool(p_a), 2) { p_bl += "{p_b},"; }
  assert(p_bl == "false,true,", "boolean return: {p_bl}");

  p_f = 0.0;
  for p_a in p_v par(p_b = p_ret_float(p_a), 2) { p_f += p_b; }
  assert(p_f == 4.5, "float return: {p_f}");

  p_st = "";
  for p_a in p_v par(p_b = p_ret_struct(p_a), 2) { p_st += "{p_b.label},"; }
  assert(p_st == "v1,v2,", "struct return: {p_st}");

  p_len = 0;
  for p_a in p_v par(p_b = p_ret_vector(p_a), 2) { p_len += len(p_b); }
  assert(p_len == 4, "vector return: {p_len}");
}

