//
// Regression (plan-57 @PLN2 follow-up / Fix A): an early `return` ABOVE several
// reclaim-eligible body-scoped vector locals emitted a scope-exit free of those
// stores inside the return block; `lastuse_reclaim` then relocated each store's
// null-init DECLARATION down past that free, stranding it out of scope in the
// generated Rust — `error[E0425]: cannot find value var___vdb_NN in this scope`
// (92× on the brick-buster --html build; reproduced with --native-emit too).
// Fix A excluded such stores from reclaim (body-0 declaration kept; watermark
// benefit forfeited — 46/46 owning stores in brick-buster's generator).  #260
// Fix B replaced it: both backends now declare/sentinel-init every `__vdb`
// up front (native: prologue `let mut var_… = sentinel`; interpreter:
// `OpInitRefSentinel` per slot at function entry), so the early-return free
// hits a null sentinel (free no-ops) and the relocated null-init +
// `OpDatabase` keep their IR position (allocation timing unchanged).  These
// stores are reclaim-eligible again.  Both backends + the --native compile
// must succeed; the wrap leak gate confirms zero leaked stores.

fn run(early: boolean) -> integer {
  if early { return 0; } // early-return free of a/b/c's body-scoped __vdb
  a = [1, 2, 3]; // reclaim-eligible; its let-decl must stay at body-0
  b = [4, 5, 6];
  c = [7, 8, 9];
  a[0] + b[1] + c[2]
}

fn main() {
  assert(run(false) == 1 + 5 + 9, "vectors after the early-return guard intact");
  assert(run(true) == 0, "early-return path returns 0");
  print("ok\n");
}
