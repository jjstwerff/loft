// @PLN85: `v[i] ?? <vector-literal>` in RETURN-TAIL position — two fixed bugs, one shape.
//
// (1) EMPTY `[]` default: with no context hint the literal typed Unknown → null (P365
//     family), the delivery classified the ncc `if` as a null-arm shape, skipped
//     materialisation, and native emitted `()` (E0308).  Fixed by threading the LHS
//     BASE type as the `??` default's parse hint (operators.rs).
// (2) NON-EMPTY `[7]` default: the owned-fresh default work-vector `_vec_N` was freed
//     by the PRE-RETURN sweep while the return expression's else-arm still wrote it —
//     a genuine both-backends use-after-free (interp read the freed store silently,
//     LOFT_POISON turned it into a SIGSEGV, native crashed on the 65535 sentinel).
//     Fixed at two chokepoints: the return-delivery materializer CONSUMES an
//     owned-fresh arm local (free-after-append + a cross-arm free so the untaken
//     path frees the preamble store too), and `insert_free`'s reads-filter drops a
//     pre-return free of any var the returned tail still reads (scopes.rs).
//
// Cells: empty/non-empty literal × value/null path, plus the always-clean twins
// (local bind, variable fallback).  Leak-checked in the suite via the wrap gate.

fn deliver_empty(vv: vector<vector<integer>>, i: integer) -> vector<integer> {
  vv[i] ?? []
}

fn deliver_lit(vv: vector<vector<integer>>, i: integer) -> vector<integer> {
  vv[i] ?? [7]
}

fn deliver_var(vv: vector<vector<integer>>, d: vector<integer>, i: integer) -> vector<integer> {
  vv[i] ?? d
}

fn main() {
  vv = [[1, 2, 3], [4, 5, 6]];

  r = deliver_empty(vv, 1);
  assert(len(r) == 3, "empty-default value path: {len(r)}");
  assert((r[0] ?? -1) == 4, "empty-default value: {r[0] ?? -1}");
  re = deliver_empty(vv, 9);
  assert(len(re) == 0, "empty-default null path: {len(re)}");

  rl = deliver_lit(vv, 1);
  assert(len(rl) == 3 && (rl[2] ?? -1) == 6, "lit-default value path: {len(rl)}");
  rn = deliver_lit(vv, 9);
  assert(len(rn) == 1 && (rn[0] ?? -1) == 7, "lit-default null path: {rn[0] ?? -1}");
  // Call the literal-default fn AGAIN — the consumed work-vector must be reborn
  // per call (a stale sentinel or double-free would corrupt the second call).
  rn2 = deliver_lit(vv, 9);
  assert(len(rn2) == 1 && (rn2[0] ?? -1) == 7, "lit-default repeat: {rn2[0] ?? -1}");

  // The always-clean twins pin the contrast.
  rloc = vv[1] ?? [];
  assert(len(rloc) == 3, "local-bind twin: {len(rloc)}");
  d = [9, 9];
  rv = deliver_var(vv, d, 5);
  assert(len(rv) == 2, "variable-fallback twin: {len(rv)}");

  println("ncc-literal-return-delivery ok {rl[0] ?? -1} {rn[0] ?? -1}");
}
