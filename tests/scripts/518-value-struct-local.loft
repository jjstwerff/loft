//
// @PLN101 — LOCAL-TO-LOCAL value semantics for `value struct`. The copy pass (scopes.rs) only
// needs to intercept reads of a value struct out of a FIELD / VECTOR ELEMENT / method param (the
// `Borrowed` views — see 516/517), because loft's existing var-to-var assignment ALREADY
// deep-copies a struct local (`b = a` allocates b its own record and deep-copies inner text/vector
// handles — true for reference structs too; only field/element *reads* alias). So a value-struct
// local initialised from another local already gets full copy semantics with NO extra machinery.
// This pins that: mutating one local never disturbs the source, and loops of copies stay leak-free.

value struct P { name: text, nums: vector<integer>, v: integer }

// self (a caller DbRef, zero-copy param) bound to a local must copy, not alias the caller.
fn tweak(self: P) -> integer {
  x = self;
  x.v = 999;
  x.name = "LOCAL";
  x.nums = [42];
  x.v
}

fn main() {
  // var-to-var, scalar + lifetime fields: b is an independent copy of a
  a = P { name: "orig", nums: [1, 2, 3], v: 7 };
  b = a;
  b.name = "MUT";
  b.nums = [9];
  b.v = 100;
  assert("{a.name}" == "orig", "var-to-var: source text untouched");
  assert(len(a.nums) == 3, "var-to-var: source vector length untouched");
  assert(a.nums[2] == 3, "var-to-var: source vector values intact");
  assert(a.v == 7, "var-to-var: source scalar untouched");

  // reassignment (target already bound) also copies, and frees the old record (no leak)
  c = P { name: "cc", nums: [5], v: 1 };
  c = a; // c's first record is dropped; c becomes a fresh copy of a
  c.name = "REASSIGN";
  assert("{a.name}" == "orig", "reassignment: source text untouched");
  assert("{c.name}" == "REASSIGN", "reassignment: target holds its own copy");

  // param self bound to a method-local copy must not disturb the caller
  r = tweak(a);
  assert(r == 999, "self-to-local: method mutated its own copy");
  assert(
    a.v == 7 && "{a.name}" == "orig" && len(a.nums) == 3,
    "self-to-local: caller's value struct fully intact"
  );

  // loop of var-to-var copies over lifetime fields — every copy must free (leak gate)
  src = P { name: "src", nums: [1, 2, 3, 4], v: 0 };
  total = 0;
  for i in 0..50 {
    d = src; // fresh deep copy each iteration
    d.nums = [i]; // mutate the copy only
    total = total + len(src.nums); // source stays length 4 throughout
  }
  assert(total == 200, "loop var-to-var copies: source length stable, leak-free");

  println("local-to-local value struct ok");
}
