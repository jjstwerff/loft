//
// A format hole holding a string with an ESCAPED QUOTE is ONE literal, wherever the line
// sits (loft#1271).
//
// `"got: {shout("a\"b")}"` compiled inside `fn main` and was refused in every other
// function, with `fatal: String not correctly terminated` pointing at the closing quote of a
// string the compiler accepts one function up.
//
// ⚠ The lexer was never the defect, though the message came from it. `split_top_level`'s
// item scanner read the string FLAT — stopping at the first unescaped `"`, which is the one
// before `a` — so the item ended inside the literal. The `fn main` that FOLLOWED then no
// longer STARTED an item, `is_script` stopped seeing it, and an ordinary program was
// desugared as a beginner script; the lexer was reporting the mangled source.
//
// That is why ORDER decided it, which is the fact that makes the diagnosis checkable: with
// `fn main` FIRST the misplaced boundary lands after it, `is_fn_main` still matches, and the
// same bytes compile. Both orders are below.
//
// The scanner now keeps the rule the lexer's `hole_closes_on_this_line` already kept: inside
// a string `{` opens a hole (`{{`/`}}` are literal braces), inside a hole `"` opens a nested
// string, and the literal ends only at a `"` at hole depth 0.
//
// ⚠ @falsified-at: `make falsify` reports this file INERT, and that is CORRECT rather than a
//   hole -- `loft --tests` never consults the script classifier, so under the harness the
//   defect cannot fire and both trees answer the same. Measured: on the released 2026.8.0 this
//   very file passes `--tests` and FAILS as a plain `loft --interpret` run, at line 75.
//
//   Its falsifying power is that it SITS HERE. `script::tests::no_corpus_file_classifies_as_script`
//   sweeps `tests/` and asserts every file the compiler accepts is not a script; with the flat
//   scanner restored it names this file, measured. The rows below are the value half — that the
//   four positions all read the same string once the file compiles at all.
//
//   The other two halves are pinned where they can fail on their own:
//   `script::tests::an_escaped_quote_inside_a_hole_does_not_end_the_item` (the item COUNT, for
//   both orders) and `script_mode::an_escaped_quote_in_a_hole_does_not_make_a_program_a_script`
//   (the end-to-end plain run, both backends).
//
// ⚠ ORDER IS LOAD-BEARING IN THIS FILE. The four escaped-quote helpers sit IMMEDIATELY before
//   `fn main` on purpose: put another def between them and the mis-split resynchronises before
//   reaching `main`, so the corpus sweep stops seeing it. An earlier draft had them at the top
//   and was vacuous — it passed on the released binary. Do not tidy them into declaration order.

fn shout(v: text) -> text { "{v}!" }

// The four positions from the report, all of which refused before, and all of which sit
// BEFORE `fn main` in this file — the order that failed.

// The controls: the same shapes with nothing to mis-pair.
fn without_an_escape() -> text { "got: {shout("ab")}" }
fn with_literal_braces() -> text { "{{brace}} {shout("x")}" }

fn test_1271_every_position_reads_the_same_string() {
  assert(as_expression_body() == "got: a\"b!", "expression body: {as_expression_body()}");
  assert(through_a_local() == "got: a\"b!", "via a local: {through_a_local()}");
  assert(through_a_return() == "got: a\"b!", "via return: {through_a_return()}");
  assert(in_a_statement() == "got: a\"b!", "via +=: {in_a_statement()}");
}

// Without the escape the two halves pair up by accident, so this shape worked throughout.
// It is here because "the escaped form works now" is also satisfied by a scanner that broke
// the unescaped one.
fn test_1271_the_unescaped_shape_is_unchanged() {
  assert(without_an_escape() == "got: ab!", "no escape: {without_an_escape()}");
}

// `{{`/`}}` are literal braces and open no hole — a rule the flat scan never had to get
// right, because it never looked at a brace at all.
//
// A `}` inside a NESTED string (`"{f("}")}"`) is deliberately absent: the ITEM SCANNER
// handles it, and `script::tests::scan_string_end_spans_holes_and_their_nested_strings`
// asserts that, but the LEXER refuses the shape with `format-unescaped-brace` on this build
// and on the released one alike. That is a separate limit, not this fix's business.
fn test_1271_literal_braces_open_no_hole() {
  // The EXPECTED value needs its own `{{`: this assertion is a format string too.
  assert(with_literal_braces() == "{{brace}} x!", "literal braces: {with_literal_braces()}");
}

// The escape still means a quote, and the string still ends where it should — the plain
// reading the hole logic must not have disturbed.
fn test_1271_a_plain_escape_outside_any_hole() {
  s = "esc \" inside";
  assert(len(s) == 12, "an escaped quote is one character: {len(s)}");
  assert(s == "esc \" inside", "and reads back: {s}");
}

fn as_expression_body() -> text { "got: {shout("a\"b")}" }
fn through_a_local() -> text { r = "got: {shout("a\"b")}"; r }
fn through_a_return() -> text { return "got: {shout("a\"b")}"; }
fn in_a_statement() -> text { out = ""; out += "got: {shout("a\"b")}"; out }

fn main() {
  test_1271_every_position_reads_the_same_string();
  test_1271_the_unescaped_shape_is_unchanged();
  test_1271_literal_braces_open_no_hole();
  test_1271_a_plain_escape_outside_any_hole();
  print("ok\n");
}
