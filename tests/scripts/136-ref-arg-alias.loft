//
// Regression for @P312 — a native-codegen borrow-check failure.  When a call
// passes a struct as a `&`-ref argument AND another argument READS the same
// struct, native used to emit `f(&mut var_c, g(var_c…))`, and the Copy-read of
// `var_c` while it was mutably borrowed tripped `rustc error[E0503]: cannot use
// var_c because it was mutably borrowed`.  The fix (`src/generation/pre_eval.rs`)
// hoists the aliasing read into a `let _pre_N = …;` temporary emitted BEFORE the
// borrow, so the read completes first.  Interp was always fine; this script runs
// on BOTH backends (not in SCRIPTS_NATIVE_SKIP), so the native compile is the
// E0503 guard.

struct Sub {
  halo: integer,
}
struct Bag {
  items: vector<integer>,
  sub: Sub,
  tag: integer,
}

fn bag_push(b: &Bag, v: integer) {
  b.items += [v];
} // mutates → stays `&`
fn read_tag(b: Bag) -> integer {
  b.tag
}
fn read_halo(s: Sub) -> integer {
  s.halo
}

// FRESH-BORROW shape: a LOCAL passed to a `&` param AND read in another arg.
// Native emits `bag_push(&mut var_bag, read_tag(var_bag))` — the E0503 trigger.
fn test_p312_fresh_borrow() {
  bag = Bag {
    items: [],
    sub: Sub { halo: 4 },
    tag: 7,
  };
  bag_push(bag, read_tag(bag));
  assert(len(bag.items) == 1, "fresh len={len(bag.items)} (expect 1)");
  assert((bag.items[0] ?? 0) == 7, "fresh v={bag.items[0] ?? 0} (expect 7)");
}

// FRESH-BORROW + nested FIELD read (the gridmesh-C3 `all_inputs(c.field, …)` shape).
fn test_p312_fresh_borrow_field() {
  bag = Bag {
    items: [],
    sub: Sub { halo: 9 },
    tag: 1,
  };
  bag_push(bag, read_halo(bag.sub));
  assert((bag.items[0] ?? 0) == 9, "field v={bag.items[0] ?? 0} (expect 9)");
}

// FORWARDING shape: the caller's own `&`-ref param passed onward + a field read.
fn p312_forward(c: &Bag) {
  bag_push(c, read_halo(c.sub));
}
fn test_p312_forwarding() {
  bag = Bag {
    items: [],
    sub: Sub { halo: 5 },
    tag: 2,
  };
  p312_forward(bag);
  assert((bag.items[0] ?? 0) == 5, "fwd v={bag.items[0] ?? 0} (expect 5)");
}
