// @PLN25 item 2 (FIXED 2026-07-10): a vector<narrow?> element carries the same
// reserved null sentinel a nullable FIELD does, so it can hold null across every
// narrow width, on both backends.  See
// plans/25-nullable-sequences/narrow-nullable-representation.md.
fn main() {
  // width 1 — u8? / i8? (ByteNullable, 255 sentinel)
  u: vector<u8?> = [];  u += [null]; u += [42]; u += [254];
  assert(u[0] == null, "u8?[0] should be null, got {u[0]}");
  assert(u[1] == 42, "u8?[1] should be 42, got {u[1]}");
  assert(u[2] == 254, "u8?[2] should be 254, got {u[2]}");
  assert(u[9] == null, "u8? OOB should be null, got {u[9]}");
  i: vector<i8?> = [];  i += [null]; i += [-5]; i += [127];
  assert(i[0] == null, "i8?[0] should be null, got {i[0]}");
  assert(i[1] == -5, "i8?[1] should be -5, got {i[1]}");
  assert(i[2] == 127, "i8?[2] should be 127, got {i[2]}");
  assert(i[9] == null, "i8? OOB should be null, got {i[9]}");
  // width 2 — u16? / i16? (Short, +1 sentinel)
  w: vector<u16?> = []; w += [null]; w += [300]; w += [65534];
  assert(w[0] == null, "u16?[0] should be null, got {w[0]}");
  assert(w[1] == 300, "u16?[1] should be 300, got {w[1]}");
  assert(w[2] == 65534, "u16?[2] should be 65534, got {w[2]}");
  s: vector<i16?> = []; s += [null]; s += [-9]; s += [32000];
  assert(s[0] == null, "i16?[0] should be null, got {s[0]}");
  assert(s[2] == 32000, "i16?[2] should be 32000, got {s[2]}");
  // width 4 — i32? (Int4, i32::MIN sentinel)
  a: vector<i32?> = []; a += [null]; a += [70000];
  assert(a[0] == null, "i32?[0] should be null, got {a[0]}");
  assert(a[1] == 70000, "i32?[1] should be 70000, got {a[1]}");
  // overflowing checked cast collapses to null
  x: integer = 999;
  u += [x as u8?];
  assert(u[3] == null, "999 as u8? should be null, got {u[3]}");
  // no-regression: non-null vector<u8> keeps its full range (255 is a value)
  v: vector<u8> = []; v += [255]; v += [0];
  assert(v[0] == 255, "vector<u8>[0] should stay 255, got {v[0]}");
  assert(v[1] == 0, "vector<u8>[1] should be 0, got {v[1]}");
}
