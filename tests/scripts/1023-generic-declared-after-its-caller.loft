//
// A generic whose body compares a nullable `T?` parameter to `null` did not compile on
// `--native` when it was declared BELOW its caller — and compiled when declared above.
//
// The second pass re-parses the file in SOURCE ORDER, so a call instantiates a generic
// declared below it before that template's own pass-2 body has been produced.  The
// monomorph then keeps whatever pass 1 left behind, and anything a construct emits only on
// the second pass is simply absent from it.  For loft#1020's deferred null test that was
// the test itself: the body handed back the raw operand where a boolean belonged, so
// `--native` refused the program (`if` and `else` have incompatible types) and the
// interpreter read the slot as whatever it held.
//
// Declaration order is not supposed to matter — the two-pass parser exists precisely so a
// function may be used before it is written — so the site is marked on BOTH passes.  It
// only WRAPS the operand, which is why it can be: the branches beside it emit ops, and
// that is what needs a resolved second pass.
//
// Every generic below is declared AFTER every function that calls it.  That is the whole
// point of the file, so keep it that way.

fn test_a_generic_declared_after_its_caller_compiles() {
  assert(isn1023([1]), "an omitted integer argument is null");
  assert(!isn1023([1], 5), "a supplied integer argument is not null");
}

fn test_it_holds_for_a_heap_instantiation_too() {
  // `text` is the instantiation loft#1020 answered INVERTED rather than crashing, so it
  // is the one that would go quiet rather than red if the marker went missing again.
  assert(isn1023(["x"]), "an omitted text argument is null");
  assert(!isn1023(["x"], "y"), "a supplied text argument is not null");
}

fn test_it_holds_for_a_struct_instantiation() {
  assert(isn1023([S1023 { a: 1 }]), "an omitted struct argument is null");
  assert(!isn1023([S1023 { a: 1 }], S1023 { a: 2 }), "a supplied struct argument is not null");
}

fn test_the_nullable_without_a_default_is_the_same_shape() {
  // The DEFAULT is not the axis — a `T?` with no default reached the same broken body.
  assert(isnd1023([1], null), "an explicit null argument is null");
  assert(!isnd1023([1], 5), "a supplied argument is not null");
}

fn test_two_separate_callers_above_the_declaration() {
  // Each caller instantiates for its own type, and both are parsed before the template.
  assert(caller_a1023() && caller_b1023(), "both callers get a working monomorph");
}

fn caller_a1023() -> boolean { isn1023([1]) }
fn caller_b1023() -> boolean { isn1023(["x"]) }

fn test_the_generic_discharge_still_works_from_above() {
  // loft#1016's deferred DEFAULT is marked on the second pass only and reaches the same
  // monomorph, so it is worth pinning that it survives this order as well.
  assert(dis1023([1]) == 0, "an omitted argument discharges to the type's zero");
  assert(dis1023([1], 7) == 7, "a supplied argument is delivered");
}

struct S1023 { a: integer }

pub fn isn1023 < T > (v: vector<T>, a: T? = null) -> boolean { len(v) >= 0 && a == null }
pub fn isnd1023 < T > (v: vector<T>, a: T?) -> boolean { len(v) >= 0 && a == null }
pub fn dis1023 < T: Addable > (v: vector<T>, a: T? = null) -> T {
  if len(v) < 0 { a? } else { a? }
}
