//
// Regression (@P393, Phase C): const/global stores are PINNED — `free_named`
// must NEVER free them.  Phase C removed the Stores ref-count, so `free_named`
// now frees unconditionally; a const store is protected only by its `pinned`
// flag (was `ref_count = u32::MAX/2`).  If the flag regresses, the const slot is
// freed mid-run, a transient vector reuses it, and the re-read returns garbage
// (interpreter: UAF/segfault; native: clobbered value).  This shape — read a
// const in a callee, churn transient vectors that reuse the freed slot, re-read
// the const — is the deterministic detector; with the pin it returns 60/60.

const NUMS: vector<integer> = [10, 20, 30];

fn read_once() -> integer {
  s = 0;
  for n in NUMS { s += n; }
  s
}

fn churn() -> integer {
  s = 0;
  for i in[100, 200, 300] {
    v = [i, i + 1, i + 2]; // transient vectors: alloc/free → may reuse NUMS' slot
    s += v[1];
  }
  s
}

fn main() {
  a = read_once(); // read NUMS in a callee scope
  b = churn(); // churn transient vectors
  c = read_once(); // re-read NUMS after potential slot reuse
  assert(a == 60, "a={a}");
  assert(c == 60, "c={c} (const freed + slot reused → pin regression)");
  assert(b == 603, "b={b}");
  println("const-pin-no-free ok");
}
