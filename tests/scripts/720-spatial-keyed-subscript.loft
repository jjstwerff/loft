// loft#720 — the point subscript `sp[x, y]` on a `spatial<T[x,y]>`, in all three
// of its roles: read, remove (`= null`) and insert-or-replace (`= value`).
//
// All three were broken, and each failed differently, which is why the issue was
// filed as "removal panics" only:
//
//   read     `Stores::get_keys` had no `Radix` arm and answered with an EMPTY key
//            list, so `read_key` popped NOTHING off the stack and the next
//            `get_stack::<DbRef>()` read a leftover key VALUE as the collection.
//            `sp[3, 3]` looked itself up in store #3.  Interpreter only — the
//            native backend builds its `&[Content]` inline and never calls
//            `read_key`, so the working member hid the omission.
//   remove   `Radix` was missing from the keyed-remove lowering, so `sp[k] = null`
//            fell through to a plain `OpCopyRecord(cell, (), …)` — the interpreter
//            corrupted the store, `--native` failed to compile the void argument.
//   insert   `Radix` was missing from the `OpSetKeyed` route, so assigning at an
//            ABSENT key copied into a null lookup and clobbered the collection
//            root: a 4-element collection read back as 1.  Silent heap corruption.
//
// The axes are deliberately asymmetric (`y = 2 * x`) so a fix that reads one
// coordinate for the other cannot pass, and the ids are distinct from both
// coordinates so a sum pins WHICH records survive, not just how many.

struct KsPt {
  const id: integer,
  const x: integer,
  const y: integer,
  name: text,
}

fn ks_count(sp: spatial<KsPt[x, y]>) -> integer {
  n = 0;
  for p in sp { n += p.id * 0 + 1 }
  n
}

fn ks_sum(sp: spatial<KsPt[x, y]>) -> integer {
  s = 0;
  for p in sp { s += p.id }
  s
}

fn main() {
  sp: spatial<KsPt[x, y]> = [];
  for i in 0..6 { sp += [KsPt { id: 10 + i, x: i, y: i * 2, name: "seed-{i}-payload" }] }
  assert(ks_count(sp) == 6, "six seeded points");
  assert(ks_sum(sp) == 75, "ids 10..15 sum to 75");

  // --- read ---------------------------------------------------------------
  // A hit reads the record at that exact point; the interpreter used to panic
  // here with "index out of bounds: the len is N but the index is 3".
  hit = sp[3, 6];
  assert(hit != null, "an existing point is found by its key");
  assert(hit.id == 13, "the found record is the RIGHT one");
  assert(hit.name == "seed-3-payload", "its owned text comes back intact");

  // A miss answers null rather than a neighbour: (3, 3) is not a point, even
  // though 3 is a valid x AND a valid y.
  assert(sp[3, 3] == null, "a coordinate pair that was never inserted is null");
  assert(sp[99, 99] == null, "an out-of-range point is null");
  assert(ks_count(sp) == 6, "lookups do not disturb the collection");

  // --- insert at an absent key --------------------------------------------
  sp[9, 18] = KsPt { id: 88, x: 9, y: 18, name: "inserted" };
  assert(ks_count(sp) == 7, "assigning at an absent key INSERTS");
  assert(ks_sum(sp) == 163, "and leaves every earlier record in place");
  assert(sp[9, 18].id == 88, "the inserted record is found by its key");
  assert(sp[3, 6].id == 13, "an unrelated point is untouched by the insert");

  // --- replace at a present key -------------------------------------------
  sp[1, 2] = KsPt { id: 77, x: 1, y: 2, name: "replaced-with-a-longer-payload" };
  assert(ks_count(sp) == 7, "assigning at a present key REPLACES, it does not add");
  assert(ks_sum(sp) == 229, "11 gave way to 77");
  assert(sp[1, 2].name == "replaced-with-a-longer-payload", "the new owned text is readable");

  // --- remove -------------------------------------------------------------
  sp[9, 18] = null;
  assert(ks_count(sp) == 6, "assigning null removes exactly one record");
  assert(ks_sum(sp) == 141, "and it is the record whose key was named");
  assert(sp[9, 18] == null, "the removed point no longer resolves");
  assert(sp[1, 2].id == 77, "its neighbours survive the removal");

  // Removing an absent key is a no-op, not a corruption.
  sp[9, 18] = null;
  sp[40, 41] = null;
  assert(ks_count(sp) == 6, "removing an absent key changes nothing");
  assert(ks_sum(sp) == 141, "and takes no other record with it");

  // --- the replace loop ----------------------------------------------------
  // A replace unlinks the old element, whose record is a store block of its own
  // (as a hash element is).  Without reclaiming it, a long replace loop grows the
  // store without bound; the collection must also still hold exactly one record
  // for that key at the end.
  for r in 0..200 { sp[4, 8] = KsPt { id: r, x: 4, y: 8, name: "replace-{r}" } }
  assert(ks_count(sp) == 6, "200 replaces at one key leave one record there");
  assert(sp[4, 8].id == 199, "the last write wins");
  assert(sp[4, 8].name == "replace-199", "including its owned text");
  assert(sp[0, 0].id == 10, "and the rest of the collection is unchanged");
}
