//
// @PLN130 — a `vector` stays DENSE: `remove` compacts, and there are never holes.
//
// This is a DESIGN DECISION, not an accident, and it was previously unguarded. @PLN130 F3
// considered stable slots (leave a hole so an element never moves, which would let a view
// survive a removal) and rejected them: a hole makes `v[i]` answer null after an unrelated
// removal, and no other index type in loft behaves that way. Staying agnostic across index
// types is worth more than the copying the compaction costs.
//
// The consequence is deliberate and belongs with the decision: because elements MOVE, a view
// taken before a removal cannot follow its element. loft materialises such a view and says so
// (see `tests/scripts/145`), rather than letting it read a neighbour.
//
// Pinning it here so a future "optimisation" that stops compacting has to argue with a test.

struct E { v: integer }

fn dump(xs: vector<E>) -> text {
  s = "";
  for x in xs {
    s += "{x.v},";
  }
  return s;
}

fn main() {
  // Removing the FIRST element shifts every later one down.
  a = [E { v: 1 }, E { v: 2 }, E { v: 3 }, E { v: 4 }];
  a.remove(0);
  assert(len(a) == 3, "200 first len {len(a)} want 3");
  assert(dump(a) == "2,3,4,", "200 first iter {dump(a)} want 2,3,4,");
  assert(a[0].v == 2 && a[1].v == 3 && a[2].v == 4, "200 first idx {a[0].v}/{a[1].v}/{a[2].v}");

  // From the MIDDLE.
  b = [E { v: 1 }, E { v: 2 }, E { v: 3 }, E { v: 4 }];
  b.remove(1);
  assert(len(b) == 3, "200 middle len {len(b)} want 3");
  assert(dump(b) == "1,3,4,", "200 middle iter {dump(b)} want 1,3,4,");
  assert(b[0].v == 1 && b[1].v == 3 && b[2].v == 4, "200 middle idx");

  // From the END — nothing moves, but the length must drop.
  c = [E { v: 1 }, E { v: 2 }, E { v: 3 }, E { v: 4 }];
  c.remove(3);
  assert(len(c) == 3, "200 last len {len(c)} want 3");
  assert(dump(c) == "1,2,3,", "200 last iter {dump(c)} want 1,2,3,");

  // Several removals inside one iteration stay dense too.
  d = [E { v: 1 }, E { v: 2 }, E { v: 3 }, E { v: 4 }, E { v: 5 }];
  for x in d {
    if x.v == 2 {
      x#remove;
    }
    if x.v == 4 {
      x#remove;
    }
  }
  assert(len(d) == 3, "200 loop len {len(d)} want 3");
  assert(dump(d) == "1,3,5,", "200 loop iter {dump(d)} want 1,3,5,");
  assert(d[0].v == 1 && d[1].v == 3 && d[2].v == 5, "200 loop idx");

  // No in-bounds index is ever null after a removal — that is the whole point of compacting.
  // Past the end stays null, which is C80 and unchanged.
  e = [E { v: 1 }, E { v: 2 }, E { v: 3 }];
  e.remove(0);
  assert(e[0].v == 2 && e[1].v == 3, "200 no in-bounds null");
  assert(e[2] == null, "200 past-end must still be null");

  // Emptying it completely leaves a well-formed empty vector.
  f = [E { v: 1 }, E { v: 2 }];
  f.remove(0);
  f.remove(0);
  assert(len(f) == 0, "200 empty len {len(f)} want 0");
  assert(dump(f) == "", "200 empty iter '{dump(f)}' want ''");

  println("200 PASSED");
}
