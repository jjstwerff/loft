//
// @PLN105 — writable-source iteration GOLDEN (doc/claude/plans/expose-iteration-scratch.md,
// Step 0).  Captures the proven sibling: iterating a WRITABLE keyed collection yields its
// elements in key order.  This is the refactor oracle for Step 1 (collapsing the two
// `on=3` `step` mirrors into one `vector::step_ordered` helper) and the inert-machinery
// oracle for Step 3 (threading the source store_nr) — both must keep every value below
// byte-identical.  Step 4 adds the exposed-source cells and asserts they equal this
// golden.  All expectations are hand-computed; the runner's leak check is the leak oracle.
//
// on=3 path (the sorted rec-nr scratch Step 1 touches): hash, index, spatial.
// on=2 path (adjacent, unchanged): sorted — included so an accidental regression shows.

struct HRec { k: integer, v: integer }
struct IRec { n: integer }
struct SItem { k: integer }
struct SP { x: integer, y: integer }

fn main() {
  // --- hash<T[k]>: build out of key order, iterate ascending by key (on=3) ---
  h: hash<HRec[k]> = [];
  h += [HRec{ k: 3, v: 30 }];
  h += [HRec{ k: 1, v: 10 }];
  h += [HRec{ k: 2, v: 20 }];
  hk = "";  hv = 0;  hn = 0;
  for hr in h { hk = hk + "{hr.k}"; hv += hr.v; hn += 1; }
  assert(hk == "123", "hash iterates ascending by key (got {hk})");
  assert(hv == 60, "hash visits every value once (sum {hv}, expect 60)");
  assert(hn == 3, "hash visits each record once (n {hn})");

  // --- index<T[n]> (red-black tree): ascending by key (on=3) ---
  ix: index<IRec[n]> = [];
  ix += [IRec{ n: 5 }];
  ix += [IRec{ n: 2 }];
  ix += [IRec{ n: 8 }];
  ixk = "";  ixs = 0;
  for ir in ix { ixk = ixk + "{ir.n} "; ixs += ir.n; }
  assert(ixk == "2 5 8 ", "index iterates ascending (got {ixk})");
  assert(ixs == 15, "index sum {ixs} (expect 15)");

  // --- spatial<T[x, y]> (Morton/Z-order natural walk, on=3): order not key-ascending,
  //     so assert count + an order-independent coordinate sum (mirrors 48-spatial). ---
  sp: spatial<SP[x, y]> = [];
  sp += [SP{ x: 3, y: 3 }];
  sp += [SP{ x: 1, y: 2 }];
  sp += [SP{ x: 0, y: 0 }];
  spt = 0;  spn = 0;
  for m in sp { spt += m.x * 100 + m.y; spn += 1; }
  assert(spn == 3, "spatial visits every record once (n {spn})");
  assert(spt == 405, "spatial coordinate sum {spt} (303+102+0 = 405)");

  // --- sorted<T[k]> (on=2, adjacent path — guards against collateral breakage) ---
  s: sorted<SItem[k]> = [];
  s += [SItem{ k: 4 }];
  s += [SItem{ k: 1 }];
  s += [SItem{ k: 3 }];
  s += [SItem{ k: 2 }];
  sk = "";
  for it in s { sk = sk + "{it.k} "; }
  assert(sk == "1 2 3 4 ", "sorted iterates ascending (got {sk})");

  print("pln105-iterate-keyed ok\n");
}
