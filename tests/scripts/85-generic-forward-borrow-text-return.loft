// @PLN85 corpus text-leak class 3 — a generic fn returning a call whose result
// FORWARD-BORROWS an argument (`label<T>(x) -> text { x.to_label() }`, where
// `to_label(self) -> text { self.field }` borrows self).  A non-generic forwards
// the borrow as a `text["x"]` view (the caller frees the arg it borrows — leak
// free), but the monomorph is built by IR substitution and keeps the BARE
// declared `text` return: the arg-dep is never derived, so the borrowed view is
// copied into an owned String and orphaned on the interpreter (native
// RAII-drops it).  `promote_monomorph_text_return` (control.rs) now delivers a
// ForwardArg call tail — AND non-tail early returns (the guard-`if` shape) —
// through the hidden `&text` buffer, exactly as the manual rebind already did.
// Graduated from probes/corpus-optional-text/ (p205_* / gen_guard* / gen_field).

interface Lab {
  fn to_label(self: Self) -> text
}
interface Val {
  fn ok(self: Self) -> boolean
}

struct Item {
  nm: text,
  sc: integer,
}
fn to_label(self: Item) -> text {
  return self.nm;
}
fn ok(self: Item) -> boolean {
  return self.sc > 0;
}

// TAIL forward-borrow call (the p205 shape).
fn label < T: Lab > (x: T) -> text {
  return x.to_label();
}

// NON-TAIL forward-borrow return inside a guard-`if`, plus a literal tail (the
// 86-interfaces `if_describe` shape).
fn describe < T: Lab + Val > (x: T) -> text {
  if x.ok() { return x.to_label(); }
  return "invalid";
}

// A rebind (proven-clean baseline: the manual `y = call(); y`).
fn label_rebind < T: Lab > (x: T) -> text {
  y = x.to_label();
  return y;
}

fn main() {
  a = Item { nm: "widget", sc: 10 };
  b = Item { nm: "broken", sc: 0 };
  assert(label(a) == "widget", "generic tail forward-borrow: {label(a)}");
  assert(describe(a) == "widget", "generic guard-if forward-borrow: {describe(a)}");
  assert(describe(b) == "invalid", "generic guard-if literal tail: {describe(b)}");
  assert(label_rebind(a) == "widget", "rebind baseline: {label_rebind(a)}");
  println("generic-forward-borrow-text-return ok");
}
