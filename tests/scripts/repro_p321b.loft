// @P321b regression — appending `null` to a `vector<text>` failed to compile
// under `--native` (E0599: `()` doesn't implement `Display`).  The `OpSetText`
// template lowered the null value to `(()).to_string()`; now a null text value
// stores the null pointer (offset 0), matching the interpreter (reads back as
// null).  Surfaced in lib/arguments `flag()` (`self.results += null`).
struct P321bHolder {
  items: vector<text>,
}

fn test_p321b_null_into_text_vector() {
  h = P321bHolder { items: [] };
  h.items += [null]; // the shape that used to break native compile
  h.items += ["x"];
  assert(len(h.items) == 2, "p321b: len={len(h.items)} (want 2)");
  assert(h.items[1] == "x", "p321b: items[1]={h.items[1]} (want x)");
  v0 = h.items[0];
  assert(!v0, "p321b: items[0] should read back as null");
}
