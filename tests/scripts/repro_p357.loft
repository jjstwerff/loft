// @P357 regression: json_parse("[]") (and "{}") must materialise an EMPTY
// collection — len 0, item(0)/field() is JNull — even after earlier parses
// have populated and freed store records.  The empty-array/object arm in
// `json_parse_into_stores` (src/native.rs) set only the JsonValue discriminant
// and left the items/fields VECTOR HANDLE stale (jv_alloc reuses recycled store
// records), so a `[]` parsed after churn read a phantom non-empty vector — the
// training port's store engine reported n_ghosts=8 for an empty
// ghost_sessions.json (`[]`).  Fix: the empty arms now zero the handle too.
fn parse_empty_after_churn() -> integer {
  // Churn the store: parse several non-empty arrays so records get allocated
  // and freed, then (in main) parse an empty array and count its elements.
  i = 0;
  total = 0;
  while i < 20 {
    big = "[";
    j = 0;
    while j <= i {
      if j > 0 { big += ","; } big += "{{\"k\":\"v{j}\"}}"; j += 1;
    }
    big += "]";
    arr = json_parse(big);
    e0 = arr.item(0);
    got = ! (e0 is JNull);
    if got { total += 1; }
    i += 1;
  }
  total
}

fn count_empty(arr: JsonValue) -> integer {
  n = 0;
  while true {
    e = arr.item(n);
    if e is JNull { break }
    n += 1;
  }
  n
}

fn main() {
  warm = parse_empty_after_churn();
  assert(warm == 20, "warmup churn: {warm}");

  // The core assertion: an empty array reads as empty, repeatedly, after churn.
  k = 0;
  while k < 10 {
    ea = json_parse("[]");
    e0 = ea.item(0);
    is_null = e0 is JNull;
    assert(is_null, "empty array item(0) must be JNull (iter {k})");
    cnt = count_empty(ea);
    assert(cnt == 0, "empty array must have 0 elements (iter {k}): {cnt}");
    k += 1;
  }

  // Empty object: field() lookups miss (JNull).
  eo = json_parse("{{}}");
  miss = eo.field("anything");
  miss_null = miss is JNull;
  assert(miss_null, "empty object field() must be JNull");

  println("p357 ok");
}
