// @PLN10 — JsonValue.as_text() carries null through the owned-String return.
//
// The native backend's `t_9JsonValue_as_text` returns an owned `String` (no
// scratch) — null for a non-string value is `STRING_NULL.to_string()` ("\0"),
// the same sentinel native text-null uses, so `?? x` and `!x` still see null.
// Locks the null-carrying contract on every backend (interpreter / native / wasm).
fn main() {
  jn = json_parse("42");
  assert((jn.as_text() ?? "NULLED") == "NULLED", "as_text on number coalesces (null)");

  jb = json_parse("true");
  assert((jb.as_text() ?? "NULLED") == "NULLED", "as_text on bool coalesces (null)");

  js = json_parse("\"hi\"");
  assert((js.as_text() ?? "NULLED") == "hi", "as_text on a string returns it");

  // direct null check — `!x` is true for null text
  x = jn.as_text();
  assert(!x, "as_text on non-string is null under `!`");

  println("as_text null-carrying: ok");
}
