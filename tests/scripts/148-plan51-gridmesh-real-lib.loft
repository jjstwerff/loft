// Probe 38 — gridmesh's crystal_segments_aged_tuned chain.
//
// Real-library pattern extracted from
// `lib/audience_crystal/src/audience_crystal.loft:749` and
// `lib/gridmesh/src/gridmesh.loft:102-133`.  Self-contained — no lib
// dependencies.
//
// Shape:
//   fn build_chunk(...) -> SegMesh {
//     m = seg_mesh_new();
//     for i in 0..N { seg_emit(m, ...); }
//     m
//   }
//   fn aged_tuned(...) -> SegMesh {
//     out = seg_mesh_new();
//     inputs = all_inputs(...);
//     for ci in inputs {
//       cm = build_chunk(ci);        // intermediate-local heap return
//       seg_mesh_append(out, cm);    // mutate-via-&-ref
//     }
//     out
//   }
//
// Distinguishing features from probes 09/10/17:
// - TWO levels of `local = call(); ...; local` chain (aged_tuned → build_chunk)
// - The outer fn uses BOTH an intermediate local (`cm`) AND a hidden buffer (`out`)
// - seg_mesh_append takes `&SegMesh` (mutable ref) — the explicit-mutation idiom
// - Per-iter cm is re-assigned; the previous iter's cm is freed via mutable ops
//
// dryopea editor consumes this pattern; @P377-original was originally
// observed in this context.
//
// Expected: PASSES on both backends (the lib tests pass today).  This probe
// is for shape-coverage in the catalogue — confirms gridmesh-style patterns
// don't expose a new sub-cluster.

struct SegMesh {
  kinds:  vector<integer>,
  values: vector<integer>,
  ids:    vector<integer>,
}

fn seg_mesh_new() -> SegMesh {
  SegMesh { kinds: [], values: [], ids: [] }
}

fn seg_emit(m: SegMesh, kind: integer, value: integer, id: integer) {
  m.kinds  += [kind];
  m.values += [value];
  m.ids    += [id];
}

fn seg_mesh_append(dst: SegMesh, src: SegMesh) {
  dst.kinds  += src.kinds;
  dst.values += src.values;
  dst.ids    += src.ids;
}

// Inner: build one chunk's segments.  `seg_mesh_new` + for-loop emit pattern.
fn build_chunk(chunk_id: integer, count: integer) -> SegMesh {
  m = seg_mesh_new();
  for k in 0..count {
    seg_emit(m, chunk_id * 10 + k, chunk_id * 100 + k, chunk_id);
  }
  m
}

// Outer: walk inputs, build each chunk, append into shared mesh.
// Mirrors crystal_segments_aged_tuned exactly.
fn aged_tuned(input_count: integer, segs_per_chunk: integer) -> SegMesh {
  out = seg_mesh_new();
  for ci in 0..input_count {
    cm = build_chunk(ci, segs_per_chunk);
    seg_mesh_append(out, cm);
  }
  out
}

fn main() {
  for i in 0..6 {
    mesh = aged_tuned(3, 4);
    assert(len(mesh.kinds) == 12, "iter {i}: total kinds = {len(mesh.kinds)} (expect 12)");
    // First chunk's first emit: kind=0*10+0=0, value=0*100+0=0, id=0
    assert(mesh.kinds[0] == 0, "iter {i}: kinds[0] = {mesh.kinds[0]}");
    // Second chunk's first emit: kind=1*10+0=10
    assert(mesh.kinds[4] == 10, "iter {i}: kinds[4] = {mesh.kinds[4]}");
    // Third chunk's last emit: kind=2*10+3=23
    assert(mesh.kinds[11] == 23, "iter {i}: kinds[11] = {mesh.kinds[11]}");
  }
  println("probe 38 PASSED");
}
