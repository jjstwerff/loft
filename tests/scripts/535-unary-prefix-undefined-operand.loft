//
// @PLN53 F1-1 — an undefined operand of a unary PREFIX operator (`-`, `!`, `~`)
// used to reach codegen as a slot-less placeholder Var and panic in
// `codegen.rs` ("Incorrect var x[65535]"), where the binary operators already
// reject it with a clean diagnostic. The unary branches now run the same
// `known_var_or_type` check. Kept in its own file so no earlier error aborts
// the second pass before these are reached (the check fires only in pass 2).

// @EXPECT_ERROR: Unknown variable
fn pe_unary_minus_undefined() {
  y: integer = -upo_undef_neg;
  assert(y == 0, "unreached");
}

// @EXPECT_ERROR: Unknown variable
fn pe_unary_not_undefined() {
  y: boolean = !upo_undef_not;
  assert(y, "unreached");
}

// @EXPECT_ERROR: Unknown variable
fn pe_unary_bitnot_undefined() {
  y: integer = ~upo_undef_bnot;
  assert(y == 0, "unreached");
}
