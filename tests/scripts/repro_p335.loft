//
// @P335 regression: a variable spelled `n_<X>` must NOT collide with a
// function named `<X>` (stored mangled as `n_<X>`).  Before the fix the
// parser resolved the raw identifier `n_day` against the def table, hit
// function `day`, and mis-parsed the declaration ("Expect token ;" for the
// typed form, "Cannot redefine function ..." for the assignment form).
// Functions are now reached ONLY via the `n_`+ident mangle.
fn day() -> integer {
  7
}
fn year() -> integer {
  2026
}

fn test_typed_decl_does_not_collide() {
  n_day: vector<text> = [];
  n_day += ["a"];
  n_day += ["b"];
  assert(len(n_day) == 2, "typed n_day decl: {len(n_day)}");
}

fn test_assignment_does_not_collide() {
  n_year = 0;
  n_year += 5;
  assert(n_year == 5, "n_year assignment: {n_year}");
}

fn test_function_still_callable() {
  // the colliding functions must still work normally
  assert(day() == 7, "day()");
  assert(year() == 2026, "year()");
}
