// P203 minimal reproducer — native: file handle inside `{...}` block not
// flushed/closed on block exit, subsequent delete() fails.
// Interpreter: PASS.  Native: FAIL.
// See doc/claude/PROBLEMS.md § 203.
// @EXPECT_FAIL p203_native_block_scope_file
fn p203_native_block_scope_file() {
  {f = file("repro_p203.txt");
   f += "x";
  }
  assert(delete("repro_p203.txt") == FileResult.Ok,
         "p203: delete after block-scope close");
}
