// loft#722 — `x = f().items[0] ?? Fallback {}` bound a dangling reference into
// the temporary `f()` returned. It read correctly once and returned zeroes after
// other allocations reused the store, which is the worst shape a memory bug can
// take: the first three reads in the reporting program were right and the fourth
// was wrong, so the code looked innocent.
//
// The `??` is what made the difference. It lowers to a value-producing block, and
// the temp holding `f()`'s result was registered at THAT block's scope and freed
// on the way out — while `x`, bound in the enclosing scope, still pointed into
// it. Without the `??` the same expression is lifted at statement level and was
// always correct; that is the behaviour restored here, by re-registering such a
// temp at the ENCLOSING scope and dropping the block-exit free.
//
// Two things constrain the fix, and both are asserted below:
//
//   - It must stay a BORROW, not become a copy. `mutates_through` writes through
//     an element binding and reads it back from the source; a fix that copied
//     would silently drop the write.
//   - Only the temps the result actually points into may be hoisted. Moving every
//     lift in a value block instead made frees go missing (27 leaked `File`
//     stores in the file suite), so `borrow_root` walks the getter chain and the
//     rest keep their block scope.
//
// The loop form is deliberately NOT here: `??` inside a loop has a separate,
// pre-existing fault visible only under `LOFT_POISON=1` (it predates this fix,
// measured on the released binary), and mixing it in would make this guard fail
// for a reason it is not about.

struct TeP {
  a: integer,
  b: integer,
  c: float,
}

struct TePs {
  items: vector<TeP>,
}

fn te_make() -> TePs {
  TePs { items: [TeP { a: 5, b: 4, c: 0.7 }] }
}

// Allocate and drop enough records that a freed store is reused — this is what
// turns a dangling reference from "still reads right" into zeroes.
fn te_churn(n: integer) -> integer {
  v: vector<TeP> = [];
  for i in 0..n { v += [TeP { a: i, b: 0 - i, c: 0.0 }] }
  len(v)
}

fn main() {
  // The reported shape: an element of a TEMPORARY's vector, through `??`.
  bad = te_make().items[0] ?? TeP { a: 0, b: 0, c: 0.0 };
  assert(bad.a == 5, "reads correctly straight away");
  churned = te_churn(64) + te_churn(64);
  assert(churned == 128, "the churn ran");
  assert(bad.a == 5, "and still reads correctly after the stores were reused");
  assert(bad.b == 4, "every field, not just the first");
  assert(bad.c > 0.69 && bad.c < 0.71, "including the float");

  // The same without `??` — always worked, and must keep working.
  plain = te_make().items[0];
  churn2 = te_churn(64);
  assert(churn2 == 64, "the second churn ran");
  assert(plain.a == 5, "a temp element bound without `??`");

  // Bound to a local first — the workaround the issue documents.
  held = te_make();
  good = held.items[0] ?? TeP { a: 0, b: 0, c: 0.0 };
  assert(good.a == 5, "binding the source first still works");

  // A borrow out of a LOCAL vector: unaffected, and must not start copying.
  v: vector<TeP> = [TeP { a: 9, b: 8, c: 1.0 }];
  e = v[0] ?? TeP { a: 0, b: 0, c: 0.0 };
  assert(e.a == 9, "an element of a local vector");

  // Still a borrow: the write must land in the source, not in a copy.
  e.b = 42;
  back = v[0] ?? TeP { a: 0, b: 0, c: 0.0 };
  assert(back.b == 42, "writing through the binding reaches the source vector");
}
