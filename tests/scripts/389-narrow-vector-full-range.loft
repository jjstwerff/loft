//
// H6 — narrow-VECTOR elements are FULL-RANGE (no null sentinel), consistent with
// the not-null narrow FIELD path.  `Parts::ShortRaw` is always non-nullable, but
// its read `get_i16_raw` used to decode `u16::MAX → null`, so a `vector<u16>`
// could not hold `65535` (nor `vector<i16>` `32767`) even though `vector<u8>`
// holds `255`.  Now `get_i16_raw` delegates to `get_short_full` (no sentinel), so
// all narrow-vector widths reach their full range.  Both backends.

struct U8B {
  v: vector<u8>,
} struct I8B {
  v: vector<i8>,
}
struct U16B {
  v: vector<u16>,
} struct I16B {
  v: vector<i16>,
}

fn main() {
  a = U8B { v: [] }; a.v += [0 as u8, 254 as u8, 255 as u8];
  assert(a.v[2] == 255, "vector<u8> holds 255");

  d = I8B { v: [] }; d.v += [-128 as i8, 0 as i8, 127 as i8];
  assert(d.v[0] == -128, "vector<i8> holds -128");
  assert(d.v[2] == 127, "vector<i8> holds 127");

  b = U16B { v: [] }; b.v += [0 as u16, 65534 as u16, 65535 as u16];
  assert(b.v[1] == 65534, "vector<u16> holds 65534");
  assert(b.v[2] == 65535, "vector<u16> holds 65535");

  c = I16B { v: [] }; c.v += [-32768 as i16, 32766 as i16, 32767 as i16];
  assert(c.v[0] == -32768, "vector<i16> holds -32768");
  assert(c.v[2] == 32767, "vector<i16> holds 32767");
}
