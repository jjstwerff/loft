// @PLN85 — the chained field-of-call class (the LAST poison cell): a chain of
// depth ≥ 2 rooted at a call result read freed memory at ANY consumption site
// (bind / argument / return / implicit tail / loop), on BOTH backends —
// silently stale without LOFT_POISON.  Two roots, two fixes:
// (1) the inline-ref capture (operators.rs) ALIASED a projection of the call
//     into an owning work-ref; argument lifting then split the call into a
//     __lift_N freed INSIDE the capture block, between the projections.  A
//     projection capture now COPIES (OpDatabase + OpCopyRecord — the C86
//     escape rule; the depth-1 materialized_view_return emission is the spec).
// (2) return_field_base_var (control.rs) walked only a single projection hop,
//     so `return t.inner.value` NRVO-renamed the buffer onto the CONTAINER
//     local and DISCARDED the tail — interp survived via the eval stack,
//     native returned the typed null (a silent divergence).  The walk now
//     recurses through chained projections and capture blocks (#489 pattern).
// Run under LOFT_POISON=1 to make regressions loud; values assert either way.

struct Holder { data: vector<integer>, tag: text }
struct Nested { inner: Mid, id: integer }
struct Mid { value: Holder, pad: integer }
fn mk_nested() -> Nested {
  return Nested { inner: Mid { value: Holder { data: [1,2,3,4,5,6,7,8], tag: "H" }, pad: 0 }, id: 5 };
}
fn mk_mid() -> Mid { return Mid { value: Holder { data: [1,2,3,4,5,6,7,8], tag: "H" }, pad: 0 }; }

// return tail, chain depth 2 (the original failing cell)
fn t1_ret() -> Holder { return mk_nested().inner.value; }
// implicit tail
fn t2_implicit() -> Holder { mk_nested().inner.value }
// named-local container, chained (the x3 native-null face)
fn t3_local() -> Holder { t = mk_nested(); return t.inner.value; }
// depth-1 controls (must stay on their existing paths)
fn t4_chain1() -> Mid { return mk_nested().inner; }
fn t5_single() -> Holder { return mk_mid().value; }
// argument position
fn t6_take(h: const Holder) -> integer { return len(h.data); }

fn main() {
  a = t1_ret();
  assert(len(a.data) == 8 && a.tag == "H", "t1: {len(a.data)}");
  b = t2_implicit();
  assert(len(b.data) == 8, "t2: {len(b.data)}");
  c = t3_local();
  assert(len(c.data) == 8, "t3: {len(c.data)}");
  d = t4_chain1();
  assert(len(d.value.data) == 8, "t4: {len(d.value.data)}");
  e = t5_single();
  assert(len(e.data) == 8, "t5: {len(e.data)}");
  // bind + argument faces, in a loop (slot churn)
  total = 0;
  for i in 0..4 {
    h = mk_nested().inner.value;
    total += len(h.data);
    total += t6_take(mk_nested().inner.value);
  }
  assert(total == 64, "loop faces: {total}");
  println("chained-field-of-call ok");
}
