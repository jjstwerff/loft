//
// loft#931 — the half of the `integer` → `i32` rule that RUNS.
//
// `931-i32-narrowing-is-checked.loft` pins the five positions that must refuse; a file
// with errors never executes, so what an accepted form actually STORES has to be asserted
// here.  Both halves are the same rule, and this is the one that would notice a fix that
// closed the gate by refusing everything.
//
// Two things it holds down:
//
//  · The CURE works and is the only one advertised.  The diagnostic says "cast explicitly
//    with `as i32`", so `as i32` must be accepted at each of the five positions — DN4's
//    explicit-cast rule keeps using range containment for exactly this reason.  A fix that
//    widened DN4 too would make the prescribed cure refuse itself, which is the deadlock
//    the issue was filed around.
//  · The width-tag idiom survives.  `f += (i as i32)` is how a program tags a
//    serialisation width, and it appears across loft's own tests and libraries; it must
//    keep compiling.

struct PnBox {
  v: i32,
  tag: integer,
}

struct PnNullable {
  c: i32?,
  t: integer,
}

fn pn_takes(x: i32) -> integer {
  x
}

fn pn_gives(n: integer) -> i32 {
  n as i32
}

// A CONSTANT that provably fits is exempt at every position — the rule is about what the
// compiler can prove, so a literal needs no cast while a plain `integer` VARIABLE does,
// whatever it happens to hold.  That is the contract `u8` has always had, and `i32` now
// matches it exactly: `n: integer = 200; x: u8 = n` and `n: integer = 2000000; x: i32 = n`
// are both refused, `x: u8 = 200` and `x: i32 = 2000000` are both accepted.
fn pn_constants_are_exempt() {
  x: i32 = 2000000;
  assert(x == 2000000, "931b const local {x}, want 2000000");

  b = PnBox { v: 7, tag: 1 };
  assert(b.v == 7, "931b const field {b.v}, want 7");

  b.v = 9;
  assert(b.v == 9, "931b const field write {b.v}, want 9");
  assert(pn_takes(11) == 11, "931b const arg {pn_takes(11)}, want 11");

  // The boundaries of what an `i32` can hold.  `-2147483648` is the null sentinel, not a
  // value, which is why the usable range stops one short of the 32-bit floor — an `i32`
  // field given it reads back `null`.  Its siblings differ: a non-null `i8` does hold
  // `-128`.  The gate refuses the sentinel, which is asserted in the error half.
  bh = PnBox { v: 2147483647, tag: 0 };
  bl = PnBox { v: -2147483647, tag: 0 };
  assert(bh.v == 2147483647, "931b i32 max {bh.v}");
  assert(bl.v == -2147483647, "931b i32 min {bl.v}");
}

// A value already OF the narrow type flows to every position with no cast — the gate is
// about a drop in storage width, and there is none here.
fn pn_same_width_is_free() {
  n: i32 = 2000000;
  x: i32 = n;
  assert(x == 2000000, "931b i32 local {x}, want 2000000");

  b = PnBox { v: n, tag: 1 };
  assert(b.v == 2000000, "931b i32 field {b.v}, want 2000000");

  b.v = n;
  assert(b.v == 2000000, "931b i32 field write {b.v}, want 2000000");
  assert(pn_takes(n) == 2000000, "931b i32 param {pn_takes(n)}, want 2000000");
}

// A nullable narrow field takes `null` — there is no value to lose, so absence is never a
// narrowing store.  `null` reaches the check typed as the full `integer` (an omitted field
// takes its default that way), so the widened width test had to be told (loft#931).
fn pn_null_is_not_a_narrowing() {
  n = PnNullable { c: 5, t: 1 };
  assert(n.c == 5, "931b nullable field {n.c}, want 5");
  n.c = null;
  assert(n.c == null, "931b nullable field cleared");

  // An OMITTED field takes its type's zero rather than null — the `omitted-field-zero`
  // advice (loft#914) is about exactly this, and `tests/issues.rs::issue_332_…` pins the
  // same answer.  What matters here is that the store is ACCEPTED: the compiler-inserted
  // default arrives at the narrowing check as a bare `null` typed `integer`, so before the
  // exemption the widened width test refused a struct literal that omits an `i32?` field.
  m = PnNullable { t: 2 };
  assert(m.c == 0, "931b omitted nullable field {m.c}, want 0");
}

// Widening is never a narrowing: a narrow alias flows into `i32`, and `i32` into
// `integer`, with no cast.
fn pn_widening_is_free() {
  a: u8 = 200;
  x: i32 = a;
  assert(x == 200, "931b u8 to i32 {x}, want 200");

  s: i16 = -3000;
  y: i32 = s;
  assert(y == -3000, "931b i16 to i32 {y}, want -3000");

  n: integer = y;
  assert(n == -3000, "931b i32 to integer {n}, want -3000");

  z: i32 = x;
  assert(z == 200, "931b i32 to i32 {z}, want 200");
}

// The prescribed cure, at each position the refusal can fire.  The value does not fit, so
// the store truncates — but the author asked for it in writing, which is the whole
// difference this issue is about.
fn pn_the_cure_is_accepted() {
  n: integer = 5000000000;

  x: i32 = n as i32;
  assert(x == 5000000000, "931b cast local {x} — a local keeps the 8-byte slot");

  b = PnBox { v: n as i32, tag: 1 };
  assert(b.v == 705032704, "931b cast field {b.v}, want 705032704");

  b.v = n as i32;
  assert(b.v == 705032704, "931b cast field write {b.v}, want 705032704");

  assert(pn_takes(n as i32) == 5000000000, "931b cast arg {pn_takes(n as i32)}");
  assert(pn_gives(n) == 705032704 || pn_gives(n) == 5000000000, "931b cast return");
}

// The serialisation width-tag idiom, which DN4 must keep accepting.
fn pn_width_tag_idiom() {
  f: integer = 0;
  i: integer = 3;
  f += (i as i32);
  assert(f == 3, "931b width tag {f}, want 3");
}

fn main() {
  pn_constants_are_exempt();
  pn_same_width_is_free();
  pn_null_is_not_a_narrowing();
  pn_widening_is_free();
  pn_the_cure_is_accepted();
  pn_width_tag_idiom();
  println("931b ok");
}
