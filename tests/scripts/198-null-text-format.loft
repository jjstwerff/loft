// @PLN10 — a text null sentinel renders "null" in format interpolation, mirroring
// integer null (i64::MIN → "null").  An empty string "" is NOT null (the
// content-based null model — `conv_bool_from_text`) and renders empty.  Both
// backends route text interpolation through `ops::format_text`, so the one fix
// there covers interpreter + native.
fn main() {
  jn = json_parse("42");        // JNumber → as_text() is null
  a = "{jn.as_text()}";
  assert(a == "null", "null text → 'null', got '{a}'");

  je = json_parse("\"\"");      // JString("") → empty, NOT null
  b = "[{je.as_text()}]";
  assert(b == "[]", "empty text → empty, got '{b}'");

  js = json_parse("\"hi\"");    // normal text unchanged
  c = "{js.as_text()}";
  assert(c == "hi", "normal text unchanged, got '{c}'");

  // null also renders "null" when embedded among other text
  jx = json_parse("99");
  d = "x={jx.as_text()}y";
  assert(d == "x=nully", "embedded null, got '{d}'");

  println("null-text format: ok");
}
