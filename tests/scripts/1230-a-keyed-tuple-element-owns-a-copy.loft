//
// D-tup-4's KEYED half (loft#1230, opened 2026-08-26 with loft#1102) — a keyed collection given
// to a tuple is COPIED, not aliased.
//
// `@FR-T-Cons` says a HEAP element handed to a tuple is copied in and that *"the tuple's element
// and the source are INDEPENDENT afterwards, and mutating either does not reach the other"*,
// grounded in `binding.md`'s `B-Copy`.  Only a bare `vector` obeyed it.  `hash`, `hash?`,
// `sorted`, `index`, `trie` and `spatial` all stored the source's handle, so `t = (h, 9)`
// followed by `h[2] = …` changed `t.0` — on both backends, on the shipped build.
//
// ⚠ `(T-Cons)`'s own conformance example is `t = (vl, 9); vl[0] = 41`, a VECTOR — the one case
// that worked.  A rule checked only by the shape that passes is a rule nobody is checking, and
// that is why this stood for five days after the vector half closed.
//
// The cure was already in the language and the register did not know it.  `OpReplaceKeyed` is
// what a STRUCT literal emits for a keyed member (`S { h: a }`), and a tuple RETURN copies
// through its synthetic `__tuple<…>` record — so both siblings `(T-Cons)` names were independent
// all along and only the tuple LITERAL aliased.  The register left this half open because the
// keyed shape was a codegen ICE ("three of the four tuple emitters hand-spelled the `DbRef` type
// set and were short by the five keyed collections"); that is fixed, and what remained was
// reaching for the copy rather than building one.
//
// THREE things were needed and none is guessable from the vector branch:
//
//   * the copy keeps the SOURCE's nullability.  Built dense, it loses its ownership dep on the
//     way into a `τ?` element slot and leaks;
//   * its result type DEPENDS on the copy's own variable, which is what tells the scope pass
//     the store has an owner in this frame;
//   * a tuple YIELD unwraps the copy, as the RETURN path already does (loft#1109).  A
//     coroutine's buffer copies its members, so an already-copied member is copied twice and
//     the wrapper's store is claimed by nobody — `tests/scripts/1148-…` leaked one store per
//     keyed kind until the yield learned the same unwrap.
//
// Scored on IDENTITY and INDEPENDENCE, never on a length alone: the copy and the source have the
// same length until the source is mutated, so only mutating it afterwards separates a copy from
// an alias.
//
// @falsified-at: 1294374b — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
//   exit 1 -> 0, native 1 assertion failures -> 0.
//
//   The file stops at its first failing assertion, so ONE is all the run can report.  Each kind
//   was therefore measured on its own against the same control build, and every one aliased:
//
//     hash     t=2 src=2      sorted   t=2 src=2      trie     t=2 src=2
//     hash?    t=2 src=2      index    t=2 src=2      spatial  t=2 src=2
//     deep (nested vector inside the element)  t=2 src=2
//     vector — control                          t=2 src=3   (correct on both trees)
//
//   Every keyed row reads 1 here and the vector control is unchanged, which is what says the
//   fix moved the keyed family and left the arm it mirrors alone.

struct E1230 { k: integer, nm: text }
struct P1230 { x: integer, y: integer, nm: text }
struct W1230 { w: text, n: integer }
struct In1230 { n: integer, tags: vector<text> }
struct De1230 { k: integer, inner: In1230 }

fn main() {
  // hash — the filed spelling.
  h1230: hash<E1230[k]> = [];
  h1230[1] = E1230 { k: 1, nm: "one" };
  th1230 = (h1230, 9);
  h1230[2] = E1230 { k: 2, nm: "two" };
  assert(len(th1230.0) == 1, "a hash element is a COPY, so the source's second record misses it");
  assert(len(h1230) == 2, "and the source itself still gained it");
  assert(th1230.0[1].nm == "one", "the copied record is reachable by its key");

  // The NULLABLE spelling: the one that needs the copy to carry the source's nullability, or
  // its ownership dep is lost entering the `τ?` slot and the store leaks.
  hn1230: hash<E1230[k]>? = [];
  hn1230[1] = E1230 { k: 1, nm: "one" };
  tn1230 = (hn1230, 9);
  hn1230[2] = E1230 { k: 2, nm: "two" };
  assert(len(tn1230.0?) == 1, "a nullable hash element is a copy too");

  // The other four kinds.  A list naming SOME of them reads as a complete rule and is not one
  // (loft#922), so each is scored: `trie` keys on text and `spatial` on a coordinate pair, so
  // neither shares the shape of the three that key on an integer.
  s1230: sorted<E1230[k]> = [];
  s1230[1] = E1230 { k: 1, nm: "one" };
  ts1230 = (s1230, 9);
  s1230[2] = E1230 { k: 2, nm: "two" };
  assert(len(ts1230.0) == 1, "a sorted element is a copy");

  i1230: index<E1230[k]> = [];
  i1230[1] = E1230 { k: 1, nm: "one" };
  ti1230 = (i1230, 9);
  i1230[2] = E1230 { k: 2, nm: "two" };
  assert(len(ti1230.0) == 1, "an index element is a copy");

  r1230: trie<W1230[w]> = [];
  r1230["aa"] = W1230 { w: "aa", n: 1 };
  tr1230 = (r1230, 9);
  r1230["bb"] = W1230 { w: "bb", n: 2 };
  assert(len(tr1230.0) == 1, "a trie element is a copy");

  p1230: spatial<P1230[x,y]> = [];
  p1230 += [P1230 { x: 1, y: 1, nm: "a" }];
  tp1230 = (p1230, 9);
  p1230 += [P1230 { x: 2, y: 2, nm: "b" }];
  assert(len(tp1230.0) == 1, "a spatial element is a copy");

  // DEEP, because `B-Copy` is what `(T-Cons)` grounds the copy in: a nested heap member inside
  // the element must be independent too, not just the collection's own records.
  d1230: hash<De1230[k]> = [];
  d1230[1] = De1230 { k: 1, inner: In1230 { n: 5, tags: ["x"] } };
  td1230 = (d1230, 9);
  d1230[1].inner.tags += ["y"];
  assert(len(td1230.0[1].inner.tags) == 1, "the copy is DEEP — a nested vector does not follow");
  assert(len(d1230[1].inner.tags) == 2, "while the source's nested vector did gain the element");

  // ---- controls ----

  // The VECTOR element, which obeyed `(T-Cons)` throughout and is the arm this mirrors.
  v1230: vector<integer> = [7, 8];
  tv1230 = (v1230, 9);
  v1230 += [41];
  assert(len(tv1230.0) == 2 && len(v1230) == 3, "a vector element was never broken");

  // The two SIBLING constructors `(T-Cons)`'s wording appeals to — *"the same answer
  // `S { v: vl }` and `[vl]` give"*.  Both already copied a keyed member, which is what says
  // the tuple literal was the odd one out rather than the keyed family being uncopyable.
  sh1230: hash<E1230[k]> = [];
  sh1230[1] = E1230 { k: 1, nm: "one" };
  st1230 = St1230 { h: sh1230 };
  sh1230[2] = E1230 { k: 2, nm: "two" };
  assert(len(st1230.h) == 1, "a STRUCT literal already copied its keyed member");
}

struct St1230 { h: hash<E1230[k]> }
