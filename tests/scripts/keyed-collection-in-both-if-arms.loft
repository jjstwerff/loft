//
// A keyed collection declared under the SAME NAME in two arms of one if/else
// chain.  `scan_if` registers a variable that both arms assign at the PARENT
// scope, which is right for a scalar and wrong for anything backed by a heap
// store: it hoists the ownership without ever creating the store, so the
// scope-exit free meets a stack-record ref where it expects an owned one.
//
// `needs_pre_init` listed text / reference / vector / enum and not the keyed
// collections, so every one of them crashed the interpreter — `hash` and
// `index` with a SIGSEGV once the arm appended, `sorted` with the runtime's own
// `BUG (#306): a stack-record ref was treated as an owned heap store`.  `vector`
// was in the list, which is why this read as type-specific rather than as the
// omission it was.  `--native` derives the answer separately and was always
// right, so this is an interpreter-vs-native divergence too.
//
// Every shape below crashed or tripped #306 before; each must now simply work.
#cwd

struct Rec { const id: integer, const a: i32 }

fn hash_arms(pick: boolean) -> integer {
  if pick {
    h: hash<Rec[id]> = [];
    h += [Rec { id: 1, a: 1 as i32 }];
    len(h)
  } else {
    h: hash<Rec[id]> = [];
    h += [Rec { id: 2, a: 2 as i32 }];
    h += [Rec { id: 3, a: 3 as i32 }];
    len(h)
  }
}

fn sorted_arms(pick: boolean) -> integer {
  if pick {
    s: sorted<Rec[id]> = [];
    s += [Rec { id: 1, a: 1 as i32 }];
    len(s)
  } else {
    s: sorted<Rec[id]> = [];
    len(s)          // the no-append arm: tripped #306 without crashing
  }
}

fn index_arms(pick: boolean) -> integer {
  if pick {
    x: index<Rec[id]> = [];
    x += [Rec { id: 1, a: 1 as i32 }];
    len(x)
  } else {
    x: index<Rec[id]> = [];
    x += [Rec { id: 9, a: 9 as i32 }];
    len(x)
  }
}

// A three-arm chain: the same name in every arm of one else-if ladder.
fn three_arms(which: integer) -> integer {
  if which == 0 {
    h: hash<Rec[id]> = [];
    len(h)
  } else if which == 1 {
    h: hash<Rec[id]> = [];
    h += [Rec { id: 1, a: 1 as i32 }];
    len(h)
  } else {
    h: hash<Rec[id]> = [];
    h += [Rec { id: 1, a: 1 as i32 }];
    h += [Rec { id: 2, a: 2 as i32 }];
    len(h)
  }
}

fn main() {
  assert(hash_arms(true) == 1, "hash: true arm");
  assert(hash_arms(false) == 2, "hash: false arm");
  assert(sorted_arms(true) == 1, "sorted: true arm");
  assert(sorted_arms(false) == 0, "sorted: false arm holds nothing");
  assert(index_arms(true) == 1, "index: true arm");
  assert(index_arms(false) == 1, "index: false arm");
  assert(three_arms(0) == 0, "three arms: first");
  assert(three_arms(1) == 1, "three arms: middle");
  assert(three_arms(2) == 2, "three arms: last");
  // Repeated so a store leaked per pass would show as growth rather than as a
  // single stray allocation nothing measures.
  total = 0;
  for k in 0..60 { total += hash_arms(k % 2 == 0); }
  assert(total == 90, "60 passes, alternating arms");
}
