//
// Regression: a `sorted<T[k]>` STRUCT FIELD returned the right elements with
// every non-key field garbage, as soon as the same struct also held a `hash<T[k]>`
// field.  Both backends.
//
//   struct DB { s: sorted<It[k]>, h: hash<It[k]> }
//   d = DB { s: a, h: b };
//   for e in d.s { … }        // e.k correct, e.v = 4294967298
//
// Trigger: two containers over the same element type mark `It` as LINKED, so
// `finish_type` promotes the sorted field `Sorted` -> `Ordered` (entries become
// 4-byte rec-ids into records, rather than inline records).  That promotion is
// deliberate; the deep-copy of an Ordered field's element records was not
// following it.
//
// Cause, in `copy_claims_array_body`: a record is an 8-byte header plus `size`
// payload bytes and `claim` takes 8-byte WORDS, but the element was claimed as
// `size.div_ceil(8)` words — one word short, leaving no room for the last field —
// and its payload was copied as `size - 4` bytes from offset 4, which starts 4
// bytes early and stops 4 bytes short.  For `It { k: integer, v: integer }` that
// copied `k` and never `v`, and `v`'s slot lay outside the claimed record, so
// reading it returned the NEXT record's header — hence a correct key beside a
// plausible-looking `(claim << 32) | length`.  The `copy_claims` recursion in the
// same loop always used offset 8; the claim and the copy now agree with it.
//
// The discriminators are asserted too: sorted+sorted (one shared container type,
// so no promotion), sorted+vector, and both collections as LOCALS all worked, and
// a guard built from those alone reports this fixed.

struct It { k: integer, v: integer }
struct DB { s: sorted<It[k]>, h: hash<It[k]> }
struct TwoSorted { s: sorted<It[k]>, t: sorted<It[k]> }
struct SortedVec { s: sorted<It[k]>, w: vector<integer> }

fn mk_sorted() -> sorted<It[k]> {
  a: sorted<It[k]> = [];
  a += It { k: 1, v: 10 };
  a += It { k: 2, v: 20 };
  return a;
}
fn mk_hash() -> hash<It[k]> {
  b: hash<It[k]> = [];
  b += It { k: 3, v: 30 };
  b += It { k: 4, v: 40 };
  return b;
}

// The reported shape — a sorted field beside a hash field over the same element.
fn test_438_sorted_beside_hash() {
  d = DB { s: mk_sorted(), h: mk_hash() };
  sum = 0;
  count = 0;
  for e in d.s { sum += e.v; count += 1; }
  assert(count == 2, "sorted field element count: {count}");
  assert(sum == 30, "sorted field value sum: {sum} (expect 30)");
  // the KEY read correctly even when broken — it sits at offset 0 either way,
  // so asserting only the key would have passed throughout.
  keys = 0;
  for e in d.s { keys += e.k; }
  assert(keys == 3, "sorted field key sum: {keys}");
  // the direct lookup fails the same way as the iteration; both are covered.
  assert(d.s[1].v == 10, "sorted field lookup [1].v: {d.s[1].v}");
  assert(d.s[2].v == 20, "sorted field lookup [2].v: {d.s[2].v}");
  // the sibling hash must stay correct.
  hsum = 0;
  for e in d.h { hsum += e.v; }
  assert(hsum == 70, "hash field value sum: {hsum} (expect 70)");
  assert(d.h[3].v == 30, "hash field lookup [3].v: {d.h[3].v}");
}

// Field order does not matter — the promotion keys on the element type.
fn test_438_hash_declared_first() {
  d = DB { h: mk_hash(), s: mk_sorted() };
  sum = 0;
  for e in d.s { sum += e.v; }
  assert(sum == 30, "hash-first: sorted sum {sum}");
}

// The sources must survive the bind intact.
fn test_438_sources_intact() {
  a = mk_sorted();
  b = mk_hash();
  d = DB { s: a, h: b };
  asum = 0;
  for e in a { asum += e.v; }
  assert(asum == 30, "source sorted after bind: {asum}");
  dsum = 0;
  for e in d.s { dsum += e.v; }
  assert(dsum == 30, "field after reading source: {dsum}");
}

// ── discriminators that always worked ────────────────────────────────────────

// Two SORTED fields share one container type, so `It` is not linked and no
// promotion happens.
fn test_438_two_sorted_fields() {
  a: sorted<It[k]> = []; a += It { k: 1, v: 10 }; a += It { k: 2, v: 20 };
  b: sorted<It[k]> = []; b += It { k: 3, v: 30 }; b += It { k: 4, v: 40 };
  d = TwoSorted { s: a, t: b };
  x = 0; for e in d.s { x += e.v; }
  y = 0; for e in d.t { y += e.v; }
  assert(x == 30 && y == 70, "two sorted fields: s={x} t={y}");
}

// A vector sibling does not create a second container over `It`.
fn test_438_sorted_beside_vector() {
  a: sorted<It[k]> = []; a += It { k: 1, v: 10 }; a += It { k: 2, v: 20 };
  w: vector<integer> = [7, 8];
  d = SortedVec { s: a, w: w };
  x = 0; for e in d.s { x += e.v; }
  assert(x == 30, "sorted beside vector: {x}");
  assert(len(d.w) == 2 && (d.w[0] ?? 0) == 7, "vector sibling: {d.w}");
}

// Both collections as LOCALS never go through the field copy at all.
fn test_438_both_as_locals() {
  a = mk_sorted();
  b = mk_hash();
  x = 0; for e in a { x += e.v; }
  y = 0; for e in b { y += e.v; }
  assert(x == 30 && y == 70, "as locals: sorted={x} hash={y}");
}
