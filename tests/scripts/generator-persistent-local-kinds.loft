//
// A generator's locals live as fields on its state-machine struct, and until now the two
// facts a field needs — what TYPE it is declared, and what NAME it is spelled — each had a
// second writer that had drifted from the first. Both halves broke only `--native`; every
// program here ran correctly under `--interpret`, which is what kept them quiet.
//
// The TYPE half: `rust_type` declares the field, and a separate list said what to
// initialise it to. That list disagreed on three arms at once — `character` declared `i32`
// and initialised `0_u32`, `single` declared `f32` and initialised `0.0_f64`, `boolean`
// declared `u8` and initialised `false`. A generator holding a local of ANY of those three
// types therefore failed to compile natively. The default is now the zero of whatever
// `rust_type` decided, so there is nothing left to disagree with.
//
// The NAME half: a write to a persistent local has to name the FIELD, and the text-append
// emitters named a plain local instead — so `a = a + t` inside a generator loop emitted
// `var_a += …` against a field called `self.var_a`, and rustc could not find it. Every
// place now goes through one accessor that answers "field or local".
//
// One function per local type, each holding its local across a `yield` so it has to be a
// field rather than a match-arm temporary.

fn keeps_a_boolean() -> iterator<integer> {
  b = true;
  yield 1;
  if b { yield 2; }
}

fn keeps_a_single() -> iterator<single> {
  s: single = 1.5f;
  yield s;
  yield s + 1.0f;
}

fn keeps_a_character() -> iterator<text> {
  c = 'x';
  yield "{c}";
  yield "{c}{c}";
}

fn keeps_a_float() -> iterator<float> {
  f = 1.25;
  yield f;
  yield f + 0.25;
}

fn keeps_an_integer() -> iterator<integer> {
  n = 7;
  yield n;
  yield n * 2;
}

// The name half: a text local APPENDED to from inside a loop, which is the shape that
// emits `+=` against the field.
fn appends_text(v: vector<text>) -> iterator<text> {
  a = "";
  for t in v { a = a + t; }
  yield a;
  b = "";
  for t in v { b = b + t + "!"; }
  yield b;
}

// Its character twin — a different emitter (`push`), the same missing question.
fn appends_characters(w: text) -> iterator<text> {
  a = "";
  for c in w { a = a + c; }
  yield a;
  yield a + a;
}

fn main() {
  // One loop-variable name per element TYPE: a `for` variable is function-scoped, so
  // reusing `x` across these loops is a compile error (loft#915).
  o = 0;
  for x in keeps_a_boolean() { o = o * 10 + x; }
  assert(o == 12, "keeps_a_boolean reads {o}, want 12");

  fs: single = 0.0f;
  for xs in keeps_a_single() { fs = fs + xs; }
  assert(fs == 4.0f, "keeps_a_single reads {fs}, want 4.0");

  tc = "";
  for s in keeps_a_character() { tc = tc + s; }
  assert(tc == "xxx", "keeps_a_character reads {tc}, want xxx");

  ff = 0.0;
  for xf in keeps_a_float() { ff = ff + xf; }
  assert(ff == 2.75, "keeps_a_float reads {ff}, want 2.75");

  oi = 0;
  for xi in keeps_an_integer() { oi = oi * 100 + xi; }
  assert(oi == 714, "keeps_an_integer reads {oi}, want 714");

  vt: vector<text> = ["x", "y"];
  ta = "";
  for s in appends_text(vt) { ta = ta + s + "|"; }
  assert(ta == "xy|x!y!|", "appends_text reads {ta}, want xy|x!y!|");

  tp = "";
  for s in appends_characters("xy") { tp = tp + s + "|"; }
  assert(tp == "xy|xyxy|", "appends_characters reads {tp}, want xy|xyxy|");

  println("ok");
}
