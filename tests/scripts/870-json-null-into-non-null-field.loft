//
// loft#870 — a `text as Struct` / `text as vector<Struct>` cast wrote the null
// SENTINEL into a field declared non-null.
//
// `integer`, `long`, `single` and `float` spell absence with a sentinel and share one
// content type between their `T` and `T?` spellings, so a type-only default has to
// pick one, and it picked the sentinel. A field declared plain then read back `null`
// — a value DN1 says the slot cannot hold — while `redundant-coalesce`, reading the
// declared type, advised deleting the `?? 0.0` that was doing the work.
//
// A ranged `u8`/`u16`/`i32` field was always right, because `Parts::Byte`/`Short`/
// `Int` carry their nullability in the Part; that is what made the defect look like a
// float/integer oddity rather than a rule about fields. And the filed shape was the
// explicit `"height": null`; a key the JSON simply OMITS is the same question and had
// the same wrong answer.
//
// The guard therefore checks BOTH ways a value can be absent, across every scalar
// width, at depth, and in a vector element — and pins the nullable spelling to `null`
// in the same breath, since a fix that zeroed everything would pass a non-null-only
// check.

struct J870Inner {
  ii_plain: float,
  ii_opt:   float?,
}

struct J870Wide {
  jw_int:    integer,
  jw_single: single,
  jw_float:  float,
  jw_byte:   u8,
  jw_short:  u16,
  jw_i32:    i32,
  jw_bool:   boolean,
  jw_q_int:  integer?,
  jw_q_flt:  float?,
  jw_q_byte: u8?,
  jw_inner:  J870Inner,
}

// Every field written `null` outright.
const J870_NULL: text = `
  {{ "jw_int": null, "jw_single": null, "jw_float": null, "jw_byte": null,
     "jw_short": null, "jw_i32": null, "jw_bool": null,
     "jw_q_int": null, "jw_q_flt": null, "jw_q_byte": null,
     "jw_inner": {{ "ii_plain": null, "ii_opt": null }} }}
`;

// Not one key present — the same question, asked by omission.
const J870_MISS: text = `{{ }}`;

// A vector, because the element path defaults through a different site than the
// top-level record does.
const J870_VEC: text = `
  [ {{ "ii_plain": 1.5, "ii_opt": 2.5 }},
    {{ "ii_plain": null, "ii_opt": null }},
    {{ }} ]
`;

fn j870_check(tag: text, w: J870Wide) {
  // Non-null scalars: the type's zero, never the sentinel.
  assert(w.jw_int == 0, "{tag} jw_int {w.jw_int}");
  assert(w.jw_single == 0.0, "{tag} jw_single {w.jw_single}");
  assert(w.jw_float == 0.0, "{tag} jw_float {w.jw_float}");
  assert(w.jw_byte == 0 as u8, "{tag} jw_byte {w.jw_byte}");
  assert(w.jw_short == 0 as u16, "{tag} jw_short {w.jw_short}");
  assert(w.jw_i32 == 0 as i32, "{tag} jw_i32 {w.jw_i32}");
  assert(!w.jw_bool, "{tag} jw_bool {w.jw_bool}");

  // A non-null field at DEPTH follows its own declaration, not its parent's.
  assert(w.jw_inner.ii_plain == 0.0, "{tag} ii_plain {w.jw_inner.ii_plain}");

  // The nullable spelling still means null — a fix that just zeroed the world
  // would pass everything above and destroy this.
  assert(w.jw_q_int == null, "{tag} jw_q_int {w.jw_q_int}");
  assert(w.jw_q_flt == null, "{tag} jw_q_flt {w.jw_q_flt}");
  assert(w.jw_q_byte == null, "{tag} jw_q_byte {w.jw_q_byte}");
  assert(w.jw_inner.ii_opt == null, "{tag} ii_opt {w.jw_inner.ii_opt}");
}

fn main() {
  j870_check("explicit-null", J870_NULL as J870Wide);
  j870_check("key-missing", J870_MISS as J870Wide);

  j870_v = J870_VEC as vector<J870Inner>;
  assert(len(j870_v) == 3, "vec len {len(j870_v)}");

  j870_e0 = j870_v[0] ?? J870Inner {};
  assert(j870_e0.ii_plain == 1.5, "e0 plain {j870_e0.ii_plain}");
  assert(j870_e0.ii_opt == 2.5, "e0 opt {j870_e0.ii_opt}");

  // Element written `null`, and element with the key omitted — both a zero in the
  // non-null slot and a null in the nullable one.
  j870_e1 = j870_v[1] ?? J870Inner {};
  assert(j870_e1.ii_plain == 0.0, "e1 plain {j870_e1.ii_plain}");
  assert(j870_e1.ii_opt == null, "e1 opt {j870_e1.ii_opt}");

  j870_e2 = j870_v[2] ?? J870Inner {};
  assert(j870_e2.ii_plain == 0.0, "e2 plain {j870_e2.ii_plain}");
  assert(j870_e2.ii_opt == null, "e2 opt {j870_e2.ii_opt}");

  // A comparison against a non-null field must answer arithmetically. This is the
  // consumer's real failure: a null height compares `<= x` TRUE and `> x` FALSE, so
  // a `if height > climb { blocked }` passability rule read a wall as walkable.
  j870_g = J870_MISS as J870Wide;
  assert(j870_g.jw_float > -1.0, "guard >");
  assert(!(j870_g.jw_float > 1.0), "guard > high");

  // A round trip through `show` reproduces the same values, so the zero is stored
  // and not merely printed.
  j870_s = "{j870_v}";
  j870_w = j870_s as vector<J870Inner>;
  j870_r1 = j870_w[1] ?? J870Inner {};
  assert(j870_r1.ii_plain == 0.0, "roundtrip plain {j870_r1.ii_plain}");
  assert(j870_r1.ii_opt == null, "roundtrip opt {j870_r1.ii_opt}");
}
