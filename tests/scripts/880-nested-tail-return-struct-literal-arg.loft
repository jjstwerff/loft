//
// loft#880 — a struct built by a `while` + vector-frontier sweep lost everything the
// loop wrote when the function was reached through TWO nested tail-position calls and
// the outer call passed a STRUCT LITERAL as an argument.
//
// Nothing warned and nothing panicked: the struct came back structurally valid and
// nearly empty. On the interpreter the write made BEFORE the loop survived and every
// write made INSIDE it was lost (1 of 13); `--native` lost all of them (0 of 13). That
// split is what pointed at the loop rather than at the return.
//
// Four things had to compose, and the loop shape is the surprising one:
//   1. the callee fills a `hash` field inside a `while` loop that REASSIGNS a vector
//      frontier (a plain `for`, or a `while` without the vector, is correct);
//   2. the middle function returns that call as a bare tail expression;
//   3. the outer function returns THAT call as a bare tail expression too;
//   4. the outer call passes a struct LITERAL as an argument — the same value passed
//      as a parameter is correct.
//
// Fixed by the return-buffer work (loft#872 / loft#877): a work-ref mint claimed the
// return-buffer ARGUMENT and re-typed it, and the Reference delivery selector renamed a
// shape-mismatched candidate onto a record buffer. This guard is the composition that
// reached those two through two tail calls, which no other test covers — it reproduces
// on the published 2026.8.0 and passes here.
//
// The negative rows are the point as much as the positive one: `wrap_param` (same
// value, passed as a parameter) and `wrap_bound` (inner result bound to a local) were
// always correct, so a fix that broke them would be trading one wrong answer for
// another.

struct H880Hex   { hx_q: integer, hx_r: integer }
struct H880Cell  { hc_q: integer, hc_r: integer, hc_dist: integer }
struct H880Field {
  hf_cells:     hash<H880Cell[hc_q, hc_r]>,
  hf_core:      H880Hex,
  hf_climb:     float,
  hf_truncated: boolean,
}
struct H880Rise  { hr_q: integer, hr_r: integer, hr_metres: float }
struct H880Layer { hl_rises: hash<H880Rise[hr_q, hr_r]> }

fn h880_layer_empty() -> H880Layer { H880Layer { hl_rises: [] } }
fn h880_limit_of(kind: integer) -> float { if kind == 1 { 3.0 } else { 0.0 } }

// The sweep: a `hash` field filled inside a `while` loop that reassigns a vector
// frontier.  Walks q = 0..12 inclusive, one cell per step, so 13 cells.
fn h880_sweep(hl: const H880Layer, climb: float, core: H880Hex) -> H880Field {
  f = H880Field { hf_cells: [], hf_core: core, hf_climb: climb, hf_truncated: false };
  f.hf_cells[core.hx_q, core.hx_r] = H880Cell { hc_q: core.hx_q, hc_r: core.hx_r, hc_dist: 0 };
  frontier: vector<H880Hex> = [core];
  d = 0;
  while len(frontier) > 0 {
    d += 1;
    next: vector<H880Hex> = [];
    for h in frontier {
      n = H880Hex { hx_q: h.hx_q + 1, hx_r: h.hx_r };
      if n.hx_q <= 12 && f.hf_cells[n.hx_q, n.hx_r] == null {
        f.hf_cells[n.hx_q, n.hx_r] = H880Cell { hc_q: n.hx_q, hc_r: n.hx_r, hc_dist: d };
        next += [n];
      }
    }
    if len(f.hf_cells) > 1000 { f.hf_truncated = true; return f; }
    frontier = next;
  }
  f
}

// One tail call.
fn h880_build(hl: const H880Layer, kind: integer, core: H880Hex) -> H880Field {
  h880_sweep(hl, h880_limit_of(kind), core)
}

// Two tail calls + a struct LITERAL argument — the failing composition.
fn h880_wrap_literal() -> H880Field {
  h880_build(h880_layer_empty(), 0, H880Hex { hx_q: 0, hx_r: 0 })
}

// Two tail calls, the same value as a PARAMETER — was always correct.
fn h880_wrap_param(core: H880Hex) -> H880Field { h880_build(h880_layer_empty(), 0, core) }

// Two tail calls, inner result BOUND to a local — was always correct (the workaround).
fn h880_wrap_bound() -> H880Field {
  wb = h880_build(h880_layer_empty(), 0, H880Hex { hx_q: 0, hx_r: 0 });
  wb
}

// Count AND a value, so a delivery that hands back a differently-wrong hash of the
// right size cannot pass: cell (12,0) is the last one the loop writes, at distance 12.
fn h880_check(f: H880Field, name: text) {
  assert(len(f.hf_cells) == 13, "{name}: {len(f.hf_cells)} cells, expected 13");
  last = f.hf_cells[12, 0];
  assert(last != null, "{name}: cell (12,0) missing");
  assert(last.hc_dist == 12, "{name}: cell (12,0) dist={last.hc_dist}, expected 12");
  assert(f.hf_core.hx_q == 0, "{name}: core q={f.hf_core.hx_q}");
  assert(f.hf_truncated == false, "{name}: truncated");
}

fn main() {
  h880_check(h880_sweep(h880_layer_empty(), 0.0, H880Hex { hx_q: 0, hx_r: 0 }), "sweep direct");
  h880_check(h880_build(h880_layer_empty(), 0, H880Hex { hx_q: 0, hx_r: 0 }), "build 1 tail");
  h880_check(h880_wrap_param(H880Hex { hx_q: 0, hx_r: 0 }), "wrap_param 2 tails");
  // The filed shape.
  h880_check(h880_wrap_literal(), "wrap_literal 2 tails + literal arg");
  h880_check(h880_wrap_bound(), "wrap_bound 2 tails + bound");

  println("880 nested-tail-return ok");
}
