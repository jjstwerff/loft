//
// @P376 regression (dryopea-surfaced, plan 03 M3) — a `vector<Struct>`
// with trailing `u8 not null` fields, built via `hash → for-iterate →
// append into a fresh vector`, then embedded in a wrapper struct and
// serialised via `:j`, produced JSON where EVERY field (including the
// leading integers) zeroed — while the same vector serialised standalone
// was correct.  Fixed by the #223 JSON round-trip batch (@P372 record
// sizing / @P373 empty-array field / @P375 empty-field emission touched
// the same format-walk machinery); verified resolved 2026-05-27.
//
// Guards the exact dryopea trigger shape: hash<Pair[k]> → for-append into
// a fresh vector<Pair> → wrap → `{w:j}`.  Pulling any step apart already
// worked; this is the combination that corrupted.

struct Pair {
  q: integer,
  r: integer,
  kind: u8,
  direction: u8,
}
struct Bag {
  items: hash<Pair[q, r]>,
}
struct Wrapper {
  version: integer,
  name: text,
  items: vector<Pair>,
}

fn main() {
  bag = Bag { items: [] };
  bag.items[1, 1] = Pair { q: 1, r: 1, kind: 0 as u8, direction: 0 as u8 };
  bag.items[2, 2] = Pair { q: 2, r: 2, kind: 0 as u8, direction: 3 as u8 };

  out: vector<Pair> = [];
  for e in bag.items {
    out += [
      Pair { q: e.q, r: e.r, kind: e.kind, direction: e.direction },
    ];
  }

  // standalone walk has always been correct
  assert(
    "{out:j}" == `[{{"q":1,"r":1,"kind":0,"direction":0}},{{"q":2,"r":2,"kind":0,"direction":3}}]`,
    "standalone vector<Pair> with u8 tail fields serialises correctly"
  );

  // the wrapped walk is the @P376 regression — must match the standalone,
  // NOT zero every field.
  w = Wrapper { version: 1, name: "test", items: out };
  assert(
    "{w:j}" == `{{"version":1,"name":"test","items":[{{"q":1,"r":1,"kind":0,"direction":0}},{{"q":2,"r":2,"kind":0,"direction":3}}]}}`,
    "wrapped vector<Pair> with u8 tail fields preserves all field values"
  );

  print("ok");
}
