// loft#725 — a struct-returning call whose result is DISCARDED must not leak.
//
// `for i in 0..8 { mk(i) }` leaked one store per round. The filed cause was wrong,
// and the matrix is what corrected it: a single discarded statement (`mk(1);`) was
// always clean, so it is not "a discarded result has no variable to hang a free on".
// The lift does mint a temp and does free it — the IR carries `__lift_1 = n_mk(…);
// OpFreeRef(__lift_1)` inside the loop body, once per iteration.
//
// What leaked was the block's declared RESULT. The lift consumes the call's value,
// leaving a block still typed `ref(C)` with no tail expression producing one, so
// codegen synthesised a typed null to satisfy the type — and for a Reference that
// null was `emit_push_null_ref`, which calls `database.null()` and claims a store.
// `gen_drop` then discarded the eval-stack bytes, and nothing freed the store
// behind them.
//
// A typed null is now a SENTINEL (`store_nr == u16::MAX`), which is what the
// function's own name says it emits: it reads as null, `free_named` no-ops on it,
// and an `OpDatabase` landing on such a slot still allocates fresh, so a null that
// is later written through is unaffected.
//
// Interpreter-only — native already lowered this to `DbRef::NULL` with no
// allocation, which is why `--native` was clean throughout and only the interpreter
// leaked. The guard is the script suite's Part B leak gate; the assertions below
// only keep the calls from being optimised into nothing.

struct DcrCell {
  n: integer,
  label: text,
}

struct DcrBox {
  items: vector<DcrCell>,
}

fn dcr_make(n: integer) -> DcrCell {
  DcrCell { n: n, label: "d-{n}" }
}

fn dcr_box(n: integer) -> DcrBox {
  DcrBox { items: [DcrCell { n: n, label: "b-{n}" }] }
}

fn main() {
  // The reported shape. A loop is required: one discarded statement was always
  // clean, because the leak is one store per synthesised block result.
  for i in 0..8 { dcr_make(i) }

  // A nested aggregate — the discarded value owns a vector as well as a record.
  for i in 0..8 { dcr_box(i) }

  // Enough rounds that a per-round leak is unmistakable rather than a fixed cost.
  for i in 0..99 { dcr_make(i) }

  // The single-statement form, which never leaked and must stay that way.
  dcr_make(1);

  // Controls: the same call, not discarded. These bound and read forms were always
  // clean, and a fix that started freeing something it should not would break them
  // rather than this file's leak gate.
  s = 0;
  for i in 0..8 {
    r = dcr_make(i);
    s += r.n;
  }
  assert(s == 28, "bound results still read correctly: {s}");

  t = dcr_make(4).label;
  assert(t == "d-4", "a field read off an inline call: {t}");

  b = dcr_box(3).items[0] ?? DcrCell { n: 0, label: "" };
  assert(b.n == 3, "an element bound out of a returned temporary: {b.n}");
}
