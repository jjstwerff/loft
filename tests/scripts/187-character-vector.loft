//
// Regression: `vector<character>` element READS failed — `v[0]` and `for c in v`
// errored "Field access not supported on type character".  Construction worked
// (the write side had OpSetCharacter) but `get_val` (src/parser/mod.rs) had no
// `Type::Character` read arm, so character element reads fell through to the
// generic field-access error.  Fix: add the symmetric `OpGetCharacter` read arm.
// This also unblocked nested `vector<vector<character>>` (gated by the same arm).

struct Holder {
  letters: vector<character>,
}

fn main() {
  // flat index read
  v: vector<character> = ['a', 'b', 'c'];
  assert(v[0] == 'a' && v[1] == 'b' && v[2] == 'c', "flat index {v}");

  // iteration
  s: text = "";
  for c in v { s += "{c}"; }
  assert(s == "abc", "iterate {s}");

  // nested vector<vector<character>>
  vv: vector<vector<character>> = [['x', 'y'], ['z']];
  assert(vv[0][0] == 'x' && vv[0][1] == 'y' && vv[1][0] == 'z', "nested {vv}");

  // struct field
  h = Holder { letters: ['p', 'q'] };
  assert(h.letters[0] == 'p' && h.letters[1] == 'q', "struct-field");

  // text indexing must still return characters (untouched control)
  t: text = "hi";
  assert(t[0] == 'h' && t[1] == 'i', "text-index control");

  println("character-vector ok");
}
