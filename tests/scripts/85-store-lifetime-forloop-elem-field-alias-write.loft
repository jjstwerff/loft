//
// @PLN25 dense-flip regression (surfaced as the p379 two-libs crash). Binding a
// local to a vector FIELD read off a BORROWED base — a for-loop element of an
// outer vector — must ALIAS the field's store, so an in-place write-through
// (`cells = sc.field; cells[i] = h`) reaches the source. The #415 deep-copy is
// for an OWNED base only (value-semantics independence); applying it to a
// borrowed base lost the write and, with no in-bounds element to copy into,
// built a null ref → `index out of bounds: len N, index 65535` (store_nr ==
// u16::MAX) on BOTH backends.
//
// Pre-dense the nullable element wrap made `sc.field` a DOUBLE OpGetField (base
// a Call, not a Var) so the #415 rule never fired on a borrowed element; the
// dense flip collapsed it to a single OpGetField(Var, …). Fix: the
// struct-vector-field deep-copy keys on the base's `deps` ownership fact (empty
// deps = owns = copy; non-empty = borrows a live source = alias), not the shape.
//
// Guards value semantics + write-through across the base-kind axis, both backends.

struct Hex {
  h_height: integer,
  h_material: integer,
}
struct Chunk {
  ck_cx: integer,
  ck_hexes: vector<Hex>,
}
struct Map {
  m_chunks: vector<Chunk>,
}

fn mk_chunk(cx: integer) -> Chunk {
  hexes: vector<Hex> = [];
  for _ in 0..4 { hexes += [
    Hex { h_height: 0, h_material: 0 },
  ]; }
  Chunk { ck_cx: cx, ck_hexes: hexes }
}

fn ensure(m: &Map, cx: integer) {
  for ec in m.m_chunks {
    if ec.ck_cx == cx { return; }
  }
  m.m_chunks += [mk_chunk(cx)];
}

// base = &Chunk reference param: aliases its field (write-through).
fn a1_write(c: &Chunk, idx: integer, h: Hex) {
  cells = c.ck_hexes; cells[idx] = h;
}

// base = for-loop element of the outer vector: the regressed case.
fn a2_write(m: &Map, cx: integer, idx: integer, h: Hex) {
  ensure(m, cx);
  for sc in m.m_chunks {
    if sc.ck_cx == cx {
      cells = sc.ck_hexes; cells[idx] = h; return;
    }
  }
}

// base = index-read element of the outer vector.
fn a3_write(m: &Map, cx: integer, idx: integer, h: Hex) {
  ensure(m, cx);
  cells = m.m_chunks[0].ck_hexes;
  cells[idx] = h;
}

// base = for-loop element, alias-READ.
fn a5_read(m: Map, cx: integer, idx: integer) -> integer {
  for gc in m.m_chunks {
    if gc.ck_cx == cx {
      cells = gc.ck_hexes; return cells[idx].h_height;
    }
  }
  -1
}

fn main() {
  c1 = mk_chunk(1);
  a1_write(c1, 2, Hex { h_height: 7, h_material: 0 });
  assert(c1.ck_hexes[2].h_height == 7, "a1: &param field alias write-through");

  m = Map { m_chunks: [] };
  a2_write(m, 1, 2, Hex { h_height: 7, h_material: 0 });
  assert(m.m_chunks[0].ck_hexes[2].h_height == 7, "a2: for-loop elem field alias write-through");
  assert(a5_read(m, 1, 2) == 7, "a5: for-loop elem field alias read");

  m2 = Map { m_chunks: [] };
  a3_write(m2, 1, 2, Hex { h_height: 7, h_material: 0 });
  assert(m2.m_chunks[0].ck_hexes[2].h_height == 7, "a3: index-read elem field alias write-through");

  // The #415 owned-base case still deep-copies (value-semantics independence).
  ch = mk_chunk(5);
  snap = ch.ck_hexes;
  ch.ck_hexes += [
    Hex { h_height: 9, h_material: 9 },
  ];
  assert(len(snap) == 4, "owned-base field read stays an independent copy (len 4)");
}
