//
// A type used before its declaration works inside a TUPLE, exactly as it already did
// everywhere else.
//
// A forward reference resolves by ADOPTION: the name becomes a `DefType::Unknown` stub and
// the later declaration upgrades it in place. Nothing rewrites the `Type::Unknown(stub)`
// values already stored — it works because pass 2 RE-PARSES every type position with the
// declaration now visible. A tuple defeated that in two ways at once (loft#944).
//
// 1. `tuple_def` derives BOTH the synthetic `__tuple<…>` def's name and its frozen element
//    layout from the members' spellings. An unresolved member spells `"unknown"` and sizes
//    as ZERO WIDTH, so pass 1 minted `__tuple<integer,unknown>` and pass 2 asked for
//    `__tuple<integer,Q>` — two defs for one shape, reported as an internal compiler error
//    by the H5 cross-pass guard. It now refuses to mint one until the members are final,
//    which makes the mint pass-2-only for the same reason `map`'s output wrapper is.
//
// 2. Everything that stores a type froze the pass-1 stub. `set_returned` runs on pass 1
//    only, and the variable table is pre-populated there, so `-> (integer, Q)` held
//    `(integer, unknown)` while its body produced `(integer, Q)`. `resolve_adopted_stubs`
//    now points those at the real type once every declaration has been seen — driven by
//    stubs RECORDED at adoption, because after the fact an adopted stub is
//    indistinguishable from a generic's type VARIABLE, and sweeping those rewrote
//    `vector<T>` and took the whole stdlib down.
//
// Underneath both: `Type::is_unknown()` answers for a bare `Unknown` and a vector of one,
// not for an unresolved member nested inside a wrapper. Six separate guards asked it and
// got "no" for `(integer, unknown)` — the same shape `&unknown` (#375) and `Never` (#376)
// had already needed their own arms for. They now ask `Data::type_has_unresolved`, which
// walks children through `Type::for_each_child`.
//
// One shape is NOT fixed and is refused instead: a tuple RETURN naming a type declared
// below it. Promoting that between the passes gets the signature right and still
// miscompiles — the synthetic struct is minted after pass 1's `fill_all`, so it has no
// layout while pass 2 parses the bodies that read it and every offset lands as `u16::MAX`.
// It now reports "move the declaration of `Q` above `mk`" rather than an internal compiler
// error, and rather than the interpreter-runs / `--native`-reads-0 split that removing the
// ICE alone produced. `tests/scripts/944b-*` pins the message.
//
// c9-c12 are controls: a forward reference in a vector, a plain local, a return type and a
// parameter all worked BEFORE this change and must keep working — the sweep is the part
// most able to break them.

fn r944_mk() -> Q944 { Q944 { n: 82 } }

// c6 — a tuple PARAMETER naming a type declared below: one of the two shapes that was an
//      internal compiler error.  (The other, a tuple RETURN, is refused — see the header.)
fn r944_take(t: (integer, Q944)) -> integer { t.1.n }

fn main() {
  // c1 — a declared tuple local whose member is declared below.
  c1: (integer, Q944) = (71, Q944 { n: 82 });
  assert(c1.0 == 71, "c1 first = {c1.0}, want 71");
  assert(c1.1.n == 82, "c1 member = {c1.1.n}, want 82");

  // c2 — the same with the value reached through a LOCAL rather than a literal. The two
  //      arrive with different unresolved spellings (`unknown(708)` vs `unknown(0)`), and
  //      the refusal named one type twice: "cannot change type from (integer, unknown) to
  //      (integer, unknown)".
  q2: Q944 = Q944 { n: 82 };
  c2: (integer, Q944) = (71, q2);
  assert(c2.1.n == 82, "c2 member = {c2.1.n}, want 82");

  // c3 — no declared type at all: the tuple's type is inferred from a local of a
  //      forward-declared struct.
  q3: Q944 = Q944 { n: 93 };
  c3 = (71, q3);
  assert(c3.1.n == 93, "c3 member = {c3.1.n}, want 93");

  // c4 — a vector whose ELEMENT type names the forward reference, declared and inferred.
  //      Both aborted the compile in pass 1 with a Fatal "cannot build this record", before
  //      pass 2 could re-check against the resolved element.
  c4: vector<(integer, Q944)> = [(71, Q944 { n: 82 })];
  assert(len(c4) == 1, "c4 len = {len(c4)}, want 1");
  assert(c4[0].1.n == 82, "c4 member = {c4[0].1.n}, want 82");
  c4i = [(71, Q944 { n: 104 })];
  assert(c4i[0].0 == 71, "c4i first = {c4i[0].0}, want 71");
  assert(c4i[0].1.n == 104, "c4i member = {c4i[0].1.n}, want 104");

  // c6 — the tuple-parameter ICE, called.
  assert(r944_take((71, Q944 { n: 82 })) == 82, "c6 = {r944_take((71, Q944 { n: 82 }))}, want 82");

  // c7 — a nested tuple, so the inner shape registers through the same deferral.
  c7: ((integer, Q944), integer) = ((71, Q944 { n: 82 }), 93);
  assert(c7.0.1.n == 82, "c7 inner member = {c7.0.1.n}, want 82");
  assert(c7.1 == 93, "c7 outer = {c7.1}, want 93");

  // c8 — the value from a CALL rather than a literal; this one always worked, and pins that
  //      the deferral did not disturb it.  Read through a local, because the direct form
  //      `(71, r944_mk())` LEAKS the callee's store — a separate, pre-existing defect that
  //      reproduces with the struct declared first and on released 2026.8.0 (loft#946).
  q8: Q944 = r944_mk();
  c8: (integer, Q944) = (71, q8);
  assert(c8.1.n == 82, "c8 member = {c8.1.n}, want 82");

  // c9 (control) — a forward reference in a VECTOR, which never needed any of this.
  c9: vector<Q944> = [Q944 { n: 71 }];
  assert(c9[0].n == 71, "c9 = {c9[0].n}, want 71");

  // c10 (control) — a forward reference as a plain local type.
  c10: Q944 = Q944 { n: 71 };
  assert(c10.n == 71, "c10 = {c10.n}, want 71");

  // c11 (control) — a forward reference as a bare return type.
  assert(r944_mk().n == 82, "c11 = {r944_mk().n}, want 82");

  // c12 (control) — a tuple with NO forward reference, declared and inferred. The deferral
  //       must not delay a tuple whose members were resolvable all along.
  c12: (integer, integer) = (71, 82);
  assert(c12.1 == 82, "c12 = {c12.1}, want 82");
  c12i = (93, 104);
  assert(c12i.0 == 93, "c12i = {c12i.0}, want 93");

  println("944 ok");
}

struct Q944 { n: integer }
