// @EXPECT_WARNING: the leading `-` binds to `x` as a sign (tighter than `**`)
// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// @PLN102 pre-freeze — `**` vs a leading `-`.  loft keeps its uniform rule: a unary
// prefix binds tighter than any binary op, so the `-` is the SIGN of its operand and
// `-a ** b` is `(-a) ** b`, NOT the Python/maths `-(a ** b)`.  For a LITERAL base this
// matches "-2 is a number" and is unsurprising → silent.  For a non-literal base
// (`-x ** y`) the `-` reads as an operator on a subexpression → a WARNING nudges the
// author to parenthesise.  The grammar itself is unchanged (no special-case precedence).

fn main() {
  x = 3;

  // --- literal base: SILENT (a signed number), (-2)**2 = 4 ---
  assert(-2**2 == 4, "literal: -2 ** 2 parses as (-2)**2 = 4");
  assert(-2.0**2.0 == 4.0, "float literal base is silent too");

  // --- parenthesised: unambiguous, SILENT ---
  assert((-x)**2 == 9, "(-x) ** 2 = 9");
  assert(-(x**2) == -9, "-(x ** 2) = -9");

  // --- non-literal base: WARNS (the @EXPECT_WARNING above); still parses (-x)**2 = 9 ---
  assert(-x**2 == 9, "-x ** 2 parses as (-x)**2 = 9 (the sign binds tighter than **)");

  print("pln102 pow/neg precedence: uniform rule kept, warning on non-literal base\n");
}
