// loft#500 regression guard — native E0308 (Str vs String) on a nested-ncc
// optional-text VECTOR return. `(v[0] ?? default).tag ?? "none"` allocates a store
// in the ncc, so scopes::free_vars inserts the Set+free+Return dance INSIDE the
// ncc block; the block then ends in `return …` but is not itself a Return node.
// The block-tail materialiser's `.unspan()`-only divergence check missed it, so it
// emitted `let _ret = { … return … }; Str::new(_ret)` — a dead, wrong-typed (`Str`
// vs the `-> String` signature) tail. Found by the @PLN89 differential oracle;
// fixed by extending the check to `.tail()`. Must compile + run on BOTH backends.
struct Slot { id: integer, tag: text? }

fn first_tag(v: vector<Slot>) -> text { (v[0] ?? Slot { id: 0, tag: "?" }).tag ?? "none" }

// the non-vector twin (already compiled — kept so the guard pins both)
fn direct_tag(s: Slot) -> text { s.tag ?? "none" }

fn main() {
    a = first_tag([Slot { id: 1, tag: null }]);
    b = first_tag([Slot { id: 2, tag: "gold" }]);
    c = first_tag([]);
    assert(a == "none", "null-tag {a}");
    assert(b == "gold", "present-tag {b}");
    assert(c == "none", "empty-vec {c}");
    assert(direct_tag(Slot { id: 3, tag: null }) == "none", "direct null");
    assert(direct_tag(Slot { id: 4, tag: "silver" }) == "silver", "direct present");
    println("500-nested-ncc-optional-text-return ok");
}
