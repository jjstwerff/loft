//
// The same element, reached three ways.  Only two of them are a mutation the caller can
// see, and before this nothing at the call site said which was which (loft#894).
//
//   hurt(first(s), 10.0);          // 0  — the write is LOST
//   hurt(s.es[0] ?? E {}, 10.0);   // 10 — lands
//   for e in s.es { hurt(e, 10.0); }  // 20 — lands
//
// Returning a struct hands back a COPY (C86), which lives in a temporary freed at the end
// of the statement, so `hurt` writes the copy and the element keeps the value it had.
// Value semantics for a returned struct is defensible on its own; the silence was not.
// Found in dryopea while giving enemies HP: six tests failed at once, and every one read
// as a bug in the thing being mutated rather than in the one-line accessor, because the
// read-back is simply the value from before the call.
//
// So this guards a DIAGNOSTIC, not a semantics change — the numbers below are the same
// ones the issue reported, and they stay that way.
//
// The lint needs two facts to meet: the callee writes through the parameter, and the
// argument is a copy of a place the caller can still reach.  Requiring the second is what
// separates a lost write from a merely pointless one, and the accepted half of this file
// is the guard on that — a false warning on the builder idiom (write the parameter and
// return it) would be worse than the silence it replaces.
//
// @EXPECT_WARNING: `hurt` writes to `e`, but the argument here is a value RETURNED by a call

struct E { q: integer, taken: float }
struct S { es: vector<E> }

// Reads an element OUT of `s` and returns it — so its return type carries a dep on `s`,
// which is what says the value handed back is a copy of something the caller still has.
fn first(s: S) -> E { s.es[0] ?? E {} }

fn hurt(e: E, hp: float) { e.taken = e.taken + hp; }

// Builds its result from nothing.  A write into THIS value loses no data that existed
// before the call, so it must stay silent — pointless is not the same as lost.
fn fresh() -> E { E { q: 9, taken: 0.0 } }

// The builder idiom: write the parameter, then hand it back.  The write is delivered
// through the return value, so this must stay silent however it is called.
fn stamp(e: E, hp: float) -> E { e.taken = e.taken + hp; e }

fn r894_new() -> S {
  s = S { es: [] };
  s.es += [E { q: 1, taken: 0.0 }];
  s
}

fn main() {
  // The reported shape — the one row that warns.
  s = r894_new();
  hurt(first(s), 10.0);
  assert((s.es[0] ?? E {}).taken == 0.0, "a write through a returned struct is lost");

  // The same write, reached ways that DO land.  Neither may warn.
  s2 = r894_new();
  hurt(s2.es[0] ?? E {}, 10.0);
  assert((s2.es[0] ?? E {}).taken == 10.0, "an indexed element is written through");

  s3 = r894_new();
  for e in s3.es { hurt(e, 10.0); }
  assert((s3.es[0] ?? E {}).taken == 10.0, "a loop variable is written through");

  // Bound to a local first: the copy is still readable, so this is a question about
  // copies rather than a lost write, and it stays silent.
  s4 = r894_new();
  e4 = first(s4);
  hurt(e4, 10.0);
  assert(e4.taken == 10.0, "the bound copy carries the write");
  assert((s4.es[0] ?? E {}).taken == 0.0, "…and the source does not");

  // A freshly built value: nothing existed to lose, so no warning.
  hurt(fresh(), 10.0);

  // The builder idiom, including the nested form where the inner call feeds the outer
  // one — the shape that a first cut of this lint reported and must not.
  stamped = stamp(fresh(), 5.0);
  assert(stamped.taken == 5.0, "a builder delivers its write through the return value");
  twice = stamp(stamp(fresh(), 5.0), 5.0);
  assert(twice.taken == 10.0, "a nested builder delivers both writes");

  println("894-lost-write-through-returned-struct ok");
}
