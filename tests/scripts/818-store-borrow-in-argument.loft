// An argument that borrows the store, inside a call that already borrowed it.
//
// Rust evaluates a method call's RECEIVER PLACE before its arguments, so a `#rust`
// template shaped `stores.method(@count)` holds `&mut *stores` while `@count` runs.
// `/` and `%` expand to a divide-by-zero guard that calls a `&mut Stores` method, so
// `reserve(h, n / 2)` emitted two live mutable borrows and rustc rejected the whole
// generated function (E0499).  `--interpret` was correct throughout; only `--native`
// could see it (loft#818), and `native_scripts` is what makes this file see it too.
//
// THE POINT OF THE FILE IS THE SHAPE, NOT `reserve`.  The same defect had already
// been hand-patched into two other templates one at a time — `OpGetVector` (@P321d),
// then its index (@P338) — each by writing `{let __x = @arg; …}` into
// `default/01_code.loft`.  The producer is the GENERATOR, so the cure lives there and
// these cells are what says so: `reserve` is the reported one, and the rest reach the
// same emitter through different templates.  A per-template patch passes the first
// cell and leaves the class open.
//
// WHY THE CONTROL CELLS ARE HERE.  `*` and a plain call emit no guard, so they
// compiled before and must keep compiling — a fix that hoisted nothing fails the div
// cells, and one that hoisted wrongly (evaluating an argument out of order, moving a
// value, or borrowing a temporary) shows up as a NEW failure in these.  Every cell
// asserts a VALUE, on both backends: the fix must not change a single answer, and a
// cell that merely compiles is not a pass.

struct B818 { k: integer, v: integer }

fn sz(x: integer) -> integer { x }

fn main() {
  n = 10;

  // The reported case, and the two operators that emit the guard.
  a: hash<B818[k]> = [];
  reserve(a, n / 2);
  a += B818 { k: 1, v: 2 };
  assert(len(a) == 1, "reserve with `/`: len {len(a)}");

  b: hash<B818[k]> = [];
  reserve(b, n % 3);
  b += B818 { k: 1, v: 2 };
  assert(len(b) == 1, "reserve with `%`: len {len(b)}");

  // Nested, so the guard is not the outermost node of the argument.
  c: hash<B818[k]> = [];
  reserve(c, (n / 2) % 3);
  c += B818 { k: 1, v: 2 };
  assert(len(c) == 1, "reserve with a nested guard: len {len(c)}");

  // A guard reached through a VECTOR INDEX rather than through an operator —
  // `v[i]` calls a `&mut Stores` bounds-check helper for the same reason.
  ix: vector<integer> = [4, 5];
  d: hash<B818[k]> = [];
  reserve(d, ix[n % 2]);
  d += B818 { k: 1, v: 2 };
  assert(len(d) == 1, "reserve with an indexed count: len {len(d)}");

  // The forms that always worked, as controls.
  e: hash<B818[k]> = [];
  reserve(e, n);
  reserve(e, n * 3);
  reserve(e, sz(n));
  e += B818 { k: 1, v: 2 };
  assert(len(e) == 1, "reserve with an inert count: len {len(e)}");

  // The vector twin, immune because its template takes the store LAST. It must
  // stay immune — the fix touches the shared emitter, not one template.
  w: vector<integer> = [];
  reserve(w, n / 2);
  w += [7];
  assert(len(w) == 1, "vector reserve with `/`: len {len(w)}");

  // A dividing KEY, not a dividing count: the same hazard one argument along.
  k: hash<B818[k]> = [];
  k += B818 { k: 5, v: 42 };
  hit = k[n / 2] ?? B818 { k: 0, v: 0 };
  assert(hit.v == 42, "keyed lookup with `/`: {hit.v}");

  // A dividing value written THROUGH a record field, which reaches the emitter
  // via `OpSetInt` instead of through a collection builtin.
  rec = B818 { k: 1, v: 0 };
  rec.v = n / 2;
  assert(rec.v == 5, "field write with `/`: {rec.v}");

  // A dividing index into a vector and into a text — the @P321d / @P338 shapes,
  // here to say the earlier hand-patches still hold under the general fix.
  vv: vector<integer> = [9, 8, 7];
  assert(vv[n / 5] == 7, "vector index with `/`: {vv[n / 5]}");
  s = "abcdef";
  ch = s[n / 5] ?? '?';
  assert(ch == 'c', "text index with `/`: {ch}");

  // The workaround the issue documents, so it cannot rot.
  cnt = n / 2;
  f: hash<B818[k]> = [];
  reserve(f, cnt);
  f += B818 { k: 1, v: 2 };
  assert(len(f) == 1, "the documented workaround: len {len(f)}");
}
