// @PLN90 phase B move-elision: the retargeted build must not overtake a statement that
// touches the destination it was retargeted INTO.
//
// `move_rewrite` transfers a dead-after owned source into its copy destination: it drops the
// source's `OpDatabase` / `OpCopyRecord` / `OpFreeRef` and retargets the source's CONSTRUCTION
// ops onto the destination slot.  The destination is therefore written at the CONSTRUCTION's
// position rather than at the copy's — a REORDER, and sound only while nothing in between
// touches that slot.
//
// `collect_move_dest`'s guards all ask whether the destination is a STABLE container
// (`bad_containers`, a compiler temp, `def_order`).  None of them asked whether it is READ, so:
//
//     for p in v { held = Tg { name: p.0.name }; p.0 = p.1; p.1 = held; }
//
// put `held`'s build into `p.1` first, and `p.0 = p.1` then copied the NEW value back — a swap
// answering `x|x` where it wants `y|x`, silently, on both backends.
//
// The cells sweep what the filed repro held FIXED, because the defect was wider than it:
//   * the intervening access is a PLAIN READ, not only a write (`seen = p.1.name`);
//   * STRAIGHT-LINE code, not only a loop body;
//   * the destination is a struct FIELD and a VECTOR ELEMENT, not only a tuple element.
// All four answered wrongly.  The last cell is the CONTROL: with nothing in between, the move
// must still elide — this is an optimisation, and a fix that simply disabled it would pass
// every other cell here.

struct MeTg { name: text }
struct MeBox { a: MeTg, b: MeTg }

// The filed shape: a write to a sibling that READS the destination.
fn test_tuple_swap_through_a_rebuilt_value() {
  v: vector<(MeTg, MeTg)> = [(MeTg { name: "x" }, MeTg { name: "y" })];
  for p in v {
    held = MeTg { name: p.0.name };
    p.0 = p.1;
    p.1 = held;
  }
  assert(v[0].0.name == "y", "tuple swap .0: {v[0].0.name}");
  assert(v[0].1.name == "x", "tuple swap .1: {v[0].1.name}");
}

// A PLAIN READ of the destination is enough — it does not have to be written.
fn test_a_plain_read_of_the_destination_sees_the_old_value() {
  v: vector<(MeTg, MeTg)> = [(MeTg { name: "x" }, MeTg { name: "y" })];
  for p in v {
    held = MeTg { name: "n" };
    seen = p.1.name;
    p.1 = held;
    assert(seen == "y", "the read saw the retargeted build: {seen}");
  }
  assert(v[0].1.name == "n", "the write did not land: {v[0].1.name}");
}

// Straight-line, no loop.
fn test_straight_line_swap() {
  o = MeBox { a: MeTg { name: "x" }, b: MeTg { name: "y" } };
  held = MeTg { name: o.a.name };
  o.a = o.b;
  o.b = held;
  assert(o.a.name == "y", "straight .a: {o.a.name}");
  assert(o.b.name == "x", "straight .b: {o.b.name}");
}

// Destination is a struct FIELD.
fn test_struct_field_destination() {
  o = MeBox { a: MeTg { name: "x" }, b: MeTg { name: "y" } };
  held = MeTg { name: "n" };
  o.a = o.b;
  o.b = held;
  assert(o.a.name == "y", "field .a: {o.a.name}");
  assert(o.b.name == "n", "field .b: {o.b.name}");
}

// Destination is a VECTOR ELEMENT.
fn test_vector_element_destination() {
  w: vector<MeTg> = [MeTg { name: "x" }, MeTg { name: "y" }];
  held = MeTg { name: "n" };
  w[0] = w[1];
  w[1] = held;
  assert(w[0].name == "y", "elem 0: {w[0].name}");
  assert(w[1].name == "n", "elem 1: {w[1].name}");
}

// THE CONTROL — nothing between the build and the copy, so the move must still be taken.
// A fix that disabled the elision outright passes every cell above and fails the point of
// the optimisation; this cell is what keeps that honest.  (`LOFT_MOVE_ELIDE=1` shows the plan;
// the rewrite itself is visible as the absence of `held`'s OpDatabase/OpCopyRecord in
// `loft introspect`.)
fn test_the_clean_move_still_elides() {
  o = MeBox { a: MeTg { name: "x" }, b: MeTg { name: "y" } };
  held = MeTg { name: "fresh" };
  o.b = held;
  assert(o.b.name == "fresh", "clean move: {o.b.name}");
  assert(o.a.name == "x", "clean move disturbed the sibling: {o.a.name}");
}

// Building FROM the container INTO it stays elidable: the source's own construction ops are
// what the rewrite retargets, so they are not a disturbance.  Without that carve-out the fix
// would refuse this shape too.
fn test_build_from_the_container_into_it() {
  o = MeBox { a: MeTg { name: "src" }, b: MeTg { name: "y" } };
  held = MeTg { name: o.a.name };
  o.b = held;
  assert(o.b.name == "src", "build-from-container: {o.b.name}");
  assert(o.a.name == "src", "the source field changed: {o.a.name}");
}

// ── The same hole in the CONSTRUCT shape (`x.field += src`, `OpAppendVector`) ─────────────
//
// B1.3b guards the SOURCE being read between its build and the move (`escaping` /
// `source_escapes`) and never guarded the DESTINATION — the identical asymmetry the Record
// shape had.  Both shapes now read ONE predicate, because two copies of one rule is the shape
// loft#1006 was.
//
// The append cell is a silent-wrong; the loop cell is worse than that.

struct MeBag { v: vector<integer>, n: integer }

// A read of the destination between the source's build and the append saw the POST-append
// state: `seen` reported 3 for a vector that held 2 elements when it was read.
fn test_a_read_before_an_append_sees_the_pre_append_state() {
  b = MeBag { v: [1, 2], n: 0 };
  tmp: vector<integer> = [];
  tmp += [9];
  seen = len(b.v);
  b.v += tmp;
  assert(seen == 2, "the read saw the retargeted append: {seen}");
  assert(len(b.v) == 3, "the append did not land: {b.v}");
  assert((b.v[2] ?? 0) == 9, "appended value: {b.v}");
}

// Building the source by ITERATING the destination.  The retarget pointed the loop's appends
// at the vector the loop was walking, so it grew without bound: SIGABRT on `--interpret`, and
// on `--native` a `store offset overflow: requested 2203149353 words`.  A time bound does not
// bound memory (CLAUDE.md), which is why this one is a guard and not a note.
fn test_appending_a_vector_built_by_iterating_it() {
  c = MeBag { v: [1, 2], n: 0 };
  doubled: vector<integer> = [];
  for x in c.v { doubled += [x * 10]; }
  c.v += doubled;
  assert(len(c.v) == 4, "length after append: {len(c.v)}");
  assert((c.v[0] ?? 0) == 1, "c.v[0]: {c.v}");
  assert((c.v[2] ?? 0) == 10, "c.v[2]: {c.v}");
  assert((c.v[3] ?? 0) == 20, "c.v[3]: {c.v}");
}

// The whole-vector REPLACE built by iterating the same field — B1.3d's own territory, which
// already carried this guard (`try_replace_one`: "base's BUILD must not read the destination
// container").  Pinned here beside its two siblings so the three cannot drift apart.
fn test_replacing_a_field_with_a_vector_built_from_it() {
  d = MeBag { v: [1, 2, 3], n: 0 };
  kept: vector<integer> = [];
  for x in d.v { if x != 2 { kept += [x]; } }
  d.v = kept;
  assert(len(d.v) == 2, "replace length: {d.v}");
  assert((d.v[0] ?? 0) == 1, "replace [0]: {d.v}");
  assert((d.v[1] ?? 0) == 3, "replace [1]: {d.v}");
}

// CONTROL for the append shape: nothing between, so the move must still be taken.
fn test_the_clean_append_still_elides() {
  b = MeBag { v: [1], n: 0 };
  tmp: vector<integer> = [];
  tmp += [7, 8];
  b.v += tmp;
  assert(len(b.v) == 3, "clean append: {b.v}");
  assert((b.v[1] ?? 0) == 7, "clean append [1]: {b.v}");
}
