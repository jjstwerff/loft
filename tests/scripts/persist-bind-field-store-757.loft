//
// loft#757 — `store_persist_bind(x, path)` persists the whole STORE `x` lives in,
// and a keyed collection reached through a struct FIELD shares its container's
// store.  So binding a field writes a file for the CONTAINER, holding every
// sibling collection with it, and that file does not load back into a bare
// collection of the field's type.
//
// The records are never damaged and the binding program reads its own output
// perfectly, which is why this stayed invisible until a different program in the
// same pipeline tried to load the file.  Pinned here so the two shapes stay
// distinguishable, and so the advice at the call site keeps firing.
//
// The two stores are written under `temp_dir()`, not beside the source.  A
// cwd-relative name put them in the repository root, where they were committed
// by accident and then rewritten by every suite run — so `git status` was dirty
// after each one and the churn kept riding along in unrelated commits.  Deleting
// them at the end is not enough on its own: a run that fails an assertion above
// never reaches the cleanup, and a regression test is exactly the thing that is
// expected to fail one day.  Writing outside the tree makes that harmless.

struct Rec  { const k: integer, v: integer }
struct Oth  { const j: integer }
struct Wrap { recs: hash<Rec[k]>, other: hash<Oth[j]> }

fn main() {
  tmp = temp_dir();
  assert(tmp != null, "temp_dir is where this test's stores go");
  bare = "{tmp ?? ""}/loft_bind757_bare.store";
  held = "{tmp ?? ""}/loft_bind757_held.store";
  _ = delete(bare); _ = delete("{bare}.dschema");
  _ = delete(held); _ = delete("{held}.dschema");

  // A keyed LOCAL owns its store — the file is a file for the collection.
  a: hash<Rec[k]> = [];
  for i in 0..3 { a += Rec { k: i, v: i * 10 }; }
  assert(store_persist_bind(a, bare), "binding a local collection succeeds");

  b: hash<Rec[k]> = [];
  assert(store_load(b, bare), "a local-bound store loads into its own type");
  nb = 0; vb = 0;
  for r in b { nb += 1; vb += r.v; }
  assert(nb == 3, "all records come back through the collection, got {nb}");
  assert(vb == 30, "and carry their values, got {vb}");

  // A keyed FIELD shares its container's store, so this writes a Wrap file.
  // @EXPECT_WARNING: a collection reached through a field shares its container's store
  w = Wrap { recs: [], other: [] };
  for i in 0..3 { w.recs += Rec { k: i, v: i }; }
  w.other += Oth { j: 9 };
  assert(store_persist_bind(w.recs, held), "binding a field also succeeds");

  // It round-trips through the CONTAINER — the file is intact, just not a
  // file for `hash<Rec[k]>`.
  w2 = Wrap { recs: [], other: [] };
  assert(store_load(w2, held), "a field-bound store loads through its container");
  nw = 0; vw = 0;
  for r in w2.recs { nw += 1; vw += r.v; }
  assert(nw == 3, "the container's records are undamaged, got {nw}");
  assert(vw == 3, "and carry their values, got {vw}");

  no = 0; jo = 0;
  for o in w2.other { no += 1; jo += o.j; }
  assert(no == 1, "the SIBLING collection travelled with it, got {no}");
  assert(jo == 9, "intact, got {jo}");

  _ = delete(bare); _ = delete("{bare}.dschema");
  _ = delete(held); _ = delete("{held}.dschema");
}
