//
// @PLN85 / Cluster-A.4 — regression guard (graduated from the A.0
// return-ownership boundary matrix). The "does this heap return BORROW a visible
// parameter?" fact (is_borrowed_view) is now computed ONCE in
// Definition::returns_borrowed_view() and read by BOTH backends, instead of being
// derived three times (interp state/codegen.rs x2, native generation/dispatch.rs).
// These cells exercise every edge the unified query must answer identically on
// both backends: a borrow-of-param return must COPY (caller owns its own store),
// an owned/fresh return must ADOPT (and stay distinct across calls), and a
// field-of-param return must COPY. Value semantics + no leak, BOTH backends.

struct Pt { x: integer }
struct Box { v: vector<integer> }

// explicit borrow-of-param return → caller copies
fn idr(v: vector<integer>) -> vector<integer> { return v; }
// owned fresh vector return → caller adopts; two calls stay distinct
fn mk(n: integer) -> vector<integer> { return [n, n]; }
// struct param return (Reference borrowed view) → caller copies
fn ids(s: Pt) -> Pt { return s; }
// owned fresh struct return → caller adopts
fn mkpt(n: integer) -> Pt { return Pt { x: n }; }
// field-of-param return (implicit tail) → caller copies (#415)
fn getv(b: Box) -> vector<integer> { b.v }

fn main() {
  // borrow-of-param vector return must COPY (not alias the arg)
  x: vector<integer> = [1, 2, 3];
  a = idr(x);
  x += [9];
  assert(len(a) == 3, "idr(x) borrow-return must COPY (a.len 3)");
  assert(len(x) == 4, "x mutated to 4");

  // reassignment from a borrow-return must also COPY
  r: vector<integer> = [0];
  y: vector<integer> = [5, 6, 7];
  r = idr(y);
  y += [9];
  assert(len(r) == 3, "reassign r = idr(y) must COPY (r.len 3)");

  // owned vector return: two calls stay DISTINCT (adopt, no recycle-alias)
  p = mk(1);
  q = mk(2);
  assert(p[0] == 1, "mk(1)[0] == 1");
  assert(q[0] == 2, "mk(2)[0] == 2 (distinct from p)");
  assert(len(p) == 2, "mk owns a 2-elem vector");

  // struct param return must COPY (mutating the source leaves the copy intact)
  s = Pt { x: 1 };
  c = ids(s);
  s.x = 9;
  assert(c.x == 1, "ids(s) struct borrow-return must COPY (c.x 1)");

  // owned struct return: two calls stay distinct
  sa = mkpt(1);
  sb = mkpt(2);
  assert(sa.x == 1, "mkpt(1).x == 1");
  assert(sb.x == 2, "mkpt(2).x == 2 (distinct)");

  // field-of-param return must COPY
  by = Box { v: [1, 2, 3] };
  ag = getv(by);
  by.v += [9];
  assert(len(ag) == 3, "getv(by) field-return must COPY (ag.len 3)");
}
