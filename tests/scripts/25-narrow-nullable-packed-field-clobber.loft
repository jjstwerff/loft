// @PLN25 deferred (HIGHER prio — silent corruption): in a struct with several narrow-
// nullable fields, writing null to one clobbers a sibling. Tracks the packed-representation
// bug; both backends identical. See plans/25-nullable-sequences/narrow-nullable-representation.md.
// @EXPECT_FAIL: packed-clobber
struct Multi { a: i8?, b: u8? }
fn main() {
  m = Multi { a: 5, b: 20 };
  m.a = null;
  assert(m.b == 20, "packed-clobber: sibling field b changed to {m.b} after m.a=null");
}
