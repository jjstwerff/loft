// @PLN25 — writing null to a narrow-nullable field must NOT clobber a sibling.
// Store::set_byte/set_short wrote the null sentinel via a bare `255`/`0` literal that
// inferred i32, so addr_mut::<i32> wrote 4 bytes and zeroed the adjacent packed fields
// (silent corruption). Fixed with the u8/u16 suffix. Regression, both backends.
struct Bytes { a: i8?, b: u8?, c: i8? }
struct Shorts { a: u16?, b: u16? }
struct Mixed { a: u8?, b: u16?, c: i8? }
fn main() {
  m = Bytes { a: 5, b: 20, c: 9 };
  m.a = null;
  assert(m.b == 20, "byte: sibling b clobbered = {m.b}");
  assert(m.c == 9,  "byte: sibling c clobbered = {m.c}");
  m.b = null;
  assert(m.c == 9,  "byte: c clobbered by m.b=null = {m.c}");
  s = Shorts { a: 5, b: 2000 };
  s.a = null;
  assert(s.b == 2000, "short: sibling b clobbered = {s.b}");
  x = Mixed { a: 5, b: 2000, c: 9 };
  x.a = null;
  assert(x.b == 2000, "mixed: b clobbered = {x.b}");
  assert(x.c == 9,    "mixed: c clobbered = {x.c}");
}
