//
// loft#1005 — passing a tuple VARIABLE with a text element refused to compile on `--native`:
// the generated parameter was `(i64, &str)` while the caller's local was `(i64, String)`.
//
// `text` spells `String` in a variable slot and `&str` in a parameter (`rust_type`), and
// nothing reconciled the two across a call.  A tuple LITERAL argument is emitted in place,
// so it already spelled `&str` and compiled — which is what made this narrow, and what
// pointed at the seam.  The interpreter, which has no owned/borrowed split, ran both.
//
// Closed at the call site by borrowing each text leaf (`&*place`, which derefs `String`,
// `Str` and `&str` alike) rather than by cloning: a by-value tuple parameter is a COPY in
// loft, so the callee cannot write back through it, and the call stays allocation-free.
//
// The NESTED parameter is the same fact one level in: `p: ((integer, text), text)` reaches
// its inner tuple as a tuple-get of a parameter, which the whole-parameter rule (loft#840)
// did not see, so reading it into an owned slot was the identical mismatch.

fn t1005_int_txt(p: (integer, text)) -> text { "{p.0}/{p.1}" }
fn t1005_txt_int(p: (text, integer)) -> text { "{p.0}/{p.1}" }
fn t1005_txt_txt(p: (text, text)) -> text { "{p.0}/{p.1}" }
fn t1005_three(p: (integer, text, single)) -> text { "{p.0}/{p.1}/{p.2}" }
fn t1005_nested(p: ((integer, text), text)) -> text { "{p.0.0}/{p.0.1}/{p.1}" }
fn t1005_pass(p: (integer, text)) -> text { t1005_int_txt(p) }

fn test_tuple_variable_with_text_reaches_a_parameter() {
  a: (integer, text) = (3, "three");
  assert(t1005_int_txt(a) == "3/three", "a tuple local with a text element passes by name");
  // The literal form is the control — it compiled before and must still answer the same.
  assert(t1005_int_txt((3, "three")) == "3/three", "the same tuple as a literal argument");
}

fn test_text_in_every_position() {
  b: (text, integer) = ("bee", 7);
  assert(t1005_txt_int(b) == "bee/7", "text first");
  c: (text, text) = ("x", "y");
  assert(t1005_txt_txt(c) == "x/y", "text in both slots");
  d: (integer, text, single) = (1, "mid", 2.5f);
  assert(t1005_three(d) == "1/mid/2.5", "text between two scalars");
}

fn test_nested_tuple_parameter() {
  e: ((integer, text), text) = ((9, "in"), "out");
  assert(t1005_nested(e) == "9/in/out", "a nested tuple parameter reads both levels");
}

fn test_the_argument_survives_the_call() {
  a: (integer, text) = (3, "three");
  assert(t1005_pass(a) == "3/three", "a tuple parameter passes on to another call");
  // Borrowed, not moved: the caller's tuple is still readable and still callable.
  assert(a.0 == 3, "the integer element survives");
  assert(a.1 == "three", "the text element survives");
  assert(t1005_int_txt(a) == "3/three", "and the same local passes a second time");
}

fn test_all_scalar_tuple_unchanged() {
  // The control: no text leaf, so nothing is re-spelled.
  s: (integer, integer) = (3, 4);
  assert(t1005_scalar(s) == 7, "an all-scalar tuple parameter is untouched");
}

fn t1005_scalar(p: (integer, integer)) -> integer { p.0 + p.1 }
