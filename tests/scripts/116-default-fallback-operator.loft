//
// @PLN116 — the postfix default-fallback operator `x?`.  `x? : T` discharges a
// nullable `x: T?` to `T` by falling back to `T`'s default when `x` is null —
// pure sugar for `x ?? construct_default(T)`, sharing ONE `has_default` /
// `build_default` predicate with the `S{}` zero value (Goal E: one home per fact).
// This is the graduated Stage-A composition matrix: every operand type, present
// vs null, chaining, and the load-bearing "S{} vs x? agreement" cell — all green
// on BOTH backends (the leak gate in run_test also asserts no store leaks).
enum Color { Red, Green, Blue }
struct Point { x: integer, y: integer }
struct Scal { i: integer?, f: float?, s: single?, b: boolean?, ch: character?, t: text?, c: Color? }

fn colname(c: Color) -> text {
  match c { Red => "Red", Green => "Green", Blue => "Blue", _ => "NULL" }
}

fn main() {
  // scalar / enum defaults via Optional (a nullable field)
  z = Scal { i: null, f: null, s: null, b: null, ch: null, t: null, c: null };
  assert(z.i? == 0, "int? -> 0");
  assert(z.f? == 0.0, "float? -> 0.0");
  assert(z.s? == 0.0, "single? -> 0.0");
  assert(z.b? == false, "bool? -> false");
  assert(z.ch? == '\0', "char? -> nul");
  assert(z.t? == "", "text? -> empty");
  assert(colname(z.c?) == "Red", "enum? -> first-defined variant Red");

  // present values keep their value (never the default)
  p = Scal { i: 7, f: 2.5, s: 1.0f, b: true, ch: 'q', t: "hi", c: Color.Blue };
  assert(p.i? == 7, "int present kept");
  assert(p.f? == 2.5, "float present kept");
  assert(p.ch? == 'q', "char present kept");
  assert(p.t? == "hi", "text present kept");
  assert(colname(p.c?) == "Blue", "enum present kept");

  // scalar default via an integer division-by-zero fault (integer? -> 0)
  a: integer = 5;
  b0: integer = 0;
  assert((a / b0)? == 0, "div-zero int? -> 0");

  // record default via a vector out-of-bounds null (S{} with every field defaulted)
  ps: vector<Point> = [Point { x: 3, y: 4 }];
  q = ps[9]?;
  assert(q.x == 0 && q.y == 0, "struct OOB -> empty struct");
  assert(ps[0]?.x == 3, "struct present + x?.field chain");

  // collection default via a nested-vector OOB null — a REAL, appendable empty
  vv: vector<vector<integer>> = [[1, 2]];
  e = vv[9]?;
  assert(e.len() == 0, "vec OOB -> empty");
  e += [7];
  assert(e.len() == 1 && e[0] == 7, "vec default is appendable");
  assert(vv[0]?.len() == 2, "vec present kept");

  // LOAD-BEARING CELL — `S{}` and `x?` produce the identical value for one type
  built = Point {};
  defaulted = ps[9]?;
  assert(built.x == defaulted.x && built.y == defaulted.y, "S-empty == x-op agreement");

  // operator interaction: `x? ?? y` and the greedy `a ?? (b?)` lex
  assert(((a / b0)? ?? 99) == 0, "x? then ?? y");
  cs: vector<integer> = [10, 20];
  assert((cs[9] ?? cs[0]?) == 10, "greedy a ?? (b?)");

  print("PLN116 x? matrix OK");
}
