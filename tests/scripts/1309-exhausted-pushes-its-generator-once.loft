//
// loft#1309 — `exhausted(gen)` pushes its generator handle ONCE.
//
// `generate_call` has a special case for the coroutine ops, introduced because they "take a
// gen DbRef from the stack at runtime, but their declarations have only const params".  That
// is true of `OpCoroutineNext`, whose `value_size: const u16` the mutable-argument loop skips.
// It is NOT true of `OpCoroutineExhausted`, declared `(gen: reference) -> boolean`: the loop
// generates that argument, and the special case generated it a SECOND time.  Only one push was
// consumed, so every call stranded 16 bytes on the eval stack.
//
// ⚠ The value is right in both states, which is why this needs a guard at all.  The surplus is
//   only NOTICED where a caller measures an argument's width — `assert(!exhausted(g), …)` under
//   debug assertions reported `expected 8B on stack but … pushed 24B`, while `d = exhausted(g)`
//   leaked the same 16 bytes with nothing to object.  So the cells below deliberately put the
//   call in ARGUMENT position, where the width check can see it; the assertions on the values
//   are necessary but not sufficient, and the debug-assertions gate is the real oracle.
//
// ⚠ The `!` in the filed title is a red herring, and so is "argument".  Measured across the
//   axes: `assert(exhausted(g) == false, …)` failed the same way with no `!` at all, and
//   `b = !exhausted(g)` failed in an ASSIGNMENT.  What decided it was whether the call was a
//   sub-expression rather than a statement-level bind — every form below is one.
//
// @falsified-at: HEAD~1 — on a debug-assertions build of the parent commit, `not_exhausted_in_an
//   _argument`, `compared_to_false_in_an_argument` and `negated_into_a_local` all abort in
//   `codegen.rs` with the 24B-vs-8B mismatch; `read_through_a_local` and `used_as_a_condition`
//   pass there, because neither reaches the width check.  A release build passes all five
//   before and after — the values never moved.

fn count_up(start: integer, stop: integer) -> iterator<integer> {
  for i in start..stop {
    yield i;
  }
}


// The filed spelling: a negated call handed to another call.
fn not_exhausted_in_an_argument() {
  g = count_up(10, 13);
  next(g);
  next(g);
  next(g);
  assert(!exhausted(g), "three values taken, the end not yet discovered");
}

// The same defect with no `!` anywhere — the operator was never the trigger.
fn compared_to_false_in_an_argument() {
  g = count_up(10, 13);
  next(g);
  next(g);
  next(g);
  assert(exhausted(g) == false, "comparison reaches the same argument slot");
}

// …and in an ASSIGNMENT, so "argument position" was not the trigger either.
fn negated_into_a_local() {
  g = count_up(10, 13);
  next(g);
  next(g);
  next(g);
  b = !exhausted(g);
  assert(b, "a negated call bound to a local answers the same");
}

// The spelling that always worked: a statement-level bind, kept as the control that says the
// fix did not simply move the fault.
fn read_through_a_local() {
  g = count_up(10, 13);
  next(g);
  next(g);
  next(g);
  d = exhausted(g);
  assert(!d, "the direct bind is unchanged");
}

// A condition rather than an argument — the other side of the same control.
fn used_as_a_condition() {
  g = count_up(10, 13);
  next(g);
  next(g);
  next(g);
  if exhausted(g) {
    assert(false, "not exhausted until one more advance runs off the end");
  }
  past_end = next(g);
  assert(past_end == null, "the advance past the last value answers null");
  assert(exhausted(g), "and only now is it exhausted");
}

// `next` is the sibling op the same special case handles, and it was never affected because
// its declaration really does carry only const params. Here so a fix that "tidies" both
// branches together has to keep this one pushing exactly once.
fn next_still_takes_its_generator_once() {
  g = count_up(1, 4);
  assert(next(g) == 1, "first");
  assert(next(g) == 2, "second");
  assert(next(g) == 3, "third");
  assert(next(g) == null, "and then the end");
}
