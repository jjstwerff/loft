//
// loft#791 — a vector local inside a GENERIC function was read with the stride
// of the type PARAMETER instead of its own element type.
//
// `substitute_type_in_value` rewrote the element size of every `OpGetVector` in
// a monomorphised body to T's stride.  That is right for a `vector<T>`, whose
// template bakes a stride of 0 precisely because the element type is not known
// yet — and wrong for every other vector in the same body.
//
// **The size of T is the whole axis, and it is why this survived.** A one-field
// struct is 8 bytes, exactly the stride of a `float`, so the substituted value
// was correct by coincidence for the shape most generic tests use. Only a WIDER
// T exposes it. So `Big` below is not decoration: with `Small` alone this test
// passes against the broken compiler.
//
// It read as data loss rather than a crash: element 0 was right, element 1 came
// back as a garbage denormal, the rest as zero — while `len()` stayed correct
// and the SAME vector passed to a non-generic helper read perfectly. A
// `vector<text>` in that position crashed outright.

interface Face { fn tag(self: Self) -> integer }

struct Small { a: integer }                                    // 8 bytes — as wide as a float
struct Big   { a: integer, b: integer, c: integer, d: text }   // wider, and the cell that fails
fn tag(self: Small) -> integer { return self.a }
fn tag(self: Big) -> integer { return self.a }

// A non-generic reader, to prove the DATA is intact and only the generic's
// access was wrong.
fn via_helper(v: vector<float>) -> float { return v[2] }

fn floats <T: Face> (t: T) -> text {
  _ = t.tag();                       // read the parameter; the BOUND is the axis
  v: vector<float> = [1.5, 2.5, 3.5];
  return "{v[0]}/{v[1]}/{v[2]}/{via_helper(v)}/{len(v)}";
}

fn ints <T: Face> (t: T) -> text {
  _ = t.tag();
  v: vector<integer> = [11, 22, 33];
  return "{v[0]}/{v[1]}/{v[2]}/{len(v)}";
}

// This one CRASHED before the fix rather than answering wrongly.
fn texts <T: Face> (t: T) -> text {
  _ = t.tag();
  v: vector<text> = ["aa", "bb", "cc"];
  return "{v[0]}/{v[1]}/{v[2]}/{len(v)}";
}

// A `vector<T>` — the case the substitution exists FOR — must keep working.
fn of_t <T: Face> (a: T, b: T) -> integer {
  v: vector<T> = [a, b];
  return v[0].tag() + v[1].tag() * 10;
}

fn main() {
  s = Small { a: 1 };
  b = Big { a: 2, b: 0, c: 0, d: "x" };

  assert(floats(s) == "1.5/2.5/3.5/3.5/3", "float vector, 8-byte T: {floats(s)}");
  assert(floats(b) == "1.5/2.5/3.5/3.5/3", "float vector, WIDE T: {floats(b)}");
  assert(ints(s) == "11/22/33/3", "integer vector, 8-byte T: {ints(s)}");
  assert(ints(b) == "11/22/33/3", "integer vector, WIDE T: {ints(b)}");
  assert(texts(s) == "aa/bb/cc/3", "text vector, 8-byte T: {texts(s)}");
  assert(texts(b) == "aa/bb/cc/3", "text vector, WIDE T: {texts(b)}");

  // The substitution still does its job where it belongs.
  assert(of_t(Small { a: 3 }, Small { a: 4 }) == 43, "vector<T> of a narrow T");
  bb = Big { a: 5, b: 0, c: 0, d: "y" };
  cc = Big { a: 6, b: 0, c: 0, d: "z" };
  assert(of_t(bb, cc) == 65, "vector<T> of a wide T");

  println("ok");
}
