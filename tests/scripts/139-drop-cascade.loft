//
// @PLN139 stages B–E — a container's death releases what it OWNS, and the value it took
// ownership of stops releasing itself. Struct fields, enum payloads and collection elements.
//
// Before this, a droppable copied into a struct field was released TWICE over: once by the
// source at its own scope end, and never by the container. Whether that read as a bug
// depended on whether the container outlived the source — inside one scope the source dies
// last anyway, so the shape looked fine, and it only bit when the container was RETURNED
// (loft#849, a use-after-free inside `sqlite3_step` for @PLN138's registry).
//
// The rule now:
//
//   A drop runs when the value's OWNER dies. Copying a droppable into a container transfers
//   ownership, so the source no longer drops and the container's death releases it.
//
// The two halves must be read together, which is why they are one file. Stage B gives every
// type that owns a droppable field a synthesized cascade (`t_<LEN><Type>_OpDropAll`) that
// runs the type's OWN hook first and then releases its fields in reverse declaration order.
// Stage C stops the source dropping — but only when something has taken over. That scoping
// is load-bearing while the stages land one at a time: a copy into a container the cascade
// cannot yet release is NOT a transfer, so its source keeps dropping and nothing is silently
// leaked in between.
//
// Stage D adds the enum: the value is a record of the VARIANT with a discriminator at its
// head, so the enum's cascade reads it once and dispatches to the variant that is present.
// A variant with nothing to release gets no arm, so a unit-only enum synthesizes nothing.
// It also needed the drop SITE widened — a struct-enum binding is a heap record exactly as a
// `Reference` one is, and reading only `Reference` there is why the cascade was synthesized
// and then never called.
//
// Stage E walks a collection's elements. A LOCAL vector needs no special case: it is backed
// by a wrapper record whose field holds the elements, so the field cascade reaches it.
//
// Container-before-fields is the RAII order and not an accident: a wrapper's own release may
// still need the resource it wraps — a connection says goodbye over the socket it is about
// to close. Cell 5 is the one that pins it.
//
// The trace is a FILE for @PLN125 arc B's reason: a drop receives only `self` and a struct
// field copies at construction, so a drop cannot write into a loft-side collection.

fn trace_path() -> text { return "loft139_cascade_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct H { id: integer }
fn OpDrop(self: H) { note("{self.id}"); }
fn mk(id: integer) -> H { return H { id: id }; }

struct S { h: H }
struct Nest { s: S }
struct Two { a: H, b: H }
struct WithHook { h: H, tag: integer }
fn OpDrop(self: WithHook) { note("outer{self.tag}"); }
struct Plain { n: integer }
enum W { WH { h: H }, WTwo { a: H, b: H }, WNone }
enum Units { UA, UB }

// 1 — a struct field, source a named local. One release, at the CONTAINER's death.
fn c1() { c = mk(1); s = S { h: c }; note("alive{s.h.id}"); }

// 2 — the same with an inline temp as the source: the transfer is detected at the LIFT,
//     since before it the IR still names the call and after it nothing records the pairing.
fn c2() { s = S { h: mk(2) }; note("alive{s.h.id}"); }

// 3 — nested. Each cascade calls the next, so depth needs no special case — and the inner
//     `S` temp must not release as well (it is a block whose tail is the work-ref, which is
//     why the source peels through a block rather than matching only a bare `Var`).
fn c3() { n = Nest { s: S { h: mk(3) } }; note("alive{n.s.h.id}"); }

// 4 — two droppable fields: reverse declaration order, matching the scope-exit free order.
fn c4() { t = Two { a: mk(4), b: mk(5) }; note("alive{t.a.id}{t.b.id}"); }

// 5 — the container has its OWN hook too. It runs BEFORE the field it owns.
fn c5() { x = WithHook { h: mk(7), tag: 6 }; note("alive{x.h.id}"); }

// 6 — THE REPORTED DEFECT: the container is RETURNED, so it outlives the source's scope.
//     This is the cell that was a use-after-free — the resource was closed while the
//     returned container still held it.
fn c6m() -> S { return S { h: mk(8) }; }
fn c6() { s = c6m(); note("alive{s.h.id}"); }

// 7 — per iteration, not once at the end: a `for` body is a scope of its own.
fn c7() { for i in 9..11 { s = S { h: mk(i) }; note("alive{s.h.id}"); } }

// 8 — an ENUM payload (stage D). The value is a record of the VARIANT with a discriminator
//     at its head, so the cascade reads the discriminator once and releases through whichever
//     variant is present. This is @PLN138's registry shape.
fn c8(k: integer) {
  w: W = if k == 0 { a: W = WH { h: mk(30) }; a } else { b: W = WNone; b };
  note("alive");
}

// 9 — a variant with TWO droppable fields: reverse declaration order inside the arm, and
//     proof the arm releases the whole payload rather than its first field.
fn c9() { w: W = WTwo { a: mk(31), b: mk(32) }; note("alive"); }

// 10 — CONTROL: the OTHER variant of the same enum owns nothing, so its arm must not run.
fn c10() { w: W = WNone; note("alive"); }

// 11 — CONTROL: a unit-only enum synthesizes no cascade at all.
fn c11() { u: Units = UA; note("alive{u == UA}"); }

// 12 — a COLLECTION of droppables (stage E). A local vector is backed by a wrapper record
//      whose field holds the elements, so the same field cascade reaches it — the loop walks
//      the elements FORWARD and releases each. This is also the shape that used to close the
//      last element once per element and the first never.
fn c12() { v: vector<H> = [mk(40), mk(41), mk(42)]; note("alive{len(v)}"); }

// 13 — a collection of CONTAINERS: each element's own cascade runs, so the composition of
//      the two constructors is what is under test, not either alone.
fn c13() { v: vector<S> = [S { h: mk(43) }, S { h: mk(44) }]; note("alive{len(v)}"); }

// 14 — a collection FIELD of a struct, rather than a bare local.
struct Bag { v: vector<H>, tag: integer }
fn c14() { b = Bag { v: [mk(45), mk(46)], tag: 1 }; note("alive{len(b.v)}"); }

// 15 — CONTROL: an EMPTY collection of a droppable type. The loop must run zero times.
fn c15() { v: vector<H> = []; note("alive{len(v)}"); }

// 16 — CONTROL: a collection whose element owns nothing. No loop may be emitted at all.
fn c16() { v: vector<Plain> = [Plain { n: 7 }]; note("alive{len(v)}"); }

// 17 — CONTROL: a droppable that never enters a container. Untouched by all of this.
fn c17() { a = mk(20); b = mk(21); note("alive{a.id}{b.id}"); }

// 18 — CONTROL: no droppable anywhere. No cascade may be synthesized, and nothing may run.
fn c18() { p = Plain { n: 1 }; note("alive{p.n}"); }

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  c1(); got = drain();
  assert(got == "alive1,1", "c1 container releases the field, after it was readable: {got}");

  c2(); got = drain();
  assert(got == "alive2,2", "c2 inline temp transfers at the lift: {got}");

  c3(); got = drain();
  assert(got == "alive3,3", "c3 nesting releases once, not once per level: {got}");

  c4(); got = drain();
  assert(got == "alive45,5,4", "c4 fields in reverse declaration order: {got}");

  c5(); got = drain();
  assert(got == "alive7,outer6,7", "c5 the container's own hook runs before its field: {got}");

  c6(); got = drain();
  assert(got == "alive8,8", "c6 a RETURNED container still holds it while alive: {got}");

  c7(); got = drain();
  assert(got == "alive9,9,alive10,10", "c7 per iteration, not once at the end: {got}");

  c8(0); got = drain();
  assert(got == "alive,30", "c8 an enum payload releases through its variant: {got}");

  c8(1); got = drain();
  assert(got == "alive", "c8 the payload-free variant releases nothing: {got}");

  c9(); got = drain();
  assert(got == "alive,32,31", "c9 a two-field variant, reverse declaration: {got}");

  c10(); got = drain();
  assert(got == "alive", "c10 a unit variant of a droppable enum runs nothing: {got}");

  c11(); got = drain();
  assert(got == "alivetrue", "c11 a unit-only enum has no cascade: {got}");

  c12(); got = drain();
  assert(got == "alive3,40,41,42", "c12 every element released, in order: {got}");

  c13(); got = drain();
  assert(got == "alive2,43,44", "c13 a collection of containers composes: {got}");

  c14(); got = drain();
  assert(got == "alive2,45,46", "c14 a collection FIELD of a struct: {got}");

  c15(); got = drain();
  assert(got == "alive0", "c15 an empty collection runs the loop zero times: {got}");

  c16(); got = drain();
  assert(got == "alive1", "c16 a collection of plain records emits no loop: {got}");

  c17(); got = drain();
  assert(got == "alive2021,21,20", "c17 uncontainered droppables are unchanged: {got}");

  c18(); got = drain();
  assert(got == "alive1", "c18 a program with no droppable runs nothing: {got}");

  delete(trace_path());
  println("139 cascade ok");
}
