// @PLN87 P2.4 — reassignment-locality gate (struct + scalar cells).
//
// A whole-binding reassignment of a non-`&` heap PARAMETER (`o = Obj{..}`) is
// LOCAL: it rebinds `o` to a fresh store and leaves the caller's value
// untouched.  Reference-default field mutation (`o.x = 9`) still propagates.
// The rebound store is freed at function exit, distinct-guarded against the
// caller's original (witness `__orig`), so it is sound across conditional and
// repeated rebind with no double-free and no leak (this script runs under
// loft_suite's program-exit leak gate on the interpreter; native verified
// separately via `loft --native`).
//
// NOT covered here:
//   - `&` write-back (P2.2): behaviour is correct (`g.x == 9`) but the
//     `SetStackRef` path leaks the old caller store — a PRE-EXISTING gap in the
//     `&`-reassignment codegen, tracked as P2.2-completion work.
//   - vector cell (P2.4): vector param reassignment still appends to the
//     caller's backing — the `__vdb` path is not yet rebind-aware.

struct Obj { x: integer }

// P2.1: non-& param reassign -> local rebind (caller unchanged).
fn rebind(o: Obj) { o = Obj { x: 9 }; }
// Control: reference-default field mutation still propagates.
fn field_mut(o: Obj) { o.x = 7; }
// Conditional rebind: sound on both the taken and untaken path.
fn cond(o: Obj, c: boolean) { if c { o = Obj { x: 9 }; } }
// Repeated rebind: each prior rebind store is freed, none leak.
fn multi(o: Obj) { o = Obj { x: 2 }; o = Obj { x: 3 }; }
// Field write (propagates) THEN whole-binding rebind (local): the caller keeps
// the field write, not the rebound value.
fn field_then(o: Obj) { o.x = 5; o = Obj { x: 9 }; }

fn main() {
    a = Obj { x: 1 }; rebind(a);
    assert(a.x == 1, "non-& param reassign is local (caller unchanged)");

    b = Obj { x: 1 }; field_mut(b);
    assert(b.x == 7, "field mutation still propagates (reference-default)");

    c1 = Obj { x: 1 }; cond(c1, true);
    assert(c1.x == 1, "conditional rebind (taken) is local");
    c2 = Obj { x: 1 }; cond(c2, false);
    assert(c2.x == 1, "conditional rebind (untaken) leaves caller intact");

    m = Obj { x: 1 }; multi(m);
    assert(m.x == 1, "repeated rebind is local (no leak, no caller mutation)");

    f = Obj { x: 1 }; field_then(f);
    assert(f.x == 5, "field write propagates, later rebind is local");

    l = Obj { x: 1 }; l = Obj { x: 2 };
    assert(l.x == 2, "local rebind reassigns in place");

    print("87-p2-reassign-locality ok\n");
}
