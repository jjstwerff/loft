// @PLN87 P2 — reassignment-locality / write-back CONSISTENCY contract.
//
// The uniform model: for a parameter of ANY type,
//   * a non-`&` whole-binding reassignment (`o = X`) is LOCAL — it rebinds the
//     parameter, leaving the caller's value untouched;
//   * a `&` whole-binding reassignment writes BACK — the caller sees the new value;
//   * field / element mutation (`o.x = 9`, `v[0] = 9`) always PROPAGATES
//     (reference-default), independent of `&`.
// Sound + leak-free across conditional / repeated rebind, on every backend (this
// script runs under loft_suite's program-exit leak gate on the interpreter, and
// through --native / --native-wasm).
//
// This file holds the cells that are GREEN today.  The remaining cells —
// vector non-`&` rebind (P2.4), vector `&` write-back, and the struct `&`
// write-back store leak (P2.2) — are pinned as lock-in tests in tests/issues.rs
// (search @PLN87) until they land, then move here.

struct Obj { x: integer }

// --- struct, non-& : whole reassign is LOCAL ---
fn o_rebind(o: Obj) { o = Obj { x: 9 }; }
// --- struct, & : whole reassign WRITES BACK (caller sees the new value), leak-free ---
fn o_amp(o: &Obj) { o = Obj { x: 9 }; }
// --- struct : field mutation PROPAGATES (reference-default) ---
fn o_field(o: Obj) { o.x = 7; }
// --- struct, non-& : conditional rebind, both paths sound ---
fn o_cond(o: Obj, c: boolean) { if c { o = Obj { x: 9 }; } }
// --- struct, non-& : repeated rebind, no leak ---
fn o_multi(o: Obj) { o = Obj { x: 2 }; o = Obj { x: 3 }; }
// --- struct : field write (propagates) THEN whole rebind (local) ---
fn o_field_then(o: Obj) { o.x = 5; o = Obj { x: 9 }; }
// --- vector, non-& : whole reassign is LOCAL (rebind to a fresh backing) ---
fn v_rebind(v: vector<integer>) { v = [7, 8, 9]; }
// --- vector, non-& : conditional rebind, both paths sound ---
fn v_cond(v: vector<integer>, c: boolean) { if c { v = [9]; } }
// --- vector, non-& : repeated rebind, no leak ---
fn v_multi(v: vector<integer>) { v = [2]; v = [3, 4]; }
// --- vector : element mutation PROPAGATES (reference-default) ---
fn v_elem(v: vector<integer>) { v[0] = 9; }
// --- vector, += : GROWS the caller's backing (not a rebind) ---
fn v_grow(v: vector<integer>) { v += [7]; }
// --- scalar, non-& : reassign is LOCAL (by value) ---
fn n_local(n: integer) { n = n * 2; }
// --- scalar, & : reassign writes BACK ---
fn n_amp(n: &integer) { n = 5; }

fn main() {
    a = Obj { x: 1 }; o_rebind(a);
    assert(a.x == 1, "struct non-& reassign is local (caller unchanged)");

    g = Obj { x: 1 }; o_amp(&g);
    assert(g.x == 9, "struct & reassign writes back to the caller (leak-free)");

    b = Obj { x: 1 }; o_field(b);
    assert(b.x == 7, "struct field mutation propagates (reference-default)");

    c1 = Obj { x: 1 }; o_cond(c1, true);
    assert(c1.x == 1, "conditional rebind (taken) is local");
    c2 = Obj { x: 1 }; o_cond(c2, false);
    assert(c2.x == 1, "conditional rebind (untaken) leaves caller intact");

    m = Obj { x: 1 }; o_multi(m);
    assert(m.x == 1, "repeated rebind is local (no leak)");

    f = Obj { x: 1 }; o_field_then(f);
    assert(f.x == 5, "field write propagates, later rebind is local");

    vr = [1, 2, 3]; v_rebind(vr);
    assert(len(vr) == 3, "vector non-& reassign is local (caller length unchanged)");
    assert(vr[0] == 1, "vector non-& reassign leaves the caller's first element");

    vt = [1, 2, 3]; v_cond(vt, true);
    assert(len(vt) == 3, "vector conditional rebind (taken) is local");
    vf = [1, 2, 3]; v_cond(vf, false);
    assert(len(vf) == 3, "vector conditional rebind (untaken) leaves caller intact");

    vm = [1, 2, 3]; v_multi(vm);
    assert(len(vm) == 3, "vector repeated rebind is local (no leak)");

    vg = [1, 2, 3]; v_grow(vg);
    assert(len(vg) == 4, "vector += grows the caller's backing (reference-default)");

    ve = [1, 2, 3]; v_elem(ve);
    assert(ve[0] == 9, "vector element mutation propagates");
    assert(len(ve) == 3, "vector element mutation does not change length");

    x = 3; n_local(x);
    assert(x == 3, "scalar non-& reassign is local (by value)");

    y = 1; n_amp(&y);
    assert(y == 5, "scalar & reassign writes back");

    // local (non-param) rebind sanity
    l = Obj { x: 1 }; l = Obj { x: 2 };
    assert(l.x == 2, "local rebind reassigns in place");

    print("87-p2-reassign-locality ok\n");
}
