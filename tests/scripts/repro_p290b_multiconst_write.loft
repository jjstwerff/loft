//
// @P290 follow-up (dryopea-surfaced) — a fn with TWO `const` struct
// params (each holding a hash) that iterates both and appends into a
// nested vector through a THIRD (non-const) param once panicked with
// "Claim on read-only store (locked by: lock_store(...))".  The @P290
// flag-split (read_only vs free_protected) resolved it; this guards the
// dryopea-faithful multi-const + write-through-other-param shape.
// (dryopea's residual filing was probed against a stale binary.)

struct Item   { v: integer }
struct PWorld { items: hash<Item[v]> }
struct MWorld { items: hash<Item[v]> }
struct Delta   { q: integer, kind: integer }
struct Entry   { ds: vector<Delta> }
struct History { entries: vector<Entry> }

fn snap_and_record(pw: const PWorld, mw: const MWorld, h: History) {
  e = Entry { ds: [] };
  for pe in pw.items { e.ds += [Delta { q: pe.v, kind: 0 }]; }
  for me in mw.items { e.ds += [Delta { q: me.v, kind: 1 }]; }
  h.entries += [e];
}

fn main() {
  pw = PWorld { items: [] };
  pw.items[10] = Item { v: 10 };
  pw.items[20] = Item { v: 20 };
  mw = MWorld { items: [] };
  mw.items[30] = Item { v: 30 };
  h = History { entries: [] };
  snap_and_record(pw, mw, h);
  assert(h.entries.len() == 1, "one entry recorded");
  assert(h.entries[0].ds.len() == 3, "three deltas across both const hashes");
  print("ok");
}
