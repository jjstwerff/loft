// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Regression: a `-> text?` function whose BODY TAIL is a value-yielding
// `if`/`match` failed to compile on `--native` while `--interpret` was correct
// — an accept/reject divergence.
//
// The per-arm accumulator (`do_if_acc`) exists so native never has to unify
// mixed arm Rust types: each arm becomes `*acc = …;` and the arms are `void`.
// Its nullability condition read the TAIL's type, which conflated two very
// different stores, and excluded both:
//
//   -> text?  with a nullable tail   nullable value, nullable destination — fine
//   -> text   with a nullable tail   nullable into NON-NULL — an `(N-Store)`
//
// Excluding the first cost every `-> text?` branch tail its per-arm delivery,
// so the whole `match` compiled as ONE Rust expression whose arms must agree:
// a buffered call yields `Str`, a formatted string yields `&String`, and rustc
// said `expected `Str`, found `&String``. The condition now reads the DECLARED
// RETURN, which is what decides whether the store is legitimate, and the
// accumulator takes that nullability too rather than claiming non-null while
// holding a null.
//
// The `-> text` half must keep reporting its N-Store; that is pinned in
// `tests/runtime_warnings.rs` (`nstore_return_position_names_offending_fn`,
// `wrong_field_guard_still_rejects`), which is the other half of this fix.
//
// Every cell is asserted BY VALUE on both backends: the bug was a compile
// failure, and "it compiles now" is not the claim.

fn lo(n: integer) -> text? { return "lo{n}"; }
fn hi(n: integer) -> text? { return "hi{n}"; }
fn lo_n(n: integer) -> text { return "lo{n}"; }
fn maybe(n: integer) -> text? { if n < 0 { return null } return "m{n}"; }

// The filed shape: CALL arms plus a FORMATTED-STRING arm. `Str` vs `&String`.
fn mixed_call_and_format(k: integer, n: integer) -> text? {
  match k { 0 => { lo(n) }, 1 => { hi(n) }, _ => { "z{n}" } }
}

// A literal `null` arm. `arm_yields_text` refuses it, so the accumulator never
// engages — this cell pins that the refusal still delivers the right answer
// rather than becoming a compile error.
fn with_a_null_arm(k: integer, n: integer) -> text? {
  if k == 1 { lo(n) } else { null }
}

// Call arms only — the shape that always compiled. It has to keep working: the
// fix widens a gate, and a widened gate can capture a shape it should not.
fn calls_only(k: integer, n: integer) -> text? {
  match k { 0 => { lo(n) }, _ => { hi(n) } }
}

// The non-null twin of `mixed_call_and_format` — the member that hid this.
fn non_null_twin(k: integer, n: integer) -> text {
  match k { 0 => { lo_n(n) }, 1 => { lo_n(n + 1) }, _ => { "z{n}" } }
}

// The chosen arm is a call that returns NULL at run time. This is the cell that
// proves a null survives the per-arm write into the text buffer as the content
// sentinel, rather than arriving as an empty string.
fn arm_null_at_runtime(k: integer, n: integer) -> text? {
  match k { 0 => { maybe(n) }, _ => { "z{n}" } }
}

// A call arm beside a BARE literal — a different Rust rep pairing (`Str` vs
// `&str`) than the formatted-string one, so it is its own cell.
fn call_and_bare_literal(w: boolean, n: integer) -> text? {
  if w { lo(n) } else { "lit" }
}

// Three arms where the MIDDLE one is the formatted string, so the fix cannot be
// an artefact of the mismatched arm being first or last.
fn format_in_the_middle(k: integer, n: integer) -> text? {
  match k { 0 => { lo(n) }, 1 => { "mid{n}" }, _ => { hi(n) } }
}

fn main() {
  assert(mixed_call_and_format(0, 7) == "lo7", "call arm, first");
  assert(mixed_call_and_format(1, 7) == "hi7", "call arm, second");
  assert(mixed_call_and_format(9, 7) == "z7", "formatted-string arm");

  assert(with_a_null_arm(1, 7) == "lo7", "null-arm shape, the text arm");
  assert(with_a_null_arm(0, 7) == null, "null-arm shape, the null arm");

  assert(calls_only(0, 7) == "lo7", "call-only arms, first");
  assert(calls_only(9, 7) == "hi7", "call-only arms, second");

  assert(non_null_twin(0, 7) == "lo7", "non-null twin, call arm");
  assert(non_null_twin(9, 7) == "z7", "non-null twin, formatted arm");

  // A runtime null through the accumulator, and its non-null sibling from the
  // SAME arm — so a fix that turned every answer null would fail here too.
  assert(arm_null_at_runtime(0, -3) == null, "a call arm that is null at runtime");
  assert(arm_null_at_runtime(0, 4) == "m4", "the same arm, non-null");
  assert(arm_null_at_runtime(9, 7) == "z7", "the literal arm beside it");

  assert(call_and_bare_literal(true, 7) == "lo7", "call beside a bare literal");
  assert(call_and_bare_literal(false, 7) == "lit", "the bare literal itself");

  assert(format_in_the_middle(0, 7) == "lo7", "formatted arm in the middle, first");
  assert(format_in_the_middle(1, 7) == "mid7", "formatted arm in the middle, itself");
  assert(format_in_the_middle(9, 7) == "hi7", "formatted arm in the middle, last");

  // Length as well as content: a text delivered through the wrong Rust rep can
  // carry the right bytes with a wrong length.
  assert(size(mixed_call_and_format(9, 7) ?? "") == 2, "formatted arm has the right size");
  assert(size(call_and_bare_literal(true, 7) ?? "") == 3, "call arm has the right size");

  // Two of these in ONE interpolation, so a shared-buffer fix would show here.
  assert("{mixed_call_and_format(0,7) ?? "?"}|{mixed_call_and_format(9,7) ?? "?"}" == "lo7|z7",
    "two nullable branch tails in one interpolation");

  println("nullable text branch tail ok");
}
