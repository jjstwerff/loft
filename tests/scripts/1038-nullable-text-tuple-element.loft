// loft#1038 — reading a `text?` tuple element must not CONSUME it.
//
// The native backend renders a text element borrowed (`&var_f.0`) and a non-text one by
// value, and it decided which by matching `Type::Text` UNPEELED — so a `text?` element
// was not "text", was emitted by value, and the read MOVED the `String`.  Any later read
// of the same element was then rustc E0382 *"borrow of moved value"* and the program did
// not build at all, while `--interpret` answered it correctly — the backend divergence
// `formal/operational.md` D-op-1 forbids.  Three sites re-derived that one fact; they now
// share `tuple_elem_type`.
fn mk() -> (text?, integer) { ("v", 7) }
fn take(p: (text?, integer)) -> text { p.0 ?? "R" }

fn main() {
  // The filed shape: a null test, then a read of the same element.
  f: (text?, integer) = (null, 3);
  assert(f.0 == null, "null test on a text? element");
  assert((f.0 ?? "N") == "N", "read after the null test");

  // Two null tests in a row — the second is where "use of moved value" landed.
  assert(f.0 == null && f.0 == null, "the null test does not consume the element");

  // Binding to a local first (the documented workaround) has to keep working.
  t = f.0;
  assert(t == null && (t ?? "N") == "N", "bound local still reads");

  // A tuple from a RETURN, not a declared local.
  g = mk();
  assert(g.0 != null && (g.0 ?? "N") == "v", "element of a returned tuple");
  assert(take(g) == "v", "the same tuple passed on by value");

  // A write, then reads of the written element.
  f.0 = "w";
  assert((f.0 ?? "N") == "w" && f.0 != null, "write then read");

  // Regressions: the non-null text element and the integer? twin.
  p: (text, integer) = ("a", 1);
  assert(p.0 == "a" && p.0 == "a" && p.1 == 1, "plain text element read twice");
  q: (integer?, integer) = (null, 2);
  assert(q.0 == null && (q.0 ?? -1) == -1, "integer? element");
}
