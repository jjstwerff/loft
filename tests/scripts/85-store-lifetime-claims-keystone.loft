//
// Cluster-C keystone guard (STABILITY_REDFLAGS § Cluster C): `remove_claims`
// and `copy_claims_hash_body` now read ONE per-`Parts` heap-cascade walk
// (`for_each_owned_child`) instead of each re-encoding the container layout.
// This pins copy (deep-copy via fn round-trip) + remove (reassignment frees the
// old collection) across every owned-child container kind, so a future drift in
// the walk (element stride, the @P290 hash `(room - 1) * 2` bound, the index
// node collection, the inline-enum variant re-dispatch) corrupts THIS test
// instead of silently shipping.  The walk bugs the keystone collapses are the
// @P290 / @P306 / @P318 / @P309 family.
//
// Runs on all three backends via the tests/scripts sweep (interp + native +
// wasm) with the store-leak gate, so a copy/remove leak fails here too.

struct ItemT { name: text not null, n: integer not null }
struct EntK  { k: integer not null, name: text not null }
struct HEnt  { k: text not null, v: integer not null }

// Each container kind as a struct field, copied via a fn round-trip (copy_claims)
// then dropped via reassignment (remove_claims).
struct VBox { items: vector<ItemT> not null }
struct HBox { by: hash<HEnt[k]> not null }
struct SBox { s: sorted<EntK[k]> not null }
struct IBox { i: index<EntK[k]> not null, s: sorted<EntK[k]> not null }
struct MBox { label: text not null, nums: vector<integer> not null, by: hash<HEnt[k]> not null }

enum Maybe { Has { s: text }, Gone { n: integer } }
struct EBox { items: vector<Maybe> not null }

fn id_v(b: VBox) -> VBox { return b; }
fn id_h(b: HBox) -> HBox { return b; }
fn id_s(b: SBox) -> SBox { return b; }
fn id_i(b: IBox) -> IBox { return b; }
fn id_m(b: MBox) -> MBox { return b; }
fn id_e(b: EBox) -> EBox { return b; }

fn sorted_names(s: sorted<EntK[k]>) -> text { r = ""; for e in s { r = "{r}{e.name},"; } return r; }
fn show(m: Maybe) -> text { match m { Has { s } => s, Gone { n } => "gone-{n}" } }

fn vector_kind() {
  b = VBox{ items: [ItemT{name:"alpha", n:1}, ItemT{name:"beta", n:2}, ItemT{name:"gamma", n:3}] };
  c = id_v(b);
  assert(c.items.len() == 3, "vector len {c.items.len()}");
  assert(c.items[0].name == "alpha" && c.items[2].name == "gamma" && c.items[2].n == 3, "vector copy");
  c = VBox{ items: [ItemT{name:"delta", n:9}] };  // remove_claims frees the old vector
  assert(c.items.len() == 1 && c.items[0].name == "delta", "vector after-reassign");
  assert(b.items.len() == 3 && b.items[2].name == "gamma", "vector orig intact");
}

fn hash_kind() {
  b = HBox{ by: [HEnt{k:"alpha",v:1}, HEnt{k:"beta",v:2}, HEnt{k:"gamma",v:3}] };
  c = id_h(b);  // copy_claims_hash_body via the keystone spine
  assert(c.by["alpha"].v == 1 && c.by["beta"].v == 2 && c.by["gamma"].v == 3, "hash copy");
  c = HBox{ by: [HEnt{k:"delta",v:9}] };  // remove_claims frees the old hash (@P290 bound)
  assert(c.by["delta"].v == 9, "hash after-reassign");
  assert(b.by["gamma"].v == 3, "hash orig intact");
}

fn sorted_kind() {
  b = SBox{ s: [EntK{k:3,name:"gamma"}, EntK{k:1,name:"alpha"}, EntK{k:2,name:"beta"}] };
  c = id_s(b);
  assert(c.s.len() == 3 && sorted_names(c.s) == "alpha,beta,gamma,", "sorted copy '{sorted_names(c.s)}'");
  c = SBox{ s: [EntK{k:9,name:"delta"}] };
  assert(c.s.len() == 1 && c.s[9].name == "delta", "sorted after-reassign");
  assert(b.s.len() == 3 && b.s[1].name == "alpha", "sorted orig intact");
}

fn index_kind() {
  // index + sibling sorted of same element type — sorted is stored as ordered
  // (array-rep): the @P309 axis through the Array/Ordered keystone arm.
  b = IBox{ i: [EntK{k:3,name:"gamma"}, EntK{k:1,name:"alpha"}, EntK{k:2,name:"beta"}],
            s: [EntK{k:3,name:"GG"}, EntK{k:1,name:"AA"}, EntK{k:2,name:"BB"}] };
  c = id_i(b);
  assert(c.i[1].name == "alpha" && c.i[2].name == "beta" && c.i[3].name == "gamma", "index copy");
  assert(c.s.len() == 3 && sorted_names(c.s) == "AA,BB,GG,", "ordered sibling '{sorted_names(c.s)}'");
  c = IBox{ i: [EntK{k:9,name:"delta"}], s: [EntK{k:9,name:"DD"}] };
  assert(c.i[9].name == "delta" && c.s.len() == 1 && c.s[9].name == "DD", "index after-reassign");
  assert(b.i[2].name == "beta" && b.s[1].name == "AA", "index orig intact");
}

fn struct_multi_heap_kind() {
  b = MBox{ label:"top", nums:[10,20,30], by:[HEnt{k:"x",v:7}, HEnt{k:"y",v:8}] };
  c = id_m(b);  // Struct arm fans out to text + vector + hash children
  assert(c.label == "top" && c.nums.len() == 3 && c.nums[2] == 30, "struct scalar+vec");
  assert(c.by["x"].v == 7 && c.by["y"].v == 8, "struct hash field");
  c = MBox{ label:"new", nums:[99], by:[HEnt{k:"z",v:1}] };
  assert(c.label == "new" && c.nums[0] == 99 && c.by["z"].v == 1, "struct after-reassign");
  assert(b.label == "top" && b.nums[1] == 20, "struct orig intact");
}

fn inline_enum_kind() {
  b = EBox{ items: [Has{s:"alpha"}, Gone{n:5}, Has{s:"gamma"}] };
  c = id_e(b);  // Enum arm — in-place variant payload deep-copy
  assert(show(c.items[0]) == "alpha" && show(c.items[1]) == "gone-5" && show(c.items[2]) == "gamma", "enum copy");
  c = EBox{ items: [Has{s:"delta"}] };  // remove_claims frees the old Has payloads
  assert(show(c.items[0]) == "delta", "enum after-reassign");
  assert(show(b.items[2]) == "gamma", "enum orig intact");
}

fn main() {
  vector_kind();
  hash_kind();
  sorted_kind();
  index_kind();
  struct_multi_heap_kind();
  inline_enum_kind();
  print("85-store-lifetime-claims-keystone ok\n");
}
