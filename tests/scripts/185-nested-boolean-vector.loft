//
// Regression (plan-58 cluster-I outer-handle stride): nested boolean vectors
// (`vector<vector<boolean>>`) corrupted/crashed.  The OUTER vector stores 4-byte
// rec-id HANDLES, but both the construct stride (record_new) and the read stride
// resolved to the inner SCALAR size — 1 byte for boolean — so adjacent 4-byte
// handles OVERLAPPED.  Integer (8) and single (4) inner scalars are ≥4 so they
// never overlapped; only sub-4 boolean did (corrupt at ≥2 rows, SIGSEGV at ≥3).
// Fix: pass the OUTER vector type as `known` to OpNewRecord when the inner content
// is <4 bytes (so record_new strides by the 4-byte handle), and clamp the read
// stride to ≥4 — without changing the type classification.

fn mk_bool_rows() -> vector<vector<boolean>> {
  return[[true, false], [false, true, false]];
}

fn main() {
  // 3 alternating rows + materialise each (the SIGSEGV / empty-row shape)
  vv: vector<vector<boolean>> = [[true, false, true], [false], [false, true]];
  assert(len(vv) == 3, "len {len(vv)}");
  assert(
    len(vv[0]) == 3 && len(vv[1]) == 1 && len(vv[2]) == 2,
    "row lens {len(vv[0])},{len(vv[1])},{len(vv[2])}"
  );
  assert(vv[0][0] == true && vv[0][1] == false && vv[0][2] == true, "row0 {vv[0]}");
  assert(vv[1][0] == false, "row1");
  assert(vv[2][0] == false && vv[2][1] == true, "row2 {vv[2]}");

  // materialise an inner row to a variable (the multi-row read path)
  r1: vector<boolean> = vv[2];
  assert(r1[0] == false && r1[1] == true, "materialise {r1}");

  // 3-deep boolean
  vvv: vector<vector<vector<boolean>>> = [];
  a: vector<vector<boolean>> = [[true, false]];
  vvv += [a];
  assert(vvv[0][0][0] == true && vvv[0][0][1] == false, "3deep {vvv[0][0]}");

  // fn-return
  m = mk_bool_rows();
  assert(m[0][0] == true && m[0][1] == false && m[1][2] == false, "fn-return {m}");

  println("nested-boolean-vector ok");
}
