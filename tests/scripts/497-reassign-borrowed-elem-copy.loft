//
// #497 / #496 regression guard: a struct-returning call REASSIGNED into an
// owned Reference local must deep-copy when the callee's return is tied to a
// passed param (`!return_adopts_fresh_store()`) — including a callee that
// borrows from a visible VECTOR param (`return cs[i]`).  The reassignment
// path's old gate scanned for visible Reference/Enum params only, so the
// vector-param borrow took the plain-adopt path; the local's owned pre-Set
// free then whole-store-freed the LENDER's backing store: crawler's
// build_walls lost `cs` mid-function (SIGSEGV under reuse pressure, silent
// wrong data before it — both faces of one hole).  The first-Set path already
// read the carried A.3 fact; this guards the reassignment path's parity.
//
// Shape 1 (minimal): the call-assignment sits inside a nested if, so the
// binding is a REASSIGNMENT (its first-set is the hoisted init).  Pre-fix:
// deg writebacks silently vanished (dsum=0) and the second iteration read
// cs's freed store.
// Shape 2 (composition): two borrowed-return locals from two captures in one
// loop — the shape of crawler's build_walls phase B.

struct WC { x: float, deg: integer, n1: integer }
struct WE { a: integer, b: integer }
struct Graph { corners: vector<WC>, edges: vector<WE> }

fn get_or_add(g: &Graph, x: float) -> integer {
  cs0 = g.corners;
  for i in 0..len(cs0) { c0 = cs0[i]; if c0 != null && c0.x == x { return i; } }
  g.corners += [WC { x: x, deg: 0, n1: -1 }];
  len(g.corners) - 1
}

fn add_edge(g: &Graph, xa: float, xb: float) {
  ia = get_or_add(g, xa);
  ib = get_or_add(g, xb);
  g.edges += [WE { a: ia, b: ib }];
}

fn corner_at(cs: vector<WC>, i: integer) -> WC {
  if i < 0 { return WC { x: 0.0, deg: 0, n1: -1 }; }
  if i < len(cs) { return cs[i]; }
  WC { x: 0.0, deg: 0, n1: -1 }
}

fn edge_at(es: vector<WE>, i: integer) -> WE {
  if i < 0 { return WE { a: -1, b: -1 }; }
  if i < len(es) { return es[i]; }
  WE { a: -1, b: -1 }
}

fn shape_minimal() {
  g = Graph { corners: [], edges: [] };
  for i in 0..10 { get_or_add(g, (i % 10 ?? 0) as float); }
  cs = g.corners;
  for k in 0..10 {
    if k >= 0 {
      ca2 = corner_at(cs, k);
      ca2.deg += 1;
      if k < len(cs) { cs[k] = ca2; }
    }
  }
  assert(len(cs) == 10, "minimal: corners intact, got {len(cs)}");
  dsum = 0;
  for m in 0..10 { cm = corner_at(cs, m); dsum += cm.deg; }
  assert(dsum == 10, "minimal: deg writebacks survive, got {dsum}");
}

fn shape_two_captures() {
  g = Graph { corners: [], edges: [] };
  for i in 0..30 {
    add_edge(g, (i % 10 ?? 0) as float, ((i + 1) % 10 ?? 0) as float);
  }
  cs = g.corners;
  es = g.edges;
  for ei in 0..len(es) {
    ed = edge_at(es, ei);
    ia = ed.a;
    if ia >= 0 {
      ca2 = corner_at(cs, ia);
      ca2.deg += 1;
      if ia < len(cs) { cs[ia] = ca2; }
    }
  }
  assert(len(cs) == 10, "two-captures: corners intact, got {len(cs)}");
  assert(len(es) == 30, "two-captures: edges intact, got {len(es)}");
  dsum = 0;
  for m2 in 0..10 { cm2 = corner_at(cs, m2); dsum += cm2.deg; }
  assert(dsum == 30, "two-captures: deg sum 30, got {dsum}");
}

fn main() {
  shape_minimal();
  shape_two_captures();
  println("ok");
}
