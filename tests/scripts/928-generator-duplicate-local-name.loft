//
// A generator moves its persistent locals onto ONE struct, so two locals that spell the
// same name have to land as two DIFFERENT fields (loft#928).
//
// Two `for i in …` loops in one function produce exactly that: each loop declares its own
// `i` AND its own hidden `i#index`, so four distinct variables spell two names. In a plain
// function this is invisible — a second `let mut var_i` shadows the first, and loft refuses
// the one shape where that would lose a value (`x = 5; for x in …` is a compile error). On a
// struct there is no shadowing: the field was declared twice and `--native` did not compile,
// while `--interpret` ran the program correctly.
//
// The names are asserted only through VALUES, because the field spelling is an internal
// detail; what the program is owed is that each loop's variable is its own.

// The filed shape: two integer loops, one name.
fn two_int_loops() -> iterator<integer> {
  s = 0;
  for i in 0..3 { s = s + i; }
  yield s;
  t = 0;
  for i in 0..3 { t = t + i * 2; }
  yield t;
}

// Three, so the disambiguator has to keep counting rather than handle one collision.
fn three_int_loops() -> iterator<integer> {
  s = 0;
  for i in 0..3 { s = s + i; }
  yield s;
  for i in 0..3 { s = s + i * 2; }
  yield s;
  for i in 0..3 { s = s + i * 3; }
  yield s;
}

// A HEAP loop variable: the field is a DbRef, and `drop_stores` frees it by name — so a
// renamed field that the teardown still spelled the old way would not compile, and one that
// both sides spelled the same but wrongly would free the wrong local.
struct P { n: integer }

fn two_struct_loops(v: vector<P>) -> iterator<integer> {
  a = 0;
  for p in v { a = a + p.n; }
  yield a;
  b = 0;
  for p in v { b = b + p.n * 10; }
  yield b;
}

// A local that already spells what the disambiguator would reach for. Suffixing blindly
// would hand `i__2` to the second `i` and collide all over again; the name is instead taken
// from the set of spellings already CLAIMED, so this one keeps `i__2` and the loop moves on.
fn collides_with_a_real_local() -> iterator<integer> {
  i__2 = 7;
  s = 0;
  for i in 0..3 { s = s + i; }
  yield s + i__2;
  t = 0;
  for i in 0..3 { t = t + i * 2; }
  yield t + i__2;
}

// Distinct names in one generator, which is what every generator did before: the first
// claimant of a spelling keeps the bare name, so this emits exactly what it always did.
fn distinct_names() -> iterator<integer> {
  s = 0;
  for i in 0..3 { s = s + i; }
  yield s;
  for j in 0..2 { s = s + j; }
  yield s;
}

fn drain(g: iterator<integer>, base: integer) -> integer {
  o = 0;
  for x in g { o = o * base + x; }
  o
}

fn main() {
  // 0+1+2 = 3, then 0+2+4 = 6.
  assert(drain(two_int_loops(), 100) == 306,
         "two_int_loops reads {drain(two_int_loops(), 100)}, want 306");

  // 3, then 3+6 = 9, then 9+9 = 18.
  assert(drain(three_int_loops(), 100) == 30918,
         "three_int_loops reads {drain(three_int_loops(), 100)}, want 30918");

  vp: vector<P> = [P { n: 1 }, P { n: 2 }];
  // 1+2 = 3, then 10+20 = 30.
  assert(drain(two_struct_loops(vp), 1000) == 3030,
         "two_struct_loops reads {drain(two_struct_loops(vp), 1000)}, want 3030");

  // 3+7 = 10, then 6+7 = 13 — and the 7 proves `i__2` still holds its own value.
  assert(drain(collides_with_a_real_local(), 100) == 1013,
         "collides_with_a_real_local reads {drain(collides_with_a_real_local(), 100)}, want 1013");

  // 3, then 3+0+1 = 4.
  assert(drain(distinct_names(), 100) == 304,
         "distinct_names reads {drain(distinct_names(), 100)}, want 304");

  println("ok");
}
