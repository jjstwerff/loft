// SPDX-License-Identifier: LGPL-3.0-or-later
// loft#1139 — a tuple's MEMBERS have two spellings too, and the same-type question has to be
// asked the same way one level in.
//
// A tuple is one loft type written two ways: `Type::Tuple(…)` on contiguous stack slots, and
// `Reference(__tuple<…>)` as a DbRef at the same elements' stored bytes — which is what a
// heap-carrying tuple RETURN carries (the caller's `__retbuf` ABI).  `unboxes_stored_tuple` is
// the one home that relates the pair, and it compared the members with `is_equal` alone.
//
// A member declared `S?` is `Optional(Reference(S))` on the stack side and the synthetic
// `Enum(__nullable<S>, true)` on the stored side (the rewrite between the two passes), so
// `is_equal` said no and the append was refused with a precision loss between a type and
// itself — while the DENSE twin, whose member is `Reference(S)` on both sides, was accepted.
// The cure the message suggested could not work either: `as (integer, S?)` is the type the
// vector already declares, so the cast had nothing to change.
//
// `Data::same_nullable_struct` is the one home for that pair, and asking it is the whole fix.
//
// The DENSE twin is a control on purpose: it is the row that says this is about the two
// SPELLINGS of a nullable member and not about tuple returns, whose machinery is unchanged.
//
// ⚠ Only a tagged member in LAST position is admitted, and that bound belongs to the unboxer
// rather than to the type.  `unbox_tuple_from_dbref` re-derives a `__tuple<…>` def from the
// element types it is handed — the STORED spellings — so a tagged member yields
// `__tuple<__nullable<S>,integer>`, a different def with different offsets, and every member
// AFTER it reads at the wrong one (measured: the trailing scalar of `(S?, integer)` reads `0`
// for `3`).  So `(S?, integer)` keeps its REFUSAL, which is why there is no cell for it here:
// turning that one into an acceptance would trade a refused program for a silently wrong one.
// Three members with the tagged one last is here instead, because it is the case that says
// the rule is "nothing follows it" and not "the tuple has two members".
//
// @falsified-at: a76483fc — interpret exit 1 -> 0, native exit 1 -> 0 (both backends refused
// the file before any test ran, with `cannot store __tuple<integer,Tn?> elements in a
// vector<(integer, Tn?)>`).

struct Tn { a: integer, b: integer }

fn tn_dense() -> (integer, Tn)  { (7, Tn { a: 1, b: 22 }) }
fn tn_present() -> (integer, Tn?) { (7, Tn { a: 1, b: 22 }) }
fn tn_absent() -> (integer, Tn?) { (9, null) }
// The member's FIRST field is zero, which is where a discriminant would alias onto the payload
// if the tagged slot were read at the wrong offset — the value that distinguishes a correct
// read from one that happens to look right.
fn tn_zero() -> (integer, Tn?) { (5, Tn { a: 0, b: 33 }) }
fn tn_scalar() -> (integer, integer?) { (2, 8) }
fn tn_three() -> (integer, integer, Tn?) { (1, 2, Tn { a: 6, b: 66 }) }

fn test_the_dense_twin_still_appends() {
  d: vector<(integer, Tn)> = [];
  d += [tn_dense()];
  seen = 0;
  for t in d {
    assert(t.0 == 7, "the scalar member: {t.0}");
    assert(t.1.a == 1 && t.1.b == 22, "the dense struct member reads whole");
    seen += 1;
  }
  assert(seen == 1, "one element: {seen}");
}

fn test_a_nullable_member_appends_and_reads_back() {
  v: vector<(integer, Tn?)> = [];
  v += [tn_present()];
  v += [tn_absent()];
  v += [tn_zero()];
  present = 0;
  absent = 0;
  for t in v {
    e = t.1;
    if e == null {
      absent += 1;
      assert(t.0 == 9, "the absent row keeps its own scalar member: {t.0}");
    } else {
      present += 1;
      if t.0 == 7 {
        assert(e.a == 1 && e.b == 22, "the present member reads whole");
      } else {
        assert(t.0 == 5, "the third row: {t.0}");
        // A zero first field must still read PRESENT: absence is the tag's to say, never a
        // payload byte's.
        assert(e.a == 0 && e.b == 33, "a member whose first field is 0 reads present and whole");
      }
    }
  }
  assert(present == 2, "two present rows: {present}");
  assert(absent == 1, "one absent row: {absent}");
}

// A nullable SCALAR member is the control for the fix's reach: it has only one spelling
// (`Optional(integer)` on both sides), so it was already accepted and must stay so.
fn test_a_nullable_scalar_member_is_unaffected() {
  w: vector<(integer, integer?)> = [];
  w += [tn_scalar()];
  for t in w {
    assert(t.0 == 2, "the first member: {t.0}");
    assert(t.1 == 8, "the nullable scalar member: {t.1}");
  }
}

// Three members, the tagged one last — nothing follows it, so every earlier offset stands.
fn test_a_tagged_member_last_of_three() {
  q: vector<(integer, integer, Tn?)> = [];
  q += [tn_three()];
  for t in q {
    assert(t.0 == 1 && t.1 == 2, "the two leading scalars: {t.0} {t.1}");
    e = t.2;
    assert(e != null, "the trailing tagged member is present");
    assert(e.a == 6 && e.b == 66, "and reads whole");
  }
}

fn main() {
  test_the_dense_twin_still_appends();
  test_a_nullable_member_appends_and_reads_back();
  test_a_nullable_scalar_member_is_unaffected();
  test_a_tagged_member_last_of_three();
}
