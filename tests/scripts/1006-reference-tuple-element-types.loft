//
// A `&(…)` reference tuple's admitted element types were THREE lists that disagreed.
//
// An element is read and written through the tuple's stored reference at its own offset —
// the same `(ref, offset)` opcode pair an ordinary struct FIELD uses — so the admitted set
// is exactly the set those pairs are laid out for.  The signature guard, `RefTupleGet` and
// `RefTuplePut` each carried their own version of that set:
//
//   - `single` was ADMITTED by the guard and by the read arm, and absent from the WRITE
//     arm — so `p.0 = p.1` on a `&(single, single)` was an internal compiler error.
//   - a function reference was ADMITTED and died in the stack allocator instead.
//   - `boolean` was REFUSED, though every layer could always have handled it.
//
// `formal/tuples.md` had no rule for `&(…)` at all (D-tup-1), which is how the two backends
// came to represent it differently with nothing to catch them.  `T-Ref` / `T-Ref-El` state
// it now, and `data::ref_tuple_element_ok` is the ONE list the guard and both arms read, so
// the rule and the implementation cannot drift apart again.
//
// A `text` element stays REFUSED and that is the rule, not an omission: the opcode pair
// exists and takes the same `(ref, offset)`, but a reference tuple's storage is not a
// record with a text slot the way a struct is — wiring it up read out of bounds on the
// interpreter and would not compile on `--native`.  The refusal names the element type and
// the cure, which is what loft#1006 asked for.  `102-expected-errors.loft` carries the
// refusals; this file carries what must WORK.

fn sw_int1006(p: &(integer, integer)) { t = p.0; p.0 = p.1; p.1 = t; }
fn sw_float1006(p: &(float, float)) { t = p.0; p.0 = p.1; p.1 = t; }
fn sw_single1006(p: &(single, single)) { t = p.0; p.0 = p.1; p.1 = t; }
fn sw_char1006(p: &(character, character)) { t = p.0; p.0 = p.1; p.1 = t; }
fn sw_bool1006(p: &(boolean, boolean)) { t = p.0; p.0 = p.1; p.1 = t; }
fn sw_mixed1006(p: &(integer, boolean, character)) { p.0 = 9; p.1 = true; p.2 = 'z'; }
fn sw_three1006(p: &(single, single, single)) { t = p.0; p.0 = p.2; p.2 = t; }

fn test_an_integer_reference_tuple_writes_through() {
  s = (1, 2);
  sw_int1006(s);
  assert(s.0 == 2 && s.1 == 1, "the caller's tuple is swapped, got {s.0}{s.1}");
}

fn test_a_float_reference_tuple_writes_through() {
  s = (1.5, 2.5);
  sw_float1006(s);
  assert(s.0 == 2.5 && s.1 == 1.5, "the caller's floats are swapped, got {s.0} {s.1}");
}

fn test_a_single_reference_tuple_writes_through() {
  // The WRITE arm had no `single`, so this was an internal compiler error while the
  // signature said it was fine.  Reading one always worked, which is why only a program
  // that assigns could see it.
  s = (1.5 as single, 2.5 as single);
  sw_single1006(s);
  assert(s.0 == 2.5 as single && s.1 == 1.5 as single, "the singles are swapped, got {s.0} {s.1}");
}

fn test_a_character_reference_tuple_writes_through() {
  s = ('a', 'b');
  sw_char1006(s);
  assert(s.0 == 'b' && s.1 == 'a', "the characters are swapped, got {s.0}{s.1}");
}

fn test_a_boolean_reference_tuple_writes_through() {
  // Refused at the signature before, though a boolean is a scalar in the same slot family
  // as a character and every layer below could handle it.
  s = (true, false);
  sw_bool1006(s);
  assert(!s.0 && s.1, "the booleans are swapped, got {s.0}{s.1}");
}

fn test_the_admitted_types_mix_in_one_tuple() {
  // Each element takes its own opcode pair at its own offset, so a mixed tuple is the
  // cell where a wrong offset or a wrong width shows up as a neighbour being disturbed.
  s = (1, false, 'a');
  sw_mixed1006(s);
  assert(s.0 == 9, "the integer element is written, got {s.0}");
  assert(s.1, "the boolean element is written, got {s.1}");
  assert(s.2 == 'z', "the character element is written, got {s.2}");
}

fn test_a_three_element_reference_tuple_reaches_its_last_element() {
  s = (1.0 as single, 2.0 as single, 3.0 as single);
  sw_three1006(s);
  assert(s.0 == 3.0 as single, "first is last, got {s.0}");
  assert(s.1 == 2.0 as single, "the middle is untouched, got {s.1}");
  assert(s.2 == 1.0 as single, "last is first, got {s.2}");
}
