//
// plan-57 Bug 2 — the OTHER half of the soundness floor: vars declared INSIDE a
// parallel arm (arm-locals) are sound (the worker owns them) and must COMPILE.
// This is the non-circular enforcement of the `is_defined`-at-block-entry
// invariant in `parse_parallel`: if a future change made arm-local user vars read
// `is_defined==true` at block entry, the capture check would falsely reject this
// code and the test fails.  (170-parallel-capture-soundness.loft guards the
// reject half; this guards the allow half.)

fn worker(n: integer) -> integer {
  n * 2
}

fn main() {
  outer = 5;
  v = [10, 20, 30];
  parallel {
    // Arm-local declaration reading an enclosing local — NOT a capture-write.
    a = outer + 1;
    // Arm-local fed by a call that reads an enclosing local.
    tmp = worker(outer);
    // Arm-local accumulator mutated by a for-loop bound by an enclosing read.
    sum = 0;
    for i in 0..3 { sum = sum + i; }
    // Read an enclosing heap value (sound) into an arm-local.
    n = v.len();
  }
  // The arms run isolated; the parent's enclosing state is untouched.
  assert(outer == 5, "enclosing scalar preserved");
  assert(v.len() == 3, "enclosing vector preserved");
  print("ok\n");
}
