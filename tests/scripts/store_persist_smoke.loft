// @PLAN38 — smoke test for `store_persist_bind` ("the hash IS the file").
//
// Driven by `tests/store_persist_loft.rs`, which invokes this script
// twice: once with $LOFT_PERSIST_TEST_MODE="fresh" against a path that
// doesn't exist, then once with mode="reload" against the same path.
// The fresh run creates a hash with three entries, binds it to the
// path, prints the keys.  The reload run also creates an empty hash,
// binds to the existing path (which loads the on-disk hash) and
// prints the keys it sees.  Equality of the two outputs proves the
// round-trip.

struct Entry {
  key: integer,
  value: integer,
}

fn record_keys(h: hash<Entry[key]>) -> text {
  result = "";
  for re_e in h {
    if result == "" {
      result = "{re_e.key}"
    } else {
      result = "{result},{re_e.key}"
    }
  }
  result
}

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH");
  mode = env_variable("LOFT_PERSIST_TEST_MODE");

  h: hash<Entry[key]> = [];

  if mode == "fresh" {
    // Populate BEFORE binding so the bytes get snapshotted to disk.
    h += Entry { key: 7,  value: 700 };
    h += Entry { key: 13, value: 1300 };
    h += Entry { key: 42, value: 4200 };

    ok = store_persist_bind(h, path);
    if !ok {
      println("FAIL fresh-bind-returned-false");
      return
    }
    // After bind, the slot is mmap'd.  Read keys back to confirm the
    // record layout survived the swap.
    println("fresh keys={record_keys(h)}");
  } else if mode == "reload" {
    // Empty hash; bind should overlay the on-disk contents.
    ok = store_persist_bind(h, path);
    if !ok {
      println("FAIL reload-bind-returned-false");
      return
    }
    println("reload keys={record_keys(h)}");
  } else {
    println("FAIL unknown-mode")
  }
}
