// Regression for @P378(a) — returning a keyed-collection (hash) bearing struct
// from a function called in a loop must not corrupt the allocator.
//
// Root cause (fixed in src/scopes.rs): the callee's heap return value is
// written into a caller-provided `__ref_N` return buffer (ref_return).  In a
// loop, that buffer was reserved ONCE at function scope, but the witness `bs`
// that adopts the buffer's store was freed EVERY iteration (loop-body scope).
// Freeing `bs` released the buffer's store; `find_free_slot` then recycled
// that store to the callee's own temp on the next iteration, so two
// `OpDatabase` targets collided on one record — the keyed value ended up
// aliasing the collection itself (`value == coll`), a self-referential insert
// that SIGSEGV'd at the hash op under `--interpret` (native happened to differ).
//
// Fix: when the witness is INNER-scoped relative to the buffer, its
// per-iteration free is emitted as `OpFreeRefIfDistinct(bs, __ref_N)` — a
// no-op while they alias (the buffer stays reserved across iterations and is
// freed once at function exit), a real free in the fresh-store case.

struct Item {
  ik: integer,
}
struct Bag {
  items: hash<Item[ik]>,
}

fn alloc_bag(seed: integer) -> Bag {
  b = Bag { items: [] };
  b.items[seed] = Item { ik: seed };
  b
}

// The minimal crashing shape: build+return a hash-bearing struct in a loop,
// consume each result.  Pre-fix this SIGSEGV'd on the 2nd/3rd iteration.
fn test_p378a_keyed_return_buffer_loop() {
  for ci in 0..10 {
    bs = alloc_bag(ci);
    it = bs.items[ci];
    assert(it != null, "p378a: lookup null at ci={ci}");
    assert(it.ik == ci, "p378a: ik={it.ik} expected {ci}");
  }
}

// Sibling: keep the returned value alive across the iteration and read it after
// other allocations, exercising that the buffer store really is independent.
fn test_p378a_returned_bag_independent() {
  total = 0;
  for ci in 0..6 {
    bs = alloc_bag(ci * 2);
    other = alloc_bag(ci * 2 + 1);
    a = bs.items[ci * 2];
    b = other.items[ci * 2 + 1];
    assert(a != null && b != null, "p378a indep: null at ci={ci}");
    total = total + a.ik + b.ik;
  }
  // sum of 0..12 = 66
  assert(total == 66, "p378a indep: total={total} (expect 66)");
}
