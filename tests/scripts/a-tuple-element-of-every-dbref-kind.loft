//
// A tuple element that travels as a `DbRef` takes the `OpPutRef` / null-sentinel path,
// and the membership question — WHICH types are DbRef-shaped — is `data::is_dbref`'s.
// Its doc comment states how an inline spelling of that list goes wrong: the three
// obvious kinds (`Reference` / `Vector` / struct-`Enum`) get written and the five keyed
// collections are forgotten, because they are reached by key and do not look like
// references at the call site.
//
// Three of the four tuple emitters had exactly that short list, so a keyed collection in
// a tuple reached the catch-all and aborted the compiler:
// `emit_tuple_put_ops: unsupported elem Hash(710, ["n"], …)`. The fourth,
// `emit_tuple_var_push_recursive`, already named every kind — which is why the tuple
// could be READ back but never written. The same family had already drifted once the
// other way (loft#808: `character` and payload-less `enum` were in three of the four and
// missing from null-init), so the cure is the shared predicate, not a fourth copy of the
// list.

struct Dk { n: integer, k: text, v: vector<integer> }

// One cell per keyed kind, each exercising the write (tuple construction), the read
// (`t.0`) and the scalar neighbour that shares the slot arithmetic.
fn dk_hash() -> integer {
  h: hash<Dk[n]> = [Dk { n: 10, k: "a", v: [1] }, Dk { n: 20, k: "b", v: [2] }];
  t = (h, 7);
  len(t.0) * 10 + t.1
}

fn dk_sorted() -> integer {
  s: sorted<Dk[n]> = [Dk { n: 10, k: "a", v: [1] }, Dk { n: 20, k: "b", v: [2] }];
  t = (s, 7);
  len(t.0) * 10 + t.1
}

fn dk_index() -> integer {
  i: index<Dk[n]> = [Dk { n: 10, k: "a", v: [1] }, Dk { n: 20, k: "b", v: [2] }];
  t = (i, 7);
  len(t.0) * 10 + t.1
}

fn dk_trie() -> integer {
  r: trie<Dk[k]> = [Dk { n: 10, k: "a", v: [1] }, Dk { n: 20, k: "b", v: [2] }];
  t = (r, 7);
  len(t.0) * 10 + t.1
}

// DESTRUCTURING pops each element back out — the emitter that answers a different
// question about the same slot, so a short list there fails where construction did not.
fn dk_destructure() -> integer {
  h: hash<Dk[n]> = [Dk { n: 10, k: "a", v: [1] }, Dk { n: 20, k: "b", v: [2] }];
  t = (h, 7);
  (coll, tag) = t;
  len(coll) * 10 + tag
}

// A keyed element beside a SECOND heap element, so the slot arithmetic has to be right
// for both rather than only for the one at offset 0.
fn dk_two_heap() -> integer {
  h: hash<Dk[n]> = [Dk { n: 10, k: "a", v: [1] }];
  vs: vector<integer> = [4, 5, 6];
  t = (h, vs);
  len(t.0) * 10 + len(t.1)
}

// CONTROL: the three kinds the short list DID name must keep answering.
fn dk_vector() -> integer {
  v: vector<integer> = [1, 2, 3];
  t = (v, 7);
  len(t.0) * 10 + t.1
}

fn dk_struct() -> integer {
  s = Dk { n: 3, k: "a", v: [1] };
  t = (s, 7);
  t.0.n * 10 + t.1
}

fn main() {
  assert(dk_hash() == 27, "hash = {dk_hash()}, want 27");
  assert(dk_sorted() == 27, "sorted = {dk_sorted()}, want 27");
  assert(dk_index() == 27, "index = {dk_index()}, want 27");
  assert(dk_trie() == 27, "trie = {dk_trie()}, want 27");
  assert(dk_destructure() == 27, "destructure = {dk_destructure()}, want 27");
  assert(dk_two_heap() == 13, "two-heap = {dk_two_heap()}, want 13");
  assert(dk_vector() == 37, "vector = {dk_vector()}, want 37");
  assert(dk_struct() == 37, "struct = {dk_struct()}, want 37");
}
