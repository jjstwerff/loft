//
// Regression (loft#775) — publishing a struct FIELD through a `&` parameter.
//
// A `&` parameter is the callee's second way to hand a value back, and a
// whole-binding write TRANSFERS a store to the caller, who then owns and frees it
// (@PLN87 P2.2).  A field read is not a store — it is a VIEW into the record that
// holds the field — so `out = ld.wl_world` published a pointer into a local the
// frame frees on the way out.  The caller kept reading it, and the next allocation
// landed on top.
//
// The three lenses disagreed, which is why it survived: `--interpret` reported the
// store as unfreed and faulted under `LOFT_POISON=1`, while `--native` silently
// answered with whatever had been allocated since.  The filed instance is a server
// whose four-chunk world became empty across a call that never touches its
// argument, with the edit clock — monotonic — running BACKWARDS.
//
// `return ld.wl_world` was already safe, because `materialize_view_return` copies a
// viewed record into an owned buffer at the return.  This is that move for the
// other escape route.
//
// The churn below matters: a freed record usually still reads correctly until
// something else claims its bytes, so the loop recycles stores and is what turns
// "probably fine" into a decided answer.

struct World775 { w_tau: integer, w_chunks: vector<integer> }
struct WorldLoad775 { wl_world: World775, wl_ok: boolean }
struct Session775 { s_world: World775, s_n: integer }

fn world_new(t: integer) -> World775 { return World775 { w_tau: t, w_chunks: [] }; }

fn world_load(t: integer) -> WorldLoad775 {
  w = world_new(t);
  w.w_chunks += [1];
  w.w_chunks += [2];
  w.w_chunks += [3];
  w.w_chunks += [4];
  return WorldLoad775 { wl_world: w, wl_ok: true };
}

// The failing shape: the owner `ld` dies at this frame's exit, and the field it
// holds is published through the `&` parameter.
fn fill(out: &World775, t: integer) { ld = world_load(t); out = ld.wl_world; }

// The neighbour that was already correct — a WHOLE record, not a view into one.
// It must stay correct, because the fix adds a copy on one of these two paths.
fn fill_fresh(out: &World775, t: integer) { out = world_new(t); }

// The other escape route, safe before this fix and after it.
fn via_return(t: integer) -> World775 { ld = world_load(t); return ld.wl_world; }

// Recycle stores so a record freed too early is handed out again rather than
// sitting undisturbed with its bytes still readable.
fn churn(n: integer) -> integer {
  a = world_load(n);
  b = world_load(n + 1);
  c = world_load(n + 2);
  return a.wl_world.w_tau + b.wl_world.w_tau + c.wl_world.w_tau;
}

fn main() {
  // The `&` write-back of a field, read back after eight rounds of churn.
  wld = world_new(0);
  fill(wld, 20);
  assert(wld.w_tau == 20, "amp field: tau before churn is {wld.w_tau}, want 20");
  assert(wld.w_chunks.len() == 4, "amp field: {wld.w_chunks.len()} chunks before churn, want 4");

  z = 0;
  for i in 0..8 { z = z + churn(100 + i * 3); }
  assert(z == 2676, "churn total {z}, want 2676");

  assert(wld.w_tau == 20, "amp field: tau after churn is {wld.w_tau}, want 20");
  assert(wld.w_chunks.len() == 4, "amp field: {wld.w_chunks.len()} chunks after churn, want 4");
  assert(wld.w_chunks[3] == 4, "amp field: last chunk is {wld.w_chunks[3]}, want 4");

  // A fresh record through the same `&` parameter still transfers, and the caller
  // still owns it.
  fr = world_new(0);
  fill_fresh(fr, 77);
  z2 = 0;
  for i in 0..4 { z2 = z2 + churn(200 + i * 3); }
  assert(fr.w_tau == 77, "amp fresh: tau is {fr.w_tau}, want 77 (z2={z2})");

  // The return route, for the same shape.
  rv = via_return(31);
  for i in 0..4 { z2 = z2 + churn(300 + i * 3); }
  assert(rv.w_tau == 31, "via return: tau is {rv.w_tau}, want 31");
  assert(rv.w_chunks.len() == 4, "via return: {rv.w_chunks.len()} chunks, want 4");

  // The copy is a COPY: writing the caller's binding must not reach back into
  // anything the callee still held.
  wld.w_tau = 55;
  wld.w_chunks += [5];
  assert(wld.w_tau == 55, "after write: tau is {wld.w_tau}, want 55");
  assert(wld.w_chunks.len() == 5, "after write: {wld.w_chunks.len()} chunks, want 5");

  println("775 amp field-writeback view OK");
}
