//
// @PLN123 — the two refusals on the plan's composition matrix that shipped
// without a test: F4 (a durable `.dmeta` sidecar) and F6 (the image floor).
//
// F4 is the one that mattered.  A sidecar records the main file's byte LENGTH
// and CRC, so shortening or rewriting the file behind its back turns a healthy
// store into a corrupt one at the next `store_durable_check`.  Both
// `store_reclaim` (truncates) and compaction-at-load (rewrites) must decline.
//
// ORDER MATTERS IN THIS SCRIPT.  Iterating a keyed collection materialises a
// key-sorted snapshot, and for a BOUND collection that snapshot is claimed
// inside the store — which changes the file's bytes and so invalidates a seal
// all by itself (measured: bare re-bind keeps `check true`; one traversal makes
// it false with the file length unchanged).  So every `store_durable_check` here
// happens BEFORE anything walks the collection.
//
// Env in:
//   LOFT_PERSIST_TEST_PATH   the store file
//   MODE                     "" (write + reclaim) | reload
//   SEAL                     "1" to `store_durable_seal` after binding
//   GROW                     "1" to grow and drop again AFTER binding
//   N                        records (default 3000, kept: N/10)

struct Rec { const id: integer, const label: text }

fn count(h: hash<Rec[id]>) -> integer { n = 0; for c in h { n += c.id * 0 + 1 } n }

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH") ?? "";
  if path == "" { println("no path"); return }
  mode = env_variable("MODE") ?? "";
  seal = (env_variable("SEAL") ?? "") == "1";
  n = (env_variable("N") ?? "") as integer ?? 3000;

  if mode == "reload" {
    back: hash<Rec[id]> = [];
    if !store_persist_bind(back, path) { println("FAIL rebind"); return }
    bytes = file(path).size;
    check = store_durable_check(path);
    println("rebound bytes {bytes} check {check} count {count(back)}");
    return
  }

  h: hash<Rec[id]> = [];
  for i in 0..n { h += [Rec { id: i, label: "label-{i}" }] }
  for d in (n / 10)..n { h[d] = null }
  if !store_persist_bind(h, path) { println("FAIL bind"); return }
  if seal { store_durable_seal(path); }
  if (env_variable("GROW") ?? "") == "1" {
    // Give the store a REAL tail, for the control that has to see reclaim do
    // its job.  A store that came straight from `bind_path` has no tail to give
    // back — the image is written at the mark plus an eighth, and that eighth is
    // exactly what a right-sized store keeps — so `freed 0` there is the correct
    // answer, not a refusal.  A tail only appears when the store GROWS while
    // bound: the arena over-allocates by 7/3, and dropping the records again
    // leaves that over-allocation above the mark.  (Unsealed only: growing the
    // file after a seal invalidates it, which is what the F4 case is about.)
    for g in n..(n * 2) { h += [Rec { id: g, label: "label-{g}" }] }
    for g in n..(n * 2) { h[g] = null }
  }
  before = file(path).size;
  check_before = store_durable_check(path);

  freed = store_reclaim(h);
  after = file(path).size;
  check_after = store_durable_check(path);
  println("seal {seal} before {before} freed {freed} after {after} check_before {check_before} check_after {check_after}");
  // The traversal goes LAST: it writes into the bound store and would flip the
  // check above if it ran first.
  println("live {count(h)}");
}
