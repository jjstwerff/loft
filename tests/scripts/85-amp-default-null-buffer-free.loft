// @PLN85 t2 — a `&D = null` default param owns a hidden materialisation buffer
// `__ref_N`.  The buffer is marked `skip_free` (its store TRANSFERS to the caller
// on the `if !r { r = D{..} }` write-back — objects.rs:2200), yet interp eagerly
// null-init'd it with an ALLOCATING OpInitRef; on the common path where `r` is
// non-null the write-back never runs, so that placeholder store orphaned once per
// call (the DA-inventory t2 leak, kt=65535, interp-only — native lowers null to
// DbRef::NULL).  Fix (codegen.rs gen_set_first_ref_null): a skip_free var must
// null-init as a SENTINEL, never an owned placeholder — nobody frees it.  Values
// assert on both backends; the wrap leak-gate proves no per-call orphan.

struct Data { num: integer, values: vector<integer> }

fn add(r: &Data = null, val: integer) {
    if !r { r = Data { num: 0 }; }
    r.num += val;
    r.values += [val];
}

// A second shape: conditional write-back with NO trailing vector append (no
// `_elm_N` slot reuse) — proves the leak was the buffer's null-init, not the reuse.
fn bump(r: &Data = null, val: integer) {
    if !r { r = Data { num: 0 }; }
    r.num += val;
}

fn main() {
    v = Data { num: 1 };
    add(v, 2);
    add(v, 3);
    add(v, 4);
    assert(v.num == 10, "num {v.num}");
    assert(len(v.values) == 3, "len {len(v.values)}");

    w = Data { num: 100 };
    bump(w, 5);
    bump(w, 6);
    assert(w.num == 111, "bump {w.num}");

    println("amp-default-null-buffer-free ok");
}
