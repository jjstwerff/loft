//
// loft#734 — an interface method that returns NOTHING, reached through a bounded
// generic.
//
// The stub the parser registers for such a method never had its return type set,
// so it kept the definition's default `Unknown` — which the native generator
// renders as `??`:
//
//   fn __iface_651_shut(cell: &UnsafeCell<Stores>, mut var_self: DbRef) -> ?? {
//
// Invalid Rust, so ANY interface carrying a `close` / `shut` / `flush` method
// could not be compiled at all. `--interpret` never asked for the type and ran
// correctly, which is exactly what kept it hidden: a one-backend failure on a
// shape that is ordinary rather than exotic — a resource-holding interface
// almost always has one.
//
// Both a void method and a value-returning one are here, because the fix sets a
// type that was previously left alone and must not disturb the case that worked.

interface I734Closable {
  fn i734_shut(self: Self)
  fn i734_tag(self: Self) -> text
}

struct I734Res { open_count: integer }

fn i734_shut(self: I734Res) { self.open_count = 0; }
fn i734_tag(self: I734Res) -> text { return "res"; }

// The generic never names the concrete type — the dispatch that needed the stub.
fn i734_close_it <T: I734Closable> (t: T) { t.i734_shut(); }
fn i734_label <T: I734Closable> (t: T) -> text { return t.i734_tag(); }

fn main() {
  r = I734Res { open_count: 3 };
  assert(i734_label(r) == "res", "734: a value-returning interface method still works");
  i734_close_it(r);
  assert(r.open_count == 0, "734: the void interface method ran and mutated self");
}
