//
// A projection rooted in a KEYED container is a borrow witness at every keyed kind.
//
// A call whose return may BORROW an argument decides borrow-vs-owned at runtime with the
// @P290 bracket, and the bracket has to NAME the argument's store.  What it can name is
// decided by two things at once: the KIND of container the argument is rooted in, and the
// SPELLING that reaches into it.  Those are two axes, and a matrix that moves one while
// pinning the other answers for a line through the grid rather than for the grid.
//
// `./scripts/matrix_axes.py cross A1 A3` measures how far the corpus crosses them, and the
// answer is why this file exists: `spatial` is reached by 20 of 892 guards at all, and its
// thinnest pairs -- with a `??` result, a tuple element, a call result, a chain -- are 3, 4,
// 5 and 7 files.  Spatial supports `sp[x, y]` element access, so those are gaps and not
// impossibilities.  Every cell here was clean when it was written: this is COVERAGE, and its
// control record says so rather than pretending to be a regression lock.
//
// The cross first reported two of those cells at ZERO, and the zero was the tool's own
// classifier labelling `sp[x, y].t.0` with whichever spelling it tested for first.  This
// file is what caught it -- an instrument reporting an absence can be checked by building
// the thing it says does not exist and asking again.
//
// The `??` cell reaches a NULLABLE field: on a non-null one the compiler elides the
// coalesce as redundant and says so, which would leave five cells claiming to exercise a
// spelling the program no longer contains.
//
// A THIRD axis is crossed with those two, and the census is why.  Run
// `matrix_axes.py file` on this file's first draft and it answers `A2 container provenance
// 1/4 -- reaches local-literal`: every cell built its container inside the function that
// then indexed it.  That is the axis loft#1105's matrix pinned, and pinning it is what hid
// an over-free, because a container that dies with the frame cannot witness a free that
// outlives it.  So each cell exists twice: `_l` builds the container where it indexes it,
// and `_p` receives one the CALLER built and keeps alive across all 12 rounds.
//
// Each kind carries a different payload (7 / 11 / 13 / 17 / 19) so a cell reading another
// kind's record shows up as a wrong number instead of passing on a shared value.
//
// @falsified-at: none — INERT, and measured rather than assumed: `make falsify
// GUARD=… REF=94bbd860` reports `0|0|none|none` on both trees on both backends.  That is
// the honest answer, because these pairs were never WRONG — they were never CROSSED.  A
// control record naming a channel here would be a false claim of regression cover.  What
// this guard can catch is a FUTURE build, which is what coverage is for.
//
// Two things make the INERT verdict readable rather than the mislabelling B6p warns about.
// The file has a `main`, so it runs under `--interpret` and the leak column is the live
// one, not the blind shape a `main`-less guard gets.  And the cells are not vacuous: six
// were mutated by moving the expected total by one, and all six fail on the assert channel.
//
// Still pinned, deliberately: provenance reaches `local-literal` and `parameter` and not
// `global` or `callee-return`, and every cell sits in a loop body.  Naming that here is
// worth little on its own -- an axis named in a closure is not an axis measured by it --
// so the standing check is `matrix_axes.py file` on this path, which re-derives the list
// from the language's domains and will keep reporting the two gaps until someone closes
// them.

struct PkIn { a: integer = 0 }
struct PkRec { k: integer = 0, px: integer = 0, py: integer = 0, w: PkIn, n: PkIn?, t: (text, text) }
fn pk_mk() -> PkIn { PkIn { a: -1 } }
fn pk_pick(s: PkIn, c: boolean) -> PkIn { if c { s } else { pk_mk() } }
fn pk_pickt(s: text, c: boolean) -> text { if c { s } else { "z" } }

fn pk_vector_chain_l(c: boolean) -> integer {
  v: vector<PkRec> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 7 }, n: PkIn { a: 7 }, t: ("xxxxxxx", "n") }];
  pk_pick(v[0].w, c).a
}
fn pk_vector_chain_p(v: vector<PkRec>, c: boolean) -> integer { pk_pick(v[0].w, c).a }
fn pk_vector_tuple_l(c: boolean) -> integer {
  v: vector<PkRec> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 7 }, n: PkIn { a: 7 }, t: ("xxxxxxx", "n") }];
  len(pk_pickt(v[0].t.0, c))
}
fn pk_vector_tuple_p(v: vector<PkRec>, c: boolean) -> integer { len(pk_pickt(v[0].t.0, c)) }
fn pk_vector_coal_l(c: boolean) -> integer {
  v: vector<PkRec> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 7 }, n: PkIn { a: 7 }, t: ("xxxxxxx", "n") }];
  pk_pick(v[0].n ?? pk_mk(), c).a
}
fn pk_vector_coal_p(v: vector<PkRec>, c: boolean) -> integer { pk_pick(v[0].n ?? pk_mk(), c).a }
fn pk_hash_chain_l(c: boolean) -> integer {
  v: hash<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 11 }, n: PkIn { a: 11 }, t: ("xxxxxxxxxxx", "n") }];
  pk_pick(v[1].w, c).a
}
fn pk_hash_chain_p(v: hash<PkRec[k]>, c: boolean) -> integer { pk_pick(v[1].w, c).a }
fn pk_hash_tuple_l(c: boolean) -> integer {
  v: hash<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 11 }, n: PkIn { a: 11 }, t: ("xxxxxxxxxxx", "n") }];
  len(pk_pickt(v[1].t.0, c))
}
fn pk_hash_tuple_p(v: hash<PkRec[k]>, c: boolean) -> integer { len(pk_pickt(v[1].t.0, c)) }
fn pk_hash_coal_l(c: boolean) -> integer {
  v: hash<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 11 }, n: PkIn { a: 11 }, t: ("xxxxxxxxxxx", "n") }];
  pk_pick(v[1].n ?? pk_mk(), c).a
}
fn pk_hash_coal_p(v: hash<PkRec[k]>, c: boolean) -> integer { pk_pick(v[1].n ?? pk_mk(), c).a }
fn pk_sorted_chain_l(c: boolean) -> integer {
  v: sorted<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 13 }, n: PkIn { a: 13 }, t: ("xxxxxxxxxxxxx", "n") }];
  pk_pick(v[1].w, c).a
}
fn pk_sorted_chain_p(v: sorted<PkRec[k]>, c: boolean) -> integer { pk_pick(v[1].w, c).a }
fn pk_sorted_tuple_l(c: boolean) -> integer {
  v: sorted<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 13 }, n: PkIn { a: 13 }, t: ("xxxxxxxxxxxxx", "n") }];
  len(pk_pickt(v[1].t.0, c))
}
fn pk_sorted_tuple_p(v: sorted<PkRec[k]>, c: boolean) -> integer { len(pk_pickt(v[1].t.0, c)) }
fn pk_sorted_coal_l(c: boolean) -> integer {
  v: sorted<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 13 }, n: PkIn { a: 13 }, t: ("xxxxxxxxxxxxx", "n") }];
  pk_pick(v[1].n ?? pk_mk(), c).a
}
fn pk_sorted_coal_p(v: sorted<PkRec[k]>, c: boolean) -> integer { pk_pick(v[1].n ?? pk_mk(), c).a }
fn pk_index_chain_l(c: boolean) -> integer {
  v: index<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 17 }, n: PkIn { a: 17 }, t: ("xxxxxxxxxxxxxxxxx", "n") }];
  pk_pick(v[1].w, c).a
}
fn pk_index_chain_p(v: index<PkRec[k]>, c: boolean) -> integer { pk_pick(v[1].w, c).a }
fn pk_index_tuple_l(c: boolean) -> integer {
  v: index<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 17 }, n: PkIn { a: 17 }, t: ("xxxxxxxxxxxxxxxxx", "n") }];
  len(pk_pickt(v[1].t.0, c))
}
fn pk_index_tuple_p(v: index<PkRec[k]>, c: boolean) -> integer { len(pk_pickt(v[1].t.0, c)) }
fn pk_index_coal_l(c: boolean) -> integer {
  v: index<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 17 }, n: PkIn { a: 17 }, t: ("xxxxxxxxxxxxxxxxx", "n") }];
  pk_pick(v[1].n ?? pk_mk(), c).a
}
fn pk_index_coal_p(v: index<PkRec[k]>, c: boolean) -> integer { pk_pick(v[1].n ?? pk_mk(), c).a }
fn pk_spatial_chain_l(c: boolean) -> integer {
  v: spatial<PkRec[px, py]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 19 }, n: PkIn { a: 19 }, t: ("xxxxxxxxxxxxxxxxxxx", "n") }];
  pk_pick(v[3, 6].w, c).a
}
fn pk_spatial_chain_p(v: spatial<PkRec[px, py]>, c: boolean) -> integer { pk_pick(v[3, 6].w, c).a }
fn pk_spatial_tuple_l(c: boolean) -> integer {
  v: spatial<PkRec[px, py]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 19 }, n: PkIn { a: 19 }, t: ("xxxxxxxxxxxxxxxxxxx", "n") }];
  len(pk_pickt(v[3, 6].t.0, c))
}
fn pk_spatial_tuple_p(v: spatial<PkRec[px, py]>, c: boolean) -> integer { len(pk_pickt(v[3, 6].t.0, c)) }
fn pk_spatial_coal_l(c: boolean) -> integer {
  v: spatial<PkRec[px, py]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 19 }, n: PkIn { a: 19 }, t: ("xxxxxxxxxxxxxxxxxxx", "n") }];
  pk_pick(v[3, 6].n ?? pk_mk(), c).a
}
fn pk_spatial_coal_p(v: spatial<PkRec[px, py]>, c: boolean) -> integer { pk_pick(v[3, 6].n ?? pk_mk(), c).a }

fn main() {
  vector_chain_l = 0;
  for _ in 0..12 { vector_chain_l += pk_vector_chain_l(true) + pk_vector_chain_l(false) }
  assert(vector_chain_l == 72, "vector x chain x local: 12 rounds of 7 + -1, got {vector_chain_l}");
  vector_chain_v: vector<PkRec> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 7 }, n: PkIn { a: 7 }, t: ("xxxxxxx", "n") }];
  vector_chain_p = 0;
  for _ in 0..12 { vector_chain_p += pk_vector_chain_p(vector_chain_v, true) + pk_vector_chain_p(vector_chain_v, false) }
  assert(vector_chain_p == 72, "vector x chain x parameter: 12 rounds of 7 + -1, got {vector_chain_p}");

  vector_tuple_l = 0;
  for _ in 0..12 { vector_tuple_l += pk_vector_tuple_l(true) + pk_vector_tuple_l(false) }
  assert(vector_tuple_l == 96, "vector x tuple x local: 12 rounds of 7 + 1, got {vector_tuple_l}");
  vector_tuple_v: vector<PkRec> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 7 }, n: PkIn { a: 7 }, t: ("xxxxxxx", "n") }];
  vector_tuple_p = 0;
  for _ in 0..12 { vector_tuple_p += pk_vector_tuple_p(vector_tuple_v, true) + pk_vector_tuple_p(vector_tuple_v, false) }
  assert(vector_tuple_p == 96, "vector x tuple x parameter: 12 rounds of 7 + 1, got {vector_tuple_p}");

  vector_coal_l = 0;
  for _ in 0..12 { vector_coal_l += pk_vector_coal_l(true) + pk_vector_coal_l(false) }
  assert(vector_coal_l == 72, "vector x coal x local: 12 rounds of 7 + -1, got {vector_coal_l}");
  vector_coal_v: vector<PkRec> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 7 }, n: PkIn { a: 7 }, t: ("xxxxxxx", "n") }];
  vector_coal_p = 0;
  for _ in 0..12 { vector_coal_p += pk_vector_coal_p(vector_coal_v, true) + pk_vector_coal_p(vector_coal_v, false) }
  assert(vector_coal_p == 72, "vector x coal x parameter: 12 rounds of 7 + -1, got {vector_coal_p}");

  hash_chain_l = 0;
  for _ in 0..12 { hash_chain_l += pk_hash_chain_l(true) + pk_hash_chain_l(false) }
  assert(hash_chain_l == 120, "hash x chain x local: 12 rounds of 11 + -1, got {hash_chain_l}");
  hash_chain_v: hash<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 11 }, n: PkIn { a: 11 }, t: ("xxxxxxxxxxx", "n") }];
  hash_chain_p = 0;
  for _ in 0..12 { hash_chain_p += pk_hash_chain_p(hash_chain_v, true) + pk_hash_chain_p(hash_chain_v, false) }
  assert(hash_chain_p == 120, "hash x chain x parameter: 12 rounds of 11 + -1, got {hash_chain_p}");

  hash_tuple_l = 0;
  for _ in 0..12 { hash_tuple_l += pk_hash_tuple_l(true) + pk_hash_tuple_l(false) }
  assert(hash_tuple_l == 144, "hash x tuple x local: 12 rounds of 11 + 1, got {hash_tuple_l}");
  hash_tuple_v: hash<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 11 }, n: PkIn { a: 11 }, t: ("xxxxxxxxxxx", "n") }];
  hash_tuple_p = 0;
  for _ in 0..12 { hash_tuple_p += pk_hash_tuple_p(hash_tuple_v, true) + pk_hash_tuple_p(hash_tuple_v, false) }
  assert(hash_tuple_p == 144, "hash x tuple x parameter: 12 rounds of 11 + 1, got {hash_tuple_p}");

  hash_coal_l = 0;
  for _ in 0..12 { hash_coal_l += pk_hash_coal_l(true) + pk_hash_coal_l(false) }
  assert(hash_coal_l == 120, "hash x coal x local: 12 rounds of 11 + -1, got {hash_coal_l}");
  hash_coal_v: hash<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 11 }, n: PkIn { a: 11 }, t: ("xxxxxxxxxxx", "n") }];
  hash_coal_p = 0;
  for _ in 0..12 { hash_coal_p += pk_hash_coal_p(hash_coal_v, true) + pk_hash_coal_p(hash_coal_v, false) }
  assert(hash_coal_p == 120, "hash x coal x parameter: 12 rounds of 11 + -1, got {hash_coal_p}");

  sorted_chain_l = 0;
  for _ in 0..12 { sorted_chain_l += pk_sorted_chain_l(true) + pk_sorted_chain_l(false) }
  assert(sorted_chain_l == 144, "sorted x chain x local: 12 rounds of 13 + -1, got {sorted_chain_l}");
  sorted_chain_v: sorted<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 13 }, n: PkIn { a: 13 }, t: ("xxxxxxxxxxxxx", "n") }];
  sorted_chain_p = 0;
  for _ in 0..12 { sorted_chain_p += pk_sorted_chain_p(sorted_chain_v, true) + pk_sorted_chain_p(sorted_chain_v, false) }
  assert(sorted_chain_p == 144, "sorted x chain x parameter: 12 rounds of 13 + -1, got {sorted_chain_p}");

  sorted_tuple_l = 0;
  for _ in 0..12 { sorted_tuple_l += pk_sorted_tuple_l(true) + pk_sorted_tuple_l(false) }
  assert(sorted_tuple_l == 168, "sorted x tuple x local: 12 rounds of 13 + 1, got {sorted_tuple_l}");
  sorted_tuple_v: sorted<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 13 }, n: PkIn { a: 13 }, t: ("xxxxxxxxxxxxx", "n") }];
  sorted_tuple_p = 0;
  for _ in 0..12 { sorted_tuple_p += pk_sorted_tuple_p(sorted_tuple_v, true) + pk_sorted_tuple_p(sorted_tuple_v, false) }
  assert(sorted_tuple_p == 168, "sorted x tuple x parameter: 12 rounds of 13 + 1, got {sorted_tuple_p}");

  sorted_coal_l = 0;
  for _ in 0..12 { sorted_coal_l += pk_sorted_coal_l(true) + pk_sorted_coal_l(false) }
  assert(sorted_coal_l == 144, "sorted x coal x local: 12 rounds of 13 + -1, got {sorted_coal_l}");
  sorted_coal_v: sorted<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 13 }, n: PkIn { a: 13 }, t: ("xxxxxxxxxxxxx", "n") }];
  sorted_coal_p = 0;
  for _ in 0..12 { sorted_coal_p += pk_sorted_coal_p(sorted_coal_v, true) + pk_sorted_coal_p(sorted_coal_v, false) }
  assert(sorted_coal_p == 144, "sorted x coal x parameter: 12 rounds of 13 + -1, got {sorted_coal_p}");

  index_chain_l = 0;
  for _ in 0..12 { index_chain_l += pk_index_chain_l(true) + pk_index_chain_l(false) }
  assert(index_chain_l == 192, "index x chain x local: 12 rounds of 17 + -1, got {index_chain_l}");
  index_chain_v: index<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 17 }, n: PkIn { a: 17 }, t: ("xxxxxxxxxxxxxxxxx", "n") }];
  index_chain_p = 0;
  for _ in 0..12 { index_chain_p += pk_index_chain_p(index_chain_v, true) + pk_index_chain_p(index_chain_v, false) }
  assert(index_chain_p == 192, "index x chain x parameter: 12 rounds of 17 + -1, got {index_chain_p}");

  index_tuple_l = 0;
  for _ in 0..12 { index_tuple_l += pk_index_tuple_l(true) + pk_index_tuple_l(false) }
  assert(index_tuple_l == 216, "index x tuple x local: 12 rounds of 17 + 1, got {index_tuple_l}");
  index_tuple_v: index<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 17 }, n: PkIn { a: 17 }, t: ("xxxxxxxxxxxxxxxxx", "n") }];
  index_tuple_p = 0;
  for _ in 0..12 { index_tuple_p += pk_index_tuple_p(index_tuple_v, true) + pk_index_tuple_p(index_tuple_v, false) }
  assert(index_tuple_p == 216, "index x tuple x parameter: 12 rounds of 17 + 1, got {index_tuple_p}");

  index_coal_l = 0;
  for _ in 0..12 { index_coal_l += pk_index_coal_l(true) + pk_index_coal_l(false) }
  assert(index_coal_l == 192, "index x coal x local: 12 rounds of 17 + -1, got {index_coal_l}");
  index_coal_v: index<PkRec[k]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 17 }, n: PkIn { a: 17 }, t: ("xxxxxxxxxxxxxxxxx", "n") }];
  index_coal_p = 0;
  for _ in 0..12 { index_coal_p += pk_index_coal_p(index_coal_v, true) + pk_index_coal_p(index_coal_v, false) }
  assert(index_coal_p == 192, "index x coal x parameter: 12 rounds of 17 + -1, got {index_coal_p}");

  spatial_chain_l = 0;
  for _ in 0..12 { spatial_chain_l += pk_spatial_chain_l(true) + pk_spatial_chain_l(false) }
  assert(spatial_chain_l == 216, "spatial x chain x local: 12 rounds of 19 + -1, got {spatial_chain_l}");
  spatial_chain_v: spatial<PkRec[px, py]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 19 }, n: PkIn { a: 19 }, t: ("xxxxxxxxxxxxxxxxxxx", "n") }];
  spatial_chain_p = 0;
  for _ in 0..12 { spatial_chain_p += pk_spatial_chain_p(spatial_chain_v, true) + pk_spatial_chain_p(spatial_chain_v, false) }
  assert(spatial_chain_p == 216, "spatial x chain x parameter: 12 rounds of 19 + -1, got {spatial_chain_p}");

  spatial_tuple_l = 0;
  for _ in 0..12 { spatial_tuple_l += pk_spatial_tuple_l(true) + pk_spatial_tuple_l(false) }
  assert(spatial_tuple_l == 240, "spatial x tuple x local: 12 rounds of 19 + 1, got {spatial_tuple_l}");
  spatial_tuple_v: spatial<PkRec[px, py]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 19 }, n: PkIn { a: 19 }, t: ("xxxxxxxxxxxxxxxxxxx", "n") }];
  spatial_tuple_p = 0;
  for _ in 0..12 { spatial_tuple_p += pk_spatial_tuple_p(spatial_tuple_v, true) + pk_spatial_tuple_p(spatial_tuple_v, false) }
  assert(spatial_tuple_p == 240, "spatial x tuple x parameter: 12 rounds of 19 + 1, got {spatial_tuple_p}");

  spatial_coal_l = 0;
  for _ in 0..12 { spatial_coal_l += pk_spatial_coal_l(true) + pk_spatial_coal_l(false) }
  assert(spatial_coal_l == 216, "spatial x coal x local: 12 rounds of 19 + -1, got {spatial_coal_l}");
  spatial_coal_v: spatial<PkRec[px, py]> = [PkRec { k: 1, px: 3, py: 6, w: PkIn { a: 19 }, n: PkIn { a: 19 }, t: ("xxxxxxxxxxxxxxxxxxx", "n") }];
  spatial_coal_p = 0;
  for _ in 0..12 { spatial_coal_p += pk_spatial_coal_p(spatial_coal_v, true) + pk_spatial_coal_p(spatial_coal_v, false) }
  assert(spatial_coal_p == 216, "spatial x coal x parameter: 12 rounds of 19 + -1, got {spatial_coal_p}");
}
