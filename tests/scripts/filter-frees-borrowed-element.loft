//
// `filter` freed the SOURCE's records, so a later loop over the same collection answered
// nothing — silently, on both backends.
//
// The comprehension's per-iteration yield slot is created with the bare element type, which
// carries no deps, so scope handling reads it as an OWNER and frees it at the end of every
// iteration.  For `map` that is right: the body is a call and the slot owns its result.
// `filter`'s body IS the loop element — the identity yield is what makes it a filter — so
// the slot was an ALIAS of a borrow of the source, and freeing it destroyed the record the
// source still pointed at.
//
// Invisible on a scalar element, whose copy is the value itself.  On a `vector<vector<T>>`
// the freed records left the source unreadable: `len(nv)` still answered 2 (the header is
// untouched) while a fresh loop over it yielded 0, which is the shape that makes this a
// wrong ANSWER rather than a crash.
//
// A variable bound to a borrow is a borrow, so the slot now carries the body variable's
// deps whenever the body is a bare variable that has any.

fn test_filter_leaves_a_nested_source_readable() {
  nv = [[1], [2]];
  f = filter(nv, |x| { true });
  assert(len(f) == 2, "filter keeps both elements");
  // The source must still iterate — this answered 0 before.
  c = [for x in nv { 1 }];
  assert(len(c) == 2, "a comprehension over the source after filter sees both elements");
  m = map(nv, |x| { len(x) });
  assert(len(m) == 2, "map over the source after filter sees both elements");
  g = filter(nv, |x| { true });
  assert(len(g) == 2, "a second filter over the source sees both elements");
}

fn test_filter_result_is_still_correct() {
  nv = [[1], [2], [3]];
  f = filter(nv, |x| { len(x) > 0 });
  assert(len(f) == 3, "every element passes the predicate");
  assert(len(f[0]) == 1, "the kept element's own contents survive the copy");
  // The elements are independent copies, not aliases of the source.
  assert(len(nv) == 3, "the source keeps its length");
  assert(len(nv[0]) == 1, "the source's element keeps its contents");
}

fn test_filter_over_text_elements() {
  sv = ["a", "bb"];
  f = filter(sv, |x| { true });
  assert(len(f) == 2, "text elements are kept");
  c = [for x in sv { 1 }];
  assert(len(c) == 2, "a text source stays readable after filter");
}

fn test_scalar_filter_unchanged() {
  // The control: a scalar element was never affected, and must stay exact.
  iv = [1, 2, 3];
  f = filter(iv, |x| { x > 1 });
  assert(len(f) == 2, "two elements pass");
  assert(f[0] == 2, "first kept value");
  assert(f[1] == 3, "second kept value");
  c = [for x in iv { 1 }];
  assert(len(c) == 3, "the scalar source stays readable");
}
