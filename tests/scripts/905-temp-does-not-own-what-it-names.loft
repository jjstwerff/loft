//
// A parser temp that NAMES storage someone else owns must not free it.
//
// Two fixes on this branch each gave a temp ownership it does not have, and each
// produced a double free that a release build runs without a word:
//
//   * loft#897 made the vector-field replacement's RHS temp own its storage, which
//     is right for an allocating RHS (`s.v = f#read(8) as vector<single>` leaked one
//     store for the life of the program without it) and wrong for a CALL. A
//     heap-returning function writes its result into a buffer the CALLER allocated
//     (the hidden trailing `__retbuf` parameter), so the value it answers IS that
//     buffer — minted once per call site and reused across loop iterations. Owning it
//     freed it once per ITERATION, and the next iteration wrote through freed
//     storage. Rows a1-a3.
//
//   * loft#900's group removal hoists the key lookup into a work-ref so every member
//     can unlink from one resolved record, and marked it `inline_ref` — which is not
//     what stops a free. The temp's scope-exit `OpFreeRef` then freed the record the
//     removal had already freed. Row b1.
//
// Neither is visible in an ordinary run: the first needs `LOFT_POISON=1` (which
// overwrites a freed record with 0xDEADBEEF, turning the stale read into a SIGSEGV)
// and the second needs `-C debug-assertions=on` (where `Store::valid` answers
// `Unknown record N`). Both gates run in CI, and this file is what they read.
//
// So the VALUES below are only half the check — a temp that wrongly owns still
// appends the right bytes on the iteration that writes them. The other half is the
// gates, which is why these rows are written to be reached by the whole-corpus
// sweeps rather than to assert about ownership directly.
//
// The controls are the point of the split: `LOFT_POISON` would also go green if the
// fix simply stopped freeing everything, and loft#897's leak would come back
// silently. Rows c1-c2 are the shapes that must still OWN — an allocating RHS bound
// to a field, and the same one assigned twice — which `tests/wrap.rs`'s leak gate
// fails on if their free goes missing.

struct Cell { q: integer, label: text }
struct Box { items: vector<Cell> }
struct Nums { v: vector<integer> }

struct Keyed { data: vector<Cell>, lookup: hash<Cell[q]> }
struct KeyedIdx { rows: index<Cell[q]>, by_q: hash<Cell[q]> }

/// Returns its own parameter's storage — the shape whose return buffer is promoted
/// to BE a named local, so the hidden parameter is RENAMED after it (`out`, not
/// `__retbuf`). A fix that looked for the NAME rather than the hidden FLAG fixed
/// `fresh` below and left this one crashing.
fn extend(v: vector<integer>, x: integer) -> vector<integer> {
  out = v;
  out += [x];
  out
}

/// Builds a new vector instead of returning its argument — its hidden parameter
/// keeps the `__retbuf` name.
fn fresh(v: vector<integer>, x: integer) -> vector<integer> {
  out: vector<integer> = [];
  for e in v { out += [e]; }
  out += [x];
  out
}

fn main() {
  // ---- a1: a call feeding the field back into itself, in a loop -----------------
  a1 = Nums { v: [] };
  for k in [10, 20, 30] { a1.v = extend(a1.v, k); }
  assert(len(a1.v) == 3, "a1 len = {len(a1.v)}, want 3");
  assert(a1.v[0] == 10 && a1.v[2] == 30, "a1 contents {a1.v}");

  // ---- a2: the same loop with no self-feed — the buffer is still the caller's ---
  a2 = Nums { v: [] };
  src: vector<integer> = [1, 2];
  n2 = 0;
  for k in [10, 20, 30] { a2.v = extend(src, k); n2 += len(a2.v); }
  assert(n2 == 9, "a2 sum of lengths = {n2}, want 9 — three elements each round");
  assert(len(a2.v) == 3, "a2 final len = {len(a2.v)}, want 3");

  // ---- a3: the other heap-return shape, whose buffer keeps its `__retbuf` name --
  a3 = Nums { v: [] };
  for k in [10, 20, 30] { a3.v = fresh(a3.v, k); }
  assert(len(a3.v) == 3, "a3 len = {len(a3.v)}, want 3");
  assert(a3.v[0] == 10 && a3.v[2] == 30, "a3 contents {a3.v}");

  // ---- a4: one call, no loop — the buffer is freed by its owner either way -------
  a4 = Nums { v: [] };
  a4.v = extend(a4.v, 10);
  assert(len(a4.v) == 1, "a4 len = {len(a4.v)}, want 1");

  // ---- b1: a linked group's removal frees the record exactly ONCE ---------------
  // The removal hoists the lookup into a temp; the temp must not free it again.
  b1 = Keyed { data: [], lookup: [] };
  b1.data = [Cell{q:1,label:"one"}, Cell{q:2,label:"two"}, Cell{q:3,label:"three"}];
  b1.lookup[2] = null;
  assert(len(b1.data) == 2, "b1 primary len = {len(b1.data)}, want 2");
  assert(len(b1.lookup) == 2, "b1 view len = {len(b1.lookup)}, want 2");
  assert((b1.lookup[3] ?? Cell{q:0,label:""}).label == "three", "b1: key 3 lost");
  s1 = ""; for e in b1.data { s1 += "{e.q}:{e.label} "; }
  assert(s1 == "1:one 3:three ", "b1 primary holds [{s1}]");

  // ---- b2: the same through an index primary, and twice over -------------------
  b2 = KeyedIdx { rows: [], by_q: [] };
  b2.rows = [Cell{q:1,label:"one"}, Cell{q:2,label:"two"}, Cell{q:3,label:"three"}];
  b2.by_q[1] = null;
  b2.rows[3] = null;
  assert(len(b2.rows) == 1, "b2 index len = {len(b2.rows)}, want 1");
  assert(len(b2.by_q) == 1, "b2 hash len = {len(b2.by_q)}, want 1");
  assert((b2.by_q[2] ?? Cell{q:0,label:""}).label == "two", "b2: key 2 lost");

  // ---- c1: an ALLOCATING rhs must still own, or loft#897's leak returns ---------
  // No call, so no caller-allocated buffer: this temp holds storage of its own and
  // its scope-exit free is the only thing that releases it.
  c1 = Box { items: [] };
  for k in [1, 2, 3] { c1.items = [Cell{q:k,label:"c{k}"}, Cell{q:k,label:"d{k}"}]; }
  assert(len(c1.items) == 2, "c1 len = {len(c1.items)}, want 2");

  // ---- c2: assigned twice — the first store must be released, not stacked -------
  c2 = Nums { v: [] };
  c2.v = [1, 2, 3];
  c2.v = [4, 5];
  assert(len(c2.v) == 2, "c2 len = {len(c2.v)}, want 2 — `=` replaces");
  assert(c2.v[0] == 4, "c2 contents {c2.v}");

  println("905 ok");
}
