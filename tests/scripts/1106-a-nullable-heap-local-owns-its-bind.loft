//
// A NULLABLE heap local bound from a call is copied out and owned, like its non-null twin
// (loft#1106).
//
// `S?` is `Optional(Reference(S))` — the same storage as `S` behind a nullability marker —
// and every shape question in the heap first-bind dispatch was asked against the BARE type.
// So a `r: S?` first-bound from a call reached none of those arms and stayed a plain alias
// of whatever DbRef came back, with two consequences the `-> S` twin of the same call has
// neither of:
//
//   * `(B-Copy)` broken — a bind COPIES its source, and a call RESULT is a whole value, not
//     a projection, so none of B-View / B-View-Base / B-View-Depth reach it. Writing through
//     the bound result reached the caller's own variable, silently.
//   * one leaked record per call — on the arm where the callee MINTED its store, nothing
//     owned it. The local's type kept the argument's dep, which reads as a permanent borrow.
//
// The cure is the bind the non-null twin already uses: `OpBindOrCopy` decides per EXECUTION,
// copying when the returned store is the witness's and adopting when it is not, so the
// scope-exit free is right on both arms. It is what makes a `null` answer safe too — a null
// carries no store to alias, so the guard adopts it and the local stays null.
//
// ⚠ WHAT MADE THIS ONE HARD: `r: P? = …` was ALREADY leak-clean, and clean BY ACCIDENT. Its
// dep was dropped only because the caller-side dep resolver has no `Optional` arm either, so
// the local read as an owner and got a free. Fixing the classification "properly" without the
// runtime guard turns that clean case INTO the leaking one — which is why the deps strip and
// the two backends' guard all read ONE predicate (`use_analysis::nullable_join_first_bind`).
//
// ⚠ AND THE VALUE ASSERTIONS DO NOT SCORE ALL OF IT — the wrap harness's LEAK GATE scores the
// other half. On a control binary built at `15be379a`, `test_a_write_through_the_bind_does_not_reach_the_argument`
// fails outright (`b3 copy 55`) while every other cell answers the same numbers and leaks.

struct P1106 { x: integer = 3, tag: integer = 0 }
enum E1106 { A { x: integer = 3 }, B { x: integer = 9 } }

fn mk1106() -> P1106? { P1106 { x: -1, tag: -1 } }
fn nothing1106() -> P1106? { null }

// `returns_borrowed_view`: the return names a visible parameter on one path and mints its own
// store on the other — the split the runtime guard decides.
fn pick1106(a: P1106?, c: boolean) -> P1106? { if c { a } else { mk1106() } }
fn pick_null1106(a: P1106?, c: boolean) -> P1106? { if c { a } else { null } }
fn pick_enum1106(a: E1106?, c: boolean) -> E1106? { if c { a } else { E1106::B { x: 9 } } }
fn pick_vec1106(a: vector<P1106>?, c: boolean) -> vector<P1106>? { if c { a } else { [P1106 { x: -1 }] } }

fn churn1106() -> integer {
  n = 0;
  for i in 0..40 { t: vector<integer> = [i, i + 1, i + 2]; n = n + len(t); }
  n
}

// The reported shape: a NON-null local handed to a `P1106?` parameter. Both arms run, because
// the leak is on the arm where the callee mints its own store.
fn from_dense(c: boolean) -> integer { q = P1106 { x: 7 }; r = pick1106(q, c); r?.x }

// The same value in a local DECLARED nullable — the cell that was clean by accident.
fn from_nullable(c: boolean) -> integer { q: P1106? = P1106 { x: 7 }; r = pick1106(q, c); r?.x }

fn test_a_nullable_bind_leaks_nothing_on_either_arm() {
  t = 0;
  for i in 0..12 { t = t + from_dense(true) + from_dense(false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
}

fn test_a_declared_nullable_local_leaks_nothing_either() {
  t = 0;
  for i in 0..12 { t = t + from_nullable(true) + from_nullable(false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
}

// ---- (B-Copy): the bind is INDEPENDENT of the argument it may alias ----

fn writes_through_nullable() -> integer { q: P1106? = P1106 { x: 7 }; r = pick1106(q, true); r?.x = 55; q?.x }
fn writes_through_dense() -> integer { q = P1106 { x: 7 }; r = pick1106(q, true); r?.x = 55; q.x }

fn test_a_write_through_the_bind_does_not_reach_the_argument() {
  assert(writes_through_nullable() == 7, "a bind copies, got {writes_through_nullable()}");
  assert(writes_through_dense() == 7, "a bind copies, got {writes_through_dense()}");
}

// ---- a `null` answer stays null ----
//
// The guard's adopt arm is what keeps this true: a null source has no store to alias, so
// nothing is allocated and the local keeps the sentinel. A bind that COPIED unconditionally
// would answer a freshly zeroed record here instead of absence.

fn null_from_join() -> integer { q: P1106? = P1106 { x: 7 }; r = pick_null1106(q, false); if r == null { 111 } else { r?.x } }
fn null_from_plain() -> integer { r = nothing1106(); if r == null { 222 } else { r?.x } }
fn null_declared() -> integer { q: P1106? = null; if q == null { 333 } else { q?.x } }

fn test_a_nullable_return_that_answers_null_stays_null() {
  assert(null_from_join() == 111, "join null arm, got {null_from_join()}");
  assert(null_from_plain() == 222, "plain null return, got {null_from_plain()}");
  assert(null_declared() == 333, "declared null, got {null_declared()}");
}

// ---- controls: the shapes that must be untouched ----

// A struct-ENUM behind the marker is the same storage and takes the same bind.
fn from_enum(c: boolean) -> integer { q: E1106? = E1106::A { x: 7 }; r = pick_enum1106(q, c); r?.x }

fn test_a_nullable_struct_enum_takes_the_same_bind() {
  t = 0;
  for i in 0..12 { t = t + from_enum(true) + from_enum(false); }
  assert(t == 192, "12 rounds of 7 + 9, got {t}");
}

// A nullable COLLECTION return is a DIFFERENT delivery — it peels to a bare vector and rides
// the caller's `__retbuf` (loft#938). Untouched here.
fn from_vector(c: boolean) -> integer { v: vector<P1106>? = [P1106 { x: 7 }]; r = pick_vec1106(v, c); len(r ?? []) }

fn test_a_nullable_collection_return_is_untouched() {
  t = 0;
  for i in 0..12 { t = t + from_vector(true) + from_vector(false); }
  assert(t == 24, "12 rounds of 1 + 1, got {t}");
}

// A REASSIGNMENT of a nullable local, which resolves through a different path than the first
// bind and was already correct.
fn reassigned(c: boolean) -> integer {
  q: P1106? = P1106 { x: 7 };
  r: P1106? = P1106 { x: 1 };
  base = r?.x;
  r = pick1106(q, c);
  r?.x * base
}

fn test_a_reassigned_nullable_local_is_untouched() {
  t = 0;
  for i in 0..12 { t = t + reassigned(true) + reassigned(false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
}

// ---- the argument must OUTLIVE the frame that binds it ----
//
// ⚠ A LEAK CHANNEL CANNOT SCORE AN OVER-FREE: freeing MORE than you should always reads as an
// improvement to it. This fix ADDS a free, so one cell has to let the freed store outlive the
// frame — here the argument arrives as a PARAMETER and is read back after enough allocation to
// recycle a released record.

fn outlives(q: P1106?, c: boolean) -> integer { r = pick1106(q, c); r?.x }

fn test_the_callers_argument_survives_the_bind() {
  o: P1106? = P1106 { x: 44, tag: 4 };
  t = 0;
  for i in 0..12 { t = t + outlives(o, true) + outlives(o, false); }
  assert(t == 516, "12 rounds of 44 + -1, got {t}");
  churn1106();
  assert(o?.x == 44, "the argument outlives the call, read back {o?.x}");
}
