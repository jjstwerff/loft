//
// PARTIAL: this guard covers the UNARY-PREFIX half of loft#1304.  The POSTFIX half
// (`m = S { … }.f(…)`) is still open, and the issue carries the two cures that were built and
// measured for it.  Every cell below is either the fixed half or a control that must not move.
//
// An assignment threads its DESTINATION as a hint into the right-hand side — `code` arriving
// at `Parser::parse_object` as `Value::Var(dest)` means *"build here instead of into a temp"*.
// The hint is valid for `m = S { … }`, where the literal IS the whole right-hand side, and
// invalid the moment the parser descends into a sub-expression.  Nothing cleared it on the way
// down, so
//
//     m = Money { c: 10 }.sub(Money { c: 3 });
//
// built the RECEIVER into `m` — the same variable the call's return lands in.  The return
// buffer overwrote the receiver's store, the frame's teardown then freed a reference that no
// longer described it, and the program printed the RIGHT answer and panicked afterwards:
// *"Store access out of bounds … the reference is corrupt"*.  `--native` would not compile it
// at all — `var_m = OpDatabase(cell, var_m, 81_i32)` inside `let mut var_m = …` is E0425, which
// is the two backends agreeing the IR was malformed rather than one mis-executing it
// (loft#1304).  Argument 2 was never affected: by then `code` is a fresh temp, so it took the
// `__ref_p2_N` work-ref path the receiver now takes too.
//
// `binding.md` `(B-Copy)` and `ownership.md` `(O-Move)` both describe what `m` must end up
// owning, and neither depends on how the receiver was SPELLED — which is what says the hint was
// the defect rather than the literal or the operator.
//
// The hint leaks TWO ways, and only one of them is closed here.
//
//  * what PRECEDES the literal — a unary prefix operator (`-x`, `!x`, `~x`) hands its operand
//    the hint directly.  `Parser::prefix_operand` is set across those three operand parses.
//    `m = -Money { c: 10 }` is that half; it lands on the `#405` refused-free guard rather than
//    the panic, because the store number is still in range there.  **This is what the guard
//    below pins.**
//  * what FOLLOWS it — `m = S { … }.f(…)`, where the literal is a call RECEIVER.  Still open.
//    A look-ahead past the balanced body was built and is NOT transparent: `Lexer::revert`
//    replays tokens so `position` comes back, but its closing `cont()` resets `prev_end` from
//    wherever the walk stopped, and three parse-error baselines moved by a column even with the
//    answer DISCARDED.  Declining the hint outright was measured too and loses the `&`-link
//    reshape refusal, which is derived from the in-place construction.  Both are on the issue.
//
// @falsified-at: 1053b516 — interpret exit 1 -> 0, native exit 1 -> 0, with the assertion count
//   reading 0 on BOTH trees.  That is the shape of the defect, not a weak guard: the prefix
//   cell's VALUE is right on the control (`-10`), so nothing asserts; what moves is the
//   store-lifetime channel, which the harness reads as the run's exit — a refused out-of-range
//   free (`#405`) and one store never freed.  Every value cell is paired with a `churn1304()`
//   and asserted AFTER it, because the defect answers correctly until the store slot is handed
//   out again (loft#1291's recycle).

struct Money1304 { cents: integer }
struct Pad1304 { a: integer, b: integer, c: integer }
struct Inner1304 { b: integer }
struct Outer1304 { inner: Inner1304 }

fn churn1304(n: integer) -> integer {
  junk: vector<Pad1304> = [];
  for i in 0..n { junk += [Pad1304 { a: i, b: i, c: i }]; }
  len(junk)
}

fn sub1304(self: Money1304, other: Money1304) -> Money1304 {
  Money1304 { cents: self.cents - other.cents }
}
fn OpMin(self: Money1304) -> Money1304 { Money1304 { cents: -self.cents } }
fn free_sub1304(x: Money1304, y: Money1304) -> Money1304 {
  Money1304 { cents: x.cents - y.cents }
}

// ---------------------------------------------------------------- the defect



fn a_unary_prefix_operand_is_not_the_destination_either() {
  // The half a lookahead cannot see: the literal ENDS the statement, so what follows says
  // "take the hint", and it is still a sub-expression because of what PRECEDES it.
  m = -Money1304 { cents: 10 };
  _ = churn1304(40);
  assert(m.cents == -10, "unary prefix on a literal: {m.cents}");
}



// ---------------------------------------------------------------- the controls

fn the_in_place_construction_is_still_taken() {
  // The OPTIMISATION this fix must not cost.  `m = S { … }` is the shape the hint exists for,
  // and it still lowers to `OpDatabase(m)` + field writes rather than a work-ref plus a copy —
  // checked by hand against `loft introspect`, and pinned here by behaviour.
  m = Money1304 { cents: 7 };
  _ = churn1304(40);
  assert(m.cents == 7, "plain literal assignment: {m.cents}");
}

fn the_shapes_that_were_always_right() {
  // Each of these was clean before the fix and must stay so — they are what said the axis was
  // the RECEIVER and not the operator, the literal, or the struct return.
  a = Money1304 { cents: 10 };
  b = Money1304 { cents: 3 };
  v = a.sub1304(b);
  assert(v.cents == 7, "variable receiver: {v.cents}");

  f = free_sub1304(Money1304 { cents: 10 }, Money1304 { cents: 3 });
  assert(f.cents == 7, "free function, literal arguments: {f.cents}");

  n = Outer1304 { inner: Inner1304 { b: 9 } };
  assert(n.inner.b == 9, "nested literal: {n.inner.b}");

  vec: vector<Money1304> = [Money1304 { cents: 1 }, Money1304 { cents: 2 }];
  t = 0;
  for e in vec { t = t + e.cents; }
  assert(t == 3, "vector of literals: {t}");
}

fn a_literal_inside_a_format_hole_is_read_correctly() {
  // The risk the lexical lookahead carries: it counts brace TOKENS, and a format hole opens
  // and closes with them.  A constant string is a single lexer item, so braces inside one are
  // not tokens; a hole is balanced.  This is the cell that would catch a miscount.
  s = "w={Money1304 { cents: 4 }.cents}";
  _ = churn1304(40);
  assert(s == "w=4", "struct literal inside a format hole: {s}");
}

pub fn main() {
  a_unary_prefix_operand_is_not_the_destination_either();
  the_in_place_construction_is_still_taken();
  the_shapes_that_were_always_right();
  a_literal_inside_a_format_hole_is_read_correctly();
  println("1304 ok");
}
