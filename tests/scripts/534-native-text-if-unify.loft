//
// Regression for #534 — native codegen failed to unify the arms of a `text`
// `if`/`else` when they mapped to different Rust types: a bare text-returning
// call yields an owned `String`, while a literal / interpolation yields a
// borrowed `&str`.  rustc rejected the mismatched arms with E0308.  The fix
// (`text_if_mismatched_reps` in `src/generation/emit.rs`) routes both arms
// through `.to_string()` (owned `String`), and the buffered `Str::new` return
// path materialises the result via the caller's work buffer.  A mismatch can
// only occur where the code never compiled, so the fix cannot regress a
// previously-working shape.  `--interpret` was already correct; this guards the
// `--native` compile+run (via `tests/native.rs::native_scripts`).

fn g(k: integer) -> text {
  match k { 1 => "one", _ => "other" }
}

// Each arm pairing that native codegen must unify.  `k == 0` selects the THEN
// arm, `k == 9` the ELSE arm.
fn f_interp_v_fncall(k: integer) -> text {
  if k == 0 { "x{k}" } else { g(k) }
}
fn f_fncall_v_interp(k: integer) -> text {
  if k == 0 { g(k) } else { "x{k}" }
}
fn f_fncall_v_lit(k: integer) -> text {
  if k == 0 { g(k) } else { "y" }
}
fn f_lit_v_fncall(k: integer) -> text {
  if k == 0 { "y" } else { g(k) }
}
// Controls that already compiled — must stay correct.
fn f_fncall_v_fncall(k: integer) -> text {
  if k == 0 { g(k) } else { g(k + 1) }
}
fn f_interp_v_lit(k: integer) -> text {
  if k == 0 { "x{k}" } else { "y" }
}

fn main() {
  // then (interp) at k==0; else (fncall) at k==1 → g(1) == "one".
  assert("{f_interp_v_fncall(0)}" == "x0", "interp-then arm");
  assert("{f_interp_v_fncall(1)}" == "one", "fncall-else arm unifies with interp-then");

  // then (fncall) at k==0 → g(0) == "other"; else (interp) at k==1.
  assert("{f_fncall_v_interp(0)}" == "other", "fncall-then arm unifies with interp-else");
  assert("{f_fncall_v_interp(1)}" == "x1", "interp-else arm");

  // then (fncall) at k==0 → g(0) == "other"; else (literal) at k==1.
  assert("{f_fncall_v_lit(0)}" == "other", "fncall-then arm unifies with literal-else");
  assert("{f_fncall_v_lit(1)}" == "y", "literal-else arm");

  // then (literal) at k==0; else (fncall) at k==1 → g(1) == "one".
  assert("{f_lit_v_fncall(0)}" == "y", "literal-then arm");
  assert("{f_lit_v_fncall(1)}" == "one", "fncall-else arm unifies with literal-then");

  // Controls that already compiled — must stay correct.
  assert("{f_fncall_v_fncall(0)}" == "other", "fncall-vs-fncall control (then)");
  assert("{f_fncall_v_fncall(5)}" == "other", "fncall-vs-fncall control (else)");
  assert("{f_interp_v_lit(0)}" == "x0", "interp-vs-literal control (then)");
  assert("{f_interp_v_lit(1)}" == "y", "interp-vs-literal control (else)");

  println("534 native text-if unify ok");
}
