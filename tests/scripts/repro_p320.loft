// @P320 regression — the `&`-parameter "never modified" check FALSE-rejected a
// function whose ONLY mutation of the `&`-param is a keyed REMOVE through a
// keyed-collection field (`h.data[key] = null`).  Keyed INSERT (`+=`) and
// whole-field reassign (`= []`) WERE recognized as mutations; the keyed remove
// — lowered to `OpHashRemove(coll, …)` — was not, so a `&` param doing only a
// remove tripped "Parameter 'h' has & but is never modified; remove the &".
//
// CLOSED 2026-05-23 by adding `OpHashRemove` to the `first_arg_write` op-sets
// in `find_written_vars` + `find_field_written_vars` (src/parser/mod.rs),
// alongside the already-present OpSetKeyed / OpClearKeyed.
//
// This file FAILING TO COMPILE (the false error) would fail the suite; the
// asserts further confirm the removal happened AND propagated back through the
// `&` ref to the caller (the whole point of the `&`).  OpHashRemove serves hash
// / index / sorted alike, so a hash and an index variant are both covered.

struct P320Ent {
  k: integer,
  v: integer,
}
struct P320Hash {
  data: hash<P320Ent[k]>,
}

// The shape that used to be rejected: a `&` param whose ONLY mutation is a
// keyed remove.
fn p320_drop_hash(h: &P320Hash, target: integer) {
  h.data[target] = null;
}

fn test_p320_hash_keyed_remove() {
  hh = P320Hash { data: [] };
  hh.data += [
    P320Ent { k: 1, v: 10 },
  ];
  hh.data += [
    P320Ent { k: 2, v: 20 },
  ];
  p320_drop_hash(hh, 1); // remove key 1 through the &-ref
  assert(len(hh.data) == 1, "p320 hash: len={len(hh.data)} (want 1)");
  assert(hh.data[1] == null, "p320 hash: key 1 not removed");
  e2 = hh.data[2];
  assert(e2 != null, "p320 hash: key 2 wrongly removed");
  assert(e2.v == 20, "p320 hash: key 2 v={e2.v} (want 20)");
}

struct P320Rec {
  id: integer,
  w: integer,
}
struct P320Index {
  rows: index<P320Rec[id]>,
}

fn p320_drop_index(ix: &P320Index, target: integer) {
  ix.rows[target] = null;
}

fn test_p320_index_keyed_remove() {
  ii = P320Index { rows: [] };
  ii.rows += [
    P320Rec { id: 5, w: 50 },
  ];
  ii.rows += [
    P320Rec { id: 6, w: 60 },
  ];
  p320_drop_index(ii, 5);
  assert(len(ii.rows) == 1, "p320 index: len={len(ii.rows)} (want 1)");
  r6 = ii.rows[6];
  assert(r6 != null, "p320 index: id 6 wrongly removed");
  assert(r6.w == 60, "p320 index: id 6 w={r6.w} (want 60)");
}
