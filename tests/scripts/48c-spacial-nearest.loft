// @PLN48 S3 — xs.nearest(cx, cy, k): the exact k-nearest query, nearest-first, on
// both backends.
struct NMob { x: integer, y: integer }

fn main() {
  xs: spacial<NMob[x, y]> = [];
  xs += [NMob{x: 0,   y: 0}];
  xs += [NMob{x: 100, y: 100}];
  xs += [NMob{x: 3,   y: 4}];    // dist 5 from origin
  xs += [NMob{x: 1,   y: 1}];    // dist sqrt(2)
  xs += [NMob{x: 50,  y: 50}];

  // Concatenate x*1000+y of the 3 nearest to (0,0), in order: 0, 1001, 3004.
  seq: integer = 0;
  for m in xs.nearest(0, 0, 3) {
    seq = seq * 100000 + m.x * 1000 + m.y;
  }
  print("seq={seq}\n");   // 0 → 1001 → 100100001001 ... deterministic order check
}
