// loft#1040 — a generic `par` worker inside a generic FUNCTION.
//
// A par lowering is more than a call target: it picks a queue variant, an element and a
// return SIZE, a result accessor and a re-wrap, all from the element and return types.
// Inside a template those types are the type VARIABLE, so a route chosen there is a route
// for a 12-byte reference; substitution then rewrites the types and leaves the whole route
// behind.  Measured before it was refused: `--interpret` answered correctly (it dispatches
// the worker by d_nr) while `--native` would not compile — "non-primitive cast: DbRef as
// i64", the result buffer read with the REFERENCE accessor and cast to the monomorph's
// scalar.  That is the divergence formal/operational.md D-op-1 forbids, so it was refused
// on both rather than shipped.
//
// It is no longer a refusal: the template parses the BODY (which is what types it) and
// leaves a marker the MONOMORPH replaces, lowering the same clause against the element and
// return types it actually has.  So the route is chosen the way every non-generic par site
// chooses it — once per instantiation, which is the only place the answer exists.
pub fn same<T>(x: T) -> T { x }
pub fn one<T>(x: T) -> integer { 1 }
pub fn scaled<T>(x: T, k: integer) -> integer { k }
fn twice(x: integer) -> integer { x * 2 }
struct Cell { v: integer }

pub fn count_par<T>(v: vector<T>) -> integer {
  n = 0;
  for e in v par(r = same(e), 1) { n += 1; _ = e; _ = r; }
  n
}
pub fn sum_ones<T>(v: vector<T>) -> integer {
  t = 0;
  for e in v par(r = one(e), 1) { t += r; _ = e; }
  t
}
pub fn sum_scaled<T>(v: vector<T>, k: integer) -> integer {
  t = 0;
  for e in v par(r = scaled(e, k), 1) { t += r; _ = e; }
  t
}
// A par inside a template whose route is NOT parametric: a concrete vector and a concrete
// worker.  It lowers where it is written, exactly as it always did.
pub fn concrete_inside<T>(a: T) -> integer {
  n = 0;
  w: vector<integer> = [1, 2];
  for e in w par(r = twice(e), 1) { n += r; }
  _ = a;
  n
}
// The #1033 shape, which must keep working: a generic worker from a NON-generic function.
fn from_plain(v: vector<integer>) -> integer {
  n = 0;
  for e in v par(r = same(e), 1) { n += r; _ = e; }
  n
}

fn main() {
  // ONE template, several instantiations — each monomorph picks its own route, which is
  // the whole point: a scalar, a text and a struct element cannot share one.
  assert(count_par([1, 2]) == 2, "integer elements");
  assert(count_par(["a", "b", "c"]) == 3, "text elements");
  f: vector<float> = [1.5, 2.5];
  assert(count_par(f) == 2, "float elements");
  s: vector<Cell> = [Cell { v: 1 }, Cell { v: 2 }, Cell { v: 3 }];
  assert(count_par(s) == 3, "struct elements — the reference route");

  // The worker's result is READ in the body, at a return type that differs from the
  // element type — the accessor and the re-wrap have to match the monomorph, not T.
  assert(sum_ones([9, 9, 9, 9]) == 4, "worker returning integer from an integer element");
  assert(sum_ones(["x"]) == 1, "worker returning integer from a text element");
  assert(sum_scaled([1, 2, 3], 5) == 15, "worker with an extra context argument");
  assert(sum_scaled(["a", "b"], 4) == 8, "the same, over text elements");

  // Regressions.
  assert(concrete_inside("t") == 6, "a concrete par inside a template still lowers there");
  assert(from_plain([1, 2]) == 3, "a generic worker from a non-generic function");
}
