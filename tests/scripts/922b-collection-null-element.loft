// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A `null` ELEMENT of a collection-typed element is the empty collection — the same rule
// a `null` reaching a collection FIELD takes (loft#922, guarded next door), because the
// slot is the same one: a 4-byte record id where `0` already means "no records".
//
// It used to abort the compiler outright. `convert` turns a `null` bound for a vector into
// the 16-byte REFERENCE sentinel, which is the right null for a vector VARIABLE (whose
// slot IS a DbRef) and the wrong one for an element; writing it through the element's
// 4-byte setter tripped an internal assertion — `expected 8B on stack but … pushed 16B` —
// so `ve += [null]` never reached a diagnostic, let alone a value. Both backends.
//
// Its own file rather than a section of the field guard: declaring `vector<vector<T>?>`
// beside the keyed types makes the generated `init()` report a schema-id divergence
// (loft#739's guard, filed as loft#923), and a guard that prints a known-red line every
// run teaches the reader to ignore it.
//
// Telling this empty from an ABSENT element is loft#917's reader half, open and unasserted
// here, exactly as in the field guard.

fn main() {
  ve: vector<vector<integer>?> = [];
  ve += [[1, 2]];
  ve += [null];
  ve += [[3]];
  assert(len(ve) == 3, "the null element left the outer vector at len {len(ve)}, want 3");
  assert(len(ve[0] ?? []) == 2, "element 0 has len {len(ve[0] ?? [])}, want 2");
  assert(len(ve[1] ?? []) == 0, "the null element has len {len(ve[1] ?? [])}, want 0");
  assert(len(ve[2] ?? []) == 1, "element 2 has len {len(ve[2] ?? [])}, want 1");

  // The elements AFTER the null one are reachable and hold what was written — a null that
  // wrote a garbage record id would still count three and read wrong here.
  tot = 0;
  for ev in ve { for ex in ev ?? [] { tot += ex; } }
  assert(tot == 6, "the elements hold {tot}, want 6");

  // A null element is a usable empty collection, not a hole: appending through the read
  // is the shape that would fault on a sentinel record id.
  after = ve[1] ?? [];
  after += [5];
  assert(len(after) == 1, "appending to the null element's value left len {len(after)}, want 1");

  // Twenty of them, so a per-element leak or a shared record shows up as a wrong length.
  many: vector<vector<integer>?> = [];
  for _ in 0..20 { many += [null]; }
  assert(len(many) == 20, "20 null elements left len {len(many)}, want 20");
  assert(len(many[7] ?? []) == 0, "a middle null element has len {len(many[7] ?? [])}, want 0");

  println("922b ok");
}
