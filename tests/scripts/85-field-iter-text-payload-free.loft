// @PLN85 corpus text-leak class 4 — `for f in s#fields` with a text-payload
// binding (`f.value is FvText { v }`).  The `#fields` loop is UNROLLED into one
// block per field; the body is parsed once and cloned, so all clones shared ONE
// `_mv_<f>` payload binding.  Scope cleanup then frees it only at its LAST
// textual use — which sits inside the CONDITIONAL match arm — so when the last
// field is NOT text the owned copy from an earlier text field orphaned on the
// interpreter (native RAII-drops it).  `parse_field_iteration` (collections.rs)
// now gives each field-block its own `_mv_` binding copy, so each is freed at its
// own block's use — a real loop's per-iteration scope.  Graduated from
// probes/corpus-optional-text/ (fi_min / fi_text / fi_text2).

struct Mixed { name: text, count: integer, active: boolean, score: float }

// Text payload appended DIRECTLY (owned copy consumed in place, per iteration).
fn names_direct(m: Mixed) -> text {
  r = "";
  for mf in m#fields {
    if mf.value is FvText { v } { r += v; }
  }
  return r;
}

// Text payload consumed via INTERPOLATION (a per-iteration `__work` buffer AND
// the `_mv_` binding — the binding is the per-clone one, the __work is already
// freed per-statement and must stay shared).
fn describe(m: Mixed) -> text {
  r = "";
  for mf in m#fields {
    if r != "" { r += "|" }
    r += mf.name;
    r += "=";
    if mf.value is FvText { v } { r += "'{v}'"; }
    if mf.value is FvInt { v } { r += "{v}"; }
    if mf.value is FvBool { v } { r += "{v}"; }
    if mf.value is FvFloat { v } { r += "{v}"; }
  }
  return r;
}

fn main() {
  m = Mixed { name: "test", count: 42, active: true, score: 9.5 };
  assert(names_direct(m) == "test", "direct text payload: {names_direct(m)}");
  assert(
    describe(m) == "name='test'|count=42|active=true|score=9.5",
    "interpolated field iteration: {describe(m)}"
  );
  println("field-iter-text-payload-free ok");
}
