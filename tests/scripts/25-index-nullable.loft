// @PLN25 index flip — `v[i]` types `τ?` (OOB → null) UNLESS the index is provably
// in-bounds. This is the graduation test for the flip (Step 6): it exercises every
// accept path (the fit-proofs + the discharge idioms) and the honest-nullable read.
// Self-asserting; gate-OFF byte-identical (no `Optional` is constructed, so the fit
// paths and `?? d` are inert). Both backends. See index-f1a-landing.md.

// ── fit-proof: a compile-time-constant index is trusted (non-null) ──────────
fn read_const(v: vector<integer>) -> integer {
  v[1]// constant index → provably fit → `integer`, no discharge needed
}

// ── fit-proof: a for-loop iteration variable is the loop's contract ─────────
fn sum_iter(v: vector<integer>) -> integer {
  s = 0;
  for i in 0..len(v) { s = s + v[i]; } // iter var → fit → `integer`
  s
}

// ── fit-proof: an `if i < len(v)` guard proves the branch in-bounds ─────────
fn guarded(v: vector<integer>, i: integer) -> integer {
  if i < len(v) { v[i] } else { -1 } // then-branch: `v[i]` is `integer`
}

// ── discharge: `v[i] ?? d` on a general index yields the base type ──────────
fn defended(v: vector<integer>, i: integer) -> integer {
  v[i] ?? 0// general index → `integer?` → `?? 0` discharges to `integer`
}

// ── honest nullable: an inferred local absorbs the `τ?` (OOB → null) ────────
fn honest_oob(v: vector<integer>, i: integer) -> boolean {
  x = v[i]; // general index → x infers `integer?`
  x == null// an OOB read is null; an in-bounds read is not
}

fn main() {
  v: vector<integer> = [10, 20, 30];
  assert(read_const(v) == 20, "constant index reads the element");
  assert(sum_iter(v) == 60, "iter-var index sums 10+20+30");
  assert(guarded(v, 1) == 20, "guarded in-bounds index reads");
  assert(guarded(v, 9) == -1, "guarded out-of-bounds takes the else");
  assert(defended(v, 1) == 20, "discharged in-bounds index reads");
  assert(defended(v, 9) == 0, "discharged out-of-bounds yields the fallback");
  assert(!honest_oob(v, 1), "in-bounds read is not null");
  assert(honest_oob(v, 9), "out-of-bounds read is null");
  println("index-nullable ok");
}
