//
// Regression for #622 — a `??` null-coalescing text block compared against a
// text local must native-compile in CALL-ARGUMENT position, not only when bound
// to a variable first.
//
// `OpEqText` / `OpNeText` used the bare Rust `@v1 == @v2`, which coerces
// nothing, so the two operands had to arrive in already-matching shapes.  Each
// text provenance produces a different one: `&String` for a local, `&str` for an
// indexed `vector<text>` element, and an OWNED `String` for a `??` block (it
// ends in `.to_string()`).  In a call argument the block was emitted inline, so
// `assert((v[0] ?? "") == t, …)` became `String == &String` → E0277, while
// `b = (v[0] ?? "") == t; assert(b, …)` compiled because the pre-eval hoist
// wrapped the block in `&*(…)`.  Both now route through `ops::op_eq_text` /
// `op_ne_text`, whose `AsRef<str>` parameters meet every provenance at `&str` —
// the same remedy @P347 already applied to `OpLtText` / `OpLeText`.
//
// Native-only defect (the interpreter was always correct), so these must run on
// BOTH backends to be meaningful.

fn ids() -> vector<text> {
  out: vector<text> = [];
  out += ["t1"];
  out += ["t2"];
  return out;
}

// The exact shape from the report: a `??` discharge compared to a text local,
// directly inside a call argument.
fn test_622_ncc_eq_local_in_call_arg() {
  tid = "t1";
  need = ids();
  assert((need[0] ?? "") == tid, "ncc == local in call arg");
  // …and the `&&` form the zero-trust packages actually used.
  assert(len(need) == 2 && (need[0] ?? "") == tid, "ncc == local behind &&");
}

// Operand order must not matter — the local on the left failed identically.
fn test_622_local_eq_ncc_in_call_arg() {
  tid = "t2";
  need = ids();
  assert(tid == (need[1] ?? ""), "local == ncc in call arg");
}

fn test_622_ncc_ne_local_in_call_arg() {
  tid = "t1";
  need = ids();
  assert((need[1] ?? "") != tid, "ncc != local in call arg");
}

// The provenances that already worked stay working: block-vs-literal,
// block-vs-block, and the bound-to-a-local baseline.
fn test_622_other_text_provenances() {
  tid = "t1";
  need = ids();
  assert((need[0] ?? "") == "t1", "ncc == literal");
  assert((need[0] ?? "") != (need[1] ?? ""), "ncc != ncc");
  b = (need[0] ?? "") == tid;
  assert(b, "bound-first baseline");
  // Ordering ops routed through `ops::` since @P347 — guard them alongside.
  assert((need[0] ?? "") < (need[1] ?? ""), "ncc < ncc");
  assert((need[0] ?? "") <= tid, "ncc <= local");
}

// A `??` block in a condition and in a nested call argument.
fn test_622_ncc_compare_nested_positions() {
  tid = "t1";
  need = ids();
  hit = 0;
  if (need[0] ?? "") == tid { hit = hit + 1; }
  assert(hit == 1, "ncc == local as if-condition");
  // Nested one call deeper.
  assert(both_true((need[0] ?? "") == tid, (need[1] ?? "") != tid), "nested call arg");
}

fn both_true(a: boolean, b: boolean) -> boolean { return a && b; }

// ── #622 follow-up: the NARROWING-CAST shape ────────────────────────────────
//
// Reported later, in a comment rather than the issue body, and so still open
// when the comparison half above was closed: a `??` discharge from a NARROW-INT
// vector, masked, then narrowed — `((v[i] ?? 0) & 255) as u8` — failed native
// compilation with E0308.  A narrow-int value-block cast its own tail to the
// element width (`… as u8`), but a loft `integer` expression is `i64` in every
// Rust position EXCEPT a function's return signature, so each consumer had to
// widen it back.  Return and assignment did; the operand seam of
// `op_logical_and_int` did not.  The tail cast is now confined to the function
// BODY block (`block_tail_cast`), which is the only place the narrow Rust type
// is real, so no consumer needs a widen.
//
// The failing case is a NARROW INTERSECTION — narrow-int source AND bitwise `&`
// AND a narrowing cast.  Change any one and it compiled, so the near variants
// are asserted alongside it; a guard picked without them reports this fixed.
// Native-only, like the rest of this file.
fn test_622_narrow_source_mask_cast() {
  src: vector<u8> = [];
  for i in 0..4 { src += [ ((i + 1) & 255) as u8 ]; }

  // The reported shape: narrow source + mask + narrowing cast.
  out: vector<u8> = [];
  for i in 0..len(src) { out += [ ((src[i] ?? 0) & 255) as u8 ]; }
  assert(len(out) == 4, "narrow source + mask + cast: len={len(out)}");
  assert((out[0] ?? 0) == 1 && (out[3] ?? 0) == 4, "narrow mask+cast values: {out}");

  // Same source and mask, WIDER destination — the destination is irrelevant.
  wide: vector<u16> = [];
  for i in 0..len(src) { wide += [ ((src[i] ?? 0) & 255) as u16 ]; }
  assert((wide[2] ?? 0) == 3, "narrow source + mask + u16 cast: {wide}");

  // A u16 source takes the same path.
  s16: vector<u16> = [4096, 8192];
  o16: vector<u16> = [];
  for i in 0..len(s16) { o16 += [ ((s16[i] ?? 0) & 255) as u16 ]; }
  assert((o16[0] ?? 0) == 0 && (o16[1] ?? 0) == 0, "u16 source masked to low byte: {o16}");

  // The variants that always compiled — they must keep working AND stay correct.
  wid: vector<integer> = [1, 2, 3];
  a: vector<u8> = []; for i in 0..len(wid) { a += [ ((wid[i] ?? 0) & 255) as u8 ]; }
  assert((a[2] ?? 0) == 3, "wide source + mask + cast: {a}");
  b: vector<u8> = []; for i in 0..len(src) { b += [ (src[i] ?? 0) as u8 ]; }
  assert((b[1] ?? 0) == 2, "narrow source, no mask: {b}");
  c: vector<u8> = []; for i in 0..len(src) { c += [ ((src[i] ?? 0) % 256) as u8 ]; }
  assert((c[1] ?? 0) == 2, "narrow source, modulo not mask: {c}");
  d: vector<u8> = []; for i in 0..len(src) { e = src[i] ?? 0; d += [ (e & 255) as u8 ]; }
  assert((d[1] ?? 0) == 2, "narrow source, bound to a local first: {d}");
}
