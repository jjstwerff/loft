//
// @PLN123 A3 — `store_reclaim(collection)` gives a BOUND store's file back.
//
// Driven by tests/store_persist_loft.rs on both backends.  Env in:
//   LOFT_PERSIST_TEST_PATH   where to bind
//
// The shape is the one the plan exists for: bind small, grow ten-fold, drop
// back to the original live set.  The file follows the growth and never comes
// back down on its own, because a bound store only ever grew.
//
// Every number the driver checks is printed with a digest beside it: a file
// that got smaller by LOSING data would satisfy every size assertion anyone
// would write, so the digest is what makes those assertions mean something.

struct Hex { const id: integer, const a: i32, const label: text }

fn digest(h: hash<Hex[id]>) -> integer {
  d = 0;
  for dg_r in h {
    d = (d * 31 + dg_r.id + (dg_r.a as integer) * 7 + len(dg_r.label)) % 1000000007;
  }
  d
}

fn live(h: hash<Hex[id]>) -> integer {
  n = 0;
  for lv_r in h { n += lv_r.id * 0 + 1 }
  n
}

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH") ?? "";
  if path == "" { println("no path"); return }

  // Second pass, a FRESH process against the file the first pass truncated:
  // a shortened file is only a store if it still opens as one.
  if (env_variable("LOFT_PERSIST_TEST_MODE") ?? "") == "reload" {
    back: hash<Hex[id]> = [];
    if !store_persist_bind(back, path) { println("FAIL reload-bind"); return }
    println("reload live {live(back)} digest {digest(back)}");
    return
  }

  world: hash<Hex[id]> = [];
  for i in 0..300 { world += [Hex { id: i, a: (i % 251) as i32? ?? (0 as i32), label: "hex {i}" }]; }
  ok = store_persist_bind(world, path);
  if !ok { println("FAIL bind"); return }
  keep_digest = digest(world);

  // Grow ten-fold, then drop every added record: the live set is back to what
  // it was at bind time, and the file is not.
  for g in 300..3000 { world += [Hex { id: g, a: (g % 251) as i32? ?? (0 as i32), label: "hex {g}" }]; }
  for d in 300..3000 { world[d] = null; }

  before = file(path).size;
  freed = store_reclaim(world);
  after = file(path).size;
  println("grown_then_dropped before {before} freed {freed} after {after}");
  println("kept live {live(world)} digest {digest(world)} was {keep_digest}");

  // Idempotent: a store with no tail left has nothing to give, and says so
  // without touching the file.
  again = store_reclaim(world);
  println("second freed {again} size {file(path).size}");

  // A truncated store is still a store: it takes new records, and the ones
  // that survived still read.
  world += [Hex { id: 42424, a: 7 as i32, label: "written after the truncation" }];
  fresh = world[42424];
  old = world[7];
  if fresh == null { println("FAIL lost-new-record"); return }
  if old == null { println("FAIL lost-old-record"); return }
  println("after_write live {live(world)} digest {digest(world)} new {fresh.label} old {old.label}");
}
