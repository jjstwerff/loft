//
// @PLN125 — an interface method may return a type declared LATER in the file.
//
// A bound-method stub stands in for the concrete method the monomorph will
// substitute, so its ABI has to equal that method's ABI — including the hidden
// `__retbuf` parameter a heap return carries. That decision reads the interface
// method's return type, and on the FIRST pass a type declared further down the
// file is not resolved yet: the stub carried no `__retbuf`, the monomorph then
// grew a `__ref_N` with no scope and no initialiser to match the concrete
// method's arity, and codegen met a variable that never got a stack slot —
// "Incorrect var __ref_2[65535]", an internal compiler error on BOTH backends.
//
// The fix re-derives every stub's signature BETWEEN the passes, where all types
// resolve (`Parser::refresh_bound_method_stubs`), never in pass 2 — growing an
// attribute there breaks the H5 two-pass contract, which is what caught the
// first attempt.
//
// So declaration ORDER is the axis under test: every interface here names a
// return type that appears below it. The control lives in
// `doc/claude/plans/125-first-grade-library-types/bytecode-comparisons/`, where
// the same shapes are declared the other way round and must stay
// byte-identical.

interface Boxy {
  fn boxed(self: Self) -> Crate
}

interface Listy {
  fn parts(self: Self) -> vector<Crate>
}

interface Shapey {
  fn shape(self: Self) -> Figure
}

// Every type the interfaces above return is declared only now.
struct Crate {
  n: integer,
}

enum Figure {
  Square { side: integer },
  Circle { radius: integer },
}

struct Item {
  w: integer,
}

fn boxed(self: Item) -> Crate { return Crate { n: self.w }; }
fn parts(self: Item) -> vector<Crate> { return [Crate { n: self.w }, Crate { n: self.w + 1 }]; }
fn shape(self: Item) -> Figure { return Square { side: self.w }; }

// Read the result inline — the shape that crashed. The temporary is the one the
// missing `__retbuf` was supposed to deliver through.
fn inline_boxed<B: Boxy>(b: B) -> integer { return b.boxed().n; }
// Bind it first: the same delivery, one step apart.
fn bound_boxed<B: Boxy>(b: B) -> integer { c = b.boxed(); return c.n; }
// A vector return takes the same arm of the ABI decision.
fn count_parts<L: Listy>(l: L) -> integer { return len(l.parts()); }
// So does a struct-enum return.
fn side_of<S: Shapey>(s: S) -> integer {
  f = s.shape();
  return match f {
    Square { side } => { side },
    Circle { radius } => { radius },
  };
}

fn main() {
  i = Item { w: 4 };
  assert(inline_boxed(i) == 4, "struct return read inline: {inline_boxed(i)}");
  assert(bound_boxed(i) == 4, "struct return bound to a local: {bound_boxed(i)}");
  assert(count_parts(i) == 2, "vector return: {count_parts(i)}");
  assert(side_of(i) == 4, "struct-enum return: {side_of(i)}");
  println("pln125 forward return ok");
}
