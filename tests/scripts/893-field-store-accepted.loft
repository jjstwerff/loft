//
// The other half of loft#893: the field stores that are CORRECT and must keep working.
//
// The check that closes #893 sits at the point every store form still reaches, so it
// sees far more than the wrong-typed ones — including several pairs that are
// deliberately NOT the same type.  Each row here is one such pair, and each is the
// reason the check cannot simply be "source type equals field type":
//
//   - a keyed collection is BUILT from a vector of its elements, and the two spellings
//     are not `is_equal` (this is the carve-out the predicate names explicitly);
//   - `null` into a heap-nullable field is a store, not a mismatch;
//   - an integer literal into a `float` field widens, and an integer-spelled element
//     into a `vector<float>` is coerced by the literal parse.
//
// A regression here is a FALSE refusal — the failure mode that makes a type check worse
// than no type check — so the values are asserted, not just the compile.

struct Inner { z: integer }
enum Colour { Red, Green, Blue }
struct E { k: integer, n: text }

struct Holder {
  vec: vector<float>,
  structs: vector<Inner>,
  inner: Inner,
  maybe: Inner?,
  colour: Colour,
  label: text,
  ratio: float,
  tag: integer,
}

// The two keyed kinds live in their OWN structs on purpose.  Holding a `hash` and a
// `sorted` field in one struct and assigning the hash first makes the later sorted
// assignment build the wrong length (4 for two elements) — on the published 2026.8.0
// and on both backends, so it long predates the #893 check and is unrelated to it
// (loft#895).  Keeping them apart is what lets these rows guard the #893 carve-out
// instead of failing for someone else's reason.
struct KeyedHolder { keyed: hash<E[k]>, tag: integer }
struct OrderedHolder { ordered: sorted<E[k]>, tag: integer }

fn r893_new() -> Holder {
  Holder {
    vec: [], structs: [], inner: Inner { z: 0 },
    maybe: null, colour: Colour::Red, label: "", ratio: 0.0, tag: 0,
  }
}

fn r893_floats() -> vector<float> { [1.0, 2.0, 3.0, 4.0] }
fn r893_inner() -> Inner { Inner { z: 7 } }
fn r893_colour() -> Colour { Colour::Green }
fn r893_label() -> text { "from a call" }

fn main() {
  h = r893_new();

  // A vector field, written the three ways a vector arrives: a literal, a local, a call.
  h.vec = [1.0, 2.0];
  assert(len(h.vec) == 2, "vector field from a literal");
  local: vector<float> = [5.0, 6.0, 7.0];
  h.vec = local;
  assert(len(h.vec) == 3, "vector field from a local");
  h.vec = r893_floats();
  assert(len(h.vec) == 4, "vector field from a call");
  assert((h.vec[2] ?? 0.0) == 3.0, "vector field keeps its elements");

  // An integer-spelled element in a `vector<float>` literal: the literal is parsed
  // against the field's element type, so this is a coercion and not a mismatch.
  h.vec = [1, 2];
  assert(len(h.vec) == 2, "vector<float> field from an integer-spelled literal");
  assert((h.vec[0] ?? 0.0) == 1.0, "the integer element became a float");

  // A vector of structs — the element type is a reference, not a scalar.
  h.structs = [Inner { z: 1 }, Inner { z: 2 }];
  assert(len(h.structs) == 2, "vector<struct> field from a literal");
  assert((h.structs[1] ?? Inner { z: 0 }).z == 2, "vector<struct> keeps its elements");

  // Building a KEYED collection from a vector of its elements.  `vector<E>` and
  // `hash<E[k]>` are not the same type and `convert` has no arm for the pair, so this
  // is the carve-out the check names by hand.  Both keyed kinds take it.
  kh = KeyedHolder { keyed: [], tag: 0 };
  kh.keyed = [E { k: 1, n: "a" }, E { k: 2, n: "b" }];
  assert(len(kh.keyed) == 2, "hash field built from a vector of elements");
  oh = OrderedHolder { ordered: [], tag: 0 };
  oh.ordered = [E { k: 2, n: "b" }, E { k: 1, n: "a" }];
  assert(len(oh.ordered) == 2, "sorted field built from a vector of elements");

  // A struct field, from a literal and from a call.
  h.inner = Inner { z: 3 };
  assert(h.inner.z == 3, "struct field from a literal");
  h.inner = r893_inner();
  assert(h.inner.z == 7, "struct field from a call");

  // A value and a `null` into a heap-nullable field.  Both must be ACCEPTED — a
  // nullable field is exactly the shape a too-eager type check would refuse, since
  // `Inner` and `null` are neither the field's declared type nor each other's.
  //
  // Only the value store is asserted.  What `h.maybe = null` then READS BACK is a
  // separate open defect — on the published 2026.8.0 the field keeps its previous
  // value, and `h.maybe == null` answers false even for a freshly built `maybe: null`
  // (loft#896).  Asserting today's answer here would pin a bug in place; asserting the
  // right answer would fail for a reason that has nothing to do with #893.
  h.maybe = null;
  h.maybe = Inner { z: 9 };
  assert((h.maybe ?? Inner { z: 0 }).z == 9, "nullable struct field takes a value");

  // An enum field, from a variant and from a call.
  h.colour = Colour::Blue;
  assert(h.colour == Colour::Blue, "enum field from a variant");
  h.colour = r893_colour();
  assert(h.colour == Colour::Green, "enum field from a call");

  // A text field, including a value derived from the field itself.
  h.label = "written";
  assert(h.label == "written", "text field from a literal");
  h.label = r893_label();
  assert(h.label == "from a call", "text field from a call");
  h.label = h.label + "!";
  assert(h.label == "from a call!", "text field from an expression over itself");

  // An integer into a `float` field widens — a conversion that cannot fail is implicit.
  h.ratio = 3;
  assert(h.ratio == 3.0, "float field widens an integer");

  h.tag = 41;
  assert(h.tag == 41, "integer field");
}
