// An index whose type pass 1 has not resolved yet is not a wrong index.
//
// Operand deferral widened so that ANY unresolved operand defers to pass 2 (a KNOWN
// operand beside an unknown one was OVERRIDING resolution, so `f() - 1` took its type
// from the literal and pass 2's real return then contradicted it).  That is correct,
// and it means `start = hlevel() + 1` legitimately arrives at pass 1 with no type when
// `hlevel` is declared lower in the file.
//
// `parse_text_index` refused such a bound outright.  The published `markdown` 0.2.0
// stopped compiling on exactly this shape (`heading_text = line[start..ln]` at
// markdown.loft:261), a library that had been building for two releases.  Declaration
// order must not decide whether a program compiles; the two-pass parser exists so it
// does not.
//
// ⚠ TWO refusal sites, not one, and they carry different messages: the index/start
// bound ("Cannot index text with 'unknown'") and the range END ("Cannot end a text
// slice at 'unknown'").  Guarding only the first left `s[start..start + 2]` — both
// bounds derived from one unresolved value — still refused, from four lines further
// down.  Every cell below therefore says WHICH bound it leaves unresolved.
//
// ⚠⚠ Every callee used by a forward cell is declared BELOW `main` on purpose.  An
// earlier draft of this file had them all above it, so nothing deferred, and the whole
// file passed while testing nothing at all.
//
// The refusals themselves stay — on pass 2, where the type is real.  Their negative
// cells are @EXPECT_ERROR functions in 102b-pass1-expected-errors.loft, because a
// compile error cannot be asserted from inside the program it kills.

fn above() -> integer {
  return 3;
}

fn main() {
  line = "## Title ##";
  ln = line.size();

  // START unresolved, end known — the markdown shape.
  start = hlevel() + 1;
  assert(start < ln, "bounds are sane");
  assert(line[start..ln] == "Title ##", "start bound from a forward-declared callee");

  // END unresolved, start known.
  assert(line[3..hlevel() + 9] == "Title ##", "end bound from a forward-declared callee");

  // BOTH unresolved, and both derived from the same unresolved value — the cell that
  // the start-only guard missed.
  assert(line[start..start + 5] == "Title", "both bounds, one forward-declared source");

  // BOTH unresolved from two different callees.
  lo = hlevel() + 1;
  hi = hlevel() + width() + 4;
  assert(line[lo..hi] == "Title ", "both bounds, two forward-declared callees");

  // A scalar index, which takes the same site as the start bound.
  assert(line[hlevel() + 1] == 'T', "scalar index from a forward-declared callee");

  // An open range, which has no end bound to resolve.
  assert(line[start..] == "Title ##", "open range from a forward-declared bound");

  // The backward direction is unchanged: a callee declared ABOVE still works.
  assert(line[above()..ln] == "Title ##", "callee declared above");
}

fn hlevel() -> integer {
  return 2;
}

fn width() -> integer {
  return 3;
}
