// @PLN35 Phase 6.3 (`#lexeme`) — a token-enum variant marks the field carrying its surface text
// with `#lexeme`, so a bare STRING LITERAL in a slice pattern matches against it: `"fn"` stands
// in for `Keyword { name: "fn" }` and reads like the grammar.  It desugars to an OR over the
// eligible variants of `tag(v[pos]) == disc && v[pos].<lexeme> == "fn"` (the field read is
// guarded by the tag test, so a wrong-variant offset is never read).  Composes with variant
// sub-patterns and `..rest`.  Cross-mode + leak-checked.

enum Token {
  Kw { #lexeme name: text }, // keyword — matched by its lexeme
  Punct { #lexeme sym: text }, // punctuation — matched by its lexeme
  Ident { name: text }, // NOT #lexeme — matched structurally + captured
  Num { value: integer },
}

// A tiny statement grammar, written the way you'd write the rules:
//   "fn" IDENT "(" ")"            |   "let" IDENT "=" NUM   |   "return" NUM
fn parse(v: vector<Token>) -> text {
  match v {
    [
      "fn",
      Ident { name },
      "(",
      ")",
    ] => "fn:{name}",
    [
      "let",
      Ident { name },
      "=",
      Num { value },
    ] => "let:{name}={value}",
    [
      "return",
      Num { value },
    ] => "ret:{value}",
    _ => "?",
  }
}

// `#lexeme` composes with `..rest`: match a leading keyword, keep the tail.
fn tail_after(v: vector<Token>) -> integer {
  match v { ["do", ..rest] => len(rest), _ => -1 }
}

fn main() {
  fnsig: vector<Token> = [
    Kw { name: "fn" },
    Ident { name: "foo" },
    Punct { sym: "(" },
    Punct { sym: ")" },
  ];
  letst: vector<Token> = [
    Kw { name: "let" },
    Ident { name: "x" },
    Punct { sym: "=" },
    Num { value: 42 },
  ];
  ret: vector<Token> = [
    Kw { name: "return" },
    Num { value: 7 },
  ];
  bad: vector<Token> = [
    Kw { name: "fn" },
    Ident { name: "foo" },
    Punct { sym: "[" },
    Punct { sym: ")" },
  ];
  // an Ident whose text is "fn" must NOT match the `"fn"` keyword literal (Ident.name isn't #lexeme)
  idfn: vector<Token> = [
    Ident { name: "fn" },
    Ident { name: "foo" },
    Punct { sym: "(" },
    Punct { sym: ")" },
  ];

  assert(parse(fnsig) == "fn:foo", "fn sig: {parse(fnsig)}");
  assert(parse(letst) == "let:x=42", "let stmt: {parse(letst)}");
  assert(parse(ret) == "ret:7", "return: {parse(ret)}");
  assert(parse(bad) == "?", "wrong punct '[' falls through: {parse(bad)}");
  assert(parse(idfn) == "?", "Ident \"fn\" is not the keyword \"fn\": {parse(idfn)}");

  assert(
    tail_after([
      Kw { name: "do" },
      Num { value: 1 },
      Num { value: 2 },
    ]) == 2,
    "lexeme + rest"
  );
  assert(tail_after([
    Num { value: 9 },
  ]) == -1, "no leading 'do'");

  print("35k-lexeme: PASS");
}
