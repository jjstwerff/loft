// @PLN25 DN3 — integer `/` and `%` TYPE `integer?` (they yield null at runtime on a zero
// divisor), so an undefended result into a non-null slot is REJECTED (that reject case lives
// in 102-expected-errors.loft). These are the ACCEPT cases — the divisor is provably non-zero
// or the result is honestly nullable:
//   - a constant non-zero literal divisor (`a / 2`, `a % 3`);
//   - a var proven non-zero by an enclosing `if v != 0 { … }` (THEN) guard;
//   - a var proven non-zero by an `if v == 0 { … } else { a / v }` (ELSE) guard;
//   - a `??`-discharged result (`a / b ?? d`);
//   - an honestly-`integer?`-declared result.
fn constdiv(a: integer) -> integer {
  a / 2
}
fn modconst(a: integer) -> integer {
  a % 3
}
fn guarded_then(a: integer, b: integer) -> integer {
  if b != 0 { return a / b; } 0
}
fn guarded_else(a: integer, b: integer) -> integer {
  if b == 0 { return -1; } else { a / b }
}
fn discharged(a: integer, b: integer) -> integer {
  a / b ?? 0
}
fn honest(a: integer, b: integer) -> integer? {
  a / b
}

fn main() {
  assert(constdiv(10) == 5, "constdiv={constdiv(10)}");
  assert(modconst(10) == 1, "modconst={modconst(10)}");
  assert(guarded_then(10, 2) == 5, "guarded_then={guarded_then(10, 2)}");
  assert(guarded_then(10, 0) == 0, "guarded_then0={guarded_then(10, 0)}");
  assert(guarded_else(10, 2) == 5, "guarded_else={guarded_else(10, 2)}");
  assert(guarded_else(10, 0) == -1, "guarded_else0={guarded_else(10, 0)}");
  assert(discharged(10, 0) == 0, "discharged={discharged(10, 0)}");
  assert((honest(10, 2) ?? -1) == 5, "honest={honest(10, 2) ?? -1}");
  // honest(10, 0) divides by zero → null at runtime (the result is honestly `integer?`).
  assert(honest(10, 0) == null, "honest0 should be null");
}
