//
// Regression (GitHub #254): a chained cast `EXPR as T1 as T2` failed to parse
// ("Expect token ;" at the second `as`) because the `as` branch returned early
// from the Pratt loop instead of updating the current type and continuing. The
// fix lets `as` fall through so chains parse left-associatively.

fn main() {
  v = 2.7;
  x = (v + 0.5) as integer as float; // 3.2 -> 3 -> 3.0
  assert(x == 3.0, "x={x} expect 3.0");

  w = 300.9;
  // a four-link chain mixing narrowing and widening
  a = w as integer as i32 as integer as float;
  assert(a == 300.0, "a={a} expect 300.0");

  // single cast still works (no regression)
  b = (w as integer) as float;
  assert(b == 300.0, "b={b} expect 300.0");

  println("chained-as-cast ok");
}
