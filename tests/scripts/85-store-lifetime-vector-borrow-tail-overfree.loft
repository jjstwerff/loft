// @PLN85 step-6 regression — an IMPLICIT-TAIL return of a BORROWED whole-vector
// view of a parameter (`fn view(b: Box) -> vector<M> { b.rows }`) must copy the
// view into the return buffer WITHOUT freeing the borrowed source.
//
// `copy_borrow_tail_into_retbuf` captured the borrowed tail into a `__fwd` local
// with empty deps, then clear+append-copied it into __retbuf — but `__fwd`'s
// scope-exit OpFreeRef then whole-store-freed the borrowed source (the caller's
// `b.rows` vector), which allocation pressure recycled -> b.rows reads a foreign
// length. Fix: append the borrowed tail DIRECTLY (no __fwd local), matching the
// proven explicit `return b.rows;` path, which frees nothing.
//
// Both backends were affected (unlike the Reference-element sibling
// 85-store-lifetime-vector-view-call-bind-overfree, which was native-only).
// The EXPLICIT-return form was already correct; this guards the IMPLICIT tail.

struct M {
  hp: integer,
  name: text,
}
struct Box {
  rows: vector<M>,
}

fn view_rows(b: Box) -> vector<M> {
  b.rows
} // borrowed implicit-tail vector view

fn filler(n: integer) -> integer {
  es: vector<M> = [];
  for j in 0..n { es += [M { hp: j, name: "RECYCLE-{j}" }]; }
  return len(es);
}

fn main() {
  b = Box { rows: [] };
  b.rows += [M { hp: 5, name: "rat" }];
  b.rows += [M { hp: 8, name: "bat" }];

  for i in 0..4 {
    r = view_rows(b); // r := independent copy of b.rows
    acc = 0;
    for k in 0..6 { acc += filler(4); } // recycle the slot a bad free released
    assert(acc == 24, "iter {i}: filler churn ran");
    assert(len(r) == 2, "iter {i}: len(r)={len(r)} (copy intact)");
    assert(
      len(b.rows) == 2,
      "iter {i}: len(b.rows)={len(b.rows)} (no over-free of borrowed source)"
    );
    first = b.rows[0] ?? M { hp: 0, name: "" };
    assert(first.name == "rat", "iter {i}: b.rows[0] intact, got '{first.name}'");
  }
  println("vector-borrow-tail-overfree ok");
}
