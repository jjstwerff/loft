//
// A value produced by a JOIN borrows whichever arm ran, so its dep list must name every
// arm it could have come from — @FR-O-Complete, "the fact per binding, per path".
//
// `Function::change_var_type` used to adopt an incoming type's deps with
// `for on in type_def.depend() { self.depend(var_nr, on); }`, and `Function::depend`
// REPLACES the list (`Type::depending` -> `with_deps(Deps::frame1(on))`).  So a type
// carrying N deps collapsed to its LAST one: a two-borrow join recorded one source and
// lost the other outright, and a mixed owned/borrowed join dropped the owning arm's mint
// marker and published itself as a pure borrow.  Nine sites shared that loop — six in
// `variables/mod.rs` plus three siblings, one of which STRIPPED every dep in a correct
// loop and RESTORED only the last.
//
// The dep list has no direct spelling in the language, so what this file can pin is the
// consequence: every arm's value must survive the join, and the borrowed source must be
// neither freed nor clobbered by it.  The predicate itself is guarded in
// `variables::loop_binding_dep_tests`, which is where the collapse is actually visible.
//
// The four cells are the matrix that found the surviving hole: the owning arm is either a
// CALL or an INLINE mint, spelled as either `if` or `match`.  They are not
// interchangeable — `minted_vars` cannot see a mint inside a callee, so `arm_join_type`'s
// strip engages only on the inline cell.  Dropping a cell drops the distinction.

fn grow_d8(src: vector<integer>) -> vector<integer> {
  out: vector<integer> = [];
  for v in src { out += [v + 10]; }
  out
}

fn test_a_two_borrow_join_keeps_both_sources() {
  a: vector<integer> = [1];
  b: vector<integer> = [2, 2];
  k = 3;
  pick = if k > 2 { a } else { b };
  assert(len(pick) == 1, "the taken arm answers its own length, got {len(pick)}");
  // Both sources must outlive the join: the one it did NOT take is the dep the collapse lost.
  assert(len(a) == 1, "the taken source is intact, got {len(a)}");
  assert(len(b) == 2, "the untaken source is intact, got {len(b)}");
  assert((pick[0] ?? -1) == 1, "the join answers the taken arm's element");
}

fn test_a_mixed_join_through_a_call_keeps_its_borrowed_source() {
  cp: vector<integer> = [1, 2, 3];
  line = if len(cp) > 2 { grow_d8(cp) } else { cp };
  assert(len(line) == 3, "the owning arm answers three, got {len(line)}");
  assert((line[0] ?? -1) == 11, "the owning arm answers the grown value");
  assert((cp[0] ?? -1) == 1, "the borrowed source is not clobbered by the join");
}

fn test_a_mixed_join_through_a_call_as_a_match() {
  cp: vector<integer> = [1, 2, 3];
  line = match len(cp) { 0 => cp, _ => grow_d8(cp) };
  assert(len(line) == 3, "the match owning arm answers three, got {len(line)}");
  assert((line[0] ?? -1) == 11, "the match owning arm answers the grown value");
  assert((cp[0] ?? -1) == 1, "the borrowed source survives the match join");
}

fn test_a_mixed_join_that_mints_inside_the_arm() {
  // The cell `arm_join_type`'s strip acts on: the mint is IN the arm, not behind a call.
  cp: vector<integer> = [1, 2, 3];
  ii = if len(cp) == 0 { cp } else { [for v in cp { v + 20 }] };
  mm = match len(cp) { 0 => cp, _ => [for v in cp { v + 30 }] };
  assert((ii[0] ?? -1) == 21, "the if inline-mint arm answers its own value");
  assert((mm[0] ?? -1) == 31, "the match inline-mint arm answers its own value");
  assert(len(ii) == 3 && len(mm) == 3, "both inline-mint arms answer three");
  assert((cp[0] ?? -1) == 1, "the borrowed source survives both inline-mint joins");
}

fn test_repeated_joins_do_not_accumulate_stores() {
  // Per ITERATION: a join whose owning arm's store is never freed shows up here and
  // nowhere else, because a single join leaks once and the gate reports a total.
  t = 0;
  for i in 0..30 {
    cp: vector<integer> = [i, i + 1, i + 2];
    line = if i % 2 == 0 { grow_d8(cp) } else { cp };
    t += len(line) + (line[0] ?? 0) - i;
  }
  assert(t == 240, "fifteen grown arms and fifteen borrowed ones sum to 240, got {t}");
}
