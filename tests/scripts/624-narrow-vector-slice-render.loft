//
// Regression for #624 — whole-vector operations on a NARROW integer vector
// (`vector<u8>` / `<u16>` / a 4-byte `integer` subtype) must honour the packed
// 1/2/4-byte element width instead of striding 8 bytes over it.
//
// Two sites carried the wide `integer` storage row where the element READ and
// the `+=` append already resolved the narrow one:
//
//   * the `v[a..b]` slice materialise loop allocated each element through the
//     wide row and stored it with `OpSetInt`, so one 8-byte write covered eight
//     1-byte slots — the slice kept only its FIRST element and read zeros for
//     the rest, at the correct `len()`, so a length assert and a `v[0]`
//     spot-check both passed over corrupt data;
//   * `{v}` dumped through the wide row, printing the first eight `u8` elements
//     packed into one i64 followed by zeros.
//
// Same class as @P314 (`tests/scripts/135-vector-u8-concat.loft`), where the
// concat op lost the narrow content type. Runs on BOTH backends — the bug was
// byte-identical on `--interpret` and `--native`, so a single-backend guard
// would not have caught it.

// Distinctive per-width values: `u16`/`i32` cases exceed the next width down, so
// a width mix-up cannot coincidentally read correct.

fn test_624_u8_slice_keeps_every_element() {
  v: vector<u8> = [];
  for i in 0..8 { v += [((i + 11) as u8?) ?? 0]; }
  s = v[1..5];
  assert(len(s) == 4, "u8 slice len={len(s)} (expect 4)");
  // The pre-fix slice read [12,0,0,0]: correct length, correct first element.
  assert((s[0] ?? -1) == 12, "u8 slice[0]={s[0] ?? -1} (expect 12)");
  assert((s[1] ?? -1) == 13, "u8 slice[1]={s[1] ?? -1} (expect 13)");
  assert((s[2] ?? -1) == 14, "u8 slice[2]={s[2] ?? -1} (expect 14)");
  assert((s[3] ?? -1) == 15, "u8 slice[3]={s[3] ?? -1} (expect 15)");
}

fn test_624_u16_and_i32_slice_widths() {
  a: vector<u16> = [];
  for i in 0..8 { a += [((i + 300) as u16?) ?? 0]; } // > 1 byte
  sa = a[1..5];
  assert(len(sa) == 4, "u16 slice len={len(sa)} (expect 4)");
  assert((sa[0] ?? -1) == 301, "u16 slice[0]={sa[0] ?? -1} (expect 301)");
  assert((sa[3] ?? -1) == 304, "u16 slice[3]={sa[3] ?? -1} (expect 304)");

  b: vector<i32> = [];
  for i in 0..8 { b += [((i + 100000) as i32?) ?? 0]; } // > 2 bytes
  sb = b[1..5];
  assert(len(sb) == 4, "i32 slice len={len(sb)} (expect 4)");
  assert((sb[0] ?? -1) == 100001, "i32 slice[0]={sb[0] ?? -1} (expect 100001)");
  assert((sb[3] ?? -1) == 100004, "i32 slice[3]={sb[3] ?? -1} (expect 100004)");
}

fn test_624_signed_narrow_slice() {
  v: vector<i8> = [];
  for i in 0..8 { v += [((i - 4) as i8?) ?? 0]; }
  s = v[1..5];
  assert(len(s) == 4, "i8 slice len={len(s)} (expect 4)");
  assert((s[0] ?? 99) == -3, "i8 slice[0]={s[0] ?? 99} (expect -3)");
  assert((s[3] ?? 99) == 0, "i8 slice[3]={s[3] ?? 99} (expect 0)");
}

fn test_624_whole_vector_render_honours_element_width() {
  v: vector<u8> = [];
  for i in 0..8 { v += [((i + 1) as u8?) ?? 0]; }
  // Pre-fix: "[578437695752307201,0,0,0,0,0,0,0]" — 0x0807060504030201 is the
  // eight one-byte elements read as a single i64.
  assert("{v}" == "[1,2,3,4,5,6,7,8]", "u8 render={v} (expect [1,2,3,4,5,6,7,8])");

  w: vector<u16> = [];
  for i in 0..4 { w += [((i + 300) as u16?) ?? 0]; }
  assert("{w}" == "[300,301,302,303]", "u16 render={w} (expect [300,301,302,303])");
}

// The slice result must itself be a well-formed narrow vector: re-slicing it and
// iterating it both read the packed elements, not a stale 8-byte stride.
fn test_624_slice_result_is_reusable() {
  v: vector<u8> = [];
  for i in 0..8 { v += [((i + 11) as u8?) ?? 0]; }
  s = v[1..5];
  again = s[1..3];
  assert(len(again) == 2, "u8 reslice len={len(again)} (expect 2)");
  assert("{again}" == "[13,14]", "u8 reslice={again} (expect [13,14])");

  sum = 0;
  for x in v[2..6] { sum = sum + x; }
  assert(sum == 13 + 14 + 15 + 16, "u8 slice for-loop sum={sum} (expect 58)");
}

// A wide `vector<integer>` and a `vector<text>` were already correct — keep them
// in the guard so a future narrow-width change cannot fix the narrow case by
// breaking the wide one.
fn test_624_wide_and_text_slices_unaffected() {
  g: vector<integer> = [];
  for i in 0..8 { g += [i + 1000000000000]; }
  sg = g[1..5];
  assert(len(sg) == 4, "integer slice len={len(sg)} (expect 4)");
  assert((sg[0] ?? -1) == 1000000000001, "integer slice[0]={sg[0] ?? -1}");
  assert((sg[3] ?? -1) == 1000000000004, "integer slice[3]={sg[3] ?? -1}");

  h: vector<text> = [];
  for i in 0..4 { h += ["x{i}"]; }
  sh = h[1..3];
  assert(len(sh) == 2, "text slice len={len(sh)} (expect 2)");
  assert((sh[0] ?? "") == "x1", "text slice[0]={sh[0] ?? \"\"} (expect x1)");
}
