//
// loft#810 — a METHOD that returns a record through the caller's hidden return
// buffer was ADOPTED without a copy and then freed as if the binding owned it.
//
// Two halves of the compiler decide this together, and they disagreed on which
// callees they were talking about. `scopes.rs` accepts a global (`n_`) and a
// method (`t_`) alike: on that basis it strips the binding's deps, which is what
// makes the scope-exit `OpFreeRef` fire. The two interpreter sites that decide
// whether to deep-COPY accepted only `n_`. So a method's return aliased the
// caller's `__ref_N` buffer AND was freed at scope exit — the buffer's store went
// back to the pool while the caller still named it, and the next iteration handed
// that slot to somebody else.
//
// **The damage is a WRONG VALUE, not a crash**, which is why the shape matters
// more than the arithmetic. Whether two owners of one slot collide at all depends
// on what the recycled slot is used for next: the reported case (a library method
// building another package's record) landed on a record header and died inside
// `memcpy`; `build` below merely loses a vector, and answers a plausible number.
// So every cell asserts a COUNT it can only reach with both vectors intact.
//
// The callee needs `tag_of` — a nested call whose return buffer is a store — for
// the same reason: without a competing allocation between the free and the next
// iteration's re-adoption, the freed slot is handed straight back and the bug is
// invisible. It is the composition that fails, not any one ingredient.

struct Bound { k: integer }
struct Acc { const binds: vector<Bound>, const notes: vector<text>, tail: text }
struct Tag { s: text, m: integer }
struct T { nm: text }
struct M { n: integer }
struct H { const items: vector<M> }

fn tag_of(self: T) -> Tag { r: Tag = Tag { s: self.nm, m: 7 }; return r }

// A method returning through the caller's buffer (`-> Acc["q"]`), holding a
// nested call that allocates a store of its own.
fn build(self: T, v: integer) -> Acc {
  q: Acc = Acc { };
  g = tag_of(self);
  q.tail += g.s;
  q.notes += ["n{g.m}"];
  q.binds += [Bound { k: v }];
  return q;
}

// CONTROL callees. Their returns are NOT tied to a caller buffer, so the fix must
// leave them exactly as they were — adopting, with no copy and no leak.
fn grow(self: H, k: integer) -> H {
  out: H = H { };
  out.items += [M { n: k }];
  out.items += [M { n: k + len(self.items) }];
  return out;
}
fn same(self: M) -> M { return self }
fn cols(self: T) -> vector<text> { out: vector<text> = []; out += [self.nm]; out += ["z"]; return out }

fn main() {
  t = T { nm: "a" };

  // A — the binding is FIRST-assigned from the call, in the loop body.
  a = 0;
  for i in 0..3 { q = build(t, i); a += len(q.binds) + len(q.notes) }
  assert(a == 6, "A: first-Set in a loop body: {a}");

  // B — the binding is REASSIGNED. A different codegen site decides this one, and
  // it carried the same narrow gate: A alone passes with B still broken.
  b = 0;
  qb: Acc = Acc { };
  for i in 0..3 { qb = build(t, i); b += len(qb.binds) + len(qb.notes) }
  assert(b == 6, "B: reassignment of an outer local: {b}");

  // C — first-assigned to null, then set inside a nested block. Reads as a
  // first-Set and lowers as a reassignment.
  c = 0;
  for i in 0..3 {
    if i >= 0 { qc = build(t, i); c += len(qc.binds) + len(qc.notes) }
  }
  assert(c == 6, "C: assignment inside a nested block: {c}");

  // D — the value must SURVIVE the call, not merely be counted during it. A
  // binding that aliased a recycled buffer reads the next iteration's data here.
  d = "";
  for i in 0..3 { q = build(t, i); d += "{q.tail}{len(q.binds)}" }
  assert(d == "a1a1a1", "D: the returned record's own fields: {d}");

  // CONTROL 1 — a callee whose return is a genuinely fresh store still adopts it.
  // Without this cell, copying every method return would pass A–D and pay a deep
  // copy on every call in the language.
  h = H { items: [M { n: 1 }] };
  s1 = 0;
  for i in 0..3 { g = grow(h, i); s1 += len(g.items); for m in g.items { s1 += m.n } }
  assert(s1 == 15, "control: adopts-fresh return: {s1}");
  assert(len(h.items) == 1, "control: adopts-fresh return left its argument alone");

  // CONTROL 2 — a method that returns a VISIBLE parameter. The binding must not
  // take the source's store with it when it dies.
  m = M { n: 5 };
  s2 = 0;
  for i in 0..3 { p = same(m); s2 += p.n }
  assert(s2 == 15, "control: returned parameter read: {s2}");
  assert(m.n == 5, "control: returned parameter survived the bindings: {m.n}");

  // CONTROL 3 — the VECTOR return buffer travels a different path (`__vdb_N`) and
  // was already right. It must stay right.
  s3 = 0;
  for i in 0..3 { cv = cols(t); s3 += len(cv) }
  assert(s3 == 6, "control: vector return through the caller's buffer: {s3}");

  println("ok");
}
