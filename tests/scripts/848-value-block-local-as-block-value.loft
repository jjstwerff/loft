//
// Regression: a value-block whose value is a local the block DECLARED answered
// `null` — silently, with no diagnostic, on both backends (loft#848).
//
//     out: A = match 0 { _ => { p: A = A { x: 10 }; p } };
//     return out;                                          // -> null
//
// The filed scope named `match`, "the first arm" and an enum; none of those is
// the axis.  What it needs is a REFERENCE type and a block VALUE that is a local
// the block declared — an `if` does it, one arm with a constant scrutinee does
// it, and a plain struct does it.  A field read off the same binding (`out.x`)
// is fine, which is most of why the shape survived review.
//
// The mechanism is a cross-pass work-ref collision.  The variable tables persist
// across passes BY NAME while the `__ref_N` counter restarts each pass, and
// several mint sites can fire only on pass 2 (they need types and layouts pass 1
// does not have).  Such a site shifts every later `__ref_N` by one — and the name
// it takes over is the one pass 1 left on the RETURN BUFFER, since `ref_return`
// promotes the returned work-ref to an argument.  So the block materialised its
// result into the buffer the real return re-mints with `OpDatabase`, and the copy
// at the return read the destroyed store.
//
// That is why only the FIRST such block in a function was wrong: only one site
// can win the single buffer, so a two-block function returning the SECOND block's
// binding is correct.  A two-block test passes where a one-block test fails.
//
// The fix gives each pass-2-only mint site its own `__ref_p2_N` sequence
// (`Vars::work_refs_p2`), the remedy `__work_p2_N` / `__vdb_N` / `__kvb_N` already
// use.  Cells below hold every axis of the matrix that moved.

struct A { x: integer }
struct P { a: integer, b: integer }
enum E { EA { a: A }, EB { b: A }, ENone }

// 1 — the reported shape: one value-block, returned WHOLE.
fn m1() -> A { out: A = match 0 { _ => { p: A = A { x: 10 }; p } }; return out; }

// 2 — two blocks, returning the SECOND.  Correct even when broken: its work-ref
//     is a plain local, because the FIRST block already took the buffer's name.
//     The control that shows the harness runs, not evidence of a fix.
fn m2() -> A {
  a: A = match 0 { _ => { p: A = A { x: 10 }; p } };
  b: A = match 0 { _ => { q: A = A { x: 20 }; q } };
  assert(a.x == 10, "m2 first binding: {a.x}");
  return b;
}

// 3 — the decisive cell: the same function returning the FIRST block's binding.
fn m3() -> A {
  a: A = match 0 { _ => { p: A = A { x: 10 }; p } };
  b: A = match 0 { _ => { q: A = A { x: 20 }; q } };
  assert(b.x == 20, "m3 second binding: {b.x}");
  return a;
}

// 4 — three blocks, still the first.  A later block does not rescue an earlier one.
fn m4() -> A {
  a: A = match 0 { _ => { p: A = A { x: 10 }; p } };
  b: A = match 0 { _ => { q: A = A { x: 20 }; q } };
  c: A = match 0 { _ => { r: A = A { x: 30 }; r } };
  assert(b.x == 20, "m4 second binding: {b.x}");
  assert(c.x == 30, "m4 third binding: {c.x}");
  return a;
}

// 5 — `if` rather than `match`: the defect is not `match`-specific.
fn m5() -> A {
  out: A = if true { p: A = A { x: 11 }; p } else { z: A = A { x: 0 }; z };
  return out;
}

// 6 — the result read as a FIELD instead of used whole.  Correct even when broken.
fn m6() -> integer {
  out: A = if true { p: A = A { x: 13 }; p } else { z: A = A { x: 0 }; z };
  return out.x;
}

// 7 — real branching, so the arm is chosen by the scrutinee and not by source order.
fn m7(k: integer) -> A {
  out: A = match k {
    0 => { p: A = A { x: 1 }; p },
    1 => { p: A = A { x: 2 }; p },
    _ => { p: A = A { x: 3 }; p },
  };
  return out;
}

// 8 — a multi-field record: a destroyed store answers null for EVERY field, so
//     one field passing is not evidence the record survived.
fn m8() -> P {
  out: P = if true { p: P = P { a: 7, b: 8 }; p } else { z: P = P { a: 0, b: 0 }; z };
  return out;
}

// 9 — the enum shape the issue was filed as.  A SECOND mint site (the variant
//     constructor, also pass-2-only) reaches the buffer here, so the struct cells
//     above passing does not cover it — this cell is what found that.
fn m9(k: integer) -> E {
  out: E = match k {
    0 => { v: E = EA { a: A { x: 5 } }; v },
    1 => { v: E = EB { b: A { x: 6 } }; v },
    _ => { v: E = ENone; v },
  };
  return out;
}
fn show(self: E) -> text { match self { EA { a } => "A{a.x}", EB { b } => "B{b.x}", ENone => "none" } }

// 10 — nested value-blocks: the inner block's value is the outer block's value.
fn m10() -> A {
  out: A = if true {
    inner: A = if true { p: A = A { x: 17 }; p } else { z: A = A { x: 0 }; z };
    inner
  } else { z: A = A { x: 0 }; z };
  return out;
}

// 11 — the two blocks reuse ONE local name.  Name reuse is not the axis, and both
//      bindings must stay independently readable.
fn m11() -> A {
  a: A = if true { p: A = A { x: 18 }; p } else { z: A = A { x: 0 }; z };
  b: A = if true { p: A = A { x: 19 }; p } else { z: A = A { x: 0 }; z };
  assert(b.x == 19, "m11 second binding: {b.x}");
  return a;
}

// 12 — two blocks with the return chosen at run time, so neither is dead.
fn m12(k: integer) -> A {
  a: A = if true { p: A = A { x: 15 }; p } else { z: A = A { x: 0 }; z };
  b: A = if true { q: A = A { x: 16 }; q } else { z: A = A { x: 0 }; z };
  if k == 0 { return a }
  return b;
}

fn main() {
  assert(m1().x == 10, "m1 single block returned whole: {m1().x}");
  assert(m2().x == 20, "m2 second-block control: {m2().x}");
  assert(m3().x == 10, "m3 first of two blocks: {m3().x}");
  assert(m4().x == 10, "m4 first of three blocks: {m4().x}");
  assert(m5().x == 11, "m5 if-block: {m5().x}");
  assert(m6() == 13, "m6 field-read control: {m6()}");
  assert(m7(0).x == 1, "m7 arm 0: {m7(0).x}");
  assert(m7(1).x == 2, "m7 arm 1: {m7(1).x}");
  assert(m7(2).x == 3, "m7 arm 2: {m7(2).x}");
  assert(m8().a == 7, "m8 field a: {m8().a}");
  assert(m8().b == 8, "m8 field b: {m8().b}");
  assert(m9(0).show() == "A5", "m9 arm 0: {m9(0).show()}");
  assert(m9(1).show() == "B6", "m9 arm 1: {m9(1).show()}");
  assert(m9(2).show() == "none", "m9 arm 2: {m9(2).show()}");
  assert(m10().x == 17, "m10 nested blocks: {m10().x}");
  assert(m11().x == 18, "m11 reused local name: {m11().x}");
  assert(m12(0).x == 15, "m12 first binding: {m12(0).x}");
  assert(m12(1).x == 16, "m12 second binding: {m12(1).x}");
  println("848 ok");
}
