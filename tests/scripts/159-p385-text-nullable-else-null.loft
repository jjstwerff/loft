// @P385 + @P386 — `if cond { v[i] ?? null } else { null }` for vector-index `text` element
//
// Sister-bug regression guard.  The probe shape exercises BOTH bugs end-to-end:
//
// @P385 (parser, fixed in src/parser/mod.rs:992,999):
//   Pre-fix: parser failed with `expected text, got null on else` because the
//   if-branch's type carried vector-index deps (e.g. `Type::Text(deps_from_v_index)`)
//   while `OpConvTextFromNull.returned` is `Type::Text(vec![])`, so the `==` match
//   in `src/parser/mod.rs::convert` (lines 992 / 999) rejected the FromNull
//   conversion.  Fix: relax those two `==` checks to `Type::is_equal(...)`,
//   which already treats any `Type::Text(_), Type::Text(_)` pair as
//   structurally equal.  Interpreter is fully green at this layer.
//
// @P386 (native codegen, fixed in src/generation/{calls,emit}.rs):
//   Pre-fix: even after @P385 made the parser accept this shape, native
//   codegen failed with rustc E0308 ("expected `&str`, found `Str`") because
//   the `??` value-block's tail materialises as `_ret.to_string()` (owned
//   `String`) while the typed-null else-branch emits a `&str` sentinel —
//   the two if-arms failed to unify on Rust's `if` type.  Fix: detect the
//   `text_string_unify` shape in `output_if_inner` and wrap both arms in
//   `.to_string()` to unify on `String`; route the unified value through
//   `stores.scratch` so the outer `Str::new(...)` borrow is sound for the
//   function's `&str` return.
//
// This test exercises the three shapes the compiler must now accept on both
// backends:
//   (a) hit-branch returns the vector value
//   (b) miss-branch returns null
//   (c) outer `?? "fallback"` resolves a chained-coalesce on the result
//
// The mirror shape `if cond { "lit" } else { null }` was always fine
// (literal text branch carries empty deps); this test pins the
// vector-element-source case that used to fail.

fn probe(v: vector<text>, idx: integer) -> text? {
  if idx < len(v) { v[idx] ?? null } else { null }
}

fn main() {
  // (a) hit branch: should return "a"
  hit = probe(["a", "b"], 0) ?? "missing";
  assert(hit == "a", "p385 hit: got '{hit}', want 'a'");

  // (b) miss branch: returns null, then chained ?? gives the fallback
  miss = probe(["a"], 5) ?? "missing";
  assert(miss == "missing", "p385 miss: got '{miss}', want 'missing'");

  // (c) chained coalesce on the result
  fb = probe([], 0) ?? "fallback";
  assert(fb == "fallback", "p385 fallback: got '{fb}', want 'fallback'");

  println("p385 PASSED");
}
