// @PLN10 (retire `stores.scratch`) — value-position text-dest synth-temp.
//
// Build 2: every text-dest native (to_lowercase / to_uppercase / replace) called
// in *value position* — argument, comparison, chain, concat, format, conditional,
// struct-field write, loop body — is wrapped in a scope-bound work-text temp
// instead of the never-cleared `stores.scratch` buffer.  All these shapes routed
// through scratch before the producer-side chokepoint.  Locks correctness on
// every backend (interpreter / native / wasm).
struct Box {
  name: text,
}

fn took(s: text) -> integer {
  len(s)
}

fn main() {
  base = "HeLLo";

  // argument position — native result passed straight into a fn
  assert(took(base.to_lowercase()) == 5, "arg position");

  // comparison — transient, no persistent destination
  assert(base.to_lowercase() == "hello", "compare");

  // chain — inner native result feeds outer native
  assert(base.to_lowercase().replace("l", "L") == "heLLo", "chain");

  // concat — two natives building one value
  assert(base.to_lowercase()+base.to_uppercase() == "helloHELLO", "concat");

  // format interpolation
  fs = "[{base.to_lowercase()}]";
  assert(fs == "[hello]", "format");

  // conditional expression
  flag = true;
  ce = if flag { base.to_lowercase() } else { base.to_uppercase() };
  assert(ce == "hello", "cond");

  // struct-field write
  b = Box { name: "" };
  b.name = base.to_lowercase();
  assert(b.name == "hello", "field");

  // loop body, VALUE position — each iteration must produce a FRESH value,
  // never accumulate into a reused temp (the synth-temp re-init guard).
  for li in 0..3 { assert(base.to_lowercase() == "hello", "loop value-position no-accumulate"); }

  // nested inside a larger arithmetic expression
  total = took(base.to_lowercase())+took(base.to_uppercase());
  assert(total == 10, "nested arg arithmetic");

  println("text-dest synth-temp: all shapes ok");
}
