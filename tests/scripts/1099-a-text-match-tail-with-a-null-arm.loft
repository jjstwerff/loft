//
// A `-> text` function whose tail is a `match` with a `null` arm COMPILES (loft#1099).
//
// It aborted the compiler instead:
//
//     H5 two-pass contract: def `n_f` (#710) grew a pass-2-only attribute `___acc_1`
//     (pass1=2, pass2=3) that is not a documented lazy append — a real cross-pass divergence
//
// `do_if_acc` promotes a per-arm text accumulator, and `text_return` then makes it a hidden
// `&text` PARAMETER — so the verdict decides ARITY, and it has to answer the same on both
// passes or pass 2 moves a signature pass 1 already published to every caller. That is the
// rule `formal/ownership.md` states for its own sibling ("a verdict that differed across
// passes would move the hidden buffer argument between them"), and the H5 contract is what
// turns breaking it into an abort rather than a corrupt frame.
//
// One term of the gate was not pass-stable: it reads the tail's INFERRED type, and for
// `match k { -1 => null, _ => a }` that is `Optional(Text)` on pass 1 and `Text` on pass 2
// from IR the two passes leave byte-identical. So the accumulator was minted on pass 2
// alone. The `if` spelling of the same program was stable and always compiled, which is what
// says this is about the inference and not about the null arm.
//
// The cure is the one `do_tret_bind` two blocks above already uses for its own hidden `&text`
// buffer, in its own words: rather than enumerate which tails infer stably, make pass 2
// FOLLOW pass 1 — promote on pass 2 only where pass 1 already minted the attribute.
//
// Each cell asserts what the ICE was hiding: that it compiles at all, and then the value of
// EVERY arm. `--native` is the half that matters most here — a text `match` tail whose arms
// are not accumulated is where the native emitter reports E0716/E0599 while the interpreter
// is correct, so an interpreter-only pass would not have said much.
//
// The five declared warnings below record which cells report `(N-Store)`, and every cell that
// stores a nullable tail into a non-null `text` return is one of them: the four `match`
// spellings and the `if`. That symmetry arrived with loft#1100 (`calls.md` D-call-5) — until
// then a `match` whose arm IS the null literal said nothing, because the report and the
// per-arm accumulator read the SAME inferred tail type and the gate could only serve one of
// them. The report now reads that type before the accumulator rewrite retypes it, so the
// spelling no longer decides whether the store is diagnosed.
//
// @EXPECT_WARNING: a nullable `text?` is stored into the return value of the non-null type `text`
// @EXPECT_WARNING: a nullable `text?` is stored into the return value of the non-null type `text`
// @EXPECT_WARNING: a nullable `text?` is stored into the return value of the non-null type `text`
// @EXPECT_WARNING: a nullable `text?` is stored into the return value of the non-null type `text`
// @EXPECT_WARNING: a nullable `text?` is stored into the return value of the non-null type `text`

fn t_null_and_local(k: integer) -> text {
  a = "ab";
  match k { -1 => null, _ => a }
}

fn t_null_local_literal(k: integer) -> text {
  a = "ab";
  match k { -1 => null, 0 => a, _ => "z" }
}

fn t_four_arms(k: integer) -> text {
  a = "ab";
  match k { -1 => null, 0 => a, 1 => "y", _ => "z" }
}

fn t_nested_arm(k: integer) -> text {
  a = "ab";
  match k { -1 => if k < -5 { null } else { "n" }, _ => a }
}

// THE REPORTED CELL. Every assertion here is unreachable code until the file compiles, which
// is the point: the guard's first job is to be a program the compiler accepts.
fn test_a_null_arm_beside_a_local_arm_compiles_and_answers() {
  assert(t_null_and_local(0) == "ab", "the local arm delivers its text, got {t_null_and_local(0)}");
  assert(t_null_and_local(-1) == null, "the null arm delivers null");
}

fn test_every_arm_of_a_longer_chain() {
  assert(t_null_local_literal(0) == "ab", "local arm: {t_null_local_literal(0)}");
  assert(t_null_local_literal(5) == "z", "literal arm: {t_null_local_literal(5)}");
  assert(t_null_local_literal(-1) == null, "null arm");

  assert(t_four_arms(0) == "ab", "four arms, local: {t_four_arms(0)}");
  assert(t_four_arms(1) == "y", "four arms, middle literal: {t_four_arms(1)}");
  assert(t_four_arms(5) == "z", "four arms, last literal: {t_four_arms(5)}");
  assert(t_four_arms(-1) == null, "four arms, null");
}

// The null is one level in, so the recogniser has to see it at depth rather than only as the
// arm's own terminal.
fn test_a_null_nested_inside_an_arm() {
  assert(t_nested_arm(0) == "ab", "outer local arm: {t_nested_arm(0)}");
  assert(t_nested_arm(-1) == "n", "the nested else, not the nested null: {t_nested_arm(-1)}");
}

// One call per iteration, because the accumulator promotion is per CALL: a signature that
// moved between passes shows as a corrupt frame or a lost argument at the call, not at the
// definition. The loop is also what the harness leak gate scores.
fn test_many_calls_answer_and_do_not_accumulate() {
  hits = 0;
  nulls = 0;
  for i in 0..200 {
    r = t_null_local_literal(i - 1);
    if r == null { nulls += 1; } else { hits += len(r); }
  }
  assert(nulls == 1, "one call takes the null arm, got {nulls}");
  // k = 0 answers "ab" (2 chars); k = 1..198 answer "z" (1 char each).
  assert(hits == 2 + 198, "the value arms hold 200 characters in total, got {hits}");
}

// ── controls: the shapes whose verdict must not move ─────────────────────────

// A DECLARED-nullable return passes the gate on its own disjunct, so it keeps its
// accumulator — and it must, because losing the per-arm delivery is what made the whole
// `match` compile as one Rust expression whose arms cannot unify (loft#741, native E0308).
fn t_nullable_return(k: integer) -> text? {
  a = "ab";
  match k { -1 => null, _ => a }
}

fn test_a_declared_nullable_return_is_unchanged() {
  assert((t_nullable_return(0) ?? "-") == "ab", "nullable return, local arm");
  assert(t_nullable_return(-1) == null, "nullable return, null arm");
}

// No null arm at all — the ordinary accumulated text `match`, which must keep promoting.
fn t_no_null_arm(k: integer) -> text {
  match k { 0 => "ab", _ => "z" }
}

fn test_a_match_without_a_null_arm_is_unchanged() {
  assert(t_no_null_arm(0) == "ab", "no null arm, first: {t_no_null_arm(0)}");
  assert(t_no_null_arm(5) == "z", "no null arm, last: {t_no_null_arm(5)}");
}

// The `if` spelling of the reported cell, which compiled throughout. Asserted so the file
// says the two spellings now agree rather than leaving that to the reader.
fn t_if_spelling(k: integer) -> text {
  a = "ab";
  if k == -1 { null } else { a }
}

fn test_the_if_spelling_agrees() {
  assert(t_if_spelling(0) == "ab", "if spelling, value arm");
  assert(t_if_spelling(-1) == null, "if spelling, null arm");
  assert(t_if_spelling(0) == t_null_and_local(0), "the two spellings agree on the value arm");
}
