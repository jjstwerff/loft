// @PLN85 / D-own-1 text corpus t4 cell, graduated: a `-> text?` function with a
// PROMOTED work-buffer (a formatted local in the return deps) and an early
// `return null` produced UB on native — the null-path ret-temp typed
// `optional(text)`, missing pre_eval's B5-L3 collapse gate (`Type::Text` only),
// so the local `String` temp survived to `return Str::new(&local)` and the
// caller memcpy'd a dangling/null pointer (ptr::copy_nonoverlapping abort).
// Interp was correct; the fix is the `.base()` peel on the collapse gate.

fn f(n: integer) -> text? {
  if n < 0 { return null; }
  s = "v";
  s += "{n}";
  s
}

// The buffer-less twin was always fine — pinned as the contrast.
fn g(n: integer) -> text? {
  if n < 0 { return null; }
  "plain"
}

fn main() {
  assert((f(5) ?? "MISS") == "v5", "value path: {f(5) ?? \"MISS\"}");
  assert(f(-1) == null, "buffered null path must be NULL (dangling-Str UB before the fix)");
  assert(g(-1) == null, "plain null path");
  // Repeat the null path — a stale/reused buffer would surface on call 2.
  assert(f(-2) == null, "buffered null path, second call");
  assert((f(9) ?? "MISS") == "v9", "value after nulls: {f(9) ?? \"MISS\"}");
  println("text-optional-null-return ok");
}
