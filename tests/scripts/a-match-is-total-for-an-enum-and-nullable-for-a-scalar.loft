//
// When a `match` must cover its subject, and what it answers when it does not.
//
// The Match chapter used to say, under the wildcard section, that "without it, the compiler
// will reject the match if any value could fall through without matching". That is true of an
// ENUM subject and false of every scalar one, and the false half is the dangerous direction: a
// reader who trusts it omits the `_` on an integer match and gets a null travelling through
// their program instead of the compile error they were promised.
//
// `formal/matching.md` (M-Total) draws the line by DECIDABILITY, not by taste: an enum has a
// finite known variant set so coverage is checked, and a scalar has an unbounded domain so it
// is not required — an unmatched scalar yields null under the C80 model, which is the one place
// a `match` falls through, and it falls through to null rather than to a fault.
//
// The chapter now carries both halves with one cell each. This is where the rest lives: the
// same question asked of every subject kind, and of the guard rule that decides what "covered"
// even means.
//
// @falsified-at: none — this guard states where a boundary IS, and the behaviour has been in
//   this place for as long as the corpus records; there is no build on which it fails, which
//   makes it a LOCK rather than a regression test. Checked by hand in both directions: every
//   assert below was inverted one at a time and each one failed, naming its own row. The
//   REFUSALS it describes are not asserted here — a multi-cell `@EXPECT_ERROR` file credits
//   every declaration after the first firing one (loft#1261) — they live as Rust cells in
//   `tests/issues.rs` (`inc26_*`, `an_arm_after_a_total_wildcard_*`), which match the message
//   and its position.

enum Direction {
  North,
  South,
  East,
  West,
}

enum Shape {
  Circle { radius: integer },
  Rect { w: integer, h: integer },
}

fn size_of(s: Shape) -> text {
  match s {
    Circle { radius } if radius > 10 => "big circle",
    Circle { radius } => "small circle",
    Rect { w, h } if w == h => "square",
    Rect { w, h } => "rect",
  }
}

// --- The scalar half: no coverage requirement, and null when nothing is selected -----------

fn an_unmatched_integer_answers_null() {
  r = match 7 {
    1 => "one",
    2 => "two",
  };
  assert(r == null, "no arm selected, so the match is null");
  assert((r ?? "none") == "none", "and `??` is what rescues it: {r ?? "none"}");
}

fn an_unmatched_text_answers_null() {
  r = match "zz" {
    "a" => 1,
    "b" => 2,
  };
  assert(r == null, "a text subject falls through the same way");
  assert((r ?? -1) == -1, "with the same rescue: {r ?? -1}");
}

fn an_unmatched_character_answers_null() {
  r = match 'q' {
    'a' => 1,
    'b' => 2,
  };
  assert(r == null, "a character subject falls through the same way");
}

fn a_scalar_match_that_does_select_an_arm_is_not_null() {
  // The control for the three rows above: the null is about SELECTION, not about the missing
  // wildcard, so the same wildcard-less match answers normally when an arm does match.
  r = match 2 {
    1 => "one",
    2 => "two",
  };
  assert(r == "two", "an arm matched, so there is no null: {r}");
}

// --- What "covered" means: a guard never counts ---------------------------------------------

fn a_guard_reads_the_bindings_its_own_pattern_made() {
  assert(size_of(Circle { radius: 20 }) == "big circle", "guard true: {size_of(Circle { radius: 20 })}");
  assert(size_of(Circle { radius: 2 }) == "small circle", "guard false falls to the next arm");
  assert(size_of(Rect { w: 3, h: 3 }) == "square", "a guard comparing two bindings");
  assert(size_of(Rect { w: 3, h: 4 }) == "rect", "and its false case");
}

fn a_guarded_arm_is_tried_in_order_and_falls_through_when_it_rejects() {
  // Three guards on the same wildcard, in order. Only the third can accept, which is what
  // "a guard can reject" means at run time — the static half (a guarded arm never secures
  // totality) is the refusal in tests/issues.rs.
  v = 42;
  label = match v {
    _ if v < 0 => "negative",
    _ if v > 100 => "large",
    _ if v == 42 => "the answer",
    _ => "normal",
  };
  assert(label == "the answer", "the first accepting guard wins: {label}");
}

// --- Enum coverage, positively --------------------------------------------------------------

fn every_variant_named_needs_no_wildcard() {
  d = Direction.West;
  axis = match d {
    North => "n",
    South => "s",
    East => "e",
    West => "w",
  };
  assert(axis == "w", "all four variants named: {axis}");
}

fn a_wildcard_covers_the_variants_left_out() {
  d = Direction.East;
  axis = match d {
    North => "vertical",
    South => "vertical",
    _ => "horizontal",
  };
  assert(axis == "horizontal", "the wildcard takes East: {axis}");
}

// --- Patterns the chapter shows once, swept ---------------------------------------------------

fn grade(n: integer) -> text {
  match n {
    90..=100 => "A",
    80..=89 => "B",
    _ => "lower",
  }
}

fn range_patterns_cover_their_bounds_and_leave_the_rest() {
  assert(grade(90) == "A", "the low bound is inside: {grade(90)}");
  assert(grade(100) == "A", "and so is the high one: {grade(100)}");
  assert(grade(89) == "B", "one below falls to the next band: {grade(89)}");
  assert(grade(79) == "lower", "and below both bands: {grade(79)}");
}

fn axis_of(d: Direction) -> text {
  match d {
    North | South => "vertical",
    East | West => "horizontal",
  }
}

fn alternation_shares_one_arm_across_patterns() {
  assert(axis_of(North) == "vertical", "first of an alternation: {axis_of(North)}");
  assert(axis_of(South) == "vertical", "second of an alternation: {axis_of(South)}");
  assert(axis_of(West) == "horizontal", "and the other arm: {axis_of(West)}");
}

fn pick(t: (integer, text)) -> text {
  match t {
    (0, _) => "zero-any",
    (2, "a") => "two-a",
    (2, "b") => "two-b",
    _ => "other",
  }
}

fn a_tuple_subject_matches_element_by_element() {
  assert(pick((0, "z")) == "zero-any", "`_` stands in for one element: {pick((0, "z"))}");
  assert(pick((2, "a")) == "two-a", "both elements decide: {pick((2, "a"))}");
  assert(pick((2, "b")) == "two-b", "and the sibling arm: {pick((2, "b"))}");
  assert(pick((3, "a")) == "other", "no arm fits, so the wildcard takes it: {pick((3, "a"))}");
}

fn read_maybe(m: integer?) -> text {
  match m {
    null => "absent",
    0 => "zero",
    _ => "present",
  }
}

fn a_null_arm_takes_the_absent_case_of_a_nullable_subject() {
  absent: integer? = null;
  present: integer? = 5;
  assert(read_maybe(absent) == "absent", "the null arm: {read_maybe(absent)}");
  assert(read_maybe(present) == "present", "and a value goes elsewhere: {read_maybe(present)}");
}
