// @P346 regression: a string-interpolation used as an `if`-branch result, over a
// vector-indexed value, inside a loop, must NOT accumulate text across iterations.
// The interpolation's work-buffer is promoted to the fn's `&text` return slot;
// the per-iteration reset `Set(refvar, "")` was a no-op on the interpreter
// (set_var early-returned), so OpFormatStack* appended to a stale buffer
// ([2.5][2.58][2.581] instead of [2.5][8][1]).  Now `Set(refvar_text, "")`
// emits OpClearStackText.  Interpreter + native must agree.
fn build(vs: vector<float>) -> text {
  out = "";
  for bi in 0..len(vs) {
    x = vs[bi];
    xj = if true { "{x}" } else { "null" };
    out += "[{xj}]";
  }
  out
}

// Also exercise an integer interpolation + a non-trivial else branch.
fn labels(ns: vector<integer>) -> text {
  out = "";
  for li in 0..len(ns) {
    n = ns[li];
    tag = if n > 0 { "{n}" } else { "zero" };
    out += "({tag})";
  }
  out
}

fn main() {
  assert(build([2.5, 8.0, 1.0]) == "[2.5][8][1]", "float: {build([2.5, 8.0, 1.0])}");
  assert(labels([3, 0, 7]) == "(3)(zero)(7)", "int: {labels([3, 0, 7])}");
  print("ok");
}
