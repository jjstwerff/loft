// @P323 regression — `text ?? <text>` where the LHS is a TEMPORARY (e.g.
// `v[i] ?? "x"` on a vector<text>) failed --native compile with E0597: the
// `??` (#ncc) value-block yielded `_ret = &var__ncc` (a borrow of the
// block-local String), and the consumer's `.to_string()` ran after the local
// dropped.  Fix: a text value-block now materialises its `_ret` to an OWNED
// String inside the block.
struct P323H { items: vector<text> }

fn test_p323_index_coalesce() {
  h = P323H { items: [] };
  h.items += ["present"];
  // LHS is a temporary (the index read) — the shape that broke native compile.
  a = h.items[0] ?? "fallback";
  assert(a == "present", "p323: a={a} (want present)");
  // null element → coalesce to the fallback.
  h.items += [null];
  b = h.items[1] ?? "fallback";
  assert(b == "fallback", "p323: b={b} (want fallback)");
}
