//
// `now()` is milliseconds and `ticks()` is microseconds, measured against each other.
//
// The Time chapter's whole content is two units and two origins, and every arithmetic
// example a reader copies — `now() / 1000` for seconds, `(ticks() - start) / 1000` for
// milliseconds — is wrong by a factor of a thousand if either is misnamed. Nothing checked
// them: the chapter asserted `now() > 0` and `ticks() >= 0`, which a clock in ANY unit
// with ANY origin satisfies, and `t2 >= t`, which is true of a counter that never moves.
//
// The two clocks are each other's oracle, which is what makes this checkable without a
// second time source. Run the same work between two readings of each:
//
//   * if `now` is milliseconds and `ticks` is microseconds, the tick delta is ~1000x the
//     millisecond delta.  Any other pairing — both ms, both us, ns anywhere — lands orders
//     of magnitude away, so the band below is deliberately wide (a factor of two either
//     side) rather than tight: it is separating 1000 from 1 and from 1000000, not
//     measuring the machine.
//   * the ORIGINS are what the ratio cannot see, so they are asserted apart: `now` is past
//     the 32-bit line because it counts from 1970, and `ticks` is NOT, because it counts
//     from a few milliseconds ago.  A `ticks` that secretly returned epoch microseconds
//     would keep the ratio and fail that.
//
// @falsified-at: none — a LOCK.  Both clocks have always been what the stdlib comments say;
//   what this catches is a future change of unit or origin, which is a build that does not
//   exist yet.
//
//   Checked by hand instead, in the direction that matters: with the ratio bounds moved to
//   demand 1x and to demand 1000000x the file fails, so the band is being compared and not
//   merely written down; with the `ticks` origin bound inverted it fails; and with the burn
//   replaced by nothing — so both deltas collapse toward zero — it fails, which is the
//   control that the ratio is measured over real elapsed time rather than over two
//   identical readings.

// Burn until the WALL CLOCK has moved a set number of milliseconds, rather than for a set
// number of iterations.  A fixed count is a bet on machine speed: the same loop that gave
// the interpreter 95 ms gave `--native` 7, where one millisecond of rounding is a seventh
// of the measurement.  Waiting on the clock itself costs the fast backend no more than it
// needs and keeps the slow one from paying for the fast one's floor.
fn ck_burn_until(ck_from: integer, ck_ms: integer) -> integer {
  ck_s = 0;
  ck_i = 0;
  while now() - ck_from < ck_ms {
    ck_s += ck_i % 3;
    ck_i += 1;
  }
  ck_s
}

fn the_two_clocks_agree_on_a_factor_of_a_thousand() {
  ck_n0 = now();
  ck_t0 = ticks();
  ck_guard = ck_burn_until(ck_n0, 30);
  ck_n1 = now();
  ck_t1 = ticks();
  assert(ck_guard >= 0, "the work loop ran: {ck_guard}");

  ck_ms = ck_n1 - ck_n0;
  ck_us = ck_t1 - ck_t0;
  assert(ck_ms > 0, "the wall clock moved during the work: {ck_ms} ms");
  assert(ck_us > 0, "the monotonic clock moved during the work: {ck_us} us");
  // us / ms must land near 1000.  Half and double, so a slow or loaded machine is fine and
  // a wrong UNIT is not.
  assert(ck_us > ck_ms * 500,
         "ticks is not microseconds against now's milliseconds: {ck_us} us vs {ck_ms} ms");
  assert(ck_us < ck_ms * 2000,
         "ticks is coarser than microseconds against now: {ck_us} us vs {ck_ms} ms");
}

// The origins, which the ratio cannot see.
fn the_clocks_start_where_the_chapter_says() {
  // 1970, so past the 32-bit line since 1970 plus a few weeks.
  ck_n = now();
  assert(ck_n > 2147483647, "now() is not an epoch millisecond stamp: {ck_n}");
  // Program start, so a few milliseconds of microseconds — nowhere near the epoch.
  ck_t = ticks();
  assert(ck_t >= 0, "ticks() is negative: {ck_t}");
  assert(ck_t < 2147483647,
         "ticks() is not measured from program start: {ck_t}");
}

// Monotonic means never backwards, and it is the one guarantee `now()` does not carry.
fn ticks_never_goes_backwards() {
  ck_prev = ticks();
  ck_back = 0;
  for ck_i in 0..40000 {
    ck_now = ticks();
    if ck_now < ck_prev { ck_back += 1; }
    ck_prev = ck_now;
  }
  assert(ck_back == 0, "ticks() stepped backwards {ck_back} time(s)");
}
