// Reading `v[i]` out of a `vector<(…)>` PARAMETER must not free the caller's store.
//
// The read unboxes the element through a work-ref cursor that holds a DbRef pointing
// INTO the vector's store. The scope-exit sweep frees a `__ref_N` on its name rather
// than on its deps, so that cursor was released at return — destroying a store the
// caller still owned. One call looked fine; the SECOND call appended through a handle
// whose slot had been recycled, and the interpreter's `vector_append` guard fired
// ("field 1.8 lies outside its own record, which claims -99 words"). `--native` and
// `LOFT_NO_SLOT_REUSE=1` both hid it, which is why it read as a slot-reuse fault
// rather than an over-free (loft#857).
//
// The cells vary one axis each: element arity, element type, where the vector lives,
// whether the read feeds the append, and how many times the callee runs. The struct
// cells are the CONTROLS — a struct element read carries a dep on the vector, so it
// was never freed, and it must stay that way.
//
// The cursor now says BORROW in its type rather than only being exempted from the free,
// which is the same fact loft#858 was measuring from the other side: an OWNING
// `Reference` local must hold its own store, so the cursor's assignment lowered to
// `OpDatabase` + `OpCopyRecord` and every `v[i]` allocated a store, deep-copied the
// element into it and freed the previous one — ~13× a `vector<struct>` read, and barely
// sensitive to arity because the allocate/free dominated the element loads. Naming the
// vector in the deps makes it a pointer bind, as the struct path always was.
//
// A borrow is only sound while what it points at holds still, so the last cells mutate
// the vector in the same statement that reads it: the unbox materialises every element
// onto the stack before the append can move the store, and these pin that ordering.

struct V2 { x: float, y: float }

fn append_read(v: vector<(float, float)>) {
  a = v[0] ?? (0.0, 0.0);      // cursor into v's store
  v += [a];                    // the append the freed slot corrupted
}

fn append_dead_read(v: vector<(integer, integer)>) {
  a = v[0] ?? (0, 0);          // read is DEAD — the fault is the read, not the dataflow
  assert(a.0 == 1, "the dead read still reads the right element");
  v += [(7, 8)];
}

fn append_struct(v: vector<V2>) {
  a = v[0] ?? V2 { x: 0.0, y: 0.0 };
  v += [a];
}

fn total(v: vector<(integer, integer)>) -> integer {
  t = 0;
  for i in 0..len(v) {
    a = v[i] ?? (0, 0);        // the cursor is REWRITTEN each iteration
    t += a.0 + a.1;
  }
  t
}

fn peek(v: vector<(integer, integer)>) -> integer {
  a = v[0] ?? (0, 0);          // read only — the callee never appends
  a.0
}

fn get(v: vector<(integer, integer)>, i: integer) -> (integer, integer) {
  v[i] ?? (0, 0)               // the read IS the return value
}

fn main() {
  // Two calls are the minimum: the first frees the store, the second appends into
  // whatever was recycled into the slot.
  a: vector<(float, float)> = [(1.0, 2.0)];
  append_read(a);
  append_read(a);
  assert(len(a) == 3, "two appends through a tuple param: len {len(a)}");
  assert((a[2] ?? (0.0, 0.0)).1 == 2.0, "the second append copied element 0's bytes");

  // A dead read is enough — the cursor exists whether or not its value is used.
  b: vector<(integer, integer)> = [(1, 2)];
  append_dead_read(b);
  append_dead_read(b);
  assert(len(b) == 3, "dead read, two appends: len {len(b)}");
  assert((b[2] ?? (0, 0)).0 == 7, "the appended literal, not recycled bytes");

  // The element type is not what matters — an integer pair faults the same way.
  c: vector<(integer, integer)> = [(3, 4), (5, 6)];
  assert(total(c) == 18, "a loop of reads: {total(c)}");
  assert(total(c) == 18, "and again, on a vector the first call must not have freed");
  assert(len(c) == 2, "a read-only callee leaves the vector alone: len {len(c)}");

  // Many calls, no append at all: the store must survive every one of them.
  d: vector<(integer, integer)> = [(7, 8)];
  t = 0;
  for _ in 0..50 { t += peek(d); }
  assert(t == 350, "50 read-only calls: {t}");
  assert(len(d) == 1, "and the vector is untouched: len {len(d)}");

  // The read as the RETURN value — the cursor's contents outlive the frame.
  e: vector<(integer, integer)> = [(1, 2), (3, 4)];
  g0 = get(e, 0);
  g1 = get(e, 1);
  g2 = get(e, 0);
  assert(g0.0 == 1 && g0.1 == 2, "returned read 0: ({g0.0}, {g0.1})");
  assert(g1.0 == 3 && g1.1 == 4, "returned read 1: ({g1.0}, {g1.1})");
  assert(g2.0 == 1 && g2.1 == 2, "re-reading 0 after 1: ({g2.0}, {g2.1})");

  // A heap-carrying element (text), so the cursor is skipped for a tuple whose
  // fields are NOT all inline — if the skip leaked, the leak gate says so.
  f: vector<(text, integer)> = [("hi", 1)];
  i = 0;
  while i < 3 {
    h = f[0] ?? ("", 0);
    f += [(h.0 + "!", h.1 + 1)];
    i += 1;
  }
  assert(len(f) == 4, "three appends of a text tuple: len {len(f)}");
  assert((f[3] ?? ("", 0)).0 == "hi!", "the text element survived: {(f[3] ?? ("", 0)).0}");

  // The read and the mutation in ONE statement. Appending can move the vector's store,
  // so a cursor still pointing into it would read the old bytes — the unbox has to have
  // finished before the append starts.
  g: vector<(integer, integer)> = [(1, 2)];
  g += [g[0] ?? (0, 0)];
  g += [g[1] ?? (0, 0)];
  assert(len(g) == 3, "read-and-append in one statement: len {len(g)}");
  assert((g[2] ?? (0, 0)).0 == 1 && (g[2] ?? (0, 0)).1 == 2, "and it copied element 0's values");

  // Enough appends to force the vector to outgrow its initial claim and be re-placed,
  // with every element read back afterwards — a cursor left pointing at the old
  // allocation shows up here as wrong values rather than as a crash.
  chain: vector<(integer, integer)> = [(0, 0)];
  k = 1;
  while k < 40 {
    prev = chain[k - 1] ?? (0, 0);
    chain += [(prev.0 + 1, prev.1 + 2)];
    k += 1;
  }
  assert(len(chain) == 40, "40 grow-and-read rounds: len {len(chain)}");
  last = chain[39] ?? (0, 0);
  assert(last.0 == 39 && last.1 == 78, "the chain survived every regrow: ({last.0}, {last.1})");
  mid = chain[20] ?? (0, 0);
  assert(mid.0 == 20 && mid.1 == 40, "and so did an element in the middle: ({mid.0}, {mid.1})");

  // CONTROL — the struct element read, which always carried a dep on the vector and
  // was never freed. A fix that widened the cursor rule would show up here.
  s: vector<V2> = [V2 { x: 1.0, y: 2.0 }];
  append_struct(s);
  append_struct(s);
  assert(len(s) == 3, "struct control: len {len(s)}");
  assert((s[2] ?? V2 { x: 0.0, y: 0.0 }).y == 2.0, "struct control values");
}
