// Probe 45 — Cluster I shape border: `??` inside a closure body
//
// Closures (lambdas) compile to a per-closure synthetic function with
// captured state.  When the closure body contains a `??` ncc-block, the
// same scope-exit free machinery should apply within the closure's local
// scope.  But closures have their own variable-table + frame-management
// path.  Test whether cluster I extends.
//
// Pairing: diff against 02 — same logic, different containing scope.
// Status: cluster I shape-border probe; tests closure code path.

struct H { items: vector<text> }

fn main() {
  h = H { items: [] };
  h.items += ["present"];
  // Capture h via a closure that takes idx + returns the coalesce result.
  pick = fn(idx: integer) -> text {
    h.items[idx] ?? "fallback"
  };
  a = pick(0);
  assert(a == "present", "probe 45: got '{a}', want 'present'");
  println("probe 45 PASSED");
}
