//
// A declared local may name a tuple with a nullable element (loft#1034).
//
// `c: (text?, integer) = ("c0", 3)` was refused — "cannot change type from (text?,
// integer) to (text, integer)" — while the IDENTICAL type was accepted as a RETURN.  Two
// positions disagreeing about one type is the shape `formal/tuples.md` D-tup-1 collapsed
// once already, and the cause was the same: the composition of two specified halves was
// not itself specified.  @PLN25 `(N-Decl)` says storing a non-null `τ` into a `τ?` slot is
// not a type change; it peeled ONE `Optional`, at the top, so it never saw a `τ?` sitting
// at a tuple POSITION.
//
// Two halves, and neither subsumes the other:
//   * the TYPING half — `decl_accepts` asks `(N-Decl)` element-wise, so the declaration is
//     legal.  It answers on pass 1, before any lowering.
//   * the LOWERING half — a tuple target now reaches `convert`, whose Tuple arm walks the
//     elements.  `scalar_target` had listed the types whose annotation drives a conversion
//     and a tuple was not among them, so the literal was never converted against what the
//     annotation asked for.
//
// The second is why the `null` ELEMENT cell below is load-bearing rather than decorative:
// with only the typing half the declaration compiles and then stores the empty text
// (`h.0 == null` answers FALSE), and `--native` does not compile at all because the
// element emits `()`.  A test that only checked non-null elements would pass on a fix that
// makes the language silently wrong.

fn mk1034() -> (text?, integer) { ("m0", 9) }
fn mk1034_null() -> (text?, integer) { (null, 3) }

fn test_a_declared_tuple_admits_a_non_null_element_where_it_declares_nullable() {
  c: (text?, integer) = ("c0", 3);
  assert((c.0 ?? "N") == "c0", "text? element holds its text, got {c.0 ?? "N"}");
  assert(c.1 == 3, "and the plain element, got {c.1}");

  // The scalar spelling of the same widening, and in the FIRST position rather than
  // trailing, so a fix keyed on position fails here.
  d: (integer?, text) = (5, "x");
  assert((d.0 ?? -1) == 5, "integer? element holds its integer, got {d.0 ?? -1}");
  assert(d.1 == "x", "and the plain element, got {d.1}");

  // Every element nullable.
  e: (text?, integer?) = ("a", 1);
  assert((e.0 ?? "N") == "a", "both-nullable text, got {e.0 ?? "N"}");
  assert((e.1 ?? -1) == 1, "both-nullable integer, got {e.1 ?? -1}");
}

fn test_a_null_element_is_the_element_types_null() {
  // The lowering half.  Before the fix this stored the empty text and `== null` answered
  // false, and `--native` refused the program.
  f: (text?, integer) = (null, 3);
  // Bound once rather than read twice: a `text?` tuple element that is null-tested and
  // then read again does not compile on `--native` (loft#1038), which is a separate
  // pre-existing defect — it reproduces from a tuple RETURN, a position this issue never
  // touched.  Binding is that issue's verified workaround, so this cell tests loft#1034
  // and not loft#1038.
  ft = f.0;
  assert(ft == null, "a null element IS null");
  assert((ft ?? "N") == "N", "so `??` reaches the fallback, got {ft ?? "N"}");
  assert(f.1 == 3, "and the plain element is unharmed, got {f.1}");

  // The integer twin needs no such care — loft#1038 is the `String` move, not the
  // nullable model — so this cell reads the element directly, on purpose.
  g: (integer?, text) = (null, "z");
  assert(g.0 == null, "a null integer element IS null");
  assert((g.0 ?? -1) == -1, "so `??` reaches the fallback, got {g.0 ?? -1}");
}

fn test_the_return_position_still_agrees() {
  // The position that always worked — carried so the two can never drift apart again,
  // which is the whole content of the bug.
  h = mk1034();
  assert((h.0 ?? "N") == "m0", "returned tuple, got {h.0 ?? "N"}");
  assert(h.1 == 9, "returned plain element, got {h.1}");

  k = mk1034_null();
  kt = k.0;                       // bound once — loft#1038, as above
  assert(kt == null, "returned null element IS null");
  assert(k.1 == 3, "returned plain element beside a null, got {k.1}");
}

fn test_reassignment_and_the_plain_tuple_are_unchanged() {
  c: (text?, integer) = ("a", 1);
  c = ("b", 2);
  assert((c.0 ?? "N") == "b", "reassignment keeps the declared type, got {c.0 ?? "N"}");
  assert(c.1 == 2, "reassigned plain element, got {c.1}");

  // The control: a tuple with no nullable element at all must be untouched.
  p: (text, integer) = ("g", 7);
  assert(p.0 == "g", "plain declared tuple, got {p.0}");
  assert(p.1 == 7, "plain declared tuple element, got {p.1}");
}
