// @P354 regression: two-or-more SIBLING call arguments that each produce a
// scratch-backed text (`JsonValue.as_text()`, `.to_json()`, `.kind()`, …) must
// NOT alias each other.  The interpreter's `n_as_text` (and 8 sibling natives)
// called `stores.scratch.clear()` before pushing their result, freeing the
// heap buffers that earlier sibling args' live `Str` views still pointed at —
// so the freed buffers got reused by the next push and every sibling arg
// collapsed to the LAST value (`[cc][cc][cc]` instead of `[aa][bb][cc]`).
// `--native` was already correct.  Fix: text-returning natives push + return
// `scratch.last()` (the canonical pattern, matching `to_lowercase`), never
// clearing; `OpClearScratch` reclaims the buffer at the next line boundary.

fn tag_str(o: JsonValue, k: text) -> text {
  return o.field(k).as_text().to_lowercase();
}

fn three(a: text, b: text, c: text) -> text {
  return "[{a}][{b}][{c}]";
}

fn main() {
  o = json_parse("{{\"x\":\"AA\",\"y\":\"BB\",\"z\":\"CC\"}}");

  // (1) the reported shape: same fn, as_text().to_lowercase() sibling args
  lowered = three(tag_str(o, "x"), tag_str(o, "y"), tag_str(o, "z"));
  print("{lowered}\n");
  assert(lowered == "[aa][bb][cc]", "as_text().to_lowercase() siblings must not alias");

  // (2) bare as_text() sibling args (no .to_lowercase())
  bare = three(o.field("x").as_text(), o.field("y").as_text(), o.field("z").as_text());
  print("{bare}\n");
  assert(bare == "[AA][BB][CC]", "bare as_text() siblings must not alias");

  // (3) to_json() sibling args
  js = three(o.field("x").to_json(), o.field("y").to_json(), o.field("z").to_json());
  print("{js}\n");
  assert(js == "[\"AA\"][\"BB\"][\"CC\"]", "to_json() siblings must not alias");
}
