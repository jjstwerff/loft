// Storing an EXISTING tuple value into a `vector<(…)>` element slot.
//
// A `vector<(…)>` element slot is typed `Reference(__tuple<…>)` — the STORED
// spelling of a tuple — while the value being written is a stack tuple. The write
// took the generic reference arm and emitted `OpCopyRecord`, which read the tuple's
// own bytes as a `DbRef`: SIGSEGV on the interpreter, `E0308: expected DbRef, found
// (f64, f64, f64)` on `--native` (loft#821).
//
// A tuple LITERAL never showed it. `v += [(1.0, 2.0, 3.0)]` is typed `Type::Tuple`
// and already took the per-element arm, so the whole shape looked supported until
// the tuple came from anywhere else — a call, a local, or a read of another vector.
// That asymmetry is what these cells pin: the literal cells are the controls, and
// they must keep passing, because a fix that routed everything through the
// per-element path would break the promoted-source case (PLAN51 V-b) instead.

fn mk(x: float) -> (float, float, float) { (x, x + 1.0, x + 2.0) }
fn sum3(v: (float, float, float)) -> float { v.0 + v.1 + v.2 }

fn main() {
  // The three sources that all reached OpCopyRecord.
  a: vector<(float, float, float)> = [];
  a += [mk(1.0)];                       // straight from a call
  assert(len(a) == 1, "append a call result: len {len(a)}");
  assert(sum3(a[0] ?? (0.0, 0.0, 0.0)) == 6.0, "the appended values must survive");

  b: vector<(float, float, float)> = [];
  t = mk(1.0);
  b += [t];                             // through a local
  assert(len(b) == 1, "append a local: len {len(b)}");
  assert((b[0] ?? (0.0, 0.0, 0.0)).2 == 3.0, "element 2 of the appended tuple");

  c: vector<(float, float, float)> = [];
  lit = (4.0, 5.0, 6.0);
  c += [lit];                           // a local holding a LITERAL — still a value
  assert((c[0] ?? (0.0, 0.0, 0.0)).0 == 4.0, "a literal bound to a local");

  // Read one vector's element and push it into another — the shape a real consumer
  // hits first, and the one that proves the read and write paths agree.
  src: vector<(float, float, float)> = [(7.0, 8.0, 9.0)];
  dst: vector<(float, float, float)> = [];
  q = src[0] ?? (0.0, 0.0, 0.0);
  dst += [q];
  assert(sum3(dst[0] ?? (0.0, 0.0, 0.0)) == 24.0, "copy between vectors");

  // Appending onto a NON-empty vector, so the slot is not the first one.
  d: vector<(float, float, float)> = [(1.0, 1.0, 1.0)];
  d += [mk(2.0)];
  assert(len(d) == 2, "append onto a non-empty vector: len {len(d)}");
  assert((d[1] ?? (0.0, 0.0, 0.0)).1 == 3.0, "the SECOND element's own bytes");

  // CONTROLS — the literal forms that always worked. A fix that changed which arm a
  // literal takes would show up here rather than in the cells above.
  e: vector<(float, float, float)> = [];
  e += [(1.0, 2.0, 3.0)];
  e += [(4.0, 5.0, 6.0), (7.0, 8.0, 9.0)];
  assert(len(e) == 3, "literal appends: len {len(e)}");
  assert(sum3(e[2] ?? (0.0, 0.0, 0.0)) == 24.0, "the last literal's values");

  // A pair, so the fix is not specific to arity 3.
  p: vector<(integer, integer)> = [];
  pr = (4, 5);
  p += [pr];
  assert((p[0] ?? (0, 0)).1 == 5, "an arity-2 tuple through a local");
}
