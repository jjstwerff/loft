// Regression — @PLN90 path A / @PLN85 P4. A `match` arm that yields a borrowed enum-field
// view directly (`Filled { items } => { items }`) used to derail the interpreter: the empty
// `_ => { [] }` arm pushed NO result, so gen_if's B5 arm-join took the join target at the
// eval base and slid the true-arm's 16-byte result DOWN onto the saved return address —
// `fn_return` then read a garbage `code_pos` and execution ran into the weeds. (`--native`
// was unaffected; it returns on the Rust call stack.)
//
// Fix: an empty/elided value-arm now delivers a typed result on its path, so both arms of a
// value `if` exit ABOVE the frame at the same level and the join never shrinks a result into
// the return address. Same family as @PLN90 441 (B5 discard) and 442 (empty value-block).
//
// The subject (`cell`) is a NAMED local that out-lives the result, so the borrowed return is
// sound; the churn loop makes a stale return-address fatal pre-fix.
struct E {
  hp: integer,
  name: text,
}
enum Cell {
  Empty,
  Filled { items: vector<E> },
}

fn g(e: Cell) -> vector<E> {
  match e {
    Filled { items } => { items }, _ => { [] }
  }
}

fn main() {
  inner: vector<E> = [];
  for k in 0..3 { inner += [E { hp: k, name: "e" }]; }
  cell = Filled { items: inner };

  for i in 0..12 {
    r = g(cell);
    assert(len(r) == 3, "filled i{i}: len={len(r)}");
    assert(r[0].hp == 0 && r[2].hp == 2, "filled i{i}: values wrong");

    // the empty `_ => { [] }` arm (the one that used to push no result)
    e = g(Empty {});
    assert(len(e) == 0, "empty i{i}: len={len(e)}");

    j: vector<E> = [];
    for q in 0..12 { j += [E { hp: q, name: "x" }]; }
  }
  println("ok");
}
