//
// A heap-building right-hand side ADOPTS the assignment's destination variable as its
// build accumulator (#501's watermark reuse; `parse_append_vector`'s `orig_var`). A
// parenthesised expression IS that whole value, so adopting is right there — but a tuple
// MEMBER is not, and member 0 is the one parsed before the `,` can say which of the two
// this is.
//
// Adopting it typed the destination as the MEMBER and then refused the retype it had just
// caused: `t = ([10, 20], 9)` reported *"Variable 't' cannot change type from
// vector<integer> to (vector<integer>, integer); use a new variable name or cast with
// 'as'"* — a legal program refused, with a message naming a cure that cannot work. The
// declared spelling reported the same collision with the two types swapped.
//
// Only an ASSIGNMENT reaches it. Value position (`return (…)`) and argument position
// (`f((…))`) have no destination to adopt and were always correct, and a member at
// position 1 or later is parsed after `val` has stopped being the destination var — so
// the three of them are the controls that say what the accumulator rule should have been
// all along.

struct Tm { n: integer }

fn tm_take(t: (vector<integer>, integer)) -> integer { t.0[0] }

fn tm_hole(a: integer, b: text) -> integer { a + len(b) }

// m1 — the defect: a vector LITERAL as member 0 of an inferred tuple.
fn tm_literal() -> integer {
  t = ([10, 20], 9);
  t.0[1]
}

// m2 — a comprehension member builds through the same accumulator.
fn tm_comprehension() -> integer {
  t = ([for i in 0..3 { i + 10 }], 9);
  t.0[2]
}

// m3 — the DECLARED spelling: the destination already carries the tuple type, so the
//      adoption collided the other way round.
fn tm_declared() -> integer {
  t: (vector<integer>, integer) = ([10, 20], 9);
  t.0[1]
}

// m4 — two collection members, so member 0's adoption cannot be excused as "the only one".
fn tm_two_collections() -> integer {
  t = ([10, 20], [30, 40]);
  t.0[1] * 100 + t.1[0]
}

// m5 — a nested tuple whose inner member 0 is a literal.
fn tm_nested() -> integer {
  t = (([10, 20], 1), 9);
  t.0.0[1]
}

// m6 — CONTROL: member 1 was always parsed after the destination stopped being live.
fn tm_second() -> integer {
  t = (9, [10, 20]);
  t.1[1]
}

// m7 — CONTROL: value position has no destination variable at all.
fn tm_value() -> (vector<integer>, integer) {
  ([10, 20], 9)
}

// m8 — CONTROL: argument position, likewise.
fn tm_argument() -> integer {
  tm_take(([10, 20], 9))
}

// m9 — CONTROL: a text member, whose build does not adopt the destination.
fn tm_text() -> integer {
  t = ("hello", 9);
  len(t.0)
}

// m10 — CONTROL: a struct literal member, which builds into its own record.
fn tm_struct() -> integer {
  t = (Tm { n: 5 }, 9);
  t.0.n
}

// m11 — CONTROL: a parenthesised vector literal is NOT a tuple, and still lands.
fn tm_paren() -> integer {
  v = ([10, 20]);
  v[1]
}

// m12 — CONTROL: a string with an interpolation HOLE inside the group. The lookahead stops
//       before a string rather than crossing one, because a revert does not restore the
//       scanner's hole state — crossing one left the enclosing group unable to close.
fn tm_interpolated() -> integer {
  y = 3;
  s = 0;
  s = (s + tm_hole(1, "{y}")) % 7;
  s
}

// m13 — CONTROL: the same hole as a tuple MEMBER, which the stop-before-a-string rule
//       answers "not a tuple" for. A text member never adopted the destination, so the
//       answer given up costs nothing and the value still lands.
fn tm_text_hole() -> integer {
  y = 3;
  t = ("v{y}", 9);
  len(t.0) * 10 + t.1
}

fn main() {
  assert(tm_literal() == 20, "m1 = {tm_literal()}, want 20");
  assert(tm_comprehension() == 12, "m2 = {tm_comprehension()}, want 12");
  assert(tm_declared() == 20, "m3 = {tm_declared()}, want 20");
  assert(tm_two_collections() == 2030, "m4 = {tm_two_collections()}, want 2030");
  assert(tm_nested() == 20, "m5 = {tm_nested()}, want 20");
  assert(tm_second() == 20, "m6 = {tm_second()}, want 20");

  v7 = tm_value();
  assert(v7.0[1] == 20, "m7 = {v7.0[1]}, want 20");
  assert(v7.1 == 9, "m7 scalar = {v7.1}, want 9");

  assert(tm_argument() == 10, "m8 = {tm_argument()}, want 10");
  assert(tm_text() == 5, "m9 = {tm_text()}, want 5");
  assert(tm_struct() == 5, "m10 = {tm_struct()}, want 5");
  assert(tm_paren() == 20, "m11 = {tm_paren()}, want 20");
  assert(tm_interpolated() == 2, "m12 = {tm_interpolated()}, want 2");
  assert(tm_text_hole() == 29, "m13 = {tm_text_hole()}, want 29");
}
