// Several MATERIALISED par loops (range / text inputs) in one function with
// DIFFERENT element types must not corrupt each other (#282).  The materialise
// temp vars are keyed on the loop number (two-pass-stable), so two loops'
// `__par_mat` can no longer collide on a counter-derived name and inherit the
// wrong element type — which made the victim read its store at the wrong stride.

fn dbl(x: integer) -> integer {
  return x * 2;
}
fn half(x: integer) -> float {
  return(x as float) / 2.0;
}
fn even(x: integer) -> boolean {
  return x % 2 == 0;
}
fn char_one(c: character) -> integer {
  if c == ' ' { return 0; } return 1;
}

fn main() {
  s1 = 0; for i in 0..5 par(a = dbl(i), 3) { s1 += a; }
  assert(s1 == 20, "range int par: {s1}");
  s2 = 0.0; for i in 0..4 par(b = half(i), 2) { s2 += b; }
  assert(s2 == 3.0, "range float par: {s2}");
  // VICTIM: a range (integer) loop, corrupted pre-fix by the later char loop.
  c = 0; for i in 0..6 par(d = even(i), 2) {
    if d { c += 1; }
  }
  assert(c == 3, "range bool par (the #282 victim): {c}");
  v = [1, 2, 3, 4, 5]; s3 = 0; for i in v par(e = dbl(i), 2) { s3 += e; }
  assert(s3 == 30, "vector int par: {s3}");
  vx = [1, 2, 3]; sx = 0; for i in vx par(f = dbl(i), 2) { sx += f; }
  assert(sx == 12, "vector int par 2: {sx}");
  // text-source: materialises vector<character> (different element type).
  n = 0; for ch in "hello" par(g = char_one(ch), 2) { n += g; }
  assert(n == 5, "text-source par: {n}");
}
