//
// loft#1067 — a short lambda takes its parameter types from the expected `fn(…)` type
// WHEREVER there is one, not only at a call site.
//
// The rule used to be scoped to the call argument, so `H { f: |x| { x * 2 } }` was
// refused while `takes(|x| { x * 2 })` was accepted — even though the field's declared
// type says exactly what the parameter's does. The filed case was the struct field; the
// sweep behind this file found four more positions with an equally available expected
// type, so the cure is one predicate on the single `⇐` channel rather than one patch per
// position: `seeds_lambda_hint`, read at every site that pushes an expected type.
//
// Each cell names ONE position. Values are hand-computed and distinct per cell, so a cell
// that stops threading its type cannot be covered by a neighbour's answer. The last two
// pin the shapes that were most at risk of being fixed only halfway: a lambda with more
// than one parameter (every parameter has to take its type from the same signature, not
// just the first) and a CAPTURING one (whose slot is 20 bytes, and whose capture is the
// half historically written four bytes wide).
//
// Its negative half is `test_no_expected_type_is_still_refused`: the diagnostic must
// still fire where nothing names a signature, or this file would pass on a compiler that
// simply stopped checking.
//
// A TUPLE member was the one position left out at first, and the reason is worth keeping:
// a `fn(…)` in a tuple could not be CALLED back out of one whatever spelling put it there
// (loft#1069), so threading the type there would have replaced a clean type error with a
// panic. The rule extends exactly as far as the storage supports — and with that fixed,
// it now extends there too.

struct H1067  { f: fn(integer) -> integer }
struct O1067  { h: H1067 }
struct G1067  { g: fn(integer, text) -> text }
struct V1067  { f: fn(integer) }

fn takes1067(f: fn(integer) -> integer) -> integer { f(5) }
fn dflt1067(f: fn(integer) -> integer = |x| { x * 2 }) -> integer { f(5) }
fn make1067() -> fn(integer) -> integer { |x| { x * 2 } }

fn test_a_call_argument_infers() {
  assert(takes1067(|x| { x * 2 }) == 10, "positional argument: got {takes1067(|x| { x * 2 })}");
}

fn test_a_declared_local_infers() {
  a: fn(integer) -> integer = |x| { x * 3 };
  assert(a(3) == 9, "declared local: got {a(3)}");
}

fn test_a_struct_literal_field_infers() {
  // The filed case. The field's declared type is the expected type.
  h = H1067 { f: |x| { x * 2 } };
  assert(h.f(7) == 14, "struct-literal field: got {h.f(7)}");
}

fn test_a_nested_struct_literal_field_infers() {
  // The same site one level in — the push must not depend on being the outermost literal.
  o = O1067 { h: H1067 { f: |x| { x * 4 } } };
  assert(o.h.f(3) == 12, "nested struct field: got {o.h.f(3)}");
}

fn test_a_vector_element_infers() {
  // Two DIFFERENT lambdas: the hint has to be re-pushed per element, not once for the
  // literal, so a second element cannot be inferred from the first.
  v: vector<fn(integer) -> integer> = [|x| { x * 2 }, |x| { x + 100 }];
  assert(v[0](3) == 6, "vector element 0: got {v[0](3)}");
  assert(v[1](3) == 103, "vector element 1: got {v[1](3)}");
}

fn test_a_return_position_infers() {
  m = make1067();
  assert(m(3) == 6, "block-tail return: got {m(3)}");
}

fn test_a_named_argument_infers() {
  // The spelling of the argument is not the axis — a named argument names the same
  // parameter the positional one does.
  assert(takes1067(f: |x| { x * 4 }) == 20, "named argument: got {takes1067(f: |x| { x * 4 })}");
}

fn test_a_parameter_default_infers() {
  assert(dflt1067() == 10, "parameter default: got {dflt1067()}");
}

fn test_every_parameter_infers_not_only_the_first() {
  g = G1067 { g: |n, s| { "{s}:{n}" } };
  assert(g.g(4, "a") == "a:4", "two parameters: got {g.g(4, \"a\")}");
}

fn test_a_tuple_member_infers() {
  // The eighth position, landed with loft#1069.
  t: (fn(integer) -> integer, integer) = (|x| { x * 2 }, 1);
  assert(t.0(3) == 6, "tuple member: got {t.0(3)}");
  u: (integer, fn(integer, text) -> text) = (5, |n, s| { "{s}{n}" });
  assert(u.1(4, "a") == "a4", "tuple member, two parameters: got {u.1(4, \"a\")}");
}

fn test_a_capturing_lambda_in_a_field_carries_its_capture() {
  k = 10;
  c = H1067 { f: |x| { x * k } };
  assert(c.f(3) == 30, "capturing lambda in a field: got {c.f(3)}");
  // Twice, so a closure record consumed by the first call would show here.
  assert(c.f(5) == 50, "the capture survives a second call: got {c.f(5)}");
}

fn test_a_void_returning_lambda_in_a_field_works() {
  seen = 0;
  v = V1067 { f: |x| { seen = x } };
  v.f(9);
  // A void `fn(integer)` field has no return to infer from, so only the PARAMETER can
  // come from the expected type — the cell that would fail if the hint needed a return.
  assert(seen == 9, "void-returning lambda in a field: got {seen}");
}

// The negative half. Widening the rule must not turn it into "never check": where
// NOTHING names a signature there is still no type to infer, and the diagnostic that says
// so — naming the cure — has to survive. Without this cell, a compiler that simply
// stopped reporting would pass every cell above.
// @EXPECT_ERROR: Cannot infer type for lambda parameter 'x'
fn test_no_expected_type_is_still_refused() {
  // A bare binding names no signature, so there is nothing for `x` to be.
  //
  // The body neither names `x` nor CALLS the lambda, and both omissions are deliberate:
  // an uninferred parameter used in the body also draws a follow-on "Unknown variable",
  // and calling an uninferred fn-ref cascades into syntax errors. Both are pre-existing
  // wreckage AFTER the diagnostic; this cell is about the diagnostic itself, so it pins
  // exactly one.
  a = |x| { 5 };
  assert(true, "unreached");
}

fn main() {
  test_a_call_argument_infers();
  test_a_declared_local_infers();
  test_a_struct_literal_field_infers();
  test_a_nested_struct_literal_field_infers();
  test_a_vector_element_infers();
  test_a_return_position_infers();
  test_a_named_argument_infers();
  test_a_parameter_default_infers();
  test_every_parameter_infers_not_only_the_first();
  test_a_tuple_member_infers();
  test_a_capturing_lambda_in_a_field_carries_its_capture();
  test_a_void_returning_lambda_in_a_field_works();
}
