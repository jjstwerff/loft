//
// @PLN125 arc C — `x[i]` dispatched to a library type.
//
// `OpIndex` was the one operator the parser never dispatched: every other one
// already had its `OpCamelCase` method (@PLN99), but a user struct met
// *"Indexing a non vector"*, so a matrix, a bitset, a row or a ring buffer had
// to read as `x.at(i)`. That was the last place a library type was VISIBLY not
// a built-in one.
//
// It follows the `OpAdd` / `OpEq` precedent exactly — same method name shape,
// same lookup, and an interface may REQUIRE it with the `op` sugar. So `x[i]`
// on a library type lowers to the ordinary two-argument method call
// `t_<LEN><Type>_OpIndex(x, i)`, and every rule that governs a method call
// governs this one because it IS one.
//
// The index type is whatever the method declares — loft does not insist it be
// an integer, and a row addressed by column NAME is the case that shows why.
//
// The refusals (a type with no `OpIndex`, an unbounded type variable, and
// `x[i] = …`) are in tests/errors.
//
// The sugar covers ONE index. A built-in takes two more spellings a library type
// does not get: the composite `x[a, b]` (which a `hash<Cell[r, c]>` answers) and
// the slice `x[a..b]` (which a vector answers). Both stop in the parser with
// `Expect token ]`, before any `OpIndex` lookup — even though a two-index
// `fn OpIndex(self: Mat, r: integer, c: integer)` is accepted and answers
// correctly when called by its name. loft#996.

interface Indexable {
  op [] (self: Self, i: integer) -> integer
  fn count(self: Self) -> integer
}

struct Bits {
  words: vector<integer>,
}

// A ring buffer: the whole point is that `x[i]` is NOT `data[i]`.
struct Ring {
  data: vector<integer>,
  start: integer,
}

// Addressed by name rather than by position.
struct Row {
  names: vector<text>,
  values: vector<integer>,
}

// An `OpIndex` that answers a STRUCT takes the heap-return path.
struct Cell {
  n: integer,
}

struct Grid {
  cells: vector<Cell>,
}

fn OpIndex(self: Bits, i: integer) -> integer { return self.words[i] ?? 0; }
fn count(self: Bits) -> integer { return len(self.words); }

fn OpIndex(self: Ring, i: integer) -> integer {
  n = len(self.data);
  if n == 0 { return 0; }
  return self.data[(self.start + i) % n] ?? 0;
}
fn count(self: Ring) -> integer { return len(self.data); }

fn OpIndex(self: Row, name: text) -> integer {
  for i in 0..len(self.names) {
    if (self.names[i] ?? "") == name { return self.values[i] ?? -1; }
  }
  return -1;
}

fn OpIndex(self: Grid, i: integer) -> Cell { return self.cells[i] ?? Cell { n: -1 }; }

// A generic that SUBSCRIPTS through its bound — the same dispatch a bounded
// `+` gets, so the stub is built and re-pointed by the same machinery.
fn total<I: Indexable>(x: I) -> integer {
  s = 0;
  for i in 0..x.count() { s += x[i]; }
  return s;
}

// @FTR-023 — `x[i]` on a library type: what the method decides, and what it must be
// reached through
//
// Every rule here follows from `x[i]` lowering to an ordinary method call: the ring's
// subscript is not its vector's, a miss past the end is the TYPE's answer rather than
// the language's, the index need not be an integer, a struct-returning subscript reads
// inline, subscripts nest (`b[b[0]]`), and a bound carries the operator to each
// implementor. What the sugar does NOT reach is in the header note above.
fn main() {
  b = Bits { words: [1, 2, 3] };
  assert(b[0] == 1, "a library type indexes: {b[0]}");
  assert(b[2] == 3, "and at the far end: {b[2]}");
  // Out of range is the TYPE's answer, not the language's — `OpIndex` is an
  // ordinary method, so it decides.
  assert(b[9] == 0, "past the end is the type's own answer: {b[9]}");

  r = Ring { data: [10, 20, 30], start: 1 };
  assert(r[0] == 20, "the ring's own offset: {r[0]}");
  assert(r[2] == 10, "and it wraps: {r[2]}");

  // The index need not be an integer.
  w = Row { names: ["id", "score"], values: [7, 91] };
  assert(w["id"] == 7, "a text index: {w["id"]}");
  assert(w["score"] == 91, "the second column: {w["score"]}");
  assert(w["absent"] == -1, "and a miss: {w["absent"]}");

  // A struct-returning subscript, read inline and bound to a local.
  g = Grid { cells: [Cell { n: 5 }, Cell { n: 6 }] };
  assert(g[1].n == 6, "a struct-returning OpIndex read inline: {g[1].n}");
  c = g[0];
  assert(c.n == 5, "and bound to a local: {c.n}");

  // Subscripts compose like any other expression.
  assert(b[0] + b[1] == 3, "two subscripts in one expression: {b[0] + b[1]}");
  assert(b[b[0]] == 2, "a subscript as the index: {b[b[0]]}");

  // Through a bound, per implementor.
  assert(total(b) == 6, "subscript through a bound: {total(b)}");
  assert(total(r) == 60, "and for the second implementor: {total(r)}");

  println("pln125 c index ok");
}
