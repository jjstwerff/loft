// 160 — @PLAN53: mixed-width / non-8-multiple tuple in a parallel `par()` loop.
//
// Promoted from cluster-2 probes 2h/2i.  UNIQUE vs `tests/issues.rs::p189c`,
// which only covers `(integer, integer)` (a 16-byte, 8-multiple tuple); these
// tuples have a NON-8-multiple total — a trailing `character` (12B), a trailing
// `boolean` (9B), and a 3-tuple (20B) — the exact par-worker-frame layout edge
// the aligned-stack fix (2h byte-smear + 2i stepped worker frame) addressed.
//
// Long-run value: a regression guard for tuple marshalling into `par` workers,
// AND a V2 differential seed — run under `LOFT_ALIGN=1 LOFT_SLOT_V2=drive` it
// exercises the stepped worker frame that the V1 run (here) does not.

fn add2(p: const(integer, integer)) -> integer {
  p.0 + p.1
}
fn pick_ic(p: const(integer, character)) -> integer {
  p.0
}
fn sel_ib(p: const(integer, boolean)) -> integer {
  if p.1 { p.0 } else { 0 }
}
fn sum3(p: const(integer, integer, character)) -> integer {
  p.0 + p.1
}

fn main() {
  // (int, int) — 16 bytes, the p189c baseline.
  ii: vector<(integer, integer)> = [(1, 10), (2, 20), (3, 30), (4, 40)];
  s = 0;
  for p in ii par(r = add2(p), 4) { s += r; }
  assert(s == 110, "ii: got {s}, want 110");

  // (int, char) — 12 bytes, non-8-multiple total.
  ic: vector<(integer, character)> = [(5, 'a'), (9, 'b')];
  s = 0;
  for p in ic par(r = pick_ic(p), 4) { s += r; }
  assert(s == 14, "ic: got {s}, want 14");

  // (int, bool) — 9 bytes, 1-byte trailing element.
  ib: vector<(integer, boolean)> = [(5, true), (9, false), (3, true)];
  s = 0;
  for p in ib par(r = sel_ib(p), 4) { s += r; }
  assert(s == 8, "ib: got {s}, want 8");

  // (int, int, char) — 20 bytes, 3-tuple non-8-multiple.
  iic: vector<(integer, integer, character)> = [(1, 2, 'a'), (3, 4, 'b')];
  s = 0;
  for p in iic par(r = sum3(p), 4) { s += r; }
  assert(s == 10, "iic: got {s}, want 10");

  println("160-plan53-tuple-par-mixed-width PASSED");
}
