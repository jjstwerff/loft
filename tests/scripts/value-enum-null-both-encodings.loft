//
// A value enum is null the same way whichever byte carries the null.
//
// An enum discriminant reaches a program as one of TWO absent bytes: an explicit null
// writes 255 (`OpConvEnumFromNull`), while zero-initialised storage and `OpGetEnum` on
// an absent record produce 0.  `Stores::enum_val` — the renderer — already treats both
// as `null`, because it indexes real variants from 1, so 0 is not a variant of any enum.
// The TESTS did not: `??` / `x?` asked `!= 255` only, `== null` asked `disc == 0` for a
// bare enum and `disc == typed null` for a `τ?` one.  Three questions, one type.
//
// What that cost, identically on BOTH backends — so the differential oracle could never
// have seen it:
//
//   v[9] ?? fallback        answered `null`, from a coalesce whose whole job is to
//                           discharge one
//   h.c == null             answered FALSE for a field never set, which renders `null`
//   h.c ?? fallback         answered `null` for that same field
//
// The sweep is over the SOURCE of the null, because that is what picks the encoding —
// the type is held fixed on purpose here, which is the opposite of the usual sweep and
// is what the defect needed.  Every row must agree with every other row.

enum Vecol { Red, Blue, Green }
struct Vhold { c: Vecol? }

fn from_a_call() -> Vecol? { null }

fn test_every_source_of_a_null_tests_as_null() {
  local: Vecol? = null;
  returned = from_a_call();
  elems = [Vecol::Blue];
  unset = Vhold { };

  assert(local == null, "a null literal");
  assert(returned == null, "a null returned by a call");
  assert(elems[9] == null, "an out-of-range element read");
  assert(unset.c == null, "a field never set");

  assert(!(local != null), "a null literal, negated");
  assert(!(returned != null), "a returned null, negated");
  assert(!(elems[9] != null), "an out-of-range read, negated");
  assert(!(unset.c != null), "a field never set, negated");
}

fn test_every_source_of_a_null_discharges_through_a_coalesce() {
  local: Vecol? = null;
  returned = from_a_call();
  elems = [Vecol::Blue];
  unset = Vhold { };

  // `Green` is discriminant 3, never 0 and never 255, so a fallback that arrived by
  // accident cannot be mistaken for one of the sentinels.
  assert((local ?? Vecol::Green) == Vecol::Green, "?? a null literal");
  assert((returned ?? Vecol::Green) == Vecol::Green, "?? a returned null");
  assert((elems[9] ?? Vecol::Green) == Vecol::Green,
         "?? an out-of-range read: got {elems[9] ?? Vecol::Green}");
  assert((unset.c ?? Vecol::Green) == Vecol::Green,
         "?? a field never set: got {unset.c ?? Vecol::Green}");

  // `x?` reaches the same check by another route, so it is asked too.  An enum's
  // default is its FIRST variant.
  assert(elems[9]? == Vecol::Red, "x? an out-of-range read: got {elems[9]?}");
  assert(unset.c? == Vecol::Red, "x? a field never set: got {unset.c?}");
}

fn test_a_present_variant_survives_every_spelling() {
  // The half that keeps the fix honest: widening what counts as null must not swallow
  // a value.  `Red` is discriminant 1 — the variant adjacent to the absent byte, so it
  // is the one an off-by-one would take.
  present: Vecol? = Vecol::Red;
  elems = [Vecol::Red, Vecol::Blue];
  held = Vhold { c: Vecol::Red };

  assert(!(present == null), "a present first variant is not null");
  assert(present != null, "a present first variant, negated");
  assert((present ?? Vecol::Green) == Vecol::Red, "?? keeps a present first variant");
  assert((elems[0] ?? Vecol::Green) == Vecol::Red, "?? keeps a present element");
  assert(!(held.c == null), "a set field is not null");
  assert((held.c ?? Vecol::Green) == Vecol::Red, "?? keeps a set field");
  assert(elems[1]? == Vecol::Blue, "x? keeps a present element");
}

fn test_a_null_written_into_a_field_agrees_with_what_the_field_shows() {
  // The case `tests/reflect_declared_nullable.rs` was pinning the OLD answer of: a
  // `null` written into a value-enum field stores the enum's null sentinel, and the
  // field then renders `null` and discharges through `??`.  `== null` used to answer
  // `false` there — contradicting both the renderer and the coalesce on the same byte.
  // It holds for the not-null spelling too, because writing `null` into it is accepted
  // and what lands really is absent.
  written = Vhold { c: null };
  assert(written.c == null, "a null WRITTEN into a nullable field");
  assert((written.c ?? Vecol::Green) == Vecol::Green, "?? that written null");
  assert("{written.c}" == "null", "and the same field renders null");

  set = Vhold { c: Vecol::Blue };
  assert(!(set.c == null), "a field set to a variant is not null");
  assert("{set.c}" == "Blue", "and it renders that variant");
}

fn test_a_boolean_is_not_an_enum() {
  // `boolean` is byte-stored the same way (0 / 1 / 255) but is a different TYPE, so it
  // must not pick up the enum's reading of 0.  `false` IS a value; if it ever routed
  // through the enum predicate it would start reading as missing, which is the one way
  // this fix could do damage.
  f = false;
  assert(!(f == null), "false is not null");
  assert((f ?? true) == false, "?? keeps false");
  assert(f? == false, "x? keeps false");
  b = Vhold { };
  _ = b;
  flags = [false, true];
  assert((flags[0] ?? true) == false, "?? keeps a false element");
  assert(!(flags[0] == null), "a false element is not null");
}

fn main() {
  test_every_source_of_a_null_tests_as_null();
  test_every_source_of_a_null_discharges_through_a_coalesce();
  test_a_present_variant_survives_every_spelling();
  test_a_null_written_into_a_field_agrees_with_what_the_field_shows();
  test_a_boolean_is_not_an_enum();
  print("value-enum-null-both-encodings ok\n");
}
