//
// Regression: `a = f(a, x)` inside a loop kept ONE element (moros H7).
//
// A heap-returning fn takes a caller-allocated return buffer as a hidden
// trailing argument and clears it on entry.  The caller minted one buffer per
// call SITE and bound the target to it, so after one iteration `a` WAS the
// buffer: the next call cleared the store its own `v` argument aliased, and
// every append but the last vanished — silently, with no diagnostic.  A second
// buffer now rotates with the first (parser/expressions.rs::rotate_loop_retbufs)
// so a call never writes into the store the live target holds.
//
// The cells below are the boundary matrix (tests/probes/h7-retbuf-alias/):
// the broken family plus the shapes that were already correct and must stay so.
// Every expectation is hand-computed.

fn add_i(v: vector<integer>, x: integer) -> vector<integer> {
  out = v;
  out += [x];
  out
}

fn add_t(v: vector<text>, x: text) -> vector<text> {
  out = v;
  out += [x];
  out
}

// Mutating the parameter and returning it — returned 0 before the fix.
fn push_param(v: vector<integer>, x: integer) -> vector<integer> {
  v += [x];
  v
}

// A fresh buffer that copies the argument element-by-element — returned 1
// before the fix, because `out = []` cleared the very store `v` aliased.
fn rebuild(v: vector<integer>, x: integer) -> vector<integer> {
  out: vector<integer> = [];
  for e in v { out += [e]; }
  out += [x];
  out
}

fn add_b(v: vector<integer>, x: integer) -> vector<integer> {
  out = v;
  out += [x];
  out
}

fn test_loop_helper_reassign() {
  a: vector<integer> = [];
  for k in [10, 20, 30] { a = add_i(a, k); }
  assert(len(a) == 3, "loop helper: len={len(a)} expect 3");
  assert(a[0] == 10 && a[1] == 20 && a[2] == 30, "loop helper: contents {a}");
}

fn test_loop_over_range() {
  a: vector<integer> = [];
  for k in 0..3 { a = add_i(a, k); }
  assert(len(a) == 3, "range loop: len={len(a)} expect 3");
}

fn test_while_loop() {
  a: vector<integer> = [];
  i = 0;
  while i < 3 { a = add_i(a, i); i = i + 1; }
  assert(len(a) == 3, "while loop: len={len(a)} expect 3");
}

// The pre-existing content must survive too: it was destroyed with the rest.
fn test_preseeded_accumulator() {
  a: vector<integer> = [7, 8];
  for k in [10, 20, 30] { a = add_i(a, k); }
  assert(len(a) == 5, "preseeded: len={len(a)} expect 5");
  assert(a[0] == 7 && a[4] == 30, "preseeded: contents {a}");
}

// An independent observable of the same fault: reading the accumulator BEFORE
// the call saw 0, 1, 1 instead of 0, 1, 2.
fn test_read_before_the_call() {
  a: vector<integer> = [];
  seen = 0;
  for k in [10, 20, 30] { seen = seen + len(a); a = add_i(a, k); }
  assert(seen == 3, "read-before-call: seen={seen} expect 3");
}

fn test_element_type_does_not_matter() {
  a: vector<text> = [];
  for k in ["a", "b", "c"] { a = add_t(a, k); }
  assert(len(a) == 3, "text elements: len={len(a)} expect 3");
}

fn test_helper_mutates_its_parameter() {
  a: vector<integer> = [];
  for k in [10, 20, 30] { a = push_param(a, k); }
  assert(len(a) == 3, "mutated param: len={len(a)} expect 3");
}

fn test_helper_builds_a_fresh_vector() {
  a: vector<integer> = [];
  for k in [10, 20, 30] { a = rebuild(a, k); }
  assert(len(a) == 3, "fresh copy: len={len(a)} expect 3");
}

// ── shapes that were already correct: a fix must not trade one for the other ──

fn test_two_call_sites_in_one_body() {
  a: vector<integer> = [];
  for k in [10, 20, 30] { a = add_i(a, k); a = add_b(a, k); }
  assert(len(a) == 6, "two call sites: len={len(a)} expect 6");
}

fn test_sequential_calls_outside_a_loop() {
  b: vector<integer> = [];
  b = add_i(b, 10);
  b = add_i(b, 20);
  b = add_i(b, 30);
  assert(len(b) == 3, "sequential: len={len(b)} expect 3");
}

fn test_through_a_temp_still_works() {
  a: vector<integer> = [];
  for k in [10, 20, 30] { b = add_i(a, k); a = b; }
  assert(len(a) == 3, "via temp: len={len(a)} expect 3");
}

fn test_struct_field_target() {
  b = Box { items: [] };
  for k in [10, 20, 30] { b.items = add_i(b.items, k); }
  assert(len(b.items) == 3, "struct field: len={len(b.items)} expect 3");
}

// The target is NOT an argument, so nothing aliases and nothing rotates.
fn test_target_not_fed_back() {
  a: vector<integer> = [];
  n = 0;
  for k in [10, 20, 30] { a = rebuild([], k); n = n + len(a); }
  assert(n == 3, "no self-feed: n={n} expect 3");
}

struct Box { items: vector<integer> }

fn main() {
  test_loop_helper_reassign();
  test_loop_over_range();
  test_while_loop();
  test_preseeded_accumulator();
  test_read_before_the_call();
  test_element_type_does_not_matter();
  test_helper_mutates_its_parameter();
  test_helper_builds_a_fresh_vector();
  test_two_call_sites_in_one_body();
  test_sequential_calls_outside_a_loop();
  test_through_a_temp_still_works();
  test_struct_field_target();
  test_target_not_fed_back();
  println("h7-loop-retbuf-alias ok");
}
