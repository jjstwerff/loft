// SPDX-License-Identifier: LGPL-3.0-or-later
// @PLN85 F2 (the program-ownership fuzzer's first ownership catch): a return
// joining a borrowed element view with an OWNED struct-LITERAL `??` default
// (`t[i] ?? N{..}`) suppressed the literal arm's work-ref free entirely — on
// the PRESENT path its (interp-allocating) preamble store leaked once per
// call.  The CALL-default twin (`?? dflt()`) never hit this: a Call arm
// contributes no source var, so the work-ref kept its plain pre-return free.
// Fix (scopes.rs): a multi-source return mixing an owned record work-ref with
// view arms routes the owned sources through the SAME hoist +
// OpFreeRefIfDistinct leg the null-arm join uses.
//
// KNOWN RESIDUAL (recorded, not asserted here): when the literal DEFAULT arm
// actually RUNS, the transferred store leaks at the interp CALLER (the fn's
// returned deps type the join as a pure borrow of `t`) — the deps-carried-join
// completion, D-own-1/D-own-2 territory.  Native is clean on all paths.

struct N {
  vs: vector<integer>,
  id: integer,
}
struct E {
  hp: integer not null,
  name: text,
}
fn e_default() -> E {
  E { hp: 0, name: "" }
}

// the F2 shape — nested-struct literal default, present path
fn pick_n(t: vector<N>, i: integer) -> N {
  t[i] ?? N { vs: [], id: 0 }
}
// flat-struct literal default (the axis is literal-vs-call, not nested-vs-flat)
fn pick_e(t: vector<E>, i: integer) -> E {
  t[i] ?? E { hp: 0, name: "" }
}
// the call-default control (must stay on its own clean path)
fn pick_c(t: vector<E>, i: integer) -> E {
  t[i] ?? e_default()
}
// the accumulate composition (the fuzzer's exact finding shape)
fn collect_n(t: vector<N>) -> vector<N> {
  out: vector<N> = [];
  for i in 0..len(t) { out += [pick_n(t, i)]; }
  out
}

fn main() {
  tn: vector<N> = [];
  for k in 0..3 { tn += [
    N { vs: [k, k + 1], id: k },
  ]; }
  te: vector<E> = [];
  for k in 0..3 { te += [
    E { hp: k, name: "x" },
  ]; }
  acc = 0;
  for i in 0..6 {
    a = pick_n(tn, i % 3);
    b = pick_e(te, i % 3);
    c = pick_c(te, i % 3);
    acc += a.id + b.hp + c.hp;
  }
  assert(acc == 18, "acc: {acc}");
  r = collect_n(tn);
  assert(len(r) == 3, "collect: {len(r)}");
  println("ncc-literal-default-join ok");
}
