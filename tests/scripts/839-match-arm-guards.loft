//
// `if` guards on vector/slice and tuple match arms, and the captures they read.
//
// Two defects stacked here (loft#839).  The guard was parsed with `has_keyword("if")`,
// which matches only an identifier while `if` lexes as a token, so the test never fired
// and every guarded arm was refused with "Expect token =>".  And simply enabling the parse
// answered WRONG: the arm's captures were assigned inside the arm BODY, which runs after
// the condition, while the guard was ANDed into that condition — so a guard reading a
// capture read an unassigned variable, `0 > 10` was false, and the arm silently did not
// match.  A guard that cannot see its own captures is close to useless, since reading a
// binding is the main reason to write one.
//
// So the assertions below are paired on purpose: each guard is exercised once where it
// HOLDS and once where it FAILS.  A single-sided test passes against an arm that never
// matches, which is exactly the wrong answer this file exists to catch.

fn scalar_control(n: integer) -> text {
  match n { x if x > 10 => "A", _ => "B" }
}

fn slice_guard(v: vector<integer>) -> text {
  match v { [a, _, _] if a > 10 => "A", _ => "B" }
}

fn slice_guard_two_captures(v: vector<integer>) -> text {
  match v { [a, b] if a < b => "rising", [a, b] => "flat-or-falling {a}{b}", _ => "other" }
}

fn tuple_guard(a: integer, b: integer, c: integer) -> text {
  t: (integer, integer, integer) = (a, b, c);
  match t { (x, _, _) if x > 10 => "A", _ => "B" }
}

// The issue's own repro: a guard beside a literal element pattern.
fn guard_with_literal(n: integer, name: text, flag: boolean) -> text {
  t: (integer, text, boolean) = (n, name, flag);
  match t {
    (x, _, true) if x > 10 => "big and true",
    (x, _, _)              => "just {x}",
  }
}

fn three_guards(n: integer) -> text {
  t: (integer, integer) = (n, 0);
  match t {
    (x, _) if x > 100 => "huge",
    (x, _) if x > 10  => "big",
    (x, _)            => "small {x}",
  }
}

// A guarded WILDCARD is not total — it needs a real wildcard after it, and both paths
// have to work.  (`839-guarded-wildcard-refused.loft` pins the missing-wildcard error.)
fn guarded_wildcard(v: vector<integer>) -> text {
  match v { _ if len(v) > 2 => "long", _ => "short" }
}

// A `..name` rest MATERIALISES a fresh sub-slice from the arm's bindings.  Those bindings
// run once, inside the branch the pattern already selected — running them again to build
// the guard's condition would allocate a second store and leak it.
fn guard_with_named_rest(v: vector<integer>) -> integer {
  match v { [a, ..rest] if a > 10 => a + len(rest), [a, ..rest] => len(rest) - a, _ => 0 }
}

fn main() {
  assert(scalar_control(11) == "A", "control: scalar guard holds");
  assert(scalar_control(5) == "B", "control: scalar guard fails");

  assert(slice_guard([11, 2, 3]) == "A", "slice guard reads its capture and holds");
  assert(slice_guard([5, 2, 3]) == "B", "slice guard reads its capture and fails");
  assert(slice_guard([11, 2]) == "B", "slice guard arm rejected on length");

  assert(slice_guard_two_captures([1, 2]) == "rising", "guard over two captures holds");
  assert(slice_guard_two_captures([2, 1]) == "flat-or-falling 21", "guard over two captures fails");

  assert(tuple_guard(11, 2, 3) == "A", "tuple guard reads its capture and holds");
  assert(tuple_guard(5, 2, 3) == "B", "tuple guard reads its capture and fails");

  assert(guard_with_literal(42, "x", true) == "big and true", "guard beside a literal element");
  assert(guard_with_literal(5, "x", true) == "just 5", "guard fails, next arm taken");
  assert(guard_with_literal(42, "x", false) == "just 42", "literal fails, guard never reached");

  assert(three_guards(500) == "huge", "first of three guards");
  assert(three_guards(50) == "big", "second of three guards");
  assert(three_guards(5) == "small 5", "no guard holds");

  assert(guarded_wildcard([1, 2, 3]) == "long", "guarded wildcard holds");
  assert(guarded_wildcard([1]) == "short", "guarded wildcard falls through to the real one");

  assert(guard_with_named_rest([11, 1, 2, 3]) == 14, "named rest bound before the guard");
  assert(guard_with_named_rest([5, 1, 2, 3]) == -2, "named rest, guard fails");

  println("839 ok");
}
