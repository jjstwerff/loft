//
// loft#875 — what a `text` field holds when the JSON does not say.
//
// The text half of the rule loft#870 fixed for the numeric scalars, and it was left
// out for a reason: a text handle of 0 reads back as null, so the empty value of a
// `text` field has to be INTERNED, and the arm that defaults a field also runs per
// record on the allocation path. Interning there cost +78 % wall and +91 % peak heap
// over 400 000 rows with three text fields — every one of them overwritten by the
// literal that followed. So the question the default answers was split in two
// (`Absent::Prefill` / `Absent::Final`): a fresh record still gets the cheap value
// nothing misreads, and the walker — the call whose value a reader actually SEES —
// interns.
//
// The defect was not only a wrong read. `name` is declared plain, so the compiler
// says `!name` can never be true, and it said that on the exact line of this suite's
// own assertion (`57-json.loft:65`) — which passed only because the value was null.
// A type, a runtime and a lint each looked right alone and jointly steered code
// toward an unguarded read of a null.
//
// Every cell checks the FIELD's declaration decides, not the type's: the same `text`
// content type answers "" where it is declared plain and null where it is declared
// `text?`, in the same record, for the same absent key.

struct I875 {
  plain: text,
  opt: text?,
  n: integer,
}
struct I875Nested { inner: I875, tag: text }
struct I875Row { rows: vector<I875>, n: integer }

const I875_NULLS: text = `{{ "plain": null, "opt": null, "n": null }}`;
const I875_MISS: text  = `{{ }}`;
const I875_HAS: text   = `{{ "plain": "p", "opt": "o", "n": 5 }}`;
const I875_BAD: text   = `{{ "plain": `;

// `store_memory()`'s first line carries "... | records N | ...", which is how a claim
// that should not have happened is counted rather than guessed at.
fn i875_records() -> integer {
  first = "";
  for line in store_memory().split('\n') { if first == "" { first = line; } }
  want = false;
  for tok in first.split(' ') {
    if want { return tok as integer ?? 0 }
    if tok == "records" { want = true; }
  }
  return 0;
}

fn i875_absent(v: I875, what: text) {
  // A plain field cannot hold null, so absence is its empty value — and `size` says
  // no characters, which is what tells "" from the one-character NUL sentinel.
  assert(v.plain == "", "{what}: plain text is [{v.plain}], expected empty");
  assert(size(v.plain) == 0, "{what}: plain text has {size(v.plain)} characters, expected 0");
  assert(v.n == 0, "{what}: a plain integer takes its zero (loft#870)");
}

/// The nullable twin, in the same record, for a value that came from a DOCUMENT.
///
/// A struct literal answers `""` here instead, and deliberately: @PLN25 settled that an
/// omitted `T?` field takes its base type's zero, because a constructor omitting a field
/// asks for the zero. A document omitting a KEY did not say anything, and that is a
/// different question with a different answer — so the two are pinned apart, not together.
fn i875_absent_key(v: I875, what: text) {
  assert(v.opt == null, "{what}: a `text?` the document omits must stay null");
}

fn main() {
  // The three spellings of "the document did not say".
  i875_absent(I875_NULLS as I875, "explicit null");
  i875_absent(I875_MISS as I875, "key omitted");
  i875_absent_key(I875_NULLS as I875, "explicit null");
  i875_absent_key(I875_MISS as I875, "key omitted");
  // A parse that FAILS abandons the record at its defaults, so those must be the
  // field's absent value too — `#errors` is what says the parse failed, not the value.
  i875_absent(I875_BAD as I875, "failed parse");
  i875_absent_key(I875_BAD as I875, "failed parse");

  // The literal is the fourth spelling of an absent PLAIN text, and it agrees: that is
  // the disagreement loft#875 reported (`T {}` gave "", `"{{}}" as T` gave null).
  i875_absent(I875 {}, "struct literal");
  // Its `text?` field answers NULL, and the difference is the point: a plain `text` has no
  // way to say "absent", so its absent value is the empty string; a `text?` does, so its
  // default is the null sentinel (`formal/types.md` D-Opt).  The four spellings above agree
  // with each other because they are all asking about the PLAIN field.
  assert(I875 {}.opt == null, "an omitted `text?` in a LITERAL is null (D-Opt)");

  // A present value still arrives — the guard must not pass by defaulting everything.
  has = I875_HAS as I875;
  assert(has.plain == "p", "a present plain text: [{has.plain}]");
  assert(has.opt == "o", "a present text?: [{has.opt}]");
  assert(has.n == 5, "a present integer: {has.n}");

  // At depth, a field follows its OWN declaration rather than its parent's.
  nested = `{{ "inner": {{ }}, "tag": null }}` as I875Nested;
  i875_absent(nested.inner, "nested one level down");
  i875_absent_key(nested.inner, "nested one level down");
  assert(nested.tag == "", "a plain text beside the nested record: [{nested.tag}]");

  // And per vector element — the path where the cost of interning would have shown.
  rows = `{{ "rows": [ {{ }}, {{ "plain": "x" }}, {{ "opt": null }} ], "n": 3 }}` as I875Row;
  assert(len(rows.rows) == 3, "three elements, got {len(rows.rows)}");
  i875_absent(rows.rows[0] ?? I875 { plain: "!", n: 9 }, "vector element 0");
  i875_absent_key(rows.rows[0] ?? I875 { plain: "!", opt: "!", n: 9 }, "vector element 0");
  assert((rows.rows[1] ?? I875 {}).plain == "x", "element 1 kept its value");
  assert((rows.rows[1] ?? I875 {}).opt == null, "element 1's text? is still null");
  i875_absent(rows.rows[2] ?? I875 { plain: "!", n: 9 }, "vector element 2");

  // The prefill split must not leak: a record whose text fields are written by the
  // literal must not also carry an interned empty each time round.
  before = i875_records();
  bulk: vector<I875> = [];
  for i in 0..200 { bulk += [I875 { plain: "v{i}", opt: "o{i}", n: i }]; }
  grew = i875_records() - before;
  assert(len(bulk) == 200, "built 200 rows, got {len(bulk)}");
  // 200 rows x 2 written texts, plus the vector's own claims. A prefill that interned
  // as well would add a third throwaway record per row and blow past this.
  assert(grew < 550, "200 two-text rows claimed {grew} records — a prefill is interning");

  println("done");
}
