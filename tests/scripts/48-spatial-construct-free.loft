// @PLN48 S2 — a spatial<T[x, y]> collection: construct, iterate in natural order,
// and free — on BOTH backends.  The runner's leak check is the real assertion —
// remove_claims must free the tree + every element record.  Covers both a local
// variable and a struct field (the field must be laid out and torn down too).
struct SMob {
  x: integer,
  y: integer,
}
struct SWorld {
  mobs: spatial<SMob[x, y]>,
}

fn main() {
  xs: spatial<SMob[x, y]> = [];
  xs += [
    SMob { x: 3, y: 3 },
  ];
  xs += [
    SMob { x: 1, y: 2 },
  ];
  xs += [
    SMob { x: 3, y: 3 },
  ]; // same cell — both kept
  xs += [
    SMob { x: 0, y: 0 },
  ];
  assert(xs.len() == 4, "len counts duplicate cells");

  // Iterate in the tree's natural (Morton/Z-order) order — no sort, the walk is
  // ordered by construction.  Sum the coordinates as a stable, order-independent
  // check that every record (including the duplicate cell) is visited exactly once.
  total: integer = 0;
  count: integer = 0;
  for m in xs {
    total += m.x * 100 + m.y;
    count += 1;
  }
  // 4 records: (3,3)+(1,2)+(3,3)+(0,0) → 303+102+303+0 = 708, count 4.
  assert(count == 4, "iteration visits every record once");
  assert(total == 708, "natural-order walk sums all coordinates");
  print("count={count} total={total}\n");

  // A spatial as a STRUCT FIELD — construct, mutate, iterate, len, tear down.
  w = SWorld { mobs: [] };
  w.mobs += [
    SMob { x: 5, y: 9 },
  ];
  w.mobs += [
    SMob { x: 2, y: 4 },
  ];
  assert(w.mobs.len() == 2, "struct-field spatial len");
  fcount: integer = 0;
  for m in w.mobs { fcount += 1; }
  assert(fcount == 2, "struct-field spatial iterates");
  // `xs` and `w` fall out of scope here; remove_claims frees them with no leak.
}
