//
// Regression (GitHub #262 / @P380, plan-58 cluster II): nested vectors whose
// innermost element is `single` (`vector<vector<single>>`, deeper) SIGSEGV'd on
// BOTH backends.  A freshly-created vector-of-vectors element is a 4-byte VECTOR
// HANDLE, but OpNewRecord default-inits it with the inner scalar's null
// sentinel; for `single` that is the NaN bit-pattern 0x7FC00000 — a non-zero
// garbage rec-id read later by remove_claims → wild get_u32_raw → crash.  The
// @P380 zero-the-handle fix existed only on the copy path; this hoists it to
// every construction path (literal / write / fn-return / copy).
//
// Covers the shapes that crashed before the fix: 2-deep literal, 3-deep += copy
// (the filed #262 repro), element write, fn-return, and 4-deep.

fn mk_single_rows() -> vector<vector<single>> {
  return[[1.5f], [2.5f, 3.5f]];
}

fn main() {
  // 2-deep literal + read (crashed at construction pre-fix)
  vv: vector<vector<single>> = [[1.5f, 2.5f], [3.5f]];
  assert(vv[0][0] == 1.5f && vv[0][1] == 2.5f, "2deep row0: {vv[0]}");
  assert(vv[1][0] == 3.5f, "2deep row1: {vv[1]}");

  // 3-deep += copy — the filed #262 reproducer
  vvv: vector<vector<vector<single>>> = [];
  a: vector<vector<single>> = [[4.5f]];
  vvv += [a];
  assert(vvv[0][0][0] == 4.5f, "3deep copy: {vvv[0][0][0]}");

  // element write
  vv[0][1] = 9.5f;
  assert(vv[0][1] == 9.5f, "after write: {vv[0]}");

  // fn-return
  r = mk_single_rows();
  assert(r[0][0] == 1.5f && r[1][1] == 3.5f, "fn-return: {r}");

  // 4-deep
  q: vector<vector<vector<vector<single>>>> = [];
  b: vector<vector<vector<single>>> = [[[5.5f]]];
  q += [b];
  assert(q[0][0][0][0] == 5.5f, "4deep: {q[0][0][0]}");

  println("nested-single-vector ok");
}
