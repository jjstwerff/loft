//
// Regression for the loft#437 shape, found by re-verifying the Commonstore
// consumer's handoff against a current build: a struct literal binding TWO OR
// MORE collection fields from pre-built locals kept only the field mentioned
// FIRST and silently emptied the rest.
//
// `Bag { a: x, b: y, c: z }` gave `a=[1,2] b=[] c=[]` — right struct, right
// field count, no error, no leak.  It was also UNSTABLE: the interpreter
// happened to print the correct rows in a bare run and the empty ones under
// `LOFT_LOG=minimal`, because the value was being read through a header that had
// already been zeroed.  So the assertions below must run under perturbation to
// mean anything; the suite's dump modes provide it.
//
// Cause: each collection field's header-zeroing (`OpSetInt4(rec, pos, 0)`) was
// emitted inline, between the PREVIOUS field's value and its own.  For a vector
// local that is literal-initialised and not otherwise used, the build is
// retargeted straight INTO the destination field, and that retargeted build runs
// before the inline zeroing — which then erased the header it had just written.
// Only the first-mentioned field escaped, because the record-creation prelude it
// rides along with is hoisted above the retargeted builds.  The zeroing for
// every field is now spliced as one block directly after that prelude, so no
// field's header can be cleared after its contents land.
//
// The discriminators are asserted alongside the failing shape: values that come
// from a CALL, or locals READ before the literal, never take the retarget path
// and always worked — a guard built only from those reports this fixed.

struct Bag { a: vector<integer>, b: vector<integer>, c: vector<integer> }
struct Texts { p: vector<text>, q: vector<text> }
struct Mixed { n: integer, a: vector<integer>, b: vector<integer> }

fn fmt_ints(v: vector<integer>) -> text {
  out = "";
  for i in 0..len(v) { if i > 0 { out += ","; } out += "{v[i] ?? 0}"; }
  return out;
}

// The reported shape: three vector fields, each from a literal-initialised local.
fn test_437_three_vector_fields() {
  x: vector<integer> = [1, 2];
  y: vector<integer> = [3, 4];
  z: vector<integer> = [5, 6];
  g = Bag { a: x, b: y, c: z };
  assert(len(g.a) == 2 && len(g.b) == 2 && len(g.c) == 2,
    "field lengths: a={len(g.a)} b={len(g.b)} c={len(g.c)}");
  assert(fmt_ints(g.a) == "1,2", "field a: {fmt_ints(g.a)}");
  assert(fmt_ints(g.b) == "3,4", "field b: {fmt_ints(g.b)}");
  assert(fmt_ints(g.c) == "5,6", "field c: {fmt_ints(g.c)}");
}

// Two fields is already enough — the fault starts at the SECOND field.
fn test_437_two_vector_fields() {
  x: vector<integer> = [1, 2];
  y: vector<integer> = [3, 4];
  g = Bag { a: x, b: y, c: [] };
  assert(fmt_ints(g.a) == "1,2" && fmt_ints(g.b) == "3,4", "two fields: a={fmt_ints(g.a)} b={fmt_ints(g.b)}");
}

// It followed the literal's MENTION order, not the struct's declaration order:
// binding `b` first made `b` the survivor and emptied `a`.
fn test_437_mention_order() {
  x: vector<integer> = [1, 2];
  y: vector<integer> = [3, 4];
  g = Bag { b: y, a: x, c: [] };
  assert(fmt_ints(g.a) == "1,2" && fmt_ints(g.b) == "3,4",
    "reversed mention order: a={fmt_ints(g.a)} b={fmt_ints(g.b)}");
}

// Element type is irrelevant — a heap element (text) failed the same way.
fn test_437_text_vector_fields() {
  p: vector<text> = ["alpha"];
  q: vector<text> = ["beta"];
  t = Texts { p: p, q: q };
  assert(len(t.p) == 1 && len(t.q) == 1, "text fields: p={len(t.p)} q={len(t.q)}");
  assert((t.p[0] ?? "") == "alpha" && (t.q[0] ?? "") == "beta", "text values: {t.p} {t.q}");
}

// A leading SCALAR field does not shield the collection fields behind it.
fn test_437_scalar_then_vectors() {
  x: vector<integer> = [1, 2];
  y: vector<integer> = [3, 4];
  m = Mixed { n: 7, a: x, b: y };
  assert(m.n == 7 && fmt_ints(m.a) == "1,2" && fmt_ints(m.b) == "3,4",
    "scalar + two vectors: n={m.n} a={fmt_ints(m.a)} b={fmt_ints(m.b)}");
}

// ── the discriminators that always worked, kept so a narrower fix cannot pass ──

// Inline literals never went through a local, so never took the retarget path.
fn test_437_inline_literals() {
  g = Bag { a: [1, 2], b: [3, 4], c: [5, 6] };
  assert(fmt_ints(g.a) == "1,2" && fmt_ints(g.b) == "3,4" && fmt_ints(g.c) == "5,6",
    "inline literals: {fmt_ints(g.a)} {fmt_ints(g.b)} {fmt_ints(g.c)}");
}

fn mk(n: integer) -> vector<integer> { v: vector<integer> = []; v += [n]; v += [n + 1]; return v; }

// A value from a CALL is not a retargetable literal build.
fn test_437_from_calls() {
  x = mk(1);
  y = mk(3);
  g = Bag { a: x, b: y, c: [] };
  assert(fmt_ints(g.a) == "1,2" && fmt_ints(g.b) == "3,4", "from calls: {fmt_ints(g.a)} {fmt_ints(g.b)}");
}

// A local READ before the literal is already materialised in its own store.
fn test_437_local_read_first() {
  x: vector<integer> = [1, 2];
  y: vector<integer> = [3, 4];
  assert(len(x) == 2 && len(y) == 2, "pre-read: x={len(x)} y={len(y)}");
  g = Bag { a: x, b: y, c: [] };
  assert(fmt_ints(g.a) == "1,2" && fmt_ints(g.b) == "3,4", "read first: {fmt_ints(g.a)} {fmt_ints(g.b)}");
}

// The sources must survive the bind — the fields are deep COPIES, not moves.
fn test_437_sources_intact() {
  x: vector<integer> = [1, 2];
  y: vector<integer> = [3, 4];
  g = Bag { a: x, b: y, c: [] };
  assert(fmt_ints(x) == "1,2" && fmt_ints(y) == "3,4", "sources after bind: x={fmt_ints(x)} y={fmt_ints(y)}");
  assert(fmt_ints(g.b) == "3,4", "field b after reading sources: {fmt_ints(g.b)}");
}
