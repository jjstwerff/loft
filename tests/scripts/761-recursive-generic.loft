//
// loft#761 — a generic that calls itself panicked the compiler before anything
// ran, on both backends: "index out of bounds: the len is 0 but the index is 1".
//
// A self-recursive generic reaches `try_generic_instantiation` while its OWN
// template is still being parsed, and the argument is the type VARIABLE, so the
// resolved "concrete" type is that variable.  Instantiating against it built a
// def by cloning the template's variable table — which the parser has not
// written back yet, so the clone was EMPTY.  That def is a plain `Function`, so
// codegen emitted it and indexed a table of length 0.
//
// There is nothing to instantiate at that point and nothing to diagnose either:
// the call is good, it just has no concrete type YET.  It answers the TEMPLATE,
// and the monomorph retargets it later — the same path any call to a generic
// takes from inside another generic.
//
// Non-generic recursion was always fine, so the trigger is recursion AND a type
// parameter together, not either one.
//
// NOT covered here: MUTUAL recursion between two generics (`even` calls `odd`
// calls `even`).  It used to corrupt the heap outright — `realloc(): invalid
// next size`, a core dump — and now runs correctly on the interpreter, but
// `--native` still rejects the generated Rust with E0308.  Only one direction of
// the pair is deferred by the guard below: the partner declared LATER has an
// unfinished table and is answered as a template, while the one declared EARLIER
// is finished and takes the ordinary instantiation path with the type variable
// still in hand.  Left out of this file rather than left failing; tracked on
// loft#761.

interface Shape {
  fn area(self: Self) -> integer
}

struct Box { w: integer, h: integer }
fn area(self: Box) -> integer { return self.w * self.h; }

struct Disc { r: integer }
fn area(self: Disc) -> integer { return self.r * self.r * 3; }

// SELF-recursive.
fn down <S: Shape> (s: S, n: integer) -> integer {
  if n <= 0 { return s.area() }
  return down(s, n - 1) + 1;
}

// Reached only THROUGH another generic — the recursion and the nesting at once.
fn outer <S: Shape> (s: S) -> integer { return down(s, 3); }

// Plain recursion, no type parameter — the control that says the trigger needs
// both halves.
fn plain(n: integer, base: integer) -> integer {
  if n <= 0 { return base }
  return plain(n - 1, base) + 1;
}

fn main() {
  b = Box { w: 3, h: 4 };     // area 12
  c = Disc { r: 5 };          // area 75

  assert(down(b, 3) == 15, "self-recursive generic: {down(b, 3)}, want 15");

  // The SAME recursive generic instantiated for a second concrete type.
  assert(down(c, 3) == 78, "second concrete type: {down(c, 3)}, want 78");

  assert(outer(b) == 15, "recursive generic reached via another: {outer(b)}, want 15");

  assert(plain(3, 12) == 15, "non-generic recursion still fine: {plain(3, 12)}, want 15");

  println("761 recursive generic ok");
}
