// size(t) — byte count (@PLN110: size(text) is the UTF-8 byte length)

fn main() {
  // ASCII: one byte per character
  assert(size("hello") == 5, "ASCII size");

  // Multi-byte: an accent is 2 bytes, so "héllo" is 6 bytes over 5 characters
  assert(size("héllo") == 6, "Multi-byte accent");
  assert(size("日本語") == 9, "CJK characters (3 bytes each)");

  // Empty text
  assert(size("") == 0, "Empty text");

  // Emoji: 4-byte UTF-8
  assert(size("🎉") == 4, "4-byte emoji");
  assert(size("♥") == 3, "3-byte heart");
  assert(size("a😃b") == 6, "Mixed ASCII and emoji (1 + 4 + 1)");
}
