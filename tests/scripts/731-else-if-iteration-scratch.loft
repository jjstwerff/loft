//
// loft#731 — a collection declared AND iterated inside an `else if` branch must
// compile on `--native`.
//
// `scopes.rs` gives every iteration scratch an `OpFreeScratch` at the
// FUNCTION's scope exit, because a `return` out of an exposed loop bypasses the
// loop epilogue. Its null-init, though, is placed where the variable is first
// used — and an `else if` puts that inside a nested block, so the
// function-level free named a binding that was out of scope: rustc E0425,
// `cannot find value var__hash_scratch_1`. A hard compile failure on one
// backend only; `--interpret` ran it correctly throughout.
//
// The shapes below differ only in WHERE the collection is declared and
// iterated, which is the whole of what decided it. A plain `else`, the function
// top level, and a nested `if` inside an `else` all compiled before — they are
// here so a future change to the declaration's placement has to keep them all.

struct S731 { const k: integer, const v: integer }

fn seeded() -> hash<S731[k]> {
  h: hash<S731[k]> = [];
  h += [S731 { k: 1, v: 10 }];
  h += [S731 { k: 2, v: 20 }];
  return h;
}

// The failing shape: declared and iterated in an `else if` branch.
fn in_else_if(m: text) -> integer {
  if m == "a" { return -1 }
  else if m == "b" {
    h = seeded();
    n = 0;
    for r in h { n += r.v; }
    return n;
  }
  else { return -2 }
}

// The same, with an early `return` before the loop — the path that makes the
// function-level free load-bearing in the first place.
fn in_else_if_early_return(m: text, stop: boolean) -> integer {
  if m == "a" { return -1 }
  else if m == "b" {
    h = seeded();
    if stop { return -3 }
    n = 0;
    for r in h { n += r.v; }
    return n;
  }
  else { return -2 }
}

// Two scratches in one function, in different branches of the same chain.
fn two_branches(m: text) -> integer {
  if m == "a" {
    h = seeded();
    n = 0;
    for r in h { n += r.v; }
    return n;
  } else if m == "b" {
    h = seeded();
    n = 0;
    for r in h { n += r.k; }
    return n;
  }
  return 0;
}

// The shapes that already compiled — kept so the fix cannot regress them.
fn at_top_level() -> integer {
  h = seeded();
  n = 0;
  for r in h { n += r.v; }
  return n;
}

fn in_plain_else(m: text) -> integer {
  if m == "a" { return -1 } else {
    h = seeded();
    n = 0;
    for r in h { n += r.v; }
    return n;
  }
}

fn main() {
  assert(in_else_if("b") == 30, "else-if branch iterates its own collection");
  assert(in_else_if("a") == -1, "else-if: first arm still taken");
  assert(in_else_if("z") == -2, "else-if: final else still taken");
  assert(in_else_if_early_return("b", false) == 30, "else-if with an early return present");
  assert(in_else_if_early_return("b", true) == -3, "else-if: the early return is taken");
  assert(two_branches("a") == 30, "two scratches, first branch");
  assert(two_branches("b") == 3, "two scratches, second branch");
  assert(at_top_level() == 30, "top-level iteration unchanged");
  assert(in_plain_else("z") == 30, "plain else unchanged");
}
