//
// Regression (loft#702): a vector CONSTANT whose elements are structs.
//
// The constant store pre-builds a vector from the literal field writes its initialiser
// emits, and it read them as ONE VALUE PER ELEMENT — true only while constants held
// scalars.  A struct element makes one write per FIELD, so `[It { a: 3, b: 4 }]` looked
// like two elements: the vector reported length 2, `b` reappeared as the next element's
// `a`, and every second field read 0.  Silent, on both backends.
//
// Two things were wrong, and both had to go.  The offset each write carries was dropped,
// so the grouping had nothing to place fields with; and a constant's initialiser was
// stored from the FIRST parser pass, before struct layouts exist, so every offset in it
// was the `u16::MAX` placeholder anyway.  A vector constant now adopts the second pass's
// initialiser, and one extractor groups the writes per element for BOTH the interpreter's
// pre-builder and native codegen's — so the two agree by construction.
//
// Axes: element FIELD COUNT (1 — the case that accidentally worked, 2, 3), element COUNT,
// field ORDER at the literal (named out of order), and the element field TYPES (integer,
// text, float, narrow).  Controls: scalar and text element vectors, which always worked,
// and the same data through a local and a call, which never went via the const store.
// `tests/scripts/102-expected-errors.loft` pins what a constant still cannot hold — an
// element with a nested record, which no field write describes.

struct It702 { a: integer, b: integer }
struct It1_702 { a: integer }
struct It3_702 { a: integer, b: integer, c: integer }
struct Mx702 { a: integer, s: text }

ITEMS702 = [It702 { a: 3, b: 4 }];
PAIR702 = [It702 { a: 3, b: 4 }, It702 { a: 5, b: 6 }];
ONE702 = [It1_702 { a: 3 }];
THREE702 = [It3_702 { a: 3, b: 4, c: 5 }];
UNORDERED702 = [It702 { b: 4, a: 3 }];
MIXED702 = [Mx702 { a: 3, s: "hi" }];
NUMS702 = [7, 8, 9];
WORDS702 = ["hi", "yo"];
FLOATS702 = [1.5, 2.5];

struct S2_702 { x: integer, v: vector<It702> }

fn build702() -> vector<It702> { [It702 { a: 3, b: 4 }] }

fn test() {
  // The filed shape: one two-field element.
  q = ITEMS702;
  assert(len(q) == 1, "one struct element: length, got {len(q)}");
  assert(q[0].a == 3 && q[0].b == 4, "one struct element: fields, got {q[0].a} {q[0].b}");

  // Two elements — the stride error piled them up.
  p = PAIR702;
  assert(len(p) == 2, "two elements: length, got {len(p)}");
  assert(p[0].a == 3 && p[0].b == 4, "two elements: first, got {p[0].a} {p[0].b}");
  assert(p[1].a == 5 && p[1].b == 6, "two elements: second, got {p[1].a} {p[1].b}");

  // One field — the width that happened to match, so this always read right.
  o = ONE702;
  assert(len(o) == 1 && o[0].a == 3, "one field: got {len(o)} {o[0].a}");

  // Three fields.
  t = THREE702;
  assert(len(t) == 1, "three fields: length, got {len(t)}");
  assert(t[0].a == 3 && t[0].b == 4 && t[0].c == 5,
         "three fields: values, got {t[0].a} {t[0].b} {t[0].c}");

  // Fields NAMED out of order — each write carries its own offset, not its position.
  u = UNORDERED702;
  assert(len(u) == 1 && u[0].a == 3 && u[0].b == 4,
         "out of order: got {len(u)} {u[0].a} {u[0].b}");

  // Mixed field types in one element.
  m = MIXED702;
  assert(len(m) == 1 && m[0].a == 3 && m[0].s == "hi",
         "mixed fields: got {len(m)} {m[0].a} {m[0].s}");

  // The constant copied INTO a struct field takes the same data.
  f = S2_702 { x: 2, v: ITEMS702 };
  assert(len(f.v) == 1, "into a field: length, got {len(f.v)}");
  assert(f.v[0].a == 3 && f.v[0].b == 4, "into a field: fields, got {f.v[0].a} {f.v[0].b}");

  // Referenced twice — a constant is inlined per use, so both reads see the same data.
  g = ITEMS702;
  assert(len(g) == 1 && g[0].b == 4, "second reference: got {len(g)} {g[0].b}");

  // Controls: the scalar element vectors, which never had a stride to get wrong.
  n = NUMS702;
  assert(len(n) == 3 && n[0] == 7 && n[2] == 9, "control: integers, got {len(n)}");
  w = WORDS702;
  assert(len(w) == 2 && w[0] == "hi" && w[1] == "yo", "control: text, got {len(w)}");
  fl = FLOATS702;
  assert(len(fl) == 2 && fl[0] == 1.5, "control: floats, got {len(fl)}");

  // Controls: the same value built as a local and from a call — neither goes via the
  // const store, and both always read correctly.
  lv: vector<It702> = [It702 { a: 3, b: 4 }];
  assert(len(lv) == 1 && lv[0].a == 3 && lv[0].b == 4, "control: a local literal");
  cv = build702();
  assert(len(cv) == 1 && cv[0].a == 3 && cv[0].b == 4, "control: a call result");

  println("702-const-vector-element-stride ok");
}
