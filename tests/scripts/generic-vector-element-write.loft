//
// `v[i] = x` inside a template writes what the concrete function writes.
//
// A generic's vector writes are re-emitted per monomorph, because the parametric IR
// copies a RECORD (`OpCopyRecord` with the type variable's record id) where a concrete
// `vector<integer>` stores an `i64` in place.  That rewriter matches the three-op
// sequence an APPEND emits — `OpNewRecord` / `OpCopyRecord` / `OpFinishRecord` — and an
// INDEXED assignment emits a lone `OpCopyRecord`, which nothing claimed.
//
// So the write spelling was the axis the corpus held fixed: `o += [x]` was covered for
// every type since P241, and `v[i] = x` was covered for none.  What it cost, on both
// backends and with no generics needed beyond the one template:
//
//   integer / float / single / boolean / character / enum
//                        the run PANICKED in the allocator, or walked a corrupt record
//                        edge — the copy read a scalar as an address
//   struct (a parameter) SILENTLY wrong: the write landed nowhere and the read gave the
//                        element that was already there
//
// The concrete twin emits `OpSetInt(OpGetVector(v, 8, 0), 0, x)` for the same source, so
// `(G-Mono)` says that is what the monomorph owes — and the fix routes through the one
// setter builder the append path already uses, rather than a second copy of it.
//
// Both spellings are swept here, and both vector ORIGINS (a parameter and a local built
// in the template), because the parameter shape is the one that failed silently while
// the local shape crashed — one axis apart, two different-looking defects.

enum Gwc { Red, Blue, Green }
struct Gws { a: integer }

pub fn ap_local<T>(x: T) -> T { o: vector<T> = []; o += [x]; o[0] }
pub fn ap_param<T>(v: vector<T>, x: T) -> T { v += [x]; v[2] }
// `seed` fills the local and `x` overwrites it, each used ONCE — appending the same
// value twice is the `avoidable-copy` shape, and a guard should not model what the
// language advises against.
pub fn ix_local<T>(seed: T, x: T) -> T { o: vector<T> = []; o += [seed]; o[0] = x; o[0] }
pub fn ix_param<T>(v: vector<T>, x: T) -> T { v[0] = x; v[0] }
// The write reached through a LOOP variable rather than a literal index — the shape a
// real generic algorithm uses, and the one where a wrong element size walks off the end.
pub fn ix_loop<T>(v: vector<T>, x: T) -> T { for i in 0..len(v) { v[i] = x; } v[1] }

// The twins for the two element kinds that failed differently: a scalar crashed, a
// struct answered the element that was already there.
fn twin_int(v: vector<integer>, x: integer) -> integer { v[0] = x; v[0] }
fn twin_struct(v: vector<Gws>, x: Gws) -> integer { v[0] = x; v[0].a }

fn test_an_indexed_write_lands_for_every_element_type() {
  // Every value is distinct from every element already in the vector, so a write that
  // does not land answers the OLD element rather than the new one — which is exactly how
  // the struct cell failed, and a cell asserting only "no crash" would have passed it.
  assert(ix_param([11, 12], -77) == -77, "integer: got {ix_param([11, 12], -77)}");
  assert(ix_param([9.5, 8.5], 1.25) == 1.25, "float: got {ix_param([9.5, 8.5], 1.25)}");
  assert(ix_param([9.5 as single, 8.5 as single], 1.25 as single) == 1.25 as single, "single");
  assert(ix_param([false, false], true) == true, "boolean: got {ix_param([false, false], true)}");
  assert(ix_param(['a', 'b'], 'q') == 'q', "character: got {ix_param(['a', 'b'], 'q')}");
  assert(ix_param(["aa", "bb"], "zz") == "zz", "text: got {ix_param(["aa", "bb"], "zz")}");
  assert(ix_param([Gwc::Blue, Gwc::Blue], Gwc::Green) == Gwc::Green,
         "enum: got {ix_param([Gwc::Blue, Gwc::Blue], Gwc::Green)}");
  assert(ix_param([Gws { a: 1 }, Gws { a: 2 }], Gws { a: -77 }).a == -77,
         "struct: got {ix_param([Gws { a: 1 }, Gws { a: 2 }], Gws { a: -77 }).a}");
}

fn test_the_monomorph_writes_what_the_twin_writes() {
  // `(G-Mono)` as an assertion rather than a claim — the specialised copy and the
  // hand-written function are given the same vector and must leave the same value.
  assert(ix_param([11, 12], -77) == twin_int([11, 12], -77), "integer vs twin");
  assert(ix_param([Gws { a: 1 }, Gws { a: 2 }], Gws { a: -77 }).a
         == twin_struct([Gws { a: 1 }, Gws { a: 2 }], Gws { a: -77 }), "struct vs twin");
}

fn test_a_local_vector_takes_an_indexed_write_too() {
  // The vector's ORIGIN is the second axis: a local built inside the template crashed
  // where a parameter answered wrongly, so both are asked.
  assert(ix_local(11, -77) == -77, "integer local: got {ix_local(11, -77)}");
  assert(ix_local(9.5, 1.25) == 1.25, "float local");
  assert(ix_local(false, true) == true, "boolean local: got {ix_local(false, true)}");
  assert(ix_local('a', 'q') == 'q', "character local: got {ix_local('a', 'q')}");
  assert(ix_local("aa", "zz") == "zz", "text local");
  assert(ix_local(Gwc::Blue, Gwc::Green) == Gwc::Green, "enum local: got {ix_local(Gwc::Blue, Gwc::Green)}");
  // The struct element is asked through `ix_param` above rather than here.  A template
  // that RETURNS a `T = struct` taken from a local vector leaks the returned store, and
  // that is a different defect: it reproduces with the indexed write removed entirely
  // (`o += [seed]; o[0]`), on a pre-fix binary as well.  Carrying it here would make this
  // guard fail for something it does not guard.
}

fn test_a_write_through_a_loop_variable() {
  // Reads the SECOND element, so a write that only ever reaches element 0 — the shape a
  // wrong element size produces — cannot pass.
  assert(ix_loop([11, 12], -77) == -77, "integer loop: got {ix_loop([11, 12], -77)}");
  assert(ix_loop([false, false], true) == true, "boolean loop: got {ix_loop([false, false], true)}");
  assert(ix_loop(['a', 'b'], 'q') == 'q', "character loop: got {ix_loop(['a', 'b'], 'q')}");
  assert(ix_loop(["aa", "bb"], "zz") == "zz", "text loop");
  assert(ix_loop([9.5, 8.5], 1.25) == 1.25, "float loop");
}

fn test_append_still_works() {
  // The control: append is what the rewriter always covered, and the indexed write is
  // added BESIDE it — the two share the setter builder, so a change to one can break the
  // other silently.
  assert(ap_local(-77) == -77, "integer append");
  assert(ap_local(1.25) == 1.25, "float append");
  assert(ap_local(true) == true, "boolean append");
  assert(ap_local('q') == 'q', "character append");
  assert(ap_local("zz") == "zz", "text append");
  assert(ap_local(Gwc::Green) == Gwc::Green, "enum append");
  assert(ap_param([11, 12], -77) == -77, "integer append to a parameter");
  assert(ap_param(["aa", "bb"], "zz") == "zz", "text append to a parameter");
  // The struct element goes through the PARAMETER vector for the same reason the local
  // indexed write does: returning a `T = struct` out of a template-LOCAL vector leaks
  // the returned store, whichever way the vector was filled.
  assert(ap_param([Gws { a: 1 }, Gws { a: 2 }], Gws { a: -77 }).a == -77,
         "struct append to a parameter");
}

fn main() {
  test_an_indexed_write_lands_for_every_element_type();
  test_the_monomorph_writes_what_the_twin_writes();
  test_a_local_vector_takes_an_indexed_write_too();
  test_a_write_through_a_loop_variable();
  test_append_still_works();
  print("generic-vector-element-write ok\n");
}
