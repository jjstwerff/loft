// SPDX-License-Identifier: LGPL-3.0-or-later
//
// `text_from_bytes(vector<u8>) -> text` — the inverse of `byte_at`.  Builds a
// text from raw UTF-8 bytes; every binary decoder (CBOR text, HPKE byte
// composition) needs it.  Both backends (interpreter via `loft_suite`, native
// via `native_scripts`).
//
// Invariants asserted:
//   - ASCII round-trips byte-for-byte to the text literal.
//   - Multi-byte UTF-8 (a 2-byte codepoint) decodes to the right text.
//   - `byte_at(text_from_bytes(v), i) == v[i]` — the round-trip with `byte_at`.
//   - The decoded length is bounded by the vector's LIVE length, not by the
//     trailing capacity slack a grown vector carries (min cap is 11 elements).
//   - Invalid UTF-8 yields the EMPTY text, never a crash (loft-safe).
//   - An empty vector yields the empty text.

fn main() {
  // "IETF" = 73 69 84 70 — pure ASCII.
  ietf: vector<u8> = []; ietf += [73 as u8, 69 as u8, 84 as u8, 70 as u8];
  s_ascii = text_from_bytes(ietf);
  assert(s_ascii == "IETF", "ASCII bytes decode to the text literal");
  assert(s_ascii.byte_at(0) == 73, "byte_at round-trip: v[0]");
  assert(s_ascii.byte_at(3) == 70, "byte_at round-trip: v[3]");

  // "héllo": h=104, é=195 169 (a 2-byte codepoint), l=108 l=108 o=111.
  hello: vector<u8> = [];
  hello += [104 as u8, 195 as u8, 169 as u8, 108 as u8, 108 as u8, 111 as u8];
  s_utf8 = text_from_bytes(hello);
  assert(s_utf8 == "héllo", "multi-byte UTF-8 decodes to the text literal");
  // byte 1 is the lead byte of the 2-byte 'é'.
  assert(s_utf8.byte_at(1) == 195, "byte_at round-trip: continuation lead byte");
  assert(s_utf8.byte_at(2) == 169, "byte_at round-trip: continuation byte");

  // Capacity-slack: a 1-byte vector carries an 11-element capacity buffer.  The
  // decode must read only the 1 LIVE byte (length at offset 4), not the slack.
  one: vector<u8> = []; one += [65 as u8]; // "A"
  s_one = text_from_bytes(one);
  assert(s_one == "A", "decode bounded by live length, not capacity slack");
  assert(s_one.len() == 1, "single live byte");

  // Invalid UTF-8: two lone continuation bytes (0x80) are not valid UTF-8.
  // Must return the empty text without crashing.
  bad: vector<u8> = []; bad += [128 as u8, 128 as u8];
  s_bad = text_from_bytes(bad);
  assert(s_bad == "", "invalid UTF-8 -> empty text (no crash)");
  assert(s_bad.len() == 0, "invalid UTF-8 -> zero-length text");

  // Empty vector -> empty text.
  empty: vector<u8> = [];
  assert(text_from_bytes(empty) == "", "empty vector -> empty text");

  println("391: text_from_bytes round-trip + edge coverage ok");
}
