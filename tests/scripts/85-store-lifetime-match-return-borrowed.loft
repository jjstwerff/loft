// @PLN85 cluster A — regression: a `match`-return whose arms return BORROWED
// parameters lowers to a value-position `if … else null` whose value-branch is
// an Insert (`clear(__retbuf); append(__retbuf, p); __retbuf`).  `infer_type`
// had no Insert case (returned None), so the sibling-Null typed-null handler in
// the native generator fell through and emitted the `null` else as `()`, which
// rustc rejects against the `DbRef` result — `--native` failed to compile
// (E0308) while `--interpret` was correct (a native-only divergence, cluster A
// row 102).  Fixed by teaching `infer_type` the Insert tail type (emit.rs).
fn pick(c: boolean, x: vector<integer>, y: vector<integer>) -> vector<integer> {
  match c { true => x, false => y }
}

fn main() {
  a = [10, 20];
  b = [30, 40];
  // the result is a COPY of the chosen borrowed source (value semantics)
  g = pick(true, a, b);
  g[0] = 999;
  assert(g[0] == 999, "result is mutable");
  assert(a[0] == 10, "borrowed source unaffected (value semantics)");
  // the other arm
  h = pick(false, a, b);
  assert(h[0] == 30, "false arm returns y");
  assert(b[0] == 30, "y source unaffected");
  println("match-return-borrowed ok");
}
