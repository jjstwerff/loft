//
// @TITLE A buffer-bound vector fn delivers EVERY return site, not only its tail
//
// A vector-returning function whose implicit tail BORROWS a visible argument
// (`Delivery::CopyBorrow`) routes through `copy_borrow_tail_into_retbuf`, which
// rewrites the tail alone.  A mid-body `return <fresh local>` in the same
// function was then left as a raw `return tmp` — so the caller adopted the
// buffer while the fresh local's store orphaned: one leaked store per
// undelivered return, values all correct.
//
// `Delivery::Rename` never had the hole (`ref_return` delivers the mid-body
// returns as well), which is exactly why it stayed invisible: the working
// member hid the omission.  Both CopyBorrow sub-shapes are guarded below — the
// whole-arg param tail and the struct-field tail (#415) — because they share
// the one funnel.
//
// The leak itself is caught by `tests/wrap.rs::run_test`'s exit-time
// "stores not freed" gate; this file asserts the VALUES stay right, so a fix
// that delivers into the buffer but drops or duplicates elements also fails.

struct Bag {
  items: vector<integer>,
}

// CopyBorrow sub-shape 1 — the tail borrows a whole vector argument.
fn pick(n: integer, other: vector<integer>) -> vector<integer> {
  if n <= 0 {
    tmp: vector<integer> = [7, 8, 9];
    return tmp;
  }
  other
}

// CopyBorrow sub-shape 2 — the tail borrows a struct FIELD of an argument.
fn pick_field(n: integer, b: Bag) -> vector<integer> {
  if n <= 0 {
    tmp: vector<integer> = [7, 8, 9];
    return tmp;
  }
  b.items
}

// Two mid-body fresh returns: pre-fix this leaked one store PER return, so the
// count — not just the presence — is guarded.
fn pick_two(n: integer, other: vector<integer>) -> vector<integer> {
  if n <= 0 {
    a: vector<integer> = [7, 8, 9];
    return a;
  }
  if n == 1 {
    b: vector<integer> = [1, 2, 3];
    return b;
  }
  other
}

// The mid-body return sits inside a loop rather than a bare `if`.
fn pick_loop(n: integer, other: vector<integer>) -> vector<integer> {
  for i in 0..3 {
    if i == n {
      tmp: vector<integer> = [4, 5];
      return tmp;
    }
  }
  other
}

fn main() {
  a = pick(0, [1, 2]);
  assert(len(a) == 3 && a[0] == 7 && a[1] == 8 && a[2] == 9, "fresh mid-body return delivers its elements");
  b = pick(5, [1, 2]);
  assert(len(b) == 2 && b[0] == 1 && b[1] == 2, "borrowed tail still copies the argument");

  g = Bag { items: [1, 2] };
  c = pick_field(0, g);
  assert(len(c) == 3 && c[0] == 7 && c[2] == 9, "field-tail shape delivers the mid-body return");
  d = pick_field(5, g);
  assert(len(d) == 2 && d[0] == 1 && d[1] == 2, "field tail still copies the field");

  e = pick_two(0, [1, 2]);
  assert(len(e) == 3 && e[0] == 7 && e[2] == 9, "first of two mid-body returns");
  f = pick_two(1, [1, 2]);
  assert(len(f) == 3 && f[0] == 1 && f[2] == 3, "second of two mid-body returns");
  h = pick_two(5, [1, 2]);
  assert(len(h) == 2 && h[0] == 1 && h[1] == 2, "tail past both mid-body returns");

  i = pick_loop(1, [9]);
  assert(len(i) == 2 && i[0] == 4 && i[1] == 5, "mid-body return from inside a loop");
  j = pick_loop(7, [9]);
  assert(len(j) == 1 && j[0] == 9, "loop falls through to the borrowed tail");

  // A caller loop re-passes the SAME fn-scoped buffer every iteration.  The
  // delivery clears the buffer before filling it (`vector_replace` = clear +
  // add), so results must not pile up across iterations.
  total = 0;
  for _i in 0..4 {
    r = pick(0, [1, 2]);
    total = total + len(r);
  }
  assert(total == 12, "caller loop: each iteration yields exactly 3 elements");

  println("ok");
}
