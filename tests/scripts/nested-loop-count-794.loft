//
// Regression (loft#794): a loop attribute (`#count` / `#first`) read from inside a
// NESTED loop was registered on the loop being parsed rather than the loop whose
// variable it names.
//
// The attribute's counter variable is minted on first READ, and a read of an OUTER
// loop's `#count` necessarily happens while the parser sits in an INNER loop, so the
// stamp landed on the wrong loop. It failed two different ways depending on how many
// attributes were live:
//
//   - ONE attribute (the outer one) — the inner loop took over the outer loop's counter
//     and incremented it once per INNER round. That compiled and ran, and answered the
//     wrong number: cases B and D below returned 6 and 2 instead of 3 and 3. This half
//     was filed as working.
//   - BOTH attributes — the second read displaced the first, leaving the inner loop's
//     own count var with no initialiser and no stack slot, and the compiler aborted with
//     an internal message naming a variable table ("Incorrect var q#count[65535]").
//
// So the loud half is the cheap one; the reason every cell below asserts a HAND-COMPUTED
// number rather than merely compiling is the quiet half.

fn test_nested_counts() {
  // A — the reported shape: BOTH counts live in the same inner body.
  //     p=0 matches q=0, p=1 matches q=1 => 2.
  a = 0;
  for p in [1, 2] { for q in [3, 4] { if q#count == p#count { a += 1 } } }
  assert(a == 2, "A both-counts-in-inner-body {a} want 2");

  // B — the OUTER count alone. Filed as working; it answered 6.
  //     p#count is 0 for three inner rounds, then 1 for three => 3.
  b = 0;
  for p in [1, 2] { for q in [1, 2, 3] { b += p#count } }
  assert(b == 3, "B outer-count-in-inner-body {b} want 3 (6 = inner loop drove it)");

  // C — the INNER count alone. The one shape the stamp never mislaid.
  //     (0+1+2) per outer round, twice => 6.
  c = 0;
  for p in [1, 2] { for q in [1, 2, 3] { c += q#count } }
  assert(c == 6, "C inner-count {c} want 6");

  // D — `#first` reads the same counter, so it broke the same way; it answered 2.
  //     True for the whole FIRST outer round: three inner rounds => 3.
  d = 0;
  for p in [1, 2] { for q in [1, 2, 3] { if p#first { d += 1 } } }
  assert(d == 3, "D outer-first-in-inner-body {d} want 3");

  // E — three levels, every count read at the deepest. Depth is its own axis: a fix
  //     that only looked one loop outward would pass A-D and fail here.
  //     Each level contributes 0 or 1 across 8 combinations => 4 per level, 12 total.
  e = 0;
  for x in [1, 2] { for y in [1, 2] { for z in [1, 2] { e += x#count + y#count + z#count } } }
  assert(e == 12, "E three-level {e} want 12");

  println("794 counts ok");
}

fn test_controls_and_order() {
  // F — CONTROL: the outer count read OUTSIDE the inner loop, where the parser is
  //     already in the right loop. Correct before the fix and must stay so.
  //     Inner adds 3 per outer round (6), plus p#count 0 then 1 => 7.
  f = 0;
  for p in [1, 2] { for q in [1, 2, 3] { f += 1 } f += p#count }
  assert(f == 7, "F outer-count-after-inner-loop {f} want 7");

  // G — CONTROL: a single loop. The unnested baseline the whole mechanism rests on.
  g = 0;
  for p in [1, 2, 3] { g += p#count }
  assert(g == 3, "G single-loop {g} want 3");

  // H — the two attributes read in the opposite ORDER. Which read comes first decided
  //     which loop was left without a counter, so both orders are the fault's two faces.
  h = 0;
  for p in [1, 2] { for q in [3, 4] { if p#count == q#count { h += 1 } } }
  assert(h == 2, "H reversed-read-order {h} want 2");

  // I — the outer count captured through LOCALS instead of read inline. Filed as a
  //     separate aborting cell; it is the same stamp reaching the same two vars.
  i = 0;
  for p in [1, 2] { for q in [3, 4] { m = p#count; n = q#count; if m == n { i += 1 } } }
  assert(i == 2, "I via-locals {i} want 2");

  println("794 ok");
}
