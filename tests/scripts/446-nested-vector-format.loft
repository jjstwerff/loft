// Nested-vector FORMAT (`{v}` interpolation) — the #483 family's display
// half, layout-independent.  Before the fix the format read the content id
// via the def-level known_type fallback (layout-coincident, #250's pattern)
// and stepped elements by the content row's own size — rendering
// `[?,null]` / dropping every element after the first, and under a shifted
// type table reading a null sentinel as a record id (SIGSEGV in
// ShowDb::write_list).

fn test_two_deep_format() {
  nf_two: vector<vector<integer>> = [];
  nf_two += [[7], [8, 9]];
  nf_s = "{nf_two}";
  assert(nf_s == "[[7],[8,9]]", "2-deep format: {nf_s}");
}

fn test_three_deep_format() {
  nf_three: vector<vector<vector<integer>>> = [];
  nf_three += [[[7], [8]]];
  nf_inner = "{nf_three[0]}";
  assert(nf_inner == "[[7],[8]]", "3-deep element format: {nf_inner}");
}
