//
// A function whose return paths disagree about OWNERSHIP orphaned the owning arm's store
// on the BORROWING path — one leaked record per call, unbounded in a loop.
//
// `fn pick(bx, take) -> P { if take { bx.p } else { P { x: 9 } } }` types as `P["bx"]` — a
// view — while the else arm mints its own store in a work-ref.  `collect_return_sources` is
// the UNION of the arms, so that work-ref lands in `return_sources` and its scope-exit free
// is suppressed on EVERY path; on the borrowing path nothing returns it and nothing frees
// it.  The suppression calls itself PATH-LOCAL and is, across separate `return` statements —
// a single `return` whose value is a JOIN is the case that argument does not cover.
//
// The cure is the leg two earlier shapes already use: hoist the value to `__ret_N` and emit
// `OpFreeRefIfDistinct(src, __ret_N)`, so the runtime decides.  On the arm that delivers the
// store the comparison matches and the free is a no-op; on the borrowing arm the stores
// differ and the orphan is released.
//
// The harness's leak check is what this file asserts; the values are here so a fix that
// silences the leak by freeing the DELIVERED store would fail too — that is the over-free
// this shape sits one step away from, and `alternating` exercises both arms in one run.

struct P1022 { x: integer }
struct Box1022 { p: P1022 }
struct VBox1022 { ps: vector<P1022> }

fn pick1022(bx: Box1022, take: boolean) -> P1022 {
  if take { bx.p } else { P1022 { x: 9 } }
}

// The owning arm as a NAMED local rather than an inline literal: the local is promoted onto
// the hidden return-buffer argument, which is the one argument a callee really owns.  This
// cell leaked on `--native` only.
fn pick_named1022(bx: Box1022, take: boolean) -> P1022 {
  q = P1022 { x: 9 };
  if take { bx.p } else { q }
}

fn pick_match1022(bx: Box1022, k: integer) -> P1022 {
  match k { 0 => bx.p, _ => P1022 { x: 9 } }
}

fn pick_velem1022(v: vector<P1022>, take: boolean) -> P1022 {
  if take { v[0] } else { P1022 { x: 9 } }
}

fn test_the_borrow_arm_does_not_orphan_the_owning_arms_buffer() {
  // The entry preamble allocates the buffer on EVERY call, so the leak appears even
  // though the owning arm never runs here.
  bx = Box1022 { p: P1022 { x: 1 } };
  t = 0;
  for i in 0..5 {
    b = pick1022(bx, i >= 0);
    t += b.x;
  }
  assert(t == 5, "five borrowing calls each read the field, got {t}");
}

fn test_a_single_borrowing_call_leaks_nothing_either() {
  // One call left one untyped store behind — the same orphan on a slot with no prior
  // type, not a second defect.
  bx = Box1022 { p: P1022 { x: 1 } };
  b = pick1022(bx, true);
  assert(b.x == 1, "a single borrowing call reads the field");
}

fn test_both_arms_in_one_run_deliver_their_own_value() {
  // The over-free neighbour: the arm that DOES deliver the buffer must keep it, so a
  // run that alternates has to answer each arm's own value.
  bx = Box1022 { p: P1022 { x: 1 } };
  s = "";
  for i in 0..6 {
    b = pick1022(bx, i % 2 == 0);
    s = "{s}{b.x},";
  }
  assert(s == "1,9,1,9,1,9,", "each arm answers its own value, got {s}");
}

fn test_a_named_owning_local_is_freed_on_the_borrowing_path() {
  bx = Box1022 { p: P1022 { x: 1 } };
  s = "";
  for i in 0..4 {
    b = pick_named1022(bx, i % 2 == 0);
    s = "{s}{b.x},";
  }
  assert(s == "1,9,1,9,", "the promoted-buffer form answers each arm, got {s}");
}

fn test_a_match_shaped_return_carries_the_same_disagreement() {
  bx = Box1022 { p: P1022 { x: 1 } };
  s = "";
  for i in 0..4 {
    b = pick_match1022(bx, i % 2);
    s = "{s}{b.x},";
  }
  assert(s == "1,9,1,9,", "the match form answers each arm, got {s}");
}

fn test_a_borrowed_vector_element_is_the_same_shape() {
  v: vector<P1022> = [P1022 { x: 1 }];
  t = 0;
  for i in 0..5 {
    b = pick_velem1022(v, i >= 0);
    t += b.x;
  }
  assert(t == 5, "an element borrow arm reads the element, got {t}");
}

fn test_the_cells_that_were_always_clean_stay_clean() {
  // The FRESH arm every time: the caller adopts and frees what it is given, so a fix
  // must not free it here as well.
  bx = Box1022 { p: P1022 { x: 1 } };
  t = 0;
  for i in 0..5 {
    b = pick1022(bx, i < 0);
    t += b.x;
  }
  assert(t == 45, "five owning calls each answer 9, got {t}");
  // A return that ONLY borrows has no buffer to orphan.
  o = 0;
  for i in 0..5 {
    b = only1022(bx);
    o += b.x + i;
  }
  assert(o == 15, "a pure borrow return still reads the field, got {o}");
  // A collection return has its own mature machinery and was never in this class.
  vb = VBox1022 { ps: [P1022 { x: 1 }] };
  c = 0;
  for i in 0..5 {
    w = pick_vec1022(vb, i >= 0);
    c += w[0].x;
  }
  assert(c == 5, "a vector-returning join still reads the element, got {c}");
}

fn only1022(bx: Box1022) -> P1022 { bx.p }

fn pick_vec1022(vb: VBox1022, take: boolean) -> vector<P1022> {
  if take { vb.ps } else { [P1022 { x: 9 }] }
}
