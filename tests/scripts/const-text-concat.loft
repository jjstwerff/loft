//
// Regression: a text constant corrupted the string it was interpolated into, and with
// enough constants panicked the parser outright.
//
// `GREET = "hello" + " world";` printed `hello world` followed by garbage, and
// `"[{B}]"` for `B = "x" + "y"` printed `xyxy]` — the `[` gone and the value doubled.
//
// A text initialiser builds its value IN PLACE in one buffer:
//
//     { OpClearText(w); OpAppendText(w, "x"); OpAppendText(w, "y"); w }
//
// and a constant is PASTED at each reference, that buffer's variable NUMBER included.
// The number only means what it says in the file-scope table where the constant was
// parsed.  Pasted into a function it names something else — inside a formatted string
// it landed on the format's own `__work_1`, so the block cleared the text being built,
// appended `x` and `y`, and the format then appended the buffer to itself: `xyxy]`.
// Past the end of the using function's table the same number panicked
// (`index out of bounds`), which is why three constants across three functions used to
// take the parser down.
//
// The fix re-points the pasted block onto a buffer the USING function owns
// (`rebind_constant_buffer`), so the numbering is valid wherever it lands; an
// all-literal initialiser is folded to a single literal first, which also stops it
// being rebuilt at every reference.  Vector constants never had this: they live in the
// const store and are REFERENCED (`OpConstRef`) rather than pasted.
//
// EACH CELL IS ITS OWN FUNCTION, and that is load-bearing rather than tidiness: the
// collision needs the constant's reference to be the FIRST buffer use in the function.
// An earlier version of this test put every assertion in `main`, which pushed each
// format past `__work_1` and made the whole file pass on the BROKEN binary — a guard
// that could not fail.  Keep one cell per function.

A = "plain";
B = "x" + "y";
C = "x" + "y" + "z";
E = B + "!";
GREET = "hello" + " world";
N = 5;
INTERP = "p{1 + 1}q";
NESTED = "p{N}q";

// The reported shape: the surrounding literal text must survive, and the value must
// appear exactly once.
fn c_two() -> text { "[{B}]" }
fn c_three() -> text { "[{C}]" }
fn c_greet() -> text { "[{GREET}]" }

// A constant built from another constant folds through.
fn c_built() -> text { "[{E}]" }

// TWO references in one format string — the paste happens per use, so a fix that
// repaired only the first would show here.
fn c_twice() -> text { "[{B}][{B}]" }

// Adjacent interpolations with literal text between them: one format, one buffer, so a
// surviving alias corrupts across the parts.
fn c_mixed() -> text { "<{A}|{B}|{C}>" }

// An initialiser that is NOT all-literal cannot fold, so it exercises the re-pointing
// path rather than the fold.  `INTERP` also used to panic when printed on its own.
fn c_interp() -> text { "[{INTERP}]" }
fn c_nested() -> text { "[{NESTED}]" }
fn c_interp_bare() -> text { INTERP }

// CONTROL: a plain literal constant was always fine — the fault needed the initialiser
// to build something, not merely to be text.
fn c_lit() -> text { "[{A}]" }

// CONTROL: reaching the constant through a local always worked, on every form.  A fix
// that only repaired the direct path would pass without these.
fn c_local() -> text { b = B; "[{b}]" }
fn c_local_interp() -> text { s = INTERP; "[{s}]" }

// CONTROL: outside a format string entirely.
fn c_bare() -> text { B }

fn main() {
  assert(c_two() == "[xy]", "concat in a format string: {c_two()}");
  assert(c_three() == "[xyz]", "three-way concat: {c_three()}");
  assert(c_greet() == "[hello world]", "the reported constant: {c_greet()}");
  assert(c_built() == "[xy!]", "constant built from a constant: {c_built()}");
  assert(c_twice() == "[xy][xy]", "two references in one format: {c_twice()}");
  assert(c_mixed() == "<plain|xy|xyz>", "mixed: {c_mixed()}");

  assert(c_interp() == "[p2q]", "interpolating constant: {c_interp()}");
  assert(c_nested() == "[p5q]", "constant interpolating a constant: {c_nested()}");
  assert(c_interp_bare() == "p2q", "interpolating constant alone: {c_interp_bare()}");

  assert(c_lit() == "[plain]", "literal-constant control: {c_lit()}");
  assert(c_local() == "[xy]", "via-a-local control: {c_local()}");
  assert(c_local_interp() == "[p2q]", "interpolating via a local: {c_local_interp()}");
  assert(c_bare() == "xy", "bare-value control: {c_bare()}");
  assert(len(c_bare()) == 2, "length: {len(c_bare())}");

  println("const-text-concat ok");
}
