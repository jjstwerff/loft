//
// Regression (GitHub #257): binding a `&`-reference parameter to a fresh local
// (`snap = s`, s: &Foo) used to panic codegen on both backends
// (gen_set_first_at_tos fallthrough: unsupported var type RefVar). The local is
// itself a RefVar; the fix copies the raw cell (interp) / a by-value record
// DbRef (native) so `snap` aliases the same record as `s`. Writes through the
// alias must reach the caller's struct, reads through both the alias and the
// original must agree, and the alias must be forwardable as a `&ref` argument.

struct Foo {
  a: integer,
  b: integer,
}

// write through the alias reaches the caller's record
fn set_a(s: &Foo) {
  snap = s; snap.a = 7;
}

// read through alias AND original, then write the sum back through the alias
fn mix(s: &Foo) {
  snap = s;
  snap.a = 7;
  r = snap.a + s.b;
  snap.b = r;
}

fn bump(s: &Foo) {
  s.a = s.a + 10;
}

// forward the alias onward as a `&ref` argument
fn forward(s: &Foo) {
  snap = s;
  bump(snap);
  snap.a = snap.a + 1;
}

fn main() {
  f = Foo { a: 0, b: 5 };
  set_a(f);
  assert(f.a == 7, "set_a: a={f.a} expect 7");

  g = Foo { a: 0, b: 5 };
  mix(g);
  assert(g.a == 7 && g.b == 12, "mix: a={g.a} b={g.b} expect 7,12");

  h = Foo { a: 0, b: 0 };
  forward(h);
  assert(h.a == 11, "forward: a={h.a} expect 11");

  println("ref-alias-copy ok");
}
