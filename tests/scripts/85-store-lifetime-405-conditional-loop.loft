//
// @PLN85 cluster II — regression guard for #405 (graduated from probes/04).
// A vector-returning fn called in NESTED loops with a CONDITIONAL, mostly-UNUSED
// assignment (`if i==t { x = ki; }`). Before the fix the interpreter SIGSEGV'd:
// gen_if's null-else gate keyed on the true-branch RETURN TYPE (non-Void) instead
// of the actual STACK DELTA, so a block ending in OpAppendVector (which pushes
// nothing) got a spurious ConstInt(i64::MIN) on the else path — 8 leaked stack
// bytes per false-branch iteration → stale DbRef → crash at OpFreeRef.
// Fix: gate null-else on `true_stack != stack_pos`. Guards: no crash, correct
// total, no leak, BOTH backends.

fn enc(n: integer) -> vector<u8> {
  b: vector<u8> = []; b += [(n&255) as u8]; return b;
}

fn main() {
  for t in 0..2 {
    for i in 0..2 {
      ki = enc(i);
      if i == t { x = ki; } // conditional + unused: the #405 trigger
    }
  }
  total = 0;
  for t in 0..50 {
    for i in 0..50 {
      ki = enc(i);
      if i == t {
        x = ki; total += len(x);
      }
    }
  }
  assert(total == 50, "405 conditional-loop: total must be 50 (got crash/garbage before fix)");
}
