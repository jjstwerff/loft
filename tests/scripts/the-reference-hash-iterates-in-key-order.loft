//
// A hash iterates in ascending key order, and that order is not its insertion order.
//
// The Hash chapter teaches the rule in one sentence and shows it on one collection.  It stops
// there on purpose: the page is read by someone meeting keyed collections for the first time,
// and the reader's question is "can I loop it and get a predictable order?", not "what does a
// two-field key do when the first fields tie?".
//
// This is where the rest of that promise is pinned.  It is worth pinning completely because the
// chapter's own example cannot see it: summing the values over a hash gives the same answer in
// every order, so the assert that looks like it tests the iteration order is blind to it.  A
// reader who needs deterministic output — a report, a serialised file, a diff between two runs —
// is relying on this and has nothing else that checks it.
//
// @falsified-at: none — this guard states where a boundary IS.  The ordering has held for as
//   long as the corpus records, so there is no build on which it fails, which makes it a LOCK
//   rather than a regression test.  Its value runs the other way: it fails the day the snapshot
//   stops being sorted, or sorts a multi-field key by something other than field order, and the
//   Hash chapter's sentence silently stops being true.

struct Count { t: text, v: integer }
struct Counting { entries: vector<Count>, lookup: hash<Count[t]> }

struct Pair { a: text, b: integer, v: integer }
struct Box { h: hash<Pair[a, b]> }

fn iteration_order_is_the_key_order_not_the_insertion_order() {
  c = Counting { };
  // Inserted deliberately out of alphabetical order, so the two orders cannot coincide.
  c.entries = [ {t: "One", v: 1}, {t: "Two", v: 2}, {t: "Three", v: 3}, {t: "Four", v: 4} ];
  keyed = "";
  for e in c.lookup { keyed += "{e.t} "; }
  assert(keyed == "Four One Three Two ", "hash iterates by key: {keyed}");
  inserted = "";
  for e in c.entries { inserted += "{e.t} "; }
  assert(inserted == "One Two Three Four ", "the vector keeps insertion order: {inserted}");
  // The pair is the whole point of the companion vector, so the two must differ here.
  assert(keyed != inserted, "the two orders must not coincide, or this file proves nothing");
}

fn a_multi_field_key_sorts_by_field_order() {
  x = Box { };
  x.h = [ {a: "b", b: 2, v: 1}, {a: "a", b: 2, v: 2}, {a: "b", b: 1, v: 3}, {a: "a", b: 1, v: 4} ];
  ord = "";
  for e in x.h { ord += "{e.a}{e.b} "; }
  // First field first, second only where the first ties -- not the other way round, and not
  // the insertion order, which would read "b2 a2 b1 a1".
  assert(ord == "a1 a2 b1 b2 ", "multi-field key sorts lexicographically: {ord}");
  assert(x.h["a", 2].v == 2, "a multi-field lookup takes the fields in order");
}

fn the_loop_variable_carries_index_count_and_first() {
  c = Counting { };
  c.entries = [ {t: "One", v: 1}, {t: "Two", v: 2}, {t: "Three", v: 3} ];
  seen = "";
  firsts = 0;
  for e in c.lookup {
    seen += "{e#index}{e#count}";
    if e#first { firsts += 1; }
  }
  // `#index` and `#count` both run 0,1,2 over a hash, so the pairs read 00 11 22.
  assert(seen == "001122", "index and count advance together: {seen}");
  assert(firsts == 1, "#first is true exactly once: {firsts}");
}

fn removing_an_absent_key_leaves_the_rest_alone() {
  c = Counting { };
  c.entries = [ {t: "One", v: 1}, {t: "Two", v: 2} ];
  c.lookup["nope"] = null;
  assert(c.lookup["One"].v == 1, "an absent-key removal leaves One");
  assert(c.lookup["Two"].v == 2, "an absent-key removal leaves Two");
  // And a present-key removal takes exactly one entry.
  c.lookup["One"] = null;
  assert(!c.lookup["One"], "One is gone");
  assert(c.lookup["Two"].v == 2, "Two survives its sibling's removal");
}

fn main() {
  iteration_order_is_the_key_order_not_the_insertion_order();
  a_multi_field_key_sorts_by_field_order();
  the_loop_variable_carries_index_count_and_first();
  removing_an_absent_key_leaves_the_rest_alone();
  print("hash guard: all cells passed\n");
}
