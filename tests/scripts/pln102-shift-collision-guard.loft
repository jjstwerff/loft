// @PLN102 null-model keystone, step 3 (D-op-null-2) — a shift that goes out of
// range [0,64) or whose result is the reserved i64::MIN null sentinel yields
// NULL (loudly, via raise_recoverable), not a silently-masked wrong value.
// Guards default/01_code.loft OpSLeftInt/OpSRightInt.
fn main() {
  assert((1<<63 ?? -1) == -1, "1<<63 (result is reserved sentinel) -> null");
  assert((1<<100 ?? -1) == -1, "1<<100 (amount >= 64) -> null, not masked");
  assert((1<< - 1 ?? -1) == -1, "1<<-1 (negative amount) -> null");
  assert((256>>100 ?? -1) == -1, ">> amount >= 64 -> null");
  // valid shifts unchanged
  assert((1<<10) == 1024, "valid <<");
  assert((1024>>2) == 256, "valid >>");
  assert((1<<62) == 4611686018427387904, "1<<62 (top valid bit) works");
  print("shift-collision-guard ok\n");
}
