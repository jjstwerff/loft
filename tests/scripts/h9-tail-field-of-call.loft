//
// Regression: `fn get() -> Inner { mk().inn }` returned a ref into a freed
// store (moros H9).
//
// The inline call is lifted to a `__lift_N` temp that the function frees on the
// way out, so projecting a field of it and returning that as the IMPLICIT tail
// hands the caller a dangling ref.  Native discarded it and returned null;
// the interpreter read the stale bytes and only LOOKED right — which is how the
// consumer met it as a SIGSEGV instead of a wrong value (a World returned this
// way reached `length_vector` with a garbage DbRef).
//
// The EXPLICIT `return mk().inn` already copied the field into the return
// buffer (#425); `classify_reference_delivery` now makes the implicit tail do
// the same.  Every cell below must agree on BOTH backends.

struct Inner { n: integer, items: vector<integer> }
struct Outer { code: integer, inn: Inner }

fn mk() -> Outer {
  Outer { code: 1, inn: Inner { n: 7, items: [1, 2, 3] } }
}

// The failing shape: an implicit tail projecting a field of a call temp.
fn tail_field_of_call() -> Inner { mk().inn }

// The shapes that already worked — they must keep working.
fn via_named_local() -> Inner { o = mk(); o.inn }
fn via_bound_field() -> Inner { t = mk().inn; t }
fn via_explicit_return() -> Inner { return mk().inn; }

fn read_n(i: Inner) -> integer { i.n }

fn test_implicit_tail_field_of_call() {
  x = tail_field_of_call();
  assert(x.n == 7, "implicit tail: n={x.n} expect 7");
  assert(len(x.items) == 3, "implicit tail: len={len(x.items)} expect 3");
}

// Passing it straight into another call is how the consumer hit it — the value
// had to survive the callee's frame, not just the assignment.
fn test_passed_straight_to_a_call() {
  assert(read_n(tail_field_of_call()) == 7, "passed on: {read_n(tail_field_of_call())} expect 7");
}

fn test_the_shapes_that_already_worked() {
  assert(via_named_local().n == 7, "named local: {via_named_local().n} expect 7");
  assert(via_bound_field().n == 7, "bound field: {via_bound_field().n} expect 7");
  assert(via_explicit_return().n == 7, "explicit return: {via_explicit_return().n} expect 7");
}

// The copy must be a real copy: mutating the result cannot reach back into
// anything the callee still owns, and a second call must be independent.
fn test_two_results_are_independent() {
  a = tail_field_of_call();
  b = tail_field_of_call();
  a.n = 99;
  assert(b.n == 7, "independence: b.n={b.n} expect 7");
}

fn main() {
  test_implicit_tail_field_of_call();
  test_passed_straight_to_a_call();
  test_the_shapes_that_already_worked();
  test_two_results_are_independent();
  println("h9-tail-field-of-call ok");
}
