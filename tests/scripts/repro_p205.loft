// P205 minimal reproducer — bounded-generic function returning `text`
// emits `Str::new(&local_String)` in native specialised codegen.  The
// local String drops at function return, leaving the returned Str's
// pointer dangling.  Comparison fails at runtime.
// Native FAILS, interpreter PASSES.
// See doc/claude/PROBLEMS.md § 205.  CLOSED 2026-05-02 by plan-09
// phase 07: src/generation/emit.rs routes generic-text returns
// through stores.scratch when the function lacks a
// Type::RefVar(Type::Text(_)) attribute.  EXPECT_FAIL marker
// removed alongside the plan-11 P204 closure (which removed its
// own marker the same day).
interface P205Labelable {
  fn p205_to_label(self: Self) -> text
}

struct P205_S {
  p205_name: text,
}
fn p205_to_label(self: P205_S) -> text {
  return self.p205_name;
}

fn p205_label < T: P205Labelable > (p205_x: T) -> text {
  return p205_x.p205_to_label();
}

fn p205_generic_text_return_dangles() {
  p205_s = P205_S { p205_name: "widget" };
  assert(p205_label(p205_s) == "widget", "p205: generic text return");
}
