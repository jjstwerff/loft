//
// A returned value that VIEWS another local must be copied into the caller's buffer, not
// renamed onto it — whether the view is written at the return or bound to a name first
// (loft#1101).
//
// `fn f() -> vector<integer> { vv = [[11, 22, 33], [44, 55]]; e = vv[0]; e }` handed back a
// view into `vv`, which the callee frees on the way out.  The promotion ladder's rename says
// *this local IS the return buffer*, which is an ownership claim (@FR-O-Move); for a view the
// owner is the base local, so the caller was left holding a freed store.  Writing the same
// projection AS the tail (`vv[0]`) was always correct, because the gates on that path read the
// tail's SHAPE.  Once the projection happens at a binding the tail is a bare `Var` and the fact
// that it points into a local lives in the binding's DEPS instead.
//
// Two facts answer it, and each covers what the other cannot:
//
//   * the DEP list, read the way `formal/ownership.md` sharpens @FR-O-Proxy — a list carries
//     three meanings, not two: empty (no store yet), a dep on the binding's own mint
//     (`__vdb_N`: it owns one), and a dep on ANOTHER LOCAL (it borrows that one).  Bare
//     non-emptiness is the reading that called a view fresh-owned.  Skipping the mint is also
//     what makes the verdict agree on BOTH parser passes — the mint dep appears on pass 2
//     only, a borrow dep on both — and this verdict decides whether the function takes a
//     hidden buffer argument, so a verdict that moved would move the ABI with it;
//   * the DEFINING STATEMENT, for the one shape no dep records: a read out of an inline
//     call's result borrows a `__lift_N` temp, and the container dep is recorded at the
//     SUBSCRIPT only.  `e = mk().items; e` therefore carried an EMPTY dep list while
//     `OpFreeRef(__lift_1)` freed what it pointed at two statements later.
//
// Every cell CHURNS between the call and the read.  Without that the freed record is still
// intact and reads correctly, which is what kept these shapes looking clean: the tuple cell
// answered `len=4 r0=39` — churn's data — only once the store had been recycled, and the
// inline-call cell diverged, answering stale-but-right interpreted and empty on `--native`.

struct Bag1101 { items: vector<integer>, n: integer }

fn mk1101() -> Bag1101 { Bag1101 { items: [7, 8, 9], n: 1 } }

// Recycles the store the callee freed, so a dangling view reads somebody else's bytes
// instead of its own.  40 rounds is comfortably past the first reuse.
fn churn1101() -> integer {
  n = 0;
  for i in 0..40 { h: vector<integer> = [i, i + 1, i + 2, i + 3]; n = n + len(h); }
  n
}

fn elem_bind() -> vector<integer> { vv = [[11, 22, 33], [44, 55]]; e = vv[0]; e }
fn elem_return() -> vector<integer> { vv = [[11, 22, 33], [44, 55]]; e = vv[0]; return e; }
fn tuple_bind() -> vector<integer> { v = [11, 22, 33]; t = (v, 7); e = t.0; e }
fn lift_bind() -> vector<integer> { e = mk1101().items; e }
fn lift_return() -> vector<integer> { e = mk1101().items; return e; }
fn arm_bind(k: integer) -> vector<integer> {
  vv = [[11, 22, 33], [44, 55]];
  if k > 0 { e = vv[0]; e } else { [99] }
}
fn nullable_bind(k: integer) -> vector<integer>? {
  if k < 0 { null } else { vv = [[11, 22, 33], [44, 55]]; e = vv[0]; e }
}

// The reported shape.  `len` alone is not enough to score it: the tuple spelling answered a
// length of 4 out of recycled memory, so the ELEMENT is asserted too.
fn test_an_element_projection_bound_to_a_local_survives_the_return() {
  r = elem_bind();
  churn1101();
  assert(len(r) == 3, "the viewed element holds three values, got {len(r)}");
  assert(r[0] == 11, "and they are its own, got {r[0] ?? -1}");
}

fn test_a_tuple_element_bound_to_a_local_survives_the_return() {
  r = tuple_bind();
  churn1101();
  assert(len(r) == 3, "the tuple's vector holds three values, got {len(r)}");
  assert(r[0] == 11, "and they are its own, got {r[0] ?? -1}");
}

// The explicit spelling reaches a different classifier, which read the same dep list as
// "fresh-owned" and handed the promotion the local's BORROW SOURCE: `vv`, a
// `vector<vector<integer>>`, was renamed onto the `vector<integer>`-shaped buffer.  It
// answered the right length while leaking the store it abandoned, one per call — so this
// cell is scored by the value AND by the wrap harness's leak gate.
fn test_the_explicit_return_spelling_agrees_with_the_implicit_one() {
  r = elem_return();
  churn1101();
  assert(len(r) == 3, "the same view, returned explicitly, got {len(r)}");
  assert(r[0] == 11, "and holding its own values, got {r[0] ?? -1}");
}

// Repeated so a leak of one store per call has somewhere to accumulate.
fn test_the_explicit_return_spelling_leaks_nothing() {
  t = 0;
  k = 0;
  while k < 8 { t += len(elem_return()); k += 1; }
  assert(t == 24, "eight calls of three elements, got {t}");
}

// No dep records this borrow, so the dep list reads EMPTY and only the defining statement
// says the value points into `__lift_1`.  The interpreter read the freed bytes and looked
// right; `--native` answered an empty vector.
fn test_a_projection_of_an_inline_call_result_survives_the_return() {
  r = lift_bind();
  churn1101();
  assert(len(r) == 3, "the lifted container's field holds three values, got {len(r)}");
  assert(r[0] == 7, "and they are its own, got {r[0] ?? -1}");
}

fn test_the_inline_call_projection_returns_explicitly_too() {
  r = lift_return();
  churn1101();
  assert(len(r) == 3, "the same lifted field, returned explicitly, got {len(r)}");
  assert(r[0] == 7, "and holding its own values, got {r[0] ?? -1}");
}

// A branch ARM that binds the view: the arm's block reaches the same tail handling, so it
// carried the same fault, and its sibling literal arm must stay untouched.
fn test_a_branch_arm_that_binds_a_view_delivers_it() {
  r = arm_bind(1);
  churn1101();
  assert(len(r) == 3, "the taken arm's view holds three values, got {len(r)}");
  assert(r[0] == 11, "and they are its own, got {r[0] ?? -1}");

  other = arm_bind(0);
  churn1101();
  assert(len(other) == 1, "the literal arm is one element, got {len(other)}");
  assert(other[0] == 99, "and it is the literal's, got {other[0] ?? -1}");
}

// The nullable return additionally raised an internal `BUG (#306): refused to free the stack
// store` — the renamed buffer reached a free that only a real store may take.  Both halves
// are asserted: the value arm delivers, and the null arm still answers the sentinel.
fn test_a_nullable_collection_return_delivers_its_viewing_arm() {
  r = nullable_bind(1) ?? [];
  churn1101();
  assert(len(r) == 3, "the value arm's view holds three values, got {len(r)}");
  assert(r[0] == 11, "and they are its own, got {r[0] ?? -1}");
}

fn test_the_nullable_null_arm_still_answers_null() {
  assert(nullable_bind(-1) == null, "the null arm answers the sentinel, not an empty vector");
}

// ---- controls: shapes that were already correct and must keep their delivery ----

// The projection written AS the tail.  It is the spelling the tail gates already copied, and
// it is what says this fix is about WHERE the projection is written, not about projections.
fn tail_proj() -> vector<integer> { vv = [[11, 22, 33], [44, 55]]; vv[0] }

fn test_the_tail_projection_is_untouched() {
  r = tail_proj();
  churn1101();
  assert(len(r) == 3, "the tail projection still delivers three, got {len(r)}");
  assert(r[0] == 11, "and its own values, got {r[0] ?? -1}");
}

// An OWNED local must keep its rename — that is the NRVO the design wants, and refusing it
// here is the over-fire a dep list read as bare non-emptiness would produce.
fn owned_literal() -> vector<integer> { l = [11, 22, 33]; l }
fn owned_build() -> vector<integer> { o: vector<integer> = []; o += [11]; o += [22]; o }

fn test_an_owned_local_keeps_its_delivery() {
  a = owned_literal();
  churn1101();
  assert(len(a) == 3, "the owned literal delivers three, got {len(a)}");
  assert(a[0] == 11, "holding its own values, got {a[0] ?? -1}");

  b = owned_build();
  churn1101();
  assert(len(b) == 2, "the built vector delivers two, got {len(b)}");
  assert(b[0] == 11, "holding its own values, got {b[0] ?? -1}");
}

// The issue's documented workaround.  It must stay correct, because a consumer told to write
// it is entitled to it whether or not the underlying shape is fixed.
fn copy_out() -> vector<integer> {
  vv = [[11, 22, 33], [44, 55]];
  o: vector<integer> = [];
  o += vv[0];
  o
}

fn test_the_copy_out_workaround_still_works() {
  r = copy_out();
  churn1101();
  assert(len(r) == 3, "the explicit copy holds three, got {len(r)}");
  assert(r[0] == 11, "and its own values, got {r[0] ?? -1}");
}

// An ARGUMENT-rooted projection is deliberately NOT this defect: the CALLER owns that store,
// so the view outlives the call and the delivery machinery gives it value semantics already.
// Refusing its rename too would be the wider cut.
fn arg_rooted(v: vector<vector<integer>>) -> vector<integer> { e = v[0]; e }

fn test_an_argument_rooted_projection_is_untouched() {
  src = [[11, 22, 33], [44, 55]];
  r = arg_rooted(src);
  churn1101();
  assert(len(r) == 3, "the argument's element holds three, got {len(r)}");
  assert(r[0] == 11, "and its own values, got {r[0] ?? -1}");
  assert(len(src) == 2, "and the caller's container is intact, got {len(src)}");
}

// A binding of a binding: `f = e` COPIES, so `f` owns its store and must keep delivering.
// It is the cell that says the fix reads what a binding BORROWS and not merely that a
// binding has a dep.
fn chain_bind() -> vector<integer> { vv = [[11, 22, 33], [44, 55]]; e = vv[0]; f = e; f }

fn test_a_copied_rebinding_still_delivers() {
  r = chain_bind();
  churn1101();
  assert(len(r) == 3, "the copied rebinding holds three, got {len(r)}");
  assert(r[0] == 11, "and its own values, got {r[0] ?? -1}");
}

// The RECORD twin, which reaches its own view repair through `return_views_local` (#306) and
// must be untouched by a vector-side change.
struct Inner1101 { k: integer }
struct Outer1101 { inn: Inner1101, n: integer }

fn ref_twin() -> Inner1101 { o = Outer1101 { inn: Inner1101 { k: 42 }, n: 1 }; e = o.inn; e }

fn test_the_record_view_return_is_untouched() {
  r = ref_twin();
  churn1101();
  assert(r.k == 42, "the record view still carries its field, got {r.k}");
}
