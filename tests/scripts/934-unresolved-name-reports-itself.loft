//
// loft#934 — an unresolvable CamelCase name in VALUE position reports itself.
//
// loft gives variables and functions `lower_case` names, so pass 1 treats a CamelCase
// name it cannot resolve as a forward reference to a TYPE and leaves a speculative stub
// behind (`objects.rs`).  Every consumer of a stub nothing adopted reports it — `Zzz {…}`
// says "unknown type", `Zzz.x` says "Field of unknown variable", `y: Zzz` and
// `sizeof(Zzz)` say "Undefined type" — except one: a bare VALUE use had no reporter at
// all, because on pass 2 the stub EXISTS, so the "Unknown variable" branch a lowercase
// name reaches was never entered.
//
// What that silence bought, before this fix:
//
//   fn f() -> integer { Zzz }   ran, and answered uninitialised memory (95490007900132)
//                               under `--interpret` and 0 under `--native`
//   if Zzz { … } else { … }     ran, silently took the else arm under `--interpret`, and
//                               handed the user a raw rustc `expected bool, found ()`
//                               under `--native`
//   y = Zzz                     ran under `--interpret`; ICEd `--native` ("Incorrect type
//                               Never")
//   println("{Zzz}")            ran on both backends and printed nothing
//
// Where a report DID escape, it was the cascade rather than the cause: `v > PEUnknown`
// said only *"missing argument for parameter 'v1' of `OpLtInt`"*, naming an internal
// opcode, a parameter the program never wrote, and a cure ("give the parameter a
// default") that cannot be applied to a builtin operator.  That is the shape the issue
// was filed from; it is pinned in `36-parse-errors.loft` beside its siblings.
//
// Each fn below is one value position.  The point of the file is that the count matches:
// ONE report per fn, naming the name the author wrote, with no cascade behind it —
// `@EXPECT_ERROR` is fatal when unmatched (loft#929), so a regression that re-silences a
// row fails here rather than passing quietly.
//
// Pass 2 only: `Parser::parse` runs pass 2 only when pass 1 finished clean, so a single
// pass-1 error anywhere in this file would silence every annotation in it and they would
// assert nothing.  Nothing here may report during pass 1.

// ── The bare value: the position that had no reporter ────────────────────────

// @EXPECT_ERROR: Unknown variable 'PeBare'
fn pe_bare_value() {
  y = PeBare;
  println("{y}");
}

// The one that returned uninitialised memory rather than refusing.
// @EXPECT_ERROR: Unknown variable 'PeReturn'
fn pe_return_position() -> integer {
  PeReturn
}

// The one `--native` could not compile, reported as a rustc type error against generated
// code the author never saw.
// @EXPECT_ERROR: Unknown variable 'PeCond'
fn pe_if_condition() {
  if PeCond {
    println("taken");
  } else {
    println("not taken");
  }
}

// The one that printed an empty placeholder on both backends.
// @EXPECT_ERROR: Unknown variable 'PeInterp'
fn pe_interpolated() {
  println("v={PeInterp}");
}

// ── The positions that reported, but named an opcode instead of the name ─────

// @EXPECT_ERROR: Unknown variable 'PeArith'
fn pe_arithmetic() {
  x = 1 + PeArith;
  println("{x}");
}

fn pe_takes(a: integer) {
  println("{a}");
}

// @EXPECT_ERROR: Unknown variable 'PeCallArg'
fn pe_call_argument() {
  pe_takes(PeCallArg);
}

// @EXPECT_ERROR: Unknown variable 'PeIndex'
fn pe_index_expression() {
  v = [1, 2];
  println("{v[PeIndex]}");
}

// An ANNOTATED target earned a second line too — "cannot change type from integer to
// never".  `never` is the poison an already-reported expression leaves behind, not a type
// anyone can write, so that message advertised `as never` as the cure.  It is suppressed
// for the same reason the opcode arity line is, and the identical shape spelled with a
// lowercase name (`y: integer = qqq`) had it as well.
// @EXPECT_ERROR: Unknown variable 'PeAnnotated'
fn pe_annotated_target() {
  y: integer = PeAnnotated;
  println("{y}");
}

// ── The suggestion still fires, so the cure stays reachable ──────────────────

struct PeNearMiss {
  n: integer,
}

// @EXPECT_ERROR: Unknown variable 'PeNearMis' — did you mean 'PeNearMiss'?
fn pe_suggests_the_near_name() {
  y = PeNearMis;
  println("{y}");
}

// ── Controls: the reporters that already worked must not double up ───────────
//
// Each of these has its OWN report, and the bare-value site must stay quiet for it or the
// author gets one typo and two errors.  They are here so a fix that widens the new report
// past a bare value fails.

// @EXPECT_ERROR: unknown type 'PeConstructed'
fn pe_construction_still_reports() {
  y = PeConstructed { a: 1 };
  println("{y}");
}

// @EXPECT_ERROR: Undefined type PeSized — sizeof needs a variable or a declared type
fn pe_sizeof_still_reports() {
  println("{sizeof(PeSized)}");
}

// (The written-annotation reporter `y: PeAnnotation = null` and the genuine-retype control
// are PASS-1 diagnostics, so they cannot share this file — they would abort before pass 2
// and silence every annotation above.  They live in `934b-unresolved-name-pass1.loft`.)

// A genuine too-few-arguments call still reports.  Suppressing the arity check for an
// already-errored slot must not suppress it for an OMITTED one — the two arrive at that
// check identically (`Value::Null` in the slot), and only the argument's TYPE tells them
// apart.
fn pe_needs_two(a: integer, b: integer) {
  println("{a} {b}");
}

// @EXPECT_ERROR: missing argument for parameter 'b' of `pe_needs_two`
fn pe_real_missing_argument() {
  pe_needs_two(1);
}

// ── Control: a real forward reference must stay silent ───────────────────────
//
// The report fires only for a stub NOTHING adopted.  A CamelCase name declared lower in
// the file leaves the same pass-1 stub, and its declaration adopts it — this fn must
// compile clean, or the fix has broken forward references.

fn pe_forward_reference_is_fine() {
  s = PeLater { a: 7 };
  println("{s.a}");
}

struct PeLater {
  a: integer,
}
