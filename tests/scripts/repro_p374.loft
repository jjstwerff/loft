//
// @P374 regression (dryopea-surfaced) — `return (a, b);` whose declared
// return type is a tuple of struct types must type-check identically to a
// final-expression tuple of the same shape.  Before the fix, the explicit
// `return` path skipped block_result's tuple→synthetic-struct rewrite and
// failed with "expected __tuple<…>, got (…)".

struct A { x: integer }
struct B { y: integer }

fn early_return(flag: boolean) -> (A, B) {
  if flag { return (A { x: 1 }, B { y: 2 }); }
  (A { x: 0 }, B { y: 0 })
}

fn main() {
  t = early_return(true);
  assert(t.0.x == 1, "early-return tuple .0");
  assert(t.1.y == 2, "early-return tuple .1");
  f = early_return(false);
  assert(f.0.x == 0, "fallthrough tuple .0");
  assert(f.1.y == 0, "fallthrough tuple .1");
  print("ok");
}
