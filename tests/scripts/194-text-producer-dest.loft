// @PLN10 (retire `stores.scratch`) — non-text-method producers ride the chokepoint.
//
// Build-3: the always-non-null text producers (json `kind` / `to_json` /
// `to_json_pretty` / `json_errors`, and `source_dir`) gained `_dest` variants and
// were added to `is_text_dest_native`, so the Build-2 synth-temp chokepoint routes
// their value-position calls away from `stores.scratch`.  Locks correctness on
// every backend.
fn took(s: text) -> integer {
  len(s)
}

fn main() {
  j = json_parse("42");

  // value position: argument
  assert(took(j.to_json()) == 2, "to_json arg");

  // value position: comparison (@PLN109 — `42` is now a JInteger, not JNumber)
  assert(j.kind() == "JInteger", "kind compare");

  // value position: format interpolation (two producers in one buffer)
  assert("[{j.to_json()}|{j.kind()}]" == "[42|JInteger]", "json format");

  // value position: concat
  assert(j.to_json()+"!" == "42!", "to_json concat");

  // value position: pretty (primitive == canonical today)
  assert(j.to_json_pretty() == "42", "to_json_pretty");

  // source_dir in value position — exercise the path (non-empty on interp/native)
  assert(took(source_dir()) >= 0, "source_dir arg path");

  // loop, value position — no accumulation across iterations
  for _ in 0..3 { assert(j.kind() == "JInteger", "kind loop no-accumulate"); }

  println("text-producer dest: all shapes ok");
}
