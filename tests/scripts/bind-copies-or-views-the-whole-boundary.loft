// WHERE a bind copies and where it views — the whole boundary, in one file.
//
// The cells existed, scattered: `294-vector-element-view-semantics` (index reads),
// `85-store-lifetime-reference-default-views` (#426's resolution),
// `reference-tuple-heap-element-through-a-record` (tuple elements), plus the C86 field cells.
// No single place said what the RULE is, and `formal/binding.md` states three of the five
// clauses — which cost three separate false readings of correct behaviour as a bug in one week
// (D-bind-12's collection half; a nested field read; a vector index read).  This file is the
// answer to "does THIS bind copy?", and every cell is measured identical on both backends.
//
// The rule, over these fifteen cells:
//
//   COPY  a whole VALUE (`d = v`, `p = o`) and every scalar — nullable or dense, since
//         `@FR-L-Null` makes `τ?` the same storage and the rule is written for every `τ`
//   COPY  a ONE-LEVEL projection off an OWNED base whose type is a COLLECTION (`af = bx.v`)
//   VIEW  a ONE-LEVEL projection off an OWNED base whose type is a STRUCT  (B-View: the one
//         place aliasing is the default, because it names an interior place)
//   VIEW  a vector INDEX read (`a = vv[0]`) and a NESTED field read (`c = o.inner.v`) —
//         #426's RESOLUTION, whose filed premise "these must COPY" was the wrong read
//   VIEW  ANY projection off a BORROWED base, at every element type
//
// `OWNERSHIP_MODEL § The law` is the prose; a view materialises where @PLN130's three
// disturbance events end the place it names.
//
// ⚠ **The NULLABLE cells at the bottom are here because the file read green without them.**
// Every one of the original eleven declared its bound source non-null — `??` appeared only
// inside an element-read assertion, never as a subject — so the one axis the boundary broke
// on was the one axis this file never moved: `b = a` with `a: vector<integer>?` aliased, and
// so did a nullable struct, while eleven cells and both backends agreed (loft#1319).  A
// boundary file is only as wide as the axes its subjects range over, and "does THIS bind
// copy?" is not answerable from cells that all spell their subject the same way.
//
// @falsified-at: dad9b359 — interpret exit 1 -> 0, interpret 2 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  The moving cells are the four
//   nullable ones added below; the original eleven pass on that build and on this one, which
//   is what makes them the boundary rather than further instances.

struct BdIn { k: integer }
struct BdHold { vecf: vector<integer>, strf: BdIn }
struct BdOut { inner: BdHold }

// ── COPY: a whole value ──────────────────────────────────────────────────────────────
fn test_whole_var_vector_copies() {
  x = [1, 2];
  c = x;
  x = [9, 9];
  assert(len(c) == 2 && (c[0] ?? 0) == 1, "whole vector bind aliased: {c}");
}

fn test_whole_var_struct_copies() {
  s = BdIn { k: 1 };
  c = s;
  s = BdIn { k: 9 };
  assert(c.k == 1, "whole struct bind aliased: {c.k}");
}

fn test_scalar_copies() {
  n = 5;
  c = n;
  n = 9;
  assert(c == 5, "scalar bind aliased: {c}");
}

// ── COPY: a one-level COLLECTION projection off an OWNED base (C86 / `af = bx.v`) ────
fn test_collection_field_off_an_owned_base_copies() {
  h = BdHold { vecf: [1, 2], strf: BdIn { k: 1 } };
  c = h.vecf;
  h.vecf = [9, 9];
  assert(len(c) == 2 && (c[0] ?? 0) == 1, "owned-base collection field aliased: {c}");
}

// ── VIEW: a one-level STRUCT projection off an OWNED base (B-View) ───────────────────
fn test_struct_field_off_an_owned_base_is_a_view() {
  h = BdHold { vecf: [1, 2], strf: BdIn { k: 1 } };
  c = h.strf;
  h.strf = BdIn { k: 9 };
  assert(c.k == 9, "B-View: a struct projection must alias, got {c.k}");
}

// ── VIEW: index and nested reads — #426's RESOLUTION, not a deviation ────────────────
fn test_vector_index_read_is_a_view() {
  vv: vector<vector<integer>> = [[1, 2]];
  c = vv[0] ?? [0];
  vv[0][0] = 9;
  assert((c[0] ?? 0) == 9, "#426: an index read must be a view, got {c}");
}

fn test_nested_field_read_is_a_view() {
  o = BdOut { inner: BdHold { vecf: [1, 2], strf: BdIn { k: 1 } } };
  c = o.inner.vecf;
  o.inner.vecf[0] = 9;
  assert((c[0] ?? 0) == 9, "#426: a nested field read must be a view, got {c}");
}

// ── VIEW: ANY projection off a BORROWED base, at every element type ──────────────────
fn test_collection_field_off_a_borrowed_base_is_a_view() {
  bv: vector<BdHold> = [BdHold { vecf: [1, 2], strf: BdIn { k: 1 } }];
  for b in bv {
    c = b.vecf;
    b.vecf = [9, 9];
    assert((c[0] ?? 0) == 9, "borrowed-base collection field copied: {c}");
  }
}

fn test_struct_field_off_a_borrowed_base_is_a_view() {
  bv: vector<BdHold> = [BdHold { vecf: [1, 2], strf: BdIn { k: 1 } }];
  for b in bv {
    c = b.strf;
    b.strf = BdIn { k: 7 };
    assert(c.k == 7, "borrowed-base struct field copied: {c.k}");
  }
}

fn test_collection_tuple_element_off_a_borrowed_base_is_a_view() {
  tv: vector<(vector<integer>, integer)> = [([1, 2], 0)];
  for p in tv {
    c = p.0;
    p.0 = [9, 9];
    assert((c[0] ?? 0) == 9, "borrowed-base collection tuple element copied: {c}");
  }
}

fn test_struct_tuple_element_off_a_borrowed_base_is_a_view() {
  ts: vector<(BdIn, integer)> = [(BdIn { k: 1 }, 0)];
  for p in ts {
    c = p.0;
    p.0 = BdIn { k: 9 };
    assert(c.k == 9, "borrowed-base struct tuple element copied: {c.k}");
  }
}

// ── COPY: the same whole values, spelled NULLABLE ────────────────────────────────────
// `@FR-B-Copy` is written for every `τ`, and `@FR-L-Null` gives `τ?` the same storage as
// its dense twin, so each of these must answer exactly as the cell it mirrors above.
fn test_whole_var_nullable_vector_copies() {
  x: vector<integer>? = [1, 2];
  c = x;
  x[0] = 9;
  assert(len(c ?? []) == 2 && (c ?? [])[0] == 1, "nullable whole vector bind aliased: {c}");
}

fn test_whole_var_nullable_struct_copies() {
  s: BdIn? = BdIn { k: 1 };
  c = s;
  s.k = 9;
  assert((c ?? BdIn { k: 0 }).k == 1, "nullable whole struct bind aliased");
}

fn test_whole_var_nullable_keyed_copies() {
  h: hash<BdIn[k]>? = [BdIn { k: 1 }];
  c = h;
  assert(len(c ?? []) == 1, "nullable whole keyed bind lost its element: {len(c ?? [])}");
}

// An ABSENT source binds ABSENT.  The copy above must not turn absence into emptiness —
// they are different values, and a bind that answers `[]` for `null` is as wrong as one
// that aliases.
fn test_an_absent_source_binds_absent() {
  v: vector<integer>? = null;
  cv = v;
  assert(cv == null, "an absent vector source bound something");
  s: BdIn? = null;
  cs = s;
  assert(cs == null, "an absent struct source bound something");
}
