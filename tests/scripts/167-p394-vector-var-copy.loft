//
// @P394 — `b = a` (declaring/assigning a vector local from a bare vector
// variable) must produce an INDEPENDENT COPY, not crash.
//
// Pre-fix: the @P292 Clear+Append branch was gated on `uses(var) > 0` (a flawed
// proxy for "v already has storage").  A FIRST assignment `b = a` fell through to
// the standard `Set(b, Var(a))` alias path, which never allocated `b` a stack
// slot → `b` landed on u16::MAX → `generate_var` asserted (codegen.rs:2669), or
// with a trailing `+=` `b` silently stayed empty and the source corrupted.
// Both backends.
//
// Fix (src/parser/expressions.rs): the bare-vector-Var branch now strips the
// RHS var's store dep from `b` (breaking the alias), then gives `b` its OWN
// store via `insert_new` on first assignment (or clears its existing store on
// reassignment) and `OpAppendVector` deep-copies the elements.  Vectors are
// copy-semantics, so `b` is fully independent of `a` afterwards.

fn test_p394_basic_copy() {
  a: vector<integer> = [1, 2, 3];
  b = a;
  assert(len(b) == 3, "copy length");
  assert(b[0] == 1 && b[1] == 2 && b[2] == 3, "copy values");
}

fn test_p394_independent() {
  a: vector<integer> = [1, 2, 3];
  b = a;
  b[0] = 99;
  assert(a[0] == 1, "mutating copy must not change source");
  assert(b[0] == 99, "copy was mutated");
}

fn test_p394_append_after_copy() {
  a: vector<integer> = [1, 2, 3];
  b = a;
  b += [4];
  assert(len(a) == 3, "source intact after b += ");
  assert(len(b) == 4 && b[3] == 4, "appended to copy");
  assert(b[0] == 1, "copy kept the original elements (not silently emptied)");
}

fn test_p394_source_intact_after_mutating_source() {
  a: vector<integer> = [1, 2, 3];
  b = a;
  a += [4];
  assert(len(a) == 4 && len(b) == 3, "source and copy diverge independently");
}

fn test_p394_typed_target() {
  a: vector<integer> = [1, 2, 3];
  b: vector<integer> = a;
  assert(b[1] == 2, "typed-target copy");
}

fn test_p394_untyped_then_use() {
  a: vector<integer> = [1, 2, 3];
  b = a;
  total = b[0] + b[2];
  assert(total == 4, "untyped copy is usable");
}

fn test_p394_text_vector() {
  a: vector<text> = ["x", "y", "z"];
  b = a;
  b[0] = "Q";
  assert(b[0] == "Q" && a[0] == "x", "text vector copy independent");
}

fn test_p394_float_vector() {
  a: vector<float> = [1.5, 2.5];
  b = a;
  assert(b[1] == 2.5, "float vector copy");
}

fn test_p394_reassign_existing() {
  a: vector<integer> = [1, 2, 3];
  b: vector<integer> = [9];
  b = a;
  assert(len(b) == 3 && b[0] == 1, "reassigning an existing vector local copies");
}

fn test_p394_chained_independent() {
  a: vector<integer> = [1, 2, 3];
  b = a;
  c = a;
  c[0] = 9;
  assert(b[0] == 1 && c[0] == 9 && a[0] == 1, "two copies of the same source are independent");
}
