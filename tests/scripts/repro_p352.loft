// @P352 regression: two structurally-identical `fn(...)` types must compare
// equal under Type::is_same.  A fn-ref's dep list records the closure vars it
// captured (different per binding site), so a raw `==` reported two identical
// `fn(integer)->integer` loop variables as different types — making the @P344
// loop-var reuse check mis-fire ("type fn(...) but was previously used as
// fn(...)") even though the two types are identical.  Fixed by giving
// Type::is_same a structural Function arm (params + return, ignoring deps).
fn dbl(x: integer) -> integer {
  return x * 2;
}
fn apply(f: fn(integer) -> integer) -> integer {
  return f(10);
}

fn main() {
  a: vector<fn(integer) -> integer> = [dbl];
  b: vector<fn(integer) -> integer> = [dbl];

  // reuse the SAME loop-var name `f` across two loops over identical fn types
  sa = 0;
  for f in a { sa += apply(f); }
  sb = 0;
  for f in b { sb += apply(f); }

  assert(sa == 20, "first reuse loop: {sa}");
  assert(sb == 20, "second reuse loop: {sb}");
  print("p352 ok\n");
}
