// @PLN85 over-free class — a vector returned from a match-arm field binding
// (`Filled { items } => items`) is a BORROWED view of the enum's field. It must
// be COPIED into the return buffer (value semantics), not renamed onto the
// buffer — which aliased the CALLER's buffer to the enum's field store, so the
// caller's buffer free then whole-store-freed the enum's field (interp SIGSEGV
// under allocation pressure that recycled the freed slot).
//
// Fix: classify_vector_delivery now routes a tail Var that borrows a visible arg
// (`tail_borrows_arg`) through CopyBorrow → copy_borrow_tail_into_retbuf, the
// same copy the struct-field tail (#415) and whole-arg tail (a2) already use.

struct M { hp: integer, depth: integer, name: text }
enum Cell {
  Empty,
  Filled { items: vector<M> },
}

fn m_none() -> M {
  M { hp: 0, depth: 0, name: "" }
}

fn filler(n: integer) -> integer {
  es: vector<M> = [];
  for j in 0..n { es += [M { hp: j, depth: j, name: "RECYCLE-{j}" }]; }
  return len(es);
}

// returns the enum's items vector — a borrowed view that must be copied out.
fn items_of(c: Cell) -> vector<M> {
  match c {
    Filled { items } => { items },
    _ => { empty: vector<M> = []; empty },
  }
}

fn main() {
  inner: vector<M> = [];
  inner += [M { hp: 1, depth: 1, name: "a" }];
  inner += [M { hp: 2, depth: 2, name: "b" }];
  c = Filled { items: inner };

  for i in 0..6 {
    r = items_of(c);
    acc = 0;
    for f in 0..6 { acc += filler(6); } // recycle any wrongly-freed slot
    assert(acc == 36, "iter {i}: filler churn ran");
    assert(len(r) == 2, "iter {i}: len(r)={len(r)} (copied out of the enum)");
    // the enum's field must survive the call + the buffer free:
    again = items_of(c);
    assert(len(again) == 2, "iter {i}: enum field intact, len(again)={len(again)}");
  }
  println("enum-field-vector-borrow ok");
}
