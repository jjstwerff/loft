//
// @PLAN38 phase 01b — smoke test for the loft-callable durable-store
// binding (`store_durable_check` + `store_durable_seal`).
//
// Driven by `tests/store_durable_loft.rs`, which:
//   1. Creates a scratch dir under $TMPDIR
//   2. Pre-populates a main store file with deterministic content
//   3. Runs this script via `loft --interpret`, passing the file path
//      as $LOFT_DURABLE_TEST_PATH
//   4. Re-invokes the same script after corrupting the sidecar to
//      verify check returns false in that state
//
// The script returns by printing one of:
//   "OK clean"         — initial state: no sidecar → check=false, seal=true,
//                        re-check=true
//   "OK corrupt-detected" — sidecar XOR'd → check=false
//   "FAIL <reason>"    — any unexpected verdict

fn main() {
  path = env_variable("LOFT_DURABLE_TEST_PATH");
  mode = env_variable("LOFT_DURABLE_TEST_MODE");

  if mode == "initial" {
    // Step 1: fresh main file present, no sidecar → check must return false.
    if store_durable_check(path) { println("FAIL initial-check-should-be-false"); return }
    // Step 2: seal — should succeed and produce a fresh sidecar.
    if !store_durable_seal(path) { println("FAIL initial-seal-should-succeed"); return }
    // Step 3: re-check — sidecar now exists + matches → check must return true.
    if !store_durable_check(path) { println("FAIL initial-recheck-should-be-true"); return }
    println("OK clean")
  } else if mode == "corrupt" {
    // Sidecar exists but the harness has XOR'd a byte → check must return false.
    if store_durable_check(path) { println("FAIL corrupt-check-should-be-false"); return }
    println("OK corrupt-detected")
  } else { println("FAIL unknown-mode") }
}
