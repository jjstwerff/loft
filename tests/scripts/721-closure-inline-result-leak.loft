// loft#721 — a closure call returning a struct, used INLINE, leaked one store
// per call; and the obvious fix for that leaks-vs-frees question is a
// use-after-free if it is answered from the wrong place.
//
// The direct-call path lifts an inline aggregate result into a `__lift_N` temp
// so `get_free_vars` frees it. `inline_struct_return` decided what to lift and
// matched only `Value::Call`; a closure call is `Value::CallRef`, so nothing
// lifted. And unlike a direct call — whose buffer is a `__ref_N` VARIABLE the
// parser minted — a `CallRef`'s buffer is allocated at RUNTIME, so nothing owned
// it unless the caller bound the result:
//
//     p = pt(0); p.a     clean, the binding owns the buffer
//     pt(0).a            leaked one store, every call
//
// The trap is deciding WHEN to lift. A `CallRef`'s callee is a runtime value, so
// the fn-ref TYPE is what the call site has — and it is not enough: a closure
// that calls a struct-returning function and one that hands back a borrowed
// element present the SAME signature, because the return's dep index lives in
// the callee's attribute space and means nothing on its own. Lifting on the type
// alone frees a borrowed element, which the ordinary suite does not notice (it
// reads correct data from a freed record) and `LOFT_POISON=1` does.
//
// So the lift resolves the fn-ref's TARGET DEFINITION and asks that definition's
// own `returns_borrowed_view()`. The cases below are the ground truth that
// verdict was validated against: the first three MUST be freed (they leaked),
// the last MUST NOT (it borrows). An unknown or ambiguous target is not lifted.
//
// The leak half has no assertion in the language — the wrap harness's leak gate
// is the guard, and it fails this file if any store survives program exit. The
// borrowed half DOES assert, because freeing there corrupts the source rather
// than leaking, and that must not read as a pass.

struct ClRow {
  const id: integer,
  name: text,
}

struct ClBox {
  rows: vector<ClRow>,
}

fn cl_make(n: integer) -> ClRow {
  ClRow { id: n, name: "row-{n}" }
}

fn main() {
  // OWNED 1 — a capturing closure that CALLS a struct-returning function.
  k = 5;
  mk = fn(i: integer) -> ClRow { cl_make(k + i) };
  total = 0;
  for r in 0..6 { total += mk(r).id }
  assert(total == 45, "six inline calls: ids 5..10 sum to 45");

  // Inline in a format string, which is where it was first seen.
  one = "{mk(0).name}";
  assert(one == "row-5", "an inline result read through a format string");

  // OWNED 2 — a capturing closure that builds the struct INLINE (no call).
  j = 20;
  lit = fn(i: integer) -> ClRow { ClRow { id: j + i, name: "lit" } };
  assert(lit(2).id == 22, "an inline-built struct result");

  // OWNED 3 — a NON-capturing closure, stored as a bare definition number
  // rather than a `FnRef`, so the target resolves by the other route.
  plain = fn(i: integer) -> ClRow { cl_make(100 + i) };
  assert(plain(1).id == 101, "a non-capturing closure's inline result");
  assert(plain(2).name == "row-102", "and its owned text is intact");

  // BORROWED — the closure hands back an element of an outer structure on one
  // path and a fresh literal on the other. This MUST NOT be lifted: freeing it
  // frees the element the source still holds. Before the target-resolving
  // verdict, this was a use-after-free that only `LOFT_POISON=1` exposed.
  b = ClBox { rows: [] };
  for i in 0..4 { b.rows += [ClRow { id: i, name: "src-{i}" }] }
  pick = fn(i: integer) -> ClRow { b.rows[i] ?? ClRow { id: -1, name: "" } };
  s = 0;
  for r in 0..4 { s += pick(r).id }
  assert(s == 6, "ids 0..3 read back through the borrowing closure");

  n = 0;
  for e in b.rows { n += e.id * 0 + 1 }
  assert(n == 4, "the source structure still holds every row");
  last = b.rows[3] ?? ClRow { id: -1, name: "" };
  assert(last.name == "src-3", "and its contents were not freed underneath it");

  // Two inline results live at once in one expression.
  pair = mk(0).id + mk(1).id;
  assert(pair == 11, "two inline results in a single expression");
}
