// loft#721 — a closure call returning a struct, used INLINE, leaked one store
// per call.
//
// The direct-call path lifts an inline aggregate result into a `__lift_N` temp
// so `get_free_vars` frees it; `inline_struct_return` decided what to lift and
// matched only `Value::Call`. A closure call is `Value::CallRef`, so it never
// lifted — and unlike a direct call, whose buffer is a `__ref_N` the parser
// minted, a `CallRef`'s buffer is allocated at RUNTIME (`fn_call_ref` pushes one
// per hidden attribute, because the bytecode call site carries only the visible
// args). With no variable owning it and no lift, nothing freed it:
//
//     r = pt(0); r.a     -> clean, the binding owns the buffer
//     pt(0).a            -> leaked one store, every call
//
// There is no assertion for "did not leak" in the language; the guard is the
// wrap harness's leak gate, which fails this file if any store survives program
// exit. So this test's job is to USE the shapes inline and finish — the values
// are checked too, because a lift that frees too eagerly would corrupt them
// rather than leak, and that must not read as a pass.

struct ClRow {
  const id: integer,
  name: text,
}

struct ClBox {
  rows: vector<ClRow>,
}

fn cl_make(n: integer) -> ClRow {
  ClRow { id: n, name: "row-{n}" }
}

fn main() {
  // Inline result of a capturing closure — the reported shape.
  k = 5;
  mk = fn(i: integer) -> ClRow { cl_make(k + i) };
  total = 0;
  for r in 0..6 { total += mk(r).id }
  assert(total == 45, "six inline calls: ids 5..10 sum to 45");

  // Inline in a format string, which is where it was first seen.
  one = "{mk(0).name}";
  assert(one == "row-5", "an inline result read through a format string");

  // Inline result of a NON-capturing closure — same runtime buffer, no capture.
  plain = fn(i: integer) -> ClRow { cl_make(100 + i) };
  assert(plain(1).id == 101, "a non-capturing closure's inline result");
  assert(plain(2).name == "row-102", "and its owned text is intact");

  // A closure whose body hands back an element of an outer structure. It reads
  // like a borrow, but the aggregate is delivered through the caller's buffer,
  // so what comes back is a fresh copy. The lift must free that copy WITHOUT
  // disturbing the structure it came from — the assertion below is what would
  // catch a lift that freed the original instead.
  b = ClBox { rows: [] };
  for i in 0..4 { b.rows += [ClRow { id: i, name: "src-{i}" }] }
  pick = fn(i: integer) -> ClRow { b.rows[i] ?? ClRow { id: -1, name: "" } };
  s = 0;
  for r in 0..4 { s += pick(r).id }
  assert(s == 6, "ids 0..3 of the copies sum to 6");

  n = 0;
  for e in b.rows { n += e.id * 0 + 1 }
  assert(n == 4, "the source structure still holds every row");
  last = b.rows[3] ?? ClRow { id: -1, name: "" };
  assert(last.name == "src-3", "and its contents were not freed underneath it");

  // Repeated inline use in one expression: two buffers live at once.
  pair = mk(0).id + mk(1).id;
  assert(pair == 11, "two inline results in a single expression");
}
