//
// #333 / C80 / E-Uncomp (formal/operational.md) — an UNDEFENDED calculation
// fault never halts.  Divide / modulo by zero (and arithmetic overflow) is
// uncomputable, so it yields the type's null sentinel and execution CONTINUES
// (the spreadsheet model: one bad cell shows null, the rest still compute).
// This REVERSES the old plan-07 4f.5 "div-zero raises" contract (the file's
// former name, `…-div-zero-raises.loft`).
//
// An UNGUARDED divide-by-zero also reports a Warn log — see
// runtime_logging.rs::prod_divide_by_zero_logs_and_continues.  A `??` / null-check
// GUARD emits the silent `*Nullable` op instead and rescues the null here.

fn test_int_div_zero_is_null() {
  z = 0;
  a = 5 / z;
  assert(a == null, "undefended int / 0 is null and continues, got {a}");
}

fn test_int_mod_zero_is_null() {
  z = 0;
  a = 5 % z;
  assert(a == null, "undefended int % 0 is null and continues, got {a}");
}

fn test_float_div_zero_is_null() {
  z = 0.0;
  a = 5.0 / z;
  assert(!a, "undefended float / 0 is null (NaN) and continues, got {a}");
}

// Arithmetic overflow is uncomputable too: silent null + continue (C80 — silent
// is the rustc-release default; loft's result is null, not a wrapped wrong answer).
fn test_int_overflow_is_null() {
  big = 9223372036854775807;
  a = big + 1;
  assert(a == null, "overflow past the 64-bit range is null, got {a}");
}

// The defended forms keep the explicit null / IEEE path — `??` rescues the null.
fn test_defended_paths() {
  z = 0;
  zf = 0.0;
  a = 5 % z ?? -1;
  b = if zf != 0.0 { 5.0 / zf } else { -2.0 };
  assert(a == -1 && b == -2.0, "defended: a={a} b={b}");
}
