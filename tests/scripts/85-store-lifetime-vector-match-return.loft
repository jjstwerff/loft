//
// @PLN85 cluster II — regression guard (graduated from probes/05).
// A fn taking an ENUM (payload) arg and returning a VECTOR via an explicit
// `return match`, called N times with all results held live. Before the fix
// every held result aliased the same NRVO return buffer (interp: all read the
// LAST call's value; native: garbage) AND the interpreter leaked the eager
// `__retbuf` work-ref store per call. Distilled from cbor's `encode_map`
// (loft-libs-core), the real-consumer trigger of the map-encode corruption.
//
// Guards: correct independent values + no store leak on BOTH backends.

enum CV { CN, CI { value: integer } }

fn enc(c: CV) -> vector<u8> {
  return match c { CN => [0 as u8], CI { value } => [(value & 255) as u8] };
}

fn main() {
  k0 = CI { value: 1 };
  k1 = CI { value: 3 };
  k2 = CI { value: 5 };
  a = enc(k0);
  b = enc(k1);
  c = enc(k2);
  // Each result must be independent (was 5 5 5 / garbage before the fix).
  assert((a[0] ?? 99) == 1, "a == 1 (got aliased last value)");
  assert((b[0] ?? 99) == 3, "b == 3");
  assert((c[0] ?? 99) == 5, "c == 5");
}
