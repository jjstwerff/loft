//
// @PLN110 sub-arc 1e — `size(scalar)` = the value's storage width, a
// compile-time constant of the type (L-Scalar / L-Narrow): boolean 1;
// character / single 4; integer / float 8; a narrow integer its narrow width
// (u8 1, u16 2, i32 4).  The argument is still evaluated for its side effects
// (every scalar is one 8-byte eval-stack slot, which the op consumes) but only
// its type feeds the constant width.
//
// Values verified against both backends (interpret + native) during Phase 1.

fn calc() -> integer {
  5 + 5
}

fn main() {
  i: integer = 100;
  f: float = 3.14;
  b: boolean = true;
  c: character = 'A';
  s: single = 1.5f;
  u: u8 = 200;
  w: u16 = 5000;
  n: i32 = 70000;
  assert(size(i) == 8, "integer = 8: {size(i)}");
  assert(size(f) == 8, "float = 8: {size(f)}");
  assert(size(b) == 1, "boolean = 1: {size(b)}");
  assert(size(c) == 4, "character = 4 (code-point slot): {size(c)}");
  assert(size(s) == 4, "single = 4: {size(s)}");
  assert(size(u) == 1, "u8 = 1 (narrow): {size(u)}");
  assert(size(w) == 2, "u16 = 2 (narrow): {size(w)}");
  assert(size(n) == 4, "i32 = 4 (forced_size, not the 8-byte range width): {size(n)}");

  // the argument may be a literal or a call — it is evaluated, only its type counts
  assert(size(42) == 8, "int literal = 8");
  assert(size('Z') == 4, "char literal = 4");
  assert(size(calc()) == 8, "size(calc()) = 8 (call argument): {size(calc())}");

  // cross-check: a scalar's size IS its per-element stride in an inline vector
  cv: vector<character> = ['a', 'b', 'c'];
  assert(size(cv) == 3 * size('x'), "vector<char> stride == size(char): {size(cv)}");
  iv: vector<integer> = [1, 2, 3];
  assert(size(iv) == 3 * size(0), "vector<int> stride == size(int): {size(iv)}");
}
