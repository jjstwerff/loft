//
// A `??` default that CALLS a function leaked the record it returned, once per index MISS.
//
// `x = v[i] ?? mk()` types its result from the SUBJECT, which names the vector
// (`ref(S)["v"]`), so the consumer reads `x` as a borrow and frees nothing.  On the miss path
// the value is a store `mk()` freshly allocated and handed back — owned by no one.  A struct
// LITERAL default was always clean for the opposite reason: `parse_object` allocates it into a
// work-ref this frame already frees.  And the compiler's refusal of a struct-valued constant
// prescribes the CALL spelling, so the leaking form is the one it tells you to write.
//
// The buffer to bind is the one the call already carries: a heap-returning callee is given a
// hidden `__ref_N` destination the caller mints and frees, and the only thing missing was
// capturing what the call answered into it.  That exposed a second half — `paired_witness`
// made the buffer its own witness for `__ref_N = f(__ref_N)`, so the scope-exit
// `OpFreeRefIfDistinct` compared the store with itself and never fired at all.
//
// The harness's leak check is what this file asserts; the values are here so a fix that
// silences the leak by dropping the default would fail too (loft#1013).

struct S1013 { a: integer }

fn mk1013() -> S1013 { S1013 { a: -1 } }

fn test_a_call_default_on_an_index_miss_is_freed() {
  v: vector<S1013> = [S1013 { a: 7 }];
  m = v[5] ?? mk1013();
  assert(m.a == -1, "the miss takes the call default");
}

fn test_it_does_not_scale_with_the_number_of_misses() {
  // Three misses leaked three records before; a loop leaked one per iteration.
  v: vector<S1013> = [S1013 { a: 7 }];
  t = 0;
  for i in 0..6 {
    m = v[i + 9] ?? mk1013();
    t += m.a;
  }
  assert(t == -6, "six misses each take the default, got {t}");
}

fn test_the_hit_path_and_the_literal_default_still_work() {
  // The two cells that were always clean — a fix must not start freeing the ELEMENT (the hit
  // path borrows the vector) nor double-free the literal's own work-ref.
  v: vector<S1013> = [S1013 { a: 7 }];
  h = v[0] ?? mk1013();
  assert(h.a == 7, "the hit path answers the element, not the default");
  l = v[5] ?? S1013 { a: -2 };
  assert(l.a == -2, "a literal default still answers");
}
