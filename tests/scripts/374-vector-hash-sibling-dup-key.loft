//
// Regression — a struct with a `vector<T>` field AND a `hash<T[key]>` field of
// the SAME element type auto-links them: appending to the vector also maintains
// the hash as a secondary index (`Field.other_indexes`, the "two views share
// records" pattern).  A DUPLICATE key used to corrupt the vector.
//
// Root cause: appending a duplicate-key record routed through `dedup_keyed`,
// which DELETED the displaced record to enforce the hash's unique-key invariant
// — but that record is still held positionally by the vector → read-back nulls /
// `Unknown record` SIGSEGV (only with `hash`; `sorted` was unaffected; only when
// the DUPLICATED field is the key).  Fix (`src/database/search.rs`): a SECONDARY
// index (maintained via `other_indexes`) only UNLINKS the stale key→record
// mapping; it never deletes the record, which the primary collection owns.  The
// `other_indexes` analogue of @P305's `keyed_field_is_linked` update-only path.
//
// Semantics: the vector keeps EVERY appended record (insertion order, duplicates
// included); the hash keeps ONE record per key — the LATEST appended.

struct Word { text: text, count: integer }
struct Counter { ordered: vector<Word>, by_text: hash<Word[text]> }
struct ByCount { ordered: vector<Word>, by_count: hash<Word[count]> }

// Duplicate key: vector keeps both, hash keeps the latest, nothing corrupts.
fn test_dup_key_vector_keeps_all_hash_keeps_latest() {
  c = Counter { ordered: [], by_text: [] };
  c.ordered += [Word { text: "apple", count: 1 }];
  c.ordered += [Word { text: "banana", count: 2 }];
  c.ordered += [Word { text: "apple", count: 9 }];
  // Vector keeps all three in insertion order.
  assert(len(c.ordered) == 3, "vector len={len(c.ordered)} (expect 3)");
  assert(c.ordered[0].text == "apple" && c.ordered[0].count == 1, "ord[0]={c.ordered[0].count}");
  assert(c.ordered[1].text == "banana", "ord[1]={c.ordered[1].text}");
  assert(c.ordered[2].text == "apple" && c.ordered[2].count == 9, "ord[2]={c.ordered[2].count}");
  // Hash keeps one record per key — the latest "apple".
  assert(c.by_text["apple"].count == 9, "hash[apple]={c.by_text[\"apple\"].count} (expect 9)");
  assert(c.by_text["banana"].count == 2, "hash[banana]={c.by_text[\"banana\"].count}");
}

// Churn after the duplicate must not surface a freed record (the displaced
// "apple" record must remain live in the vector).
fn test_dup_key_survives_churn() {
  c = Counter { ordered: [], by_text: [] };
  for label in ["a", "b", "a", "c", "b", "a"] {
    c.ordered += [Word { text: label, count: 1 }];
  }
  // 6 appended; vector holds all 6 (3×a, 2×b, 1×c).
  junk: vector<Word> = [];
  for k in 0..50 { junk += [Word { text: "junk", count: k }]; }
  assert(len(c.ordered) == 6, "churn vector len={len(c.ordered)} (expect 6)");
  total = 0;
  for e in c.ordered { total = total + len(e.text); }
  assert(total == 6, "churn total text bytes={total} (expect 6)");
  assert(c.by_text["a"].text == "a" && c.by_text["c"].text == "c", "churn hash lookups");
}

// The duplicated key is a non-text (integer) field — same fix applies.  Before
// the fix, `d.ordered[0].text` read the LAST element ("z") instead of "x".
fn test_dup_integer_key() {
  d = ByCount { ordered: [], by_count: [] };
  for t in ["x", "y", "z"] { d.ordered += [Word { text: t, count: 5 }]; }
  assert(len(d.ordered) == 3, "int-key vector len={len(d.ordered)} (expect 3)");
  assert(d.ordered[0].text == "x", "int-key [0]={d.ordered[0].text} (expect x)");
  assert(d.ordered[2].text == "z", "int-key [2]={d.ordered[2].text} (expect z)");
  // The hash keeps the latest record for the shared key 5.
  assert(d.by_count[5].text == "z", "by_count[5]={d.by_count[5].text} (expect z, latest)");
}
