// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A text-returning call inside `"{…}"` compiles wherever it runs.
//
// `--native` hoists an argument that has work to do into a `let _pre_N = …`, and the
// binding derefs when it holds an OWNED text, because the callee's parameter is `&str`.
// That decision listed two shapes — a text-returning user CALL, and a value BLOCK whose
// result is text — and a hoist that carries the argument's CONSTRUCTION alongside the
// call is neither: it is a SEQUENCE whose tail is one of them.
//
// So `print("{f(["aa"])}")` with `fn f(v: vector<text>) -> text { v[0] }` handed a
// `String` to `format_text` and rustc refused the whole program — `expected &str, found
// String` — while `--interpret` ran it and printed `aa`.  One program, one driver
// accepting and the other rejecting, which is the D-op-2 facet of the differential
// oracle: well-typedness is ONE judgment.
//
// The trigger needs all three: a function returning a BORROWED projection of its
// argument (an element or a field — a text VIEW, not a built text), a TEMPORARY argument
// (a literal, so there is something to hoist), and the call inside an interpolation.
// Binding the argument first made it compile, which is why nothing in the corpus hit it.

struct Bts { t: text, n: integer }

// The two borrowed-projection bodies: a vector element and a struct field.
fn elem_of(v: vector<text>) -> text { v[0] }
fn field_of(s: Bts) -> text { s.t }
// The controls: a literal return and a forwarded parameter both produced a value the
// binding already handled, and a BUILT text is owned by the callee rather than borrowed.
fn just_a_literal() -> text { "lit" }
fn forwards(t: text) -> text { t }
fn builds(v: vector<text>) -> text { v[0] + "!" }

fn test_a_borrowed_projection_survives_a_temporary_argument() {
  // The argument is a LITERAL, so the emitter has the vector's construction and the call
  // to hoist together — the shape that did not compile.
  assert("{elem_of(["aa", "bb"])}" == "aa", "an element of a literal vector");
  assert("{field_of(Bts { t: "ff", n: 1 })}" == "ff", "a field of a literal struct");
}

fn test_the_same_call_with_a_bound_argument() {
  // The workaround that used to be the only spelling that compiled — it must keep
  // working, and it must agree with the line above.
  w = ["aa", "bb"];
  s = Bts { t: "ff", n: 1 };
  assert("{elem_of(w)}" == "{elem_of(["aa", "bb"])}", "bound and literal agree, element");
  assert("{field_of(s)}" == "{field_of(Bts { t: "ff", n: 1 })}", "bound and literal agree, field");
}

fn test_the_controls_still_work() {
  assert("{just_a_literal()}" == "lit", "a literal return");
  assert("{forwards("fw")}" == "fw", "a forwarded parameter");
  assert("{builds(["aa", "bb"])}" == "aa!", "a BUILT text, owned by the callee");
}

fn test_the_value_is_the_text_not_its_shape() {
  // Length and content, not merely "it compiled": a deref applied to the wrong thing
  // would still compile and could hand back the wrong bytes.
  assert(len("{elem_of(["hello", "bb"])}") == 5, "the element's length");
  assert("{elem_of(["hello", "bb"])}" + "!" == "hello!", "the element concatenates");
  assert("<{field_of(Bts { t: "mid", n: 2 })}>" == "<mid>", "the field inside surrounding text");
  // Two of them in ONE interpolation, so the second hoist cannot reuse the first's
  // binding by accident.
  assert("{elem_of(["aa", "bb"])}{field_of(Bts { t: "ff", n: 1 })}" == "aaff", "two in one string");
}

fn main() {
  test_a_borrowed_projection_survives_a_temporary_argument();
  test_the_same_call_with_a_bound_argument();
  test_the_controls_still_work();
  test_the_value_is_the_text_not_its_shape();
  print("borrowed-text-return-in-interpolation ok\n");
}
