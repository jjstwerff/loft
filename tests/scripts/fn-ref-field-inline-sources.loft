//
// The fn-ref struct-field sources that WORK — the positive half of the pair whose other
// half is `fn-ref-field-non-inline-refused.loft`.
//
// A `fn`-typed field is written from an inline lambda literal, and only from one: a
// variable source and a call source are each refused by name (P215 / P213-deferred,
// because a capturing source needs its closure record copied and that is not built yet).
// This file pins that the three admitted spellings still deliver a callable function,
// so the refusal that closed the crash cannot quietly widen into them.
//
// `k` is captured on purpose in the third cell: a capturing lambda is 20 bytes (4 for the
// d_nr, 12 for the closure `DbRef`, then the split-field layout @P213 gave it), and the
// whole family of defects here is four of those bytes being written where twenty belong.
// So the cell asserts the CAPTURED value arrives, not merely that the call returns.

struct Fnh { f: fn(integer) -> integer }

fn fnh_plain(x: integer) -> integer { x + 1 }

fn test_a_named_function_is_a_valid_source() {
  h = Fnh { f: fnh_plain };
  assert(h.f(5) == 6, "a named function: got {h.f(5)}");
}

fn test_an_inline_lambda_is_a_valid_source() {
  h = Fnh { f: fn(x: integer) -> integer { x * 2 } };
  assert(h.f(5) == 10, "an inline lambda: got {h.f(5)}");
}

fn test_a_capturing_inline_lambda_carries_its_capture() {
  k = 10;
  h = Fnh { f: fn(x: integer) -> integer { x + k } };
  // 15 and not 5: the captured `k` has to survive the field write, which is the half
  // that is twelve bytes wide.
  assert(h.f(5) == 15, "a capturing lambda: got {h.f(5)}");

  // Called twice, so a closure record consumed by the first call would show up here.
  assert(h.f(1) == 11, "the capture survives a second call: got {h.f(1)}");
}

fn main() {
  test_a_named_function_is_a_valid_source();
  test_an_inline_lambda_is_a_valid_source();
  test_a_capturing_inline_lambda_carries_its_capture();
  print("fn-ref-field-inline-sources ok\n");
}
