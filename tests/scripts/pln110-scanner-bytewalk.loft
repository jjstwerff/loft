//
// @PLN110 — regression guard for the byte-scan idiom the tracker-index scanner
// (tools/indexer/src/scan.loft) relies on.  The scanner walks file content
// byte-by-byte to split lines and locate tags:
//
//     n = src.size();               // BYTE count — NOT len(src) (char count)
//     while i <= n { if i == n || src[i] == '\n' { line = src[line_start..i]; ... } }
//
// It MUST bound the walk with `size` (bytes), because `src[i]` / `src[a..b]` are
// byte-positioned.  With `len` (character count) the walk stops far short on any
// file full of multi-byte characters — PROBLEMS.md is full of 🟢 and — em-dashes
// — so the scan never reaches the rows past the multi-byte region and reports
// their @P references as "broken" (the @PLN110 flip regression that turned
// index_hygiene red).  This test fails if a scanner-style byte walk is bounded
// by `len` instead of `size`.

// Mirror of scan.loft's line splitter: return the LAST line of `src`.
fn last_line_bytewalk(src: text) -> text {
  n = src.size();
  line_start = 0;
  i = 0;
  while i < n {
    if src[i] == '\n' { line_start = i + 1; }
    i += 1;
  }
  src[line_start..n]
}

fn main() {
  // Content whose last line sits AFTER heavy multi-byte text, exactly like a
  // deep PROBLEMS.md row.  size(doc) >> len(doc) here.
  doc = "| 21 | 🟢 FIXED — first row |\n| 31 | 🟢 FIXED — second row |\nLAST row wins";
  assert(size(doc) > len(doc), "doc is genuinely multi-byte: size={size(doc)} len={len(doc)}");

  // A `size`-bounded walk reaches the end and returns the true last line.
  // A `len`-bounded walk would stop inside the multi-byte region and return a
  // wrong (short) slice — the scan.loft regression.
  last = last_line_bytewalk(doc);
  assert(last == "LAST row wins", "byte walk reached the last line: {last}");

  // Sanity: len is the character count, size is the byte count (@PLN110).
  assert(len("🟢") == 1 && size("🟢") == 4, "🟢 is 1 char / 4 bytes");
  assert(len("—") == 1 && size("—") == 3, "em dash is 1 char / 3 bytes");
}
