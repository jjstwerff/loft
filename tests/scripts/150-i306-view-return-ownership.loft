// #306 regression — returned views must not let callers free stores they
// don't own.  Pre-fix, a struct read from a vector (`table[idx]`) returned
// through a local crossed the call boundary labelled OWNED: the caller's
// scope-exit OpFreeRef then whole-store-freed the TABLE's store (the vector
// died mid-program; the returned value dangled), and the reassignment alias
// `best = cand` doubled the mislabelled owners.  Covers:
//   1. view returned via a local            (ref_return transitive dep merge)
//   2. view returned directly / mid-body    (was already safe — guard rail)
//   3. conditional alias into the returned  (reassignment deep-copy)
//   4. view of a fn-LOCAL vector returned   (materialise into an owned copy)

struct M {
  hp: integer,
  depth: integer,
  name: text,
}

fn m_none() -> M {
  M { hp: 0, depth: 0, name: "" }
}

// 1. view via local
fn pick_local(table: vector<M>, idx: integer) -> M {
  chosen = table[idx] ?? m_none();
  chosen
}

// 2a. view returned directly (tail)
fn pick_direct(table: vector<M>, idx: integer) -> M {
  table[idx] ?? m_none()
}

// 2b. view returned mid-body
fn pick_mid(table: vector<M>, idx: integer) -> M {
  if idx >= 0 { return table[idx] ?? m_none(); }
  m_none()
}

// 3. conditional alias of the picked view into the returned var
fn choose(table: vector<M>, salt: integer) -> M {
  best = m_none();
  cand = pick_local(table, salt % 2 ?? 0);
  if cand.depth > best.depth { best = cand; }
  best
}

// 4. view of a LOCAL vector escaping through the return — must be
//    materialised (pre-fix: dangled into the local's freed store).
fn pick_from_local(seed: integer) -> M {
  pool: vector<M> = [];
  pool += [M { hp: seed, depth: seed + 1, name: "local" }];
  found = pool[0] ?? m_none();
  found
}

fn main() {
  t: vector<M> = [];
  t += [M { hp: 5, depth: 3, name: "rat" }];
  t += [M { hp: 8, depth: 5, name: "bat" }];

  for i in 0..6 {
    a = pick_local(t, i % 2 ?? 0);
    b = pick_direct(t, (i + 1) % 2 ?? 0);
    c = pick_mid(t, i % 2 ?? 0);
    d = choose(t, i);
    e = pick_from_local(i * 10);
    // The table must stay alive and intact through every call.
    assert(len(t) == 2, "iter {i}: len(t) = {len(t)} (expect 2)");
    assert(a.depth == 3 || a.depth == 5, "iter {i}: a.depth = {a.depth}");
    assert(b.name == "rat" || b.name == "bat", "iter {i}: b.name = '{b.name}'");
    assert(c.hp == 5 || c.hp == 8, "iter {i}: c.hp = {c.hp}");
    exp = if(i % 2 ?? 0) == 0 { 3 } else { 5 };
    assert(d.depth == exp, "iter {i}: d.depth = {d.depth} (expect {exp})");
    assert(e.depth == i * 10 + 1, "iter {i}: e.depth = {e.depth} (expect {i * 10 + 1})");
    assert(e.name == "local", "iter {i}: e.name = '{e.name}'");
  }
  println("i306 view-return ownership: ok");
}
