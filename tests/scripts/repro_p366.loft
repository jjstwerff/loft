//
// @P366 regression: `text as vector<Struct>` (the JSON cast) must NOT silently
// return an empty vector when the JSON carries fields the struct doesn't
// declare.  Pre-fix, an unknown key made `walk_parsed_struct` return a
// WalkErr, the array loop's `?` aborted the whole parse, and the cast returned
// `len == 0` with no error.  Now unknown keys are skipped (lenient-ignore),
// matching the dynamic `JsonValue` walker.  Interpreter + native must agree.
//
// NB: `{{` / `}}` are literal braces (a single `{` starts string interpolation).

struct Item {
  tag: text,
  amount: integer,
}
struct Nested {
  id: integer,
  inner: Item,
}

fn main() {
  // extra top-level key "extra" must not drop the element
  with_extra = "[{{\"tag\":\"a\",\"amount\":1,\"extra\":\"x\"}}]" as vector<Item>;
  assert(len(with_extra) == 1, "extra key must not drop element: {len(with_extra)}");
  assert(with_extra[0].tag == "a", "tag survives extra key");
  assert(with_extra[0].amount == 1, "amount survives extra key");

  // clean JSON still parses
  clean = "[{{\"tag\":\"b\",\"amount\":2}}]" as vector<Item>;
  assert(len(clean) == 1, "clean still parses");

  // single (non-vector) struct cast with an extra key
  one = "{{\"tag\":\"c\",\"amount\":3,\"junk\":true}}" as Item;
  assert(one.tag == "c" && one.amount == 3, "single struct cast ignores extra");

  // nested struct: extra key at BOTH levels must be ignored
  nest = "{{\"id\":7,\"extra1\":0,\"inner\":{{\"tag\":\"d\",\"amount\":4,\"extra2\":\"z\"}}}}" as Nested;
  assert(nest.id == 7, "nested outer id");
  assert(nest.inner.tag == "d" && nest.inner.amount == 4, "nested inner survives extra keys");

  print("ok");
}
