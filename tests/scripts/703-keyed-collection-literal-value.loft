//
// Regression (loft#703): a non-empty KEYED collection literal as a VALUE.
//
// `[K { … }]` builds a `vector<K>` wherever it stands, and only became a keyed collection
// when it was written THROUGH a keyed destination that already existed — a struct-literal
// field, or a `+=` onto a built collection.  Everywhere else the declared type never
// reached the literal: a typed local reported "cannot change type from hash<K,[k]> to
// vector<K>", and a return or an argument reported the same mismatch.  So loft had no
// expression form for a keyed collection at all, which is also why a non-empty keyed
// field DEFAULT stayed refused under loft#698.
//
// The keyed type now reaches the literal, and a keyed destination keeps its own type and
// its own store: the elements are added THROUGH it (`new_record` reads the local's type
// to pick `hash::add` / `sorted_new` / `tree::add`), which is what `h += [K { … }]`
// already did.  The generated IR is byte-identical to that form.
//
// Axes: the collection KIND (hash / sorted / index), the POSITION the literal stands in
// (typed local, return, call argument), and EMPTINESS — an empty keyed literal in value
// position has no element whose `OpNewRecord` would allocate its store, so it needs the
// store said outright.  Controls: the empty local (loft#697), the `+=` build, the
// struct-literal field, and a plain `vector<K>` literal, none of which change.

struct Kv703 { k: integer, v: integer }
struct Box703 { h: hash<Kv703[k]> }
// The keyed field DEFAULT loft#698 had to leave refused for want of this value form.
struct Dflt703 { x: integer, h: hash<Kv703[k]> = [Kv703 { k: 1, v: 2 }] }

fn ret_hash_one() -> hash<Kv703[k]> { [Kv703 { k: 5, v: 6 }] }
fn ret_hash_empty() -> hash<Kv703[k]> { [] }
fn ret_sorted_empty() -> sorted<Kv703[k]> { [] }
fn take_hash(h: hash<Kv703[k]>) -> integer { len(h) }

// An empty `[]` in value position for a NON-keyed element type the narrow-integer hint
// never covered — `fn mk() -> vector<S> { [] }` did not compile at all before.
struct S703 { x: integer }
fn ret_vec_struct_empty() -> vector<S703> { [] }
fn ret_vec_text_empty() -> vector<text> { [] }

fn test() {
  // The filed shape: a typed local built from a non-empty keyed literal.
  h: hash<Kv703[k]> = [Kv703 { k: 5, v: 6 }];
  assert(len(h) == 1, "hash local: length, got {len(h)}");
  hv = h[5];
  assert(hv != null && hv.v == 6, "hash local: value reached by key");

  // Two elements, and a duplicate key (the last write wins, as `+=` does).
  h2: hash<Kv703[k]> = [Kv703 { k: 5, v: 6 }, Kv703 { k: 7, v: 8 }];
  assert(len(h2) == 2, "hash local: two elements, got {len(h2)}");
  h2a = h2[5];
  h2b = h2[7];
  assert(h2a != null && h2a.v == 6, "hash local: first element");
  assert(h2b != null && h2b.v == 8, "hash local: second element");
  h3: hash<Kv703[k]> = [Kv703 { k: 5, v: 6 }, Kv703 { k: 5, v: 9 }];
  assert(len(h3) == 1, "hash local: duplicate key collapses, got {len(h3)}");
  h3a = h3[5];
  assert(h3a != null && h3a.v == 9, "hash local: duplicate key keeps the last");

  // The other keyed kinds take the same path.
  s: sorted<Kv703[k]> = [Kv703 { k: 5, v: 6 }];
  sa = s[5];
  assert(len(s) == 1 && sa != null && sa.v == 6, "sorted local, got {len(s)}");
  ix: index<Kv703[k]> = [Kv703 { k: 5, v: 6 }];
  ia = ix[5];
  assert(len(ix) == 1 && ia != null && ia.v == 6, "index local, got {len(ix)}");

  // Still usable afterwards — the literal built a real keyed collection, not a snapshot.
  h += Kv703 { k: 9, v: 10 };
  h9 = h[9];
  assert(len(h) == 2 && h9 != null && h9.v == 10, "hash local: still appendable");

  // Iteration reaches the elements.
  total = 0;
  for e in h2 { total += e.k + e.v; }
  assert(total == 26, "hash local: iteration, got {total}");

  // VALUE position: returned from a function, and passed as an argument.
  r = ret_hash_one();
  ra = r[5];
  assert(len(r) == 1 && ra != null && ra.v == 6, "returned keyed literal, got {len(r)}");
  assert(len(ret_hash_empty()) == 0, "returned empty keyed literal");
  assert(len(ret_sorted_empty()) == 0, "returned empty sorted literal");
  assert(take_hash([Kv703 { k: 5, v: 6 }]) == 1, "keyed literal as an argument");
  assert(take_hash([]) == 0, "empty keyed literal as an argument");

  // An empty `[]` in value position for element types the old hint never covered.
  assert(len(ret_vec_struct_empty()) == 0, "empty vector<struct> return");
  assert(len(ret_vec_text_empty()) == 0, "empty vector<text> return");

  // A returned empty keyed collection is a real one — fillable by the caller.
  f = ret_hash_empty();
  f += Kv703 { k: 1, v: 2 };
  f1 = f[1];
  assert(len(f) == 1 && f1 != null && f1.v == 2, "returned empty keyed is fillable");

  // Controls — none of the forms that already worked change.
  ec: hash<Kv703[k]> = [];
  assert(len(ec) == 0, "control: empty keyed local, got {len(ec)}");
  ec += Kv703 { k: 5, v: 6 };
  ea = ec[5];
  assert(len(ec) == 1 && ea != null && ea.v == 6, "control: += onto an empty keyed local");
  b = Box703 { h: [Kv703 { k: 5, v: 6 }] };
  ba = b.h[5];
  assert(len(b.h) == 1 && ba != null && ba.v == 6, "control: keyed struct-literal field");
  v: vector<Kv703> = [Kv703 { k: 5, v: 6 }];
  assert(len(v) == 1 && v[0].v == 6, "control: a plain vector literal, got {len(v)}");

  // The keyed field DEFAULT, refused until this literal had a value form to return.
  d = Dflt703 { x: 9 };
  d1 = d.h[1];
  assert(d.x == 9, "keyed default: x survives, got {d.x}");
  assert(len(d.h) == 1 && d1 != null && d1.v == 2, "keyed default: filled, got {len(d.h)}");
  d2 = Dflt703 { x: 8 };
  d.h += Kv703 { k: 3, v: 4 };
  assert(len(d.h) == 2 && len(d2.h) == 1,
         "keyed default: each record owns its own, got {len(d.h)} {len(d2.h)}");

  println("703-keyed-collection-literal-value ok");
}
