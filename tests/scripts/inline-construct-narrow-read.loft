//
// Native pre-eval fix: an INLINE `Struct{..}.field` read of a #rust-inline op
// (the byte/short field-read ops) whose receiver mutates stores (the inline
// construction) used to emit the op as an UNRESOLVED CALL on native —
// `dispatch.rs` hoisted the store-mutating arg into `_harg_*` and emitted
// `OpGetByteNullable(cell, _harg, ..)`, but a #rust-inline op has no callable fn.
// Now that path is gated on `rust().is_empty()`, so inline ops fall through to
// the normal emit which inlines the #rust body (its `let db = @v1; ..` sequences
// the mutating arg before the read borrow). Both backends.

struct B    { x: u8? }         struct BNN  { x: u8 not null }
struct S    { z: u16 }         struct SNN  { z: u16 not null }
struct I8s  { y: i8 }          struct I16s { w: i16 }

fn main() {
  // inline construct-and-read — the pattern that emitted an unresolved call
  assert(B    { x: 200 }.x   == 200,   "inline u8 nullable read");
  assert(BNN  { x: 255 }.x   == 255,   "inline u8 not-null max read");
  assert(S    { z: 5000 }.z  == 5000,  "inline u16 nullable read");
  assert(SNN  { z: 65535 }.z == 65535, "inline u16 not-null max read");
  assert(I8s  { y: -100 }.y  == -100,  "inline i8 nullable read");
  assert(I16s { w: 20000 }.w == 20000, "inline i16 nullable read");
  // null through the inline path too
  assert(B    { x: null }.x  == null,  "inline u8 nullable null read");
}
