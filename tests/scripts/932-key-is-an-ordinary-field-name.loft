//
// `key` is an ordinary field name on a keyed-collection element (loft#932).
//
// It was refused on a hash element — "reserved for hash iteration — rename the field" —
// because issue 83 hit a runtime panic ("Allocating a used store") on exactly the shape
// this file's first function runs.  The refusal outlived the panic by a long way, and
// three facts retired it rather than one:
//
//  · The pseudo-field it reserved does not exist.  `for kv in h { kv.key }` over an
//    element struct WITHOUT a real `key` field answers "Unknown field", not the hash key
//    — so a real field named `key` never had anything to collide with.  The name was
//    reserved for a feature that was never there.
//  · It only covered `hash`.  `typedef::fill_all` walks struct ATTRIBUTES looking for a
//    `Type::Hash`, so `sorted`/`index` were never checked and neither was any LOCAL — and
//    both spellings have shipped working all along (`146-keyed-rekey-through-view.loft`
//    builds on `sorted<Elm[key]>`, `135-hash-table-rebuild…` on `hash<Entry[key]>` locals).
//    A rule that holds in one of four positions is not a rule anyone can rely on.
//  · The panic no longer reproduces.  `pe_issue_83_program` below IS the program the
//    refusal was written for, and it runs.
//
// So the question the issue posed — extend the refusal to the local form, or narrow it —
// is answered by evidence rather than by taste: there is nothing left to refuse, and
// `key` is the natural name for a key field.  The FIELD form is what this file adds; the
// local form is asserted beside it so the two positions cannot drift apart again.

struct Entry {
  key: text,
  count: integer,
}

struct Db {
  data: hash<Entry[key]>,
}

// Keyed on `name`, with an unrelated real field also called `key` — the one shape where a
// pseudo-field would genuinely have been ambiguous, had one existed.  `e.key` is the field
// the author declared, and nothing else.
struct Tagged {
  name: text,
  key: text,
}

struct TaggedDb {
  h: hash<Tagged[name]>,
}

struct Elm {
  key: integer,
  tag: integer,
}

// The exact issue-83 program, which the refusal replaced with a compile error.
fn pe_issue_83_program() {
  db = Db { data: [] };
  db.data += [Entry { key: "hello", count: 1 }];
  e = db.data["hello"];
  assert(e != null, "932 issue-83 entry should exist");
  assert(e.count == 1, "932 issue-83 count {e.count}, want 1");
  assert(e.key == "hello", "932 issue-83 key {e.key}, want hello");
}

// A hash FIELD keyed on `key`: insert, look up, remove, iterate.
fn pe_hash_field() {
  db = Db { data: [] };
  db.data += [Entry { key: "a", count: 1 }, Entry { key: "b", count: 2 }];
  assert(len(db.data) == 2, "932 field len {len(db.data)}, want 2");
  assert(db.data["b"].count == 2, "932 field lookup {db.data[\"b\"].count}, want 2");

  db.data["a"] = null;
  assert(db.data["a"] == null, "932 field removed entry still found");
  assert(len(db.data) == 1, "932 field len after remove {len(db.data)}, want 1");

  db.data += [Entry { key: "c", count: 3 }];
  sum = 0;
  seen = "";
  for e in db.data {
    sum += e.count;
    seen += e.key;
  }
  assert(sum == 5, "932 field iterated sum {sum}, want 5");
  assert(len(seen) == 2, "932 field iterated {len(seen)} keys, want 2");
}

// The same collection as a LOCAL — the position the refusal never inspected, so it has
// always run.  Asserted here so the field form and the local form stay one behaviour.
fn pe_hash_local() {
  h: hash<Entry[key]> = [Entry { key: "a", count: 1 }, Entry { key: "b", count: 2 }];
  assert(h["a"].count == 1, "932 local lookup {h[\"a\"].count}, want 1");
  sum = 0;
  for e in h {
    sum += e.count;
  }
  assert(sum == 3, "932 local iterated sum {sum}, want 3");
}

// A real `key` field that is NOT the collection's key.  `e.key` reads the declared field;
// the key the hash is built on is `name`, and the two never merge.
fn pe_key_field_is_not_the_hash_key() {
  d = TaggedDb { h: [Tagged { name: "n", key: "hello" }] };
  e = d.h["n"];
  assert(e.key == "hello", "932 unrelated key field {e.key}, want hello");
  assert(e.name == "n", "932 unrelated name {e.name}, want n");
}

// The sibling keyed kinds the refusal never covered.  They accepted this shape while
// `hash` refused it, which is the inconsistency that made the rule unlearnable.
fn pe_other_keyed_kinds() {
  s: sorted<Elm[key]> = [Elm { key: 30, tag: 333 }, Elm { key: 10, tag: 111 }];
  assert(s[10].tag == 111, "932 sorted {s[10].tag}, want 111");

  i: index<Elm[key]> = [Elm { key: 7, tag: 77 }];
  assert(len(i) == 1, "932 index len {len(i)}, want 1");
}

fn main() {
  pe_issue_83_program();
  pe_hash_field();
  pe_hash_local();
  pe_key_field_is_not_the_hash_key();
  pe_other_keyed_kinds();
  println("932 ok");
}
