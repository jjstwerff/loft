//
// A generic instantiated at `vector<X>` first refused every later instantiation at a
// scalar `X` — and the reverse order compiled.
//
// A monomorph is named `t_<LEN><Type>_<fn>`, which is also the spelling of a METHOD on
// `<Type>`.  The name was built from the concrete type's DEF, and a collection's def is the
// bare `vector` / `hash` / …, which erases the element: `T = vector<integer>` and
// `T = vector<text>` both mangled to `t_6vector_idl`.  So the first collection
// instantiation published itself as a method on `vector`, and every later call whose
// argument was any vector at all dispatched to it — including the call that wanted
// `T = integer`, which was then refused against the monomorph's `vector<vector<integer>>`
// parameter and never reached generic resolution.
//
// The message named the second call site, which is correct and useless: nothing is wrong
// there, and a generic helper used once with a nested collection simply stopped accepting
// anything else for the rest of the file.
//
// Keying the name on the CONCRETE type's own name fixes it.  Non-collection concretes are
// unchanged — a struct's, an integer's and a text's type-def name IS their own name, which
// is why a `vector<S>` instantiation never showed this: it binds `T = S`.

pub fn idl1024 < T > (v: vector<T>) -> integer { len(v) }

struct S1024 { a: integer }

fn test_a_collection_instantiation_does_not_capture_a_later_scalar_one() {
  // The filed order: the WIDER instantiation first.
  vv: vector<vector<integer>> = [[1], [2]];
  a = idl1024(vv);
  b = idl1024([1, 2, 3]);
  assert(a == 2, "the nested vector has two elements, got {a}");
  assert(b == 3, "the flat vector has three, got {b}");
}

fn test_the_reverse_order_still_works() {
  // This order always compiled, so it is the cell that proves the fix did not simply
  // move the breakage.
  b = idl1024([1, 2, 3]);
  vv: vector<vector<integer>> = [[1], [2]];
  a = idl1024(vv);
  assert(a == 2 && b == 3, "both instantiations answer their own length, got {a} {b}");
}

fn test_two_collection_instantiations_differing_only_in_element_type() {
  // Both mangled to the same name before, so the second was refused against the first's
  // parameter type.  This is the cell the element-erasure causes directly.
  vi: vector<vector<integer>> = [[1], [2]];
  vt: vector<vector<text>> = [["a"], ["b"], ["c"]];
  a = idl1024(vi);
  b = idl1024(vt);
  assert(a == 2, "the integer-nested vector has two, got {a}");
  assert(b == 3, "the text-nested vector has three, got {b}");
}

fn test_a_collection_instantiation_beside_a_text_one() {
  vv: vector<vector<integer>> = [[1], [2]];
  a = idl1024(vv);
  b = idl1024(["x", "y", "z"]);
  assert(a == 2 && b == 3, "a vector then a text instantiation, got {a} {b}");
}

fn test_a_struct_instantiation_is_unchanged() {
  // `T = S` names a method on `S`, and the argument is a `vector<S>`, so this never
  // captured anything — the control for the naming change.
  vs: vector<S1024> = [S1024 { a: 1 }];
  a = idl1024(vs);
  b = idl1024([1, 2, 3]);
  assert(a == 1 && b == 3, "a struct then a scalar instantiation, got {a} {b}");
}
