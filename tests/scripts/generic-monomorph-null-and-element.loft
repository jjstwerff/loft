//
// A monomorph decides `??` and `v[i]` the way the CONCRETE function would.
//
// `formal/interfaces.md` `(G-Mono)` says a specialised copy behaves as the hand-written
// concrete one would, and names one recurring way that fails: an operation whose choice
// is a function of `τ` gets DECIDED while `τ` is still the type variable, and
// substitution then rewrites the TYPE and leaves the CHOICE behind.  loft#1016 (`x?`'s
// default), #1020 (`x == null`), #1028 (a `null` literal) and #1032 (a yield channel)
// were each that.  Two more sites were, and this file is their sweep:
//
//   1. **The `??` null CHECK.**  Built from the subject's type — a DbRef's `rec`, a
//      boolean's `255`, a character's `char(0)`, a tuple's first field.  In a template
//      that type is the placeholder, an attribute-less struct, so the reference arm won
//      and baked `rec != 0`.  A partial name map tried to repair it afterwards and
//      listed integer / text / float / single / enum, ending `_ => None` — so `boolean`
//      and `character` fell through it silently.  Measured: `x ?? fb` LOOPED FOREVER at
//      `T = boolean` and corrupted a record at `T = character` on `--interpret`, and
//      `--native` refused to compile either monomorph (`u8` / `i32` "doesn't have
//      fields").  The check is now DEFERRED, the way `== null` already was.
//
//   2. **The element READ.**  `wrap_vector_get_val` picks the value-extraction op from
//      the element type and ended `_ => return code` — which reads as "everything else
//      is reference-shaped" and was not.  `character` and a VALUE enum both need
//      unpacking and fell through, so `v[1]` handed back the address as the value:
//      a garbage codepoint for `['a','b']` and `null` for `[Col::Blue, Col::Green]`,
//      on BOTH backends, while the concrete twin was right.
//
// The sweep is over the CONCRETE type because that is the axis the corpus was missing:
// at `T = text` or a struct a reference IS the answer, so every cell here passed before
// the fix at those types.  They stay as the controls that pass for the wrong reason.
// Every cell also states what the hand-written concrete twin answers, since agreement
// between the two backends is not the oracle — `(G-Mono)` is.

enum Mcol { Red, Blue, Green }
struct Mrec { a: integer }

pub fn m_coal<T>(fb: T, x: T?) -> T { x ?? fb }
pub fn m_qdef<T>(fb: T, x: T?) -> T { _ = fb; x? }
pub fn m_ncr<T>(fb: T, x: T?) -> T { y = x ?? return fb; y }
pub fn m_oob<T>(v: vector<T>, fb: T) -> T { v[9] ?? fb }
pub fn m_in<T>(v: vector<T>, fb: T) -> T { v[0] ?? fb }
pub fn m_elem<T>(v: vector<T>) -> T { v[1] }

// A generic calling a generic: at `inner`'s instantiation `T` is still `outer`'s type
// VARIABLE, so the deferred site must stay deferred and be answered at the OUTER
// instantiation — never at the inner one, where the answer does not exist yet.
pub fn m_inner<T>(fb: T, x: T?) -> T { x ?? fb }
pub fn m_outer<S>(fb: S, x: S?) -> S { m_inner(fb, x) }

// The hand-written twins, for the two types the deferral was missing.  Each is the
// oracle for the monomorph beside it, not merely a second opinion.
// The fallback is baked rather than passed: two trailing boolean parameters are what
// the `trailing-boolean-parameters` advice is for, and a guard should not model the
// shape it advises against.
fn twin_coal_bool(x: boolean?) -> boolean { x ?? true }
fn twin_coal_char(fb: character, x: character?) -> character { x ?? fb }
fn twin_elem_char(v: vector<character>) -> character { v[1] }
fn twin_elem_enum(v: vector<Mcol>) -> Mcol { v[1] }

fn test_coalesce_uses_the_concrete_types_null_test() {
  // `boolean` and `character` are the cells that hung and corrupted; the rest are the
  // controls.  Each pair asks for the fallback AND the value, so a check that answers
  // one constant for everything cannot pass.
  assert(m_coal(-77, null) == -77, "integer fallback");
  assert(m_coal(-77, 11) == 11, "integer value");
  assert(m_coal(1.25, null) == 1.25, "float fallback");
  assert(m_coal(1.25, 9.5) == 9.5, "float value");
  assert(m_coal(1.25 as single, null) == 1.25 as single, "single fallback");
  assert(m_coal(1.25 as single, 9.5 as single) == 9.5 as single, "single value");

  assert(m_coal(true, null) == true, "boolean fallback: got {m_coal(true, null)}");
  // The load-bearing cell: `false` is a VALUE, not a missing one, so the fallback must
  // NOT win here.  A truthiness test in place of a null test passes the line above and
  // fails this one.
  assert(m_coal(true, false) == false, "boolean value: got {m_coal(true, false)}");
  assert(m_coal('q', null) == 'q', "character fallback: got {m_coal('q', null)}");
  assert(m_coal('q', 'a') == 'a', "character value: got {m_coal('q', 'a')}");

  assert(m_coal("zz", null) == "zz", "text fallback");
  assert(m_coal("zz", "aa") == "aa", "text value");
  assert(m_coal(Mcol::Green, null) == Mcol::Green, "enum fallback");
  assert(m_coal(Mcol::Green, Mcol::Blue) == Mcol::Blue, "enum value");
  assert(m_coal(Mrec { a: -77 }, null).a == -77, "struct fallback");
  assert(m_coal(Mrec { a: -77 }, Mrec { a: 11 }).a == 11, "struct value");
  assert(m_coal([-77], null)[0] == -77, "vector fallback");
  assert(m_coal([-77], [11])[0] == 11, "vector value");
}

fn test_the_monomorph_answers_what_the_concrete_twin_answers() {
  // `(G-Mono)` stated as an assertion: the specialised copy and the hand-written
  // function are asked the same question and must give the same answer.
  assert(m_coal(true, null) == twin_coal_bool(null), "boolean fallback vs twin");
  assert(m_coal(true, false) == twin_coal_bool(false), "boolean value vs twin");
  assert(m_coal('q', null) == twin_coal_char('q', null), "character fallback vs twin");
  assert(m_coal('q', 'a') == twin_coal_char('q', 'a'), "character value vs twin");
  assert(m_elem(['a', 'b']) == twin_elem_char(['a', 'b']), "character element vs twin");
  assert(m_elem([Mcol::Blue, Mcol::Green]) == twin_elem_enum([Mcol::Blue, Mcol::Green]),
         "enum element vs twin");
}

fn test_every_coalesce_spelling_defers() {
  // `x?` and `x ?? return d` reach the same decision by different routes, so a fix that
  // only covered `x ?? d` leaves two thirds of the surface broken.
  assert(m_qdef(true, null) == false, "x? boolean default: got {m_qdef(true, null)}");
  assert(m_qdef(true, false) == false, "x? boolean value");
  assert(m_qdef(-77, null) == 0, "x? integer default");
  assert(m_qdef(-77, 11) == 11, "x? integer value");
  assert(m_qdef('q', 'a') == 'a', "x? character value: got {m_qdef('q', 'a')}");

  assert(m_ncr(true, null) == true, "?? return boolean fallback: got {m_ncr(true, null)}");
  assert(m_ncr(true, false) == false, "?? return boolean value: got {m_ncr(true, false)}");
  assert(m_ncr('q', null) == 'q', "?? return character fallback");
  assert(m_ncr('q', 'a') == 'a', "?? return character value");
  assert(m_ncr(-77, null) == -77, "?? return integer fallback");
  assert(m_ncr(-77, 11) == 11, "?? return integer value");
}

fn test_an_element_read_unpacks_the_concrete_types_slot() {
  // Asks for element 1, never element 0: a read that ignores the index answers the
  // first element and would pass a `v[0]` cell for the wrong reason.
  assert(m_elem([11, 12]) == 12, "integer element");
  assert(m_elem([9.5, 8.5]) == 8.5, "float element");
  assert(m_elem([9.5 as single, 8.5 as single]) == 8.5 as single, "single element");
  assert(m_elem([false, true]) == true, "boolean element");
  assert(m_elem(['a', 'b']) == 'b', "character element: got {m_elem(['a', 'b'])}");
  assert(m_elem(["aa", "bb"]) == "bb", "text element");
  assert(m_elem([Mcol::Blue, Mcol::Green]) == Mcol::Green,
         "enum element: got {m_elem([Mcol::Blue, Mcol::Green])}");
  assert(m_elem([Mrec { a: 11 }, Mrec { a: 12 }]).a == 12, "struct element");
}

fn test_a_coalesce_over_an_element_read() {
  // The null the check sees now comes from a READ rather than from a parameter — the
  // spelling that first showed the boolean cell answering `null` instead of either arm.
  assert(m_oob([11, 12], -77) == -77, "integer out of range");
  assert(m_in([11, 12], -77) == 11, "integer in range");
  assert(m_oob([false, true], true) == true, "boolean out of range: got {m_oob([false, true], true)}");
  assert(m_in([false, true], true) == false, "boolean in range: got {m_in([false, true], true)}");
  assert(m_oob(['a', 'b'], 'q') == 'q', "character out of range");
  assert(m_in(['a', 'b'], 'q') == 'a', "character in range: got {m_in(['a', 'b'], 'q')}");
  assert(m_oob(["aa", "bb"], "zz") == "zz", "text out of range");
  assert(m_in(["aa", "bb"], "zz") == "aa", "text in range");
}

fn test_a_nested_generic_stays_deferred() {
  // The inner call is instantiated at the OUTER template's type variable, so answering
  // it there would bake the placeholder's own shape a second time.
  assert(m_outer(true, null) == true, "nested boolean fallback: got {m_outer(true, null)}");
  assert(m_outer(true, false) == false, "nested boolean value: got {m_outer(true, false)}");
  assert(m_outer('q', null) == 'q', "nested character fallback");
  assert(m_outer('q', 'a') == 'a', "nested character value");
  assert(m_outer(-77, null) == -77, "nested integer fallback");
  assert(m_outer(-77, 11) == 11, "nested integer value");
}

fn main() {
  test_coalesce_uses_the_concrete_types_null_test();
  test_the_monomorph_answers_what_the_concrete_twin_answers();
  test_every_coalesce_spelling_defers();
  test_an_element_read_unpacks_the_concrete_types_slot();
  test_a_coalesce_over_an_element_read();
  test_a_nested_generic_stays_deferred();
  print("generic-monomorph-null-and-element ok\n");
}
