// A generator that yields a value carried as a DbRef — the channel the corpus never
// exercised.
//
// Before this file, `tests/scripts` yielded `integer` (45 files), `text` (10), `single` and
// `float`, and NOTHING carried by handle.  The whole DbRef yield channel was uncovered, which
// is why the gap below survived: `generation/coroutine.rs` chose the channel with an inline
// `matches!(yield_tp, Reference | Vector | Enum(_, true, _))` — three of the EIGHT types that
// travel as a `DbRef` (`element_stack_size` is the authority).  A generator over a keyed
// collection therefore took the `next_i64` channel for a handle: a raw rustc `E0605` on
// `--native`, and `BUG (#306)` on `--interpret`.  Both sites now read `data::is_dbref`.
//
// The KEYED cells below were the second half, and they had a SECOND site with the same short
// list: `collections.rs` binds the consumer's loop variable as a BORROW of the generator
// (`x: ref(E)["___gen_1"]`) so the per-iteration free is never emitted — but only for
// `Reference | Enum(_, true, _) | Vector`.  A keyed yield bound `x` with NO dep, the scope
// machinery read it as an OWNER, and the free that arm exists to prevent produced exactly the
// `BUG (#306)` its own comment describes.  Both sites now read `data::is_dbref`.
//
// `spatial` is here because `coroutine_layout::next_operands` lists six of the eight
// (no Radix, no Trie) — that turned out not to bite, and this cell is what keeps it that way.

struct CyE { k: integer, v: text }

// A VECTOR element — a DbRef yield that works on both backends, and the cell that shows the
// keyed failure is about the type set rather than about DbRef yields as such.
fn test_yielding_a_vector() {
  total = 0;
  seen = 0;
  for v in cy_vectors() {
    total += len(v);
    seen += 1;
  }
  assert(seen == 2, "iterations: {seen}");
  assert(total == 5, "total length across both yields: {total}");
}

fn cy_vectors() -> iterator<vector<integer>> {
  a: vector<integer> = [1, 2];
  yield a;
  b: vector<integer> = [3, 4, 5];
  yield b;
}

// A STRUCT reference — the other DbRef shape that works on both backends.
fn test_yielding_a_struct_reference() {
  sum = 0;
  names = "";
  for e in cy_structs() {
    sum += e.k;
    names += e.v;
  }
  assert(sum == 3, "summed keys: {sum}");
  assert(names == "ab", "concatenated values: {names}");
}

fn cy_structs() -> iterator<CyE> {
  yield CyE { k: 1, v: "a" };
  yield CyE { k: 2, v: "b" };
}

// The scalar channel beside them, so a change that repaired the DbRef channel by breaking the
// integer one cannot pass this file.
fn test_the_scalar_channel_is_unaffected() {
  n = 0;
  for i in cy_ints() { n += i; }
  assert(n == 6, "scalar yields: {n}");
}

fn cy_ints() -> iterator<integer> {
  yield 1;
  yield 2;
  yield 3;
}

// A KEYED collection — the shape that failed on both backends for two different reasons.
fn test_yielding_a_keyed_collection() {
  total = 0;
  seen = 0;
  for h in cy_hashes() {
    total += len(h);
    seen += 1;
  }
  assert(seen == 2, "iterations: {seen}");
  assert(total == 3, "total across both yields: {total}");
}

fn cy_hashes() -> iterator<hash<CyE[k]>> {
  a: hash<CyE[k]> = [CyE { k: 1, v: "a" }];
  yield a;
  b: hash<CyE[k]> = [CyE { k: 2, v: "b" }, CyE { k: 3, v: "c" }];
  yield b;
}

// A SORTED collection, so the cell set is not one keyed kind standing for five.
fn test_yielding_a_sorted_collection() {
  total = 0;
  for s in cy_sorted() { total += len(s); }
  assert(total == 2, "sorted yields: {total}");
}

fn cy_sorted() -> iterator<sorted<CyE[k]>> {
  a: sorted<CyE[k]> = [CyE { k: 1, v: "a" }, CyE { k: 2, v: "b" }];
  yield a;
}

// A SPATIAL collection — `Parts::Radix`, one of the two `next_operands` does not list.
fn test_yielding_a_spatial_collection() {
  total = 0;
  for s in cy_spatial() { total += len(s); }
  assert(total == 1, "spatial yields: {total}");
}

struct CyP { x: integer, y: integer, n: text }

fn cy_spatial() -> iterator<spatial<CyP[x, y]>> {
  a: spatial<CyP[x, y]> = [CyP { x: 1, y: 2, n: "a" }];
  yield a;
}

// The generator keeps its own value across the yield — the cell that says the handover is a
// BORROW by the consumer rather than a move, which is why two owners was the failure mode.
fn test_the_generator_still_owns_its_value_after_yielding() {
  ok = false;
  for h in cy_checks_itself() { ok = len(h) == 1; }
  assert(ok, "the consumer saw the yielded collection");
}

fn cy_checks_itself() -> iterator<hash<CyE[k]>> {
  a: hash<CyE[k]> = [CyE { k: 1, v: "a" }];
  yield a;
  assert(len(a) == 1, "the generator lost its own value at the yield: {len(a)}");
}
