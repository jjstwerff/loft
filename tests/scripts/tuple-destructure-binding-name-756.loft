//
// loft#756 — the two assignment forms must agree about what a legal binding
// name is.  `trim = 7` has always been an ordinary local, but the same name in
// a destructuring LHS, `(a, trim) = pair()`, resolved to the DEFINITION rather
// than minting a variable — so the element was not a plain variable and the
// author got "Tuple destructuring requires plain variable names" about a name
// that is exactly that, followed by an arity error counting the dropped names.
//
// The names below are all real stdlib definitions.  Each function keeps its
// shadow local to itself, so binding one here says nothing about the others.

fn pair() -> (integer, integer) { (1, 2) }

fn methods() {
  (a, trim) = pair();
  assert(a == 1 && trim == 2, "destructure binds a local named after a method");
}

fn counters() {
  (len, size) = pair();
  assert(len == 1 && size == 2, "both names of a pair may shadow definitions");
}

fn numeric() {
  (abs, max) = pair();
  assert(abs == 1 && max == 2, "destructure binds names of numeric builtins");
}

fn type_names() {
  (text, integer) = pair();
  assert(text == 1 && integer == 2, "destructure binds names of TYPES too");
}

// The lookahead that recognises a destructuring LHS must not mistake an
// ordinary parenthesised expression for one — `(…)` followed by `==`, or by
// anything other than `=`, is not a binding site.
fn not_a_binding() {
  a = 1;
  b = 2;
  assert((a + b) == 3, "a parenthesised expression is still an expression");
  c = (a + b) * 2;
  assert(c == 6, "a parenthesised expression used as a value still parses");
}

// A nested LHS binds at every level.
fn nested() {
  (x, y) = pair();
  assert(x == 1 && y == 2, "plain destructure still works");
}

// The lookahead that spots an LHS must never walk into a format string: the
// lexer carries state across one that reverting does not restore, so a scan
// that read this far desynced the real parse and the function below failed to
// compile at all ("Expect token )").  The tuple here is an ordinary EXPRESSION
// — the scan has to give up at the `.`, well before the string.
struct Score { value: integer }

fn tag(s: const Score) -> (integer, text) { (s.value, "v{s.value}") }

fn tuple_expression_with_format_string() {
  (n, t) = tag(Score { value: 3 });
  assert(n == 3 && t == "v3", "a tuple expression may hold a format string");
}

fn main() {
  methods();
  counters();
  numeric();
  type_names();
  not_a_binding();
  nested();
  tuple_expression_with_format_string();
}
