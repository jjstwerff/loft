//
// A local a closure captured, and then ASSIGNED AGAIN, frees the store it ends up holding
// (loft#1388).
//
// `formal/ownership.md` `(O-Latest)`: ownership belongs to the LATEST assignment at that
// point.  A closure record adopts the store its capture named AT THE BUILD, and the frame's
// scope-exit free is suppressed so the record's cascade is the sole owner (#323).  The
// suppression has to name the same STORE the adoption does, or the two decisions disagree —
// which is loft#1324, closed for the COLLECTION half, where the capture names a view and
// `capture_build_backings` finds the backing local.  The DIRECT half asked `is_captured(v)`,
// a fact about the BINDING, and went on suppressing the free of whatever the local named
// LAST.  So a local reassigned after the build leaked the store it ended up holding, on both
// backends, once per reassignment and once per pass of a loop, with the right answer printed
// and only the exit warning to say so.
//
// Both spellings of the build reach it and both are here, because they differ in ORDER: a
// STORED closure is built by an earlier statement, while an inline argument is built inside
// the very right-hand side that reassigns the local — `s = build(|i| { s.a + i })` hands the
// record the store `s` is about to stop naming.  `Value::walk` is pre-order, so the second
// shape's build is reached after its own assignment and had to be read off the right-hand
// side directly (`captures_built_in`), against the map as it stood BEFORE the assignment.
//
// The CONTROLS are what keep the widening honest: a capture that is never reassigned must
// still hand its store to the record (freeing it in the frame as well would be the #323
// over-free, and an escaping closure would read a released store), and a literal right-hand
// side rebuilds in place and mints nothing to leak.
//
// `main` calls every cell and is what scores this guard: `--tests` does not leak-check
// (`scripts/falsify.sh` § ONE CHANNEL IS BLIND).  `tests/wrap.rs::run_test` runs `main` when
// a file has one and leak-checks it on both backends.
//
// @falsified-at: ac412a96 — interpret and native both leaked `kt=81 S×3, kt=25
//   main_vector<integer>×1` -> clean.  Every control unmoved.

struct S { a: integer, b: text }

fn build(f: fn(integer) -> integer) -> S { S{a: f(1), b: "built"} }
fn build_v(f: fn(integer) -> integer) -> vector<integer> { [f(1), f(2)] }

fn test_an_inline_closure_argument() {
  s = S{a: 1, b: "x"};
  s = build(|i| { s.a + i });
  assert(s.a == 2, "inline: got {s.a}, want 2");
}

fn test_an_inline_closure_argument_twice() {
  s = S{a: 1, b: "x"};
  s = build(|i| { s.a + i });
  s = build(|i| { s.a + i });
  assert(s.a == 3, "inline twice: got {s.a}, want 3");
}

fn test_a_stored_closure() {
  s = S{a: 1, b: "x"};
  h: fn(integer) -> integer = |i| { s.a + i };
  s = build(h);
  assert(s.a == 2, "stored: got {s.a}, want 2");
}

fn test_an_inline_closure_over_a_vector() {
  v = [1, 2];
  v = build_v(|i| { (v[0] ?? 0) + i });
  assert((v[0] ?? 0) == 2 && (v[1] ?? 0) == 3, "vector inline: got {v[0] ?? 0},{v[1] ?? 0}, want 2,3");
}

fn test_a_stored_closure_over_a_vector() {
  v = [1, 2];
  g: fn(integer) -> integer = |i| { (v[0] ?? 0) + i };
  v = build_v(g);
  assert((v[0] ?? 0) == 2 && (v[1] ?? 0) == 3, "vector stored: got {v[0] ?? 0},{v[1] ?? 0}, want 2,3");
}

fn test_a_capture_never_reassigned_is_the_records() {
  s = S{a: 1, b: "x"};
  h: fn(integer) -> integer = |i| { s.a + i };
  n = h(5);
  assert(n == 6 && s.a == 1, "never reassigned: got {n} {s.a}, want 6 1");
}

fn test_a_literal_right_hand_side_rebuilds_in_place() {
  s = S{a: 1, b: "x"};
  h: fn(integer) -> integer = |i| { s.a + i };
  s = S{a: 7, b: "lit"};
  assert(s.a == 7 && h(5) == 12, "literal rhs: got {s.a} {h(5)}, want 7 12");
}

fn main() {
  test_an_inline_closure_argument();
  test_an_inline_closure_argument_twice();
  test_a_stored_closure();
  test_an_inline_closure_over_a_vector();
  test_a_stored_closure_over_a_vector();
  test_a_capture_never_reassigned_is_the_records();
  test_a_literal_right_hand_side_rebuilds_in_place();
}
