//
// @PLN110 — golden pin of the whole text surface AFTER the len/size flip.
//
// `len(text)` = CHARACTER count; `size(text)` = BYTE count (@PLN110 Phase 2a).
//
//   * Section A pins the len (character count) / size (byte count) values across
//     ASCII / 2- / 3- / 4-byte / mixed inputs.
//   * Section B (BYTE-WORLD STABILITY) — byte offsets (`s[p]`, slices, `find`,
//     `byte_at`) and character iteration — is byte-positioned and did NOT move in
//     the flip; it proves the flip touched only `len`/`size`.
//
// UTF-8 widths used below: 'é'=2 bytes (0xC3 0xA9 = 195,169), '♥'=3 bytes
// (0xE2 0x99 0xA5 = 226,153,165), CJK '日'/'本'=3 bytes each, '😃'=4 bytes.

fn main() {
  ascii = "hello"; // 5 bytes, 5 chars
  cafe = "café"; // 5 bytes, 4 chars
  heart = "♥"; // 3 bytes, 1 char
  cjk = "日本"; // 6 bytes, 2 chars
  emoji = "😃"; // 4 bytes, 1 char
  mix = "a♥b"; // 5 bytes, 3 chars

  // ===================================================================
  // SECTION A — len = CHARACTER count, size = BYTE count (@PLN110).
  // ===================================================================
  // len = character count (the human count)
  assert(len(ascii) == 5, "A: len ascii chars");
  assert(len(cafe) == 4, "A: len café chars");
  assert(len(heart) == 1, "A: len heart chars");
  assert(len(cjk) == 2, "A: len cjk chars");
  assert(len(emoji) == 1, "A: len emoji chars");
  assert(len(mix) == 3, "A: len mix chars");
  // size = byte count (the byte-indexing bound)
  assert(size(ascii) == 5, "A: size ascii bytes");
  assert(size(cafe) == 5, "A: size café bytes");
  assert(size(heart) == 3, "A: size heart bytes");
  assert(size(cjk) == 6, "A: size cjk bytes");
  assert(size(emoji) == 4, "A: size emoji bytes");
  assert(size(mix) == 5, "A: size mix bytes");
  // Cross-check: len==size only for pure ASCII; they diverge on multi-byte.
  assert(len(ascii) == size(ascii), "A: ascii len==size (no multibyte)");
  assert(len(cafe) != size(cafe), "A: café len!=size (multibyte diverges)");

  // ===================================================================
  // SECTION B — BYTE-WORLD STABILITY.  Must stay GREEN across the flip.
  // ===================================================================

  // --- byte_at: raw O(1) byte read, byte-indexed, 0 when out of range ---
  assert(cafe.byte_at(0) == 99, "B: byte_at café[0]='c'");
  assert(cafe.byte_at(3) == 195, "B: byte_at café[3]=é lead");
  assert(cafe.byte_at(4) == 169, "B: byte_at café[4]=é continuation");
  assert(cafe.byte_at(5) == 0, "B: byte_at café[5] out-of-range -> 0");
  assert(mix.byte_at(1) == 226, "B: byte_at mix[1]=♥ lead");

  // --- s[p]: byte-positioned char read; a mid-char byte snaps to the char's start ---
  assert(mix[0] == 'a', "B: mix[0]=a");
  assert(mix[1] == '♥', "B: mix[1]=♥ (byte 1 = ♥ lead)");
  assert(mix[2] == '♥', "B: mix[2] snaps back to ♥ (continuation byte)");
  assert(mix[3] == '♥', "B: mix[3] snaps back to ♥ (continuation byte)");
  assert(mix[4] == 'b', "B: mix[4]=b");
  assert(cafe[3] == 'é', "B: café[3]=é lead");
  assert(cafe[4] == 'é', "B: café[4] snaps back to é");

  // --- slices s[a..b]: byte offsets, snapping to char boundaries ---
  assert(mix[0..1] == "a", "B: slice mix[0..1]");
  assert(mix[1..4] == "♥", "B: slice mix[1..4] = ♥ (3 bytes)");
  assert(mix[0..4] == "a♥", "B: slice mix[0..4]");
  assert(mix[4..5] == "b", "B: slice mix[4..5]");
  assert(mix[1..] == "♥b", "B: open slice mix[1..]");
  assert(cafe[0..3] == "caf", "B: slice café[0..3]");
  assert(cafe[3..5] == "é", "B: slice café[3..5] = é");

  // --- find/rfind: return a BYTE offset (null when absent) ---
  assert(mix.find("♥") == 1, "B: find ♥ at byte 1");
  assert(mix.find("b") == 4, "B: find b at byte 4");
  assert(mix.find("z") == null, "B: find absent -> null");
  assert(cafe.find("é") == 3, "B: find é at byte 3");
  assert(cjk.find("本") == 3, "B: find 本 at byte 3");

  // --- character iteration: count == char count (== len) ---
  n_mix = 0;
  for _ in mix { n_mix += 1; }
  assert(n_mix == 3, "B: iterate mix -> 3 chars");
  n_cjk = 0;
  last_index = -1;
  for c in cjk {
    n_cjk += 1; last_index = c#index;
  }
  assert(n_cjk == 2, "B: iterate cjk -> 2 chars");
  assert(last_index == 3, "B: cjk last char #index = byte 3");
}
