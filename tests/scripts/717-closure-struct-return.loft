// loft#717 — a closure that CAPTURES something and whose body CALLS a function
// returning a STRUCT segfaulted the interpreter, while `--native` was correct.
//
// The interpreter's `CallRef` pushes the hidden arguments the bytecode does not:
// one buffer per hidden attribute (the aggregate return buffer), then the closure
// record, read back from the fn-ref slot. That read re-expresses its offset
// against the shifted top-of-stack — and the shift was accumulated as 12 bytes
// per buffer, the size a `DbRef` measures, where `put_stack` steps the slot to
// its alignment and actually moves 16. Every hidden buffer therefore put the
// closure read 4 bytes short, and the callee received a garbage closure `DbRef`.
//
// Neither half is visible on its own, which is why this shape and no simpler one
// reproduces it:
//   - no capture       -> no closure to read, so the short offset hits nothing
//   - no struct return -> no hidden buffer, so the shift is zero
// It takes BOTH. The axes below pin each one rather than only the pair, so a
// future change that breaks one of them fails here with a name attached.
//
// The captured value need not be the call's argument (`q` below): what matters
// is that a capture EXISTS, because the fault is frame layout, not data flow.
// Values are distinct from one another so an assertion says WHICH value came
// back, not merely that something did.
//
// Every call result is BOUND to a local before being read. That is not
// incidental: using a closure's struct result inline (`pt(0).a`) leaks the
// runtime-allocated hidden buffer — a separate, pre-existing defect that is
// unchanged by this fix and tracked on its own. Binding keeps this guard about
// the crash.

struct SrPoint {
  a: float,
  b: float,
}

struct SrPair {
  first: integer,
  second: integer,
}

fn sr_make(v: float) -> SrPoint {
  SrPoint { a: v, b: v * 2.0 }
}

fn sr_pair(n: integer) -> SrPair {
  SrPair { first: n, second: n * 10 }
}

fn sr_double(v: float) -> float {
  v * 2.0
}

fn main() {
  // The reported shape: capture a float, call a struct-returning function.
  k = 4.0;
  pt = fn(i: integer) -> SrPoint { sr_make(k) };
  got = pt(0);
  assert(got.a == 4.0, "the captured value reaches the called function");
  assert(got.b == 8.0, "and the struct's other field is built from it");

  // Called repeatedly: each call re-pushes the hidden buffer and re-reads the
  // closure, so a short offset would not survive a second round.
  total = 0.0;
  for r in 0..8 {
    step = pt(r);
    total += step.a;
  }
  assert(total == 32.0, "eight calls each return the same captured 4.0");

  // An INTEGER capture — the fault was frame layout, not the captured type.
  n = 7;
  pr = fn(i: integer) -> SrPair { sr_pair(n) };
  p = pr(0);
  assert(p.first == 7, "an integer capture survives the same path");
  assert(p.second == 70, "including a field derived from it");

  // The capture is NOT the call's argument: the call takes a constant and the
  // capture is only read separately. This crashed before the fix too.
  m = 3.0;
  q = fn(i: integer) -> SrPoint { _ = m; sr_make(1.0) };
  qv = q(0);
  assert(qv.a == 1.0, "a capture that never reaches the call still lays the frame out");

  // --- the axes, each of which alone is NOT enough -----------------------
  // No capture: the closure still returns a struct through a hidden buffer.
  nc = fn(i: integer) -> SrPoint { sr_make(2.0) };
  ncv = nc(0);
  assert(ncv.a == 2.0, "a struct-returning closure with no capture");

  // No call: the same struct built inline, with a capture.
  j = 5.0;
  ni = fn(i: integer) -> SrPoint { SrPoint { a: j, b: 1.0 } };
  niv = ni(0);
  assert(niv.a == 5.0, "a capturing closure that builds its struct inline");

  // A capture and a call, but the call returns a SCALAR — no hidden buffer.
  s = 6.0;
  sc = fn(i: integer) -> float { sr_double(s) };
  assert(sc(0) == 12.0, "a capturing closure calling a scalar-returning function");

  // Two captures and a struct return: the BUFFER count drives the offset, not
  // the capture count, so a second capture must not shift it further.
  x = 1.0;
  y = 9.0;
  two = fn(i: integer) -> SrPoint { SrPoint { a: x, b: y } };
  tv = two(0);
  assert(tv.a == 1.0, "first of two captures");
  assert(tv.b == 9.0, "second of two captures");
}
