//
// A heap parameter SHARES the caller's store, so every change that mutates that store is
// visible to the caller — including the STRUCTURAL ones (loft#1251, @FR-F-ParamGrow).
//
// `formal/calls.md` splits it in one place: @FR-F-ParamHeap makes a heap parameter an alias,
// @FR-F-ParamGrow says growing and shrinking are mutations of that shared store like any
// other, and @FR-F-ParamRebind names the ONE local act — replacing the whole value, which
// rebinds the callee's name and reaches nothing.  @FR-F-ParamRef adds write-back for exactly
// that one case, and that is the whole of what `&` buys on a collection.
//
// Two shipped documents promised the opposite — that `v += [x]` on a non-`&` parameter was
// callee-local and that `&vector<T>` was what let a function grow its argument.  It never
// was, on either backend, for as long as anyone measured.  The mistake is worth pinning
// rather than just correcting, because it is a READING and readings come back: a plain BIND
// does copy (@FR-B-Copy) and a SLICE is a fresh vector, so `c = b; c += [4]` and
// `w = a[1..4]; w += [9]` both leave the original alone.  Neither is about parameters.  The
// last two cells here are those, so the three cases are distinguishable in one file instead
// of each looking like evidence for the others.
//
// @falsified-at: none — the behaviour this pins is unchanged and always was; no earlier build
//   can fail it.  What it guards is the DOCUMENTED claim, which was wrong in two places at
//   once, so its job is to make a future change to any of these cells loud rather than to
//   score a past one.  Its own controls are the `&`-replace cell (the only cell where the
//   token changes the answer) and the bind/slice pair (the only cells that do NOT reach the
//   caller) — a build that shared everything, or nothing, fails on those.

struct It1251 { n: integer }
struct K1251 { key: integer, v: integer }
struct Box1251 { v: vector<integer> }

fn plain_append(v: vector<integer>, x: integer)   { v += [x]; }
fn plain_append_s(v: vector<It1251>, x: It1251)   { v += [x]; }
fn plain_elem(v: vector<integer>)                 { v[0] = 99; }
fn plain_remove(v: vector<integer>)               { v.remove(0); }
fn plain_clear(v: vector<integer>)                { v.clear(); }
fn plain_replace(v: vector<integer>)              { v = [7, 7]; }
fn amp_append(v: &vector<integer>, x: integer)    { v += [x]; }
fn amp_replace(v: &vector<integer>)               { v = [7, 7]; }
fn plain_hash(h: hash<K1251[key]>, k: integer)    { h += [K1251 { key: k, v: k }]; }
fn plain_sorted(s: sorted<K1251[key]>, k: integer) { s += [K1251 { key: k, v: k }]; }
fn plain_index(x: index<K1251[key]>, k: integer)  { x += [K1251 { key: k, v: k }]; }
fn make1251() -> vector<integer>                  { [1, 2, 3] }

fn test_a_plain_parameter_grows_the_callers_vector() {
  // The filed cell.  The appended element is READABLE through the caller, so this is a real
  // structural change and not a stale length.
  a: vector<integer> = [1, 2, 3];
  plain_append(a, 4);
  assert(len(a) == 4, "a plain vector parameter's append reaches the caller, got {len(a)}");
  assert((a[3] ?? -1) == 4, "and the element is there, got {a[3] ?? -1}");

  // A struct element type is the same act on the same store.
  s: vector<It1251> = [It1251 { n: 1 }];
  plain_append_s(s, It1251 { n: 2 });
  assert(len(s) == 2, "…at a struct element type too, got {len(s)}");
  assert((s[1].n ?? -1) == 2, "and the element is there, got {s[1].n ?? -1}");
}

fn test_shrinking_is_the_same_act_as_growing() {
  // If `+=` reaches the caller because the store is shared, so must every other structural
  // change.  A guard that only pinned the append would let a future fix split them.
  a: vector<integer> = [1, 2, 3];
  plain_remove(a);
  assert(len(a) == 2, "a plain parameter's remove reaches the caller, got {len(a)}");
  assert((a[0] ?? -1) == 2, "and it removed the right one, got {a[0] ?? -1}");

  b: vector<integer> = [1, 2, 3];
  plain_clear(b);
  assert(len(b) == 0, "a plain parameter's clear reaches the caller, got {len(b)}");
}

fn test_an_element_write_reaches_the_caller() {
  // The half both documents got right, kept so the file states the whole rule.
  a: vector<integer> = [1, 2, 3];
  plain_elem(a);
  assert((a[0] ?? -1) == 99, "a plain parameter's element write reaches the caller, got {a[0] ?? -1}");
}

fn test_replacing_the_whole_value_is_the_one_local_act() {
  // @FR-F-ParamRebind.  This is the cell that keeps the rule from collapsing into "a
  // parameter is a reference": `v = [7,7]` rebinds the callee's NAME and reaches nothing.
  a: vector<integer> = [1, 2, 3];
  plain_replace(a);
  assert(len(a) == 3, "a plain parameter's whole-value replace stays local, got {len(a)}");
  assert((a[0] ?? -1) == 1, "and the caller keeps its own elements, got {a[0] ?? -1}");
}

fn test_what_the_ampersand_actually_buys() {
  // Appending works with `&` too — the token is not what permits it…
  a: vector<integer> = [1, 2, 3];
  amp_append(a, 4);
  assert(len(a) == 4, "a `&` parameter appends as the plain one does, got {len(a)}");

  // …and REPLACEMENT is the one observable difference between the two spellings.  Without
  // this cell "`&` adds nothing for a vector" reads as true, which is the conclusion the
  // wrong documentation invites.
  b: vector<integer> = [1, 2, 3];
  amp_replace(b);
  assert(len(b) == 2, "a `&` parameter's whole-value replace writes back, got {len(b)}");
  assert((b[0] ?? -1) == 7, "and the caller sees the new elements, got {b[0] ?? -1}");
}

fn test_every_container_kind_answers_the_same() {
  // The rule is about a shared STORE, so it cannot be a vector-only fact.
  h: hash<K1251[key]> = [];
  h += [K1251 { key: 1, v: 1 }];
  plain_hash(h, 2);
  assert(len(h) == 2, "a plain hash parameter's insert reaches the caller, got {len(h)}");

  s: sorted<K1251[key]> = [];
  s += [K1251 { key: 1, v: 1 }];
  plain_sorted(s, 2);
  assert(len(s) == 2, "a plain sorted parameter's insert reaches the caller, got {len(s)}");

  x: index<K1251[key]> = [];
  x += [K1251 { key: 1, v: 1 }];
  plain_index(x, 2);
  assert(len(x) == 2, "a plain index parameter's insert reaches the caller, got {len(x)}");
}

fn test_where_the_argument_came_from_does_not_change_the_answer() {
  // The sharpest cell in the file: a vector held in a struct FIELD.  BINDING that projection
  // COPIES — @FR-B-Copy's `af = bx.v`, one-level collection off an owned base — and PASSING
  // it aliases.  Same expression, two positions, two answers, and both are the rules working
  // rather than a disagreement.  This is the pair the wrong documentation had collapsed.
  b = Box1251 { v: [1, 2, 3] };
  plain_append(b.v, 4);
  assert(len(b.v) == 4, "a field's vector passed as an argument is shared, got {len(b.v)}");
  copy = b.v;
  plain_append(copy, 5);
  assert(len(b.v) == 4, "…while BINDING the same projection copies, got {len(b.v)}");
  assert(len(copy) == 5, "and the copy grew instead, got {len(copy)}");

  // A callee's RETURN is a fresh owned value (@FR-F-Ret); handing it on shares THAT value.
  r = make1251();
  plain_append(r, 4);
  assert(len(r) == 4, "a returned vector passed on is shared, got {len(r)}");

  // Once per turn, so a lowering that hoisted the call out of the loop would read as one
  // append rather than three.
  c = Box1251 { v: [1, 2, 3] };
  for i in 0..3 { plain_append(c.v, i); }
  assert(len(c.v) == 6, "three calls append three times, got {len(c.v)}");
  assert((c.v[5] ?? -1) == 2, "and the last one is the last turn's, got {c.v[5] ?? -1}");
}

fn test_a_bind_and_a_slice_are_not_parameters() {
  // The two facts the wrong documentation was probably generalising from.  A plain BIND
  // copies (@FR-B-Copy) and a SLICE is a fresh vector, so an append through either leaves the
  // original alone — the opposite answer to every cell above, in the same file, so the three
  // cases cannot be read as one.
  b: vector<integer> = [1, 2, 3];
  c = b;
  plain_append(c, 4);
  assert(len(b) == 3, "a plain bind copies, so the caller's vector is untouched, got {len(b)}");
  assert(len(c) == 4, "…and the copy did grow, got {len(c)}");

  a: vector<integer> = [1, 2, 3, 4, 5];
  w = a[1..4];
  plain_append(w, 9);
  assert(len(a) == 5, "a slice is a fresh vector, so the original is untouched, got {len(a)}");
  assert(len(w) == 4, "…and the slice did grow, got {len(w)}");
  plain_elem(w);
  assert((a[1] ?? -1) == 2, "a write through a slice does not reach the original, got {a[1] ?? -1}");
  assert((w[0] ?? -1) == 99, "…it lands in the slice, got {w[0] ?? -1}");
}
