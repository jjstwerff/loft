//
// Regression for @P314 — concatenating two `vector<u8>` (and other narrow
// integer vectors) with `dst += src` must preserve the appended ELEMENT VALUES,
// not zero them.  Before the fix, the emitted `OpAppendVector` carried the wide
// `integer` content type (id 0) instead of the narrow byte type, so
// `vector_add` strided by 8 bytes over a 1-byte-packed vector and the appended
// elements came out as zeros (corrupting, allocation-history-dependently, the
// kinds/colors arrays of gridmesh's SegMesh in C3 incremental rebuild).
//
// Also guards @P316 — `isum` reads a `vector<u8>` element with `?? <int>`
// (`v[i] ?? 0`).  Native used to emit `(if … {u8} else {0_i64}) as u8` → E0308;
// the fix widens both `??` branches to `i64` so the element-coalesce typechecks.
// This script therefore runs on BOTH backends (no longer in SCRIPTS_NATIVE_SKIP).

struct V {
  a: vector<u8>,
}

fn isum(v: vector<u8>) -> integer {
  s = 0; for i in 0..len(v) { s = s + (v[i] ?? 0); } s
}

// Append several u8 vectors of ODD lengths so the append positions are
// non-word-aligned (the precise shape the bug corrupted).
fn test_p314_u8_concat_values() {
  d = V { a: [] };
  d.a += [1, 2, 3]; // len 3 (next append at byte 11 — unaligned)
  d.a += [50, 51, 52, 53, 54]; // len 8
  d.a += [100, 101]; // len 10
  assert(len(d.a) == 10, "u8 concat len={len(d.a)} (expect 10)");
  // values must survive exactly (sum 1+2+3 + 50..54 + 100+101)
  assert(isum(d.a) == 6 + 260 + 201, "u8 concat sum={isum(d.a)} (expect 467)");
}

// Concatenating from a SOURCE vector field (the seg_mesh_append shape).
fn test_p314_u8_concat_from_field() {
  out = V { a: [] };
  parts: vector<V> = [];
  for k in 0..4 {
    seg = V { a: [] };
    for j in 0..7 { seg.a += [(((k * 10 + j) % 200)&255) as u8]; } // odd length 7
    parts += [seg];
  }
  per = 0;
  for pp in parts { per = per + isum(pp.a); }
  for pp in parts { out.a += pp.a; } // bulk concat
  assert(len(out.a) == 28, "u8 field concat len={len(out.a)} (expect 28)");
  assert(isum(out.a) == per, "u8 field concat sum={isum(out.a)} != per-part sum={per}");
}
