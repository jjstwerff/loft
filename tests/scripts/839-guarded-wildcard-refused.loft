//
// The two arm forms that a guard must NOT be allowed to make look total.
//
// @EXPECT_ERROR: match on vector is not exhaustive
// @EXPECT_ERROR: a guard is not supported on a cursor match arm

enum Tok { Fn { x: integer }, Id { x: integer } }
struct Cur { src: vector<Tok>, pos: integer }

// A guarded `_` can fail at runtime, so it does not make the match exhaustive.  The
// wildcard test used to be decided BEFORE the guard was parsed, which would have let this
// through with a subject falling past every arm.
fn no_total_arm(v: vector<integer>) -> text {
  match v { _ if len(v) > 2 => "long" }
}

// A cursor arm ADVANCES the shared cursor from its bindings, which run before the guard.
// A guard failing after that would leave the cursor consumed while the next arm re-matched
// from the wrong position — the whole parse would silently read the wrong tokens.  Refused
// rather than shipped: the test belongs in the arm body, where the advance is committed.
fn cursor_arm_guard() -> integer {
  c = Cur { src: [Fn { x: 0 }, Id { x: 7 }], pos: 0 };
  match c { [Id { x }] if x > 3 => x, _ => -1 }
}

fn main() {
  println(no_total_arm([1, 2, 3]));
  println("{cursor_arm_guard()}");
}
