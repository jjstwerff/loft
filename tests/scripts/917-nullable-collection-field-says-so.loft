//
// A `?` on a COLLECTION field means what it says: the field can be absent, and absent is not
// empty (loft#917).
//
// This file used to assert the OPPOSITE — every cell stated the wrong answer the field gave,
// and its header said "if a later layout change makes `== null` work, they fail and this file
// is the thing that says the warning can go". This is that change, so the assertions are
// inverted and the `nullable-collection-field` warning is gone.
//
// How it works, and why it needed no layout change:
//
// A collection field is a 4-byte RECORD ID. `0` already means the empty collection, and the
// value-level null — `DbRef::NULL`, a `store_nr` of `u16::MAX` — cannot reach a field, because
// `OpGetField` is pure pointer arithmetic and the vector ops read the id out of the slot
// themselves. So absence gets its own reserved id, `DbRef::ABSENT_REC` (`u32::MAX`), the same
// way a store reserves `u16::MAX`. Nothing in the corpus could ever hold it: a record id
// indexes words within a store.
//
// The reserved id is read in exactly two ways, and keeping them apart is the whole design:
//
//   * `vector::is_absent_collection` reads the slot RAW — this is `== null`, the one question
//     whose answer differs between absent and empty.
//   * `Store::collection_rec` maps it to `0` — this is every other reader, because "which
//     record holds the elements?" has the same answer for both: none. A reader that saw the
//     raw value instead would take `u32::MAX` for a record number, which is a SIGSEGV rather
//     than a wrong answer (a6 and a7 below are the rows that caught exactly that).
//
// c8-c12 are controls that must not move: a non-nullable field, a local, and the `[]` spelling
// on every path. If a repair ever collapses absent back into empty, c2/c5 fail; if it makes
// `[]` read as absent — the trap that killed the obvious `OpConvBoolFromRef` fix — c2 and c9
// fail together.

struct Row917 { k: integer, v: integer }

struct H917 {
  vec: vector<integer>?,
  hsh: hash<Row917[k]>?,
  srt: sorted<Row917[k]>?,
}

// QUIET — a scalar `?` and a struct `?` field read back as null correctly (loft#896) and are
// untouched by this.
struct Fine917 {
  txt: text?,
  num: integer?,
  inr: Row917?,
}

struct Plain917 { vec: vector<integer>, tag: integer }

fn main() {
  // c1 — constructed absent, reads back absent. Every collection kind, because a keyed field
  //      is the same 4-byte slot and used to lower `== null` to `OpEqRef` — a DbRef compare a
  //      slot POINTER can never satisfy, so it answered false however the field was written.
  c1 = H917 { vec: null, hsh: null, srt: null };
  assert(c1.vec == null, "c1 vec absent");
  assert(c1.hsh == null, "c1 hsh absent");
  assert(c1.srt == null, "c1 srt absent");

  // c2 — the distinction the whole change is for: EMPTY is not absent.
  c2 = H917 { vec: [], hsh: null, srt: null };
  assert(!(c2.vec == null), "c2 [] is not absent");
  assert(len(c2.vec ?? []) == 0, "c2 [] len = {len(c2.vec ?? [])}, want 0");

  // c3 — present reads present, and its elements survive.
  c3 = H917 { vec: [71, 82, 93], hsh: null, srt: null };
  assert(!(c3.vec == null), "c3 present");
  assert(len(c3.vec ?? []) == 3, "c3 len = {len(c3.vec ?? [])}, want 3");
  assert((c3.vec ?? [])[2] == 93, "c3 elem = {(c3.vec ?? [])[2]}, want 93");

  // c4 — assigning `null` releases the records AND records the absence. The release is not
  //      new (loft#922); the marker is.
  c4 = H917 { vec: [71, 82], hsh: null, srt: null };
  c4.vec = null;
  assert(c4.vec == null, "c4 assigned null");
  assert(len(c4.vec ?? []) == 0, "c4 len after null = {len(c4.vec ?? [])}, want 0");

  // c5 — and assigning `[]` releases them WITHOUT recording absence, which is the pair c4
  //      has to be distinguishable from.
  c5 = H917 { vec: [71, 82], hsh: null, srt: null };
  c5.vec = [];
  assert(!(c5.vec == null), "c5 [] is not absent");
  assert(len(c5.vec ?? []) == 0, "c5 len = {len(c5.vec ?? [])}, want 0");

  // c6 — an absent field is refillable. This is the row that failed first: the writers landed
  //      before the readers, so the fill read `u32::MAX` as a record number and segfaulted.
  c6 = H917 { vec: null, hsh: null, srt: null };
  c6.vec = [93, 104];
  assert(!(c6.vec == null), "c6 refilled");
  assert(len(c6.vec ?? []) == 2, "c6 len = {len(c6.vec ?? [])}, want 2");
  assert((c6.vec ?? [])[1] == 104, "c6 elem = {(c6.vec ?? [])[1]}, want 104");

  // c7 — `??` on an absent field yields the default, and on a present one the value. Same
  //      SIGSEGV origin as c6.
  c7 = H917 { vec: null, hsh: null, srt: null };
  assert(len(c7.vec ?? []) == 0, "c7 ?? absent = {len(c7.vec ?? [])}, want 0");
  c7b = H917 { vec: [71], hsh: null, srt: null };
  assert(len(c7b.vec ?? []) == 1, "c7 ?? present = {len(c7b.vec ?? [])}, want 1");

  // c8 (control) — a NON-nullable collection field. `= null` on one still means "release the
  //       records" and must NOT record absence: the field's own type says it cannot be.
  c8 = Plain917 { vec: [71, 82, 93], tag: 7 };
  assert(len(c8.vec) == 3, "c8 len = {len(c8.vec)}, want 3");
  c8.vec = [];
  assert(len(c8.vec) == 0, "c8 cleared = {len(c8.vec)}, want 0");
  assert(c8.tag == 7, "c8 tag = {c8.tag}, want 7 — the holder must be intact");

  // c9 (control) — an absent and an empty field, side by side, both read and both freed. If
  //       the marker ever leaks into the empty one, this and c2 fail together.
  c9a = H917 { vec: null, hsh: null, srt: null };
  c9b = H917 { vec: [], hsh: null, srt: null };
  assert(c9a.vec == null && !(c9b.vec == null), "c9 absent and empty stay distinct");

  // c10 (control) — scalars and a struct field are a different mechanism (loft#896) and must
  //        keep answering as they did.
  c10 = Fine917 { txt: null, num: null, inr: null };
  assert(c10.txt == null, "c10 text null");
  assert(c10.num == null, "c10 integer null");
  assert(c10.inr == null, "c10 struct null (loft#896)");

  // c11 (control) — a LOCAL nullable collection. Its null is the value-level sentinel, a
  //        different representation entirely, and it was already correct.
  c11: vector<integer>? = null;
  assert(c11 == null, "c11 local null");
  c11 = [71];
  assert(!(c11 == null), "c11 local assigned");
  assert(len(c11 ?? []) == 1, "c11 local len = {len(c11 ?? [])}, want 1");

  // c12 (control) — iterating and appending across an absent field, so the readers that take
  //        the slot through `collection_rec` are exercised rather than just `len`.
  c12 = H917 { vec: null, hsh: null, srt: null };
  n12 = 0;
  for e in c12.vec ?? [] { n12 = n12 + e; }
  assert(n12 == 0, "c12 iterating absent = {n12}, want 0");
  c12.vec = [71];
  c12.vec += [82];
  assert(len(c12.vec ?? []) == 2, "c12 appended = {len(c12.vec ?? [])}, want 2");

  println("917 ok");
}
