//
// @P390 — `v = v[a..b]` self-slice-assign must preserve element values.
//
// Pre-fix (interpreter): `materialize_iterator` emitted `OpClearVector(v)`
// BEFORE the loop read `v[i]` from the SAME record, so every element read back
// null — length preserved, values lost (`[10,20,30,40]` then `v = v[0..2]`
// read null at every index).  Fix (src/parser/expressions.rs): when the slice
// source IS the assignment target (detected via `ir_mentions_var`), materialise
// into a temp local first (the @P287 struct-field pattern), then
// `OpClearVector + OpAppendVector` — the temp breaks the alias.  The
// non-aliased `t = v[a..b]` keeps the direct fast path and is checked below.

fn test_p390_self_slice_integer() {
  v: vector<integer> = [10, 20, 30, 40];
  v = v[0..2];
  assert(v.len() == 2, "int self-slice len");
  assert(v[0] == 10 && v[1] == 20, "int self-slice values preserved");
}

fn test_p390_self_slice_float() {
  v: vector<float> = [1.5, 2.5, 3.5];
  v = v[1..3];
  assert(v.len() == 2, "float self-slice len");
  assert(v[0] == 2.5 && v[1] == 3.5, "float self-slice values preserved");
}

fn test_p390_self_slice_text() {
  v: vector<text> = ["a", "b", "c", "d"];
  v = v[2..4];
  assert(v.len() == 2, "text self-slice len");
  assert(v[0] == "c" && v[1] == "d", "text self-slice values preserved");
}

fn test_p390_non_aliased_unaffected() {
  // The non-aliased form keeps the direct fast path AND leaves the source intact.
  src: vector<integer> = [7, 8, 9];
  dst = src[0..2];
  assert(dst[0] == 7 && dst[1] == 8, "non-aliased dst values");
  assert(src.len() == 3 && src[2] == 9, "non-aliased source intact");
}
