// loft#1085 — a promoted return buffer the callee never allocates into belongs to
// the CALLER, and freeing it there recycles a slot a live local still owns.
//
// The cure is that a ref local's null-init now writes the NULL sentinel, which is
// what `--native` already wrote, instead of ALLOCATING an empty store.  Only the
// allocating form gave the caller a store to keep, and `LOFT_ALLOC_INIT_REF=1`
// brings it back — the asserts below fire under it, which is what makes this file
// a reading rather than a hope.
//
// `fn l1_passthrough(v) -> Pt { pt(v, v) }` hands its hidden buffer straight to
// the inner call and never mints a store into it.  The callee's conditional free
// of that buffer could therefore only ever no-op (the inner call delivered
// through it) or release the caller's store (the inner call allocated fresh).
// The second is what happened: the freed slot went back on the free list while
// `a` still pointed at it, and the next allocation — the `pt(a.x + b.x, …)`
// temporary — took it and wrote over `a`.  `a.x` then read back `a.x + b.x`.
// Silent, `--interpret` only, and it needed FOUR iterations, because the slot has
// to be recycled to a live owner before the over-free can hit anything.
//
// The other three functions are the legs the same decision serves, and they are
// here so a future narrowing of it fails with a name attached rather than as a
// leak in an unrelated script:
//   - L2 (loft#688)  this function MINTS into the buffer and a sibling path
//                    returns another store, so the minted one needs the free;
//   - L3 (loft#1022) the arms disagree about ownership — one borrows, one mints;
//   - L4            a null arm beside a minting arm.
// Under `LOFT_STRICT_STORES=1` L2 leaks `Pt×2` if the free is dropped for it, so
// the suite's own leak check is what holds that half.

struct Pt {
  x: float,
  y: float,
}

struct Box {
  p: Pt,
}

fn pt(px: float, py: float) -> Pt {
  Pt { x: px, y: py }
}

fn l1_passthrough(v: float) -> Pt {
  pt(v, v)
}

fn l2_mint_and_sibling(c: boolean, other: Pt) -> Pt {
  r = Pt { x: 1.0, y: 1.0 };
  if c { return other }
  r
}

fn l3_ownership_split(bx: Box, take: boolean) -> Pt {
  if take { bx.p } else { Pt { x: 9.0, y: 9.0 } }
}

fn l4_null_arm(c: boolean) -> Pt? {
  if c { Pt { x: 4.0, y: 4.0 } } else { null }
}

fn main() {
  // Four iterations and two buffers: the shape that recycles a slot onto a live
  // local.  Both locals are read AFTER the append that takes the freed slot.
  out: vector<Pt> = [];
  bad = 0;
  for i in 0..4 {
    a = if i % 2 == 1 { l1_passthrough(1.0) } else { pt(1.0, 1.0) };
    b = if i % 2 == 1 { l1_passthrough(2.0) } else { pt(2.0, 2.0) };
    out += [pt(a.x + b.x, 0.0)];
    if a.x != 1.0 { bad += 1 }
    if b.x != 2.0 { bad += 1 }
  }
  assert(bad == 0, "a passthrough buffer's callee must not free the caller's store");
  assert(len(out) == 4, "and every append still landed");

  bx = Box { p: Pt { x: 7.0, y: 7.0 } };
  s2 = 0.0;
  s3 = 0.0;
  s4 = 0.0;
  for j in 0..4 {
    o = Pt { x: 5.0, y: 5.0 };
    s2 += l2_mint_and_sibling(j % 2 == 1, o).x;
    s3 += l3_ownership_split(bx, j % 2 == 1).x;
    if l4_null_arm(j % 2 == 1) != null { s4 += 4.0 }
  }
  assert(s2 == 12.0, "a minting buffer with a sibling return still delivers");
  assert(s3 == 32.0, "arms that disagree about ownership still deliver");
  assert(s4 == 8.0, "a null arm beside a minting arm still delivers");
}
