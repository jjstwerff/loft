//
// Regression (loft#754) — a function whose body ENDS in a PLACE READ
// (`w.items[i].bytes`) returned an EMPTY vector under `--native` and the right
// one under `--interpret`.  Writing `return` in front of the identical
// expression fixed it, which is what made it read as anything but a compiler
// bug.
//
// A tail expression with pending scope frees is hoisted to a `__ret_N` temp so
// the frees run between the read and the `Return`.  That rule (`scopes.rs`,
// B5-L3) named only the SCALAR return types, and a later branch named text; a
// `vector` / record / struct-enum tail fell through to a fabricated
// `Return(Null)` with the expression left as a DISCARDED statement.  The
// interpreter read the value off eval-stack top and answered correctly, so only
// native was wrong — it emitted `let _ = expr; …; return DbRef::NULL`.  (rustc
// said so, as `unused_must_use` on the dropped element read.)
//
// THE BOUNDARY IS TWO-SIDED, and both sides are asserted here:
//
//   * the frees must EXIST — without an early `return []` (or any freeable
//     local) the tail is already emitted as a `Return`, which is why `tail_no_free`
//     passed throughout and is carried as the control;
//
//   * the tail must be a PLACE READ — a bare accessor chain over a variable,
//     which allocates nothing and writes no return buffer, so its value lives
//     only on the eval stack.  A CALL tail already delivers through its hidden
//     buffer; hoisting one instead engaged the store-transfer machinery around
//     a borrowed argument and over-froze the caller's store, so `tail_is_call`
//     is here to keep the fix from widening back over it.
//
// Every expected value is hand-computed from the four bytes the fixture holds.

struct Section { sc_tag: integer, sc_bytes: vector<u8>, sc_name: text }
struct World { w_sections: vector<Section>, w_top: vector<u8> }

fn fixture() -> World {
  World {
    w_sections: [ Section { sc_tag: 7,
                            sc_bytes: [11 as u8, 22 as u8, 33 as u8, 44 as u8],
                            sc_name: "abc" } ],
    w_top: [1 as u8, 2 as u8],
  }
}

fn big(w: World) -> boolean { return len(w.w_top) > 99; }
fn mk() -> vector<u8> { return [1 as u8, 2 as u8, 3 as u8]; }

// --- THE CASE: an early `return []` leaves a work-ref to free, and the tail is
//     a vector FIELD of a vector ELEMENT.  Native answered 0 of 4 bytes. ---
fn tail_after_early_return(w: World) -> vector<u8> {
  if big(w) { return []; }
  w.w_sections[0].sc_bytes
}

// --- the same expression with an explicit `return`: always worked, and is the
//     control that says the READ itself is fine ---
fn tail_explicit_return(w: World) -> vector<u8> {
  if big(w) { return []; }
  return w.w_sections[0].sc_bytes;
}

// --- CONTROL: no early return, so no frees and no hoist.  This cell passed
//     before the fix; if it ever fails the hoist has started firing where the
//     tail was already a `Return`. ---
fn tail_no_free(w: World) -> vector<u8> {
  w.w_sections[0].sc_bytes
}

// --- the freeable local need not be the early return's `[]`: any local that
//     needs freeing puts ops between the tail and the Return ---
fn tail_after_local_vector(w: World) -> vector<u8> {
  junk = [1, 2];
  if len(junk) > 99 { return []; }
  w.w_sections[0].sc_bytes
}

// --- a RECORD return through the same shape.  `w.w_sections[0]` is an
//     `OpGetVector` place read, so native returned the null DbRef and the
//     caller read a null record — the tag below is what catches it. ---
// The `-> Section` return is the point of this cell — a non-null RECORD return through a
// place read — so the signature stays and the notice is declared.  `Section?` returns through
// a different ABI (no hidden buffer) and would move the cell off the path it guards.
// @EXPECT_WARNING: non-null type `Section`
fn tail_record(w: World) -> Section {
  junk = [1, 2];
  if len(junk) > 99 { return null; }
  w.w_sections[0]
}

// --- a TEXT field tail: text has its own hoist branch, so this is the far side
//     of the type boundary and must be unaffected ---
fn tail_text(w: World) -> text {
  junk = [1, 2];
  if len(junk) > 99 { return ""; }
  w.w_sections[0].sc_name
}

// --- a plain FIELD of the argument: routed through the borrow-copy path, not
//     the hoist, and correct throughout ---
fn tail_plain_field(w: World) -> vector<u8> {
  junk = [1, 2];
  if len(junk) > 99 { return []; }
  w.w_top
}

// --- a CALL tail with the same pending free.  NOT a place read: it delivers
//     through its own hidden buffer.  Hoisting this shape is what broke
//     `return-borrow-of-mutated-arg`, so this cell pins the fix's upper edge. ---
fn tail_is_call(w: World) -> vector<u8> {
  junk = [1, 2];
  if len(junk) > 99 || len(w.w_top) > 99 { return []; }
  mk()
}

// --- the if/else tail: its arms are unified onto one work-ref, a path the
//     hoist must not take over ---
fn tail_is_branch(w: World) -> vector<u8> {
  junk = [1, 2];
  if len(junk) > 99 { return []; }
  if len(w.w_top) > 1 { w.w_sections[0].sc_bytes } else { w.w_top }
}

fn byte_sum(v: vector<u8>) -> integer {
  t = 0;
  for b in v { t += b as integer; }
  t
}

fn main() {
  w = fixture();

  // Read at the call site first: if THIS is wrong the fixture is wrong, and
  // every cell below would agree with each other about the wrong bytes.
  assert(len(w.w_sections[0].sc_bytes) == 4, "fixture: 4 bytes");
  assert(byte_sum(w.w_sections[0].sc_bytes) == 110, "fixture: sum 110");

  a = tail_after_early_return(w);
  assert(len(a) == 4, "tail after early return: len {len(a)}, want 4");
  assert(byte_sum(a) == 110, "tail after early return: sum {byte_sum(a)}, want 110");

  b = tail_explicit_return(w);
  assert(len(b) == 4, "explicit return: len {len(b)}, want 4");
  assert(byte_sum(b) == 110, "explicit return: sum {byte_sum(b)}, want 110");

  c = tail_no_free(w);
  assert(len(c) == 4, "no free to run: len {len(c)}, want 4");
  assert(byte_sum(c) == 110, "no free to run: sum {byte_sum(c)}, want 110");

  d = tail_after_local_vector(w);
  assert(len(d) == 4, "freeable local: len {len(d)}, want 4");
  assert(byte_sum(d) == 110, "freeable local: sum {byte_sum(d)}, want 110");

  s = tail_record(w);
  assert(s.sc_tag == 7, "record tail: tag {s.sc_tag}, want 7");
  assert(len(s.sc_bytes) == 4, "record tail: bytes {len(s.sc_bytes)}, want 4");

  t = tail_text(w);
  assert(t == "abc", "text tail: '{t}', want 'abc'");

  p = tail_plain_field(w);
  assert(len(p) == 2, "plain field tail: len {len(p)}, want 2");
  assert(byte_sum(p) == 3, "plain field tail: sum {byte_sum(p)}, want 3");

  k = tail_is_call(w);
  assert(len(k) == 3, "call tail: len {len(k)}, want 3");
  assert(byte_sum(k) == 6, "call tail: sum {byte_sum(k)}, want 6");

  r = tail_is_branch(w);
  assert(len(r) == 4, "branch tail: len {len(r)}, want 4");
  assert(byte_sum(r) == 110, "branch tail: sum {byte_sum(r)}, want 110");

  // The argument must survive being read through: the hoist copies a DbRef, it
  // does not adopt the store, so `w` still holds its own bytes afterwards.
  assert(len(w.w_sections[0].sc_bytes) == 4, "argument intact: 4 bytes");
  assert(byte_sum(w.w_top) == 3, "argument intact: top sum 3");

  println("754 ok");
}
