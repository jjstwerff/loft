//
// P246 regression — file-scope `const NAME = expr;` is accepted as
// a synonym for the bare-name form.  Pre-fix the leading `const`
// kicked the parser through `expression()` and `change_var_type`
// panicked on an empty file-scope variable table.

const WITH_KW = 100;
WITHOUT_KW = 200;
pub const SHARED = 7;
const NAME = "loft";

fn main() {
  // Both forms produce real, readable file-scope constants.
  assert(WITH_KW == 100, "with-kw");
  assert(WITHOUT_KW == 200, "without-kw");
  assert(SHARED == 7, "pub const");
  assert(NAME == "loft", "text const");
  // Use in arithmetic + format string — confirms the codegen path
  // has the right type info, not a stale-sentinel slot.
  doubled = WITH_KW * 2;
  assert(doubled == 200, "arithmetic on const");
  s = "name={NAME}, n={SHARED}";
  assert(s == "name=loft, n=7", "interpolation: got {s}");
}
