//
// Snapshot-write idiom: open file, explicitly truncate with
// set_file_size(0), then write a header + payload sequence with `+=`,
// then sync().  Two save passes round-trip with the payload from the
// most recent save (no leftover bytes from the longer first save).
// This is the pattern used by tools/audience-demo/single_port_server.loft
// and lib/hex_world/src/hex_world.loft once `+=` becomes append-only.

// @PLN9: cwd-relative paths — this test does cwd-relative file I/O.
#cwd
fn cleanup() {
  delete("test_loft_snap.bin");
}

fn main() {
  cleanup();

  // First save — 5 elements.
  {
    f = file("test_loft_snap.bin");
    f#format = LittleEndian;
    f.set_file_size(0);
    f += (0x1ECEC0DE as u32);
    f += (7 as u32);
    f += (5 as u32);
    for i in 0..5 { f += (((100 + i)&0x7FFFFFFF) as u32); }
    f.sync();
  }
  {
    f = file("test_loft_snap.bin");
    assert(f#size == 32, "first save size = 4(magic) + 4(tick) + 4(count) + 5*4(payload) = 32");
  }

  // Second save — only 2 elements.  The file must shrink, not retain
  // payload bytes from the previous save.
  {
    f = file("test_loft_snap.bin");
    f#format = LittleEndian;
    f.set_file_size(0);
    f += (0x1ECEC0DE as u32);
    f += (9 as u32);
    f += (2 as u32);
    f += (200 as u32);
    f += (201 as u32);
    f.sync();
  }
  {
    f = file("test_loft_snap.bin");
    assert(f#size == 20, "second save size = 4 + 4 + 4 + 2*4 = 20 (truncated)");
    f#format = LittleEndian;
    magic: u32 = (f#read&0x7FFFFFFF) as u32;
    assert(magic == (0x1ECEC0DE as u32), "magic round-trips");
    tick: u32 = (f#read&0x7FFFFFFF) as u32;
    assert(tick == (9 as u32), "tick round-trips");
    count: u32 = (f#read&0x7FFFFFFF) as u32;
    assert(count == (2 as u32), "count round-trips");
    v0: u32 = (f#read&0x7FFFFFFF) as u32;
    v1: u32 = (f#read&0x7FFFFFFF) as u32;
    assert(v0 == (200 as u32), "payload[0]");
    assert(v1 == (201 as u32), "payload[1]");
  }

  cleanup();
  println("115-snapshot-roundtrip ok");
}
