//
// @PLN102 pre-freeze audit (F1) — float/single `==`/`!=` are EXACT IEEE equality.
//
// Was: `==`/`!=` used a fixed ABSOLUTE epsilon (1e-9 f64 / 1e-6 f32) while `<`/`<=` were
// exact — a trichotomy violation (`a < b` AND `a == b` both true near the boundary) and a
// bug at small magnitudes (`1e-12 == 2e-12` → true). Now `==`/`!=` are exact; `approx(a,b,eps)`
// is the named tolerance-compare. The NaN-null structure is preserved (null == null is true).
// Runs on both backends via the wrap harness.

fn main() {
  // --- exact: a sub-ULP-distinguishable offset is NOT equal ---
  a = 1.0;
  b = 1.0 + 0.0000000005;               // 5e-10 — a distinct double
  assert(a != b, "exact ==: 5e-10 offset is a distinct double");
  assert(!(a == b), "exact ==: == is false for the offset");

  // --- trichotomy restored: NEVER (a < b AND a == b) ---
  assert(a < b, "a < b holds");
  assert(!(a == b), "and a == b is false — no overlap");
  assert(a != b == !(a == b), "!= is the exact complement of ==");

  // --- small-magnitude bug fixed: 1e-12 and 2e-12 are NOT equal ---
  assert(0.000000000001 != 0.000000000002, "exact ==: 1e-12 != 2e-12 (absolute-epsilon bug gone)");

  // --- null (NaN) model preserved (keystone step 2) ---
  n = 0.0 / 0.0 ?? null;
  assert(n == n, "null == null is still true (uniform null model)");
  assert(!(n != n), "null != null is still false");
  assert(n != 0.0, "null != a real value");

  // --- approx() restores tolerance; a null operand is not approximately anything ---
  assert(approx(a, b, 0.000000001), "approx within 1e-9");
  assert(!approx(1.0, 2.0, 0.001), "approx outside eps is false");
  assert(!approx(n, 1.0, 1.0), "approx with a null operand is false");

  // --- single mirrors float (exact, tolerance ~1 ULP at 1.0f is ~1.2e-7) ---
  af = 1.0f;
  bf = 1.0f + 0.0000005f;               // 5e-7 — a distinct single
  assert(af != bf, "single exact: 5e-7 offset is a distinct single");
  assert(approx(af, bf, 0.000001f), "single approx within 1e-6");
  assert(!approx(af, bf, 0.0000001f), "single approx: 5e-7 exceeds 1e-7");

  print("pln102 float exact-eq: all pinned on both backends\n");
}
