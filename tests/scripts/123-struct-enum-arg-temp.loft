//
// @P303 — an inline-constructed struct-enum returned by a user fn and
// passed DIRECTLY as a call argument (`use_e(mk())`) leaked the temp
// store: `inline_struct_return` (`src/scopes.rs`) lifted user-fn
// `Type::Reference` results into a freed `__lift_N` temp but had no
// `Type::Enum(_, true, _)` arm, so the struct-enum result was never
// lifted/freed.  (The interp leak check exposed it; native silently
// leaked too.)  Fixed by adding the struct-enum arm (guarded on an
// empty dep, so @P301 hidden-param via-local returns stay on the
// work-ref free path).  Both backends; the `clean/` leak case asserts
// no store leaks.

enum IntE {
  A { v: integer },
  B { w: integer },
}
enum MixE {
  M { v: integer },
  N { s: text },
}
struct S {
  v: integer,
}

fn mk_int() -> IntE {
  A { v: 21 }
}
fn mk_mix() -> MixE {
  N { s: "hi" }
}
fn mk_struct() -> S {
  S { v: 7 }
}

fn use_int(e: IntE) -> integer {
  match e {
    A { v } => v, B { w } => w
  }
}
fn use_mix(e: MixE) -> integer {
  match e {
    M { v } => v, N { s } => s.len()
  }
}
fn use_struct(e: S) -> integer {
  e.v
}

fn main() {
  // direct inline struct-enum temp as call arg (the @P303 shape)
  assert(use_int(mk_int()) == 21, "int arg-temp");
  assert(use_mix(mk_mix()) == 2, "mixed-variant text arg-temp");

  // baseline: bound-to-local first (never leaked) — must still work
  x = mk_int();
  assert(use_int(x) == 21, "int via local");

  // sibling: struct (Reference) arg temp (was already lifted/freed)
  assert(use_struct(mk_struct()) == 7, "struct arg-temp");

  println("123-struct-enum-arg-temp ok");
}
