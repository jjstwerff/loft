//
// Regression: a THIRD struct-enum sharing a variant name with two others aborted
// the compiler — "Double structure type src1::Nil", reported as an internal error
// on perfectly legal code, on both backends.
//
// Each variant of a struct-enum is registered as its own structure in the flat
// database type table, so the name must be unique there.  The disambiguator was
// the SOURCE id, which separates two libraries that define the same name but
// cannot separate two definitions in one file: the first variant took the bare
// name, the second took `src1::Nil`, and the third had nowhere left to go.  A
// variant's parent enum is itself a registered type, so the parent's DB name now
// supplies the third key onward — the same escape the synthetic `__nullable<S>`
// variants already took.  Programs that compile today keep the names they have.
//
// Three is the smallest failing count, so each family below has four members:
// one past the boundary.

// Four struct-enums sharing a UNIT variant name.
enum SV1 { Nil, Holder { text_v: text } }
enum SV2 { Nil, Pair { a: text, b: text } }
enum SV3 { Nil, Bytes { items: vector<u8> } }
enum SV4 { Nil, Count { n: integer } }

// Four sharing a PAYLOAD-carrying variant name, each with a payload of its own
// type — the four structures genuinely differ, so they cannot share one table
// entry.  A bare `Item { … }` still resolves to the FIRST definer (variant names
// are one flat namespace and nothing here disambiguates them), so only PV1's is
// constructed; what this file pins is that registering all four is not an abort.
enum PV1 { NoneA, Item { v: text } }
enum PV2 { NoneB, Item { v: integer } }
enum PV3 { NoneC, Item { v: vector<u8> } }
enum PV4 { NoneD, Item { v: boolean } }

fn test_shared_variant_name_schema() {
  // Every variant must construct, match and read back as its own type — a shared
  // table entry would give two of them the same layout.
  a = Holder { text_v: "a" };
  b = Pair { a: "1", b: "2" };
  c = Bytes { items: [65] };
  d = Count { n: 7 };

  match a { Holder { text_v } => { assert(text_v == "a", "SV1 payload: {text_v}"); }, _ => { assert(false, "SV1 variant"); } };
  match b { Pair { a, b } => { assert(a == "1" && b == "2", "SV2 payload: {a}/{b}"); }, _ => { assert(false, "SV2 variant"); } };
  match c { Bytes { items } => { assert(text_from_bytes(items) == "A", "SV3 payload: {text_from_bytes(items)}"); }, _ => { assert(false, "SV3 variant"); } };
  match d { Count { n } => { assert(n == 7, "SV4 payload: {n}"); }, _ => { assert(false, "SV4 variant"); } };

  // The shared UNIT variant still selects the else-arm on each of the four enums.
  n1: SV1 = Nil;
  n4: SV4 = Nil;
  match n1 { Holder { text_v } => { assert(false, "SV1 nil took the payload arm: {text_v}"); }, _ => { } };
  match n4 { Count { n } => { assert(false, "SV4 nil took the payload arm: {n}"); }, _ => { } };

  // The first of the four same-named payload variants round-trips its own type.
  p1 = Item { v: "s" };
  match p1 { Item { v } => { assert(v == "s", "PV1 payload: {v}"); }, _ => { assert(false, "PV1 variant"); } };
}
