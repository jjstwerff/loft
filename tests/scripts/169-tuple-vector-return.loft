//
// Returning a tuple that CONTAINS a vector must not crash.  Pre-fix, the
// tuple-return heap-promotion (control.rs::rewrite_tail_tuple_with_work_ref)
// wrote the whole vector via a bare OpSetInt4 (an 8-byte DbRef as a 4-byte
// int) → stack skew → garbage write into the locked CONST_STORE
// (store.rs:1374 panic on interpret; rustc E0308/E0605 on native).
// Fix: set_field_check deep-copies a real vector FIELD value (OpGetField +
// OpAppendVector), like the struct constructor — while keeping OpSetInt4 for
// the vector-db init's raw 0-header (val is Value::Int) and the narrow-vec
// insert (f_nr == usize::MAX).

fn g_first() -> (vector<integer>, integer) {
  a: vector<integer> = [1, 2, 3];
  (a, 5)
}

fn g_second() -> (integer, vector<integer>) {
  a: vector<integer> = [];
  a += [7, 8]; // mutably built (not a literal const-store)
  (9, a)
}

fn test_tuple_vector_first() {
  (v, k) = g_first();
  assert(v.len() == 3 && v[0] == 1 && v[2] == 3 && k == 5, "vector-first tuple return");
}

fn test_tuple_vector_second_mutable() {
  (m, w) = g_second();
  assert(
    m == 9 && w.len() == 2 && w[0] == 7 && w[1] == 8,
    "vector-second + mutably-built tuple return"
  );
}
