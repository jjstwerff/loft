//
// A text a function RETURNS is owned by the return, not borrowed from a buffer.
//
// A branch in tail position delivers each arm into the return accumulator, and
// an arm whose text is not a bare variable is first built into a work buffer and
// handed back as a REFERENCE to it (`OpCreateStack(buf)`). Delivering that
// reference stored a borrow of a buffer the enclosing scope frees on the very
// next statement: the interpreter answered `""` — a wrong value, silently, exit
// 0 — and `--native` emitted `*var_acc = ().to_string()`, which is not Rust.
//
// The shape is ordinary — `return x ?? "fallback"` — and binding the result to a
// local first (`y = x ?? "fallback"; return y`) avoided it, which is what made
// the failure look like it was about `??` rather than about delivery. Found
// while building @PLN133 S7's registry.
//
// Every function here returns through a TAIL branch; each `_local` twin returns
// the same value through an intermediate local, so a cell that is wrong in one
// and right in the other names the delivery rather than the expression.

fn maybe(i: integer) -> text? {
  if i == 0 { return null }
  return "value-{i}";
}

// The found instance: a constant fallback in tail position.
fn constant_tail(i: integer) -> text { got = maybe(i); return got ?? "<none>"; }
fn constant_local(i: integer) -> text { got = maybe(i); out = got ?? "<none>"; return out; }

// A fallback that is BUILT rather than constant, so the work buffer really holds
// something — the arm that would have delivered a reference to it.
fn built_tail(i: integer) -> text { got = maybe(i); return got ?? "none at {i}"; }
fn built_local(i: integer) -> text { got = maybe(i); out = got ?? "none at {i}"; return out; }

// An `if` tail rather than a `??`, since both lower to the same per-arm delivery.
fn if_tail(i: integer) -> text {
  got = maybe(i);
  if got == null { return "absent/{i}" }
  return "present/{got ?? ""}";
}

// A `match` tail, where the arms are built texts.
enum Pick { First, Second, Third }

fn match_tail(p: Pick, i: integer) -> text {
  match p {
    First => "one-{i}",
    Second => "two-{i * 2}",
    Third => "three",
  }
}

// The bind-site analogue of the same rewrite: a branch delivered into a local.
fn branch_bind(i: integer) -> text {
  got = maybe(i);
  out = if got == null { "bound-none-{i}" } else { "bound-{got ?? ""}" };
  return out;
}

// A tail whose fallback is another text LOCAL — the arm that was always a bare
// variable, so it is the control that says the rewrite still works where it did.
fn local_fallback(i: integer) -> text {
  spare = "spare-{i}";
  got = maybe(i);
  return got ?? spare;
}

fn main() {
  // The null side is where the borrowed arm was taken.
  assert(constant_tail(0) == "<none>", "constant tail: [{constant_tail(0)}]");
  assert(constant_tail(0) == constant_local(0), "constant tail vs local");
  assert(built_tail(0) == "none at 0", "built tail: [{built_tail(0)}]");
  assert(built_tail(0) == built_local(0), "built tail vs local");

  // …and the non-null side must not have been disturbed by the fix.
  assert(constant_tail(3) == "value-3", "constant tail, present: [{constant_tail(3)}]");
  assert(built_tail(3) == "value-3", "built tail, present: [{built_tail(3)}]");
  assert(constant_tail(3) == constant_local(3), "present tail vs local");

  assert(if_tail(0) == "absent/0", "if tail: [{if_tail(0)}]");
  assert(if_tail(4) == "present/value-4", "if tail, present: [{if_tail(4)}]");

  assert(match_tail(Pick.First, 7) == "one-7", "match first: [{match_tail(Pick.First, 7)}]");
  assert(match_tail(Pick.Second, 7) == "two-14", "match second: [{match_tail(Pick.Second, 7)}]");
  assert(match_tail(Pick.Third, 7) == "three", "match third: [{match_tail(Pick.Third, 7)}]");

  assert(branch_bind(0) == "bound-none-0", "branch bind: [{branch_bind(0)}]");
  assert(branch_bind(5) == "bound-value-5", "branch bind, present: [{branch_bind(5)}]");

  assert(local_fallback(0) == "spare-0", "local fallback: [{local_fallback(0)}]");
  assert(local_fallback(6) == "value-6", "local fallback, present: [{local_fallback(6)}]");

  // The returned text must survive being USED, not merely compared: a borrow of
  // a freed buffer can still compare equal by luck while its bytes are gone.
  joined = "";
  for n in 0..4 { joined += "{constant_tail(n)}|" }
  assert(joined == "<none>|value-1|value-2|value-3|", "accumulated: [{joined}]");

  println("pln133-text-tail-delivery ok");
}
