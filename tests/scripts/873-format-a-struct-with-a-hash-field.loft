//
// loft#873 — formatting a struct that has a `hash<…>` field.
//
// `{r_f}` SIGSEGV'd the interpreter in `OpFormatDatabase` and exited silently on
// native, while `{r_f.cells[1, 2]}` and every scalar field were fine. The record
// walker reached `ShowDb::write_hash`, which carried a bucket loop of its own that
// read each slot as a bare record number at `pos: 8` — the layout before @PLN135
// arc H moved entries into an ARENA, where several share one record and `(rec, pos)`
// identifies an entry. Nothing had caught the drift because nothing reached it: a
// BARE hash is refused at compile time (`Cannot format type hash<…>`), so a hash
// FIELD is the only way in. The walk is `hash::records_sorted` now — the module that
// owns the layout — so it cannot drift from it again.
//
// Wider than filed: `to_json()` goes through the same walker, so a hash-bearing
// record could not be serialised either. That half round-trips here, because a
// crash and a wrong serialisation are the same defect seen from two sides.
//
// The cells vary what the old loop could get away with: entry COUNT (an arena
// chunk holds several), a REMOVAL (a stale slot would render a freed entry), and a
// REHASH past the initial table (a stale bucket array would render the old one).
// Keys are distinct and the elements carry a value derived from them, so a wrong
// entry is named rather than merely counted.

struct I873Cell { q: integer, r: integer, v: integer }
struct I873Named { name: text, w: integer }
struct I873Field { cells: hash<I873Cell[q, r]>, n: integer }
struct I873ByName { by_name: hash<I873Named[name]>, n: integer }
struct I873Outer { inner: I873Field, tag: text }

fn main() {
  f = I873Field { cells: [], n: 3 };
  f.cells[5, 6] = I873Cell { q: 5, r: 6, v: 9 };
  f.cells[1, 2] = I873Cell { q: 1, r: 2, v: 7 };
  f.cells[3, 4] = I873Cell { q: 3, r: 4, v: 8 };

  // Key order, not insertion order — `records_sorted` is what a reader can rely on.
  assert("{f}" == "{{cells:[{{q:1,r:2,v:7}},{{q:3,r:4,v:8}},{{q:5,r:6,v:9}}],n:3}}",
         "debug render: {f}");
  assert("{f:j}" == "{{\"cells\":[{{\"q\":1,\"r\":2,\"v\":7}},{{\"q\":3,\"r\":4,\"v\":8}},{{\"q\":5,\"r\":6,\"v\":9}}],\"n\":3}}",
         "json render: {f:j}");

  // The element and a scalar field were always fine; they are the controls that say
  // the failure was the PARENT walk and not the hash's contents.
  one = f.cells[1, 2] ?? I873Cell { q: 0, r: 0, v: 0 };
  assert("{one}" == "{{q:1,r:2,v:7}}", "the element alone: {one}");
  assert("{f.n}" == "3", "a scalar field alone: {f.n}");

  e = I873Field { cells: [], n: 0 };
  assert("{e}" == "{{cells:[],n:0}}", "an empty hash field: {e}");

  t = I873ByName { by_name: [], n: 2 };
  t.by_name["zeta"] = I873Named { name: "zeta", w: 2 };
  t.by_name["alpha"] = I873Named { name: "alpha", w: 1 };
  assert("{t}" == "{{by_name:[{{name:\"alpha\",w:1}},{{name:\"zeta\",w:2}}],n:2}}",
         "text keys sort as text: {t}");

  o = I873Outer { inner: I873Field { cells: [], n: 1 }, tag: "deep" };
  o.inner.cells[9, 9] = I873Cell { q: 9, r: 9, v: 1 };
  assert("{o}" == "{{inner:{{cells:[{{q:9,r:9,v:1}}],n:1}},tag:\"deep\"}}",
         "a hash one level down: {o}");

  // A removed entry must not come back in the render.
  f.cells[3, 4] = null;
  assert("{f}" == "{{cells:[{{q:1,r:2,v:7}},{{q:5,r:6,v:9}}],n:3}}",
         "after a removal: {f}");

  // Past the initial bucket table, so the render walks a REHASHED one.
  g = I873Field { cells: [], n: 0 };
  for i in 0..40 { g.cells[i, 0] = I873Cell { q: i, r: 0, v: i * 2 }; }
  gt = "{g}";
  assert(size(gt) == 638, "40 entries render to a known length, got {size(gt)}");
  assert(gt.starts_with("{{cells:[{{q:0,r:0,v:0}},{{q:1,r:0,v:2}},"), "rehashed head: {gt}");
  assert(gt.ends_with("{{q:39,r:0,v:78}}],n:0}}"), "rehashed tail: {gt}");

  // The serialiser shares the walk, so it shared the crash. Round-trip, don't just
  // render: a walk that emits plausible text from the wrong slots still fails here.
  j = f.to_json();
  back = j as I873Field;
  assert(back.n == 3, "round trip kept the scalar: {back.n}");
  assert(len(back.cells) == 2, "round trip kept both entries: {len(back.cells)}");
  assert((back.cells[1, 2] ?? I873Cell { q: 0, r: 0, v: 0 }).v == 7, "round trip kept the value");
  assert(back.to_json() == j, "the round trip is a fixed point");

  println("done");
}
