//
// Assigning to a `vector<T>?` field REPLACES what it holds, the way the same
// assignment to a `vector<T>` field always has.
//
// The whole-replace path — clear the field, then build the new contents into it —
// was selected on the field type being `Type::Vector`. A `vector<T>?` field is
// `Optional(Vector(...))`, which did not match, so the replace was skipped entirely
// and the literal's element-construction ops ran on a field that still held its old
// records: `=` silently meant `+=`. Assigning `[9]` over `[7, 8]` read back as three
// elements, identically on both backends (loft#917). An `Optional(τ)` field lays out
// exactly like `τ`, so the `?` never had anything to say about this.
//
// `= null` was worse than wrong — it emitted a discarded null sentinel, so the field
// kept both its records and its length and the statement did nothing at all. It now
// frees them and leaves the field empty.
//
// STILL OPEN, deliberately unasserted here: `q.xs == null` answers false even
// straight after `q.xs = null`. A vector field holds a record id where `0` means "no
// records", and nothing in that encoding is left to mean *absent* rather than
// *empty* — so the reader half waits on a representation, which is what keeps
// loft#917 open. Every assertion below is about the VALUE the field holds, which is
// answerable today.

struct Q { xs: vector<integer>?, tag: integer }
struct P { xs: vector<integer>, tag: integer }

fn tot_of(v: vector<integer>) -> integer {
  s_t = 0;
  for e in v { s_t += e; }
  s_t
}

fn main() {
  // A literal replaces, and replaces again.
  q1 = Q { xs: [7, 8], tag: 1 };
  q1.xs = [9];
  assert(len(q1.xs ?? []) == 1, "one literal over two left len {len(q1.xs ?? [])}, want 1");
  assert(tot_of(q1.xs ?? []) == 9, "replaced holds {tot_of(q1.xs ?? [])}, want 9");
  q1.xs = [4, 5];
  assert(len(q1.xs ?? []) == 2, "second replace left len {len(q1.xs ?? [])}, want 2");
  assert(tot_of(q1.xs ?? []) == 9, "second replace holds {tot_of(q1.xs ?? [])}, want 9");

  // An empty literal empties it.
  q1.xs = [];
  assert(len(q1.xs ?? []) == 0, "empty literal left len {len(q1.xs ?? [])}, want 0");

  // `null` frees what the field holds, rather than dropping the statement.
  q2 = Q { xs: [1, 2, 3], tag: 2 };
  q2.xs = null;
  assert(len(q2.xs ?? []) == 0, "null assign left len {len(q2.xs ?? [])}, want 0");

  // A vector VARIABLE on the right replaces too, and the source is unharmed.
  v3 = [11, 12];
  q3 = Q { xs: [1], tag: 3 };
  q3.xs = v3;
  assert(len(q3.xs ?? []) == 2, "var replace left len {len(q3.xs ?? [])}, want 2");
  assert(tot_of(q3.xs ?? []) == 23, "var replace holds {tot_of(q3.xs ?? [])}, want 23");
  assert(len(v3) == 2, "the source vector lost elements: len {len(v3)}, want 2");

  // A call result on the right — the shape that allocates its own storage.
  q4 = Q { xs: [1, 1, 1], tag: 4 };
  q4.xs = built(2);
  assert(len(q4.xs ?? []) == 2, "call replace left len {len(q4.xs ?? [])}, want 2");
  assert(tot_of(q4.xs ?? []) == 2, "call replace holds {tot_of(q4.xs ?? [])}, want 2");

  // `+=` still APPENDS — the fix is about `=`, and must not have changed the other.
  q5 = Q { xs: [1], tag: 5 };
  q5.xs += [2];
  assert(len(q5.xs ?? []) == 2, "append left len {len(q5.xs ?? [])}, want 2");
  assert(tot_of(q5.xs ?? []) == 3, "append holds {tot_of(q5.xs ?? [])}, want 3");

  // Repeated replace in a loop: the field must not grow, and must not leak.
  q6 = Q { xs: [], tag: 6 };
  for i in 0..20 { q6.xs = [i, i]; }
  assert(len(q6.xs ?? []) == 2, "20 replaces left len {len(q6.xs ?? [])}, want 2");
  assert(tot_of(q6.xs ?? []) == 38, "last replace holds {tot_of(q6.xs ?? [])}, want 38");

  // The non-nullable control, which was correct throughout and must stay so.
  p1 = P { xs: [7, 8], tag: 1 };
  p1.xs = [9];
  assert(len(p1.xs) == 1, "non-null replace left len {len(p1.xs)}, want 1");
  p1.xs += [10];
  assert(len(p1.xs) == 2, "non-null append left len {len(p1.xs)}, want 2");

  println("917 ok");
}

fn built(n: integer) -> vector<integer> {
  b_v = [];
  for _ in 0..n { b_v += [1]; }
  b_v
}
