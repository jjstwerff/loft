//
// A void function whose body ends in a VALUE expression (loft#1075).
//
//   fn f() -> boolean { true }
//   fn main() { f() }
//
// ran on `--interpret` and would not compile on `--native` — a bare rustc `E0308:
// mismatched types … expected `()`, found `u8`` quoting a line of a temporary `.rs` file,
// under the message "native compilation failed (codegen bug)".  `--native` is the DEFAULT
// backend, so a plain `loft t.loft` failed this way, and the shape is ordinary: a
// `[[build.asset]]` script whose last expression is a call returning `boolean` is how it
// was found.
//
// The two backends had not each picked an answer — the IR had already picked one, and it
// was the BLOCK's TYPE that had not followed.  `parse_block` wraps a value-typed statement
// in `Value::Drop` when the enclosing definition returns nothing, so BOTH backends receive
// `drop n_f();` and the discard is the shipped, single answer.  But every statement except
// the LAST reaches the `t = Type::Void` at the foot of the statement loop, so a dropped
// tail left the block typed `boolean` in a function whose signature is `()`.  The native
// emitter takes the signature from the DECLARED return and the body's trailing default
// value from the block's INFERRED type, so it emitted `0 as u8` inside a `()` function.
//
// The interpreter did not merely ignore it: `test_a_tail_that_is_not_a_call`'s struct
// literal was still allocated at program exit ("1 stores not freed"), held by the same
// wrong type.  So this is one cause with two symptoms, one per backend — a build failure
// on `--native` and a leak on `--interpret` — which is why the fix is in the parser and
// not in the emitter that reported it.
//
// The tell is next door: `fn main() { f(); }` — the same IR down to the `drop` — always
// worked on both backends, because the `;` sent the statement round the loop to that
// reset.  A one-token difference deciding whether a program compiles is what says the
// block type, not the emitter, is the thing that was wrong.
//
// Every cell here checks that the tail RAN as well as that the program builds: the
// discard must be of the value, not of the work.  A cell that only checked the exit code
// would pass on a compiler that deleted the tail outright.
//
// `test_the_semicolon_form_is_unchanged`, `test_a_value_function_still_returns_its_tail`
// and `test_a_block_expression_still_yields_its_tail` are the controls — the fix is about
// a DROPPED tail, so a tail that is not dropped must be untouched.
//
// `test_a_lambda_still_infers_its_return_from_its_tail` is not a control but an EXCEPTION,
// and it is a cell an attempt at this fix failed.  `result == Void` reaches the drop
// meaning two different things, and only one of them is a decision: a function DECLARED
// with no return type on one hand, and a placeholder something else will fill in on the
// other.  There are two placeholders.  A LAMBDA's, whose return type is INFERRED from this
// very block type, is the one pinned here.  The other is a `{ … }` in STATEMENT position,
// which is parsed against Void even when it is the TAIL of an enclosing block and is then
// the value that block yields — `x = {{ …; n }}`, the shape the Rust test harness writes
// around every `.expr(…)`.  It is NOT pinned here, because a doubly-braced block has its
// own pre-existing defect (measured on a pristine tree: `{ { n } }` yields `5` on
// `--interpret` and `0` on `--native`, and `{ { 5 } }` yields null on both), so no cell
// could assert a correct value for it.  What pins it instead is
// `tests/expressions.rs::coroutine_character_iterator_exhausts`, whose `.expr(…)` wrapper
// is exactly that shape: without the context gate it fails with a parse error four lines
// on, in an `assert` whose first argument had become void.  Hence the gate on the
// function-body context.
//
// (Measured on a pristine tree at 655ff4dd: every non-control cell below failed to compile
// on `--native` with E0308 and ran on `--interpret`.  Type made no difference — boolean,
// integer, text, struct, vector, tuple and a narrow `u8` all did it — and neither did
// `main` versus an ordinary function.)

struct VtRec { n: integer, s: text }

fn vt_bump(c: vector<integer>) -> boolean { c[0] = c[0] + 1; true }
fn vt_bump_int(c: vector<integer>) -> integer { c[0] = c[0] + 1; 7 }
fn vt_bump_text(c: vector<integer>) -> text { c[0] = c[0] + 1; "hi" }
fn vt_bump_rec(c: vector<integer>) -> VtRec { c[0] = c[0] + 1; VtRec { n: 3, s: "x" } }
fn vt_bump_vec(c: vector<integer>) -> vector<integer> { c[0] = c[0] + 1; [1, 2] }
fn vt_bump_tuple(c: vector<integer>) -> (integer, text) { c[0] = c[0] + 1; (1, "z") }
fn vt_bump_narrow(c: vector<integer>) -> u8 { c[0] = c[0] + 1; 200 }

// The shape itself, once per tail type — each of these functions is DECLARED void and
// ends in a value.
fn vt_tail_bool(c: vector<integer>) { vt_bump(c) }
fn vt_tail_int(c: vector<integer>) { vt_bump_int(c) }
fn vt_tail_text(c: vector<integer>) { vt_bump_text(c) }
fn vt_tail_rec(c: vector<integer>) { vt_bump_rec(c) }
fn vt_tail_vec(c: vector<integer>) { vt_bump_vec(c) }
fn vt_tail_tuple(c: vector<integer>) { vt_bump_tuple(c) }
fn vt_tail_narrow(c: vector<integer>) { vt_bump_narrow(c) }
fn vt_tail_literal(c: vector<integer>) { vt_bump(c); 5 }
fn vt_tail_arith(c: vector<integer>) { vt_bump(c); 2 + 3 }
fn vt_tail_struct_literal(c: vector<integer>) { vt_bump(c); VtRec { n: 1, s: "y" } }
fn vt_tail_if(c: vector<integer>) { if true { vt_bump(c) } else { false } }
fn vt_tail_block(c: vector<integer>) { { vt_bump(c) } }
fn vt_tail_semicolon(c: vector<integer>) { vt_bump(c); }

fn test_every_tail_type_runs_and_is_discarded() {
  c: vector<integer> = [0];
  vt_tail_bool(c);
  vt_tail_int(c);
  vt_tail_text(c);
  vt_tail_rec(c);
  vt_tail_vec(c);
  vt_tail_tuple(c);
  vt_tail_narrow(c);
  assert(c[0] == 7, "seven void functions with value tails all ran: got {c[0]}");
}

fn test_a_tail_that_is_not_a_call() {
  // Cell 6 of the issue's boundary: `fn main() { 5 }`.  No call in the tail at all, so it
  // was never about the call — any value-typed tail did it.
  c: vector<integer> = [0];
  vt_tail_literal(c);
  vt_tail_arith(c);
  vt_tail_struct_literal(c);
  assert(c[0] == 3, "a literal, an operator and a struct literal as tails: got {c[0]}");
}

fn test_a_tail_that_is_an_if_or_a_block() {
  c: vector<integer> = [0];
  vt_tail_if(c);
  vt_tail_block(c);
  assert(c[0] == 2, "an if-expression and a nested block as tails: got {c[0]}");
}

fn test_the_semicolon_form_is_unchanged() {
  // Control: this always worked, on both backends — the `;` is what sent the statement
  // round the loop to the reset the last statement missed.
  c: vector<integer> = [0];
  vt_tail_semicolon(c);
  assert(c[0] == 1, "the semicolon form: got {c[0]}");
}

fn test_a_value_function_still_returns_its_tail() {
  // Control: the fix keys on a tail that is DROPPED, which happens only when the
  // enclosing function is declared void.  A declared return type must be unaffected.
  c: vector<integer> = [0];
  assert(vt_bump_int(c) == 7, "a value function returns its tail: got {vt_bump_int(c)}");
  assert(vt_indirect(c) == 7, "…and through another function: got {vt_indirect(c)}");
}

fn test_a_block_expression_still_yields_its_tail() {
  // Control: a block in VALUE position is checked against the expected type, not against
  // void, so its tail is not dropped and it still yields.
  c: vector<integer> = [0];
  x = {
    vt_bump(c);
    5
  };
  assert(x == 5, "a block expression yields its tail: got {x}");
  assert(c[0] == 1, "…and its earlier statements ran: got {c[0]}");
}

fn test_a_lambda_still_infers_its_return_from_its_tail() {
  // The other placeholder, and the reason a first attempt at this fix was wrong.  A LAMBDA
  // declares no return type either, so the block its body is parsed into carries the same
  // `Void` a declared-void function does — and the opposite meaning: a placeholder its
  // return type is INFERRED from, not a decision that nothing comes back.  Its tail is
  // wrapped in a `Drop` it does not mean, so flattening the block type there gave every
  // short `|x| { … }` a void return and `map` refused it with D-clo-2's "cannot infer the
  // type of the function passed to `map`".
  v: vector<integer> = [1, 2].map(|y| { y * 2 });
  assert(v[0] == 2, "a short lambda's inferred return: got {v[0]}");
  assert(v[1] == 4, "…for the second element too: got {v[1]}");
  k = 10;
  c: vector<integer> = [1].map(|y| { y + k });
  assert(c[0] == 11, "…and a capturing one: got {c[0]}");
  d: vector<integer> = [1, 2, 3].filter(|y| { y > 1 });
  assert(len(d) == 2, "…and a boolean-returning one through filter: got {len(d)}");
}

fn test_the_discard_does_not_accumulate() {
  // A heap-returning tail discarded 200 times.  The value is dropped, so nothing it owns
  // may survive the call — measured separately as a flat resident size from 1 000 to
  // 800 000 iterations, identical to the semicolon form.
  c: vector<integer> = [0];
  for _i in 0..200 {
    vt_tail_text(c);
    vt_tail_rec(c);
    vt_tail_vec(c);
  }
  assert(c[0] == 600, "600 discarded heap tails: got {c[0]}");
}

fn vt_indirect(c: vector<integer>) -> integer { vt_bump_int(c) }

fn main() {
  test_every_tail_type_runs_and_is_discarded();
  test_a_tail_that_is_not_a_call();
  test_a_tail_that_is_an_if_or_a_block();
  test_the_semicolon_form_is_unchanged();
  test_a_value_function_still_returns_its_tail();
  test_a_block_expression_still_yields_its_tail();
  test_a_lambda_still_infers_its_return_from_its_tail();
  test_the_discard_does_not_accumulate();
}
