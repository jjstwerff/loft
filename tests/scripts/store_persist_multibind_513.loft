//
// Regression for #513 — within a SINGLE process, every `store_persist_bind`
// into a freshly-declared hash must read the persisted data, not just the
// first bind.  The bug: freeing a bound (mmap) store left it in its slot, and
// reusing that slot `init()`'d the empty-store header THROUGH the mmap, so a
// later bind read an empty hash (fixed in `Stores::reinit_reused_slot`).
//
// Driven by tests/store_persist_loft.rs on BOTH backends with a scratch
// $LOFT_PERSIST_TEST_PATH.  Argless (loft_suite) → benign no-op.

struct Rec {
  id: integer,
  v: integer,
}

fn count(h: hash<Rec[id]>) -> integer {
  n = 0; for _x in h { n = n + 1; } n
}

fn build(path: text) {
  // build + persist; frame dropped on return
  h: hash<Rec[id]> = [];
  h += Rec { id: 1, v: 10 };
  h += Rec { id: 2, v: 20 };
  h += Rec { id: 3, v: 30 };
  _ = store_persist_bind(h, path);
}

fn readc(path: text) -> integer {
  // fresh hash, bind, count — the reused-slot case
  g: hash<Rec[id]> = [];
  _ = store_persist_bind(g, path);
  count(g)
}

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH");
  if path == "" { return } // argless run (loft_suite) → no-op
  build(path);
  // Three independent binds after the first bound store's frame dropped.
  // Bug produced 3,0,0 (interpret) / 0,0,0 (native); fix gives 3,3,3.
  println("counts={readc(path)},{readc(path)},{readc(path)}");
}
