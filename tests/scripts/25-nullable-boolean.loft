// @PLN25 — a `boolean?` (Optional(Boolean)) stores as u8 (tri-state 0/1/255). The bool→u8
// wrap must fire in DIRECT positions (local init, reassign, comparison rvalue, return,
// param default, call-arg), not only at field/vector/join seams — else native emits a
// `bool` value into a `u8` slot (rustc E0308). Both backends must agree.
fn ret_true() -> boolean? {
  true
}
fn param_default(b: boolean? = true) -> boolean? {
  b
}
fn as_arg(b: boolean?) -> boolean? {
  b
}

fn main() {
  loc: boolean? = true; assert(loc == true, "local init");
  cmp: boolean? = (2 > 1); assert(cmp == true, "comparison rvalue");
  nul: boolean? = null; assert(nul == null, "null literal");
  re: boolean? = true; assert(re == true, "reassign step 1");
  re = false; assert(re == false, "reassign step 2");
  assert(ret_true() == true, "return true");
  assert(param_default() == true, "param default");
  assert(param_default(false) == false, "param default overridden");
  assert(as_arg(null) == null, "call-arg null");
  assert(as_arg(true) == true, "call-arg true");
}
