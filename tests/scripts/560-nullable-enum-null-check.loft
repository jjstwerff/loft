//
// @PLN102 — a nullable value-enum was un-null-checkable: `n: Color? = null`
// rendered `null` but `n == null` was false, `n ?? d` didn't coalesce, and
// `if !n` treated it as present.  Root: `convert(Null, Enum)` skipped
// `OpConvEnumFromNull` (the FromNull loop matched by return type, and that op
// returns the generic `enumerate`, never `is_equal` to a specific `Enum(Color)`),
// so the slot held a bare-null byte 0 while every consumer tests the 255
// sentinel.  Fixed by converting a null value-enum target to its typed null (255).

enum Color {
  Red,
  Green,
  Blue,
}
struct Box {
  c: Color?,
}
struct NN {
  col: Color,
}
fn pick(present: boolean) -> Color? {
  if present { Color.Red } else { null }
}

fn test() {
  // --- VARIABLE: null vs present ---
  n: Color? = null;
  m: Color? = Color.Green;
  assert(n == null, "null enum variable == null");
  assert(!(n != null), "null enum variable != null is false");
  assert(m != null, "present enum variable != null");
  assert(!(m == null), "present enum variable == null is false");

  // coalescing
  assert((n ?? Color.Blue) == Color.Blue, "null enum coalesces to default");
  assert((m ?? Color.Blue) == Color.Green, "present enum keeps its value");

  // boolean / render
  assert(!n, "!null enum is true (absent)");
  assert("{n}" == "null", "null enum renders null");

  // --- REASSIGNMENT: present -> null ---
  x: Color? = Color.Green;
  x = null;
  assert(x == null, "reassigned-to-null enum == null");

  // --- FUNCTION RETURN ---
  assert(pick(false) == null, "function returning null enum == null");
  assert(pick(true) != null, "function returning present enum != null");

  // --- INLINE STRUCT FIELD ---
  b: Box = Box { c: null };
  b2: Box = Box { c: Color.Red };
  assert(b.c == null, "null enum struct field == null");
  assert(b2.c != null, "present enum struct field != null");
  assert((b.c ?? Color.Blue) == Color.Blue, "null enum field coalesces");

  // --- NON-NULLABLE enum field == null ---
  // A value-enum field read is a disc byte (null = disc 0), NOT a store_nr
  // sentinel: `field == null` must test the disc, not OpRefIsNull — which used to
  // apply `.store_nr` to a u8 (native E0610) and read a wrong value.  On a present
  // struct the field is never null; through a NULL struct receiver it reads null.
  se: NN = NN { col: Color.Green };
  assert(!(se.col == null), "non-null enum field of present struct is not null");
  sn: NN? = null;
  assert(sn.col == null, "non-null enum field read through a null struct is null");
}
