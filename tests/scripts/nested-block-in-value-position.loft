// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A `{ … }` block that IS another block's value keeps its own tail.
//
//   fn f() -> integer { { 5 } }        // answered null on --interpret, 0 on --native
//   fn g() -> integer { n = 5; { n } } // answered 5 on --interpret, 0 on --native
//
// Silently, on both backends, and with the two of them DISAGREEING on the second one —
// which is the shape that says this is a lowering fault rather than a rule nobody wrote
// down. The function type-checked the whole time: `t` is the inner block's type, so
// `-> integer` was satisfied and only the VALUE was thrown away.
//
// Every `{ … }` reaching `expression` is parsed against `Type::Void` — a STATEMENT block,
// as far as that site can tell — so its tail is wrapped in a `Value::Drop`. That is right
// for a statement and wrong for a block whose value someone reads. The parse site cannot
// tell them apart: which statement turns out to be the last one is not known until the `}`,
// and the expected type it would otherwise need is not threaded for a plain scalar (the
// wider question of loft#942/#943). So the drop is undone at the one point that does
// know — after the statement loop, where the block's type is already the value it yields.
//
// The rule is local and total, which is what makes `nb_depth_three` (`{ { { 5 } } }`) work
// rather than only the one-level case: a block typed as a VALUE ends in that value, and
// whether anyone wants it is the enclosing level's question — the enclosing level wraps the
// whole block in a `Drop` of its own when the answer is no. A first version that looked one
// level down instead, for a nested block whose tail was dropped, repaired depth 2 and left
// depth 3 answering null.
//
// The type is `Void` for a tail that was legitimately dropped — the `;` form, and the body
// of a function declared with no return type (`formal/calls.md` `(F-Drop)`) — so both are
// untouched, and the last two cells are the controls that say so.
//
// And the repair is restricted to a bare `{ … }`, which is the only context handed a `Void`
// it did not mean. A `for` / `while` / `parallel for` / `fields` body gets one because it IS
// a statement — its tail cannot be anyone's value — and undoing the drop there leaks
// whatever the tail returned. Measured: `for i in 0..8 { dcr_make(i) }` leaked one store per
// round, reopening loft#725, which is what `725-discarded-call-result-freed.loft` catches.
//
// (Measured at 2806884c, the commit before the fix: `a literal tail: got null` on
// `--interpret` and `got 0` on `--native`.)
//
// Found while writing the loft#1075 guard: `x = {{ …; n }}` is the shape the Rust test
// harness writes around every `.expr(…)`, and a cell that wanted to assert it could not,
// because the value was wrong for a reason of its own.

struct NbRec { n: integer, s: text }

fn nb_bump(c: vector<integer>) -> boolean { c[0] = c[0] + 1; true }

fn nb_literal_tail() -> integer { { 5 } }
fn nb_local_tail() -> integer { n = 5; { n } }
fn nb_call_tail(c: vector<integer>) -> boolean { { nb_bump(c) } }
fn nb_arith_tail() -> integer { { 2 + 3 } }
fn nb_text_tail() -> text { { "hi" } }
fn nb_rec_tail() -> NbRec { { NbRec { n: 3, s: "x" } } }
fn nb_vec_tail() -> vector<integer> { { [1, 2] } }
fn nb_depth_three() -> integer { { { { 5 } } } }
fn nb_if_arm(c: boolean) -> integer { if c { { 5 } } else { 6 } }
fn nb_after_a_statement(c: vector<integer>) -> integer { nb_bump(c); { 5 } }
fn nb_void_tail(c: vector<integer>) { { nb_bump(c) } }
fn nb_semicolon_tail() -> integer { n = 5; { n }; n }

fn test_a_nested_block_yields_its_tail() {
  assert(nb_literal_tail() == 5, "a literal tail: got {nb_literal_tail()}");
  assert(nb_local_tail() == 5, "a local tail: got {nb_local_tail()}");
  assert(nb_arith_tail() == 5, "an operator-expression tail: got {nb_arith_tail()}");
  assert(nb_text_tail() == "hi", "a text tail: got {nb_text_tail()}");
}

fn test_a_nested_block_yielding_a_heap_value() {
  r = nb_rec_tail();
  assert(r.n == 3, "a struct tail, first field: got {r.n}");
  assert(r.s == "x", "a struct tail, second field: got {r.s}");
  v = nb_vec_tail();
  assert(len(v) == 2, "a vector tail, length: got {len(v)}");
  assert(v[0] == 1, "a vector tail, first element: got {v[0]}");
}

fn test_a_nested_block_whose_tail_is_a_call() {
  c: vector<integer> = [0];
  assert(nb_call_tail(c), "a call tail answers its value");
  assert(c[0] == 1, "…and the call ran once: got {c[0]}");
}

fn test_depth_and_position() {
  assert(nb_depth_three() == 5, "three levels of nesting: got {nb_depth_three()}");
  assert(nb_if_arm(true) == 5, "a nested block as an if arm: got {nb_if_arm(true)}");
  assert(nb_if_arm(false) == 6, "the other arm is unaffected: got {nb_if_arm(false)}");
  // Bound, not called inside the assert: `assert`'s MESSAGE is evaluated too, so a
  // side-effecting call written twice runs twice.
  c: vector<integer> = [0];
  after = nb_after_a_statement(c);
  assert(after == 5, "a tail after a statement: got {after}");
  assert(c[0] == 1, "…and the statement before it ran: got {c[0]}");
}

fn test_a_block_expression_bound_directly() {
  // Control: a `{ … }` on the right of an assignment always worked — it is parsed through
  // a different site, with no `Void` to mistake for a decision.
  x = { 5 };
  assert(x == 5, "a single-braced block on an assignment: got {x}");
  n = 7;
  y = {{
    n
  }};
  assert(y == 7, "a doubly-braced one, the test harness's own shape: got {y}");
}

fn test_a_void_function_still_discards_a_nested_block_tail() {
  // Control, and the boundary with `formal/calls.md`'s `(F-Drop)`: the enclosing block's
  // type is `Void` there, so the tail was dropped on purpose and must stay dropped — the
  // call inside it still runs.
  c: vector<integer> = [0];
  nb_void_tail(c);
  assert(c[0] == 1, "the tail of a void function still runs: got {c[0]}");
}

fn test_a_nested_block_in_statement_position_is_still_a_statement() {
  // Control: only the TAIL is repaired.  A nested block followed by `;` is an ordinary
  // statement, and the value after it is the block's.
  assert(nb_semicolon_tail() == 5, "a nested block mid-body: got {nb_semicolon_tail()}");
}

fn main() {
  test_a_nested_block_yields_its_tail();
  test_a_nested_block_yielding_a_heap_value();
  test_a_nested_block_whose_tail_is_a_call();
  test_depth_and_position();
  test_a_block_expression_bound_directly();
  test_a_void_function_still_discards_a_nested_block_tail();
  test_a_nested_block_in_statement_position_is_still_a_statement();
}
