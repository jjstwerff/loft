//
// loft#755 — `for c in s` must yield every character the text holds, including
// a NUL.  It used to terminate on the yielded CHARACTER, and `character`'s null
// is code point 0, so a NUL the text really carries read as end-of-text: the
// loop stopped there while `len`, `size`, `byte_at`, `find` and slicing all
// reported and returned the bytes past it.  `text_from_bytes` builds such a
// text from valid UTF-8, so the value is reachable through a public route and
// a decoder that assembled bytes and then iterated silently lost its tail.
//
// The guarantee pinned here is the one the six accessors have to share:
// ITERATION YIELDS EXACTLY `len(s)` CHARACTERS, whatever those characters are.
// That is render-independent — it does not depend on how a null character
// prints — and it is what the fix made true (position-based termination, the
// same shape the vector arm already used).

fn one(c: character) -> integer { 1 }

// Characters visited by a plain `for` over the text these bytes spell.
fn visited(v: vector<u8>) -> integer {
  s = text_from_bytes(v);
  n = 0;
  for c in s { n += 1; }
  n
}

// Same walk, driven through the par materialiser — a second iteration site
// that read the same value sentinel and truncated identically.
fn visited_par(v: vector<u8>) -> integer {
  s = text_from_bytes(v);
  n = 0;
  for c in s par(d = one(c), 2) { n += d; }
  n
}

fn agrees(v: vector<u8>, name: text) {
  s = text_from_bytes(v);
  assert(visited(v) == len(s),
    "for over {name} must yield len(s)={len(s)} characters, got {visited(v)}");
}

fn main() {
  // A NUL anywhere in the text — leading, interior, trailing, doubled — no
  // longer ends the walk.  Each was 0 or 1 iterations before the fix.
  agrees([65, 0, 66], "A NUL B");
  agrees([65, 0], "A NUL");
  agrees([0, 65], "NUL A");
  agrees([0, 0], "NUL NUL");
  agrees([195, 169, 0, 195, 169], "e-acute NUL e-acute");

  // Controls — texts with no NUL at all, which always walked correctly.  They
  // are here so the guarantee cannot be met by over-counting: multi-byte
  // characters must still advance by their own width, not by one byte.
  agrees([65, 66], "AB");
  agrees([104, 195, 169, 108], "h e-acute l");
  agrees([], "empty");

  // A multi-byte literal counts characters, not bytes.
  n = 0;
  for c in "hello" { n += 1; }
  assert(n == 5, "for over a multi-byte literal yields 5 characters, got {n}");

  // The one text that is NOT covered by the rule above: loft's null text IS
  // the one-byte NUL string, so `size` answers 1 for it while it holds no
  // characters at all.  It must yield nothing — the fix has to know a null
  // text apart from a text whose first character is a NUL.
  lone = text_from_bytes([0]);
  z = 0;
  for c in lone { z += 1; }
  assert(z == 0, "a null text holds no characters, got {z}");

  // Both iteration sites agree.
  p = visited_par([65, 0, 66]);
  assert(p == 3, "par over a NUL-carrying text visits 3 characters, got {p}");
}
