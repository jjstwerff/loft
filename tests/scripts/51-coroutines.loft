// CO1: Coroutines — yield, iterator<T>, next(), exhausted(), for-loop, text param, nested call.
// CO1.4: yield from delegation.

fn count() -> iterator<integer> {
  yield 10;
  yield 20;
  yield 30;
}

fn one_val() -> iterator<integer> {
  yield 42;
}

fn double(x: integer) -> integer { x * 2 }

fn gen_doubles() -> iterator<integer> {
  yield double(5);
  yield double(10);
}

fn gen_len(s: text) -> iterator<integer> {
  yield len(s);
  yield len(s);
}

fn inner_vals() -> iterator<integer> {
  yield 10;
  yield 20;
}

fn outer_with_from() -> iterator<integer> {
  yield 1;
  yield from inner_vals();
  yield 2;
}

// P211: text-yielding generator with sequential top-level yields.
fn names() -> iterator<text> {
  yield "alice";
  yield "bob";
  yield "carol";
}

// P211: text-yielding generator driven by `while` (exercises both
// P210's Value::Loop arm in collect_segments and the next_text path
// for non-trivial state).
fn ticks_text(n: integer) -> iterator<text> {
  i = 0;
  while i < n {
    yield "tick";
    i = i + 1;
  }
}

fn main() {
  // --- CO1.3: next() advances generator ---
  gen = count();
  a = next(gen);
  b = next(gen);
  c = next(gen);
  assert(a + b + c == 60, "sequence sum: {a}+{b}+{c}");

  // --- CO1.6: exhausted() after all yields consumed ---
  g = one_val();
  next(g);
  next(g);
  done = exhausted(g);
  assert(done, "exhausted after last yield");

  // --- CO1.5: for-loop over generator ---
  total = 0;
  for n in count() { total += n; }
  assert(total == 60, "for-loop sum: {total}");

  // --- CO1.3e: nested call — helper invoked between yields ---
  total2 = 0;
  for n in gen_doubles() { total2 += n; }
  assert(total2 == 30, "nested call yields: {total2}");

  // --- CO1.3d: text parameter survives yield/resume ---
  total3 = 0;
  for n in gen_len("hello") { total3 += n; }
  assert(total3 == 10, "text param survives yield: {total3}");

  // --- CO1.4: yield from delegation ---
  yf_total = 0;
  for n in outer_with_from() { yf_total += n; }
  assert(yf_total == 33, "yield from: {yf_total}");

  // --- P211: text-yielding generator round-trips ---
  joined = "";
  for s in names() { joined = joined + s + ","; }
  assert(joined == "alice,bob,carol,", "text yield concat: {joined}");

  // --- P211: text yield from a `while` loop ---
  ticks_seen = 0;
  for t in ticks_text(4) { ticks_seen = ticks_seen + 1; assert(t == "tick", "tick val"); }
  assert(ticks_seen == 4, "ticks count: {ticks_seen}");

  println("CO1: coroutines ok");
}
