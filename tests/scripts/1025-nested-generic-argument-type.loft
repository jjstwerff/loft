//
// A generic calling another generic was refused whenever the callee's parameter was
// `vector<T>` rather than a bare `T`.
//
// When a monomorph is built, every generic its body calls has to be instantiated too.
// `instantiate_nested_generics` did that at `concrete` — the type the OUTER monomorph
// bound its own variable to — which is right only if the nested generic takes a bare `T`.
// With `vector<T>`, the ordinary spelling, the callee was handed `integer` where its
// parameter reads `vector<T>`: resolution answered `Unknown` and the program was refused
// with *"Cannot resolve generic type parameter from argument type"*, pointing at the
// callee's own declaration rather than at anything the author had written wrong.
//
// A generic calling a generic is the whole point of the feature, so this was not an exotic
// shape — it was most of it.  The argument type now comes from the CALL, read out of the
// monomorph's own (already substituted) variable table, so it is the concrete type really
// being passed.
//
// Found while probing loft#1023's boundary; measured identically on the pristine baseline.

pub fn ilen1025 < T > (v: vector<T>) -> integer { len(v) }
pub fn olen1025 < T > (v: vector<T>) -> integer { ilen1025(v) }

pub fn inull1025 < T > (v: vector<T>, a: T? = null) -> boolean { len(v) >= 0 && a == null }
pub fn onull1025 < T > (v: vector<T>) -> boolean { inull1025(v) }
pub fn opass1025 < T > (v: vector<T>, b: T? = null) -> boolean { inull1025(v, b) }

fn test_a_generic_calling_a_generic_over_a_vector_parameter() {
  // The filed shape, with no nullable anywhere: it was refused outright.
  assert(olen1025([1, 2]) == 2, "the nested call reads the vector's length");
  assert(olen1025(["a", "b", "c"]) == 3, "and again for a heap element type");
}

fn test_the_nested_callee_may_have_a_defaulted_nullable() {
  assert(onull1025([1]), "the nested callee's omitted argument is null");
  assert(onull1025(["x"]), "and for a heap element type too");
}

fn test_the_outer_may_pass_its_own_nullable_through() {
  assert(opass1025([1]), "an omitted argument passes through as null");
  assert(!opass1025([1], 5), "a supplied argument passes through as itself");
}

fn test_a_nested_generic_declared_below_its_caller() {
  // The PASS-1 body class: the templates below are declared after every caller, so the
  // monomorphs were built before their bodies existed.  This answered `false` on the
  // interpreter and `null` on `--native` — wrong, silently, and differently on each.
  assert(dnull1025([1]), "the nested omitted argument is null");
  assert(dlen1025([1, 2]) == 2, "and a plain nested call reads its length");
}

fn test_each_instantiation_reaches_its_own_nested_monomorph() {
  // Two element types through one nesting: the nested monomorph is chosen per outer
  // instantiation, so a single shared one would answer one of these wrongly.
  a = olen1025([1, 2]);
  b = olen1025(["a", "b", "c"]);
  assert(a == 2 && b == 3, "each nesting reaches its own monomorph, got {a} {b}");
}

// Declared AFTER every caller on purpose — see the pass-1-body cell above.
pub fn dinner1025 < T > (v: vector<T>, a: T? = null) -> boolean { len(v) >= 0 && a == null }
pub fn dnull1025 < T > (v: vector<T>) -> boolean { dinner1025(v) }
pub fn dilen1025 < T > (v: vector<T>) -> integer { len(v) }
pub fn dlen1025 < T > (v: vector<T>) -> integer { dilen1025(v) }
