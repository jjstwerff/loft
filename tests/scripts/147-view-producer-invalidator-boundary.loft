//
// @PLN130 — the producer × invalidator boundary: WHICH binds mint a view, and WHAT invalidates
// one.  Graduated from probes 25, 27, 29, 31, 32, 33, 34.
//
// This is the boundary the plan spent most of its measurement on, and it was resting on nothing:
// the fixes for the FAILING cells got regression tests (`144`, `145`, `146`, `200`, `201`, `774`)
// while the cells that PASS — the ones establishing where the defect stops — stayed in `probes/`,
// which CI does not run.  A passing cell is exactly what a future change to the materialise
// analysis moves silently: strip a dep too eagerly and a view that should alias becomes a copy;
// strip too little and a stale view comes back.  Neither shows up in the fix tests.
//
// So each cell below pins one answer to *"is this bind a view or a copy, and does this operation
// invalidate it?"*  The split is deliberately NOT visible in the source — that is the finding —
// so the assertions are what document it:
//
//   producer                                    | verdict
//   `v[i]` / `v[i].f`                           | VIEW  (pinned by 145)
//   a captured `for` loop var                   | COPY  (K1 here)
//   a view stored into another record            | COPY  (K2 here)
//   a `match` capture, heap payload              | VIEW  (K3 here)
//   a `match` capture, SCALAR payload            | COPY  (K3 here — the loft#673 doc split)
//   a destructured tuple element                 | COPY  (K4 here)
//
//   invalidator                                  | effect
//   `remove` / `#remove` on the container        | the view materialises (pinned by 145)
//   `#remove` of OTHER elements while a view lives| view materialises, container intact (K5)
//   reshaping a NESTED container through the view | the OUTER view stays valid (K6)
//   `par` reads over the container                | nothing invalidated (K7)

struct Box    { n: integer, tag: integer = 0 }
struct Holder { inner: Box }
struct Outer  { id: integer, data: vector<integer> = [] }

enum Payload { Num { v: integer }, Items { items: vector<Box> } }

fn dbl(b: Box) -> integer { b.n * 2 }

fn pick(v: vector<Box>) -> (Box, integer) { (v[2], 2) }

// K1 — a captured `for` loop variable is a COPY, not an index-pinned view.  If this flips, a
// write through the capture starts reaching the container and a removal starts reaching the
// capture.
fn k1_loop_capture_copies() {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
  keep = Box { n: 0 };
  for b in boxes {
    if b.n == 33 { keep = b; }
  }
  assert(keep.n == 33 && keep.tag == 333, "147 K1 keep {keep.n}/{keep.tag} want 33/333");
  keep.n = 99;
  assert(boxes[2].n == 33, "147 K1 boxes[2].n {boxes[2].n} want 33 (capture must be a copy)");
  boxes.remove(0);
  assert(len(boxes) == 2, "147 K1 len {len(boxes)} want 2");
  assert(keep.n == 99 && keep.tag == 333, "147 K1 after remove {keep.n}/{keep.tag} want 99/333");
  assert(boxes[1].n == 33, "147 K1 e1 {boxes[1].n} want 33");
}

// K2 — a view STORED into another record copies, so a later removal cannot reach it.
fn k2_stored_view_copies() {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
  h = Holder { inner: boxes[2] };
  assert(h.inner.n == 33 && h.inner.tag == 333, "147 K2 pre {h.inner.n}/{h.inner.tag} want 33/333");
  boxes.remove(0);
  assert(h.inner.n == 33, "147 K2 h.inner.n {h.inner.n} want 33");
  assert(h.inner.tag == 333, "147 K2 h.inner.tag {h.inner.tag} want 333");
  assert(len(boxes) == 2, "147 K2 len {len(boxes)} want 2");
  assert(boxes[1].n == 33, "147 K2 e1 {boxes[1].n} want 33");
}

// K3 — a `match` capture splits BY PAYLOAD TYPE: a heap payload is a view (writes reach the
// subject), a SCALAR payload is a copy.  LOFT.md once claimed "a view whatever the field's
// type"; that was corrected (@PLN130 F6, loft#673) and this is what holds it corrected.
fn k3_match_capture_splits_by_payload() {
  p = Payload::Items { items: [Box { n: 11 }, Box { n: 22 }] };
  match p {
    Items { items } => {
      items[0].n = 77;              // heap payload — a view, so the write reaches `p`
    },
    Num { v } => { }
  }
  match p {
    Items { items } => {
      assert(items[0].n == 77, "147 K3 heap payload {items[0].n} want 77 (must be a view)");
    },
    Num { v } => { }
  }

  s = Payload::Num { v: 5 };
  match s {
    Num { v } => {
      v = 9;                        // SCALAR payload — a copy, so `s` keeps 5
    },
    Items { items } => { }
  }
  match s {
    Num { v } => {
      assert(v == 5, "147 K3 scalar payload {v} want 5 (must be a copy)");
    },
    Items { items } => { }
  }
}

// K4 — a destructured tuple element COPIES: the write does not reach the container, and a
// later removal does not reach the binding.
fn k4_tuple_element_copies() {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
  (chosen, idx) = pick(boxes);
  assert(idx == 2, "147 K4 idx {idx} want 2");
  assert(chosen.n == 33 && chosen.tag == 333, "147 K4 chosen {chosen.n}/{chosen.tag} want 33/333");
  chosen.n = 99;
  assert(boxes[2].n == 33, "147 K4 boxes[2].n {boxes[2].n} want 33 (tuple bind must copy)");
  boxes.remove(0);
  assert(len(boxes) == 2, "147 K4 len {len(boxes)} want 2");
  assert(boxes[1].n == 33, "147 K4 e1 {boxes[1].n} want 33");
  assert(chosen.n == 99, "147 K4 chosen {chosen.n} want 99 (independent copy)");
}

// K5 — `#remove` of OTHER elements while a view is live: the view materialises and keeps the
// value it named, and every surviving element is intact.  Two live views, one container.
fn k5_remove_others_during_iteration() {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 },
           Box { n: 33, tag: 333 }, Box { n: 44, tag: 444 }];
  held = boxes[3];
  for b in boxes {
    if b.n < 30 { b#remove; }
  }
  assert(len(boxes) == 2, "147 K5 len {len(boxes)} want 2");
  held.n = 99;
  assert(boxes[0].n == 33 && boxes[0].tag == 333, "147 K5 e0 {boxes[0].n}/{boxes[0].tag} want 33/333");
  assert(boxes[1].n == 44 && boxes[1].tag == 444, "147 K5 e1 {boxes[1].n}/{boxes[1].tag} want 44/444");
  assert(held.n == 99 && held.tag == 444, "147 K5 held {held.n}/{held.tag} want 99/444");
}

// K6 — reshaping a NESTED container THROUGH a view does not invalidate the OUTER view: `w`
// still addresses `outs[1]` afterwards.  The nested `remove` must not be read as a reshape of
// the outer container.
fn k6_nested_reshape_keeps_outer_view() {
  outs = [Outer { id: 1 }, Outer { id: 2 }, Outer { id: 3 }];
  outs[0].data += [1];
  outs[1].data += [10];
  outs[1].data += [20];
  outs[1].data += [30];
  outs[2].data += [100];

  w = outs[1];
  assert(w.id == 2, "147 K6 w.id {w.id} want 2");
  assert(len(w.data) == 3, "147 K6 len(w.data) {len(w.data)} want 3");

  w.data.remove(0);

  assert(len(outs) == 3, "147 K6 len(outs) {len(outs)} want 3");
  assert(len(w.data) == 2, "147 K6 len(w.data) {len(w.data)} want 2");
  assert(w.data[0] == 20 && w.data[1] == 30, "147 K6 w.data {w.data[0]}/{w.data[1]} want 20/30");

  w.id = 99;
  assert(outs[1].id == 99, "147 K6 outs[1].id {outs[1].id} want 99 (outer view still addresses it)");
  assert(outs[0].id == 1, "147 K6 outs[0].id {outs[0].id} want 1");
  assert(outs[2].id == 3, "147 K6 outs[2].id {outs[2].id} want 3");
  assert(len(outs[1].data) == 2, "147 K6 len(outs[1].data) {len(outs[1].data)} want 2");
}

// K7 — a `par` read-only pass over the container invalidates nothing: the view held across it
// still writes through to its element.
fn k7_par_reads_do_not_invalidate() {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
  held = boxes[2];
  assert(held.n == 33, "147 K7 held.n {held.n} want 33");

  total = 0;
  for b in boxes par(d = dbl(b), 2) {
    total += d;
  }
  assert(total == 132, "147 K7 total {total} want 132");

  held.n = 99;
  assert(len(boxes) == 3, "147 K7 len {len(boxes)} want 3");
  assert(boxes[2].n == 99 && boxes[2].tag == 333, "147 K7 e2 {boxes[2].n}/{boxes[2].tag} want 99/333");
  assert(boxes[0].n == 11, "147 K7 e0 {boxes[0].n} want 11");
}

fn main() {
  k1_loop_capture_copies();
  k2_stored_view_copies();
  k3_match_capture_splits_by_payload();
  k4_tuple_element_copies();
  k5_remove_others_during_iteration();
  k6_nested_reshape_keeps_outer_view();
  k7_par_reads_do_not_invalidate();
  println("147-view-producer-invalidator-boundary: PASS");
}
