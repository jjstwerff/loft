// @PLN35 PC1 — match over a CURSOR (a struct with a `vector<T>` source field + an integer `pos`
// field) PREFIX-consumes: it matches a prefix of the source from `pos` and advances `pos` by the
// consumed count on a match (leaving it unchanged on a miss).  So sequential matches walk a token
// stream — the parser-combinator foundation.  A plain `vector<T>` still WHOLE-consumes.  The token
// type comes from the pattern variants, not a generic cursor type.  Cross-mode + leak-checked.

enum Tok { Fn { x: integer }, Id { x: integer }, LP { x: integer } }
struct Cur { src: vector<Tok>, pos: integer }
struct Node { val: integer }

fn main() {
  c = Cur { src: [Fn { x: 0 }, Id { x: 7 }, LP { x: 3 }], pos: 0 };

  // Sequential prefix-consume: each match advances `pos`; a field read is relative to `pos`.
  r1 = match c { [ Fn ] => c.pos, _ => -1 };
  assert(r1 == 1, "Fn -> pos 1: {r1}");
  r2 = match c { [ Id { x } ] => x * 10 + c.pos, _ => -1 };   // Id.x=7 at pos 1, advance to 2
  assert(r2 == 72, "Id x=7 -> 72: {r2}");
  r3 = match c { [ LP { x } ] => x * 10 + c.pos, _ => -1 };   // LP.x=3 at pos 2, advance to 3
  assert(r3 == 33, "LP x=3 -> 33: {r3}");

  // At end: no match, `pos` unchanged.
  r4 = match c { [ Fn ] => 1, _ => c.pos };
  assert(r4 == 3, "end -> pos unchanged 3: {r4}");

  // Multi-element prefix consumes exactly the pattern arity.
  d = Cur { src: [Fn { x: 0 }, Id { x: 0 }, LP { x: 0 }], pos: 0 };
  r5 = match d { [ Fn, Id ] => d.pos, _ => -1 };              // consume 2 -> pos 2
  assert(r5 == 2, "Fn Id -> pos 2: {r5}");

  // A plain vector still WHOLE-consumes (arity must equal the length).
  ts: vector<Tok> = [Fn { x: 0 }, Id { x: 0 }, LP { x: 0 }];
  w = match ts { [ Fn, Id ] => 1, _ => 0 };                    // len 3 != 2 -> no
  assert(w == 0, "vector whole-consume unaffected: {w}");

  // Regression — an arm that returns a freshly-built STRUCT must NOT free the cursor's
  // borrowed source (`cursor.src` lives inside the cursor record).  Freeing it frees the
  // whole cursor; a later allocation then reuses the slot and corrupts it.  Rebind the
  // struct result (allocates a record) and read the cursor afterwards — pos + src must
  // survive.  (Sub-rule invocation, PC2, is exactly this shape: a fn(cursor) -> Node.)
  e = Cur { src: [Fn { x: 0 }, Id { x: 7 }, LP { x: 3 }], pos: 1 };
  res = match e { [ Id { x } ] => Node { val: x }, _ => null };
  node = res;
  assert(node.val == 7, "struct-arm result: {node.val}");
  assert(e.pos == 2, "struct-arm advance -> 2: {e.pos}");
  assert(e.src.len() == 3, "cursor src intact after rebind: {e.src.len()}");

  print("35q-cursor-match: PASS");
}
