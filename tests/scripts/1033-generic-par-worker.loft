//
// A generic function is callable as a `par` worker (loft#1033).
//
// `par(r = idf(e), 1)` was refused with "'idf' is not a function" while the same `idf`
// resolved everywhere else in the file.  The par path resolved the NAME to a def and then
// demanded `DefType::Function`; a template is `DefType::Generic`.  Resolving a name and
// never INSTANTIATING is the whole defect — the refusal was the symptom of a missing step,
// not a rule being enforced.
//
// Two halves, because a generic call site has two:
//   * the worker is instantiated from the ELEMENT type (the first parsed argument is
//     skipped precisely because it names the element), plus any context arguments;
//   * the worker's RETURN type is answered by `predict_generic_return_type`, the
//     cross-pass contract an ordinary generic call already uses.  Without it pass 1 reads
//     the template's `T` and pass 2 the monomorph's `integer`, and the result variable's
//     table entry carries the pass-1 answer into pass 2 — "Variable '_discard_1' cannot
//     change type from T to integer".
//
// NOT covered here: a generic worker inside a generic FUNCTION.  That is refused on BOTH
// backends with its own message, because the par LOWERING — queue variant, element and
// return size, result accessor, re-wrap — is decided from types that are still the type
// VARIABLE inside a template, and substitution rewrites the types while leaving the route
// behind.  Tracked as loft#1040, with the measured divergence it prevents: interpreted it
// answered correctly, `--native` failed with "non-primitive cast: DbRef as i64".

pub fn idf1033<T>(x: T) -> T { x }
pub fn dbl1033<T: Addable>(x: T) -> T { x + x }
fn plain1033(x: integer) -> integer { x }

fn test_a_generic_worker_runs_over_each_element_type() {
  a = 0;
  for e in [1, 2, 3] par(r = idf1033(e), 1) { a += 1; _ = r; }
  assert(a == 3, "integer elements, got {a}");

  b = 0;
  for e in [1.5, 2.5] par(r = idf1033(e), 1) { b += 1; _ = r; }
  assert(b == 2, "float elements, got {b}");

  c = 0;
  for e in [true, false] par(r = idf1033(e), 1) { c += 1; _ = r; }
  assert(c == 2, "boolean elements, got {c}");
}

fn test_the_workers_result_is_the_monomorphs_type_not_the_templates() {
  // The load-bearing half: the result is USED, not discarded, so it must carry the
  // CONCRETE type.  A cell that only counts iterations passes while `r` is still `T`.
  s = 0;
  for e in [1, 2, 3] par(r = dbl1033(e), 1) { s += r; }
  assert(s == 12, "doubled integers summed, got {s}");

  f = 0.0;
  for e in [1.5, 2.5] par(r = dbl1033(e), 1) { f += r; }
  assert(f == 8.0, "doubled floats summed, got {f}");
}

fn test_one_generic_worker_serves_two_instantiations() {
  n = 0;
  for e in [1, 2] par(r = idf1033(e), 1) { n += 1; _ = r; }
  for e in [1.5, 2.5, 3.5] par(r = idf1033(e), 1) { n += 1; _ = r; }
  assert(n == 5, "two monomorphs of one worker, got {n}");
}

fn test_a_non_generic_worker_is_unchanged() {
  // The control: this always worked, and is here so a change that broke the ordinary
  // path while fixing the generic one cannot pass.
  n = 0;
  for e in [1, 2, 3] par(r = plain1033(e), 1) { n += 1; _ = r; }
  assert(n == 3, "non-generic worker, got {n}");
}
