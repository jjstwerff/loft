// Arithmetic on a forward-declared callee is typed from the operand that is really there,
// whatever the other operand is and whichever side it sits on.
//
// The two-pass parser exists so a function may be used above where it is written, so
// declaration order must not decide a type.  It used to: on pass 1 `f() - 1` read as
// `unknown - integer`, the operator search matched `OpSubInt` off the LITERAL, and the
// local was locked to integer.  Pass 2 resolved `f()` to float and the assignment was
// REFUSED — "Variable 'a' cannot change type from integer to float" — at a line that is
// correct, about a decision the reader never made.  Writing the type down did not help:
// `a: float = f() - 1` was refused too, with the message reversed.
//
// The deferral now fires when ANY operand is unresolved rather than only when ALL are.
// The all-unresolved restriction was there to keep a genuine operator mismatch
// reportable; loft#918's reject-site deferral took that job over, so the two coexist
// (`pln102_one_known_operand_keeps_the_mismatch_diagnostic` is the other half).
//
// This file is the BOTH-BACKENDS half: the `pln102_*` tests in tests/issues.rs run the
// interpreter, and a type decision made in the parser reaches native codegen too.

fn main() {
  // ── one unresolved operand, literal second ───────────────────────────────────────────
  a = later_float() - 1;
  assert(a == 3.5, "unresolved minus literal");

  // ── literal FIRST: operand order is not what decides this ────────────────────────────
  b = 1 - later_float();
  assert(b == -3.5, "literal minus unresolved");

  // ── a different operator: the deferral is in the shared operator search, not in `-` ──
  c = later_float() + 1;
  assert(c == 5.5, "unresolved plus literal");
  d = later_float() * 2;
  assert(d == 9.0, "unresolved times literal");

  // ── the type written down explicitly, the shape that read worst ──────────────────────
  e: float = later_float() - 1;
  assert(e == 3.5, "declared type is honoured");

  // ── both operands unresolved: the half that already worked, kept under guard ─────────
  f = later_float() - later_half();
  assert(f == 4.0, "both operands unresolved");

  // ── the backward direction must be unchanged ─────────────────────────────────────────
  g = earlier_float() - 1;
  assert(g == 1.25, "callee declared above");

  // ── integer arithmetic must NOT be widened by the deferral ───────────────────────────
  h = later_int() - 1;
  assert(h == 6, "an unresolved integer callee stays integer");
  assert(h / 2 == 3, "and divides as an integer, not as a float");

  // ── the operand reached through a chain, so the resolution is transitive ─────────────
  i = later_via_chain() + 0.5;
  assert(i == 5.0, "a forward callee that itself calls forward");
}

fn earlier_float() -> float { 2.25 }

fn later_float() -> float { 4.5 }
fn later_half() -> float { 0.5 }
fn later_int() -> integer { 7 }
fn later_via_chain() -> float { later_float() }
