//
// @PLN126 — `store_release(collection)` drops what has been written from memory
// and changes NOTHING about what the collection holds.
//
// The whole call is a residency hint, so its failure mode is not a crash: it is a
// record that reads back wrong, or a reference the caller was still holding that
// now names re-read bytes.  Both are silent, and both are what this asserts.
//
// So this checks, on both backends:
//   * a reference taken BEFORE a release still reads its own VALUE afterwards —
//     not merely that it can be read, because a re-faulted page hands back a
//     plausible number either way;
//   * every record survives a release after every single write: same count, same
//     digest, same answers to a hit and a miss;
//   * the file's LENGTH is untouched — this is not `store_reclaim`;
//   * an unbound collection answers 0 and is unharmed, and a second call with
//     nothing new written answers 0 as well.
//
// The MEMORY half is not here and cannot be: a program cannot see its own
// resident set.  `database::spans::a_frontier_release_moves_the_resident_set`
// owns that half (44.3 MB -> 2.2 MB on a 20 000-record build).
//
// Env in:
//   LOFT_PERSIST_TEST_PATH   where to bind

struct Row {
  const id: integer,
  const a: i32,
  const label: text,
  const xs: vector<integer>,
}

fn digest(h: hash<Row[id]>) -> integer {
  d = 0;
  for dg in h {
    d = (d * 31 + dg.id + (dg.a as integer) * 7 + len(dg.label) + len(dg.xs)) % 1000000007;
  }
  d
}

fn live(h: hash<Row[id]>) -> integer {
  n = 0;
  for lv in h { n += lv.id * 0 + 1 }
  n
}

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH") ?? "";
  if path == "" { println("no path"); return }

  rows: hash<Row[id]> = [];
  // Bind FIRST: the file IS the arena, which is the only mode where there is
  // anything to release. Binding last would build in anonymous heap and this
  // call would correctly answer 0.
  if !store_persist_bind(rows, path) { println("FAIL bind"); return }

  // An unbound sibling: the same call on a heap collection must be a harmless
  // no-op, because a hint that raised on the wrong collection would be a hint
  // nobody could call from a library.
  heap: hash<Row[id]> = [];
  heap += [Row { id: 1, a: 1 as i32, label: "heap", xs: [1, 2, 3] }];
  println("unbound {store_release(heap)} live {live(heap)}");

  // Build in key order, releasing after every record — the frequency the
  // measurement showed is affordable, and the one most likely to expose a
  // record that does not survive its own release.
  total = 0;
  for i in 0..400 {
    rows += [Row { id: i, a: (i % 251) as i32? ?? (0 as i32), label: "row {i}", xs: [] }];
    r = rows[i];
    for j in 0..12 { r.xs += [i * 100 + j]; }
    total += store_release(rows);
  }
  println("released_positive {total > 0}");

  // A reference held ACROSS a release, checked by VALUE. `held` was taken while
  // record 7's pages were resident; every release since has dropped them, so
  // this read comes off the file.
  held = rows[7];
  store_release(rows);
  println("held id {held.id} label {held.label} last {held.xs[11]} len {len(held.xs)}");

  // Nothing written since the previous call, so there is nothing to drop.
  println("idempotent {store_release(rows)}");

  // The file is not shortened, and the content is whole.
  size_before = file(path).size;
  store_release(rows);
  println("size_stable {file(path).size == size_before}");
  println("live {live(rows)} digest {digest(rows)}");
  println("hit {rows[399].label} miss {rows[4000] == null}");
}
