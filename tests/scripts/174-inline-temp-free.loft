//
// Regression (@P393): an UNBOUND heap-returning call temporary used INLINE (as a
// call argument or method receiver) had no statement-end free → it leaked on the
// interpreter (native codegen already freed it).  Two siblings, both fixed by
// `inline_struct_return` lift arms (src/scopes.rs):
//   * t9    — a de-NRVO'd (empty-dep) vector return: a fn/method whose body builds
//             the result with >=2 element-temps (`z=[]; z+=[a]; z+=[b]; z`, or a
//             loop + trailing append as in stdlib `split`) is NOT NRVO-promoted, so
//             it returns by value with no caller buffer.  `Type::Vector` lift arm.
//   * bug10 — a capturing closure returned then passed as an unbound arg
//             (`apply(make())`) left its `__closure_*` record at rc 1.
//             `Type::Function` lift arm.
//   * #879  — an OPTIONAL aggregate return (`-> C?`, `-> vector<T>?`).  Every lift
//             arm matched the unpeeled return type, and `Optional(t)` is a
//             compile-time wrapper over t's own runtime layout, so `-> C?` read as
//             "not liftable" and its result got a bare stack-pop.  Filed as a `??`
//             bug, but the `??` is incidental: a discarded `pick(1);` leaks too.
//             The `??` half is its own arm — the `ncc` value-block's `__ncc_N`
//             subject temp is `skip_free`, so an INLINE `??` left the subject's
//             store owned by nothing.
// Negative controls (NRVO'd 1-append, borrowed `-> text[self]`, bound locals, a
// borrowed `-> C?` view, store-free optional scalars) must stay clean — the lift's
// `dep.is_empty()` guard must NOT over-free them.  The wrap leak gate verifies zero
// leaked stores on BOTH backends.

// --- t9: de-NRVO'd vector returns (leaked inline before the Vector lift arm) ---
fn two_append() -> vector<integer> {
  z = []; z += [1]; z += [2]; z
}
fn reassign() -> vector<integer> {
  z: vector<integer> = [9]; z = [1, 2]; z
}
fn loop_trailing(s: text) -> vector<text> {
  // the stdlib `split` shape
  r = [];
  p = 0;
  for c in s {
    if c == '-' {
      r += [s[p..c#index]]; p = c#next;
    }
  }
  if s.len() > 0 { r += [s[p..s.len()]]; }
  r
}

// --- t9 negative control: NRVO'd (1 append) must stay clean ---
fn one_append() -> vector<integer> {
  z = []; z += [7]; z
}

// --- bug 10: capturing closure returned + passed as an unbound arg ---
fn apply(f: fn() -> integer) -> integer {
  f()+f()
}
fn make() -> fn() -> integer {
  n = 0; fn() -> integer {
    n = n + 1; n
  }
}

// --- #879: optional aggregate returns, used inline / discarded ---
struct Cell { q: integer }
struct Holder { child: Cell }
fn pick(n: integer) -> Cell? { if n > 0 { Cell { q: 7 } } else { null } }
fn opt_vec(n: integer) -> vector<integer>? { if n > 0 { [1, 2, 3] } else { null } }
fn q_of(c: Cell) -> integer { c.q }
fn q_of_opt(c: Cell?) -> integer { (c ?? Cell { q: -1 }).q }

// --- #879 negative controls ---
// A BORROWED view typed optional: the lift must not claim it, or reading the
// source below is a use-after-free.
fn kid(h: Holder) -> Cell? { h.child }
// Optional returns that allocate no store at all — nothing to free.
fn opt_int(n: integer) -> integer? { if n > 0 { 5 } else { null } }
fn opt_text(n: integer) -> text? { if n > 0 { "hi" } else { null } }

fn main() {
  // t9 — inline-unbound de-NRVO'd vector returns (these leaked before the fix)
  assert(len(two_append()) == 2, "two_append len");
  assert(len(reassign()) == 2, "reassign len");
  assert(len(loop_trailing("a-b-c")) == 3, "loop_trailing len");
  assert("x-y-z".split('-').join("-") == "x-y-z", "stdlib split/join roundtrip");
  assert(len("p-q-r".split('-')) == 3, "stdlib split len");

  // t9 negative controls — already clean; the dep guard must not over-free them
  assert(len(one_append()) == 1, "one_append (NRVO'd) len");
  assert(len("  hi".trim_start()) == 2, "borrowed trim_start len");

  // bug 10 — capturing closure as an unbound arg (leaked before the Function arm)
  assert(apply(make()) == 3, "closure passed as arg");

  // #879 — an optional aggregate return with no `??` in sight.  A discarded call
  // and one handed straight to a parameter both leaked one record per call.
  pick(1);
  opt_vec(1);
  assert(q_of_opt(pick(1)) == 7, "optional record as argument");
  assert(len(opt_vec(1) ?? []) == 3, "optional vector length");

  // #879 — the filed shape: a record-typed `??` written INLINE.  Both arms, since
  // the default arm yields the work-ref the caller already frees and would be the
  // one to double-free if the lift claimed ownership wrongly.
  assert(q_of(pick(1) ?? Cell { q: -9 }) == 7, "inline ?? present arm");
  assert(q_of(pick(0) ?? Cell { q: -9 }) == -9, "inline ?? default arm");
  assert((pick(1) ?? Cell { q: -9 }).q == 7, "inline ?? field access");
  assert(q_of(pick(0) ?? pick(1) ?? Cell { q: -9 }) == 7, "chained ??");

  // #879 — it scales: the leak was one store per evaluation, unbounded in a loop.
  total = 0;
  for i in 0..200 { total += q_of(pick(i + 1) ?? Cell { q: -9 }); }
  assert(total == 1400, "inline ?? in a loop, total={total}");

  // #879 negative controls — the lift must not over-free a borrowed optional view
  // (this read would dangle) nor invent a free for a store-free optional.
  h = Holder { child: Cell { q: 5 } };
  kid(h);
  assert(h.child.q == 5, "borrowed optional view survives the discard");
  opt_int(1);
  opt_text(1);
  assert((opt_int(1) ?? 0) == 5, "optional integer");
  assert((opt_text(1) ?? "x") == "hi", "optional text");

  println("inline-temp-free ok");
}
