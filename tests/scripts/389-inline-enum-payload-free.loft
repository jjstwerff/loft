// @PLN25 — reassigning an inline struct-enum element frees the OLD variant's
// heap payload (`remove_claims` gained the symmetric `Parts::Enum` arm).  This
// script guards CORRECTNESS across all three backends (interp / native / wasm):
// the free zeroes the prior payload's field pointers in place, so the value
// written immediately after must still read back correctly — a regression
// where the free clobbered a still-needed field would surface as a wrong tag
// here.  (The leak itself — record-count stability — is pinned by
// `tests/leak.rs::pln25_inline_struct_enum_payload_free`, since an intra-store
// leak is invisible to the script suite's store-level gate.)
//
// Both variants carry a payload on purpose: a BARE no-field variant value
// (`Gone` with no fields) leaks a whole store on construction — a SEPARATE,
// pre-existing bug unrelated to this fix — which would trip the suite's
// store-leak gate and mask what this script actually checks.

enum Maybe { Has { s: text }, Gone { n: integer } }

fn read(v: vector<Maybe>) -> text {
  match v[0] {
    Has { s } => s,
    Gone { n } => "gone-{n}"
  }
}

fn test() {
  v: vector<Maybe> = [Gone { n: 0 }];
  // Churn Has -> Gone -> Has, overwriting a present text payload each lap;
  // the Has->Gone step must free the prior text.
  for i in 0..40 {
    v[0] = Has { s: "lap-payload-{i}" };
    v[0] = Gone { n: i };
    v[0] = Has { s: "lap-payload-{i}" };
  }
  assert(read(v) == "lap-payload-39", "after churn: {read(v)}");

  // Overwrite a present text payload directly with another present text payload.
  v[0] = Has { s: "second" };
  assert(read(v) == "second", "direct overwrite: {read(v)}");

  // Overwrite a present text payload with a scalar variant (frees the text).
  v[0] = Gone { n: 7 };
  assert(read(v) == "gone-7", "final: {read(v)}");

  print("ok\n");
}
