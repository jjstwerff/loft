// #635 — the curated platform-directory functions `temp_dir()` / `cache_dir()`.
// Both return a real path on native and the interpreter (never null there); the
// browser's null case (no filesystem) cannot run in this suite. `cache_dir()`
// is loft's own cache root, which lives under a `loft` directory. Run by
// `tests/wrap.rs::loft_suite` on both backends.

fn test_temp_dir_is_a_real_path() {
  t = temp_dir();
  assert(t != null, "temp_dir is non-null on native/interpret");
  assert(len(t ?? "") > 0, "temp_dir is a non-empty path");
}

fn test_cache_dir_is_under_a_loft_root() {
  c = cache_dir();
  assert(c != null, "cache_dir is non-null on native/interpret");
  assert((c ?? "").ends_with("loft"), "cache_dir is the loft cache root");
}
