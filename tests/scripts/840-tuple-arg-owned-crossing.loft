//
// A tuple carrying `text` arrives as a PARAMETER and then crosses into an owned slot.
//
// The native backend passes a tuple's `text` elements borrowed (`&str`) and stores them
// owned (`String`); every other element type spells the same Rust either way, so the split
// stays invisible until a tuple containing text crosses from a parameter into a local, a
// match temp, a struct field, or a return buffer.  Nothing reconciled the two spellings, so
// the crossing was rustc E0308 and the program did not build at all on `--native` while the
// interpreter — which has no owned/borrowed split — ran it (loft#840).
//
// Each function below is one crossing.  `match` is only the shape the bug was reported
// through: `local = t` and `return t` fail identically, which is why they are pinned here
// too.  The scalar and local-subject cases are the controls — they built before the fix and
// must keep building, since a fix that made every tuple owned would satisfy the rest alone.

// --- the crossings that used to fail ---

fn matched(t: (integer, text, boolean)) -> text {
  match t { (n, _, _) => "n{n}" }
}

fn matched_on_literals(t: (integer, text, boolean)) -> text {
  match t { (1, "one", true) => "lit", _ => "other" }
}

fn all_text_matched(t: (text, text)) -> text {
  match t { (a, _) => "a{a}" }
}

fn copied_to_local(t: (integer, text, boolean)) -> text {
  local: (integer, text, boolean) = t;
  local.1
}

fn returned(t: (integer, text, boolean)) -> (integer, text, boolean) {
  t
}

fn nested(t: ((integer, text), boolean)) -> text {
  local: ((integer, text), boolean) = t;
  local.0.1
}

struct Holder { pair: (integer, text, boolean) }

fn into_field(t: (integer, text, boolean)) -> text {
  h = Holder { pair: t };
  h.pair.1
}

// --- controls: these built before the fix and must keep working ---

fn read_only(t: (integer, text, boolean)) -> text { t.1 }

fn passed_along(t: (integer, text, boolean)) -> text { read_only(t) }

fn scalars_matched(t: (integer, integer, boolean)) -> text {
  match t { (n, _, _) => "n{n}" }
}

fn local_subject_matched() -> text {
  t: (integer, text, boolean) = (1, "one", true);
  match t { (n, _, _) => "n{n}" }
}

fn main() {
  assert(matched((1, "one", true)) == "n1", "match on a tuple parameter carrying text");
  assert(matched_on_literals((1, "one", true)) == "lit", "literal arm over a tuple parameter");
  assert(all_text_matched(("x", "y")) == "ax", "every element is text");
  assert(copied_to_local((1, "one", true)) == "one", "tuple parameter copied to a local");
  assert(returned((1, "one", true)).1 == "one", "tuple parameter returned");
  assert(nested(((1, "one"), true)) == "one", "text reached through a nested tuple");
  assert(into_field((1, "one", true)) == "one", "tuple parameter stored in a struct field");

  assert(read_only((1, "one", true)) == "one", "control: element read in place");
  assert(passed_along((1, "one", true)) == "one", "control: parameter passed on borrowed");
  assert(scalars_matched((1, 2, true)) == "n1", "control: no text element");
  assert(local_subject_matched() == "n1", "control: subject is a local");

  println("840 ok");
}
