//
// @PLN130 F1 (loft#778) — reassigning a view from a loop variable must not destroy the
// container.
//
// `k = a[0]` binds a VIEW.  `scopes.rs` strips its container dep when it sees `k` reassigned
// later, because from that point `k` is treated as an owner and needs a scope-exit free.
// The interpreter then bound the raw interior pointer anyway, so `k`'s "own" store WAS the
// container's, and the reassignment's pre-Set `OpFreeRef` released the whole vector:
// `len(a)` went to 0 before any removal and `a[0]` read `null(oob)`.  Native escaped it by
// materialising `_own_store_k` off the same empty deps.
//
// The fix makes the interpreter act on the fact both backends already read — an element read
// bound to an OWNER materialises into its own store.  A binding that keeps its deps is
// untouched and still aliases (that is the documented `c = v[i]` behaviour, loft#774).

struct Box { n: integer, tag: integer = 0 }

fn main() {
  a = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
  k = a[0];
  for x in a {
    if x.n == 33 {
      k = x;
    }
  }
  assert(len(a) == 3, "144 len {len(a)} want 3 — the container was destroyed");
  assert(a[0].n == 11 && a[0].tag == 111, "144 a[0] {a[0].n}/{a[0].tag} want 11/111");
  assert(a[1].n == 22, "144 a[1].n {a[1].n} want 22");
  assert(a[2].n == 33 && a[2].tag == 333, "144 a[2] {a[2].n}/{a[2].tag} want 33/333");
  assert(k.n == 33 && k.tag == 333, "144 k {k.n}/{k.tag} want 33/333");

  // A view that is NOT reassigned keeps its dep and still aliases — the documented rule.
  c = a[2];
  c.n = 99;
  assert(a[2].n == 99, "144 alias a[2].n {a[2].n} want 99 (unreassigned view still aliases)");
  println("144 PASSED");
}
