//
// `map` answers `vector<U>` for a callback `fn(T) -> U`, with `U` free (loft#945).
//
// STDLIB.md has documented `map(v: vector<T>, f: fn(T) -> U) -> vector<U>` all along, and the
// lowering already built the result from the callback's return type. Three things stopped it:
//
//   * the ARGUMENT HINT pinned the callback's return to the element type, so the lambda's
//     body was type-checked against `T` — `map(xs, |x| { "n{x}" })` was refused *inside the
//     user's own lambda* ("expected integer, got text");
//   * PASS 1 answered `vector<T>` while pass 2 answered `vector<U>`, so a named callback got
//     as far as the binding and was refused there ("cannot change type from … to …");
//   * the hand-built per-element CALL never supplied the hidden buffer a heap-returning
//     callee takes, which crashed the compiler outright ("Too few parameters on n_shout").
//
// The third one bit `U == T` as well: `xs.map(|s| { "{s}!" })` on a `vector<text>` was an
// internal compiler error on the released 2026.8.0, and so was the method spelling of
// anything, because `.map(…)` was only recognised on pass 2 — the two passes disagreed about
// the callback's own signature.
//
// So the cells below sweep FOUR axes together, not one: the spelling (free vs method), the
// callback (inline lambda vs named function), `U`'s storage class (scalar, text, collection,
// record, enum), and whether `U == T`. Each answers a distinctive value, so an arm that
// collapsed to one implementation is visible rather than merely compiling.

struct P945 { name: text, age: integer }
enum C945 { C945Red, C945Green }

fn label945(x: integer) -> text { "n{x}" }
fn shout945(s: text) -> text { "{s}!" }
fn mkp945(x: integer) -> P945 { P945 { name: "p{x}", age: x } }

fn main() {
  xs = [1, 2];
  ts = ["a", "bb"];

  // c1 — the filed shape: an inline lambda whose `U` is text where `T` is integer.
  c1 = map(xs, |x| { "n{x}" });
  assert(len(c1) == 2, "c1 len = {len(c1)}, want 2");
  assert((c1[0] ?? "?") == "n1" && (c1[1] ?? "?") == "n2", "c1 = {c1[0] ?? "?"}/{c1[1] ?? "?"}");

  // c2 — the same through a NAMED callback, which used to be refused at the binding instead
  //      of inside the lambda. Same defect, different report.
  c2 = map(xs, label945);
  assert((c2[1] ?? "?") == "n2", "c2 = {c2[1] ?? "?"}, want n2");

  // c3 — a DECLARED destination does not help unless both passes agree, so pin it too.
  c3: vector<text> = map(xs, label945);
  assert((c3[0] ?? "?") == "n1", "c3 = {c3[0] ?? "?"}, want n1");

  // c4 — the METHOD spelling must answer exactly what the free one does. It was recognised
  //      on pass 2 only, so its callback was parsed without an element-type hint on pass 1.
  c4 = xs.map(|x| { "n{x}" });
  assert((c4[1] ?? "?") == "n2", "c4 = {c4[1] ?? "?"}, want n2");

  // c5 — the other direction, text -> integer, in both spellings. `len` of a heap element,
  //      so the callback reads its argument rather than just re-wrapping it.
  c5 = map(ts, |s| { len(s) });
  c5m = ts.map(|s| { len(s) });
  assert((c5[1] ?? -1) == 2 && (c5m[1] ?? -1) == 2, "c5 = {c5[1] ?? -1}/{c5m[1] ?? -1}, want 2/2");

  // c6 — `U == T` over TEXT. Not an element-type change at all, and an internal compiler
  //      error on the released binary: the callback's hidden text buffer was minted on pass 2
  //      alone. Both the lambda and the named form.
  c6 = ts.map(|s| { "{s}!" });
  assert((c6[0] ?? "?") == "a!" && (c6[1] ?? "?") == "bb!", "c6 = {c6[0] ?? "?"}/{c6[1] ?? "?"}");
  c6n = map(ts, shout945);
  assert((c6n[1] ?? "?") == "bb!", "c6n = {c6n[1] ?? "?"}, want bb!");

  // c7 — `U` is a COLLECTION. The callback answers a store of its own, so it needs the
  //      return buffer reserved for it, which for a lambda can only happen once its return
  //      type is read off its body.
  c7 = xs.map(|x| { [x, x + 1] });
  assert(len(c7) == 2, "c7 len = {len(c7)}, want 2");
  assert(len(c7[0] ?? []) == 2, "c7 inner = {len(c7[0] ?? [])}, want 2");
  assert(((c7[1] ?? [])[1] ?? -1) == 3, "c7 value = {(c7[1] ?? [])[1] ?? -1}, want 3");

  // c8 — `U` is a RECORD, from a lambda and from a named function. A struct LITERAL tail
  //      carries the built-in-place marker, which is a fact about the expression and not a
  //      type a signature can name.
  c8 = xs.map(|x| { P945 { name: "p{x}", age: x * 10 } });
  assert(len(c8) == 2, "c8 len = {len(c8)}, want 2");
  c8n = map(xs, mkp945);
  assert(len(c8n) == 2, "c8n len = {len(c8n)}, want 2");

  // c9 — `U` is an ENUM.
  c9 = xs.map(|x| { if x == 1 { C945.C945Red } else { C945.C945Green } });
  assert(len(c9) == 2, "c9 len = {len(c9)}, want 2");

  // c10 (control) — `U == T`, scalar: the one shape that always worked. Both spellings, so a
  //       fix that reached only one of them is visible here.
  c10 = map(xs, |x| { x + 100 });
  c10m = xs.map(|x| { x + 100 });
  assert((c10[0] ?? -1) == 101 && (c10m[0] ?? -1) == 101,
         "c10 = {c10[0] ?? -1}/{c10m[0] ?? -1}, want 101/101");

  // c11 (control) — `filter` and `reduce` keep their OWN return contracts: a predicate really
  //        is `-> boolean` and a fold really answers its accumulator's type. Neither may be
  //        loosened by the `map` change.
  c11 = xs.filter(|x| { x > 1 });
  assert(len(c11) == 1 && (c11[0] ?? -1) == 2, "c11 = {len(c11)}/{c11[0] ?? -1}, want 1/2");
  c11r = [1, 2, 3].reduce(0, |a, x| { a + x });
  assert(c11r == 6, "c11r = {c11r}, want 6");

  // c12 (control) — a CAPTURING lambda still captures, and chaining still works. Both would
  //        break if the callback's signature were rebuilt from the element type.
  k12 = 5;
  c12 = xs.map(|x| { x + k12 });
  assert((c12[1] ?? -1) == 7, "c12 = {c12[1] ?? -1}, want 7");
  c12c = [1, 2, 3].filter(|x| { x > 1 }).map(|x| { "v{x}" });
  assert(len(c12c) == 2 && (c12c[0] ?? "?") == "v2",
         "c12c = {len(c12c)}/{c12c[0] ?? "?"}, want 2/v2");

  // c13 (control) — the comprehension the workaround uses answers the same thing. It went
  //        through the ordinary call machinery all along, which is why it was already right,
  //        and it is the oracle the `map` lowering is measured against.
  c13: vector<text> = [for s in ts { shout945(s) }];
  assert((c13[1] ?? "?") == "bb!", "c13 = {c13[1] ?? "?"}, want bb!");

  println("945 ok");
}
