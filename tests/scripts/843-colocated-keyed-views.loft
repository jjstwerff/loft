//
// loft#843 — a keyed collection's records became unaddressable to the sibling
// that views them.
//
// A `sorted<T[k]>` beside a `hash<T[k2]>`
// becomes an `ordered` array whose slots hold a 4-byte record id, read back at a
// hard-coded `pos = 8` (`vector::ordered_find`) — an address that only names an
// element OWNING its record. @PLN135 arc H moved hash entries into a packed
// arena, several to a record at a stride, so the position stopped being
// recoverable from the id and every entry in one chunk read back as that chunk's
// FIRST. The length stayed right, which is what made it dangerous: a caller that
// checks `len` before iterating sees a healthy collection.
//
// The sibling link is one-directional by design — the first-declared field owns
// the records, later ones are views that maintain nothing — so inserting through
// a VIEW reaches only that view. That is a separate question from this fix and is
// left as it was: `85-store-lifetime-claims-keystone.loft` builds an `index` and
// a `sorted` over one element type with DIFFERENT contents and asserts they stay
// different, so making the link mutual is a semantic change rather than a repair.
//
// The cells below are the boundary, not a demonstration: `index + sorted` was
// always CORRECT (a tree allocates one record per element), and keeping it here
// is what shows the fix did not simply disable the arena everywhere.

struct T1 { const name: text, weight: integer }
struct T2 { const name: text, weight: integer }
struct T3 { const name: text, weight: integer }
struct T4 { const nm: text, w: integer }
struct T5 { const k: integer, w: integer }
struct T6 { const name: text, weight: integer }

// hash declared FIRST, sorted second
struct D1 { const id: integer, seen: hash<T1[name]> = [], rank: sorted<T1[weight]> = [] }
// sorted declared FIRST — the order that used to decide everything
struct D2 { const id: integer, rank: sorted<T2[weight]> = [], seen: hash<T2[name]> = [] }
// enough elements to span more than one arena chunk
struct D3 { const id: integer, seen: hash<T3[name]> = [], rank: sorted<T3[weight]> = [] }
// a DESCENDING sorted, and a non-text key
struct D4 { const id: integer, seen: hash<T4[nm]> = [], rank: sorted<T4[-w]> = [] }
struct D5 { const id: integer, seen: hash<T5[k]> = [], rank: sorted<T5[w]> = [] }
// the cell that was always right: a tree index owns one record per element
struct D6 { const id: integer, byname: index<T6[name]> = [], rank: sorted<T6[weight]> = [] }

fn main() {
  // --- 1: the records are addressable, in key order --------------------------
  a = D1 { id: 1 };
  a.seen += [T1 { name: "a", weight: 5 }];
  a.seen += [T1 { name: "b", weight: 3 }];
  r1 = ""; for x in a.rank { r1 += "{x.name}{x.weight} " }
  assert(len(a.rank) == 2, "D1 rank len {len(a.rank)}");
  assert(r1 == "b3 a5 ", "D1 rank [{r1}]");

  // --- 2: the OWNER is the first-declared field, whichever kind it is --------
  // Here the `sorted` is declared first, so it owns and the hash is the view.
  // Inserting through the owner must reach the view — this is the cell that
  // proves the addressing fix is not specific to a hash being the owner.
  b = D2 { id: 2 };
  b.rank += [T2 { name: "a", weight: 5 }];
  b.rank += [T2 { name: "b", weight: 3 }];
  r2 = ""; for y in b.rank { r2 += "{y.name}{y.weight} " }
  assert(len(b.rank) == 2, "D2 rank len {len(b.rank)}");
  assert(r2 == "b3 a5 ", "D2 rank [{r2}]");
  assert(len(b.seen) == 2, "D2 seen len {len(b.seen)}");

  // --- 3: past one chunk, every element is its own ---------------------------
  // 40 elements is the cell that made the fault unmistakable: they all read back
  // as the first, so a duplication bug cannot hide behind a small count.
  d = D3 { id: 4 };
  for i in 0..40 { d.seen += [T3 { name: "n{i}", weight: i }] }
  seq = "";
  for z in d.rank { seq += "{z.weight}," }
  want = "";
  for j in 0..40 { want += "{j}," }
  assert(len(d.rank) == 40, "D3 rank len {len(d.rank)}");
  assert(seq == want, "D3 rank order [{seq}]");

  // --- 4: direction and key type are not what decides it ---------------------
  e = D4 { id: 5 };
  e.seen += [T4 { nm: "a", w: 5 }];
  e.seen += [T4 { nm: "b", w: 3 }];
  r4 = ""; for p in e.rank { r4 += "{p.nm}{p.w} " }
  assert(r4 == "a5 b3 ", "D4 descending [{r4}]");

  f = D5 { id: 6 };
  f.seen += [T5 { k: 10, w: 5 }];
  f.seen += [T5 { k: 20, w: 3 }];
  r5 = ""; for q in f.rank { r5 += "{q.k}:{q.w} " }
  assert(r5 == "20:3 10:5 ", "D5 integer key [{r5}]");

  // --- 5: the cell that was never broken stays correct -----------------------
  g = D6 { id: 7 };
  g.byname += [T6 { name: "a", weight: 5 }];
  g.byname += [T6 { name: "b", weight: 3 }];
  r6 = ""; for s in g.rank { r6 += "{s.name}{s.weight} " }
  assert(r6 == "b3 a5 ", "D6 index+sorted [{r6}]");
  assert(len(g.byname) == 2, "D6 byname len {len(g.byname)}");

  // A hash with NO co-located view keeps the arena — nothing here should have
  // turned that off, and a leak-clean exit is the other half of saying so.
  h = D1 { id: 8 };
  for k in 0..8 { h.seen += [T1 { name: "k{k}", weight: 100 - k }] }
  assert(len(h.seen) == 8, "plain hash len {len(h.seen)}");

  println("colocated keyed views ok");
}
