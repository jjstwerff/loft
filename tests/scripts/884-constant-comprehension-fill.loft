//
// A comprehension whose body does not vary with the loop variable IS a fill, and is
// lowered to the repeat literal's one-template-plus-`OpAppendCopy` instead of running
// the per-record allocation protocol once per element (loft#884, PERFORMANCE.md O8.5).
//
// The transform rewrites what a program BUILDS, so every row below checks the length
// AND the contents: a fill that miscounts, or that copies the wrong source, keeps the
// shape of a right answer. `[x; n]` had exactly those two defects (loft#886), and this
// lowering inherits its machinery, so the rows that read past index 0 are the point.
//
// The rows that must NOT fill are half the guard. `[for _ in 0..n { f() }]` has to call
// `f()` n times, and a body that reads the loop variable produces n different values —
// a transform that fires on either one is silently wrong, and the length would still
// be right. The gate is PURITY, not loop-invariance.
//
// The bounds are read from parser state that the last-parsed range writes, so an
// iterable that is NOT a range must not inherit them: a vector or text source has its
// own length, and borrowing `0..7` from an earlier loop would build the wrong one.

struct C884Pair { a: vector<integer>, b: vector<integer> }
struct C884One { a: vector<integer> }

fn c884_sum(v: vector<integer>) -> integer {
  t = 0;
  for e in v { t += e; }
  t
}

// Impure on purpose: each call advances the counter it is handed, so a wrongly-filled
// comprehension shows up in the VALUES (all 1s) and not only in a call count.
fn c884_bump(c: vector<integer>) -> integer {
  c[0] = (c[0] ?? 0) + 1;
  c[0] ?? 0
}

fn c884_fill(n: integer) -> vector<integer> { [for _ in 0..n { -1 }] }

fn main() {
  // The filed shape: a RUNTIME count. This is the row a const-folded guard would miss,
  // and the one a consumer actually writes.
  n = 5;
  runtime: vector<integer> = [for _ in 0..n { -1 }];
  assert(len(runtime) == 5, "len runtime = {len(runtime)}, want 5");
  assert(c884_sum(runtime) == -5, "sum runtime = {c884_sum(runtime)}, want -5");

  // Constant bounds take the same route, and must agree with it.
  literal: vector<integer> = [for _ in 0..3 { -1 }];
  assert(len(literal) == 3, "len literal = {len(literal)}, want 3");
  assert(c884_sum(literal) == -3, "sum literal = {c884_sum(literal)}, want -3");

  // Zero and negative counts: the count is `till - from`, and a fill of a negative
  // number of elements is empty, not a wrapped-around one. `[x; n]` reached
  // 4 294 967 295 copies on exactly this input before loft#886.
  z = 0;
  empty: vector<integer> = [for _ in 0..z { -1 }];
  assert(len(empty) == 0, "len empty = {len(empty)}, want 0");
  neg = -3;
  negative: vector<integer> = [for _ in 0..neg { -1 }];
  assert(len(negative) == 0, "len negative = {len(negative)}, want 0");

  // A non-zero lower bound: the count is a subtraction, not the upper bound alone.
  from_three: vector<integer> = [for _ in 3..9 { -1 }];
  assert(len(from_three) == 6, "len from_three = {len(from_three)}, want 6");
  assert(c884_sum(from_three) == -6, "sum from_three = {c884_sum(from_three)}, want -6");

  // An inclusive range includes its end.
  inclusive: vector<integer> = [for _ in 0..=4 { -1 }];
  assert(len(inclusive) == 5, "len inclusive = {len(inclusive)}, want 5");
  assert(c884_sum(inclusive) == -5, "sum inclusive = {c884_sum(inclusive)}, want -5");

  // Element types other than integer ride the same lowering — the template is written
  // once and copied, so a type whose write differs would corrupt every element after
  // the first, which is what `["abc"; 4]` did.
  singles: vector<single> = [for _ in 0..4 { 2.5f }];
  assert(len(singles) == 4, "len singles = {len(singles)}, want 4");
  assert((singles[0] ?? 0.0f) == 2.5f, "singles[0] = {singles[0] ?? 0.0f}, want 2.5");
  assert((singles[3] ?? 0.0f) == 2.5f, "singles[3] = {singles[3] ?? 0.0f}, want 2.5");

  floats: vector<float> = [for _ in 0..4 { 1.5 }];
  assert((floats[3] ?? 0.0) == 1.5, "floats[3] = {floats[3] ?? 0.0}, want 1.5");

  flags: vector<boolean> = [for _ in 0..4 { true }];
  assert(len(flags) == 4, "len flags = {len(flags)}, want 4");
  assert((flags[3] ?? false), "flags[3] is false, want true");

  // --- the rows that must NOT become a fill ---

  // Reads the loop variable: n DIFFERENT values.
  counted: vector<integer> = [for x in 0..5 { x }];
  assert(len(counted) == 5, "len counted = {len(counted)}, want 5");
  assert(c884_sum(counted) == 10, "sum counted = {c884_sum(counted)}, want 10 (0+1+2+3+4)");
  assert((counted[4] ?? 99) == 4, "counted[4] = {counted[4] ?? 99}, want 4");

  // Impure body: the call has to happen once per element. Filling would give all 1s,
  // whose LENGTH is still right — so the value check is the one that can see it.
  ctr: vector<integer> = [0];
  bumped: vector<integer> = [for _ in 0..5 { c884_bump(ctr) }];
  assert(len(bumped) == 5, "len bumped = {len(bumped)}, want 5");
  assert((bumped[0] ?? 99) == 1, "bumped[0] = {bumped[0] ?? 99}, want 1");
  assert((bumped[4] ?? 99) == 5, "bumped[4] = {bumped[4] ?? 99}, want 5 — the call ran once per element");
  assert(c884_sum(bumped) == 15, "sum bumped = {c884_sum(bumped)}, want 15");

  // A filter decides per element how many there are, so it is not a fill.
  filtered: vector<integer> = [for x in 0..5 if x < 2 { -1 }];
  assert(len(filtered) == 2, "len filtered = {len(filtered)}, want 2");

  // --- a non-range iterable must not inherit the last range's bounds ---
  // The `0..9` above is what a stale read would find; both of these are length 2.
  src: vector<integer> = [3, 4];
  from_vector: vector<integer> = [for _ in src { -1 }];
  assert(len(from_vector) == 2, "len from_vector = {len(from_vector)}, want 2 (not the last range's)");

  from_text: vector<integer> = [for _ in "ab" { -1 }];
  assert(len(from_text) == 2, "len from_text = {len(from_text)}, want 2 (not the last range's)");

  // A range inside the BODY is parsed after the bounds and must not replace them:
  // this builds 3 elements, each of them the length of a 9-element vector.
  nested: vector<integer> = [for _ in 0..3 { len([for j in 0..9 { j }]) }];
  assert(len(nested) == 3, "len nested = {len(nested)}, want 3 (not the inner range's 9)");
  assert(c884_sum(nested) == 27, "sum nested = {c884_sum(nested)}, want 27 (3 x 9)");

  // --- positions the fill must decline ---
  // A struct-literal FIELD. The copy is handed the vector it copies within, but a
  // field is reached THROUGH the enclosing record, and the append then lands in
  // whichever vector that resolves to — the second field gets nothing. Filling here
  // built `a` with six elements and `b` with none, while every length above stayed
  // right, so only a multi-field struct can see it.
  pair = C884Pair { a: [for _ in 0..3 { 0 }], b: [for _ in 0..3 { 0 }] };
  assert(len(pair.a) == 3, "len pair.a = {len(pair.a)}, want 3");
  assert(len(pair.b) == 3, "len pair.b = {len(pair.b)}, want 3");

  // The same shape one field at a time cannot see it: with a single field the
  // record resolves to the only vector there is, and the wrong answer is right.
  single_field = C884One { a: [for _ in 0..3 { 0 }] };
  assert(len(single_field.a) == 3, "len single_field.a = {len(single_field.a)}, want 3");

  // Through a function boundary, where the count is a parameter.
  assert(len(c884_fill(7)) == 7, "len c884_fill(7) = {len(c884_fill(7))}, want 7");
  assert(len(c884_fill(0)) == 0, "len c884_fill(0) = {len(c884_fill(0))}, want 0");

  println("884 constant-comprehension fill: ok");
}
