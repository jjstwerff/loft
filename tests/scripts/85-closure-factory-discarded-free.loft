// @PLN85 t1 — an immediately-invoked closure factory `make_greeter("Hi")("bob")`
// discards the returned fn-ref temp WITHOUT freeing the freshly-minted closure
// record it carries (the DA-inventory t1 leak, both backends).  The chained-call
// temp was unconditionally marked `skip_free` on the assumption it BORROWS the
// source's closure — true for a pass-through (`passthru(g)`) or a non-capturing
// lambda, but wrong for a fresh factory whose closure the temp SOLELY owns.  Fix
// (parser/operators.rs): stamp `skip_free` only in pass 2 (the closure-ownership
// dep isn't propagated in pass 1 — a pass-1 stamp poisons the persistent bit) and
// only for a BORROWED source; an owned closure is freed at scope exit.  Values
// assert on both backends; the wrap leak-gate proves the closure is freed once.

fn make_greeter(prefix: text) -> fn(text) -> text {
    fn(name: text) -> text { "{prefix} {name}" }
}
fn make_adder(base: integer) -> fn(integer) -> integer {
    fn(n: integer) -> integer { base + n }
}
// non-capturing lambda factory — no closure store to free.
fn make_inc() -> fn(integer) -> integer {
    fn(x: integer) -> integer { x + 1 }
}
// borrowed pass-through — the returned fn-ref aliases the caller's closure.
fn passthru(f: fn(text) -> text) -> fn(text) -> text { f }

fn main() {
    // (1) the t1 cell: discarded immediately-invoked capturing closure.
    r = make_greeter("Hello")("world");
    assert(r == "Hello world", "call {r}");

    // (2) integer closure, also discarded.
    s = make_adder(10)(5);
    assert(s == 15, "adder {s}");

    // (3) non-capturing factory — nothing to free, must stay clean.
    t = make_inc()(41);
    assert(t == 42, "inc {t}");

    // (4) borrowed pass-through — the closure must NOT be double-freed.
    g = make_greeter("Hi");
    b = passthru(g)("bob");
    assert(b == "Hi bob", "passthru {b}");

    // (5) bound factory result still frees its closure at scope exit.
    h = make_greeter("Yo");
    c = h("sue");
    assert(c == "Yo sue", "bound {c}");

    // (6) repeated discarded closures in a loop — no per-iteration leak.
    total = 0;
    for i in 0..30 { total += make_adder(i)(1); }
    assert(total == 465, "loop {total}");

    println("closure-factory-discarded-free ok");
}
