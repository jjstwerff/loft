//
// @PLN123 — a persisted image keeps its eighth of slack even when the caller
// tidied up first.
//
// `bind_path` sizes an image at the high-water mark PLUS an eighth, and that
// eighth is deliberate: a bound store stays live, growth multiplies by 7/3, so a
// store with no room left pays a 2.33x FILE resize on its very next claim
// (loft#710).  The clamp that kept the image "never larger than the arena"
// collapsed the eighth to zero for any store `store_reclaim` had just trimmed to
// its mark — so arc A silently disabled the protection loft#710 added.
//
// The claim that trips it is the most ordinary one there is: READING the
// collection.  Iterating a keyed collection materialises a key-sorted snapshot,
// and for a bound collection that snapshot is claimed inside the store.
//
// Env in:
//   LOFT_PERSIST_TEST_PATH   the store file
//   N                        records (default 2000)
//   RECLAIM                  "0" to skip `store_reclaim` before the bind

struct Rec { const id: integer, const label: text, const xs: vector<i32> }

fn i32_of(v: integer) -> i32 { v as i32? ?? (0 as i32) }

fn make(i: integer) -> Rec {
  s = "label-{i}";
  for lb in 0..(i % 7) { s += "-{lb}" }
  v: vector<i32> = [];
  for j in 0..(i % 5 + 1) { v += [i32_of(i * 31 + j)] }
  Rec { id: i, label: s, xs: v }
}

fn count(h: hash<Rec[id]>) -> integer { n = 0; for c in h { n += c.id * 0 + 1 } n }

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH") ?? "";
  if path == "" { println("no path"); return }
  n = (env_variable("N") ?? "") as integer ?? 2000;
  reclaim = (env_variable("RECLAIM") ?? "") != "0";

  h: hash<Rec[id]> = [];
  for g in 0..n { h += [make(g)] }
  if reclaim { store_reclaim(h); }
  if !store_persist_bind(h, path) { println("FAIL bind"); return }

  // Stat BEFORE anything walks the collection — the traversal below is the
  // whole point, so measuring after it would measure the traversal.
  after_bind = file(path).size;
  c = count(h);
  after_read = file(path).size;
  println("reclaim {reclaim} after_bind {after_bind} after_read {after_read} count {c}");
}
