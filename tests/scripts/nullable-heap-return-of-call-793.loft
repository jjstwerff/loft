//
// Regression (loft#793): a function declared `-> T?` over a HEAP type answered null
// when the returned value came from a CALL, and a bare `return null` from one handed
// back eval-stack garbage.
//
// Only a DENSE heap return (`-> S`, `-> vector<S>`, `-> StructEnum`) is given a hidden
// `__retbuf` argument to deliver through. A NULLABLE one is not, so its value can only
// travel back as the call's own return value — and that value was dropped: the call was
// emitted as a discarded statement followed by a fabricated `return null`. The
// interpreter read the result off eval-stack top and answered correctly, which hid the
// whole class there; `--native`, and any `StaticCall` into a library's compiled half,
// returned the null sentinel. That is why it was reported as a LIBRARY bug (a
// `dialect_named(nm) -> Dialect?` answering null for every dialect it had) while the
// same code in one file looked fine — one file plus `--interpret` is exactly the cell
// that masks it.
//
// The mirror-image half is the NULL path. `return null` from a `-> vector<T>?` or
// `-> StructEnum?` fn pushed nothing (or a 4-byte enum discriminator) where the caller
// read a 12-byte DbRef, so the caller saw a stale ref as NON-null and freed it a second
// time — "refused free of out-of-range store", sometimes a SIGSEGV.
//
// Both halves must hold on BOTH backends, and the controls are what keep the fix
// honest: c8/c10 were already correct and must stay so. `-> text?` (c8) has its own
// delivery contract and must not be routed through the ref hoist, and the local-binding
// spelling (c10) is the shape whose emitted IR the fix reproduces — if it ever needs
// changing too, the fix moved rather than landed.

struct D { const nm: text }
enum SE { A { const nm: text }, B { const k: integer } }

fn mk() -> D { return D { nm: "pg" }; }
fn mkv() -> vector<D> { return [D { nm: "v0" }, D { nm: "v1" }]; }
fn mke() -> SE { return SE::A { nm: "se" }; }
fn mkt() -> text { return "tx"; }
fn wrap(d: D) -> D { return D { nm: "w{d.nm}" }; }

// 1 — the reported shape: explicit `return <call>` from a nullable STRUCT return.
fn c1(n: text) -> D? { if n == "y" { return mk() } return null; }
// 2 — the IMPLICIT tail of the same thing; it fell through the same fabricated return.
fn c2(n: text) -> D? { if n == "n" { return null } mk() }
// 3 — nullable VECTOR return. Its work ref is pre-allocated at entry, so the pending
//     free must become conditional or it kills the very store being returned.
fn c3(n: text) -> vector<D>? { if n == "y" { return mkv() } return null; }
// 4 — nullable STRUCT-ENUM return: a heap record, delivered like the struct.
fn c4(n: text) -> SE? { if n == "y" { return mke() } return null; }
// 5 — NESTED calls: two work refs live at the return, only one of which is the value.
fn c5(n: text) -> D? { if n == "y" { return wrap(mk()) } return null; }
// 6 — no branch at all, so the return is the whole body.
fn c6() -> D? { return mk(); }
// 7 — CONTROL: the callee is itself nullable, so it has no retbuf and was always right.
fn c7(n: text) -> D? { if n == "y" { return c6() } return null; }
// 8 — CONTROL: `-> text?` keeps its own text-return delivery; it must NOT take the hoist.
fn c8(n: text) -> text? { if n == "y" { return mkt() } return null; }
// 9 — CONTROL: a nullable DENSE-returning fn used as a value; the non-null twin of c1.
fn c9() -> D { return mk(); }
// 10 — CONTROL: the local-binding spelling, correct before the fix and the shape the
//      emitted IR now matches. If this ever has to change, the fix moved.
fn c10(n: text) -> D? { if n == "y" { m = mk(); return m } return null; }

fn test() {
  // The value path: every cell must DELIVER, on both backends.
  a = c1("y");
  assert(a != null, "c1 delivers the call's value");
  assert((a ?? D { nm: "-" }).nm == "pg", "c1 nm {(a ?? D { nm: "-" }).nm}");
  b = c2("y");
  assert(b != null, "c2 implicit tail delivers");
  assert((b ?? D { nm: "-" }).nm == "pg", "c2 nm {(b ?? D { nm: "-" }).nm}");
  c = c3("y");
  assert(c != null, "c3 nullable vector delivers");
  assert(len(c ?? []) == 2, "c3 len {len(c ?? [])}");
  // A struct-enum has no `== null` operator, so the discharge witnesses delivery:
  // a dropped value would fall through to the default arm.
  d = c4("y") ?? SE::B { k: 5 };
  match d {
    A { nm } => { assert(nm == "se", "c4 nm {nm}") },
    B { k } => { assert(false, "c4 nullable struct-enum dropped its value: {k}") }
  }
  e = c5("y");
  assert(e != null, "c5 nested calls deliver the OUTER value");
  assert((e ?? D { nm: "-" }).nm == "wpg", "c5 nm {(e ?? D { nm: "-" }).nm}");
  f = c6();
  assert(f != null, "c6 body-is-the-return delivers");
  assert((f ?? D { nm: "-" }).nm == "pg", "c6 nm {(f ?? D { nm: "-" }).nm}");
  g = c7("y");
  assert(g != null, "c7 nullable-callee control");
  h = c8("y");
  assert((h ?? "-") == "tx", "c8 text control {h ?? "-"}");
  i = c9();
  assert(i.nm == "pg", "c9 dense control {i.nm}");
  j = c10("y");
  assert((j ?? D { nm: "-" }).nm == "pg", "c10 local-binding control");

  // The NULL path: a bare `return null` must read as null, not as eval-stack garbage.
  assert(c1("n") == null, "c1 null path");
  assert(c3("n") == null, "c3 nullable-vector null path");
  assert(c5("n") == null, "c5 null path");
  assert(c8("n") == null, "c8 text null path");
  assert(c10("n") == null, "c10 null path");
  // A struct-enum has no `== null` operator, so its null path is witnessed by the
  // discharge instead — the shape that used to free an out-of-range store on the way out.
  k = c4("n") ?? SE::B { k: 5 };
  match k {
    A { nm } => { assert(false, "c4 null path produced a value: {nm}") },
    B { k } => { assert(k == 5, "c4 null path discharges to the default") }
  }

  // Repetition is the leak axis: the delivered store must be adopted by the caller and
  // the work ref freed exactly once, so a loop over the value path must not grow the heap.
  n = 0;
  for _ in 0..40 {
    p = c1("y"); if p != null { n += 1 }
    q = c3("y"); if q != null { n += 1 }
    r = c5("y"); if r != null { n += 1 }
  }
  assert(n == 120, "loop delivered every round: {n}");
  println("793 ok");
}
