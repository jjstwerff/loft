// #299 regression: a thin wrapper that tail-returns a struct from a nested,
// adoption-ABI builder — `fn f() -> S { g(...) }` — must not free the returned
// struct's store at its own exit.  When the callee is declared AFTER the wrapper
// (forward reference), the placeholder for the call is added in a later parse
// pass where the tail is already `Span(Call(...))`; `collect_hidden_ref_args`
// previously did not unwrap `Span`, so `ref_return` never promoted the
// placeholder to f's hidden return dest.  The local `__ref_N` was then freed at
// f's exit (`OpFreeRef`), and the next allocation reused that store — all three
// results below aliased one store and read the last-written value (interpret
// only; native/WASM were unaffected).  Surfaced by the crawler FOV loop.

struct Big {
  lw: integer,
  lh: integer,
  a: integer,
  b: integer,
  c: integer,
  d: integer,
  e: integer,
  g: integer,
}

// Wrapper DECLARED BEFORE the builder — the order that defeated the promotion.
fn make(w: integer) -> Big {
  make_inner(w, 0)
}

fn make_inner(w: integer, extra: integer) -> Big {
  r = Big { lw: w, lh: w, a: 0, b: 0, c: 0, d: 0, e: 0, g: 0 };
  r.a = w + extra;
  r
}

fn main() {
  s = make(41);
  assert(s.lw == 41, "first wrapper result holds its own value");
  // Two more wrapper calls.  Before the fix these reused s's wrongly-freed
  // store, so s/t/u all read the last value (77).
  t = make(99);
  u = make(77);
  assert(s.lw == 41, "s not clobbered by later wrapper calls");
  assert(t.lw == 99, "t not clobbered by later wrapper call");
  assert(u.lw == 77, "u holds its own value");
  print("ok");
}
