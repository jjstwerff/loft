//
// Regression (plan-58 cluster III-a): nested narrow-int vector LITERALS silently
// corrupted on both backends.  `vector<vector<i32>> = [[1,2]]` typed the inner
// literal's elements as wide `integer` (8-byte stride) because `parse_item`
// parsed the element with no declared-type context (`Type::Unknown(0)`), while
// the read used the declared narrow width (4-byte) → write@8/read@4 → vv[0][1]
// read 0.  The fix propagates the declared element type `in_t` into the element
// parse, so a nested literal's inner elements adopt the declared narrow width.
// Width-general (i16/u8); copy and write paths were already correct.

fn mk_i32_rows() -> vector<vector<i32>> {
  return[[10, 20, 30], [40]];
}

fn main() {
  // i32 2-deep literal — every index + lengths, distinctive values
  vv: vector<vector<i32>> = [
    [1076895760, 1212630597, 1347440720],
    [2003195204],
    [50462976, 117835012],
  ];
  assert(len(vv[0]) == 3 && len(vv[1]) == 1 && len(vv[2]) == 2, "i32 lens");
  assert(
    vv[0][0] == 1076895760 && vv[0][1] == 1212630597 && vv[0][2] == 1347440720,
    "i32 row0: {vv[0]}"
  );
  assert(vv[1][0] == 2003195204, "i32 row1");
  assert(vv[2][0] == 50462976 && vv[2][1] == 117835012, "i32 row2: {vv[2]}");

  // i16 and u8 (other narrow widths)
  a16: vector<vector<i16>> = [[1001, 2002, 3003], [4004]];
  assert(a16[0][1] == 2002 && a16[0][2] == 3003 && a16[1][0] == 4004, "i16: {a16[0]}");
  a8: vector<vector<u8>> = [[11, 22, 33], [44]];
  assert(a8[0][1] == 22 && a8[0][2] == 33 && a8[1][0] == 44, "u8: {a8[0]}");

  // 3-deep i32 literal
  vvv: vector<vector<vector<i32>>> = [[[111111, 222222]], [[333333]]];
  assert(
    vvv[0][0][0] == 111111 && vvv[0][0][1] == 222222 && vvv[1][0][0] == 333333,
    "3deep: {vvv[0][0]}"
  );

  // i32 nested vector as a struct field (literal-append)
  h: vector<vector<i32>> = [];
  h += [[555555, 666666]];
  assert(h[0][0] == 555555 && h[0][1] == 666666, "structfield-append: {h[0]}");

  // fn-return
  r = mk_i32_rows();
  assert(r[0][1] == 20 && r[0][2] == 30 && r[1][0] == 40, "fn-return: {r}");

  println("nested-narrow-int-vector ok");
}
