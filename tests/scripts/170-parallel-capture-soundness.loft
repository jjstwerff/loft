//
// plan-57 Bug 2 soundness floor: a `parallel {}` arm runs in an isolated worker
// (read-only heap clone + private stack), so it may only READ enclosing state.
// Every unbuilt/broken capture — writing/mutating an enclosing local, or
// capturing a parameter — must be a clean COMPILE ERROR, not a silent no-op or a
// crash.  (The sound read surface is covered by 80/81-parallel*.loft.)
//
// @EXPECT_ERROR: cannot write or mutate enclosing-scope variable 'x'
// @EXPECT_ERROR: cannot write or mutate enclosing-scope variable 'v'
// @EXPECT_ERROR: cannot write or mutate enclosing-scope variable 'b'
// @EXPECT_ERROR: cannot capture function parameter 'p'
// @EXPECT_ERROR: cannot write or mutate enclosing-scope variable 's'

struct Box {
  n: integer,
}

// Scalar write to an enclosing local — silently dropped at runtime (the write
// goes to the worker's private stack and is discarded on join).
fn cap_scalar_write() {
  x = 0;
  parallel { x = 7; }
}

// Vector mutation through a captured ref — crashes the read-only worker clone.
fn cap_vector_mutate() {
  v = [1];
  parallel { v += [2]; }
}

// Struct field mutation through a captured ref.
fn cap_struct_field() {
  b = Box { n: 1 };
  parallel { b.n = 5; }
}

// Parameter capture (read) — SIGSEGVs at teardown.  Copy to a local first if you
// need the value inside an arm.
fn cap_param(p: integer) -> integer {
  parallel { p2 = p + 1; }
  p
}

// Cross-scope write — the arm writes an outer-scope local; SIGSEGVs at runtime.
// Reading `x` (an enclosing local) is fine; only the write to `s` is rejected.
fn cap_cross_scope(n: integer) -> integer {
  s = 0;
  if n > 0 {
    x = 3;
    parallel { s = x + 1; }
  }
  s
}
