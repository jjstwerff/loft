// #339 — codegen panic "Too few parameters on n_<fn> (got 3, need 4)".
// A thin pub wrapper tail-calling a wider struct-returning fn, where
// (a) the wide impl is defined AFTER the wrapper and RETURNS A LOCAL
// (the NRVO-promotable shape — a struct literal tail does not promote),
// and (b) a caller is parsed BEFORE the wrapper.  The wrapper's hidden
// return-buffer attr then only materialised in pass 2 (its callee had no
// hidden attr during the wrapper's pass-1 parse), AFTER the earlier
// caller had been re-parsed against the 3-attr signature — codegen
// asserted on the short call.  Fixed by freezing signatures after pass 1
// (a pass-2-only promotion falls back to the copy-return path).

struct W339 { items: vector<integer>, tag: integer }

// Caller parsed BEFORE the wrapper.
fn use_wrap() -> integer {
  x = wrap339(1, 2, 3);
  len(x.items)+x.tag
}

// Caller of the two-deep chain, also before it.
fn use_chain() -> integer {
  y = chain339(2, 3);
  len(y.items)+y.tag
}

// Thin wrapper chain BEFORE the wide impl.
pub fn chain339(a: integer, b: integer) -> W339 {
  wrap339(a, b, 7)
}

pub fn wrap339(a: integer, b: integer, c: integer) -> W339 {
  full339(a, b, c, 0)
}

// The wide impl LAST — returns a LOCAL (promotes in ITS pass 1).
pub fn full339(a: integer, b: integer, c: integer, d: integer) -> W339 {
  s = W339 { items: [], tag: c };
  for i in 0..a + b { s.items += [i + d]; }
  s
}

fn test_wrapper_arity() {
  r = use_wrap();
  assert(r == 6, "wrapper: expected 6 got {r}");
}

fn test_chain_arity() {
  r = use_chain();
  assert(r == 12, "chain: expected 12 got {r}");
}

fn test_direct_call_still_works() {
  z = full339(1, 1, 5, 10);
  assert(len(z.items) == 2 && z.tag == 5, "direct: got len {len(z.items)} tag {z.tag}");
  assert(z.items[1] == 11, "direct items: got {z.items[1]}");
}

// H1 census follow-up (2026-06-11): the SAME late-growth panic fired for
// VECTOR returns — a vector-literal tail promotes in pass 2 only, so a
// caller defined ABOVE the fn hit 'Too few parameters on n_<fn> (got 0,
// need 1)'.  The retrofit now covers all three heap-buffer kinds.
fn use_vector_literal_fn() -> integer {
  v = colours295();
  len(v)
}

pub fn colours295() -> vector<text> {
  ["red", "green", "blue"]
}

fn test_vector_literal_caller_first() {
  n = use_vector_literal_fn();
  assert(n == 3, "vector caller-first: got {n}");
  c = colours295();
  assert(c[1] == "green", "direct: got {c[1]}");
}
