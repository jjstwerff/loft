// @PLN85 p188 — a DISCARDED owned keyed-collection return (`build() -> sorted<T[k]>`
// and the index/hash siblings) leaked its by-value store on BOTH backends: the #490
// `Value::Drop` lift only recognised Reference / struct-Enum / Function / Vector
// returns via `inline_struct_return`, so a keyed collection fell through to a plain
// stack-pop that never freed the store.  Under a debug-assertions build the leaked
// store even panicked the exit dumper (format.rs:1213 `types[65535]` — rendering a
// sentinel-typed leaked store).  Fix: extend the owned-collection lift to Sorted /
// Index / Hash / Spacial (empty dep = owned), and teach the set-var codegen that
// those DbRef-backed types bind via `OpPutRef`.  Values assert on both backends; the
// wrap leak-gate proves the discarded stores are freed.

struct Tag { id: integer not null, label: text }

fn build_sorted() -> sorted<Tag[id]> {
    out: sorted<Tag[id]> = [];
    out += Tag { id: 2, label: "v2" };
    out += Tag { id: 1, label: "v1" };
    out
}
fn build_index() -> index<Tag[id]> {
    out: index<Tag[id]> = [];
    out += Tag { id: 5, label: "x" };
    out
}
fn build_hash() -> hash<Tag[id]> {
    out: hash<Tag[id]> = [];
    out += Tag { id: 7, label: "h" };
    out
}

fn main() {
    // (1) discarded — the p188 cell, all three keyed collections.
    build_sorted();
    build_index();
    build_hash();

    // (2) bound + used — must stay correct (the lift excludes borrowed/NRVO deps).
    s = build_sorted();
    assert(len(s) == 2, "sorted {len(s)}");
    i = build_index();
    assert(len(i) == 1, "index {len(i)}");

    // (3) discarded in a loop — no per-iteration leak.
    for n in 0..25 { build_sorted(); }

    println("discarded-keyed-collection-return-free ok");
}
