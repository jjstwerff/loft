// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// `@FR-B-Copy` says a plain bind of a heap WHOLE VALUE is INDEPENDENT.  It did not hold when
// the right-hand side was a branch JOIN: `b = if c { a } else { [0, 0] }` ALIASED `a`, so a
// later write to `a` was visible through `b`, on both backends and on the shipped 2026.8.0.
// The plain bind of the identical value one line away copies, which is the oracle sitting
// next to the defect (loft#1321).
//
// `@FR-B-Join` is the rule the fix implements: a join is read ARM BY ARM.  It copies where
// every arm would have copied on its own, and keeps the view where some arm NAMES a place a
// view rule exempts.  A join is not itself a projection, so the arms are what can carry a
// place — and reading the JOIN instead of its arms would make `@FR-B-View-Depth` unreachable
// for its own documented spelling, because `v[i]` is `τ?` and cannot be used without a
// discharge, which lowers to a branch.
//
// What made this survive its neighbours: the destination inherited a dep on the arm it was
// bound from, and `owned_ref` in `generate_set` requires `depend().is_empty()`, so the copy
// machinery — including the `OpBindOrCopy` arm written for exactly this shape — was closed
// off before it could be reached.  The ownership ORACLE reported the joined binding `Owned`
// throughout; the shipped dep said borrowed, and the alias followed the dep.
//
// Axes it MOVES: the ARM TAIL (a bare variable, a call, a one-level field read off an owned
//   base, a literal, both arms variables, a `??` discharge, `match` arms, three arms); the
//   bound type (`vector<integer>`, `vector<struct>`, a record, and the keyed kinds as the
//   already-correct control); which side is written afterwards (source then read the bind,
//   and the bind then read the source); how many times the bind RUNS (once, and in a loop
//   where a per-pass copy makes a leak visible); and backend — interpreter and `--native`,
//   every cell, since the two lower this in different files.
//
// Axes it HOLDS FIXED, and why:
//   * The arm COUNT stops at three.  The rule is per-arm and the lowering is not N-ary in
//     any way a fourth arm would exercise; three is what distinguishes "handles two" from
//     "handles a chain".
//   * The join's CONDITION is always a constant here.  Which arm runs is decided before the
//     bind either way; a computed condition varies the arm taken, not the rule applied.
//
// The controls are the whole reason this is not "make every join copy".  A join whose arm
// names a place must still VIEW — that is the cell that turns red first if the arm test is
// dropped for the branch shape alone, and `bind-copies-or-views-the-whole-boundary.loft`
// carries it as `test_vector_index_read_is_a_view`.
//
// ⚠ ONE EDGE IS DELIBERATELY LEFT AS IT WAS, and it is a cell below rather than a silence:
// `b = if c { vv[0] } else { [0, 0] }` still VIEWS.  Read arm by arm that is what the rules
// say, and it is also the shape `ownership.md` D-own-8 calls a defect — a binding that is a
// view on one path and an owner on the other.  Changing it means deciding that a branch
// produces a VALUE, which moves what `@FR-B-View-Depth` reaches for a shipped spelling; that
// is a compatibility decision with its own gate, not something to fold into a bug fix.  The
// cell pins today's answer so the decision is a visible diff when it is taken.
//
// @falsified-at: ad38c1bd — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  One assertion because the file
//   stops at the first that fires — the bare-variable arm.  The record, `match`, `??` and
//   three-arm cells were each measured alone against the same commit; the view cell, the
//   keyed cells and the call-tail cell pass on that build too, which is what makes them
//   controls rather than further instances.

struct J21S { j21_v: integer }
struct J21R { j21_k: integer, j21_v: integer }
struct J21O { j21_vs: vector<integer> }

fn j21_through_a_call(j21_q: vector<integer>) -> vector<integer> {
  return j21_q;
}

fn j21_a_bare_variable_arm() {
  j21_a: vector<integer> = [41, 42];
  j21_c = true;
  j21_b = if j21_c { j21_a } else { [0, 0] };
  j21_a[1] = 99;
  assert(j21_b[1] == 42, "a joined bind is a COPY, got {j21_b[1]}");
  assert(len(j21_b) == 2, "with the arm's length");

  // The other direction: writing the BIND must not reach the source.
  j21_d: vector<integer> = [41, 42];
  j21_e = if j21_c { j21_d } else { [0, 0] };
  j21_e[0] = 77;
  assert(j21_d[0] == 41, "the source is untouched by a write through the joined bind");
  assert(j21_e[0] == 77, "which did land in the bind");
}

fn j21_every_arm_shape() {
  j21_c = true;

  // a CALL tail — correct before this fix, because loft#1320 lifts it into an owned temp
  j21_a: vector<integer> = [41, 42];
  j21_b = if j21_c { j21_through_a_call(j21_a) } else { [0, 0] };
  j21_a[1] = 99;
  assert(j21_b[1] == 42, "a call-tail arm copies, got {j21_b[1]}");

  // a ONE-LEVEL field read off an OWNED base — `@FR-B-View-Base`'s collection half copies
  j21_o = J21O { j21_vs: [41, 42] };
  j21_f = if j21_c { j21_o.j21_vs } else { [0, 0] };
  j21_o.j21_vs[1] = 99;
  assert(j21_f[1] == 42, "an owned field-read arm copies, got {j21_f[1]}");

  // BOTH arms variables — neither is a fresh value, so neither may be adopted
  j21_g: vector<integer> = [41, 42];
  j21_h: vector<integer> = [7, 8];
  j21_i = if j21_c { j21_g } else { j21_h };
  j21_g[1] = 99;
  assert(j21_i[1] == 42, "both-variable arms copy, got {j21_i[1]}");
  assert(j21_h[1] == 8, "and the arm NOT taken is untouched");

  // LITERAL arms — nothing to alias, and nothing to copy either; the control for over-firing
  j21_j = if j21_c { [41, 42] } else { [0, 0] };
  assert(j21_j[1] == 42, "literal arms are unchanged, got {j21_j[1]}");

  // a `??` discharge over a whole VARIABLE — a branch, and its subject is a whole value
  j21_k: vector<integer>? = [41, 42];
  j21_l = j21_k ?? [0, 0];
  j21_k[1] = 99;
  assert(j21_l[1] == 42, "a `??` over a variable copies, got {j21_l[1]}");

  // `match` arms, and THREE of them
  j21_n = 1;
  j21_m: vector<integer> = [41, 42];
  j21_p = match j21_n { 1 => j21_m, 2 => [1, 1], _ => [0, 0] };
  j21_m[1] = 99;
  assert(j21_p[1] == 42, "a match arm copies, got {j21_p[1]}");

  j21_q: vector<integer> = [41, 42];
  j21_r = if j21_n == 0 { [1, 1] } else if j21_n == 1 { j21_q } else { [0, 0] };
  j21_q[1] = 99;
  assert(j21_r[1] == 42, "a three-arm chain copies, got {j21_r[1]}");
}

fn j21_a_record_arm() {
  j21_c = true;
  j21_s: J21S = J21S { j21_v: 41 };
  j21_t = if j21_c { j21_s } else { J21S { j21_v: 0 } };
  j21_s.j21_v = 99;
  assert(j21_t.j21_v == 41, "a joined RECORD bind is a COPY, got {j21_t.j21_v}");

  j21_u: J21S = J21S { j21_v: 41 };
  j21_w = if j21_c { j21_u } else { J21S { j21_v: 0 } };
  j21_w.j21_v = 77;
  assert(j21_u.j21_v == 41, "the record source is untouched by a write through the bind");
  assert(j21_w.j21_v == 77, "which did land in the bind");
}

fn j21_a_struct_element_type() {
  // The element type is a record rather than an integer, so the copy is a per-element
  // record copy rather than a scalar run.
  j21_c = true;
  j21_v: vector<J21S> = [J21S { j21_v: 41 }, J21S { j21_v: 42 }];
  j21_b = if j21_c { j21_v } else { [] };
  j21_v[1].j21_v = 99;
  assert(j21_b[1].j21_v == 42, "a struct-element join copies, got {j21_b[1].j21_v}");
  assert(len(j21_b) == 2, "with both elements");
}

fn j21_repeated_in_a_loop() {
  // A copy per pass, so a leak or an over-free shows here and in none of the single-bind
  // cells, and each pass must answer independently of the source.
  j21_src: vector<integer> = [41, 42];
  j21_c = true;
  j21_seen = 0;
  j21_i = 0;
  while j21_i < 4 {
    j21_copy = if j21_c { j21_src } else { [0, 0] };
    j21_src[1] = 50 + j21_i;
    j21_seen += j21_copy[1];
    j21_i += 1;
  }
  // each pass copies BEFORE its own write: 42 + 50 + 51 + 52
  assert(j21_seen == 195, "each pass copies before its own write, got {j21_seen}");
  assert(j21_src[1] == 53, "and the source carries every write, got {j21_src[1]}");
}

fn j21_the_keyed_kinds_are_the_control() {
  // Already correct, and they must not move: the keyed branch lowers to `OpReplaceKeyed`,
  // which deep-copies whichever arm ran whatever its shape.
  j21_c = true;
  j21_h: hash<J21R[j21_k]> = [J21R { j21_k: 1, j21_v: 41 }];
  j21_b = if j21_c { j21_h } else { [] };
  assert(len(j21_b) == 1, "a joined hash bind carries its element");
  j21_found = j21_b[1];
  assert(j21_found != null, "and it is findable by key");
  assert((j21_found ?? J21R { j21_k: 0, j21_v: 0 }).j21_v == 41, "with its value");

  j21_s: sorted<J21R[j21_k]> = [J21R { j21_k: 1, j21_v: 41 }];
  j21_bs = if j21_c { j21_s } else { [] };
  assert(len(j21_bs) == 1, "and a joined sorted bind too");
}

fn j21_an_arm_that_names_a_place_still_views() {
  // The deliberate edge, pinned rather than left silent.  `vv[0]` NAMES an interior place,
  // and `@FR-B-View-Depth` makes reading one a VIEW; read arm by arm the join keeps that.
  // It is also the shape D-own-8 calls a defect, so this cell is where the decision to
  // change it would show as a diff.  See this file's header.
  j21_vv: vector<vector<integer>> = [[41, 42]];
  j21_c = true;
  j21_b = if j21_c { j21_vv[0] } else { [0, 0] };
  j21_vv[0][1] = 99;
  assert(j21_b[1] == 99, "an arm that names a place still VIEWS, got {j21_b[1]}");

  // and the same shape through the discharge every `τ?` element read needs
  j21_ww: vector<vector<integer>> = [[41, 42]];
  j21_d = j21_ww[0] ?? [0];
  j21_ww[0][1] = 99;
  assert((j21_d[1] ?? 0) == 99, "and so does `vv[0] ?? d`, got {j21_d[1] ?? 0}");
}

fn main() {
  j21_a_bare_variable_arm();
  j21_every_arm_shape();
  j21_a_record_arm();
  j21_a_struct_element_type();
  j21_repeated_in_a_loop();
  j21_the_keyed_kinds_are_the_control();
  j21_an_arm_that_names_a_place_still_views();
}
