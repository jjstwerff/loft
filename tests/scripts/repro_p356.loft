// @P356 regression: explicit out-of-bounds `v[i]` / `s[i]` (and negative
// index) is a RECOVERABLE fault — it returns the type's null sentinel and
// execution CONTINUES, identically on the interpreter and `--native`.
// Previously the interpreter HALTED (raised IndexOutOfBounds, exit 1) while
// native returned null and continued — a silent backend divergence (and the
// null path could feed an empty vector's [0] into a loop bound → hang).
// Three coordinated fixes made this safe:
//   (A) gen_if leveling: an expression `if {value} else null` (the `?? null`
//       ncc lowering) now pushes a TYPED NULL on the false path so the join
//       is balanced — without it, `tv[0] ?? null` over a text vector freed a
//       mis-offset slot → SIGSEGV.
//   (B) the `??`→nullable swap now covers every element getter (text / float /
//       single / enum / char / bool / nested), not just integers.
//   (C) bare `v[i]` routes through `raise_recoverable` (log Warn + null +
//       continue; `LOFT_DEV_SOFT_HALT` opts into fail-fast).
// Both backends now agree.

fn oob_empty_int() -> integer {
    v: vector<integer> = [];
    return v[0];          // OOB → null
}

fn oob_int() -> integer {
    v: vector<integer> = [10, 20, 30];
    return v[5];          // OOB → null
}

fn neg_in_range() -> integer {
    v: vector<integer> = [10, 20, 30];
    return v[-1];         // Python-style → 30
}

fn neg_out() -> integer {
    v: vector<integer> = [10, 20, 30];
    return v[-10];        // out of range → null
}

fn text_oob_continues() -> integer {
    s = "hello";
    c = s[100];           // OOB → null char, continues
    return len(s);        // proves execution continued
}

// The (A) crash repro: `?? null` over an emptied text vector.
fn text_vec_coalesce_null() -> text? {
    tv: vector<text> = ["a", "b"];
    for s in tv { s#remove; }
    return tv[0] ?? null;  // OOB → ncc → null (was SIGSEGV before fix A)
}

// `?? fallback` over an emptied text vector recovers to the fallback.
fn text_vec_coalesce_fallback() -> text {
    tv: vector<text> = ["a"];
    for s in tv { s#remove; }
    return tv[0] ?? "fb";
}

fn main() {
    a = oob_empty_int();
    b = oob_int();
    c = neg_in_range();
    d = neg_out();
    e = text_oob_continues();
    f = text_vec_coalesce_null();
    g = text_vec_coalesce_fallback();
    print("a={a} b={b} c={c} d={d} e={e} g=[{g}]\n");
    assert(a == null, "empty v[0] must be null");
    assert(b == null, "OOB v[5] must be null");
    assert(c == 30, "v[-1] must be 30 (Python addressing)");
    assert(d == null, "out-of-range v[-10] must be null");
    assert(e == 5, "execution must continue past s[100] OOB");
    assert(f == null, "tv[0] ?? null on emptied text vector must be null (no crash)");
    assert(g == "fb", "tv[0] ?? \"fb\" must recover to the fallback");
}
