// @TITLE H3 — narrow-width integer casts and vector index assignment
// Two defects the crawler hit in its collision field, both on BOTH backends.
//
// 1. `x as u32?` on a RUNTIME operand always returned null.  `dn4_checked_cast` built the
//    range guard with `spec.max as i32`, and u32's maximum (4_294_967_294) wraps to -2, so
//    the guard `0 <= v && v <= -2` rejected every value.  Silent, because the idiomatic
//    `?? 0` then supplied a plausible zero.  A CONSTANT operand hid it by const-folding
//    before the guard is built — which is why every cell below launders its value through
//    `opaque()` first.  Remove that and this file goes vacuous.
//
// 2. `v[i] = x` on a `vector<u16>`/`vector<i16>` failed to COMPILE ("Cannot assign to
//    attribute on type 'OpGetShortRaw'"): the narrow-vector 2-byte reader was missing from
//    the read→write op mapping, though its write twin `OpSetShortRaw` already existed.
//    A u16 STRUCT FIELD always worked, so the vector spelling is the one to guard.
struct Grid { cells: vector<u32>, flags: vector<u16>, deltas: vector<i16> }

// Defeats const-folding, so the checked cast is emitted rather than evaluated.
fn opaque(x: integer) -> integer { x + 0 }

fn poke_u32(g: Grid, i: integer, v: integer) { g.cells[i] = v as u32? ?? 0 }
fn poke_u16(g: Grid, i: integer, v: integer) { g.flags[i] = v as u16? ?? 0 }
fn poke_i16(g: Grid, i: integer, v: integer) { g.deltas[i] = v as i16? ?? 0 }

fn main() {
  // --- 1. the checked cast survives a runtime operand, at every width ---
  n = opaque(7);
  assert((n as u8?  ?? -1) == 7, "u8 checked cast");
  assert((n as i8?  ?? -1) == 7, "i8 checked cast");
  assert((n as u16? ?? -1) == 7, "u16 checked cast");
  assert((n as i16? ?? -1) == 7, "i16 checked cast");
  assert((n as i32? ?? -1) == 7, "i32 checked cast");
  assert((n as u32? ?? -1) == 7, "u32 checked cast — returned null for EVERY value before");

  // A u32 above i32::MAX passes the guard: the bound is compared at i64 width now.
  big = opaque(4000000000);
  assert((big as u32? ?? -1) == 4000000000, "u32 guard admits values above i32::MAX");

  // The guard still REJECTS out-of-range values — the fix widened it, it did not remove it.
  assert((opaque(-1) as u32? ?? -1) == -1, "u32 rejects a negative");
  assert((opaque(300) as u8? ?? -1) == -1, "u8 still rejects 300");

  // --- 2. index assignment on narrow-width vector elements ---
  g = Grid{ cells: [1, 2], flags: [1, 2], deltas: [1, 2] };
  g.flags[0]  = opaque(500) as u16? ?? 0;   // direct — did not compile before
  g.deltas[0] = opaque(-500) as i16? ?? 0;  // direct — did not compile before
  poke_u32(g, 1, 70000);                    // through a struct parameter
  poke_u16(g, 1, 600);
  poke_i16(g, 1, -600);
  assert((g.flags[0] ?? 0) == 500,   "u16 vector element, direct write");
  assert((g.deltas[0] ?? 0) == -500, "i16 vector element, direct write");
  assert((g.cells[1] ?? 0) == 70000, "u32 vector element, write via a struct param");
  assert((g.flags[1] ?? 0) == 600,   "u16 vector element, write via a struct param");
  assert((g.deltas[1] ?? 0) == -600, "i16 vector element, write via a struct param");

  // The untouched neighbours are intact — a wrong element stride shows up here.
  assert((g.cells[0] ?? 0) == 1,  "u32 neighbour untouched");
  assert((g.flags[1] ?? 0) == 600, "u16 element stride is 2 bytes, not 8");
  assert(size(g.flags) == 4, "two u16 elements occupy 4 bytes");
  assert(size(g.deltas) == 4, "two i16 elements occupy 4 bytes");
  assert(size(g.cells) == 8, "two u32 elements occupy 8 bytes");
  print("ok\n");
}
