//
// loft#735 — a call argument that the #248 ordering-lift captures must not be
// FREED by that lift.
//
// The shape: a call whose receiver is a borrowed `&` ref (`put(w, …)` with
// `w: &World`) and whose later argument is an inline heap-returning call
// (`make_flat(…)`). `scan_args` force-lifts that argument into a `__lift_N` temp
// so the store is materialised before the receiver's `OpCreateStack` is pushed —
// an ORDERING fix (#248), not an ownership transfer.
//
// The lift claimed ownership anyway: `heap_call_return` hands back the type with
// `Deps::none()`, so `get_free_vars` read `owns == true` and emitted
// `OpFreeRef(__lift_N)` after the call. But `make_flat` delivers through the
// CALLER's hidden work-ref (`__ref_N`), which the caller frees at function exit —
// so the lift freed a live store. The slot was then recycled under the still-live
// world, and the next nested write landed in the recycled store.
//
// What made it expensive to find is the SHAPE of the damage: the chunk appends and
// the one-step field write (`ck_base`) still landed, so the container came out
// structurally correct — right count, right scalar fields — and only the innermost
// payload was wrong. Every structural check passed. Measured on moros, where it read
// as terrain with correct x/z and wrong y (four rounds of diagnosis, each excluding a
// real hypothesis, because the instrument reporting them was the thing at fault).
//
// The lift now carries the free-time half of the fact it already carried the
// allocate-time half of (`inline_ref` / `skip_free`), so no `OpFreeRef` is emitted
// and the caller's `__ref_N` stays the sole owner.
//
// Hand-correct target, proven before the fix: binding the same call to a named local
// yields `flat:vector<integer>["__ref_1"]` with NO free. The lift now matches it.
//
// The interpreter SIGSEGV'd here; native survived on slot-reuse luck with the same
// double free in its output, so both backends are asserted below. The suite's leak
// gate is the other half: an over-suppressed free would leak here rather than crash.

struct L735Cell {
  sv_height: integer,
}

struct L735Layer {
  ly_cells: vector<L735Cell>,
}

struct L735Chunk {
  ck_base: integer,
  ck_layers: vector<L735Layer>,
}

struct L735World {
  w_chunks: vector<L735Chunk>,
}

struct L735Holder {
  h_cache: L735World,
}

// Grown by repeated append, so the returned store is delivered through the
// caller's hidden work-ref rather than handed back by value.
fn l735_make_flat(seed: integer) -> vector<integer> {
  out: vector<integer> = [];
  for i in 0..4 { out += [seed + i]; }
  out
}

// The mutating callee: appends a chunk, writes a one-step field, then writes
// through TWO index steps. Pre-fix only the last of the three was lost.
fn l735_put(w: &L735World, base: integer, flat: vector<integer>) {
  w.w_chunks += [L735Chunk { ck_base: 0, ck_layers: [L735Layer { ly_cells:
    [for _c in 0..4 { L735Cell { sv_height: 0 } }] }] }];
  ci = len(w.w_chunks) - 1;
  w.w_chunks[ci].ck_base = base;
  for k in 0..4 {
    w.w_chunks[ci].ck_layers[0].ly_cells[k] = L735Cell { sv_height: flat[k] ?? 0 };
  }
}

fn l735_check(tag: text, w: L735World, want_chunks: integer, want_base: integer,
              want_cell: integer) {
  assert(len(w.w_chunks) == want_chunks,
    "{tag}: chunks={len(w.w_chunks)} want {want_chunks}");
  got_base = w.w_chunks[0].ck_base;
  assert(got_base == want_base, "{tag}: base={got_base} want {want_base}");
  // The one that vanished: the innermost payload, two index steps deep.
  got_cell = w.w_chunks[0].ck_layers[0].ly_cells[2].sv_height;
  assert(got_cell == want_cell, "{tag}: cell2={got_cell} want {want_cell}");
}

fn l735_via_param(b: &L735World, x: integer) {
  l735_put(b, 100 + x, l735_make_flat(300 + x * 10));
}

fn main() {
  // The reported shape: the destination is the caller's own LOCAL, and the
  // heap-returning call sits inline in the argument list. Two rounds are needed —
  // one call never tripped it, because the damage lands on the RECYCLED slot.
  wa = L735World { w_chunks: [] };
  for x1 in 0..2 { l735_put(wa, 100 + x1, l735_make_flat(300 + x1 * 10)); }
  l735_check("local inline", wa, 2, 100, 302);

  // Control — the destination arrives as a `&` parameter. Always worked; it is
  // what made the local case look like a caller problem rather than a lift bug.
  wb = L735World { w_chunks: [] };
  for x2 in 0..2 { l735_via_param(wb, x2); }
  l735_check("via & param", wb, 2, 100, 302);

  // Control — the destination is a struct field. Also always worked.
  h = L735Holder { h_cache: L735World { w_chunks: [] } };
  for x3 in 0..2 { l735_put(h.h_cache, 100 + x3, l735_make_flat(300 + x3 * 10)); }
  l735_check("struct field", h.h_cache, 2, 100, 302);

  // Control — the argument hoisted into a named local. This is the hand-correct
  // form the fix makes the lift match, and it is the workaround the issue names.
  wd = L735World { w_chunks: [] };
  for x4 in 0..2 {
    flat = l735_make_flat(300 + x4 * 10);
    l735_put(wd, 100 + x4, flat);
  }
  l735_check("arg hoisted", wd, 2, 100, 302);

  // The lifted value must still be READ correctly, not merely left unfreed: a fix
  // that skipped the lift altogether would break this rather than the leak gate.
  we = L735World { w_chunks: [] };
  l735_put(we, 555, l735_make_flat(700));
  assert(we.w_chunks[0].ck_layers[0].ly_cells[3].sv_height == 703,
    "lifted argument still delivers its value");

  println("ok");
}
