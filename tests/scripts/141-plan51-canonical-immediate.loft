// Probe 01 — canonical immediate-Set-then-tail shape (the @P377 oracle).
//
//   fn render_struct(p: P) -> Canvas {
//     cv = alloc_canvas(...);   // Set is IMMEDIATE penultimate
//     cv                         // tail
//   }
//
// S1's `nrvo_collapse_tail_set` (parse-time) substitutes the inner call's
// hidden-buffer arg with `cv`, so the inner call writes directly into cv's
// slot.  S2's narrow codegen gate (src/state/codegen.rs:1378-1390) then
// detects the resulting `Set(cv, Call(fn, [.., Var(cv), ..]))` shape and
// skips the pre-Set OpFreeRef — preventing the caller's buffer from being
// freed mid-call.
//
// Together S1+S2 close this shape on both backends.  Native always passed.
//
// Expected: PASS on both --interpret and --native.
// Status: closes @P377 (LEAK + CORRUPTION).

struct P { tag: integer }
struct Q { tag: integer }
struct Canvas {
  data: vector<integer>,
  w: integer,
}

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render_p(p: P) -> Canvas {
  cv = alloc_canvas(4, 5, p.tag); cv
}
fn render_q(q: Q) -> Canvas {
  cv = alloc_canvas(7, 9, q.tag * 2); cv
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    q = Q { tag: i + 100 };
    cv_p = render_p(p);
    cv_q = render_q(q);
    assert(cv_p.w == 4, "iter {i}: cv_p.w = {cv_p.w}");
    assert(cv_q.w == 7, "iter {i}: cv_q.w = {cv_q.w}");
    assert(len(cv_p.data) == 5, "iter {i}: len(cv_p) = {len(cv_p.data)}");
    assert(len(cv_q.data) == 9, "iter {i}: len(cv_q) = {len(cv_q.data)}");
    for k in 0..5 { assert(cv_p.data[k] == i, "iter {i} k {k}: cv_p[{k}] = {cv_p.data[k]}"); }
    for k in 0..9 {
      assert(cv_q.data[k] == (i + 100)*2, "iter {i} k {k}: cv_q[{k}] = {cv_q.data[k]}");
    }
  }
  println("probe 01 PASSED");
}
