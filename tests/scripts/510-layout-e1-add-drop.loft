// @PLN97 Phase E1 — an Add/Drop schema change rides the ONE lenient
// serialize→deserialize path (`to_json` out / `Struct.parse` in) with NO
// special mechanism: a missing (added) field defaults, an extra (dropped) field
// is ignored, and the preserved fields survive intact. This is the "add-only /
// drop-only is automatic" claim, proven on interp + --native + wasm.
//
// Note: an ADDED field defaults to null (the absent sentinel) — even a
// `not null` field — since the serialized old data carries no value for it. A
// program that adds a not-null field must supply a default at another layer.
struct V1 { name: text, score: integer not null }
struct V2 { name: text, score: integer not null, level: integer not null }

fn main() {
  // ADD (V1 → V2): the new field `level` defaults; name/score preserved.
  a = V1 { name: "hero", score: 42 };
  av2 = V2.parse(a.to_json());
  assert(av2.name == "hero", "add: name preserved");
  assert(av2.score == 42, "add: score preserved");

  // DROP (V2 → V1): the removed field `level` is ignored; name/score preserved.
  b = V2 { name: "boss", score: 7, level: 3 };
  dv1 = V1.parse(b.to_json());
  assert(dv1.name == "boss", "drop: name preserved");
  assert(dv1.score == 7, "drop: score preserved");

  println("e1 add/drop lenient round-trip ok");
}
