// @P272 regression — a SIDE-EFFECTING text producer used inside an INLINE
// format-string comparison must be evaluated exactly once.  `#errors`
// (i_parse_errors) clears the stored parse errors on read.  Native used to
// hoist the format block into a `_pre_N` binding AND re-inline it in the
// comparison: the dead hoisted copy consumed the errors, so the live copy read
// empty — `inline=false` on --native, `inline=true` on --interpret.
//
// The fix is the pre-eval cut-over: emission substitutes a hoisted node by its
// intrinsic identity (node address → `_pre_N`), so the operand is emitted once
// and never re-generated inline.  No counter, no regenerate-and-string-match.
// This must hold identically on BOTH backends (Goal D).

struct PScore {
  val: integer,
}

fn main() {
  // Side-effecting producer inside an inline format-string comparison.
  b = PScore.parse("not_json");
  inline = "[{b#errors}]" != "[]";
  assert(inline, "inline #errors compare must be non-empty (evaluated once)");

  // The documented var-form workaround must keep working too.
  c = PScore.parse("also_bad");
  errs = "[{c#errors}]";
  varform = errs != "[]";
  assert(varform, "var-form #errors compare");

  // A PURE producer in the same inline shape stays correct (no regression).
  d = PScore.parse("nope");
  pure = "[{d.to_json()}]" != "[]";
  assert(pure, "inline pure-producer compare");

  print("p272 ok\n");
}
