//
// Regression (#406) — a struct field whose type is a STRUCT-ENUM, initialised
// from a VARIABLE / call return (not an inline literal), must be copied into the
// field AT ITS OFFSET.  `set_field_check`'s `Type::Enum(_, true, _)` arm copied
// the source enum into the struct BASE (offset 0) instead of a field sub-ref, so
// a struct-enum in any non-first field landed at offset 0 — clobbering field 0
// and leaving a garbage discriminant.  The vector-append in the original report
// only SURFACED the already-corrupt struct (`copy_claims` read the -1
// discriminant and panicked out-of-bounds); the corruption was in CONSTRUCTION,
// before the append.  An inline `CInt { value: 1 }` literal was unaffected (it
// constructs in place at the field offset).
//
// Fix (src/parser/mod.rs): the struct-enum arm now emits `OpGetField(base, pos)`
// then `OpCopyRecord` into that field sub-ref — mirroring the `Type::Reference`
// arm directly above it.

enum CV { CInt { value: integer not null } }
struct Entry { key: CV, value: CV }
struct Mix { count: integer not null, k: CV }
struct Tri { a: CV, b: CV, c: CV }

fn mk(x: integer) -> CV { return CInt { value: x }; }
fn rd(c: CV) -> integer { if c is CInt { value } { return value; } return -1; }

// The original report: build a two-enum-field struct from variables, append to a
// vector, read it back.  Both fields must survive at their own offsets.
fn test_enum_fields_from_vars_then_append() {
  a = mk(1);
  b = mk(2);
  e = Entry { key: a, value: b };
  assert(rd(e.key) == 1, "construction key={rd(e.key)} (expect 1)");
  assert(rd(e.value) == 2, "construction value={rd(e.value)} (expect 2)");
  v: vector<Entry> = [];
  v += [e];
  assert(len(v) == 1, "appended len={len(v)} (expect 1)");
  assert(rd(v[0].key) == 1, "after-append key={rd(v[0].key)} (expect 1)");
  assert(rd(v[0].value) == 2, "after-append value={rd(v[0].value)} (expect 2)");
}

// A struct-enum field AFTER a scalar field: the enum must land at its own offset,
// not clobber the leading scalar (`count` read 9, `k` read its own value).
fn test_scalar_then_enum_field() {
  a = mk(7);
  o = Mix { count: 9, k: a };
  assert(o.count == 9, "scalar count={o.count} (expect 9)");
  assert(rd(o.k) == 7, "enum k={rd(o.k)} (expect 7)");
}

// Three struct-enum fields from variables — each at a distinct offset.
fn test_three_enum_fields() {
  x = mk(1);
  y = mk(2);
  z = mk(3);
  o = Tri { a: x, b: y, c: z };
  assert(rd(o.a) == 1, "tri a={rd(o.a)} (expect 1)");
  assert(rd(o.b) == 2, "tri b={rd(o.b)} (expect 2)");
  assert(rd(o.c) == 3, "tri c={rd(o.c)} (expect 3)");
}

// Mixed sources: a literal in the first field, a variable in the second.  The
// variable copy must not overwrite the literal-built first field.
fn test_literal_first_variable_second() {
  b = mk(2);
  o = Entry { key: CInt { value: 1 }, value: b };
  assert(rd(o.key) == 1, "mixed key={rd(o.key)} (expect 1)");
  assert(rd(o.value) == 2, "mixed value={rd(o.value)} (expect 2)");
}

// Field REASSIGNMENT of a struct-enum from a variable also targets the offset.
fn test_enum_field_reassignment() {
  a = mk(4);
  b = mk(5);
  o = Entry { key: CInt { value: 0 }, value: CInt { value: 0 } };
  o.key = a;
  o.value = b;
  assert(rd(o.key) == 4, "reassign key={rd(o.key)} (expect 4)");
  assert(rd(o.value) == 5, "reassign value={rd(o.value)} (expect 5)");
}
