//
// @PLAN59 / H1 — a ref-returning fn with MULTIPLE return sites whose
// values are materialized work refs (forward-referenced callee, or a
// generated `.parse` method).  Phase 1 provisions ONE signature-time
// `__retbuf`; the first site consumes (renames) it, so site 2+ must NOT
// grow the signature (arity is a pure function of the declaration) —
// those locals stay un-promoted and return through the reassigned-local
// copy path.  Was: legacy in-place growth + the armed-build assert
// "@PLAN59: arity grew post-signature on plain fn" (seen on
// moros_map::map_from_json and graphics' glb_pos_min).
//
// Distinctive value per return path; every path checked.

struct S {
  // Nullable so `from_json` below can reach its third return site on a parse that
  // supplies nothing. A plain `integer` cannot hold null, so the absent key would
  // read 0 and the fallback would never fire — the site under test would go
  // unexercised while every assertion still passed (loft#870).
  v: integer?,
}

// `mk` is defined AFTER its callers — the forward-reference shape that
// materializes a per-site `__ref_N` (a pre-parsed callee chains the
// buffer instead and never trips this).
fn pick(json: text) -> S {
  if json == "" { return mk(71006); }
  result = mk(71007);
  if json == "bad" { return mk(71008); }
  result
}

fn from_json(json: text) -> S {
  if json == "" { return mk(70999); }
  result = S.parse(json);
  if result.v == null { return mk(70998); }
  result
}

fn mk(n: integer) -> S {
  s = S { v: n }; s
}

fn main() {
  assert(pick("").v == 71006, "first site (buffer-bound), got {pick(\"\").v}");
  assert(pick("x").v == 71007, "tail local (copy path), got {pick(\"x\").v}");
  assert(pick("bad").v == 71008, "mid site (copy path), got {pick(\"bad\").v}");
  assert(from_json("").v == 70999, "parse fn first site, got {from_json(\"\").v}");
  good = from_json("{{\"v\": 71010}}");
  assert(good.v == 71010, "parse result tail, got {good.v}");
  fb = from_json("{{}}");
  assert(fb.v == 70998, "parse-null fallback site, got {fb.v}");
}
