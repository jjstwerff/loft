//
// A branch join is nullable when ANY arm is, whichever arm that is and however the branch is
// spelled (loft#1103, `types.md` D-Null-Join).
//
// That is `(N-Join)` verbatim — a join has type `⨆ᵢ τᵢ`, *made OPTIONAL iff some `τᵢ` is
// optional* — and it is what makes `(N-Decl)` and `(N-Store)` reach a branch at all. Without
// it the join took the FIRST arm's type and a later arm's `Optional` was dropped rather than
// joined, so a declared non-null slot accepted null and held it:
//
//     fn maybe(k: integer) -> integer? { if k > 5 { 7 } else { null } }
//     fn f(k: integer) -> integer { x: integer = if k == 9 { 1 } else { maybe(k) }; x }
//
// `f(1)` answered `null` on both backends with no diagnostic, and the variable really was
// non-null — the IR read `x(1):integer`, so nothing had been widened behind the declaration.
// Writing the same store DIRECTLY (`x: integer = maybe(k)`) was always refused; only its
// position in a later arm hid it.
//
// A `null` LITERAL in that same arm was always caught, but by a different mechanism: the DN1
// walkers match the `OpConv*FromNull` node a literal lowers to. A nullable-TYPED value produces
// no null-shaped node at all, so nothing asked about it — one notion with two spellings and
// only one of them looked for. The join now asks the TYPE, which is the spelling-free form of
// the question, so both spellings answer the same.
//
// The cells below pin WHICH SITE REPORTS, because the rules give three different answers and a
// fix that made them uniform would be wrong:
//
//   * a DECLARED slot is refused — `(N-Decl)`: "declaring non-null FORBIDS a later nullable
//     write". This is what the direct spelling already did, so it is the answer the branch
//     spelling has to match;
//   * a RETURN and a FIELD warn and hold the null — `(N-Store)` for a type whose null is
//     representable-and-distinct, which "compiles + runs, the slot holds null";
//   * a NARROW width is refused wherever it appears, because its sentinel collides with a real
//     value. That is the cell this fix most had to reach: every other one is recoverable with a
//     warning by the rule, and that one is not.
//
// ⚠ THIS FILE ALONE DOES NOT SCORE THE FIX, and that is deliberate rather than an oversight.
// Every cell here declares the nullable type the rules require, and a join that WRONGLY types
// non-null still stores into a nullable slot happily — so all of it passes on a pre-fix binary.
// It pins the positive half: the join really is `τ?`, so the null arrives and is observable,
// and the non-null joins beside it did not move. The refusals are what changed, and they live
// in `1103b-a-nullable-branch-arm-refused.loft`, where six `@EXPECT_ERROR`s go unmatched on a
// control binary built at `9c1a0e4e`. Neither half implies the other.

struct Box1103 { n: integer }

fn maybe1103(k: integer) -> integer? { if k > 5 { 7 } else { null } }
fn maybe_text1103(k: integer) -> text? { if k > 5 { "a" } else { null } }

// ---- the join is nullable, so a nullable destination is legal and silent ----

// Each cell declares `integer?`, which is what the rules say the author must write. That is the
// positive half of the fix: the join really is `integer?`, so the null ARRIVES and is
// observable, rather than being a diagnostic with nothing behind it.
fn else_arm(k: integer) -> integer? { x: integer? = if k == 9 { 1 } else { maybe1103(k) }; x }
fn then_arm(k: integer) -> integer? { x: integer? = if k == 9 { maybe1103(k) } else { 1 }; x }
fn chain_arm(k: integer) -> integer? {
  x: integer? = if k == 9 { 1 } else if k == 8 { 2 } else { maybe1103(k) };
  x
}
fn match_later(k: integer) -> integer? { x: integer? = match k { 9 => { 1 }, _ => { maybe1103(k) } }; x }
fn match_first(k: integer) -> integer? { x: integer? = match k { 9 => { maybe1103(k) }, _ => { 1 } }; x }
fn index_arm(k: integer, v: vector<integer>) -> integer? { x: integer? = if k == 9 { 1 } else { v[k] }; x }
fn text_arm(k: integer) -> text? { x: text? = if k == 9 { "a" } else { maybe_text1103(k) }; x }

// The reported shape. Before the fix this same body with a NON-NULL declaration compiled and
// answered null; the declaration below is the one the rules require, and the value has to
// survive it.
fn test_a_nullable_else_arm_makes_the_join_nullable() {
  assert(else_arm(1) == null, "the else arm's null reaches the slot, got {else_arm(1) ?? -1}");
  assert(else_arm(9) == 1, "the then arm is untouched, got {else_arm(9) ?? -1}");
  assert(else_arm(7) == 7, "and the else arm's non-null value arrives, got {else_arm(7) ?? -1}");
}

// The THEN arm was always joined correctly — `merge_dependencies` keeps the first arm's shape,
// and the first arm is the then arm. It is the control that says this fix is about WHICH arm,
// not about branches.
fn test_a_nullable_then_arm_still_works() {
  assert(then_arm(9) == 7, "k=9 takes the nullable arm, maybe(9) is 7, got {then_arm(9) ?? -1}");
  assert(then_arm(1) == 1, "the else arm's literal, got {then_arm(1) ?? -1}");
}

// `else if` and `match` are the same nesting, and both were silent for the same reason: an
// `else if` CHAIN keeps its shape out of the join deliberately, so only what it BORROWED was
// read, never whether it was nullable.
fn test_an_else_if_chain_arm_counts_as_an_arm() {
  assert(chain_arm(1) == null, "the chain's last arm is nullable, got {chain_arm(1) ?? -1}");
  assert(chain_arm(9) == 1, "the first arm, got {chain_arm(9) ?? -1}");
  assert(chain_arm(8) == 2, "the middle arm, got {chain_arm(8) ?? -1}");
}

fn test_a_later_match_arm_counts_as_an_arm() {
  assert(match_later(1) == null, "the wildcard arm is nullable, got {match_later(1) ?? -1}");
  assert(match_later(9) == 1, "the literal arm, got {match_later(9) ?? -1}");
}

// The FIRST match arm was already joined — the mirror of the then-arm control.
fn test_a_first_match_arm_still_works() {
  assert(match_first(9) == 7, "maybe(9) is 7, got {match_first(9) ?? -1}");
  assert(match_first(1) == 1, "the wildcard's literal, got {match_first(1) ?? -1}");
}

// A nullable arm need not be a CALL: an out-of-range index read is `integer?` too, and it was
// silent in exactly the same position.
fn test_an_index_read_arm_counts_as_an_arm() {
  assert(index_arm(4, [5]) == null, "an out-of-range read is nullable, got {index_arm(4, [5]) ?? -1}");
  assert(index_arm(9, [5]) == 1, "the then arm, got {index_arm(9, [5]) ?? -1}");
}

// A heap element type, to show the join is not a scalar special case.
fn test_a_text_arm_joins_nullable_too() {
  assert(text_arm(1) == null, "the else arm's null reaches the slot");
  assert(text_arm(9) == "a", "the then arm, got {text_arm(9) ?? "N"}");
}

// ---- controls: joins that must NOT become nullable ----

// Neither arm is nullable, so the join is not. This is the cell that fails if the widening is
// applied unconditionally, and it is most of the language.
fn plain(k: integer) -> integer { x: integer = if k == 9 { 1 } else { 2 }; x }

fn test_a_join_of_two_non_null_arms_stays_non_null() {
  assert(plain(9) == 1, "the then arm, got {plain(9)}");
  assert(plain(1) == 2, "the else arm, got {plain(1)}");
}

fn plain_match(k: integer) -> integer { x: integer = match k { 9 => { 1 }, 8 => { 2 }, _ => { 3 } }; x }

fn test_a_match_of_non_null_arms_stays_non_null() {
  assert(plain_match(9) == 1, "first arm, got {plain_match(9)}");
  assert(plain_match(8) == 2, "middle arm, got {plain_match(8)}");
  assert(plain_match(1) == 3, "wildcard, got {plain_match(1)}");
}

// A discharged arm is not a nullable arm: `??` is the cure the diagnostic names, so it has to
// leave the join non-null or the advice would be wrong.
fn discharged(k: integer) -> integer { x: integer = if k == 9 { 1 } else { maybe1103(k) ?? 0 }; x }

fn test_a_discharged_arm_leaves_the_join_non_null() {
  assert(discharged(1) == 0, "the discharge supplies the default, got {discharged(1)}");
  assert(discharged(7) == 7, "and passes a real value through, got {discharged(7)}");
  assert(discharged(9) == 1, "the then arm, got {discharged(9)}");
}

// A branch used as a STATEMENT rather than a value: nothing is stored, so nothing joins.
fn test_a_statement_branch_is_untouched() {
  t = 0;
  for i in 0..3 { if i == 1 { t += 10; } else { t += 1; } }
  assert(t == 12, "one then and two elses, got {t}");
}
