//
// `e#remove` in a loop removes exactly ONE element, frees what it owned, and takes
// it out of every member of a linked collection group.
//
// `#remove` reaches an element by POSITION, which is the half of removal nothing
// owned. loft#900 gave the by-RECORD form (`coll[key] = null`) an owner; the cursor
// form kept its own arithmetic and was wrong five ways, all identical on
// `--interpret`, `--native` and the published 2026.8.0:
//
//   * over an `array<T>` it removed TWO elements — `OpRemove` was handed the
//     ELEMENT's width where a record-backed container's slots are four bytes, so it
//     shifted a span several slots long — and never freed the record a slot names.
//     A `vector<T>` BECOMES an `array<T>` as soon as any keyed collection over `T`
//     exists ANYWHERE in the program, so whether this loop worked depended on a
//     declaration in another struct entirely (rows a3, a4, a11);
//   * inside a group it maintained no other member, leaving a sibling naming a
//     freed record — the use-after-free loft#900 fixed for the other spelling
//     (rows a5, a6, a7, a9);
//   * a `rev()` loop over a plain `vector` rewound the cursor FORWARD, because the
//     vector branch never put the reverse bit in `on`, so the loop skipped the next
//     element (row a2);
//   * a `rev()` loop over an inline `sorted` rewound one too far the other way and
//     REVISITED the element that shifted down (row a8);
//   * over an `ordered` the interpreter removed and the native backend removed
//     NOTHING at all — `OpRemove` had no arm for it (row a7).
//
// The fix puts the layout question in one place: `Stores::remove_vector_at` reads
// the element type's `linked` flag and answers both "how wide is a slot" and
// "is there a record to free", so the two spellings that remove by index —
// `e#remove` and `v.remove(i)` — cannot disagree. The group half mirrors
// loft#900: each OTHER member unlinks first, the spelled member goes last and
// frees. The record it needs is the LOOP VARIABLE, which is already the element
// at its payload start for every kind a group can hold.
//
// ONE ELEMENT TYPE PER ROW, deliberately. The `vector`→`array` promotion is
// program-wide, so a single `hash<E[k]>` anywhere would turn every `vector<E>` row
// in this file into an `array<E>` row and the inline rows would stop testing the
// inline path — the failure mode that made loft#901's first guard print a false
// green (see 901-linked-group-fill.loft).
//
// NOT covered here, and pinned as absent rather than left ambiguous: `rev()` over
// an `ordered` collection iterates FORWARDS (loft#904, pre-existing and separate —
// its stepper has no backwards half), so row a7 reads in forward order.

struct E1 { k: integer, n: text }
struct E2 { k: integer, n: text }
struct E3 { k: integer, n: text }
struct E4 { k: integer, n: text }
struct E5 { k: integer, n: text }
struct E6 { k: integer, n: text }
struct E7 { k: integer, n: text }
struct E8 { k: integer, n: text }
struct E9 { k: integer, n: text }
struct E10 { k: integer, n: text }
struct E11 { k: integer, n: text }
struct E12 { k: integer, n: text }
struct E13 { k: integer, n: text }

struct Inline1 { v: vector<E1> }
struct Inline2 { v: vector<E2> }

// The keyed collection that forces `E3`/`E4`/`E11` to be record-backed lives in its
// OWN struct, so those vectors become arrays WITHOUT joining a group: the slot width
// and the record free are the whole story, with no sibling to maintain.
struct Arr3 { v: vector<E3> }
struct Force3 { h: hash<E3[k]> }
struct Arr4 { v: vector<E4> }
struct Force4 { h: hash<E4[k]> }
struct Arr11 { v: vector<E11> }
struct Force11 { h: hash<E11[k]> }

struct GroupVH { v: vector<E5>, by_k: hash<E5[k]> }
struct GroupIH { idx: index<E6[k]>, by_k: hash<E6[k]> }
struct GroupSH { ord: sorted<E7[k]>, by_k: hash<E7[k]> }
struct Sorted8 { s: sorted<E8[k]> }
struct Trio { v: vector<E9>, by_k: hash<E9[k]>, idx: index<E9[k]> }
struct Arr10 { v: vector<E10> }
struct Force10 { h: hash<E10[k]> }
struct Inline12 { v: vector<E12> }
struct Arr13 { v: vector<E13> }
struct Force13 { h: hash<E13[k]> }

// The rows are grouped by what they pin rather than run from one body: `main` with
// all of them scores past the function-complexity nudge, and a guard file should not
// print advice of its own.
fn inline_rows() {
  // ---- a1: inline vector, remove the middle element ----------------------------
  // The shape that always worked; it is here so a fix that routed everything
  // through the record-backed path would fail loudly rather than leak quietly.
  a1 = Inline1 { v: [] };
  a1.v = [E1{k:1,n:"alpha"}, E1{k:2,n:"beta"}, E1{k:3,n:"gamma"}];
  for e1 in a1.v { if e1.k == 2 { e1#remove; } }
  s1 = ""; for e1 in a1.v { s1 += "{e1.k}:{e1.n} "; }
  assert(len(a1.v) == 2, "a1 len = {len(a1.v)}, want 2");
  assert(s1 == "1:alpha 3:gamma ", "a1 holds [{s1}], want [1:alpha 3:gamma ]");

  // ---- a2: inline vector under rev() — the cursor must not skip -----------------
  // `on` carried no reverse bit for this loop, so the rewind stepped the cursor the
  // FORWARD way and the walk jumped over the next element: `rev()` + remove-all left
  // one element behind, and removing one element skipped the one below it.
  a2 = Inline2 { v: [] };
  a2.v = [E2{k:1,n:"alpha"}, E2{k:2,n:"beta"}, E2{k:3,n:"gamma"}];
  seen2 = "";
  for e2 in rev(a2.v) { seen2 += "{e2.k}"; e2#remove; }
  assert(seen2 == "321", "a2 visited [{seen2}], want [321]");
  assert(len(a2.v) == 0, "a2 len = {len(a2.v)}, want 0");

  // ---- a8: inline sorted under rev() — the cursor must not revisit ---------------
  // The rewind went one PAST the removed slot, so the next step landed back on the
  // element that had shifted down into it: `3231` instead of `321`.
  a8 = Sorted8 { s: [] };
  a8.s = [E8{k:1,n:"alpha"}, E8{k:2,n:"beta"}, E8{k:3,n:"gamma"}];
  seen8 = "";
  for e8 in rev(a8.s) { seen8 += "{e8.k}"; if e8.k == 2 { e8#remove; } }
  assert(seen8 == "321", "a8 visited [{seen8}], want [321]");
  s8 = ""; for e8 in a8.s { s8 += "{e8.k}:{e8.n} "; }
  assert(s8 == "1:alpha 3:gamma ", "a8 holds [{s8}], want [1:alpha 3:gamma ]");

  // ---- a12: `v.remove(i)` over an INLINE vector — the control --------------------
  // `OpRemoveVector`'s operand changed from a width to a type; this row is what says
  // the inline case still reads it correctly.
  a12 = Inline12 { v: [] };
  a12.v = [E12{k:1,n:"alpha"}, E12{k:2,n:"beta"}, E12{k:3,n:"gamma"}];
  a12.v.remove(0);
  s12 = ""; for e12 in a12.v { s12 += "{e12.k}:{e12.n} "; }
  assert(len(a12.v) == 2, "a12 len = {len(a12.v)}, want 2");
  assert(s12 == "2:beta 3:gamma ", "a12 holds [{s12}], want [2:beta 3:gamma ]");

  // ---- b1: a base-typed vector — no records, no claims, still one element --------
  b1 = [10, 20, 30];
  for n1 in b1 { if n1 == 20 { n1#remove; } }
  sb1 = ""; for n1 in b1 { sb1 += "{n1} "; }
  assert(len(b1) == 2, "b1 len = {len(b1)}, want 2");
  assert(sb1 == "10 30 ", "b1 holds [{sb1}], want [10 30 ]");
}

/// The record-backed (`array`) rows: a slot is four bytes and names a record of its
/// own, with no group around it.
fn array_rows() {
  // ---- a3: array (record-backed, NOT grouped) — one element, and the record goes -
  // The filed shape: `struct Force3` alone made `Arr3.v` an array, and `#remove`
  // then removed the named element AND its successor.
  a3 = Arr3 { v: [] };
  a3.v = [E3{k:1,n:"alpha"}, E3{k:2,n:"beta"}, E3{k:3,n:"gamma"}];
  for e3 in a3.v { if e3.k == 2 { e3#remove; } }
  s3 = ""; for e3 in a3.v { s3 += "{e3.k}:{e3.n} "; }
  assert(len(a3.v) == 2, "a3 len = {len(a3.v)}, want 2");
  assert(s3 == "1:alpha 3:gamma ", "a3 holds [{s3}], want [1:alpha 3:gamma ]");

  // ---- a4: array, remove the FIRST element -------------------------------------
  // Removing at slot 0 shifted the whole vector by an element width, so BOTH
  // survivors read back as `null:null` — a wrong length over unreadable bytes.
  a4 = Arr4 { v: [] };
  a4.v = [E4{k:1,n:"alpha"}, E4{k:2,n:"beta"}, E4{k:3,n:"gamma"}];
  for e4 in a4.v { if e4.k == 1 { e4#remove; } }
  s4 = ""; for e4 in a4.v { s4 += "{e4.k}:{e4.n} "; }
  assert(len(a4.v) == 2, "a4 len = {len(a4.v)}, want 2");
  assert(s4 == "2:beta 3:gamma ", "a4 holds [{s4}], want [2:beta 3:gamma ]");

  // ---- a11: `v.remove(i)` over an array — the other by-index spelling ------------
  // Same operand, same mistake: `OpRemoveVector` was handed the element's width too.
  a11 = Arr11 { v: [] };
  a11.v = [E11{k:1,n:"alpha"}, E11{k:2,n:"beta"}, E11{k:3,n:"gamma"}];
  a11.v.remove(1);
  s11 = ""; for e11 in a11.v { s11 += "{e11.k}:{e11.n} "; }
  assert(len(a11.v) == 2, "a11 len = {len(a11.v)}, want 2");
  assert(s11 == "1:alpha 3:gamma ", "a11 holds [{s11}], want [1:alpha 3:gamma ]");

  // ---- a13: the walk continues over the survivors --------------------------------
  // An array loop visited `1`, then twice read the slot the over-long shift had
  // wrecked; the cursor has to land on the successor, once.
  a13 = Arr13 { v: [] };
  a13.v = [E13{k:1,n:"alpha"}, E13{k:2,n:"beta"}, E13{k:3,n:"gamma"}];
  seen13 = "";
  for e13 in a13.v { seen13 += "{e13.k}"; if e13.k == 2 { e13#remove; } }
  assert(seen13 == "123", "a13 visited [{seen13}], want [123]");
  s13 = ""; for e13 in a13.v { s13 += "{e13.k}:{e13.n} "; }
  assert(s13 == "1:alpha 3:gamma ", "a13 holds [{s13}], want [1:alpha 3:gamma ]");

  // ---- a10: drain an array entry by entry, then refill ---------------------------
  // The reuse path. Nothing freed the record a slot named, so a long-lived
  // collection grew without bound while its length stayed flat; and the two-at-a-time
  // removal made the drain loop's arithmetic run away entirely.
  a10 = Arr10 { v: [] };
  for r10 in 0..4 {
    a10.v += [E10{k:1,n:"alpha"}, E10{k:2,n:"beta"}, E10{k:3,n:"gamma"}];
    assert(len(a10.v) == 3, "a10 round {r10}: filled to {len(a10.v)}, want 3");
    for e10 in a10.v { e10#remove; }
    assert(len(a10.v) == 0, "a10 round {r10}: drained to {len(a10.v)}, want 0");
  }
  a10.v += [E10{k:5,n:"epsilon"}];
  s10 = ""; for e10 in a10.v { s10 += "{e10.k}:{e10.n} "; }
  assert(s10 == "5:epsilon ", "a10 refill holds [{s10}], want [5:epsilon ]");
}

/// The linked-collection-group rows: a removal spelled through any member takes the
/// element out of every member, and frees its record exactly once.
fn group_rows() {
  // ---- a5: array primary in a group — the hash must lose it too -----------------
  a5 = GroupVH { v: [], by_k: [] };
  a5.v = [E5{k:1,n:"alpha"}, E5{k:2,n:"beta"}, E5{k:3,n:"gamma"}];
  for e5 in a5.v { if e5.k == 2 { e5#remove; } }
  assert(len(a5.v) == 2, "a5 primary len = {len(a5.v)}, want 2");
  assert(len(a5.by_k) == 2, "a5 view len = {len(a5.by_k)}, want 2");
  assert((a5.by_k[2] ?? E5{k:0,n:"MISS"}).n == "MISS", "a5: key 2 still in the hash");
  assert((a5.by_k[3] ?? E5{k:0,n:""}).n == "gamma", "a5: key 3 lost from the hash");
  k5 = 0; t5 = 0; for e5 in a5.by_k { k5 += e5.k; t5 += len(e5.n); }
  assert(k5 == 4, "a5 view keys sum {k5}, want 4");
  assert(t5 == 10, "a5 view text total {t5}, want 10 — a freed record reads short");

  // ---- a6: index primary in a group --------------------------------------------
  // The filed group case: the index removed and freed correctly, and the hash went
  // on naming the record that was gone — `4294967296:null` out of a live-looking view.
  a6 = GroupIH { idx: [], by_k: [] };
  a6.idx = [E6{k:1,n:"alpha"}, E6{k:2,n:"beta"}];
  for e6 in a6.idx { if e6.k == 1 { e6#remove; } }
  assert(len(a6.idx) == 1, "a6 primary len = {len(a6.idx)}, want 1");
  assert(len(a6.by_k) == 1, "a6 view len = {len(a6.by_k)}, want 1");
  k6 = 0; t6 = 0; for e6 in a6.by_k { k6 += e6.k; t6 += len(e6.n); }
  assert(k6 == 2, "a6 view keys sum {k6}, want 2");
  assert(t6 == 4, "a6 view text total {t6}, want 4");

  // ---- a7: ordered primary in a group ------------------------------------------
  // A `sorted` sharing records is laid out as an `ordered`, which `OpRemove` had no
  // arm for on the native backend: one spelling, two answers.
  a7 = GroupSH { ord: [], by_k: [] };
  a7.ord = [E7{k:1,n:"alpha"}, E7{k:2,n:"beta"}, E7{k:3,n:"gamma"}];
  for e7 in a7.ord { if e7.k == 3 { e7#remove; } }
  s7 = ""; for e7 in a7.ord { s7 += "{e7.k}:{e7.n} "; }
  assert(len(a7.ord) == 2, "a7 primary len = {len(a7.ord)}, want 2");
  assert(s7 == "1:alpha 2:beta ", "a7 holds [{s7}], want [1:alpha 2:beta ]");
  assert(len(a7.by_k) == 2, "a7 view len = {len(a7.by_k)}, want 2");
  assert((a7.by_k[3] ?? E7{k:0,n:"MISS"}).n == "MISS", "a7: key 3 still in the hash");

  // ---- a9: three members, one loop removal --------------------------------------
  a9 = Trio { v: [], by_k: [], idx: [] };
  a9.v = [E9{k:1,n:"alpha"}, E9{k:2,n:"beta"}, E9{k:3,n:"gamma"}];
  for e9 in a9.v { if e9.k == 2 { e9#remove; } }
  assert(len(a9.v) == 2, "a9 vector len = {len(a9.v)}, want 2");
  assert(len(a9.by_k) == 2, "a9 hash len = {len(a9.by_k)}, want 2");
  assert(len(a9.idx) == 2, "a9 index len = {len(a9.idx)}, want 2");
  s9 = ""; for e9 in a9.idx { s9 += "{e9.k}:{e9.n} "; }
  assert(s9 == "1:alpha 3:gamma ", "a9 index holds [{s9}], want [1:alpha 3:gamma ]");
}

fn main() {
  inline_rows();
  array_rows();
  group_rows();
  println("903 ok");
}
