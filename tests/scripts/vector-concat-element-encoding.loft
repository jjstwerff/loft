// Two vectors whose INTEGER elements are stored differently cannot be concatenated.
//
// `OpAppendVector` copies element BYTES: it is handed the destination's element type and
// never learns the source's, so it cannot re-encode.  `u8` and `integer` are both
// "integer" to the type checker, so `vector<u8> + vector<integer>` type-checked and then
// copied 8-byte elements into 1-byte slots — `[1,250] + [7,8]` answered `[1,250,7,0]` —
// and `vector<u8> + vector<i8>` answered `[1,250,123,133]` for `[-5,5]`, because the two
// encodings offset their values differently.  Nothing reported either.
//
// The refusal follows the scalar rule: formal/types.md (I-Narrow) makes a narrowing
// explicit, and a mixed concat narrows in one direction or the other at every element.
// What must keep working is everything the type checker already got right.
fn make() -> vector<integer> { [7, 8] }

fn main() {
  // A literal append into a narrow vector — the literal is built in the destination's
  // own encoding, so there is nothing to convert.
  u: vector<u8> = [1, 250];
  u += [9];
  assert("{u}" == "[1,250,9]", "literal append into a narrow vector");

  // Concatenation with a literal, and with a call returning the same element type.
  a = u + [3];
  assert("{a}" == "[1,250,9,3]", "concat with a literal");
  w: vector<integer> = [7, 8];
  b = w + make();
  assert("{b}" == "[7,8,7,8]", "concat with a call of the same element type");

  // Two vectors of one narrow type share an encoding, so the byte copy is exact.
  c = u + u;
  assert("{c}" == "[1,250,9,1,250,9]", "concat of one narrow type");

  // The ranged spelling of one range, twice — same encoding, same answer.
  r1: vector<integer limit(10,255)> = [12, 200];
  r2: vector<integer limit(10,255)> = [10];
  d = r1 + r2;
  assert("{d}" == "[12,200,10]", "concat of one ranged type");

  // Element-by-element is the cure the refusal names, and it converts.  A narrowing step
  // takes the checked cast loft asks for everywhere else (`as u8?`), which is the point:
  // the concat hid a narrowing the language makes you write down.
  e: vector<u8> = [];
  for x in w { e += [(x as u8?) ?? 0]; }
  assert("{e}" == "[7,8]", "element-by-element append converts");
}
