// Probe 49 — Critical-severity reproducer: SIGBUS on method-after-`??`
//
// Probe 46 crashed with SIGBUS at opcode 220 (or "none — crash outside
// interpreter" on re-run, suggesting the crash is in bytecode dispatch
// or post-dispatch cleanup, NOT in a deterministic opcode handler).
//
// This probe is the smallest variant of probe 46 — only the essential
// shape `(<ncc-block>).method_call()`.  Used as the minimum reproducer
// for cluster-I-crash mode in any future bisect / instrumentation work.
//
// SIGBUS is consistent with reading a dangling pointer aligned to a
// boundary that gets unmapped (or read from a guard page).  Distinct
// from cluster I's silent NUL/garbage corruption — it's a HARD crash.
//
// Pairing: 46 (parent, same shape but with two assertions).
// Status: critical-severity SIGBUS probe.  Run with LOFT_LOG=crash_tail:30
// to capture the last opcode before signal.

struct H { items: vector<text> }

fn main() {
  h = H { items: [] };
  h.items += ["hello"];
  // SIGBUS: method dispatch reads dangling Str's ptr from stack
  a = (h.items[0] ?? "x").to_uppercase();
  println("probe 49 reached assert (a='{a}')");
  assert(a == "HELLO", "probe 49: got '{a}', want 'HELLO'");
  println("probe 49 PASSED");
}
