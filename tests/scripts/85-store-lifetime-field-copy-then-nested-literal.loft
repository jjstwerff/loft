//
// @PLN85 A.1 substrate — regression guard for the store-reuse / nested-literal
// corruption (#426).  A borrowing-read field COPY (`af = bx.v`, the #415
// mechanism) is materialised only on the SECOND parser pass, where it consumed
// one `elm`-name slot (`unique("elm")`) that the FIRST pass never consumed.
// `Function::unique`'s per-prefix counter must advance identically on both
// passes; the one-slot drift renamed every later `_elm_N`, so a subsequent
// NESTED vector literal `[[…]]` built its inner element into an ORPHANED store
// (the dep that pass 1 set on the old `_elm` name was lost on pass 2's new
// name) and read back length 0.  Both backends; only depth >= 2 literals after
// the copy were hit (a plain `[…]` carries no inner element to orphan).
//
// Fix: the field-read copy strips `af`'s inherited dep AND advances the `elm`
// counter on BOTH passes (emitting IR only on pass 2), keeping the later
// literal's `_elm_N` stable across passes.  The var-copy case (`b = a`) is
// untouched.
//
// Before the fix: `a0.len` and the 3-deep tail both read 0.  Verified RED on
// both backends; GREEN after.

struct Box {
  v: vector<integer>,
}

fn main() {
  // The minimal shape: a borrowing-read copy, then a 2-deep nested literal.
  bx = Box { v: [1, 2, 3] };
  af = bx.v; // #415 borrowing-read copy
  a: vector<vector<integer>> = [[7, 8]]; // inner element must survive
  assert(len(af) == 3, "borrowing-read copy stays length 3");
  assert(len(a[0]) == 2, "nested literal inner element must be [7,8] (was orphaned -> len 0)");

  // The original 3-deep repro: the copy frees its source, the freed store is
  // recycled, and a 3-deep build into it corrupted the innermost vector.
  vvv: vector<vector<vector<integer>>> = [];
  b: vector<vector<integer>> = [[9, 10]];
  vvv += [b];
  assert(len(vvv[0][0]) == 2, "3-deep nested build after a copy must be [9,10] (was len 0)");

  // The copy itself stays independent of its source (the #415 value-semantics
  // guarantee the substrate fix must not disturb).
  bx.v += [4];
  assert(len(af) == 3, "af is an independent copy, not an alias of bx.v");
}
