// @PLN25 F2 — `not null` is retired: a type is non-null by default, so the
// annotation is a no-op and every use gets a deprecation warning. It still
// PARSES (accepted no-op) so not-yet-republished libraries keep loading; the
// warning drives the gate attrition toward the eventual hard "retired" error.
// Verifies the warning fires in every position AND the code still runs.
// @EXPECT_WARNING: `not null` is deprecated
struct S {
  a: integer not null,
  b: text not null,
}
fn ret() -> integer not null {
  7
}
struct Narrow {
  p: integer limit(0, 255) not null,
}
fn main() {
  s: S = S { a: 1, b: "x" };
  n: Narrow = Narrow { p: 255 };
  assert(s.a == 1, "field a");
  assert(s.b == "x", "field b");
  assert(ret() == 7, "return");
  assert(n.p == 255, "narrow not null keeps full range");
}
