//
// loft#1066 — a monomorph that returns a store its OWN body allocated must hand that
// store to somebody.  Used inline, nobody took it: one leaked record per call.
//
// A generic template declares `-> T`, and a bare type annotation carries no dep, so
// substitution gives every monomorph of it the SAME empty return dep whatever its body
// does.  `f<T>(x: T) -> T { x }` (which borrows the argument) and
// `f<T>(x: T) -> T { y: T = x; y }` (which copies it) are therefore indistinguishable to
// the dep-based ownership test, and the caller-side lift was gated on the `__retbuf`
// parameter instead — which a monomorph, built by IR substitution rather than by
// signature finalization, never has.  So the lift never fired and the store was orphaned.
//
// The cure reads the BODY: `Definition::monomorph_return_is_fresh`.  It is a positive
// proof and an under-approximation on purpose — a tail it cannot read answers "not
// proven", which costs a leak, where a wrong "proven" would free a store the caller still
// names.  The first cell below is that hazard, and it is the reason this cannot simply
// lift every monomorph.
//
// Every cell asserts the VALUE too.  The leak channel alone would rank a monomorph that
// returned nothing as the best cell in the file.
//
// The filed report scoped this to "a `T = struct` return taken from a template-LOCAL
// vector".  The vector is not the axis — `{ y: T = x; y }` has no vector and leaked
// identically — so the cells sweep the source of the owned store rather than one spelling
// of it.
//
// A value-yielding `if` tail is covered too, but was NOT at first: an arm-local of a
// monomorph used to be built against the type variable's row and answer a wrong number, so
// classifying arms would have been building on sand.  With loft#1070 fixed the arms are
// ordinary owned locals and the proof walks them — requiring EVERY arm to be fresh, so one
// borrowing arm still refuses the whole site.  A MIXED-arm return (one arm the argument,
// one a fresh local) therefore stays unlifted and keeps leaking on the owning path: the
// callee hands back one value and the caller either frees it or does not, so a per-arm
// answer is not expressible at the call site.  The leak is the safe side of that, and the
// last cell pins it as the deliberate limit rather than an oversight.

struct S1066 { a: integer }
struct T1066 { a: integer, b: text }

// The hazard the proof must keep refusing: the return IS the argument, so lifting it
// would free a store the caller still owns.
pub fn borrow1066<T>(x: T) -> T { x }

// The filed shape: the store comes out of a template-LOCAL vector.
pub fn via_vector1066<T>(x: T) -> T { o: vector<T> = []; o += [x]; o[0] }

// The same fact with no vector at all — the cell that showed the filed scope was wrong.
pub fn via_local1066<T>(x: T) -> T { y: T = x; y }

// An explicit `return` rather than a tail: both are return sites and both must classify.
pub fn via_return1066<T>(x: T) -> T { y: T = x; return y }

// An element of a PARAMETER vector — rooted at an argument, so NOT proven fresh. It must
// keep working and keep not leaking, which is what says the proof did not over-reach.
pub fn via_param_vector1066<T>(v: vector<T>, x: T) -> T { v += [x]; v[1] }

// A value-yielding `if` tail whose arms are BOTH fresh locals (loft#1070 made this
// classifiable), and one whose arms disagree — the deliberate limit.
pub fn via_arms1066<T>(x: T, c: boolean) -> T { if c { y: T = x; y } else { z: T = x; z } }
pub fn via_mixed1066<T>(x: T, c: boolean) -> T { if c { x } else { w: T = x; w } }

fn test_a_borrowed_return_is_not_lifted() {
  // If this were lifted, the caller would free `v`'s store and the second read would
  // dangle. The value AFTER the call is the assertion that matters.
  v = S1066 { a: -11 };
  assert(borrow1066(v).a == -11, "borrowed return, inline: got {borrow1066(v).a}");
  assert(v.a == -11, "the argument survives the call: got {v.a}");
}

fn test_an_owned_return_from_a_local_vector() {
  assert(via_vector1066(S1066 { a: -77 }).a == -77, "via a local vector: got {via_vector1066(S1066 { a: -77 }).a}");
}

fn test_an_owned_return_from_a_plain_local() {
  assert(via_local1066(S1066 { a: -78 }).a == -78, "via a plain local: got {via_local1066(S1066 { a: -78 }).a}");
}

fn test_an_owned_return_through_an_explicit_return() {
  assert(via_return1066(S1066 { a: -79 }).a == -79, "via an explicit return: got {via_return1066(S1066 { a: -79 }).a}");
}

fn test_an_element_of_a_parameter_vector_still_works() {
  w: vector<S1066> = [S1066 { a: -1 }];
  assert(via_param_vector1066(w, S1066 { a: -80 }).a == -80, "element of a param vector: got {via_param_vector1066(w, S1066 { a: -80 }).a}");
}

fn test_a_struct_carrying_a_text_field() {
  // A text field makes the copied record own a second allocation, so a half-done lift
  // shows here and not in the integer-only cells.
  r = via_local1066(T1066 { a: -81, b: "carried" });
  assert(r.a == -81, "text-carrying struct, integer field: got {r.a}");
  assert(r.b == "carried", "text-carrying struct, text field: got {r.b}");
}

fn test_repeated_inline_calls_do_not_accumulate() {
  // Three calls leaked THREE stores before the fix — the leak scaled with call count,
  // which is what makes it a loop hazard rather than a one-off.
  t = 0;
  i = 0;
  while i < 3 { t += via_local1066(S1066 { a: i + 1 }).a; i += 1 }
  assert(t == 6, "three inline calls in a loop: got {t}");
}

fn test_two_instantiations_of_one_template() {
  // Each monomorph is classified on its own body; one T must not decide for another.
  assert(via_local1066(S1066 { a: -82 }).a == -82, "instantiation S: got {via_local1066(S1066 { a: -82 }).a}");
  assert(via_local1066(T1066 { a: -83, b: "x" }).a == -83, "instantiation T: got {via_local1066(T1066 { a: -83, b: "x" }).a}");
}

fn test_an_owned_return_through_if_arms() {
  // Both arms declare their own local, so both are fresh and the site is lifted.
  assert(via_arms1066(S1066 { a: -84 }, true).a == -84, "the taken arm: got {via_arms1066(S1066 { a: -84 }, true).a}");
  assert(via_arms1066(S1066 { a: -85 }, false).a == -85, "the other arm: got {via_arms1066(S1066 { a: -85 }, false).a}");
}

fn test_a_mixed_arm_return_is_refused_and_still_correct() {
  // One arm returns the ARGUMENT and one a fresh local, so the site is not proven fresh
  // and nothing is lifted.  The VALUES must still be right on both paths, and the
  // borrowed one must survive — that is what this cell guards.
  //
  // Both results are BOUND rather than used inline, and that is the point rather than a
  // convenience: binding is what gives the owning arm's store an owner.  Used inline it
  // would leak, which is the deliberate limit — the callee hands back ONE value and the
  // caller either frees it or does not, so a per-arm answer is not expressible at the call
  // site, and refusing is the safe half of that.  Leaking here would also weaken the leak
  // gate for the other ten cells, which is the stronger guard.
  v = S1066 { a: -86 };
  borrowed = via_mixed1066(v, true);
  assert(borrowed.a == -86, "the borrowing arm: got {borrowed.a}");
  owned = via_mixed1066(v, false);
  assert(owned.a == -86, "the owning arm: got {owned.a}");
  assert(v.a == -86, "the argument survives both: got {v.a}");
}

fn main() {
  test_a_borrowed_return_is_not_lifted();
  test_an_owned_return_from_a_local_vector();
  test_an_owned_return_from_a_plain_local();
  test_an_owned_return_through_an_explicit_return();
  test_an_element_of_a_parameter_vector_still_works();
  test_a_struct_carrying_a_text_field();
  test_repeated_inline_calls_do_not_accumulate();
  test_two_instantiations_of_one_template();
  test_an_owned_return_through_if_arms();
  test_a_mixed_arm_return_is_refused_and_still_correct();
}
