//
// @PLN87 / loft#506 — a whole-binding `&`-WRITE-BACK reaches the caller's argument lvalue
// for a COMPUTED lvalue too (vector element `items[i]`, struct field `s.f`), not only a
// simple local.  The caller lowers the write-back's new record back into the source's
// existing store (scopes.rs::amp_writeback_storeback → OpCopyRecord with the free-source
// bit): leak-clean, both backends.  A field-mutation callee is left untouched (no store-back).
struct Item { px: integer }
struct Box { it: Item }

fn setback(item: &Item, val: integer) { item = Item { px: val }; }   // whole-binding write-back
fn bump(item: &Item, val: integer) { item.px = val; }                // field mutation (no write-back)

fn main() {
    items: vector<Item> = [Item { px: 0 }, Item { px: 5 }];

    // WRITE-BACK to a VECTOR ELEMENT reaches the caller (was silently dropped, loft#506).
    setback(items[1], 42);
    assert(items[1].px == 42, "element write-back reaches items[1]");
    assert(items[0].px == 0,  "element write-back left items[0] alone");

    // FIELD MUTATION through a `&`-computed-arg still works (P160), unchanged.
    bump(items[0], 9);
    assert(items[0].px == 9, "field mutation via & propagates");

    // WRITE-BACK to a STRUCT FIELD reaches the caller.
    b = Box { it: Item { px: 0 } };
    setback(b.it, 7);
    assert(b.it.px == 7, "field write-back reaches b.it");

    println("87-amp-element-writeback ok");
}
