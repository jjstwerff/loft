//
// @PLN87 / loft#506 — a whole-binding `&`-WRITE-BACK reaches the caller's argument lvalue for a
// COMPUTED lvalue too (vector element `items[i]`, struct field `s.f`), not only a simple local.
// The caller captures the element into a FRESH OWNED temp (so the callee's write-back frees the
// COPY, never the caller's element record — that record is the stable backing), passes the temp
// (the working local-var path), and copies the result back after the call
// (scopes.rs::amp_writeback_owned_copy).  REPEAT-safe and leak-clean, both backends.  A
// field-mutation callee is left untouched (P160).
struct Item { px: integer, tag: integer }
struct Box { it: Item }

fn setback(item: &Item, val: integer) { item = Item { px: val, tag: item.tag }; }  // write-back, READS old tag
fn bump(item: &Item, val: integer) { item.px = val; }                              // field mutation (no write-back)
fn setback_n(item: &Item, val: integer) -> integer { item = Item { px: val, tag: item.tag }; val * 2 }

fn main() {
    items: vector<Item> = [Item { px: 0, tag: 1 }, Item { px: 5, tag: 99 }];

    // element WRITE-BACK reaches the caller AND preserves a read-old field (was silently dropped).
    setback(items[1], 42);
    assert(items[1].px == 42 && items[1].tag == 99, "element write-back + read-old-field");
    assert(items[0].px == 0, "element write-back left items[0] alone");

    // REPEATED write-back to the SAME element must not corrupt (the revert-caught bug).
    setback(items[1], 7);
    assert(items[1].px == 7 && items[1].tag == 99, "repeated element write-back stays sound");

    // NON-void write-back: result used AND element updated.
    got = setback_n(items[1], 3);
    assert(got == 6 && items[1].px == 3, "non-void write-back: result + element");

    // FIELD MUTATION via a `&`-computed-arg still works (P160), unchanged.
    bump(items[0], 9);
    assert(items[0].px == 9, "field mutation via & propagates");

    // WRITE-BACK to a STRUCT FIELD reaches the caller.
    b = Box { it: Item { px: 0, tag: 4 } };
    setback(b.it, 8);
    assert(b.it.px == 8 && b.it.tag == 4, "field write-back reaches b.it");

    // LOOP: repeated write-back across all elements, leak-safe.
    v: vector<Item> = [Item { px: 0, tag: 0 }, Item { px: 0, tag: 0 }];
    for round in 0..4 { for i in 0..2 { setback(v[i], round + i); } }
    assert(v[0].px == 3 && v[1].px == 4, "loop write-back sound");

    println("87-amp-element-writeback ok");
}
