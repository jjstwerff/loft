//
// @PLN22 Phase 1 — two enums may share a variant name (`Red` below).  Before
// this landed, defining the second enum panicked at parse ("Dual definition of
// Red").  Now the collision is legal: a bare variant VALUE resolves against the
// CONTEXT enum — match subject, typed-local decl, typed reassignment, `==` LHS,
// call argument, return type (incl. an `if`-branch tail), struct-field type and
// default, `is`, and an `Enum::`/`Enum.` qualifier.  A bare variant used to
// DEFINE a new untyped variable with NO context (`x = Red`) is a hard error
// even when the name is unique — see 102-expected-errors.loft.  The variant name
// stays usable as a TYPE/constructor (`Circle { … }`, `s: Circle`).
enum Light {
  Red,
  Green,
  Blue,
}
enum Berry {
  Red,
  Black,
}

fn lname(l: Light) -> text {
  match l { Red => "L-red", Green => "L-green", Blue => "L-blue", }
}
fn bname(b: Berry) -> text {
  match b { Red => "B-red", Black => "B-black", }
}

// bare variant in RETURN position (direct and via an if-branch tail).
fn make_light() -> Light {
  Red
}
fn grade(b: Berry) -> Berry {
  if b is Red { Black } else { Red }
}

// a mixed struct-enum: unit variant + struct variant sharing the enum.
enum Sig {
  Idle,
  On { level: integer },
}

// struct with a bare-variant field DEFAULT plus a sibling field whose bare-variant
// init resolves against its own field enum (the lib/logger `level: Level = Warning`
// shape).  `mode` defaults to a MIXED struct-enum UNIT variant (`Idle`) — its
// allocation must NOT clobber the explicitly-provided sibling `light` (regression
// for the field-default work-ref aliasing bug).
struct Cfg {
  mode: Sig = Idle,
  first: Light = Green,
  light: Light,
}

fn test_pln22_shared_variants() {
  // match arm + call argument: the SAME bare `Red` resolves by context enum.
  assert(lname(Light.Blue) == "L-blue", "match resolves Light");
  assert(bname(Red) == "B-red", "arg Red -> Berry::Red");
  assert(lname(Red) == "L-red", "arg Red -> Light::Red");

  // typed-local decl + typed reassignment.
  x: Light = Red;
  y: Berry = Black;
  y = Red;
  assert(x is Red, "typed-local x is Light::Red");
  assert(y is Red, "reassigned y is Berry::Red");

  // comparison RHS resolves by the LHS enum.
  a = Light.Green;
  c = Berry.Red;
  assert(!(a == Red), "a (Green) != Light::Red");
  assert(c == Red, "c == Berry::Red");

  // return position: direct and if-branch tail.
  assert(make_light() is Red, "direct return Red -> Light::Red");
  assert(grade(Berry.Red) is Black, "if-branch return resolves Berry");

  // mixed struct-enum unit variant in a typed context.
  s: Sig = Idle;
  assert(s is Idle, "mixed-enum unit variant typed init");

  // struct field defaults (mixed-enum `mode: Sig = Idle`, plain `first: Light =
  // Green`) + an explicit sibling init — the mixed default must not clobber it.
  cfg = Cfg { light: Red };
  assert(cfg.mode is Idle, "mixed-enum unit-variant field default");
  assert(cfg.first is Green, "plain-enum field default bare variant");
  assert(cfg.light is Red, "explicit sibling not clobbered by the mixed default");

  // qualified construction + qualified `==`, per enum (both `::` and `.`).
  assert(Light::Red == Light.Red, ":: and . qualified forms agree");
  assert(Berry::Red == Berry::Red, "Berry::Red == Berry::Red");
  assert(!(Light::Red == Light::Green), "Light::Red != Light::Green");
}
