//
// @P294 regression — the interpreter value stack (store #0) is
// allocated once at 1000 words / 8000 bytes and must grow on deep
// call nesting.  Before the fix, ~40 modest frames overflowed the
// buffer and silently corrupted the heap (the bounds check in
// Store::addr_mut is a debug_assert!, compiled out in the release
// library), aborting at program teardown.  Each frame here carries
// several locals incl. a text local, so the cumulative stack_pos
// crosses the old 8000-byte limit well before the recursion bottoms
// out.

// @FTR-079 — the runtime stack the execute loop drives: it GROWS on deep call nesting
// instead of running off the end of the frame it started with
fn sum_to(n: integer) -> integer {
  // Locals (incl. text) inflate the per-frame size so cumulative
  // stack_pos exceeds the old 1000-word buffer at modest depth.
  a = n;
  b = n * 2;
  c = n * 3;
  pad = "frame-{n}-padding-text";
  if n <= 0 { return 0; }
  rest = sum_to(n - 1);
  // pad.len() is constant per n only via the number's width; fold a
  // deterministic, pad-independent value so the assert is exact.
  a + rest + (b - b)+(c - c)
}

fn main() {
  // 250 deep × (3 ints + text + saved frame) easily passes 8000 bytes.
  total = sum_to(250);
  // sum_to(n) = n + (n-1) + ... + 1 = n*(n+1)/2.
  assert(total == 31375, "deep recursion sum (250*251/2) = {total}");
  println("117-deep-stack ok");
}
