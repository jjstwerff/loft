//
// Regression (loft#749) — a text slice whose end falls inside the string's LAST
// character walked off the end of the buffer and PANICKED the interpreter:
// "index out of bounds: the len is 5 but the index is 5", a Rust backtrace with
// no loft source location.
//
// `till` is snapped FORWARD past continuation bytes so a slice ends on a
// character boundary.  The loop tested its bound BEFORE the increment and then
// read the incremented index, so the one case where the snap runs to the very
// end of the buffer — a multi-byte character at the tail — read one past it.
//
// Two user-visible shapes, one cause:
//   * `s[i..s.len()]`, the obvious spelling of "from here to the end", on any
//     text with a multi-byte character (`len()` counts CHARACTERS, slice bounds
//     are BYTES, so the end lands mid-character and the snap runs to the tail).
//   * `split_text` when a multi-byte character follows the LAST separator —
//     position-dependent, so `"é\ncd"` split fine and `"ab\ncé"` aborted.
//
// `--native` has its own derivation of this slice (`OpGetTextSub` in
// src/codegen_runtime.rs) and was correct throughout, so every case below is a
// DIFFERENTIAL check: the two backends must agree, and each expected value is
// hand-computed from the documented rule rather than read off either binary.
//
// The rule, for the hand-computation:
//   `from` snaps BACKWARD to the start of its character; `till` snaps FORWARD to
//   the next character boundary; `till <= from` is empty; `from` outside the
//   text is empty; a `till` past the end clamps.  Both bounds are BYTE offsets —
//   `size()` is the byte count, `len()` the character count.
//
// The `s[i..s.len()]` cells below are written the way the report writes them, and
// they WARN: mixing a character count into a byte bound is advised against, and
// this file is also what proves that lint fires.  They must still produce the
// right answer — an advisory diagnostic never changes what a program computes,
// and every one of these slices ends inside the final character, where the
// forward snap lands on the same place `size()` would have named.
//
// @EXPECT_WARNING: a text slice ends at `len(text)` (a character count)

fn check_ascii_control() {
  // No multi-byte characters anywhere: bytes and characters coincide, so these
  // cells were correct before the fix and must stay put.
  x = "abcd";
  assert(size(x) == 4 && x.len() == 4, "ascii: size {size(x)} len {x.len()}");
  assert(x[0..3] == "abc", "ascii 0..3: {x[0..3]}");
  assert(x[1..4] == "bcd", "ascii 1..4: {x[1..4]}");
  assert(x[0..x.len()] == "abcd", "ascii 0..len: {x[0..x.len()]}");
  assert(x[2..2] == "", "ascii empty: {x[2..2]}");
}

fn check_trailing_two_byte() {
  // "abcé" — a=0 b=1 c=2, é=3..4.  The reported case: the tail is multi-byte.
  x = "abcé";
  assert(size(x) == 5 && x.len() == 4, "trailing: size {size(x)} len {x.len()}");
  assert(x[0..3] == "abc", "trailing 0..3: {x[0..3]}");
  // 4 is INSIDE é, so it snaps forward to 5 — this is the cell that panicked.
  assert(x[3..4] == "é", "trailing 3..4: {x[3..4]}");
  assert(x[3..5] == "é", "trailing 3..5: {x[3..5]}");
  assert(x[0..4] == "abcé", "trailing 0..4: {x[0..4]}");
  // `from` inside é snaps BACKWARD to 3.
  assert(x[4..5] == "é", "trailing 4..5: {x[4..5]}");
  // The spelling from the report: `s[i..s.len()]` with len() a character count.
  assert(x[3..x.len()] == "é", "trailing 3..len: {x[3..x.len()]}");
  assert(x[0..x.len()] == "abcé", "trailing 0..len: {x[0..x.len()]}");
  // Past the end clamps rather than faulting.
  assert(x[0..99] == "abcé", "trailing 0..99: {x[0..99]}");
  assert(x[3..3] == "", "trailing empty: {x[3..3]}");
}

fn check_leading_two_byte() {
  // "éabc" — é=0..1, a=2 b=3 c=4.  Multi-byte BEFORE the tail: this side always
  // worked, and it is the control that says the fix did not move it.
  y = "éabc";
  assert(size(y) == 5 && y.len() == 4, "leading: size {size(y)} len {y.len()}");
  assert(y[0..2] == "é", "leading 0..2: {y[0..2]}");
  assert(y[0..1] == "é", "leading 0..1: {y[0..1]}");
  assert(y[1..2] == "é", "leading 1..2: {y[1..2]}");
  assert(y[2..5] == "abc", "leading 2..5: {y[2..5]}");
}

fn check_three_and_four_byte() {
  // Widths beyond two bytes: the snap has to cross two and three continuations,
  // so a fix that only handled a single continuation byte fails here.
  z = "a中b";                       // a=0, 中=1..3, b=4
  assert(size(z) == 5 && z.len() == 3, "3byte: size {size(z)} len {z.len()}");
  assert(z[1..2] == "中", "3byte 1..2: {z[1..2]}");
  assert(z[1..4] == "中", "3byte 1..4: {z[1..4]}");
  assert(z[0..2] == "a中", "3byte 0..2: {z[0..2]}");
  assert(z[2..5] == "中b", "3byte 2..5: {z[2..5]}");
  assert(z[4..5] == "b", "3byte 4..5: {z[4..5]}");

  m = "中";                          // the whole text is one 3-byte character
  assert(size(m) == 3 && m.len() == 1, "lone: size {size(m)} len {m.len()}");
  assert(m[0..1] == "中", "lone 0..1: {m[0..1]}");
  assert(m[0..3] == "中", "lone 0..3: {m[0..3]}");
  assert(m[0..m.len()] == "中", "lone 0..len: {m[0..m.len()]}");

  w = "ab😀";                        // 😀 = 4 bytes at 2..5
  assert(size(w) == 6 && w.len() == 3, "4byte: size {size(w)} len {w.len()}");
  assert(w[2..3] == "😀", "4byte 2..3: {w[2..3]}");
  assert(w[2..6] == "😀", "4byte 2..6: {w[2..6]}");
  assert(w[0..3] == "ab😀", "4byte 0..3: {w[0..3]}");
  assert(w[0..w.len()] == "ab😀", "4byte 0..len: {w[0..w.len()]}");
}

fn check_single_index() {
  // `s[i]` is a different lowering (one `character`, no `till`); it must keep
  // agreeing with the two-bound form.  Compared through interpolation because
  // `character` and `text` have no `==` between them.
  x = "abcé";
  assert("{x[0]}" == "a", "single 0: {x[0]}");
  assert("{x[3]}" == "é", "single 3: {x[3]}");
  z = "a中b";
  assert("{z[1]}" == "中", "single 3byte: {z[1]}");
  assert("{z[4]}" == "b", "single after 3byte: {z[4]}");
}

fn check_split_text() {
  // Position-dependent before the fix: a multi-byte character AFTER the last
  // separator aborted, one BEFORE it did not.  Contents are asserted, not only
  // the count — a split that returns the right number of wrong pieces passes a
  // count-only check.
  a = "ab\ncd".split_text("\n");
  assert(a.len() == 2 && (a[0] ?? "") == "ab" && (a[1] ?? "") == "cd", "split ascii: {a}");

  b = "é\ncd".split_text("\n");
  assert(b.len() == 2 && (b[0] ?? "") == "é" && (b[1] ?? "") == "cd", "split leading: {b}");

  c = "ab\ncé".split_text("\n");
  assert(c.len() == 2 && (c[0] ?? "") == "ab" && (c[1] ?? "") == "cé", "split trailing: {c}");

  d = "ab\ncé\nx".split_text("\n");
  assert(d.len() == 3 && (d[2] ?? "") == "x", "split trailing then more: {d}");

  e = "中\n中".split_text("\n");
  assert(e.len() == 2 && (e[0] ?? "") == "中" && (e[1] ?? "") == "中", "split 3byte: {e}");
}

fn check_reported_parse_shape() {
  // The whole reason it was filed: a `key=value` parse over text whose value is
  // an author-given, non-ASCII name.
  t = "name=porte café\nkind=door";
  found = "";
  for line in t.split_text("\n") {
    i = line.find("=");
    if line[0..i] == "name" { found = line[(i + 1)..line.len()]; }
  }
  assert(found == "porte café", "parse: got `{found}`, want `porte café`");
}

fn main() {
  check_ascii_control();
  check_trailing_two_byte();
  check_leading_two_byte();
  check_three_and_four_byte();
  check_single_index();
  check_split_text();
  check_reported_parse_shape();
  println("749 ok");
}
