//
// @PLN87 residual — whole-binding `&`-WRITE-BACK to a VECTOR ELEMENT argument is
// NOT supported and silently drops on BOTH backends: for `fn f(o: &Item){ o = X }`
// called `f(items[i])`, the caller lowers `items[i]` to a temp holding the element
// ref (`__ref = OpGetVector(items,i)`) and passes `OpCreateStack(__ref)`; the callee's
// reassignment writes back into that TEMP, and no store-back into the vector slot is
// emitted — so `items[i]` keeps its old value.  (A LOCAL-var arg works: its stack-ref
// points at the var's own slot.)  Tracked as loft#506 (caller-side store-back).
//
// This guard pins the SAFE, working forms a user should reach for instead — both
// backends.  When the residual is fixed, add the `&`-element write-back positive case.
struct Item { px: integer }

// WORKS: field mutation via a plain (non-`&`) param — reference-default propagates.
fn bump(it: Item, v: integer) { it.px = v; }

fn main() {
    items: vector<Item> = [Item { px: 0 }, Item { px: 0 }];

    // WORKS: a WHOLE-value element replace is a DIRECT assignment (not a `&` write-back).
    items[1] = Item { px: 42 };
    assert(items[1].px == 42, "direct element assign");

    // WORKS: field mutation through a plain param reaches the caller's element.
    bump(items[0], 7);
    assert(items[0].px == 7, "field mutation via plain param propagates");

    println("87-amp-element-writeback-limitation ok");
}
