//
// @P384 — a NEGATIVE bound in a vector slice `v[lo..hi]` counts from the end,
// mirroring single-index `v[-1]`.  Before the fix the loop walked the raw bound
// and leaned on per-element from-end inside the element read, so it only worked
// when start and end sat on the same side of zero:
//   v[-3..-1] was [30,40] (ok),  v[2..-1] broke to [],  v[-2..] wrapped past
//   zero to [40,50,10,20,30,40,50], and v[..-1]/v[1..-2] silently gave [].
// The fix normalises BOTH bounds to absolute positions once, before the loop.
//
// Runs on every backend (interp / --native / wasm) via the wrap.rs + native.rs
// auto-discovery of tests/scripts/.

fn main() {
  v = [10, 20, 30, 40, 50];

  // Single-index from-end still holds (the model the slice now follows).
  last = v[-1] ?? 0;
  prev = v[-2] ?? 0;
  assert(last == 50, "v[-1] = {last}");
  assert(prev == 40, "v[-2] = {prev}");

  // The fixed cases: negative END with non-negative / open / negative START.
  a: vector<integer> = v[2.. - 1]; // was []
  assert(a.len() == 2 and a[0] == 30 and a[1] == 40, "v[2..-1] = {a}");

  b: vector<integer> = v[1.. - 2]; // was []
  assert(b.len() == 2 and b[0] == 20 and b[1] == 30, "v[1..-2] = {b}");

  c: vector<integer> = v[-3.. - 1]; // already ok — lock it
  assert(c.len() == 2 and c[0] == 30 and c[1] == 40, "v[-3..-1] = {c}");

  d: vector<integer> = v[-2..]; // was wrap-around garbage
  assert(d.len() == 2 and d[0] == 40 and d[1] == 50, "v[-2..] = {d}");

  // Open-start with a negative end.
  o: vector<integer> = v[.. - 1]; // was []
  assert(o.len() == 4 and o[0] == 10 and o[3] == 40, "v[..-1] = {o}");

  // Inclusive range with a negative end: 1..=-2 is index 1..=3.
  inc: vector<integer> = v[1..= - 2];
  assert(inc.len() == 3 and inc[0] == 20 and inc[2] == 40, "v[1..=-2] = {inc}");

  // Positive bounds unchanged (regression guard for the common path).
  p: vector<integer> = v[2..4];
  assert(p.len() == 2 and p[0] == 30 and p[1] == 40, "v[2..4] = {p}");

  // A negative slice in a for-loop drives iteration correctly.
  s = 0;
  for x in v[1.. - 1] { s = s + x; } // 20+30+40
  assert(s == 90, "for-loop over v[1..-1] sum = {s}");

  // Empty slice (start past the from-end-resolved end) stays empty, not wrapped.
  e: vector<integer> = v[3.. - 3]; // start 3, end 2
  assert(e.len() == 0, "v[3..-3] len = {e.len()}");

  println("all p384 negative-slice cells passed");
}
