// Probe 29 — tuple return wrapping two heap-allocated structs.
//
//   fn split(p: P) -> (Canvas, Canvas) {
//     a = alloc_canvas(4, 5, p.tag);
//     b = alloc_canvas(7, 9, p.tag * 2);
//     (a, b)
//   }
//
// Two heap-returning fn calls, two locals (a, b), returned as a tuple.
// Tests: do tuple returns introduce TWO hidden buffers (one per element)
// via ref_return?  How does S1 / S2 handle multi-buffer fns?

struct P {
  tag: integer,
}
struct Canvas {
  data: vector<integer>,
  w: integer,
}

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn split(p: P) -> (Canvas, Canvas) {
  a = alloc_canvas(4, 5, p.tag);
  b = alloc_canvas(7, 9, p.tag * 2);
  (a, b)
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    (ca, cb) = split(p);
    assert(ca.w == 4, "iter {i}: ca.w = {ca.w}");
    assert(cb.w == 7, "iter {i}: cb.w = {cb.w}");
    assert(ca.data[0] == i, "iter {i}: ca[0] = {ca.data[0]}");
    assert(cb.data[0] == i * 2, "iter {i}: cb[0] = {cb.data[0]}");
  }
  println("probe 29 PASSED");
}
