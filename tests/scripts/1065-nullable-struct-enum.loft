//
// loft#1065 — a nullable struct-enum (`Shape?`) is carried as a twelve-byte `DbRef`, so
// its null is the reference sentinel.
//
// THREE shapes share the `Type::Enum` spelling and take three different nulls: a VALUE
// enum the `255` discriminant byte, a synthetic `__nullable<S>` the discriminant `0`, and
// a STRUCT-enum the store-pointer sentinel.  Several sites answered "what is this type's
// null" without telling them apart, so a struct-enum took the value enum's BYTE — one
// byte written where a handle belongs.  `--interpret` answered correctly and then tripped
// its own store-lifetime guard reading the slot back as a live ref; `--native` would not
// compile at all (`non-primitive cast: u8 as loft::keys::DbRef`); and the null TEST for
// the same type was refused outright while the bare spelling beside it worked.
//
// `formal/types.md` settles which null it should be rather than leaving it a design call:
// *"Representation is derived… how the `null` is stored follows from the base type"*, and
// its table gives a reference the out-of-band `nullref`.  A struct-enum's storage IS a
// reference, so the sentinel was always the only admissible answer — the sites that said
// otherwise were the deviation.
//
// The cure is one question asked consistently — is this `Type::Enum` a struct-enum
// (`Enum(_, true, _)`) or a value enum — plus `base()` where a shape was read without
// peeling `Optional`.  Six sites; every cell below is one of them, and the cells sweep
// the POSITION the value stands in, because that is what decided which site was reached.
//
// INLINE storage — a struct FIELD, a `vector<Shape?>` element — is covered too, and takes
// a DIFFERENT encoding for the same reason the rule gives: the slot there is a four-byte
// RECORD POINTER, which cannot hold the twelve-byte sentinel, so absence is pointer `0` —
// what the field prime already writes.  Its cells are at the end (loft#1071).
//
// Including ITERATION: `for e in v { e == null }` binds a sub-reference to the element
// SLOT rather than a handle, so it reads the same word a field read does.  Which of the
// two a `Var` is turns on what it VIEWS, followed through the dep chain — a loop
// variable's own dep names ITSELF, and only its declaration's dep names the vector, so
// reading the first link answers no.

enum Shape1065 { Dot, Circle { r: integer } }
struct Box1065 { s: Shape1065? }

fn takes1065(s: Shape1065?) -> boolean { s == null }
fn makes1065(present: boolean) -> Shape1065? {
  if present { Shape1065::Circle { r: 4 } } else { null }
}

fn test_an_absent_local_is_falsy() {
  // The filed repro. It answered correctly BEFORE the fix too — and then tripped
  // "refused free of out-of-range store", because the slot held a byte, not a handle.
  // So the value is only half the cell; the guard is the other half, and it fires
  // through the suite's leak/exit check rather than an assert here.
  s: Shape1065? = null;
  assert(!s, "an absent struct-enum is falsy: got {if s { "truthy" } else { "falsy" }}");
}

fn test_an_absent_local_equals_null() {
  // Refused outright before the fix — "No matching operator '==' on 'Shape1065?' and
  // 'null'" — while the same test on the bare `Shape1065` beside it worked.
  s: Shape1065? = null;
  assert(s == null, "absent == null");
  assert(!(s != null), "absent != null is false");
}

fn test_a_present_unit_variant() {
  // A no-payload variant was always ACCEPTED into the slot (it is typed as the enum,
  // not as its own reference), so this cell is what says the fix did not disturb the
  // half that already worked.
  s: Shape1065? = Shape1065::Dot;
  assert(s != null, "a present unit variant is not null");
  assert(!!s, "a present unit variant is truthy");
}

fn test_a_present_payload_variant() {
  // A variant carrying a RECORD is typed as its own `Reference`, and the subtype rule
  // that accepts it into the enum was written for the bare spelling only — so `Shape?`
  // refused what `Shape` accepted, and the `?` was the axis.
  s: Shape1065? = Shape1065::Circle { r: 7 };
  assert(s != null, "a present payload variant is not null");
  assert(match s { Circle { r } => r, Dot => -1 } == 7, "its payload reads back");
}

fn test_reassignment_both_ways() {
  // Each slot is READ before it is overwritten, so the cell proves both states rather
  // than only the second — and so the reassignment is not a dead store.
  a: Shape1065? = null;
  assert(a == null, "absent before the reassignment");
  a = Shape1065::Circle { r: 5 };
  assert(a != null, "present after the reassignment");
  b: Shape1065? = Shape1065::Circle { r: 5 };
  assert(b != null, "present before the reassignment");
  b = null;
  assert(b == null, "absent after the reassignment");
}

fn test_a_nullable_parameter() {
  assert(takes1065(null), "a null argument arrives null");
  assert(!takes1065(Shape1065::Dot), "a present argument arrives present");
  assert(!takes1065(Shape1065::Circle { r: 1 }), "a present payload argument arrives present");
}

fn test_a_nullable_return() {
  assert(makes1065(false) == null, "an absent return is null");
  assert(makes1065(true) != null, "a present return is not null");
}

fn test_the_coalesce_and_a_full_discharge() {
  absent: Shape1065? = null;
  assert((absent ?? Shape1065::Dot) != null, "?? on an absent yields the default");
  present: Shape1065? = Shape1065::Circle { r: 3 };
  assert((present ?? Shape1065::Dot) != null, "?? on a present yields the value");
}

fn test_a_loop_allocates_nothing_per_iteration() {
  // The leak channel is the point: the slot holds a handle now, and a handle written
  // once per iteration is what a mis-sized null would orphan. Four iterations so a
  // per-iteration leak is distinguishable from a single one.
  i = 0;
  n = 0;
  while i < 4 {
    s: Shape1065? = if i % 2 == 0 { null } else { Shape1065::Circle { r: i } };
    if s == null { n += 1 }
    i += 1;
  }
  assert(n == 2, "two of four iterations were absent: got {n}");
}

fn test_a_vector_of_nullable_struct_enums_constructs() {
  // Not the TEST — reading `v[0] == null` back is loft#1071 — but the construction,
  // which used to abort inside the allocator ("index out of bounds: the len is 3 but
  // the index is 255", the enum-null byte read as a type id).
  v: vector<Shape1065?> = [];
  v += [null];
  assert(len(v) == 1, "a vector of nullable struct-enums builds: got {len(v)}");
}

fn test_an_inline_field_holds_absence() {
  // loft#1071 — the write stores the record pointer `0` and the test reads that word.
  // Before, the write emitted a record COPY of the null into a four-byte slot and the
  // test was refused outright, so nothing could observe that the write was wrong.
  a = Box1065 { s: null };
  b = Box1065 { s: Shape1065::Circle { r: 6 } };
  assert(a.s == null, "an absent field is null");
  assert(b.s != null, "a present field is not null");
  assert(match b.s { Circle { r } => r, Dot => -1 } == 6, "the present field's payload reads back");
}

fn test_an_inline_field_assigned_both_ways() {
  // `b.s = null` is a different site from `Box { s: null }`, and it used to be silently a
  // NO-OP: the assignment lowered to a record copy that stored nothing the test could see.
  b = Box1065 { s: Shape1065::Dot };
  assert(b.s != null, "present at construction");
  b.s = null;
  assert(b.s == null, "cleared by assignment");
  b.s = Shape1065::Circle { r: 2 };
  assert(b.s != null, "set again by assignment");
}

fn test_a_vector_element_holds_absence() {
  // Reading the element by INDEX. The whole shape used to abort inside the allocator on
  // construction ("index out of bounds: the len is 3 but the index is 255" — the enum-null
  // byte read as a type id), so nothing downstream could be reached at all.
  v: vector<Shape1065?> = [];
  v += [null];
  v += [Shape1065::Circle { r: 4 }];
  assert(len(v) == 2, "both elements are there: got {len(v)}");
  assert(v[0] == null, "the absent element");
  assert(v[1] != null, "the present element");
}

fn test_iterating_a_vector_of_nullable_struct_enums() {
  // The read that needed the dep chain followed. Mixed on purpose: a count is only
  // evidence if both answers appear, and the ORDER puts an absent element first and last
  // so a test that answered one constant could not pass.
  v: vector<Shape1065?> = [];
  v += [null];
  v += [Shape1065::Circle { r: 3 }];
  v += [null];
  absent = 0;
  present = 0;
  for e in v { if e == null { absent += 1 } else { present += 1 } }
  assert(len(v) == 3, "all three elements are there: got {len(v)}");
  assert(absent == 2, "two absent elements: got {absent}");
  assert(present == 1, "one present element: got {present}");
}

fn main() {
  test_an_absent_local_is_falsy();
  test_an_absent_local_equals_null();
  test_a_present_unit_variant();
  test_a_present_payload_variant();
  test_reassignment_both_ways();
  test_a_nullable_parameter();
  test_a_nullable_return();
  test_the_coalesce_and_a_full_discharge();
  test_a_loop_allocates_nothing_per_iteration();
  test_a_vector_of_nullable_struct_enums_constructs();
  test_an_inline_field_holds_absence();
  test_an_inline_field_assigned_both_ways();
  test_a_vector_element_holds_absence();
  test_iterating_a_vector_of_nullable_struct_enums();
}
