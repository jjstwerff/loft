//
// @PLN139 stages B+C — a container's death releases what it OWNS, and the value it took
// ownership of stops releasing itself.
//
// Before this, a droppable copied into a struct field was released TWICE over: once by the
// source at its own scope end, and never by the container. Whether that read as a bug
// depended on whether the container outlived the source — inside one scope the source dies
// last anyway, so the shape looked fine, and it only bit when the container was RETURNED
// (loft#849, a use-after-free inside `sqlite3_step` for @PLN138's registry).
//
// The rule now:
//
//   A drop runs when the value's OWNER dies. Copying a droppable into a container transfers
//   ownership, so the source no longer drops and the container's death releases it.
//
// The two halves must be read together, which is why they are one file. Stage B gives every
// type that owns a droppable field a synthesized cascade (`t_<LEN><Type>_OpDropAll`) that
// runs the type's OWN hook first and then releases its fields in reverse declaration order.
// Stage C stops the source dropping — but only when something has taken over, which is what
// keeps the staging honest: a copy into an enum payload or a collection element is NOT yet
// cascaded (stages D/E), so it is NOT treated as a transfer and its source keeps dropping
// exactly as before. Suppressing there would turn today's early release into a silent leak.
//
// Container-before-fields is the RAII order and not an accident: a wrapper's own release may
// still need the resource it wraps — a connection says goodbye over the socket it is about
// to close. Cell 6 is the one that pins it.
//
// The trace is a FILE for @PLN125 arc B's reason: a drop receives only `self` and a struct
// field copies at construction, so a drop cannot write into a loft-side collection.

fn trace_path() -> text { return "loft139_cascade_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct H { id: integer }
fn OpDrop(self: H) { note("{self.id}"); }
fn mk(id: integer) -> H { return H { id: id }; }

struct S { h: H }
struct Nest { s: S }
struct Two { a: H, b: H }
struct WithHook { h: H, tag: integer }
fn OpDrop(self: WithHook) { note("outer{self.tag}"); }
struct Plain { n: integer }

// 1 — a struct field, source a named local. One release, at the CONTAINER's death.
fn c1() { c = mk(1); s = S { h: c }; note("alive{s.h.id}"); }

// 2 — the same with an inline temp as the source: the transfer is detected at the LIFT,
//     since before it the IR still names the call and after it nothing records the pairing.
fn c2() { s = S { h: mk(2) }; note("alive{s.h.id}"); }

// 3 — nested. Each cascade calls the next, so depth needs no special case — and the inner
//     `S` temp must not release as well (it is a block whose tail is the work-ref, which is
//     why the source peels through a block rather than matching only a bare `Var`).
fn c3() { n = Nest { s: S { h: mk(3) } }; note("alive{n.s.h.id}"); }

// 4 — two droppable fields: reverse declaration order, matching the scope-exit free order.
fn c4() { t = Two { a: mk(4), b: mk(5) }; note("alive{t.a.id}{t.b.id}"); }

// 5 — the container has its OWN hook too. It runs BEFORE the field it owns.
fn c5() { x = WithHook { h: mk(7), tag: 6 }; note("alive{x.h.id}"); }

// 6 — THE REPORTED DEFECT: the container is RETURNED, so it outlives the source's scope.
//     This is the cell that was a use-after-free — the resource was closed while the
//     returned container still held it.
fn c6m() -> S { return S { h: mk(8) }; }
fn c6() { s = c6m(); note("alive{s.h.id}"); }

// 7 — per iteration, not once at the end: a `for` body is a scope of its own.
fn c7() { for i in 9..11 { s = S { h: mk(i) }; note("alive{s.h.id}"); } }

// 8 — CONTROL: a droppable that never enters a container. Untouched by all of this.
fn c8() { a = mk(20); b = mk(21); note("alive{a.id}{b.id}"); }

// 9 — CONTROL: no droppable anywhere. No cascade may be synthesized, and nothing may run.
fn c9() { p = Plain { n: 1 }; note("alive{p.n}"); }

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  c1(); got = drain();
  assert(got == "alive1,1", "c1 container releases the field, after it was readable: {got}");

  c2(); got = drain();
  assert(got == "alive2,2", "c2 inline temp transfers at the lift: {got}");

  c3(); got = drain();
  assert(got == "alive3,3", "c3 nesting releases once, not once per level: {got}");

  c4(); got = drain();
  assert(got == "alive45,5,4", "c4 fields in reverse declaration order: {got}");

  c5(); got = drain();
  assert(got == "alive7,outer6,7", "c5 the container's own hook runs before its field: {got}");

  c6(); got = drain();
  assert(got == "alive8,8", "c6 a RETURNED container still holds it while alive: {got}");

  c7(); got = drain();
  assert(got == "alive9,9,alive10,10", "c7 per iteration, not once at the end: {got}");

  c8(); got = drain();
  assert(got == "alive2021,21,20", "c8 uncontainered droppables are unchanged: {got}");

  c9(); got = drain();
  assert(got == "alive1", "c9 a program with no droppable runs nothing: {got}");

  delete(trace_path());
  println("139 fields ok");
}
