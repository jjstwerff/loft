//
// loft#931 — storing a 64-bit `integer` into an `i32` needs an explicit cast, like every
// other narrow alias.
//
// An `i32` struct field used to take `5000000000` with NO diagnostic and store
// `705032704`, identically on `--interpret`, `--native` and released 2026.8.0.  Its
// sibling `u8` refused the same shape, so the discipline looked uniform and was not:
//
//   pub type u8  = integer limit(0, 255) size(1);
//   pub type i32 = integer size(4);            // <- the only one with no limit(…)
//
// `Parser::is_narrowing_int` decides narrowing by range CONTAINMENT, and `i32` spans the
// whole 32-bit range — which is the range a plain `integer` reports, its 64-bit value
// living in an 8-byte slot the bounds do not describe.  So the two specs differ in
// `forced_size` alone, `[s.min,s.max] ⊆ [d.min,d.max]` holds for a pair whose storage
// drops 8 bytes to 4, and the one alias whose NAME says "32 bits" was the one the width
// discipline never checked.
//
// The implicit stores now compare STORAGE WIDTH as well (`is_narrowing_int_store`), which
// is strictly wider than containment rather than different from it — a range that does
// not fit cannot have a narrower width.  DN4's explicit-cast rule deliberately does NOT
// adopt it: `as i32` is the cure this diagnostic prescribes, so it has to stay spellable,
// and widening DN4 would instead start demanding `as i32?` wherever a program writes
// `f += (i as i32)` to tag a serialisation width.
//
// The five storage positions are pinned together because the filed defect was that they
// DISAGREED — only the field truncated, while the local and the parameter were inert
// annotations that quietly kept all 64 bits.  Two `@EXPECT_ERROR` annotations for exactly
// this have sat inert in `102-expected-errors.loft` since @PLAN48 P2 (loft#929).
//
// Pass 2 only — one pass-1 error would silence every annotation here (loft#929).

struct PnBox {
  v: i32,
  tag: integer,
}

// ── The five positions.  Each must refuse; none may truncate in silence ──────

// @EXPECT_ERROR: cannot implicitly narrow integer to i32
fn pn_local_annotation() {
  n: integer = 5000000000;
  x: i32 = n;
  println("{x}");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to i32
fn pn_parameter() {
  n: integer = 5000000000;
  println("{pn_takes(n)}");
}

fn pn_takes(x: i32) -> integer {
  x
}

// @EXPECT_ERROR: cannot implicitly narrow integer to i32
fn pn_field_initialiser() {
  n: integer = 5000000000;
  b = PnBox { v: n, tag: 1 };
  println("{b.v}");
}

// The field WRITE, which is where the silent `705032704` came from.
// @EXPECT_ERROR: cannot implicitly narrow integer to i32
fn pn_field_write() {
  n: integer = 5000000000;
  b = PnBox { v: 1, tag: 1 };
  b.v = n;
  println("{b.v}");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to i32
fn pn_return_type(n: integer) -> i32 {
  n
}

// ── The siblings, which always refused — pinned so the widened test cannot ────
// ── quietly stop covering the half that already worked ───────────────────────

struct PnNarrow {
  b: u8,
  s: i16,
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn pn_u8_still_refused() {
  n: integer = 300;
  b = PnNarrow { b: n, s: 1 };
  println("{b.b}");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to i16
fn pn_i16_still_refused() {
  n: integer = 40000;
  b = PnNarrow { b: 1, s: n };
  println("{b.s}");
}
