//
// @PLN85 cluster II — regression guard: a fn that returns one of its vector
// PARAMETERS directly (`return v`) must deliver an independent COPY to the caller,
// not alias the caller's value. Before the fix `a = idv(x); x += [9]` mutated `a`
// too (a.len became 4). Fix: when the returned value is backed by a parameter,
// copy it into the return buffer (clear+append+return buffer), gated on
// is_argument so locally-owned returns are untouched. The `return v` empty-dep
// ownership hole from OWNERSHIP_MODEL.md.

fn idv(v: vector<u8>) -> vector<u8> {
  return v;
}

fn main() {
  x: vector<u8> = [1, 2, 3];
  a = idv(x);
  x += [9];
  assert(a.len() == 3, "param-return must COPY: a must stay length 3, not alias x's growth");
  assert(x.len() == 4, "x grew to 4");
}
