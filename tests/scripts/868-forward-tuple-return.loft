//
// loft#868 — a tuple-returning function declared LATER in the file, tuple-accessed.
//
// Pass 1 has not seen the declaration yet, so the call's type is `Unknown` by
// design (a forward reference is legal). The `.`-access then recovers through
// `Parser::field()`, which skipped the member token so parsing could continue —
// but only when the member was spelled as an IDENTIFIER. A NUMERIC tuple index
// stayed in the stream, and the statement parser tripped on it as `Expect token
// ;`. That error fires on pass 1, and pass 1 erroring means pass 2 never runs —
// so the declaration was never reached and the whole file was rejected.
//
// The named-field and `[i]` index spellings always recovered (both consume their
// own member token), which is why only the tuple form was affected. All three
// are pinned here so a future recovery path cannot lose one of them again.

fn main() {
  ft_pair = ft_later("x");
  assert(ft_pair.0 == "x", "forward tuple .0");
  assert(ft_pair.1 == 7, "forward tuple .1");

  // Inside a format string — a separate parse path onto the same recovery.
  assert("{ft_pair.0}/{ft_pair.1}" == "x/7", "forward tuple in format");

  // Chained: `.0` of a tuple element that is itself a tuple.
  ft_nest = ft_nested();
  assert(ft_nest.1.0 == 3, "forward nested tuple");

  // The two spellings that already worked, kept as the control.
  ft_vec = ft_vector();
  assert(ft_vec[1] == 20, "forward vector index");
  ft_struct = ft_struct_later();
  assert(ft_struct.n == 5, "forward struct field");

  println("done");
}

struct FtS {
  n: integer,
}

fn ft_later(s: text) -> (text, integer) {
  (s, 7)
}

fn ft_nested() -> (integer, (integer, integer)) {
  (1, (3, 4))
}

fn ft_vector() -> vector<integer> {
  [10, 20, 30]
}

fn ft_struct_later() -> FtS {
  FtS { n: 5 }
}
