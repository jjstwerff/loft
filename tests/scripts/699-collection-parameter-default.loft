//
// Regression (loft#699): a PARAMETER default that builds a heap value.
//
// A parameter default is stored on the SIGNATURE and replayed in the CALLER's frame, so
// the only names that survive the crossing are the earlier parameters `add_defaults`
// transplants.  One needing a TEMPORARY numbered it in the callee's table, and that index
// then resolved against the caller's locals — the same crossing loft#698 removed for a
// field default, and it failed in as many ways: `= []` and `= [1, 2]` tripped the
// database-reference assert (an ICE), `= "a" + "b"` returned the wrong text on the
// interpreter and would not compile natively, `= []` on a `hash` read garbage.
//
// The cure is the same one: lower such a default into a function of its own and store the
// call, so the temporaries are numbered in that function's table and never leave it.  The
// earlier parameters the default references become that function's own arguments.
//
// Axes: the collection KIND (vector / keyed), the element type (scalar / struct), whether
// the default is EMPTY or built, the temporary KIND (a literal, a text concat, a call),
// whether it REFERENCES an earlier parameter, and the call CONTEXT (once, in a loop —
// a loop is what catches a default that fills a buffer it shares between calls).
// Controls: a supplied argument (which always worked), and scalar/text-literal defaults
// (which never needed a temporary).
//

struct S699 { x: integer, y: integer }
struct K699 { k: integer, v: integer }

// The filed shape: an empty vector default on a collection parameter.
fn vec_empty(a: integer, b: vector<integer> = []) -> integer { a + len(b) }

// Built, not empty — the default needs a temporary to hold the literal.
fn vec_two(a: integer, b: vector<integer> = [4, 5, 6]) -> integer { a + len(b) }

// A struct element, whose width the empty literal only learns from the parameter type.
fn vec_struct(a: integer, b: vector<S699> = []) -> integer { a + len(b) }

// A KEYED collection parameter — an empty one has no expression form of its own.
fn hash_empty(a: integer, b: hash<K699[k]> = []) -> integer { a + len(b) }

// A non-collection temporary: text concatenation builds in a work buffer.
fn text_concat(a: integer, b: text = "a" + "b") -> text { "{a}{b}" }

// A CALL as the default — its return buffer belongs to the frame that replays it.
fn mk699() -> vector<integer> { [4, 5, 6] }
fn vec_call(a: integer, b: vector<integer> = mk699()) -> integer { a + len(b) }

// A struct literal default.
fn struct_lit(a: integer, b: S699 = S699 { x: 3, y: 4 }) -> integer { a + b.x + b.y }

// The default REFERENCES an earlier parameter, and needs a temporary as well: the
// generated function takes `a` as its own argument so nothing crosses tables.
fn refs_earlier(a: text, b: text = "x" + a) -> text { "{a}|{b}" }
fn refs_earlier_vec(a: integer, b: vector<integer> = [a]) -> integer { a + len(b) }

// A chain of defaults referencing earlier parameters, none needing a temporary — the
// control that the stored default keeps its ARGUMENT indices across both parser passes.
fn chained(a: integer, b: integer = 10, c: integer = a + b) -> integer { a + b + c }

// The default is REBUILT per call, never shared: a loop is what shows it.
fn per_call(a: integer, b: vector<integer> = [4, 5]) -> integer { b += [a]; len(b) }

// Controls — a scalar and a bare text literal never needed a temporary.
fn scalar(a: integer, b: integer = 1 + 2) -> integer { a + b }
fn text_lit(a: integer, b: text = "ab") -> text { "{a}{b}" }

fn test() {
  // omitted → the default; supplied → the argument.
  assert(vec_empty(1) == 1, "vec_empty default, got {vec_empty(1)}");
  assert(vec_empty(1, [7, 8]) == 3, "vec_empty supplied");
  assert(vec_two(1) == 4, "vec_two default, got {vec_two(1)}");
  assert(vec_two(1, [7, 8]) == 3, "vec_two supplied");
  assert(vec_struct(1) == 1, "vec_struct default, got {vec_struct(1)}");
  assert(vec_struct(1, [S699 { x: 1, y: 2 }]) == 2, "vec_struct supplied");
  assert(hash_empty(1) == 1, "hash_empty default, got {hash_empty(1)}");
  assert(text_concat(1) == "1ab", "text_concat default, got {text_concat(1)}");
  assert(text_concat(1, "Z") == "1Z", "text_concat supplied");
  assert(vec_call(1) == 4, "vec_call default, got {vec_call(1)}");
  assert(vec_call(1, [7, 8]) == 3, "vec_call supplied");
  assert(struct_lit(1) == 8, "struct_lit default, got {struct_lit(1)}");
  assert(struct_lit(1, S699 { x: 10, y: 20 }) == 31, "struct_lit supplied");
  assert(refs_earlier("A") == "A|xA", "refs_earlier default, got {refs_earlier(\"A\")}");
  assert(refs_earlier("A", "B") == "A|B", "refs_earlier supplied");
  assert(refs_earlier_vec(1) == 2, "refs_earlier_vec default, got {refs_earlier_vec(1)}");
  assert(chained(1) == 22, "chained defaults, got {chained(1)}");

  // Each call gets its OWN default value — a buffer shared between calls would grow.
  for i in 0..3 {
    n = per_call(i);
    assert(n == 3, "per_call keeps a fresh default, got {n}");
  }

  // Controls.
  assert(scalar(1) == 4, "scalar default, got {scalar(1)}");
  assert(scalar(1, 9) == 10, "scalar supplied");
  assert(text_lit(1) == "1ab", "text literal default, got {text_lit(1)}");
  assert(text_lit(1, "Z") == "1Z", "text literal supplied");

  println("699-collection-parameter-default ok");
}
