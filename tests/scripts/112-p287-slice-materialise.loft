//
// @P287 — slice → vector materialisation across LHS shapes.
//
// Pre-fix: each of the three cases below crashed `src/scopes.rs:298`
// with `index out of bounds: the len is 0 but the index is usize::MAX`
// because the iter IR's embedded `Break(0)` (end-of-stream test)
// reached scope analysis without a wrapping loop.  Fix: detect a
// materialisable iter by IR shape (Value::Iter with Block-typed next)
// rather than by Type::Iterator second-Null, and add a struct-field
// branch (var_nr == u16::MAX) that materialises into a temp local
// then field-writes via OpClearVector + OpAppendVector.
//
// Locks the fix in all three backends (interp, --native, wasm) via
// the wrap.rs / native.rs / wrap.rs::wasm_dir trio.

struct S {
  v: vector<integer>,
}

fn test_local_slice_assign() {
  // Annotated local LHS, slice from a different vector.
  src: vector<integer> = [10, 20, 30, 40];
  v2: vector<integer> = src[1..];
  assert(v2.len() == 3, "local slice len");
  assert(v2[0] == 20, "local slice first");
}

fn test_struct_field_self_slice() {
  // Self-slice of the SAME field — the failing case from the
  // audience projector's heat-field trim.
  s = S { v: [1, 2, 3, 4] };
  s.v = s.v[1..];
  assert(s.v.len() == 3, "struct self-slice len");
  assert(s.v[0] == 2, "struct self-slice first");
}

fn test_struct_field_other_source_slice() {
  // Slice from a DIFFERENT vector — proves the crash was about slice-
  // RHS, not specifically about self-reference.
  s = S { v: [1, 2, 3, 4] };
  src: vector<integer> = [10, 20, 30, 40];
  s.v = src[1..];
  assert(s.v.len() == 3, "struct other-source len");
  assert(s.v[0] == 20, "struct other-source first");
}

fn test_local_append_slice() {
  // `+=` slice — same materialisation, just appends instead of
  // clear+append.  Hit a different code path (s_type was silently
  // converted from Iterator to Vector by parse_operators for +=),
  // fixed by trusting the IR shape over s_type.
  v: vector<integer> = [1, 2, 3];
  src: vector<integer> = [10, 20, 30];
  v += src[1..3];
  assert(v.len() == 5, "local += slice len");
  assert(v[3] == 20, "local += slice [3]");
  assert(v[4] == 30, "local += slice [4]");
}

fn main() {
  test_local_slice_assign();
  test_struct_field_self_slice();
  test_struct_field_other_source_slice();
  test_local_append_slice();
  println("all four p287 cells passed");
}
