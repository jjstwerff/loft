//
// D-key-1 guard: a keyed range / partial-key subscript is a `for`-only iterator
// (a `Value::Iter`).  The LEGITIMATE consumers — a `for` loop, a comprehension
// (which materialises a vector), an exact-key lookup (a single record) — must keep
// working on both backends.  The value-position MISUSE (`x = coll[lo..hi]`) is a
// clean compile error, covered by tests/parse_errors.rs (keyed_*_in_value_position).

struct Item {
  nr: integer,
  label: text,
  val: integer,
}

// The two collections live in SEPARATE structs on purpose. Two keyed collections
// over one element type in ONE struct are auto-linked into a linked group — two
// routes to a single record set, where filling either fills both (DATABASE.md
// § Clearing one member of a linked group). This file is about slicing two
// INDEPENDENT collections, so keeping them apart is what makes their contents
// mean what the assertions below say.
//
// They were one struct until loft#924. Each member zeroed its own header at its
// own position in the literal, so the second one silently truncated away what
// the first had put in the shared record set, and the two fills read as
// independent. Rejoining them would make `s` hold all seven records.
struct Idx {
  idx: index<Item[nr, label]>,
}

struct Srt {
  s: sorted<Item[nr]>,
}

fn build_idx() -> Idx {
  Idx {
    idx: [
      Item { nr: 10, label: "a", val: 1 },
      Item { nr: 20, label: "b", val: 2 },
      Item { nr: 20, label: "c", val: 3 },
      Item { nr: 30, label: "d", val: 4 },
    ],
  }
}

fn build_srt() -> Srt {
  Srt {
    s: [
      Item { nr: 10, label: "a", val: 1 },
      Item { nr: 20, label: "b", val: 2 },
      Item { nr: 30, label: "d", val: 4 },
    ]
  }
}

fn main() {
  db = build_idx();
  srt = build_srt();

  // (1) range slice consumed directly by a for-loop
  range_sum = 0;
  range_cnt = 0;
  for e in db.idx[20..40] {
    range_sum += e.val;
    range_cnt += 1;
  }
  assert(range_cnt == 3, "range for count: {range_cnt}");
  assert(range_sum == 9, "range for sum: {range_sum}");

  // (2) range slice materialised into a fresh vector via a comprehension
  mat: vector<Item> = [for x in db.idx[10..=20] { x }];
  assert(len(mat) == 3, "comprehension len: {len(mat)}");
  assert(mat[0].val == 1, "comprehension first: {mat[0].val}");

  // (3) partial-key match (primary key only, on a 2-key index) in a for-loop
  partial_sum = 0;
  for e in db.idx[20] { partial_sum += e.val; }
  assert(partial_sum == 5, "partial-key for sum: {partial_sum}");

  // (4) exact multi-key lookup — a single record, valid in a value position
  hit = db.idx[20, "c"];
  assert(hit.val == 3, "exact multi-key lookup: {hit.val}");
  assert(!db.idx[99, "z"], "missing exact key is null");

  // (5) sorted: exact-key lookup + full key-ordered iteration
  assert(srt.s[30].val == 4, "sorted exact lookup: {srt.s[30].val}");
  sorted_sum = 0;
  for e in srt.s { sorted_sum += e.val; }
  assert(sorted_sum == 7, "sorted for sum: {sorted_sum}");

  print("502-keyed-slice-for-only ok\n");
}
