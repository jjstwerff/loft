//
// A generator may hold a HEAP local — `--native` could not compile ANY of these.
//
// P224 made coroutine body-locals survive across `next_*` calls by lifting them into the
// state-machine struct, and scoped itself to scalars and text: *"References are skipped —
// they would need Store-allocation cascade in the factory."*  Its own doc comment names the
// consequence exactly — *"variables Set in one state and Var-read in another would otherwise
// be scoped to a single match arm and produce E0425 (cannot find value `var_X` in this
// scope)"* — and that is what every generator below produced, on both `main` and this branch.
//
// The trigger is far wider than it looks, which is why this file exists rather than one cell:
// no reassignment is needed, no view, no `&`.  A generator that merely BINDS a struct and
// yields twice was enough.  So every loft generator over structured data was uncompilable
// natively, silently, while `--interpret` ran them correctly — a backend split, not a
// missing feature.
//
// No cascade was needed in the end.  A heap local lowers to a `DbRef` — `Copy`, and the same
// shape the for-loop value buffer already stores — so the factory initialises the field to
// `DbRef::NULL` and the body's own `OpDatabase` fills it, which is exactly what the
// per-arm `let mut var_x: DbRef = DbRef::NULL` did before.
//
// The cells move the KIND of local (struct / vector / keyed), how it is PRODUCED (literal vs
// a call's return), and whether it is REASSIGNED or mutated between yields — the axes that
// separately reach the two faults this had (E0425 for the arm scoping, then E0308 where the
// declaration `Set(v, Null)` emitted `()` for a DbRef).  Boundary:
// `doc/claude/plans/130-element-view-invalidation/probes/42-generator-heap-locals.loft`.

struct P { n: integer, tag: integer = 0 }
struct Holder { v: vector<P>, m: integer = 0 }
struct Elm { key: integer, tag: integer = 0 }

fn mk(x: integer) -> P { return P { n: x, tag: x * 10 }; }

// The minimal shape: a struct local, no reassignment at all, read after a yield.
fn only_bound() -> iterator<integer> {
  s = P { n: 11, tag: 111 };
  yield s.n;
  yield s.tag;
}

// Reassigned between yields — the shape P224's doc describes.
fn reassigned() -> iterator<integer> {
  s = P { n: 11 };
  yield s.n;
  s = P { n: 22 };
  yield s.n;
}

// Mutated through, rather than replaced.
fn mutated() -> iterator<integer> {
  s = P { n: 11 };
  yield s.n;
  s.n = 22;
  yield s.n;
}

// Produced by a CALL rather than a literal — a different emitter (return buffer / NRVO).
fn from_a_call() -> iterator<integer> {
  s = mk(11);
  yield s.n;
  s = mk(22);
  yield s.tag;
}

// A vector local, indexed after the yield.
fn vector_local() -> iterator<integer> {
  v = [11, 12, 13];
  yield v[0];
  v = [22, 23];
  yield v[1];
}

// A vector of STRUCTS, appended to between yields — the local must keep the same store.
fn vector_of_structs() -> iterator<integer> {
  v = [P { n: 11 }];
  yield v[0].n;
  v += [P { n: 22 }];
  yield v[1].n;
}

// A keyed collection local.
fn keyed_local() -> iterator<integer> {
  s: sorted<Elm[key]> = [Elm { key: 10, tag: 111 }];
  yield s[10].tag;
  s += [Elm { key: 30, tag: 333 }];
  yield s[30].tag;
}

// A nested struct holding a vector — the chain must survive the suspension whole.
fn nested_holder() -> iterator<integer> {
  h = Holder { v: [P { n: 11 }, P { n: 22 }], m: 7 };
  yield h.v[1].n;
  yield h.m;
}

// Two heap locals live at once, so the fix cannot be "the one local".
fn two_locals() -> iterator<integer> {
  a = P { n: 11 };
  b = P { n: 22 };
  yield a.n;
  yield b.n;
}

// Each generator is driven to EXHAUSTION, not merely read twice.  A generator abandoned
// part-way never runs the tail its owned locals are freed in, so it leaks — a separate,
// pre-existing defect (it reproduces on `main`, and needs a coroutine drop path to fix).
// Exhausting keeps this file about the thing it names; the leak has its own issue.
fn two(g: iterator<integer>, name: text, w1: integer, w2: integer) {
  a = next(g) ?? -1;
  b = next(g) ?? -1;
  done = next(g) ?? -1;
  assert(a == w1, "776 {name} first {a} want {w1}");
  assert(b == w2, "776 {name} second {b} want {w2}");
  assert(done == -1, "776 {name} exhausted {done} want -1");
}

fn main() {
  two(only_bound(), "only_bound", 11, 111);
  two(reassigned(), "reassigned", 11, 22);
  two(mutated(), "mutated", 11, 22);
  two(from_a_call(), "from_a_call", 11, 220);
  two(vector_local(), "vector_local", 11, 23);
  two(vector_of_structs(), "vector_of_structs", 11, 22);
  two(keyed_local(), "keyed_local", 111, 333);
  two(nested_holder(), "nested_holder", 22, 7);
  two(two_locals(), "two_locals", 11, 22);
  print("776 ok\n");
}
