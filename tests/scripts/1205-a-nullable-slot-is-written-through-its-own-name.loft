//
// loft#1205's POSITIVE half: the cure the refusal names actually computes the right answer,
// and the `?` spellings that ARE places still write through.
//
// A NULL DISCHARGE is a value, not a place (@FR-N-NotPlace) — `1205b-a-discharged-target-is-
// refused.loft` holds that half.  This file is the other side of the same rule, and it is
// the half that can go quiet: a compiler that refused every `?` anywhere near an assignment
// would satisfy the refusal cells and break the language, so what is scored here is what the
// message TELLS the author to write, plus the discharge spelling that was never at issue.
//
// ⚠ The separating cell is `1205_interior_discharge`.  `b.inner?.x += 1` also carries a `?`,
// and it is CORRECT: the discharge is not the target's outermost node, so `.x` after it names
// a real interior place and the write reaches the container (H-View).  The refusal reads the
// outermost node for exactly that reason.  Without this cell the guard could not tell the
// shipped rule from "reject anything with a `?` on the left".
//
// The keyed sibling is scored in the group cells because it is the half the filed issue read
// as a separate defect: the `?` write skipped the collection-group maintenance entirely, so a
// cell reading only the vector's length sees half the answer.  @FR-Col-Group's failure mode is
// a zero, never an error.
//
// @falsified-at: 251d405f — exit 0 -> 1: the `text`-behind-a-discharge cell does not COMPILE on
//   the parent, which reports "the left side of this assignment is a value, not a variable. A
//   file-scope `NAME: text = …` is a CONSTANT" about code this file does not contain.  The rest
//   of the file is INERT against that build on purpose — those cells are the spellings that
//   already worked, and what they guard is the fix not over-reaching.  That control was built
//   and measured rather than predicted: widening `null_discharge_target` from the outermost node
//   to "the LHS mentions a discharge anywhere" (`any_node`) refuses `ho1205.inner?.x += 1` and
//   this file exits 1, while the refusal file still passes there with every cell matched — so
//   the negative half alone could not have caught it.  Each assertion was also mutated in turn
//   on the shipped build and each fails (`len(look) == 0` and `inner?.x == 1` shown to report
//   their own message).

struct Ed1205 { k: integer, nm: text }
struct Gp1205 { look: hash<Ed1205[k]>, data: vector<Ed1205>? }
struct In1205 { x: integer }
struct It1205 { nm: text }
struct Ht1205 { i: It1205? }
struct Ho1205 { inner: In1205? }

// The cure the diagnostic names, on a group whose vector member starts EMPTY.
fn gp1205_from_empty() -> Gp1205 {
  g1205a = Gp1205 { data: [] };
  g1205a.data += [Ed1205 { k: 7, nm: "seven" }];
  g1205a
}

// …and on the same group whose vector member starts NULL.  This is the path the discharge was
// written for, so the cure has to hold here or the message sends the author nowhere.
fn gp1205_from_null() -> Gp1205 {
  g1205b = Gp1205 { };
  g1205b.data += [Ed1205 { k: 7, nm: "seven" }];
  g1205b
}

fn main() {
  // ---- the cure, from an EMPTY nullable member ----
  ge1205 = gp1205_from_empty();
  assert(len(ge1205.data ?? []) == 1, "the bare write appends exactly one record");
  assert(ge1205.data?[0].k == 7, "and the record carries the key it was given");
  assert(ge1205.data?[0].nm == "seven", "and its text member too");
  assert(len(ge1205.look) == 1, "and the keyed sibling of the group receives it");
  assert(ge1205.look[7].nm == "seven", "reachable by its key, with the same value");

  // ---- the cure, from a NULL nullable member ----
  gn1205 = gp1205_from_null();
  assert(len(gn1205.data ?? []) == 1, "a null member takes the write too");
  assert(gn1205.data?[0].nm == "seven", "with the value intact");
  assert(len(gn1205.look) == 1, "and its keyed sibling still receives it");

  // ---- a nullable LOCAL, written through its own name ----
  vl1205: vector<Ed1205>? = null;
  vl1205 += [Ed1205 { k: 3, nm: "three" }];
  assert(len(vl1205 ?? []) == 1, "a null nullable local takes the write");
  assert(vl1205?[0].nm == "three", "with the value intact");

  // ---- the SEPARATING cell: a discharge that is NOT the target ----
  ho1205 = Ho1205 { inner: In1205 { x: 1 } };
  ho1205.inner?.x += 1;
  assert(ho1205.inner?.x == 2, "an interior discharge still names a place and writes through");

  // A `text` member behind the same interior discharge.  Scored beside the `integer` one
  // because the two took DIFFERENT paths and only one of them worked: a text write is
  // intercepted before the general dispatch and turned away when its place names no binding,
  // and an `ncc`-rooted place named none — so this line reported that a file-scope `NAME: text`
  // is a constant, about code nobody had written.
  tw1205 = Ht1205 { i: It1205 { nm: "ab" } };
  tw1205.i?.nm = "cd";
  assert(tw1205.i?.nm == "cd", "a text member behind an interior discharge is written too");

  // ---- the discharge as a READ, both arms ----
  rd1205 = Gp1205 { data: [] };
  rd1205.data += [Ed1205 { k: 1, nm: "one" }];
  rd1205.data += [Ed1205 { k: 2, nm: "two" }];
  assert(len(rd1205.data?) == 2, "`?` still discharges a present slot to its own value");
  nl1205 = Gp1205 { };
  assert(len(nl1205.data ?? [Ed1205 { k: 9, nm: "nine" }]) == 1, "`??` still takes the default arm");
  assert(len(nl1205.data?) == 0, "and `?` still takes the type's own default");
}
