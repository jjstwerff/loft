// Differential-oracle divergence 2026-07-10 — a `-> text` fn whose TAIL is a
// `match` miscompiled on native while the interpreter ran fine (an accept/reject
// divergence, caught by `tests/oracle/27-native-tailcall-return-heap.loft`).
//
// MECHANISM.  A text tail promotes its branch arms into an `__acc` buffer
// (`do_if_acc` → `push_text_arms_into` → `text_return`), which is what lets the
// caller supply the `&text` return buffer.  A `match` lowers to
// `Block["scalar_match"]{ Set(subj), <nested If chain> }` — the same
// value-yielding branch tail as a bare `if`, just behind the subject-binding
// wrapper — but `if_tail_yields_text` did not see through that block, so the
// promotion never fired.  Native then emitted an arm that borrows a dead `Str`
// temporary, and the interpreter (which keeps the value on its stack) was right.
//
// The trigger is the CALLEE needing a caller-provided destination buffer (a
// computed text body), NOT a heap/store-backed param as the oracle cell's old
// header claimed: a literal-bodied callee returns an owned `String` and is fine,
// with or without params.  Both rustc symptoms are pinned here because the
// subject type decides which one fires: `text` subject → E0599 (`().to_string()`,
// the value dropped); `integer` subject → E0716 (borrow of a dropped temporary).
// Fixed by teaching `if_tail_yields_text` the `scalar_match` see-through, exactly
// as it already does for the `ncc`/`ncr` coalesce blocks.

fn tmt_computed() -> text {
  "a" + "b"
} // buffer-taking callee (computed body)
fn tmt_literal() -> text {
  "lit"
} // bufferless callee (owned String)
fn tmt_param(s: text) -> text {
  s + "!"
} // params are irrelevant to the trigger

// integer subject → the E0716 mask
fn tmt_int_subject(k: integer) -> text {
  match k { 1 => tmt_computed(), _ => "" }
}

// text subject → the E0599 mask
fn tmt_text_subject(k: text) -> text {
  match k { "hit" => tmt_computed(), _ => "" }
}

// three arms: the chain nests `If`s, which `arm_yields_text` must recurse
fn tmt_three_arms(k: integer) -> text {
  match k { 1 => tmt_computed(), 2 => tmt_param("x"), _ => "" }
}

// a bufferless callee must keep working (it never needed the promotion)
fn tmt_literal_callee(k: integer) -> text {
  match k { 1 => tmt_literal(), _ => "" }
}

// both arms buffer-taking
fn tmt_both_arms(k: integer) -> text {
  match k { 1 => tmt_computed(), _ => tmt_param("z") }
}

// the `if` twin stays correct (it always was) — guards against a regression in
// the shared `do_if_acc` path the fix routes through
fn tmt_if_twin(k: integer) -> text {
  if k == 1 { tmt_computed() } else { "" }
}

// The BIND position — `q = <branch>; …` — was the same class at a different site,
// and is now fixed too (`Parser::try_branch_text_bind`, the bind-site analogue of
// `do_if_acc`).  Both rustc masks are pinned: an integer/boolean subject gave E0716,
// an `if` gave E0308.  A TEXT subject passed only by accident (its `OpFreeText` on
// the subject copy tripped the emitter's `has_trailing_void`), so it is pinned too —
// it must stay correct for the RIGHT reason now.  Full corpus cell:
// `tests/oracle/30-text-branch-bind-delivery.loft`.
fn tmt_bind_text_subject(k: text) -> text {
  q = match k { "hit" => tmt_computed(), _ => "" };
  q
}
fn tmt_bind_int_subject(k: integer) -> text {
  q = match k { 1 => tmt_computed(), _ => "" };
  q
}
fn tmt_bind_if(k: integer) -> text {
  q = if k == 1 { tmt_computed() } else { "" };
  q
}
// Destination NOT returned, so no hidden-buffer promotion.  The leading `Set(q, "")`
// in `try_branch_text_bind` is what introduces `q` here: without it the per-arm sets
// live inside the branch, the interpreter silently read an EMPTY text (a wrong
// answer, worse than the reject it replaced) and native emitted an undeclared var.
fn tmt_bind_local(k: integer) -> text {
  q = match k { 1 => tmt_computed(), _ => "" };
  "[{q}]"
}

fn main() {
  assert(tmt_int_subject(1) == "ab", "int subject hit");
  assert(tmt_int_subject(9) == "", "int subject miss");
  assert(tmt_text_subject("hit") == "ab", "text subject hit");
  assert(tmt_text_subject("no") == "", "text subject miss");
  assert(tmt_three_arms(1) == "ab", "three arms first");
  assert(tmt_three_arms(2) == "x!", "three arms second");
  assert(tmt_three_arms(7) == "", "three arms default");
  assert(tmt_literal_callee(1) == "lit", "literal callee");
  assert(tmt_both_arms(1) == "ab", "both arms first");
  assert(tmt_both_arms(0) == "z!", "both arms default");
  assert(tmt_if_twin(1) == "ab", "if twin");
  assert(tmt_bind_text_subject("hit") == "ab", "bind, text subject");
  assert(tmt_bind_int_subject(1) == "ab", "bind, int subject (was E0716)");
  assert(tmt_bind_int_subject(9) == "", "bind, int subject default");
  assert(tmt_bind_if(1) == "ab", "bind an if (was E0308)");
  assert(tmt_bind_local(1) == "[ab]", "bind, destination not returned");
}
