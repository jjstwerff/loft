//
// Regression — field-of-element SET to a struct literal carrying a vector
// (`xs[i].field = V{a: [literal]}`) must DEEP-OWN the nested vector backing,
// not free it.  Sibling of @P313 (whole-element set `xs[i] = Cont{...}`, fixed)
// and @P311 (keyed SET).
//
// Root cause (interpreter only — native was already guarded): the field-set
// built `xs[i].field.a` IN PLACE by appending elements via `OpNewRecord`,
// reusing one element-ref temp `_elm_2` across the appends.  `generate_set`'s
// reassignment path emitted an UNCONDITIONAL pre-Set `OpFreeRef` of the old
// `_elm_2` — but an `OpNewRecord` RHS returns an INTERIOR ref into the vector's
// backing store, so consecutive elements share one store and the whole-store
// free killed the live backing.  The corruption was SILENT: correct bytes
// survived until the next allocation recycled the freed store (non-deterministic
// data loss; deterministic SIGSEGV / use-after-free only under the armed
// `get_vector` debug-assert).  The native generator's
// `if _old.store_nr != new.store_nr` guard already protected the native backend.
// Fix (src/state/codegen.rs `generate_set`): route an `OpNewRecord` RHS through
// the runtime-guarded post-free (`OpFreeRefIfDistinct`) so a same-store
// reassignment is a no-op.
//
// The bug only surfaced inside a NON-root function (root `main` leaks its
// locals, so the freed store was never read again).  These `fn test_*` entries
// run as the harness's top-level entries — the live shape.  The ARMED build's
// `get_vector` use-after-free assert is the deterministic detector; under the
// release build the reads below produce correct values, and the baselines guard
// against over-fixing (scalar-field / whole-element / struct-call set paths).

struct V { a: vector<integer> }
struct Cont { m: V }
struct Scalar { n: integer }
struct SCont { m: Scalar }

fn mk(n: integer) -> V {
  v: vector<integer> = [];
  for j in 0..n { v += [j]; }
  V{a: v}
}

// The bug shape: field-of-element set to a struct literal with a vector field,
// across several elements, then read every nested element back.
fn test_field_elem_set_vector() {
  xs: vector<Cont> = [];
  for i in 0..4 { xs += [Cont{m: V{a: []}}]; }
  for i in 0..4 { xs[i].m = V{a: [i * 10, i * 10 + 1, i * 10 + 2]}; }
  total = 0;
  for i in 0..4 {
    assert(len(xs[i].m.a) == 3, "elem {i} len={len(xs[i].m.a)} (expect 3)");
    assert(xs[i].m.a[0] == i * 10 && xs[i].m.a[2] == i * 10 + 2,
      "elem {i} values: a[0]={xs[i].m.a[0]} a[2]={xs[i].m.a[2]}");
    total = total + len(xs[i].m.a);
  }
  assert(total == 12, "field-set total={total} (expect 12 = 4x3)");
}

// Baseline (must stay correct): field-set with a SCALAR field — no nested
// vector backing, so the pre-Set free was never reached.
fn test_field_elem_set_scalar_unaffected() {
  xs: vector<SCont> = [];
  for i in 0..3 { xs += [SCont{m: Scalar{n: 0}}]; }
  for i in 0..3 { xs[i].m = Scalar{n: i * 7}; }
  for i in 0..3 { assert(xs[i].m.n == i * 7, "scalar elem {i} = {xs[i].m.n}"); }
}

// Baseline (must stay correct): whole-element set — the @P313-fixed path.
fn test_whole_elem_set_unaffected() {
  xs: vector<Cont> = [];
  for i in 0..3 { xs += [Cont{m: V{a: []}}]; }
  for i in 0..3 { xs[i] = Cont{m: V{a: [i, i, i, i]}}; }
  total = 0;
  for x in xs { total = total + len(x.m.a); }
  assert(total == 12, "whole-set total={total} (expect 12 = 3x4)");
}

// Baseline (must stay correct AND leak-free): field-set from a struct-returning
// CALL (an unowned temporary) — the path that legitimately keeps its source free.
fn test_field_set_from_call_unaffected() {
  xs: vector<Cont> = [];
  for i in 0..3 { xs += [Cont{m: V{a: []}}]; }
  for i in 0..3 { xs[i].m = mk(i + 2); }
  total = 0;
  for i in 0..3 { total = total + len(xs[i].m.a); }
  assert(total == 9, "call-set total={total} (expect 9 = 2+3+4)");
}
