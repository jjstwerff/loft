// par() over a NARROW-integer vector (vector<u8> / vector<i32>).  The element
// must be read at its true 1/4-byte stride, not 8 — native used get_int (8
// bytes) and over-read across rows, giving garbage.  Kept separate from
// 22c-par-sources.loft (which already has many par loops) to avoid the
// unrelated "many par loops in one fn" corruption.

fn dbl(x: integer) -> integer {
  return x * 2;
}

fn main() {
  // u8 element, integer-param worker (element widens to the param).
  vb: vector<u8> = [1, 2, 3];
  s1 = 0;
  for i in vb par(r = dbl(i), 2) { s1 += r; }
  assert(s1 == 12, "vector<u8> par: {s1}");

  // i32 element.
  vi: vector<i32> = [10, 20, 30];
  s2 = 0;
  for i in vi par(r = dbl(i), 2) { s2 += r; }
  assert(s2 == 120, "vector<i32> par: {s2}");
}
