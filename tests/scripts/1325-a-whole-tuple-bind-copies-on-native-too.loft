//
// A whole-value bind of a tuple LOCAL carrying a non-Copy leaf is an independent COPY on
// `--native` as well as on the interpreter (loft#1325, `formal/binding.md` @FR-B-Copy and
// `formal/operational.md` D-op-1).
//
// `u = a` over a local `(text, text)` emitted `let mut var_u: (String, String) = var_a;`, which
// MOVES it — so every later read of `var_a` was rustc E0382 and the program did not build at
// all, while the interpreter ran it and answered what `(B-Copy)` promises. A backend that
// REFUSES what the other computes is the divergence D-op-1 forbids, and the refusing side is
// the one that was wrong: `(B-Copy)` says the bind is a copy, so `.clone()` is the emission
// that keeps the promise.
//
// ⚠ THE NON-COPY LEAF IS THE AXIS, NOT THE TUPLE.  An all-scalar tuple is `Copy` in generated
// Rust, so its "move" was already a copy and needed nothing; a text leaf, a nested tuple with
// one, and a mixed scalar/text pair are the shapes that did. `tuple_has_non_copy_leaf` is the
// predicate, shared with the `TupleGet` arm one level in (P247), so the two cannot drift about
// what a non-Copy leaf is.
//
// ⚠ AND A TUPLE PARAMETER IS SOMEBODY ELSE'S CASE.  A parameter arrives BORROWED and is
// re-spelled by `tuple_arg_owned_elems` (loft#840, loft#1005); the arm added here fires only on
// a LOCAL source, so the two do not overlap and neither had to learn the other's job.
//
// @falsified-at: 61e6fc62 — native exit 1 -> 0; interpret INERT (expected for a
//   backend-divergence guard — only one side can move).
// ⚠ THE INERT INTERPRETER ROW IS THE POINT, NOT A GAP.  This backend was correct throughout and
//   is the ORACLE here rather than the subject. And what moves on native is the COMPILE: that
//   build does not produce a program to run, because rustc refuses it with `error[E0382]:
//   borrow of moved value`, so no ASSERT can fire and the exit code is the only channel there
//   is. A guard for an accept/reject divergence has exactly one movable side by construction.
// ⚠ AND THE EXIT CODE IS A SINGLE BIT, so the census is per shape rather than from the row:
//   compiled one at a time on that build, FOUR of this file's shapes are refused and each names
//   a different rustc message — the plain bind, the mixed scalar/text pair and the nested tuple
//   as `borrow of moved value`, the append-then-write as `assign to part of moved value`. The
//   all-scalar tuple compiles and answers correctly there, which is what makes it the control.

fn test_a_whole_tuple_bind_is_independent() {
  // The filed shape. Writing through the copy must not reach the source, and the source must
  // still be READABLE afterwards — which is the half rustc refused.
  a = ("a1", "b1");
  u = a;
  u.0 = "c0";
  assert(a.0 == "a1", "the source after a copy was written: got {a.0}");
  assert(u.0 == "c0", "the copy's own value: got {u.0}");
  assert(a.1 == "b1", "the source's untouched element: got {a.1}");
}

fn test_the_source_survives_being_appended() {
  // The issue's second shape: the tuple goes into a vector and the source keeps being written.
  a = ("a1", "b1");
  v: vector<(text, text)> = [];
  v += [a];
  a.1 = "z";
  assert(a.1 == "z", "the source after the append: got {a.1}");
  assert(v[0].0 == "a1", "the appended element's first: got {v[0].0}");
  assert(v[0].1 == "b1", "the appended element must not follow the source: got {v[0].1}");
}

fn test_a_mixed_scalar_and_text_tuple() {
  // The non-Copy test is per LEAF: one text element is enough to make the whole tuple move.
  a = (1, "a1");
  u = a;
  u.0 = 2;
  u.1 = "c0";
  assert(a.0 == 1, "the source's scalar: got {a.0}");
  assert(a.1 == "a1", "the source's text: got {a.1}");
  assert(u.0 == 2, "the copy's scalar: got {u.0}");
  assert(u.1 == "c0", "the copy's text: got {u.1}");
}

fn test_a_nested_tuple_with_a_text_leaf() {
  // `tuple_has_non_copy_leaf` recurses, so a text buried one level down counts.
  a = ((1, "a1"), 2);
  u = a;
  u.0.1 = "c0";
  assert(a.0.1 == "a1", "the source's nested text: got {a.0.1}");
  assert(u.0.1 == "c0", "the copy's nested text: got {u.0.1}");
}

fn test_an_all_scalar_tuple_is_unmoved() {
  // The control for the axis: `(integer, integer)` is `Copy`, so its bind was always a copy and
  // this change must not have reached it.
  a = (1, 5);
  u = a;
  u.0 = 2;
  assert(a.0 == 1, "the scalar source: got {a.0}");
  assert(u.0 == 2, "the scalar copy: got {u.0}");
}

fn test_a_destructure_is_unmoved() {
  // Recorded correct on both backends when the issue was filed; it consumes the tuple rather
  // than binding it, so it never met the move.
  a = ("a1", "b1");
  (x, y) = a;
  assert(x == "a1", "destructured first: got {x}");
  assert(y == "b1", "destructured second: got {y}");
}

fn test_a_comparison_is_unmoved() {
  // Also recorded correct: a comparison borrows.
  a = ("a1", "b1");
  b = ("a1", "b1");
  c = ("z", "b1");
  assert(a == b, "equal pairs compared unequal");
  assert(!(a == c), "unequal pairs compared equal");
}

fn test_a_copy_whose_source_is_never_read_again() {
  // A move would compile here, so this cell does not prove the clone was needed — it says the
  // clone did not break the case that always worked.
  a = ("a1", "b1");
  u = a;
  u.0 = "c0";
  assert(u.0 == "c0", "the copy's written element: got {u.0}");
  assert(u.1 == "b1", "the copy's carried element: got {u.1}");
}
