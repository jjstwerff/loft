//
// The repeat literal `[x; n]` builds n elements — it used to build n+1, and n=0 corrupted
// the heap.
//
// `OpAppendCopy` is handed the TOTAL the literal asks for, and the template element is
// already appended when it runs, so it needs `n - 1` more. It added `n` instead: the
// vector grew one past the request and the extra slot was never written, so `[7; 3]` read
// back as length 4 with garbage in the last element — a wrong length AND an uninitialised
// read, silently, on both backends.
//
// `n == 0` is the same off-by-one taken to its end: the copy count reached
// `0..(multiply - 1)` on a `u32`, wrapped to 4 294 967 295, and walked `copy_block` off
// the end of the store until glibc aborted the process ("Fatal glibc error: malloc.c").
// The template also has to go, or a zero-length request answers length 1.
//
// Both halves reproduce on the published 2026.8.0, both backends. The interpreter
// (`State::append_copy`) and native (`codegen_runtime::OpAppendCopy`) carry separate
// copies of this loop, so every row below is a two-generator check.
//
// A RUNTIME count is the row that cannot be const-folded away — it is what a consumer
// actually writes, and it is the one an all-literal guard would miss.

fn r886_sum(v: vector<integer>) -> integer {
  t = 0;
  for e in v { t += e; }
  t
}

fn main() {
  // The filed shape: three elements, all of them the template.
  three: vector<integer> = [7; 3];
  assert(len(three) == 3, "len [7;3] = {len(three)}, want 3");
  // Sum, not just length: an uninitialised trailing slot has the right length and the
  // wrong contents, which is the half a length check alone cannot see.
  assert(r886_sum(three) == 21, "sum [7;3] = {r886_sum(three)}, want 21");

  // One — the template alone is already the answer, so nothing may be added.
  one: vector<integer> = [5; 1];
  assert(len(one) == 1, "len [5;1] = {len(one)}, want 1");
  assert(r886_sum(one) == 5, "sum [5;1] = {r886_sum(one)}, want 5");

  // Zero — the heap-corrupting row. The template must be dropped, not kept.
  none: vector<integer> = [7; 0];
  assert(len(none) == 0, "len [7;0] = {len(none)}, want 0");
  assert(r886_sum(none) == 0, "sum [7;0] = {r886_sum(none)}, want 0");

  // A RUNTIME count, which no const-fold can reach.
  k = 4;
  runtime: vector<integer> = [9; k];
  assert(len(runtime) == 4, "len [9;k=4] = {len(runtime)}, want 4");
  assert(r886_sum(runtime) == 36, "sum [9;k=4] = {r886_sum(runtime)}, want 36");

  // A runtime ZERO — the underflow row, reached without a literal 0.
  z = 0;
  rzero: vector<integer> = [3; z];
  assert(len(rzero) == 0, "len [3;z=0] = {len(rzero)}, want 0");

  // A wider element than the 8-byte integer: the copy strides by the element size, so a
  // stride bug shows up as the wrong sum rather than the wrong length.
  fl: vector<float> = [1.5; 3];
  assert(len(fl) == 3, "len [1.5;3] = {len(fl)}, want 3");
  tot = 0.0;
  for e in fl { tot += e; }
  assert(tot == 4.5, "sum [1.5;3] = {tot}, want 4.5");

  // A NEGATIVE count. `n == 0` was fixed by dropping the template; a negative one took
  // the same route through `as u32` and wrapped to 4 294 967 295 `copy_block`s, walking
  // off the store until glibc aborted the process. The two backends did not even agree:
  // `--native` already clamped, the interpreter did not — so this row is where a twin
  // drift on a heap-corrupting input shows.
  neg = 0 - 1;
  rneg: vector<integer> = [3; neg];
  assert(len(rneg) == 0, "len [3;neg=-1] = {len(rneg)}, want 0");

  // An element whose value is NOT its inline bytes. A `text` element stores a 4-byte
  // interned id, so the copy has to re-intern from the TEMPLATE — it re-interned from
  // the vector handle instead, and every copy read back as junk while element 0 was
  // right. Length and element 0 both looked correct, so only reading a LATER element
  // catches it.
  words: vector<text> = ["abc"; 4];
  assert(len(words) == 4, "len [\"abc\";4] = {len(words)}, want 4");
  joined = "";
  for w in words { joined += w; }
  assert(joined == "abcabcabcabc", "[\"abc\";4] joined to '{joined}'");

  // The same question for a record and for a nested vector: both carry claims of their
  // own, and a struct carries a text field INSIDE it.
  pts: vector<R886P> = [R886P { px: 5, pnm: "hi" }; 3];
  assert(len(pts) == 3, "len struct repeat = {len(pts)}, want 3");
  psum = 0;
  pnames = "";
  for p in pts { psum += p.px; pnames += p.pnm; }
  assert(psum == 15, "struct repeat sum = {psum}, want 15");
  assert(pnames == "hihihi", "struct repeat names = '{pnames}'");

  rows: vector<vector<integer>> = [[1, 2]; 3];
  assert(len(rows) == 3, "len nested repeat = {len(rows)}, want 3");
  rsum = 0;
  for r in rows { rsum += r886_sum(r); }
  assert(rsum == 9, "nested repeat sum = {rsum}, want 9");

  println("886 repeat-literal ok");
}

struct R886P { px: integer, pnm: text }
