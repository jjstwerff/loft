// JSON: serialization (:j), parsing (.parse), cast (as), errors, nested structs.

struct JUser {
  id: integer,
  name: text,
  email: text,
}
struct JScore {
  val: integer,
}
struct JInner {
  x_coord: integer,
}
struct JOuter {
  label: text,
  data: JInner,
}
struct JItem {
  tag: text,
  amount: integer,
}

fn test_json_serialize() {
  u = JUser { id: 42, name: "Alice", email: "alice@example.com" };
  json = "{u:j}";
  assert(json == `{{"id":42,"name":"Alice","email":"alice@example.com"}}`, "serialize: {json}");
}

fn test_json_parse_object() {
  bob = JUser.parse(`{{"id":7,"name":"Bob","email":"bob@test.org"}}`);
  assert(bob.id == 7, "id: {bob.id}");
  assert(bob.name == "Bob", "name: {bob.name}");
  assert(bob.email == "bob@test.org", "email: {bob.email}");
}

fn test_json_round_trip() {
  u = JUser { id: 1, name: "Carol", email: "c@d.com" };
  u2 = JUser.parse("{u:j}");
  assert(u2.id == 1, "round-trip id");
  assert(u2.name == "Carol", "round-trip name");
}

fn test_json_parse_loft_native() {
  s = JScore.parse(`{{val: 7}}`);
  assert(s.val == 7, "loft-native parse: {s.val}");
}

fn test_json_parse_from_variable() {
  input = `{{"x_coord": 10}}`;
  p = JInner.parse(input);
  assert(p.x_coord == 10, "from var: {p.x_coord}");
}

fn test_json_parse_nested_struct() {
  c = JOuter.parse(`{{"label":"ok","data":{{"x_coord":99}}}}`);
  assert(c.label == "ok", "label: {c.label}");
  assert(c.data.x_coord == 99, "nested: {c.data.x_coord}");
}

fn test_json_parse_missing_field() {
  partial = JUser.parse(`{{"id":1}}`);
  assert(partial.id == 1, "id present");
  assert(!partial.name, "missing name is null");
  assert(!partial.email, "missing email is null");
}

fn test_json_parse_vector() {
  scores = vector<JScore>.parse(`[{{"val":10}},{{"val":20}},{{"val":30}}]`);
  assert(len(scores) == 3, "vector len: {len(scores)}");
  assert(scores[0].val == 10, "scores[0]");
  assert(scores[2].val == 30, "scores[2]");
}

fn test_json_cast_object() {
  jt = `{{"tag": "hello", "amount": 42}}`as JItem;
  assert(jt.tag == "hello", "cast tag: {jt.tag}");
  assert(jt.amount == 42, "cast amount: {jt.amount}");
}

fn test_json_cast_vector() {
  items = `[{{"tag":"a","amount":1}},{{"tag":"b","amount":2}}]`as vector<JItem>;
  assert(len(items) == 2, "cast len: {len(items)}");
  assert(items[0].tag == "a", "cast[0].tag");
  assert(items[1].amount == 2, "cast[1].amount");
}

fn test_json_quoted_field_names() {
  jt = JItem { "tag": "quoted", "amount": 7 };
  assert(jt.tag == "quoted", "quoted: {jt.tag}");
  assert(jt.amount == 7, "quoted amount");
}

fn test_errors_empty_on_success() {
  s = JScore.parse(`{{"val": 42}}`);
  err = s#errors;
  assert(len(err) == 0, "no error expected, got: '{err}'");
  assert(s.val == 42, "val: {s.val}");
}

fn test_errors_on_bad_input() {
  bad = JScore.parse(`not_json`);
  err = bad#errors;
  assert(len(err) > 0, "expected error for bad input");
  assert(bad.val == null, "val should be null");
}

fn test_errors_nested_path() {
  bad = JOuter.parse(`{{"label":"ok","data":"not_an_object"}}`);
  err = bad#errors;
  assert(len(err) > 0, "expected error for nested: {err}");
}

// loft#768 — an enum reached through a RECORD (a field, a vector element, a
// nested struct) used to render its variant name bare and unquoted:
// `{"kind":Circle {"r":2}}`.  That is not JSON, and `json_parse` rejected the
// whole document rather than just that field, so a struct containing an enum
// could not be serialised or reflected over at all.  A variant renders as a
// quoted name, or as a single-key object keyed by it when it carries fields —
// the shape a BARE variant already produced, so both routes agree.

enum JShape { JCircle { r: float }, JSquare { side: integer } }
enum JColor { JRed, JGreen }

struct JEnumField { kind: JShape }
struct JSimpleField { c: JColor }
struct JEnumVec { items: vector<JColor> }
struct JPayloadVec { items: vector<JShape> }
struct JEnumNest { inner: JEnumField }

fn test_json_enum_payload_in_field() {
  o = JEnumField { kind: JCircle { r: 2.0 } };
  json = "{o:j}";
  assert(json == `{{"kind":{{"JCircle":{{"r":2}}}}}}`, "payload field: {json}");
}

fn test_json_enum_payload_bare_agrees_with_field() {
  // The bare variant was already correct; it is asserted here so the two
  // routes to the same value can never drift apart again.
  bare = "{JCircle{r: 2.0}:j}";
  assert(bare == `{{"JCircle":{{"r":2}}}}`, "bare payload: {bare}");
}

fn test_json_enum_without_payload_in_field() {
  o = JSimpleField { c: JRed };
  json = "{o:j}";
  assert(json == `{{"c":"JRed"}}`, "simple field: {json}");
}

fn test_json_enum_in_vector() {
  v: vector<JColor> = [JRed, JGreen];
  o = JEnumVec { items: v };
  json = "{o:j}";
  assert(json == `{{"items":["JRed","JGreen"]}}`, "enum vector: {json}");

  w: vector<JShape> = [JCircle { r: 1.0 }, JSquare { side: 3 }];
  p = JPayloadVec { items: w };
  pj = "{p:j}";
  assert(pj == `{{"items":[{{"JCircle":{{"r":1}}}},{{"JSquare":{{"side":3}}}}]}}`,
         "payload vector: {pj}");
}

fn test_json_enum_nested_record() {
  o = JEnumNest { inner: JEnumField { kind: JSquare { side: 5 } } };
  json = "{o:j}";
  assert(json == `{{"inner":{{"kind":{{"JSquare":{{"side":5}}}}}}}}`, "nested: {json}");
}

fn test_json_enum_document_reparses() {
  // The regression that motivated the fix: the emitted document has to be
  // acceptable to json_parse, not merely look close to JSON.
  o = JEnumField { kind: JSquare { side: 9 } };
  match json_parse("{o:j}") {
    JObject { fields } => assert(len(fields) == 1, "field count: {len(fields)}"),
    _ => assert(false, "json_parse rejected an enum-bearing document"),
  }
}

// loft#769 — a `text?` holding null is stored as the STRING_NULL ("\0")
// sentinel.  The renderer escaped it as data, so an ABSENT value came back as a
// present one-character string (`{"note":"\u0000"}`), losing exactly the
// null-vs-empty distinction `text?` exists to carry.

struct JNullText { note: text?, n: integer }

fn test_json_null_text_is_json_null() {
  o = JNullText { note: null, n: 7 };
  json = "{o:j}";
  assert(json == `{{"note":null,"n":7}}`, "null text: {json}");
}

fn test_json_present_text_still_renders() {
  o = JNullText { note: "ok", n: 7 };
  json = "{o:j}";
  assert(json == `{{"note":"ok","n":7}}`, "present text: {json}");
}

fn test_json_empty_text_stays_distinct_from_null() {
  // The whole point of the distinction: "" and null must not collapse.
  e = JNullText { note: "", n: 1 };
  n = JNullText { note: null, n: 1 };
  ej = "{e:j}";
  nj = "{n:j}";
  assert(ej == `{{"note":"","n":1}}`, "empty text: {ej}");
  assert(ej != nj, "empty and null must render differently: {ej} vs {nj}");
}
