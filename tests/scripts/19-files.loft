// File system: format detection, path safety, exists, delete, move, text I/O, files(), lines().
// @PLN9: cwd-relative paths — reads repo fixtures (tests/example) + scratch files in the cwd.
#cwd
fn cleanup() {
  delete("test_loft_t.txt");
  delete("test_loft_src.txt");
  delete("test_loft_dst.txt");
}

fn main() {
  cleanup();
  // --- file() format detection ---
  assert(file("tests/example").format == Directory, "directory format");
  assert(file("tests/example/show.loft").format == TextFile, "text file format");
  assert(file("nonexistent_xyz.txt").format == NotExists, "nonexistent format");
  // --- Path safety: traversal outside project is rejected ---
  assert(file("../Cargo.toml").format == NotExists, ".. at start rejected");
  assert(file("tests/example/../../../etc").format == NotExists, "net upward rejected");
  assert(file("tests/example/config/../show.loft").format == TextFile, "net-zero traversal ok");
  // --- exists() ---
  assert(exists("tests/example"), "exists: directory");
  assert(exists("tests/example/show.loft"), "exists: file");
  assert(!exists("nonexistent_xyz.txt"), "exists: missing");
  assert(!exists("../Cargo.toml"), "exists: outside project");
  // --- delete() returns FileResult ---
  assert(!delete("nonexistent_xyz.txt").ok(), "delete non-existent not ok");
  assert(!delete("../Cargo.toml").ok(), "delete outside project not ok");
  // --- move() edge cases ---
  assert(!move("nonexistent_src_xyz.txt", "dst_xyz.txt").ok(), "move: missing source");
  assert(!move("tests/example/show.loft", "tests/example/map.png").ok(), "move: dst already exists");
  assert(!move("tests/example/show.loft", "../outside.txt").ok(), "move: dst outside project");
  assert(!move("../Cargo.toml", "stolen.toml").ok(), "move: src outside project");
  // --- loft#708: the WRITE side obeys the same verdict as the read side ---
  // These reported NotExists above while `write` / `+=` / `write_bytes` created
  // the file anyway, so `f#next = f.size` read 0 and the documented append
  // idiom overwrote from byte 0.  Each refusal is observable, never silent.
  // The absolute form of the same path is NOT refused (it never steps above its
  // own root), so it can see whether anything actually landed — an assertion on
  // the relative path would be vacuous, since that path cannot see either way.
  // Clear the targets through their absolute form FIRST: a loft that still had
  // the bug (an older binary, a bisect) really does create them, and a leftover
  // would then fail this run for the previous run's reason.
  here = directory();
  delete("{here}/../loft_escape_708.txt");
  delete("{here}/../loft_escape_708.bin");
  {
    esc = file("../loft_escape_708.txt");
    assert(!esc.write("escaped").ok(), "write outside project refused");
    esc += "escaped too";
  }
  assert(!write_bytes("../loft_escape_708.bin", [1 as u8]), "write_bytes outside project refused");
  assert(!exists("{here}/../loft_escape_708.txt"), "refused write created nothing");
  assert(!exists("{here}/../loft_escape_708.bin"), "refused write_bytes created nothing");
  assert(read_bytes("../Cargo.toml") == null, "read_bytes outside project reads absent");
  assert(list_dir("..") == null, "list_dir outside project reads absent");
  assert(!is_file("../Cargo.toml"), "is_file outside project");
  assert(!is_dir(".."), "is_dir outside project");
  // A handle for a path outside the project answers as one for an absent file:
  // it reports no size, not the leftovers of an unfilled struct.
  assert(file("../Cargo.toml").size == 0, "outside project reports no size");
  { gone = file("../Cargo.toml"); assert(gone#size == null, "outside project has no live size"); }
  // === Text file write and read ===
  {
    f = file("test_loft_t.txt");
    f += "Hello World";
    assert(f#size == 11, "text write size 11");
    assert(f#index == 0, "text write #index is start of write");
    assert(f#next == 11, "text write #next at end");
  }
  assert(exists("test_loft_t.txt"), "text file created");
  {
    f = file("test_loft_t.txt");
    s = f#read(5) as text;
    assert(s == "Hello", "text read first 5");
    assert(f#index == 0, "text read #index after first");
    assert(f#next == 5, "text read #next after first");
    s2 = f#read(6) as text;
    assert(s2 == " World", "text read next 6");
    assert(f#index == 5, "text read #index after second");
    assert(f#next == 11, "text read #next after second");
    // Read past EOF returns partial
    f#next = 8;
    tail = f#read(100) as text;
    assert(tail == "rld", "text read past eof returns partial");
    // Seek back to start
    f#next = 0;
    again = f#read(5) as text;
    assert(again == "Hello", "text seek and reread");
  }
  assert(delete("test_loft_t.txt").ok(), "delete text file");
  // === move() write-and-move cycle ===
  {
    f = file("test_loft_src.txt");
    f += "data";
  }
  assert(move("test_loft_src.txt", "test_loft_dst.txt").ok(), "move succeeds");
  assert(!exists("test_loft_src.txt"), "source gone after move");
  assert(exists("test_loft_dst.txt"), "destination exists after move");
  assert(delete("test_loft_dst.txt").ok(), "delete destination");
  // === Seek then overwrite: text file ===
  {
    f = file("test_loft_t.txt");
    f += "Hello";
    f#next = 0;
    f += "World";
  }
  {
    f = file("test_loft_t.txt");
    assert(f#read(5) as text == "World", "text seek overwrite: reads overwritten data");
  }
  assert(delete("test_loft_t.txt").ok(), "delete after text seek overwrite test");
  // === file().files() directory listing ===
  dir_list = file("tests/example").files();
  assert(dir_list[0].path == "tests/example/config", "files() first entry is config dir");
  assert(dir_list[0].format == Directory, "files() first entry format is Directory");
  assert(dir_list[1].format == TextFile, "files() second entry is a text file");
  // === lines() reads text file into vector ===
  c = file("tests/example/config/terrain.txt").lines();
  assert(c[1] == "    terrain = [", "lines()[1] content");
  // === path_sep: platform path separator is '/' or '\' ===
  sep = path_sep();
  assert(sep == '/' || sep == '\\', "path_sep is slash or backslash");
  // === now: milliseconds since Unix epoch (non-negative, sanity check) ===
  ms = now();
  assert(ms > 0, "now() returns positive timestamp");
  // Rough sanity: 2020-01-01 = 1577836800000 ms
  assert(ms > 1577836800000, "now() is past year 2020");
  // === ticks: microseconds since program start (monotonic) ===
  t1 = ticks();
  assert(t1 >= 0, "ticks() returns non-negative value");
  t2 = ticks();
  assert(t2 >= t1, "ticks() is monotonically non-decreasing");
  // === env_variable: returns empty text for unknown variable ===
  missing = env_variable("LOFT_TEST_NONEXISTENT_VAR_XYZ");
  assert(missing == "", "env_variable of unknown name returns empty string");
  // === mkdir and mkdir_all ===
  // Use a file inside the dir to verify existence, since delete() only removes files.
  mkdir("test_loft_dir_xyz"); // idempotent pre-clean: ignore result
  delete("test_loft_dir_xyz/sentinel.txt");
  assert(mkdir_all("test_loft_dir_xyz").ok(), "mkdir_all on existing dir ok");
  assert(exists("test_loft_dir_xyz"), "dir exists after mkdir");
  assert(!mkdir("test_loft_dir_xyz").ok(), "mkdir on existing dir not ok");
  // Write a sentinel file then clean up via file delete
  {
    sentinel = file("test_loft_dir_xyz/sentinel.txt");
    sentinel += "x";
  }
  assert(exists("test_loft_dir_xyz/sentinel.txt"), "sentinel file created");
  assert(delete("test_loft_dir_xyz/sentinel.txt").ok(), "sentinel deleted");
  // mkdir_all creates nested directories
  assert(mkdir_all("test_loft_dir_xyz/a/b").ok(), "mkdir_all creates nested dirs");
  assert(exists("test_loft_dir_xyz/a/b"), "nested leaf exists");
  // mkdir outside project is rejected
  assert(!mkdir("../loft_outside_test").ok(), "mkdir outside project rejected");
  // === directory(), user_directory(), program_directory() ===
  cwd = directory();
  assert(len(cwd) > 0, "directory() is non-empty");
  home = user_directory();
  assert(len(home) > 0, "user_directory() is non-empty");
  prog = program_directory();
  assert(len(prog) > 0, "program_directory() is non-empty");
  // The subpath argument each of these has always advertised was ignored: the
  // parameter doubles as the buffer the result comes back in, and it was
  // cleared before being read, so `directory("sub")` returned the bare cwd.
  // Asserted by shape, not by separator — `Path::join` uses the platform's.
  assert(directory("sub").ends_with("sub"), "directory(v) appends v");
  assert(size(directory("sub")) > size(cwd), "directory(v) extends the cwd");
  assert(user_directory("cfg").ends_with("cfg"), "user_directory(v) appends v");
  assert(size(user_directory("cfg")) > size(home), "user_directory(v) extends home");
  assert(program_directory("assets").ends_with("assets"), "program_directory(v) appends v");
  assert(size(program_directory("assets")) > size(prog), "program_directory(v) extends it");
  // And it must be a DIRECTORY, as the name says: it used to be `current_exe()`
  // whole, so appending to it gave `…/loft/assets` — a path that cannot exist.
  assert(is_dir(prog), "program_directory() names a directory, not the binary");
}
