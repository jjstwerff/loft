//
// loft#961 — `env_variables()` was unusable on every backend.
//
// `Stores::os_variables` looked the element type up as `name("Variable")`, but the
// stdlib declares `EnvVariable` (`default/02_files.loft`).  `Data::name` answers
// `u16::MAX` for a name it does not know — a SENTINEL, not a type — and that sized
// the element at 0, so the vector's first `claim(0)` raised `Incomplete record` from
// deep inside `Store::claim`.  A bare `len(env_variables())` died, on the interpreter
// and on `--native` alike, and on the released 2026.8.0 binary too: the builtin had no
// working call at all, which is why no test caught the rename.
//
// The assertions avoid anything environment-specific ON PURPOSE.  The count is not
// stable — `--native` runs the program as a child process and sees a few more
// variables than the interpreter (48 vs 52 here) — and no single variable name is
// portable across the OSes this suite runs on.  What IS invariant is the shape:
//
//   * there is at least one variable (a zero-length vector would be the old bug
//     surviving as an empty answer rather than a panic);
//   * every entry has a non-empty NAME — the record is really two `text` fields, not
//     a zero-sized element read back as blanks;
//   * a name found through the vector round-trips through `env_variable()`, the
//     single-variable builtin, so the two halves of the env API agree.

fn main() {
  vs = env_variables();
  assert(len(vs) > 0, "env_variables() must return at least one variable");

  named = true;
  for v in vs {
    if size(v.name) == 0 { named = false; }
  }
  assert(named, "every entry carries a non-empty name");

  // Round-trip the first entry through the single-variable builtin.  Reading a
  // zero-sized record would give an empty name here, and `env_variable("")` answers
  // "" — so this cell only passes when the record layout is real.
  first_name = "";
  first_value = "";
  got = false;
  for v in vs {
    if !got { first_name = v.name; first_value = v.value; got = true; }
  }
  assert(got, "the loop saw the first entry");
  assert(size(first_name) > 0, "the first entry has a name");
  direct = env_variable(first_name);
  assert(direct == first_value,
         "env_variable('{first_name}') is '{direct}', env_variables() says '{first_value}'");

  print("961 ok\n");
}
