//
// Stability-sweep regression — a record whose payload is a SINGLE byte
// (a one-boolean struct, a closure capturing one boolean) must get a
// record large enough for that byte.  `Stores::claim` takes WORDS but
// both OpDatabase twins passed the type size in BYTES, so a 1-byte
// payload claimed 1 word total (header + type tag, ZERO payload bytes)
// and every field write landed one byte past the record — silent in
// release, caught by the armed-assert build (`store.rs` `valid()`).
// Cross-mode: interpreter + --native must agree.

struct OneBool { on: boolean? }
struct TwoBool { a: boolean, b: boolean? }

fn main() {
  // 1-byte struct record: construct, read, overwrite, read back.
  s = OneBool { on: true };
  assert(s.on == true, "one-bool ctor");
  s.on = false;
  assert(s.on == false, "one-bool reassign");
  s.on = null;
  assert(s.on == null, "one-bool null");

  // Closure record capturing exactly one boolean (the @PLN17 shape that
  // surfaced this): the captured byte lives in a 1-byte-payload record.
  flag = false;
  flip = fn() -> boolean { flag = !flag; flag };
  r1 = if flip() { 1 } else { 0 };
  r2 = if flip() { 1 } else { 0 };
  assert(r1 == 1 && r2 == 0, "one-bool closure capture: {r1} {r2}");

  // Boundary control: 2-byte payload was already sized correctly.
  t = TwoBool { a: true, b: null };
  t.a = false;
  assert(t.a == false && t.b == null, "two-bool control");

  println("299-single-byte-record ok");
}
