// Comparing two tuples — `==`, `!=`, `<`, `<=`, `>`, `>=`.
//
// Ordering is LEXICOGRAPHIC: the first element decides, and later elements are consulted
// only while the earlier ones are equal. That is the rule the written form already
// suggests, and the one every cell below pins — especially the tie cases, which are the
// only place `<` and `<=` differ and the only place an off-by-one in the chain shows.
//
// The comparison lowers to the ELEMENT types' own operators, so the interesting cells are
// the ones that ask whether the elements really decide: text compared by value rather than
// by identity, a nested tuple recursing, an element type with no `<` reporting itself
// rather than the tuple around it, and both spellings of a tuple (a stack literal and a
// `vector<(…)>` element) comparing the same way.

struct Counter { n: integer }
enum Colour { Red, Green, Blue }

/// An operand that is observable, for the evaluated-once cells.
fn bump(c: Counter) -> (integer, integer) { c.n = c.n + 1; (1, 2) }
fn mk(x: integer) -> (integer, text) { (x, "v{x}") }

fn main() {
  // Equality is every element equal; inequality is any element differing.
  a = (1, 2);
  b = (1, 2);
  c = (1, 3);
  assert(a == b, "equal tuples compare equal");
  assert(!(a == c), "a differing last element is not equal");
  assert(a != c, "and is unequal");
  assert(!(a != b), "equal tuples are not unequal");
  assert(a == a, "a tuple equals itself");

  // The FIRST element decides, whatever the rest say.
  assert((1, 9) < (2, 0), "(1,9) < (2,0) — the first element decides");
  assert(!((2, 0) < (1, 9)), "and not the other way round");
  assert((2, 0) > (1, 9), "the same fact through >");
  assert((5, 0, 0) > (1, 9, 9), "arity 3, still the first element");

  // Later elements only once the earlier ones tie. These four are what separate `<` from
  // `<=`: on identical tuples the strict forms must be false and the inclusive ones true.
  assert((1, 9) < (1, 10), "an equal first element falls through to the second");
  assert(!((1, 9) < (1, 9)), "identical tuples are not strictly less");
  assert(!((1, 9) > (1, 9)), "nor strictly greater");
  assert((1, 9) <= (1, 9), "but are less-or-equal");
  assert((1, 9) >= (1, 9), "and greater-or-equal");
  assert(!((1, 10) <= (1, 9)), "a greater second element is not <=");

  // The tie running two deep, so the chain is not just "first vs rest".
  assert((1, 2, 3) < (1, 2, 4), "arity 3, only the last element differs");
  assert(!((1, 2, 4) < (1, 2, 3)), "and its mirror");
  assert((1, 2, 3) <= (1, 2, 3), "arity 3 <= on identical tuples");
  assert((1, 2, 3) != (1, 2, 4), "arity 3 inequality reaches the last element");

  // Element types other than integer decide the same way they do on their own.
  assert((1.5, 2.5) < (1.5, 2.6), "float elements");
  assert((1.5, 2.5) == (1.5, 2.5), "float equality");
  assert(('a', 1) < ('b', 0), "character elements");
  assert((Colour.Red, 1) < (Colour.Blue, 0), "scalar enum elements order by declaration");
  assert((Colour.Green, 2) == (Colour.Green, 2), "enum equality");
  assert((true, 1) == (true, 1), "boolean equality");
  assert((true, 1) != (false, 1), "boolean inequality");

  // Text is compared BY VALUE. Two separately built texts are equal, which is the whole
  // point — a reference-identity answer would say they are not.
  t1 = (1, "abc");
  t2 = (1, "abc");
  assert(t1 == t2, "text elements compare by value, not by identity");
  assert((1, "abc") < (1, "abd"), "text elements order lexically");
  assert((1, "abc") < (2, "aaa"), "an integer first element still decides over text");

  // A nested tuple element recurses into the same rule.
  assert(((1, 2), 3) < ((1, 2), 4), "nested element ties, the outer last element decides");
  assert(((1, 2), 3) < ((1, 3), 0), "the nested element itself decides");
  assert(((1, 2), 3) != ((1, 3), 3), "nested inequality");

  // Each operand is evaluated ONCE, though every element read names its side again.
  cc = Counter { n: 0 };
  dd = Counter { n: 0 };
  eq = bump(cc) == bump(dd);
  assert(eq, "both calls return (1, 2)");
  assert(cc.n == 1, "the left operand is evaluated once: {cc.n}");
  assert(dd.n == 1, "the right operand is evaluated once: {dd.n}");

  // The STORED spelling — a `vector<(…)>` element — compares like the stack one, against a
  // literal, against a local, and against another element.
  v: vector<(integer, integer)> = [(1, 2), (1, 3)];
  hits = 0;
  for p in v { if p == (1, 3) { hits = hits + 1; } }
  assert(hits == 1, "a loop variable against a literal: {hits}");
  ref = (1, 3);
  found = false;
  for p in v { if p >= ref { found = true; } }
  assert(found, "a loop variable against a local");
  assert((v[0] ?? (0, 0)) < (v[1] ?? (0, 0)), "two index reads");
  assert((v[0] ?? (0, 0)) != (v[1] ?? (0, 0)), "and they differ");

  // BOTH sides in the stored spelling — neither operand is a stack tuple to begin with.
  b1: vector<(integer, integer)> = [(1, 2), (3, 4)];
  b2: vector<(integer, integer)> = [(3, 4), (5, 6)];
  same = 0;
  for p in b1 { for q in b2 { if p == q { same = same + 1; } } }
  assert(same == 1, "two loop variables compared: {same}");
  lower = 0;
  for p in b1 { for q in b2 { if p < q { lower = lower + 1; } } }
  assert(lower == 3, "lexicographic across two loop variables: {lower}");

  // Heap-carrying tuples, which travel as records: still compared by their values.
  hv: vector<(integer, text)> = [mk(1), mk(2)];
  assert((hv[0] ?? (0, "")) < (hv[1] ?? (0, "")), "stored heap-carrying tuples");
  assert(mk(3) == mk(3), "two boxed returns compare by value");
  assert(mk(3) != mk(4), "and differ when they should");
}
