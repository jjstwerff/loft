//
// Filling a linked collection group reaches every member, whichever member it is
// spelled through and whatever kinds the members are.
//
// Two or more collections over one element type in one struct are auto-linked into
// several routes to a SINGLE record set (`Field.other_indexes`, loft#843). Three
// pair shapes never got the second route: `hash` + `index` kept ONE element however
// many went in, `hash` + `hash` built the right NUMBER of entries all naming the
// first record, and `sorted` + `sorted` / `vector` + `sorted` stayed empty. No
// diagnostic — a lookup through the second route simply missed, so a smoke test with
// a single element passed. Identical on both backends and on the published 2026.8.0.
//
// One fact explains all of them: every member names its elements by a 4-byte record
// id. A hash slot encodes `rec.rec` (`hash::SLOT_RECORD`), an `array` / `ordered`
// slot stores it raw and reads it back at a hard-coded payload start, and an `index`
// keeps its red-black links in FIELDS of the record. None can express a position
// INSIDE a record, so an element that does not own one is unaddressable through its
// siblings — and two shapes made elements that do not: a hash packs its entries into
// a shared chunk arena, and a `sorted` stores its elements inline.
//
// `record_new` already refuses the arena for an element type flagged `linked`, and
// `finish_type` already promotes `vector` → `array` and `sorted` → `ordered` for one.
// The flag was only ever set as a SIDE EFFECT of that promotion, so a group whose
// members are all keyed never set it. It is now set for every group element type.
//
// The cells check CONTENTS, not just length: `hash` + `hash` had the right length
// with every entry naming the same record, which is exactly what a length cannot
// see.
//
// **Every row has its OWN element type, and that is what makes this file bite.**
// The promotion is keyed on the element type across the WHOLE program, so one
// `vector<E>` beside one `hash<E[k]>` anywhere makes every other collection over `E`
// record-backed and every row below passes on the unfixed build. Written over a
// shared `E` this file printed `901 ok` on the published 2026.8.0 — a guard that
// could not fail. Rows a1/a4 are the two ends of that: a1 has no vector or sorted
// member at all, a4 has no hash or index one.
//
// The controls carry the scope. c1 pins that a plain `vector` as the SECOND field IS a
// group member: membership is a fact about the PAIR, so the same two fields mean the
// same thing in either order (@FR-Col-Group). This cell read `0` and this file pinned
// that as the boundary, on the reasoning that widening the test to any collection would
// make two independent vectors alias — which a BOTH-SIDES test does not do, since two
// vectors are still two non-keyed kinds (loft#1158; the aliasing control it names lives
// in `1158-a-group-forms-whichever-member-is-declared-first.loft`). c2 is the same
// mistake one kind over: a `trie` second field IS keyed, so it joins the group. It too
// used to read 0 here and was pinned as the scope — the defect, not the boundary, since
// a trie was simply missing from the test that forms a group (loft#927). c3 pins a LONE
// hash, which must keep packing its entries into the arena (@PLN135 arc H): a fix that
// made every hash allocate one record per entry would pass every row above and
// silently give back that plan's win.

struct E1 { k: integer, n: text }
struct E2 { k: integer, n: text }
struct E3 { k: integer, n: text }
struct E4 { k: integer, n: text }
struct E5 { k: integer, n: text }
struct E6 { k: integer, n: text }
struct E7 { k: integer, n: text }
struct E8 { k: integer, n: text }
struct E9 { k: integer, n: text }

struct HI { a: hash<E1[k]>, b: index<E1[k]> }
struct HH { a: hash<E2[k]>, b: hash<E2[k]> }
struct SS { a: sorted<E3[k]>, b: sorted<E3[k]> }
struct VS { a: vector<E4>, b: sorted<E4[k]> }
struct IH { a: index<E5[k]>, b: hash<E5[k]> }
struct SSS { a: sorted<E6[k]>, b: sorted<E6[k]>, c: sorted<E6[k]> }
struct HV { a: hash<E7[k]>, b: vector<E7> }
struct ST { a: sorted<E8[k]>, b: trie<E8[n]> }
struct LoneH { a: hash<E9[k]>, tag: integer }

// Sum of the keys and of the name lengths over one member — order-independent, and
// it separates "two entries" from "two entries naming one record" (which reads back
// k 1+1 = 2 and n 5+5 = 10 instead of k 1+2 = 3 and n 5+4 = 9).
fn tally(k: integer, n: integer, who: text, want_len: integer, len_got: integer) {
  assert(len_got == want_len, "{who}: len = {len_got}, want {want_len}");
  assert(k == 3, "{who}: key sum = {k}, want 3 (1 + 2)");
  assert(n == 9, "{who}: name bytes = {n}, want 9 (alpha + beta)");
}

fn main() {
  // ---- a1: hash + index — the index kept only the first element ----------------
  a1 = HI { a: [], b: [] };
  a1.a = [E1{k:1,n:"alpha"}, E1{k:2,n:"beta"}];
  ka = 0; na = 0; for e1 in a1.a { ka += e1.k; na += len(e1.n); }
  kb = 0; nb = 0; for e1b in a1.b { kb += e1b.k; nb += len(e1b.n); }
  tally(ka, na, "a1 hash", 2, len(a1.a));
  tally(kb, nb, "a1 index", 2, len(a1.b));
  // The lookup is the point of a second route, so pin it rather than the length.
  assert((a1.b[2] ?? E1{k:0,n:""}).n == "beta", "a1: index lookup of key 2 missed");

  // ---- a2: hash + hash — right length, every entry naming the first record ------
  a2 = HH { a: [], b: [] };
  a2.a += [E2{k:1,n:"alpha"}];
  a2.a += [E2{k:2,n:"beta"}];
  ka2 = 0; na2 = 0; for e2 in a2.b { ka2 += e2.k; na2 += len(e2.n); }
  tally(ka2, na2, "a2 second hash", 2, len(a2.b));

  // ---- a3: sorted + sorted — the view was never populated at all ----------------
  a3 = SS { a: [], b: [] };
  a3.a = [E3{k:1,n:"alpha"}, E3{k:2,n:"beta"}];
  ka3 = 0; na3 = 0; for e3 in a3.b { ka3 += e3.k; na3 += len(e3.n); }
  tally(ka3, na3, "a3 second sorted", 2, len(a3.b));

  // ---- a4: vector + sorted — same, and the pairing needs no index anywhere ------
  a4 = VS { a: [], b: [] };
  a4.a = [E4{k:1,n:"alpha"}, E4{k:2,n:"beta"}];
  ka4 = 0; na4 = 0; for e4 in a4.b { ka4 += e4.k; na4 += len(e4.n); }
  tally(ka4, na4, "a4 sorted view", 2, len(a4.b));
  assert((a4.b[1] ?? E4{k:0,n:""}).n == "alpha", "a4: sorted lookup of key 1 missed");

  // ---- b1: spelled through the VIEW — neither member is the privileged one ------
  b1 = IH { a: [], b: [] };
  b1.b = [E5{k:1,n:"alpha"}, E5{k:2,n:"beta"}];
  kb1 = 0; nb1 = 0; for e5 in b1.a { kb1 += e5.k; nb1 += len(e5.n); }
  tally(kb1, nb1, "b1 index reached through the hash", 2, len(b1.a));

  // ---- b2: three members, one fill ---------------------------------------------
  b2 = SSS { a: [], b: [], c: [] };
  b2.a = [E6{k:1,n:"alpha"}, E6{k:2,n:"beta"}];
  kb2 = 0; nb2 = 0; for e6 in b2.b { kb2 += e6.k; nb2 += len(e6.n); }
  kc2 = 0; nc2 = 0; for e6c in b2.c { kc2 += e6c.k; nc2 += len(e6c.n); }
  tally(kb2, nb2, "b2 second sorted", 2, len(b2.b));
  tally(kc2, nc2, "b2 third sorted", 2, len(b2.c));

  // ---- c1: a plain vector as the SECOND field IS a group member ----------------
  c1 = HV { a: [], b: [] };
  c1.a = [E7{k:1,n:"alpha"}, E7{k:2,n:"beta"}];
  assert(len(c1.a) == 2, "c1 hash len = {len(c1.a)}, want 2");
  assert(len(c1.b) == 2, "c1 vector len = {len(c1.b)}, want 2 — a group is order-independent");

  // ---- c2: a trie IS a group member, like every other keyed kind ---------------
  c2 = ST { a: [], b: [] };
  c2.a = [E8{k:1,n:"alpha"}, E8{k:2,n:"beta"}];
  assert(len(c2.a) == 2, "c2 sorted len = {len(c2.a)}, want 2");
  assert(len(c2.b) == 2, "c2 trie len = {len(c2.b)}, want 2 — a trie joins the group");

  // ---- c3: a lone hash keeps its arena — it has no sibling to be addressed by ---
  c3 = LoneH { a: [], tag: 7 };
  c3.a = [E9{k:1,n:"alpha"}, E9{k:2,n:"beta"}];
  kc3 = 0; nc3 = 0; for e9 in c3.a { kc3 += e9.k; nc3 += len(e9.n); }
  tally(kc3, nc3, "c3 lone hash", 2, len(c3.a));
  assert(c3.tag == 7, "c3 tag = {c3.tag}, want 7");

  println("901 ok");
}
