//
// `a == null` on a GENERIC parameter picked its null test at TEMPLATE time, and the
// monomorph kept it.
//
// Which test `τ`'s null wants is a function of `τ` — a collection reads a store_nr
// sentinel, a float reads NaN, an enum reads a discriminant, a nullable reference reads
// its own sentinel, and everything else compares against the typed null.  Inside a
// template `T?` is `Optional(Reference(<type var>))` and the placeholder is a STRUCT, so
// the REFERENCE branch won for every instantiation: `OpRefIsNull` over an 8-byte
// `integer` slot panicked the interpreter and would not compile on `--native`
// (E0610 `.store_nr` on an `i64`).
//
// ⚠ The panic was not the whole defect.  A `text` instantiation neither panicked nor
// refused — it answered the comparison INVERTED, false for an omitted argument and true
// for a supplied one, which is the cell a crash-shaped repro cannot see.
//
// The cure is the one loft#1016 used for the DEFAULT of the same declaration: the site
// is stamped and answered per monomorph, where `T` is real.  Doing it any other way
// would mint a sixth spelling of "what is `τ`'s null", which is the defect loft#1014
// was — so the parse site and the monomorph call ONE `null_test`.

pub fn isn1020 < T > (v: vector<T>, a: T? = null) -> boolean { len(v) >= 0 && a == null }
pub fn nn1020 < T > (v: vector<T>, a: T? = null) -> boolean { len(v) >= 0 && a != null }
pub fn isnv1020 < T > (v: vector<T>, a: T? = null) -> boolean { len(v) >= 0 && a == null }
pub fn bare1020 < T: Addable > (a: T) -> boolean { a == null }

struct S1020 { a: integer }

fn test_an_integer_instantiation_answers_its_own_null() {
  // The filed cell: this panicked on the interpreter and would not compile on --native.
  assert(isn1020([1]), "an omitted integer argument is null");
  assert(!isn1020([1], 5), "a supplied integer argument is not null");
}

fn test_a_float_instantiation_answers_its_own_null() {
  // A float null is the NaN sentinel, and NaN compares unequal to everything — so an
  // equality here can only ever answer false, whichever sentinel it reads.
  assert(isn1020([1.5]), "an omitted float argument is null");
  assert(!isn1020([1.5], 2.5), "a supplied float argument is not null");
}

fn test_a_text_instantiation_answered_the_comparison_inverted() {
  // The silent cell.  Before the fix this read false / true — the exact opposite, with
  // no panic, no refusal and no diagnostic.
  assert(isn1020(["x"]), "an omitted text argument is null");
  assert(!isn1020(["x"], "y"), "a supplied text argument is not null");
}

fn test_a_struct_instantiation_still_reads_its_reference_sentinel() {
  // The one instantiation the template's guess happened to be right for — it must stay
  // right, which is what makes this a dispatch and not a replacement.
  assert(isn1020([S1020 { a: 1 }]), "an omitted struct argument is null");
  assert(!isn1020([S1020 { a: 1 }], S1020 { a: 2 }), "a supplied struct argument is not null");
}

fn test_a_collection_instantiation_reads_its_own_sentinel() {
  // Its own generic: one template instantiated at both `vector<X>` and `X` in a single
  // file is refused for reasons of its own, unchanged by this fix and unrelated to it.
  vv: vector<vector<integer>> = [[1]];
  assert(isnv1020(vv), "an omitted vector argument is null");
  assert(!isnv1020(vv, [2]), "a supplied vector argument is not null");
}

fn test_the_negated_spelling_answers_the_same_question() {
  // `!=` is the same op with the answer flipped, so it has to defer identically.
  assert(!nn1020([1]), "an omitted integer argument is not non-null");
  assert(nn1020([1], 5), "a supplied integer argument is non-null");
  assert(!nn1020(["x"]), "an omitted text argument is not non-null");
  assert(nn1020(["x"], "y"), "a supplied text argument is non-null");
}

fn test_every_instantiation_in_one_program_gets_its_own_answer() {
  // One template, four monomorphs: the site is answered per instantiation, not once.
  s = "";
  if isn1020([1]) { s = "{s}i" }
  if isn1020([1.5]) { s = "{s}f" }
  if isn1020(["x"]) { s = "{s}t" }
  if isn1020([S1020 { a: 1 }]) { s = "{s}s" }
  assert(s == "ifts", "all four instantiations read their own null, got {s}");
}

fn test_a_non_nullable_type_variable_agrees_with_its_concrete_spelling() {
  // `fn f(a: integer) { a == null }` answers false, so the generic must too.  It used to
  // be refused outright — "generic type T: operator '==' requires a concrete type" —
  // which is the template being unable to decide, not the language saying no.
  assert(!bare1020(5), "a non-null integer is not null");
  assert(!bare1020(0), "and zero is not null either");
}

