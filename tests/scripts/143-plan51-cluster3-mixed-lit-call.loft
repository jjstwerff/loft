// Probe 04 — Struct-literal Set then Call Set then tail.
//
//   fn render_lit_then_call(p: P) -> Canvas {
//     cv = Canvas { data: [], w: 1 };     // First Set — struct literal RHS
//     cv = alloc_canvas(4, 5, p.tag);     // Second Set (S1-substituted, S2 fires)
//     cv
//   }
//
// The first Set has a struct-literal RHS, not a Call.  S1 doesn't fire
// (S1's pattern matches `Set(cv, Call(...))`).  S2's `s1_substituted`
// check is `value.unspan()` being `Value::Call(_, args)` with `args`
// containing `Var(v)` — for a struct-literal RHS, the outer Value is not
// Call, so S2 returns false → pre-Set OpFreeRef on cv FIRES.
//
// This is structurally similar to probe 02 but with an explicit struct
// literal as the first RHS — likely manifests the same corruption when
// run in an interleaved-fn context.
//
// Expected: FAIL on --interpret in interleaved context.
// Status: known broken.  Possibly same fix surface as probe 02 (extended
// S1 / parse-time substitution for struct-literal RHS into hidden buffer).

struct P {
  tag: integer,
}
struct Q {
  tag: integer,
}
struct Canvas {
  data: vector<integer>,
  w: integer,
}

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render_lit_then_call(p: P) -> Canvas {
  cv = Canvas { data: [], w: 1 };
  cv = alloc_canvas(4, 5, p.tag);
  cv
}

fn render_direct(q: Q) -> Canvas {
  cv = alloc_canvas(7, 9, q.tag * 2); cv
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    q = Q { tag: i + 100 };
    cv_c = render_lit_then_call(p);
    cv_d = render_direct(q);
    assert(cv_c.w == 4, "iter {i}: cv_c.w = {cv_c.w}");
    assert(len(cv_c.data) == 5, "iter {i}: len(cv_c) = {len(cv_c.data)}");
    assert(cv_c.data[0] == i, "iter {i}: cv_c[0] = {cv_c.data[0]}");
    assert(cv_d.data[0] == (i + 100)*2, "iter {i}: cv_d[0] = {cv_d.data[0]}");
  }
  println("probe 04 PASSED");
}
