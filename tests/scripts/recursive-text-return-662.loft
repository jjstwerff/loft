//
// Regression: a SELF-recursive function returning `text` failed to compile with a
// bogus arity miscount — "Too few parameters on n_f (got 2, need 3)" — reported at
// the call site even though it passed exactly the declared number of arguments
// (loft#662, both backends).
//
// A call to a text-returning function has to hand the callee a `&text` out-param
// buffer, and that buffer was minted from the SAME counter as the body's format
// buffers (`__work_N`).  For a self-recursive callee the buffer only becomes
// necessary on pass 2 — pass 1 has not promoted the signature yet when it parses
// the recursive call — so pass 2 minted one extra `__work_N` before the format
// buffers, shifting every later number by one.  The variable tables persist across
// passes BY NAME, so pass 2's buffers then re-found pass 1's variables under the
// wrong roles: the return buffer landed on a fresh name (appending a second hidden
// parameter, which is the arity miscount) and an ordinary local landed on the
// variable pass 1 had promoted to a `&text` parameter.
//
// Fixed by giving the caller-allocated buffer its own counter, exactly as the
// vector/enum caller retbuf already had (`work_vdb`), which leaves `__work_N`
// driven only by the body's format sites — those ARE pass-stable.

fn r662_tail(n: integer) -> text {
  if n <= 0 { return "x"; }
  sub = r662_tail(n - 1);
  return "{sub}y";
}

// Two work buffers in one recursive body: the second buffer is what the shifted
// counter aliased onto a promoted parameter (emitting an undeclared `var___work_1`
// natively, and a truncated value on the interpreter).
fn r662_two_buffers(n: integer) -> text {
  if n <= 0 { return "x"; }
  sub = r662_two_buffers(n - 1);
  mid = "[{sub}]";
  return "{mid}y";
}

// Concatenation rather than interpolation.
fn r662_concat(n: integer) -> text {
  if n <= 0 { return "x"; }
  sub = r662_concat(n - 1);
  return sub + "y";
}

// Recursion under an extra parameter.
fn r662_two_args(n: integer, s: text) -> text {
  if n <= 0 { return s; }
  sub = r662_two_args(n - 1, s);
  return "{sub}y";
}

// A nullable text return takes the same work-buffer promotion.
fn r662_optional(n: integer) -> text? {
  if n <= 0 { return "x"; }
  sub = r662_optional(n - 1) ?? "?";
  return "{sub}y";
}

// MUTUAL recursion — the forward callee is promoted after this call site parses.
fn r662_a(n: integer) -> text {
  if n <= 0 { return "a"; }
  sub = r662_b(n - 1);
  return "{sub}A";
}
fn r662_b(n: integer) -> text {
  if n <= 0 { return "b"; }
  sub = r662_a(n - 1);
  return "{sub}B";
}

// The recursive call inside a loop reuses the caller buffer every iteration.
fn r662_in_loop(n: integer) -> text {
  if n <= 0 { return "x"; }
  acc = "";
  k = 0;
  while k < 2 { acc = "{acc}{r662_in_loop(n - 1)}"; k += 1; }
  return "{acc}|";
}

fn test_recursive_text_return() {
  assert(r662_tail(3) == "xyyy", "self-recursive text return: {r662_tail(3)}");
  assert(r662_two_buffers(2) == "[[x]y]y", "two work buffers: {r662_two_buffers(2)}");
  assert(r662_concat(3) == "xyyy", "concat tail: {r662_concat(3)}");
  assert(r662_two_args(3, "A") == "Ayyy", "extra parameter: {r662_two_args(3, "A")}");
  assert((r662_optional(3) ?? "NULL") == "xyyy", "optional text return: {r662_optional(3) ?? "NULL"}");
  // a(3)=b(2)+"A", b(2)=a(1)+"B", a(1)=b(0)+"A"="bA" -> "bAB" -> "bABA"
  assert(r662_a(3) == "bABA", "mutual recursion: {r662_a(3)}");
  assert(r662_in_loop(2) == "xx|xx||", "recursion in a loop: {r662_in_loop(2)}");
}
