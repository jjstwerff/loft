// Probe 21 — high iteration count to confirm leak class scaling.
//
// Same shape as probe 02 (double-Set leak), but 100 iters instead of 6.
// If the leak is per-iter, we should see Canvas×100.  If it's a finite
// one-time leak, the count should plateau.

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render_double(p: P) -> Canvas {
  cv = alloc_canvas(3, 3, p.tag);
  cv = alloc_canvas(4, 5, p.tag + 1);
  cv
}

fn main() {
  for i in 0..100 {
    p = P { tag: i };
    cv = render_double(p);
    assert(cv.w == 4, "iter {i}: w = {cv.w}");
    assert(len(cv.data) == 5, "iter {i}: len = {len(cv.data)}");
    assert(cv.data[0] == i + 1, "iter {i}: data[0] = {cv.data[0]}");
  }
  println("probe 21 PASSED");
}
