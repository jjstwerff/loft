// Corruption-detection probe for @P377.  Two struct-param fns each returning a
// fresh Canvas, exercised in interleaved loops with value-asserting reads on
// every iteration.  The documented silent-corruption mode is "null reads when
// >= 2 such fns coexist" — assertions on the returned Canvas's data length and
// element values catch that.

struct P {
  tag: integer,
}
struct Q {
  tag: integer,
}
struct Canvas {
  data: vector<integer>,
  w: integer,
}

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render_p(p: P) -> Canvas {
  cv = alloc_canvas(4, 5, p.tag); cv
}
fn render_q(q: Q) -> Canvas {
  cv = alloc_canvas(7, 9, q.tag * 2); cv
}

fn main() {
  // Interleaved: each iteration calls BOTH fns (the ">= 2 coexist" condition).
  for i in 0..12 {
    p = P { tag: i };
    q = Q { tag: i + 100 };
    cv_p = render_p(p);
    cv_q = render_q(q);
    // Assert structure (catches null reads / store reuse corruption).
    assert(cv_p.w == 4, "iter {i}: cv_p.w = {cv_p.w} (expect 4)");
    assert(cv_q.w == 7, "iter {i}: cv_q.w = {cv_q.w} (expect 7)");
    assert(len(cv_p.data) == 5, "iter {i}: len(cv_p.data) = {len(cv_p.data)} (expect 5)");
    assert(len(cv_q.data) == 9, "iter {i}: len(cv_q.data) = {len(cv_q.data)} (expect 9)");
    // Assert each element matches the seed (catches mid-vector corruption).
    for k in 0..5 {
      assert(cv_p.data[k] == i, "iter {i} k {k}: cv_p[{k}] = {cv_p.data[k]} (expect {i})");
    }
    for k in 0..9 {
      assert(
        cv_q.data[k] == (i + 100)*2,
        "iter {i} k {k}: cv_q[{k}] = {cv_q.data[k]} (expect {(i + 100) * 2})"
      );
    }
  }
  println("corruption test PASSED");
}
