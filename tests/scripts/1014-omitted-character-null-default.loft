//
// `character` had FOUR spellings of its own null, and the two backends picked different ones.
//
// `types.md` pins one: `Char`'s in-band sentinel is CODEPOINT 0 — the same `'\0'` that
// `construct_default(Character)` answers, that `op_conv_bool_from_character` tests for, and
// that the parser's `null()` emits via `OpConvCharacterFromNull`.  Two sites disagreed:
//
//   · the interpreter's `emit_typed_null` grouped `Character` with `Integer` and pushed EIGHT
//     bytes of `i64::MIN` into a FOUR-byte slot.  It read as null only because the low word of
//     `i64::MIN` is zero on a little-endian box — right by accident, at the wrong width.
//   · `--native`'s `write_typed_null_in` wrote `i32::MIN`, which is not codepoint 0 at all, so
//     `a == null` on an omitted `character? = null` answered FALSE while the interpreter said
//     true.  `ops::to_char` reaches that value through `from_u32_unchecked`, for which
//     `0x8000_0000` is undefined behaviour.
//
// And a `character?` DISCHARGE would not compile on `--native` in any form: the `?` lowers to
// an `If`, which was not on the four-node-kind allow-list that decides the `ops::to_char`
// wrap, so the template compared an `i32` against `char::from(0)` (rustc E0308).  That list is
// a type test now — an operand of a character-typed parameter arrives as the i32 storage form
// whatever produced it.
//
// Every assertion below is a cell of the boundary matrix, on BOTH backends (loft#1014).

fn c1014(a: character? = null) -> boolean { a == null }
fn d1014(a: character? = null) -> boolean { (a?) == '\0' }
fn r1014(a: character? = null) -> character { a? }
fn tail1014(a: character? = null, b: integer = 7) -> integer { if a == null { b } else { b * 10 } }

fn test_an_omitted_character_default_is_null_on_both_backends() {
  assert(c1014() == true, "an omitted `character? = null` IS null");
  assert(c1014('z') == false, "a supplied character is not null");
  // The collision types.md documents: codepoint 0 IS the sentinel, so a literal `'\0'`
  // reads as null.  Asserted so the cost stays visible rather than becoming a surprise.
  assert(c1014('\0') == true, "a supplied '\\0' reads as null — the in-band sentinel collides");
}

fn test_the_discharge_answers_the_types_zero() {
  // `(D-Scalar) construct_default(Character) = '\0'`.  This is also the cell `--native`
  // could not COMPILE: the `?` discharge is an `If`, and the wrap was chosen by node kind.
  assert(d1014() == true, "an omitted character? discharges to '\\0'");
  assert(d1014('z') == false, "a supplied character survives the discharge");
  assert(r1014() == '\0', "the discharged value returned out of the function is '\\0'");
  assert(r1014('q') == 'q', "a supplied character is returned unchanged");
}

fn test_the_slot_width_does_not_disturb_its_neighbours() {
  // The interpreter pushed 8 bytes for a 4-byte slot.  A parameter AFTER the omitted
  // character is what would show a spill.
  assert(tail1014() == 7, "the parameter after an omitted character keeps its default");
  assert(tail1014('z', 3) == 30, "a supplied pair still lands in the right slots");
}
