//
// @PLN125 arc A step A1 — an interface may DECLARE an associated type, and
// declaring one changes nothing.
//
//   interface SqlDb {
//     type Rows: SqlRows
//     fn select(self: Self, sql: text) -> Self.Rows   // A2, not yet
//   }
//
// A1 is deliberately inert: the contract can be written before anything reads
// it, so every existing program stays byte-identical in IR and native Rust and
// a program that declares one behaves exactly as it does today. A2 resolves
// `Self.Rows` to the concrete companion; until then the declaration only
// reserves the syntax.
//
// The bound is parsed and DISCARDED rather than rejected. Writing
// `type Rows: SqlRows` and having it mean less than it says is the point of an
// inert step — refusing the bound would force the consumer to edit the same
// line again at A2.
//
// What this file pins is that the surrounding interface still works: the
// declaration must not disturb method registration, bounded-generic
// satisfaction, or dispatch. Malformed forms (`type` with no name, a bound with
// no interface) are diagnosed, and that is checked in tests/errors.

interface SqlRows {
  fn row_width(self: Self) -> integer
}

interface SqlDb {
  // A bound, an un-bounded one, and a multi-bound — every shape A2 must resolve.
  type Rows: SqlRows
  type Plain
  type Both: SqlRows + SqlDb
  fn db_width(self: Self) -> integer
  fn db_name(self: Self) -> text
}

struct Conn {
  n: integer,
  label: text,
}

fn db_width(self: Conn) -> integer { return self.n; }
fn db_name(self: Conn) -> text { return self.label; }

// The declaration must not stop `Conn` satisfying `SqlDb` — satisfaction is
// structural over the METHODS, and an associated type nothing reads yet cannot
// be part of that judgement.
fn width_of<D: SqlDb>(d: D) -> integer { return d.db_width(); }
fn name_of<D: SqlDb>(d: D) -> text { return d.db_name(); }

// An interface with NO associated type has to keep working beside one that has
// them — the parse is per-body, so a shared code path would show up here.
interface Plain2 {
  fn twice(self: Self) -> integer
}
struct Num { v: integer }
fn twice(self: Num) -> integer { return self.v * 2; }
fn twice_of<P: Plain2>(p: P) -> integer { return p.twice(); }

fn main() {
  c = Conn { n: 7, label: "conn" };
  assert(width_of(c) == 7, "a bounded generic still dispatches on the interface");
  assert(name_of(c) == "conn", "and a text-returning method still does too");
  assert(c.db_width() == 7, "the method is still callable directly");

  n = Num { v: 21 };
  assert(twice_of(n) == 42, "an interface with no associated type is unaffected");

  println("pln125 a1 associated type inert ok");
}
