// loft#1035 — a generator may take a `text?` parameter.
//
// The coroutine emitter builds a state STRUCT for the generator, and it decided
// "String field or scalar field?" by matching `Type::Text` unpeeled — at eight separate
// sites.  A `text?` parameter is a `String` field (that comes from `rust_type`, which
// does peel), so the sites disagreed: the factory filled the `String` field with a bare
// `&str` (rustc E0308) and the body then MOVED it out of `&mut self` (E0507).  The
// generator did not compile at all on `--native` while `--interpret` ran it — the
// divergence `formal/operational.md` D-op-1 forbids.  @PLN25 settles which side is right:
// `Optional(τ)` shares τ's storage exactly, so a `text?` slot IS a `String` slot, and the
// eight sites now read one `is_text_slot`.
// The filed repro reads the parameter nowhere — declaring it was enough to break the
// build — so the never-read warning is part of the shape under test.
// @EXPECT_WARNING: Parameter a is never read
fn unused(a: text?) -> iterator<text> { yield "x"; }
fn discharged(a: text?) -> iterator<text> { yield a ?? "d"; }
fn via_local(a: text?) -> iterator<text> { b = a; yield b ?? "d"; yield "z"; }
fn in_a_loop(a: text?, b: integer) -> iterator<text> {
  for i in 0..b { yield "{a ?? "d"}{i}"; }
}
fn plain(a: text) -> iterator<text> { yield a; }
fn number(a: integer?) -> iterator<integer> { yield a ?? -1; }

fn main() {
  // The filed shape: declaring the parameter is enough, it need never be read.
  n = 0;
  for y in unused("k") { n += 1; _ = y; }
  assert(n == 1, "generator with an unread text? parameter");

  // Read the parameter, present and absent.
  s = "";
  for y in discharged("k") { s += y; }
  for y in discharged(null) { s += y; }
  assert(s == "kd", "text? parameter read on both sides of the discharge");

  // Bound to a persistent local first — its own struct field, same decision.
  t = "";
  for y in via_local(null) { t += y; }
  assert(t == "dz", "text? parameter through a persistent local");

  // The eager-collect (for-body) factory is a second emitter of the same struct.
  u = "";
  for y in in_a_loop("k", 2) { u += y; }
  assert(u == "k0k1", "text? parameter inside a generator's own loop");

  // Regressions: the non-null text parameter and the integer? twin, which both worked.
  v = "";
  for y in plain("k") { v += y; }
  assert(v == "k", "plain text parameter");
  w = 0;
  for y in number(null) { w += y; }
  assert(w == -1, "integer? parameter");
}
