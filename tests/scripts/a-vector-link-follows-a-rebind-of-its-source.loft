//
// A `&` link to a VECTOR local follows a rebind of its source, in both directions
// (loft#1392).
//
// `formal/binding.md` `(B-Ref-Alias)` makes a `&`-annotated binding *a live LINK to the source
// instead of a copy*, and `(B-Ref-Uniform)` says a `&τ` variable is used exactly like a `τ`
// variable.  A vector link is not a stack deref but a SHARE of the source's `DbRef` — the
// lowering a `&vector` parameter already takes — so a fresh backing on EITHER side re-points
// one of the two and the link stops being live.  loft#1371 gave the link side the cure: a
// whole-value write through the link clears the SHARED store and refills it in place
// (`@FR-B-Ref-Write`).  The source's own whole-value write is the same question one step out
// and had no cure, so `q = &v; v = [7, 8, 9]` left `q` on the store `v` held AT THE BIND —
// `len(q)` answered 2 where `len(v)` answered 3, on both backends and with nothing said.
//
// Registering the SOURCE in the same set is the fix, and it is gated to pass 2 on purpose: the
// set outlives a pass, so a registration made when the LINK is parsed would reach the source's
// own DECLARATION when pass 2 re-reads the body from the top — dropping the allocation that
// gives the source a backing store at all.  Measured: `v = []` after a link then compiled to a
// clear of a variable native had never declared.  Pass 2 reads the body in order, so the
// declaration is parsed before the link registers and only the later rebinds are in place.
//
// Every other spelling of the link already followed a rebind and is here as a CONTROL: a link
// to a struct or a text local (through `OpCreateStack`, loft#1371), and a link to a struct
// FIELD, whose rebuild is in place already.  So are the writes that must keep working in both
// directions — element, append and whole-value, through the link and through the source — and
// a plain vector local with no link, which must still mint on a rebind.
//
// @falsified-at: 3360fb93 — interpret exit 1 -> 0 with 4 assertion failures -> 0, native
//   exit 1 -> 0 with 1 -> 0 (native stops at the first failing test; the interpreter runs
//   them all).  The controls unmoved on both.

struct H { data: vector<integer> }

fn test_the_link_follows_a_source_rebind() {
  v = [1, 2];
  q = &v;
  v = [7, 8, 9];
  assert(len(q) == 3 && len(v) == 3, "len: got {len(q)} {len(v)}, want 3 3");
  assert((q[0] ?? 0) == 7, "value: got {q[0] ?? 0}, want 7");
}

fn test_the_annotated_spelling() {
  v = [1, 2];
  q: &vector<integer> = v;
  v = [7, 8, 9];
  assert(len(q) == 3 && (q[0] ?? 0) == 7, "annotated: got {len(q)} {q[0] ?? 0}, want 3 7");
}

fn test_two_source_rebinds() {
  v = [1, 2];
  q = &v;
  v = [7, 8, 9];
  v = [4];
  assert(len(q) == 1 && (q[0] ?? 0) == 4, "twice: got {len(q)} {q[0] ?? 0}, want 1 4");
}

fn test_an_empty_source_rebind() {
  v = [1, 2];
  q = &v;
  v = [];
  assert(len(q) == 0 && len(v) == 0, "empty: got {len(q)} {len(v)}, want 0 0");
}

fn test_a_source_append_reaches_the_link() {
  v = [1, 2];
  q = &v;
  v += [3];
  assert(len(q) == 3, "source append: got {len(q)}, want 3");
}

fn test_a_source_element_write_reaches_the_link() {
  v = [1, 2];
  q = &v;
  v[0] = 9;
  assert((q[0] ?? 0) == 9, "source element: got {q[0] ?? 0}, want 9");
}

fn test_an_element_write_through_the_link_reaches_the_source() {
  v = [1, 2];
  q = &v;
  q[0] = 9;
  assert((v[0] ?? 0) == 9, "link element: got {v[0] ?? 0}, want 9");
}

fn test_an_append_through_the_link_reaches_the_source() {
  v = [1, 2];
  q = &v;
  q += [3];
  assert(len(v) == 3, "link append: got {len(v)}, want 3");
}

fn test_a_whole_write_through_the_link_reaches_the_source() {
  v = [1, 2];
  q = &v;
  q = [4, 5, 6];
  assert(len(v) == 3 && (v[0] ?? 0) == 4, "link whole: got {len(v)} {v[0] ?? 0}, want 3 4");
}

fn test_a_link_to_a_field_follows_its_rebind() {
  h = H{data: [1, 2]};
  q = &h.data;
  h.data = [7, 8, 9];
  assert(len(q) == 3, "field link: got {len(q)}, want 3");
}

fn test_a_text_link_follows_a_source_rebind() {
  t = "a";
  r = &t;
  t = "b";
  assert(r == "b" && t == "b", "text link: got {r} {t}, want b b");
}

// `(I-Comp)` is stated over the PLACE, not the spelling: a link and its source are one place,
// so a build that reads the link reads its own destination.  Making the source's rebind
// happen IN PLACE is what put these two here — the clear now reaches the link, where a fresh
// backing used to leave the link on the old store and the read worked by accident.
fn test_a_comprehension_reading_through_the_link() {
  a: vector<integer> = [7, 8, 9];
  r = &a;
  a = [for i in 0..r.len() { (r[i] ?? 0) * 2 }];
  assert(len(a) == 3 && (a[0] ?? 0) == 14 && (a[2] ?? 0) == 18,
         "comprehension via link: got {len(a)} {a[0] ?? 0} {a[2] ?? 0}, want 3 14 18");
}

fn test_a_literal_reading_through_the_link() {
  a: vector<integer> = [7, 8, 9];
  r = &a;
  a = [(r[2] ?? 0), (r[0] ?? 0)];
  assert(len(a) == 2 && (a[0] ?? 0) == 9 && (a[1] ?? 0) == 7,
         "literal via link: got {len(a)} {a[0] ?? 0} {a[1] ?? 0}, want 2 9 7");
}

fn test_a_vector_with_no_link_still_mints() {
  w = [1, 2];
  w = [5, 6, 7];
  assert(len(w) == 3 && (w[0] ?? 0) == 5, "no link: got {len(w)} {w[0] ?? 0}, want 3 5");
}
