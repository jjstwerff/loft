//
// loft#1069 — a `fn(…)` stored in a TUPLE member, called back out of it.
//
// It could not be, by any spelling — a named fn-ref, a long-form lambda, a short one —
// and each backend failed its own way.  `--interpret` panicked
// `fn_call_ref: fn_var=16 < 20`; `--native` refused to compile (`expected (u32, DbRef),
// found i64`) and, once that was fixed, panicked `invalid fn-ref: 710`.
//
// One cause, three symptoms: a fn-ref slot is the PAIR (the d_nr plus its closure), and a
// fn-ref written as a bare name lowers to the d_nr alone.  Every other position for the
// same value already tops it up — a plain local's first Set, a return, a call argument —
// and the tuple literal was the one path that did not, on either backend.  It cannot be
// fixed at the element, because the value cannot say what it is: a bare d_nr infers as an
// `integer`, so only the DESTINATION names the member as a `fn(…)`.  All three fixes
// therefore hang off the declared tuple type.
//
// The third symptom is the one worth naming: the native reachability walk collects a
// fn-ref out of a `Set` whose VARIABLE is a `Function`, so a function reachable only
// through a tuple was pruned and left with no arm in the fn-ref dispatch.  Same shape as
// the @P299 (`OpSetInt4` into a struct field) and @P328 (`yield`) recoveries.
//
// `test_a_tuple_with_no_fn_member_is_unchanged` is the control: the fix keys on a
// `Function` member, so a tuple without one must take exactly the path it always did.
//
// The cell that showed the blast radius is `test_reading_a_plain_member_of_such_a_tuple`.
// Reading `t.1`, an ordinary integer, faulted just as calling `t.0` did — because the
// under-pushed fn member moved every later member's offset and the tuple's own base with
// it.  The member that broke the tuple was not the member being read.

fn dbl1069(x: integer) -> integer { x * 2 }
fn inc1069(x: integer) -> integer { x + 1 }

fn test_a_named_fn_ref_as_the_first_member() {
  t: (fn(integer) -> integer, integer) = (dbl1069, 1);
  assert(t.0(3) == 6, "call the fn member: got {t.0(3)}");
  assert(t.1 == 1, "the integer member beside it: got {t.1}");
}

fn test_a_named_fn_ref_as_the_second_member() {
  // Position matters: the top-up shifts everything ABOVE it, so a fn member that is not
  // first exercises a different set of offsets.
  t: (integer, fn(integer) -> integer) = (9, dbl1069);
  assert(t.0 == 9, "the integer member first: got {t.0}");
  assert(t.1(3) == 6, "call the fn member second: got {t.1(3)}");
}

fn test_two_fn_members_stay_distinct() {
  t: (fn(integer) -> integer, fn(integer) -> integer) = (dbl1069, inc1069);
  assert(t.0(3) == 6, "the first fn member: got {t.0(3)}");
  assert(t.1(3) == 4, "the second fn member: got {t.1(3)}");
}

fn test_reading_a_plain_member_of_such_a_tuple() {
  // No fn is CALLED here. Before the fix this faulted anyway, which is what says the
  // defect was the tuple's layout and not the call.
  t: (fn(integer) -> integer, integer) = (dbl1069, 42);
  assert(t.1 == 42, "an integer member of a fn-carrying tuple: got {t.1}");
}

fn test_an_inline_long_form_lambda() {
  t: (fn(integer) -> integer, integer) = (fn(x: integer) -> integer { x * 5 }, 2);
  assert(t.0(3) == 15, "long-form lambda member: got {t.0(3)}");
  assert(t.1 == 2, "the member after it: got {t.1}");
}

fn test_an_inline_short_lambda() {
  // loft#1067's tuple row, which was held back until this fix: a short lambda infers its
  // parameter types from the tuple MEMBER's declared type, like every other position.
  t: (fn(integer) -> integer, integer) = (|x| { x * 2 }, 1);
  assert(t.0(3) == 6, "short lambda member: got {t.0(3)}");
  assert(t.1 == 1, "the member after it: got {t.1}");
}

fn test_a_capturing_lambda_carries_its_capture() {
  // A capturing source ALREADY emitted the pair — this cell is the one that worked
  // before, and it must keep working: the fix must not double-wrap it.
  k = 10;
  t: (fn(integer) -> integer, integer) = (fn(x: integer) -> integer { x + k }, 4);
  assert(t.0(3) == 13, "capturing lambda member: got {t.0(3)}");
  assert(t.0(5) == 15, "the capture survives a second call: got {t.0(5)}");
  assert(t.1 == 4, "the member after it: got {t.1}");
}

fn test_three_members_with_the_fn_in_the_middle() {
  t: (integer, fn(integer) -> integer, text) = (9, dbl1069, "z");
  assert(t.0 == 9, "before: got {t.0}");
  assert(t.1(3) == 6, "the fn in the middle: got {t.1(3)}");
  assert(t.2 == "z", "after: got {t.2}");
}

fn test_calling_one_member_twice() {
  t: (fn(integer) -> integer, integer) = (dbl1069, 1);
  assert(t.0(3) == 6, "first call: got {t.0(3)}");
  assert(t.0(5) == 10, "second call: got {t.0(5)}");
  assert(t.1 == 1, "the member after two calls: got {t.1}");
}

fn test_a_tuple_with_no_fn_member_is_unchanged() {
  t: (integer, text) = (5, "a");
  assert(t.0 == 5, "plain tuple, integer: got {t.0}");
  assert(t.1 == "a", "plain tuple, text: got {t.1}");
}

fn main() {
  test_a_named_fn_ref_as_the_first_member();
  test_a_named_fn_ref_as_the_second_member();
  test_two_fn_members_stay_distinct();
  test_reading_a_plain_member_of_such_a_tuple();
  test_an_inline_long_form_lambda();
  test_an_inline_short_lambda();
  test_a_capturing_lambda_carries_its_capture();
  test_three_members_with_the_fn_in_the_middle();
  test_calling_one_member_twice();
  test_a_tuple_with_no_fn_member_is_unchanged();
}
