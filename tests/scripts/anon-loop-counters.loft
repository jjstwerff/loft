// Nested `for _ in …` loops must each get their OWN hidden counter.
//
// The loop counter is named after the binder (`{name}#index`), which collides for
// `_` — the one binder people legitimately write more than once in a function.
// Two `for _` loops therefore shared a counter: the inner ran to its end, the outer
// saw an exhausted counter and stopped after ONE iteration.  Silently — the code
// ran, returned success, and produced a plausible short answer.
//
// Reported twice by consumers before it was found (moros H5 and H8): a hex_world
// file holding two layers saved byte-for-byte correctly and loaded back with one.
// `_` is exempt from the C61 nested-same-name guard (it must work across different
// element types in one function), so nothing else caught it.
//
// Fixed in parse_in_range: `_` takes the same `create_unique` path `$` already had.

fn main() {
  // The reported reproducers, exactly.
  a = 0;
  for _ in 0..3 { b = 0; for _ in 0..4 { b = b + 1; } a = a + b; }
  assert(a == 12, "H5: nested anon loops, outer must run 3x — got {a}, want 12");

  hits = 0;
  for _ in 0..2 { for _ in 0..3 { hits = hits + 1; } }
  assert(hits == 6, "H8: 2x3 anon loops — got {hits}, want 6");

  // Three deep: the shape hex_world actually used (chunks / layers / cells).
  n = 0;
  for _ in 0..2 { for _ in 0..3 { for _ in 0..5 { n = n + 1; } } }
  assert(n == 30, "triple-nested anon loops — got {n}, want 30");

  // Sequential `for _` loops must keep working — they always did, and the fix
  // must not turn independent counters into a shared one the other way round.
  s = 0;
  for _ in 0..3 { s = s + 1; }
  for _ in 0..4 { s = s + 1; }
  assert(s == 7, "sequential anon loops — got {s}, want 7");

  // Mixed iterables: the counters differ in kind (vector cursor vs range), which
  // is exactly why `_` is exempt from the same-name guard in the first place.
  v = [10, 20, 30];
  m = 0;
  for _ in v { for _ in 0..4 { m = m + 1; } }
  assert(m == 12, "anon vector loop around anon range loop — got {m}, want 12");

  assert(text_loops() == 6, "anon text loop around anon range loop");
  assert(reads_underscore() == 6, "reading `_` in the body");

  // Named binders keep their existing behaviour (nested same-name is a compile
  // error, C61; these are the shapes that were already correct).
  c = 0;
  for i in 0..3 { for j in 0..4 { c = c + 1; } }
  assert(c == 12, "named nested loops — got {c}, want 12");

  println("anon loop counters: ok");
}

// Kept in its OWN function: the visible `_` binding is shared per function (that is
// what lets `_` span element types), so a text loop types it `char` — mixing that
// with an integer read of `_` below would be a type conflict, not a counter bug.
fn text_loops() -> integer {
  t = 0;
  for _ in "abc" { for _ in 0..2 { t = t + 1; } }
  return t;
}

// The VISIBLE binding is untouched by the fix: `_` still reads as the current
// value, so this sums 0+1+2+3.  Only the hidden companion counter became unique.
fn reads_underscore() -> integer {
  r = 0;
  for _ in 0..4 { r = r + _; }
  return r;
}
