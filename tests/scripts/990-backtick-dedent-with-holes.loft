//
// loft#990 — a backtick block was dedented unless it contained an interpolation, in
// which case it was not dedented at all and kept its trailing blank line.  One `{…}`
// anywhere in the block was enough, before or after the affected lines.
//
// The rule was `closing-backtick column - 1`, which the scanner only learns when it
// REACHES that backtick — and a hole makes it hand the text so far to the parser and
// return long before that, so every segment of a holed block was built with no strip.
// The rule and the streaming were incompatible by construction.
//
// The rule is now the FIRST CONTENT LINE's indentation, which is knowable before any
// hole can occur, so both kinds of block answer alike.  Two consequences worth pinning
// because they are visible: a line indented LESS than the base comes out flush rather
// than keeping its own indentation (which used to leave it further right than the
// siblings that were indented PAST it), and a blank line does not set the base.

fn test_990_hole_dedents_like_no_hole() {
  plain = `
    alpha
    beta
    `;
  holed = `
    alpha
    beta {"x"}
    `;
  assert(plain == "alpha\nbeta", "plain block: [{plain}]");
  assert(holed == "alpha\nbeta x", "holed block: [{holed}]");
  // The trailing whitespace-only line is layout in BOTH, so neither carries it.
  assert(size(plain) == 10, "plain size {size(plain)}");
  assert(size(holed) == 12, "holed size {size(holed)}");
}

/// A hole on the OPENING line: the base is still the first line that follows it.
fn test_990_hole_on_the_opening_line() {
  n = "N";
  s = `{n}
    a
    b
    `;
  assert(s == "N\na\nb", "hole on opening line: [{s}]");
}

/// A hole on the first content line itself — the leading spaces are read before the
/// hole can interrupt, so the base is settled by the time it matters.
fn test_990_hole_on_the_first_content_line() {
  n = "N";
  s = `
    {n}a
    b
    `;
  assert(s == "Na\nb", "hole on first content line: [{s}]");
}

/// A blank line settles nothing — taking its zero as the base would switch the dedent
/// off for the whole block, and a template may well open with one.
fn test_990_a_blank_line_does_not_set_the_base() {
  n = "N";
  s = `

    a {n}
    b
    `;
  assert(s == "a N\nb", "blank first line: [{s}]");
}

/// A line indented LESS than the base comes out flush with the others.
fn test_990_a_line_indented_less_comes_out_flush() {
  n = "N";
  s = `
        a {n}
    b
        c
    `;
  assert(s == "a N\nb\nc", "outdented line: [{s}]");
}

/// A tab is not a space, so a tab-indented block has a base of zero and is left alone.
fn test_990_tabs_are_left_alone() {
  n = "N";
  s = `
	a {n}
	b
	`;
  assert(s == "\ta N\n\tb", "tabbed block: [{s}]");
}

/// A backtick block inside another one's hole keeps its own base.
fn test_990_a_nested_block_has_its_own_base() {
  n = "N";
  s = `
    x {`in {n}`} y
    z
    `;
  assert(s == "x in N y\nz", "nested block: [{s}]");
}

/// Doubled braces are literal text and do not open a hole, so they neither set nor
/// disturb the base.
fn test_990_doubled_braces_stay_literal() {
  n = "N";
  s = `
    p {{ c: {n} }}
    q
    `;
  assert(s == "p {{ c: N }}\nq", "doubled braces: [{s}]");
}

/// A block whose content is on the opening line: that line cannot be the base — it
/// starts wherever the backtick ended — so the line after it is.
fn test_990_content_on_the_opening_line() {
  s = `a
    b
    `;
  assert(s == "a\nb", "content on opening line: [{s}]");
}

/// Nothing but layout.
fn test_990_an_empty_block_is_empty() {
  s = `
    `;
  assert(size(s) == 0, "empty block: [{s}]");
}

/// The shape LOFT.md advertises: a template whose values sit in the middle of it.
fn test_990_a_template_dedents() {
  name = "Ada";
  count = 3;
  page = `
    <h1>hello {name}</h1>
    <p>{count} messages</p>
    `;
  assert(page == "<h1>hello Ada</h1>\n<p>3 messages</p>", "template: [{page}]");
}
