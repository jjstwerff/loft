// @PLN35 L2 (Phase 1): nested struct-enum sub-patterns in a match field position.
// `Parcel { detail: Ship { carrier } }` tag-tests the field's variant AND binds its payload —
// the capability parse_field_sub_pattern gained by recursing into struct-enum fields.

enum Detail { Ship { carrier: text }, Pickup { store: integer } }
struct Parcel { id: integer, detail: Detail }

// nested variant + payload binding
fn carrier(p: Parcel) -> text {
  match p {
    Parcel { detail: Ship { carrier } } => carrier
    _ => "none"
  }
}

// nested bare variants (tag-test only, no payload) across two arms
fn kind(p: Parcel) -> integer {
  match p {
    Parcel { detail: Ship } => 1
    Parcel { detail: Pickup } => 2
    _ => 0
  }
}

// nested payload from the non-first variant
fn store_of(p: Parcel) -> integer {
  match p {
    Parcel { detail: Pickup { store } } => store
    _ => -1
  }
}

fn main() {
  ship = Parcel { id: 1, detail: Ship { carrier: "FedEx" } };
  pick = Parcel { id: 2, detail: Pickup { store: 7 } };
  assert(carrier(ship) == "FedEx", "nested Ship carrier: {carrier(ship)}");
  assert(carrier(pick) == "none", "Pickup falls to wildcard: {carrier(pick)}");
  assert(kind(ship) == 1, "kind ship: {kind(ship)}");
  assert(kind(pick) == 2, "kind pickup: {kind(pick)}");
  assert(store_of(pick) == 7, "nested Pickup store: {store_of(pick)}");
  assert(store_of(ship) == -1, "Ship falls to wildcard: {store_of(ship)}");
  print("35-nested-match: PASS");
}
