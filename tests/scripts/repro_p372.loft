//
// @P372 regression (dryopea-surfaced) — `text as Struct` HUNG forever for a
// struct whose byte size exceeds 56 (more than seven 8-byte fields).  The cast
// claimed a fixed 8-word (64-byte) target record but wrote the struct at byte
// offset 8, leaving only 56 bytes; a larger struct's tail field (notably a
// vector field's 4-byte handle) overflowed into the ADJACENT block's header and
// zeroed it, after which `claim_scan` spun forever on the zero-sized block
// (`pos += abs(claim)` never advances; the debug_assert is gone in release).
// A vector field made it deterministic — appending its elements triggers the
// claim that walks the corrupted free list.  Fixed in both db_from_text mirrors
// (interpreter `state/io.rs` + native `codegen_runtime.rs`) by sizing the record
// to 1 + size.div_ceil(8) words.  This test simply COMPLETING proves no hang.

struct Inner { q: integer, r: integer, kind: text }
struct G8 { c1: integer, c2: integer, c3: integer, c4: integer, c5: integer, c6: integer, c7: integer, cv: vector<Inner> }
struct IntVec8 { d1: integer, d2: integer, d3: integer, d4: integer, d5: integer, d6: integer, d7: integer, dv: vector<integer> }
struct Big { a1: integer, a2: integer, a3: integer, a4: integer, a5: integer, a6: integer, a7: integer, a8: integer, a9: integer, a10: integer, a11: integer, a12: integer, av: vector<Inner> }

fn main() {
  g8 = `{{"c1":1,"c2":2,"c3":3,"c4":4,"c5":5,"c6":6,"c7":7,"cv":[{{"q":0,"r":0,"kind":"grass"}}]}}` as G8;
  assert(g8.c1 == 1, "g8.c1");
  assert(g8.c7 == 7, "g8.c7 (8th field offset intact)");
  assert(g8.cv.len() == 1, "g8.cv len");
  assert(g8.cv[0].kind == "grass", "g8 nested element");

  iv = `{{"d1":1,"d2":2,"d3":3,"d4":4,"d5":5,"d6":6,"d7":7,"dv":[10,20,30]}}` as IntVec8;
  assert(iv.d7 == 7, "iv.d7");
  assert(iv.dv.len() == 3, "iv.dv len");
  assert(iv.dv[2] == 30, "iv.dv element");

  big = `{{"a1":1,"a2":2,"a3":3,"a4":4,"a5":5,"a6":6,"a7":7,"a8":8,"a9":9,"a10":10,"a11":11,"a12":12,"av":[{{"q":9,"r":8,"kind":"x"}}]}}` as Big;
  assert(big.a12 == 12, "big.a12 (12th field intact)");
  assert(big.av[0].q == 9, "big nested element");

  print("ok");
}
