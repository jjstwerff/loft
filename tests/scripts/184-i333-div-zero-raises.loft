//
// #333 — undefended division/modulo by zero raises `divide by zero` on BOTH
// backends (plan-07 4f.5: the raise is the semantics; IEEE/null behaviour is
// the defended `?? / != null` path).  Pre-fix the native binary recorded the
// raise but never checked it: `5 / 0` printed a wrong value and exited 0.
//
// @PLN25 note (gate flip): the raise still fires on both backends; the
// loft_suite harness classifies an undefended div-zero as a RECOVERABLE fault
// (not a UserPanic/AssertionFailed), so these `@EXPECT_FAIL` functions read as
// "passed" — an informational `FIXED` notice, NOT a suite failure.

// @EXPECT_FAIL: divide by zero
fn test_int_div_zero() {
  z = 0;
  a = 5 / z;
  print("unreachable {a}");
}

// @EXPECT_FAIL: divide by zero
fn test_float_div_zero() {
  z = 0.0;
  a = 5.0 / z;
  print("unreachable {a}");
}

// The defended forms keep the null/IEEE path — no raise.
fn test_defended_paths() {
  z = 0;
  zf = 0.0;
  a = 5 % z ?? -1;
  b = if zf != 0.0 { 5.0 / zf } else { -2.0 };
  assert(a == -1 && b == -2.0, "defended: a={a} b={b}");
}
