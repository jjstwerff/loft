// loft#803 — a forward-referenced enum resolves where it is NAMED, and its
// variants carry the value the author wrote.  Both backends.
//
// Two faults met here, and the second is why three earlier fixes were reverted:
//
//   RESOLUTION — `Colour.Green` above `enum Colour` reported "Unknown variable",
//   and in a package "Unknown type null — did you mean 'JNull'?", naming two
//   things nobody wrote.  A forward-reference STUB was handed to the field
//   access as a resolved type of `null` instead of as a deferral.
//
//   VALUE — every variant of an ADOPTED enum rendered `unknown`.  Registration
//   is scoped to the defs a file just added, and an adopted stub's def number is
//   BELOW that range, so the one def that IS the enum was never registered.
//
// The VALUE assertions are the load-bearing ones.  Making the program compile is
// the easy half and was achieved three times by fixes that then answered
// `unknown` or `null` — a wrong value where there had been an error.  So each
// cell asserts the variant back, and BOTH variants are checked: a fix that
// stamps only the first discriminant passes a one-variant test.
//
// The cross-module half of the same mechanism (an enum reached through an
// ADOPTED stub, which is what was never registered) is `tests/multilib/
// fwd801_body.loft` — it cannot be written in one file, because adoption needs
// a `use` that suspends the declaring file.

enum FeColour { FeRed, FeGreen }

fn fe_second() -> text { c = FeColour.FeGreen; return "{c}"; }
fn fe_first() -> text { c = FeColour.FeRed; return "{c}"; }

// An enum-typed FIELD declared before its enum, with a field AFTER it: that
// trailing field lost its position entirely when the enum was unregistered at
// layout time — the loft#797 shape, one field along.
struct FeSess { s_a: integer, s_c: FeShade, s_b: integer }
enum FeShade { FeDark, FeLight }

fn main() {
  // Resolution AND value, forward, both variants.
  assert(fe_second() == "FeGreen", "a forward enum's second variant");
  assert(fe_first() == "FeRed", "the FIRST variant — one discriminant is not enough");

  // The field case.  `s_b` is the field that silently vanished, so its value is
  // the assertion that matters; `s_a` proves the record is otherwise sane.
  x = FeSess { s_a: 1, s_c: FeShade.FeLight, s_b: 2 };
  assert(x.s_a == 1, "the field BEFORE the enum field");
  assert("{x.s_c}" == "FeLight", "the enum field itself");
  assert(x.s_b == 2, "the field AFTER the enum field keeps its position");
  y = FeSess { s_a: 7, s_c: FeShade.FeDark, s_b: 9 };
  assert(y.s_b == 9, "a second record, so the first is not a lucky offset");
  assert("{y.s_c}" == "FeDark", "the other variant in the field position");

  // A discriminant that RENDERS correctly can still compare wrongly, so identity
  // is asserted separately from the text.
  c = FeColour.FeGreen;
  assert(c == FeColour.FeGreen, "a forward enum compares equal to itself");
  assert(!(c == FeColour.FeRed), "and unequal to its sibling");
  m = match c { FeRed => "r", FeGreen => "g" };
  assert(m == "g", "and matches as itself");

  // The BACKWARD control, same file, same run.  Without it a fix that broke
  // ordinary enums while fixing forward ones would still pass everything above.
  b = FeBack.FeTwo;
  assert("{b}" == "FeTwo", "an ordinary enum declared BEFORE its use still works");
  assert(b == FeBack.FeTwo, "and still compares");
}

enum FeBack { FeOne, FeTwo }
