// @PLN10 Phase B — bufferless ("nwb") user text functions return an owned String
// (wrapper `-> String`, every text return `(val).to_string()`) instead of riding
// the never-cleared `stores.scratch`; buffered functions that return a local /
// `??`-block / nwb-inner value write that String into their EXISTING work buffer.
// Generated native code is scratch-free as a result (verified under
// LOFT_SCRATCH_TRIP=panic).  These shapes are the ones the emitter must keep
// consistent across all four backends — they exercise nwb-if-return, nwb-format,
// the cross-fn ripple (a buffered outer returning an nwb inner), and the `??`
// value-block closure (the live buffer-write site).

// nwb: every return is a literal, reached via an if (no work buffer).
fn label(n: integer) -> text {
  if n > 5 { return "big"; }
  return "small";
}

// nwb: the return is a computed format (no work buffer).
fn tag(name: text, n: integer) -> text {
  return "{name}#{n}";
}

// buffered outer (a text local) that tail-returns an nwb inner call — the ripple:
// the inner produces an owned String, this fn's wrapper is `-> Str`.
fn wrap_tag(name: text) -> text {
  prefix = "x";
  return tag("{prefix}{name}", 1);
}

// nwb outer that tail-returns an nwb inner — String -> String, no re-wrap dangle.
fn forward(n: integer) -> text {
  return label(n);
}

struct Items {
  vals: vector<text>,
}

fn main() {
  assert(label(7) == "big", "nwb if-return big");
  assert(label(2) == "small", "nwb if-return small");
  assert(tag("a", 3) == "a#3", "nwb format-return");
  assert(wrap_tag("z") == "xz#1", "buffered-outer -> nwb-inner ripple");
  assert(forward(9) == "big", "nwb-outer -> nwb-inner");

  // @PLAN52 ncc: a `??` value-block inside a closure body — the live buffer-write
  // site (the closure's `__work_ret` is written, not scratch).
  it = Items { vals: [] };
  it.vals += ["present"];
  pick = fn(idx: integer) -> text {
    it.vals[idx] ?? "fallback"
  };
  p = pick(0);
  q = pick(9);
  assert(p == "present", "ncc closure present arm, got '{p}'");
  assert(q == "fallback", "ncc closure fallback arm, got '{q}'");

  println("nwb-text owned-string: ok");
}
