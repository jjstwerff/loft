//
// The interpreter's value stack keeps its RECORD when its buffer grows (loft#935).
//
// The stack lives inside record 1 of store #0, claimed once at `State::new` and then
// written directly — frame slots bypass `claim`, so `Store::grow_words` is what extends
// the buffer when a program nests deeply enough.  It extended the BUFFER only: record 1's
// header still claimed the 1000 words it was born with, so every stack byte past 8000 sat
// outside the record that owns it.  `Store::valid` says so under debug assertions
// (`Fld 8004 is outside of record 1 size 8000`); a release build simply wrote there, into
// a region the store's own accounting believed nobody held.
//
// It surfaced as `realloc(): invalid next size` — a glibc heap-metadata abort — in a
// consumer's test file that never called the code that had just been edited.  Adding a
// `vector<Struct>` local to a ~700-line dispatcher was what woke it: the enclosing
// function's size is not the defect, it is what makes the frame big enough to cross the
// initial claim.  That is also why the shape resisted shrinking — the axis it needed was
// stack DEPTH, and every attempt held the function fixed and varied the expression.
//
// The ablation that named it: pre-size the stack store so `ensure_stack` never grows, and
// every file that aborted passes.
//
// This file is the depth axis, kept cheap.  Each frame holds BOTH a text (a Rust `String`
// header living inline in the frame) and a `vector<Struct>` local, and asserts after the
// recursive call that its own locals are intact — which is exactly the question a stack
// that grew underneath them answers.  The assertions run on both backends; under the
// debug-assertions gate the same program also arms `Store::valid`, which is what turns a
// silent write into a named failure.

struct SdPart {
  a: integer,
  b: integer,
}

fn sd_build(n: integer) -> vector<SdPart> {
  out: vector<SdPart> = [];
  i = 0;
  while i < n {
    out += [SdPart { a: i, b: i * 2 }];
    i += 1;
  }
  out
}

// `sd_deep(0)` is 3, and every level adds its own 3 — so `sd_deep(n)` is `3 * (n + 1)`.
fn sd_deep(n: integer) -> integer {
  s = "depth {n}";
  v = sd_build(3);
  if n <= 0 {
    return len(v);
  }
  r = sd_deep(n - 1);
  // Read the locals AFTER the deeper calls have grown the stack under this frame.
  assert(len(v) == 3, "this frame's vector survived the deeper calls");
  assert(v[2].b == 4, "this frame's vector still holds its own elements");
  assert(size(s) >= 7, "this frame's text survived the deeper calls");
  r + len(v)
}

fn sd_stack_grows_under_live_frames() {
  assert(sd_deep(0) == 3, "the base case");
  assert(sd_deep(50) == 153, "a depth the initial claim covers");
  // Past the 1000-word initial claim: this is the depth the defect needed.
  assert(sd_deep(600) == 1803, "a depth that grows the stack store");
}

fn main() {
  sd_stack_grows_under_live_frames();
  println("935 ok");
}
