// @PLN102 pre-freeze (E2 Tier-1) — an out-of-range narrowing cast reads NULL
// (the C80 in-band sentinel), never a SATURATED plausible-wrong value.  Before
// the fix `single as integer` clamped to i64::MAX while `float as integer`
// already nulled — an inconsistency.  Both now null on overflow; an in-range
// cast round-trips.  Rendered form is checked (`"{x}" == "null"`) because the
// integer null IS i64::MIN.

fn test() {
  // --- float -> integer: overflow nulls, in-range round-trips ---
  fb: float = 1e30;
  fn2: float = -1e30;
  assert("{fb as integer}" == "null", "float overflow -> integer is null");
  assert("{fn2 as integer}" == "null", "negative float overflow -> integer is null");
  assert(100.5 as integer == 100, "in-range float -> integer truncates to value");

  // --- single -> integer: overflow nulls (was i64::MAX), in-range round-trips ---
  sb: single = 1e30 as single;
  sn: single = -1e30 as single;
  so: single = 100.0 as single;
  assert("{sb as integer}" == "null", "single overflow -> integer is null");
  assert("{sn as integer}" == "null", "negative single overflow -> integer is null");
  assert(so as integer == 100, "in-range single -> integer round-trips");
}
