//
// loft#866 / loft#867 — a `text as vector<Struct>` / `text as Struct` cast whose
// result crosses a function return.
//
// `OpCastVectorFromText` INTERNS the text into a store of its own, but the `as`
// handler grafted the source's deps onto the result, so a freshly allocated record
// read as a VIEW OF THE TEXT IT PARSED. The return-buffer machinery then delivered
// it as a borrow, and what that cost depended only on what the text happened to be:
//
//   · a text LOCAL      — renamed onto `__retbuf`, so one slot was both a `text` and
//                         the record buffer: the #306 guard then SIGSEGV on the
//                         interpreter, four rustc E0308s on native (loft#867)
//   · a LIFTED temp     — bound as the buffer with the cast emitted as a bare
//                         statement, so the untouched (empty) buffer was returned:
//                         an empty vector, silently, on native (loft#866)
//   · a PARAMETER       — worked, which is why the shape looked file-specific
//
// The deps are decided on BOTH passes, because the return buffer is chosen on pass 1
// and freezes the signature; a pass-2-only correction arrives after the text local
// has already become a parameter.
//
// Every source spelling below is a separate delivery path, and the struct target
// needed its own #409 forward-copy leg that only the vector target had. `file()` is
// deliberately absent: a text literal reaches the same place, which is what says the
// defect is the cast and not the I/O.

struct JcRow {
  name:  text,
  slope: integer,
}

struct JcFlat {
  version: integer,
  name:    text,
}

const JC_ROWS: text = "[{{\"name\":\"a\",\"slope\":1}},{{\"name\":\"b\",\"slope\":2}}]";
const JC_FLAT: text = "{{\"version\":1,\"name\":\"probe\"}}";

// --- vector<Struct> target, one function per source spelling ---

fn jc_vec_tail_param(body: text) -> vector<JcRow> {
  body as vector<JcRow>
}

fn jc_vec_tail_local() -> vector<JcRow> {
  jvt_t = JC_ROWS;
  jvt_t as vector<JcRow>
}

fn jc_vec_bound_local() -> vector<JcRow> {
  jvb_o = JC_ROWS as vector<JcRow>;
  jvb_o
}

// --- Struct target, the same three spellings ---

fn jc_flat_tail_param(body: text) -> JcFlat {
  body as JcFlat
}

fn jc_flat_tail_local() -> JcFlat {
  jft_t = JC_FLAT;
  jft_t as JcFlat
}

fn jc_flat_bound_local() -> JcFlat {
  jfb_t = JC_FLAT;
  jfb_m = jfb_t as JcFlat;
  jfb_m
}

// The cast inside a function that returns nothing — the control that always worked.
fn jc_flat_no_return() {
  jfn_t = JC_FLAT;
  jfn_m = jfn_t as JcFlat;
  assert(jfn_m.version == 1, "no-return cast version");
}

fn jc_check_rows(rows: vector<JcRow>, who: text) {
  assert(len(rows) == 2, "len " + who);
  assert(rows[0].name == "a", "name0 " + who);
  assert(rows[1].slope == 2, "slope1 " + who);
}

fn main() {
  jc_check_rows(jc_vec_tail_param(JC_ROWS), "vec_tail_param");
  jc_check_rows(jc_vec_tail_local(), "vec_tail_local");
  jc_check_rows(jc_vec_bound_local(), "vec_bound_local");

  jc_a = jc_flat_tail_param(JC_FLAT);
  assert(jc_a.version == 1, "flat_tail_param version");
  assert(jc_a.name == "probe", "flat_tail_param name");

  jc_b = jc_flat_tail_local();
  assert(jc_b.version == 1, "flat_tail_local version");
  assert(jc_b.name == "probe", "flat_tail_local name");

  jc_c = jc_flat_bound_local();
  assert(jc_c.version == 1, "flat_bound_local version");
  assert(jc_c.name == "probe", "flat_bound_local name");

  jc_flat_no_return();

  // Inline at the call site — the shape both reports used as their control.
  assert(len(JC_ROWS as vector<JcRow>) == 2, "inline vector cast");

  println("done");
}
