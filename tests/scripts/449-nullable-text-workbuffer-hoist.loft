// @PLN25 DN1 — a `text?` LOCAL referenced by the return deps must hoist to the
// same hidden `RefVar(Text)` work-buffer argument a plain `text` local does
// (`Optional(τ)` shares `τ`'s sentinel storage).  Before the control.rs
// `.base()` peel it fell through to the generic hoist arm and became a VISIBLE
// VALUE parameter — call sites pushed a `null` placeholder into a frame laid
// out for a work buffer, corrupting the callee's stack: interpreter heap
// corruption (`realloc(): invalid next size` — crashed every ws consumer:
// multiplayer_v2/v3/v5, engine_host s4) and native E0308.

// Shape 1 (the ws consumer shape): the `text?` comes from a CALL, the hit
// returns from INSIDE the while, the miss falls through to `return null`.
fn hoist_source(hs_n: integer) -> text? {
  if hs_n > 2 { return "value-{hs_n}"; }
  return null;
}

fn hoist_pick_call() -> text? {
  hp_attempts = 0;
  while hp_attempts < 10 {
    hp_raw = hoist_source(hp_attempts);
    if hp_raw != null { return hp_raw; }
    hp_attempts += 1;
  }
  return null;
}

fn test_call_source_return_in_while() {
  tc_r = hoist_pick_call();
  assert(tc_r != null, "call-source hit must be non-null");
  assert((tc_r ?? "-") == "value-3", "first non-null is value-3, got {tc_r ?? "-"}");
}

// Shape 2: an explicitly-typed null `text?` local + tail-expression return
// (was a SIGSEGV even without any loop-hit).
fn hoist_typed_null() -> text? {
  ht_found: text? = null as text?;
  ht_steps = 0;
  ht_steps += 1;
  assert(ht_steps == 1, "frame-layout skew: ht_steps read {ht_steps}");
  ht_found
}

fn test_typed_null_local_tail_return() {
  tn_r = hoist_typed_null();
  assert(tn_r == null, "typed-null local must survive the hoist as null");
}

// Shape 3: vector<text?> source + break-accumulate into a `text?` local
// (was "Incorrect var ...[64] versus 56" — the 8-byte frame-layout skew).
struct HoistBox {
  hb_items: vector<text?>,
}

fn hoist_pick_vec(hb: HoistBox) -> text? {
  hv_found: text? = null as text?;
  hv_attempts = 0;
  while hv_attempts < 4 {
    hv_raw = hb.hb_items[hv_attempts];
    if hv_raw != null {
      hv_found = hv_raw; break;
    }
    hv_attempts += 1;
  }
  hv_found
}

fn test_vector_source_break_accumulate() {
  tv_b = HoistBox { hb_items: [null, null, "two", "three"] };
  tv_r = hoist_pick_vec(tv_b);
  assert((tv_r ?? "-") == "two", "first non-null element is two, got {tv_r ?? "-"}");
}

// The plain-text twin must keep its (already working) hoist behaviour.
fn hoist_source_plain(sp_n: integer) -> text {
  if sp_n > 2 { return "plain-{sp_n}"; }
  return "";
}

fn hoist_pick_plain() -> text? {
  pp_attempts = 0;
  while pp_attempts < 10 {
    pp_raw = hoist_source_plain(pp_attempts);
    if pp_raw != "" { return pp_raw; }
    pp_attempts += 1;
  }
  return null;
}

fn test_plain_text_twin_unchanged() {
  tp_r = hoist_pick_plain();
  assert((tp_r ?? "-") == "plain-3", "plain twin returns plain-3, got {tp_r ?? "-"}");
}
