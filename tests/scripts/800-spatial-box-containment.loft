//
// Regression (loft#800): a `spatial` box query returned points outside the box.
//
// `xs[(x1,y1)..(x2,y2)]` is documented as the bounding box — the refusal for a scalar
// range says so outright. It answered the MORTON INTERVAL between the two corner codes,
// which for any non-degenerate box is a strict superset: Z-order threads out of the box
// and back, and every record in those excursions came back.
//
// `radix_db::range` returning the raw interval is deliberate and stays that way — its
// own doc says the caller filters, and the two OTHER surfaces it serves want exactly the
// Z-order walk. `build_radix_range_vec` is the layer that knows which form it lowered,
// and that is where containment is now asserted.
//
// The two cells that always passed are kept as controls, because they are why this
// survived undetected: a point-sized box and an all-enclosing box are both correct even
// with no filter at all, and they are the two shapes anyone tries first.

struct P { const x: integer, const y: integer, n: integer }

fn scene() -> spatial<P[x, y]> {
  s: spatial<P[x, y]> = [];
  s += [P { x: 1, y: 1, n: 10 }];
  s += [P { x: 5, y: 2, n: 20 }];
  s += [P { x: 3, y: 9, n: 30 }];
  s
}

fn test_box_returns_only_what_is_inside_it() {
  s = scene();

  // The reported cell. (5,2) sits inside the Morton interval of the corners but
  // outside the box on x, so a missing filter shows up here and nowhere else.
  a = "";
  for h in s[(1, 1)..(3, 9)] { a += "n{h.n} "; }
  assert(a == "n10 n30 ", "box (1,1)-(3,9) got '{a}' want 'n10 n30 '");

  // CONTROL — a degenerate box. Correct even unfiltered.
  b = "";
  for h in s[(5, 2)..(5, 2)] { b += "n{h.n} "; }
  assert(b == "n20 ", "degenerate box got '{b}' want 'n20 '");

  // CONTROL — a box containing everything. Correct even unfiltered.
  c = "";
  for h in s[(0, 0)..(9, 9)] { c += "n{h.n} "; }
  assert(c == "n10 n20 n30 ", "enclosing box got '{c}' want 'n10 n20 n30 '");

  // A box containing nothing must answer nothing, not its nearest neighbour.
  d = "";
  for h in s[(6, 6)..(8, 8)] { d += "n{h.n} "; }
  assert(d == "", "empty box got '{d}' want ''");

  // One axis excludes, the other includes — the filter must require EVERY axis.
  e = "";
  for h in s[(1, 1)..(9, 2)] { e += "n{h.n} "; }
  assert(e == "n10 n20 ", "y-excluding box got '{e}' want 'n10 n20 ' (n30 is at y=9)");
}

fn test_open_ended_slices_keep_their_z_order_walk() {
  // The other two surfaces `build_radix_range_vec` lowers are NOT boxes: they are the
  // Z-order walk onward from a corner, which is what makes `..:n` a proximity query.
  // Filtering them would be the same bug in the opposite direction, so they are pinned
  // here — a fix to the box must not reach them.
  s = scene();

  a = "";
  for h in s[(0, 0)..] { a += "n{h.n} "; }
  assert(a == "n10 n20 n30 ", "open slice from the origin got '{a}'");

  b = 0;
  for h in s[(0, 0)..:2] { b += 1; }
  assert(b == 2, "limited open slice took {b} want 2");
}
