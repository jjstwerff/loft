// A chained JsonValue expression owns what it makes and borrows what it reads.
//
// Every JsonValue CONSTRUCTOR (`json_null`, `json_bool`, `json_number`, `json_string`,
// `json_array`, `json_object`, `json_parse`) allocates a fresh store; every ACCESSOR
// (`field`, `item`) hands back a view INTO the store it was given.  Used inline —
// `json_null().kind()`, `v.field("a").item(1).kind()` — the two need opposite treatment:
// the constructor's temporary must be lifted so something frees it, and the accessor's
// must NOT be, or freeing it destroys the arena the caller still holds.
//
// Nothing in the type distinguished them, because a native declaration has no body and so
// never ran through the machinery that records "this return borrows argument 0".  The
// cure is an inference at the declaration (`parser/definitions.rs`): a native fn with a
// `self` parameter that returns the SAME struct-enum type borrows from self, so its return
// carries `dep=[0]`; a constructor has no self, keeps `dep=[]`, and is lifted.
//
// This file guards the BEHAVIOUR, not that mechanism.  Measured 2026-08-20: disabling the
// inference and rebuilding changes nothing here — same values, same store ledger, clean
// under LOFT_POISON=1 on both backends — so the later store-lifetime work appears to hold
// these shapes up on its own.  Do not read a green run here as "the inference works".
//
// What it does catch is the bite itself returning: it is a leak test as much as a value
// test, since the harness checks the store ledger, and the loops are what make a per-call
// leak fail loudly instead of costing one record.
struct Item { value: integer }

fn main() {
  // ── constructors: each allocates, each must be freed ───────────────────────────────
  assert(json_null().kind() == "JNull", "json_null");
  assert(json_bool(true).kind() == "JBool", "json_bool");
  assert(json_number(2.5).kind() == "JNumber", "json_number");
  assert(json_string("s").kind() == "JString", "json_string");
  items: vector<JsonValue> = [json_number(1.0), json_number(2.0)];
  assert(json_array(items).kind() == "JArray", "json_array");

  // A per-call leak is invisible at one call and unbounded in a loop, which is the shape
  // the ledger catches.
  n = 0;
  for i in 0..500 {
    if json_number(1.0 * i).kind() == "JNumber" { n += 1; }
    if json_string("x").kind() == "JString" { n += 1; }
  }
  assert(n == 1000, "constructors in a loop deliver every time");

  // ── accessors: each borrows the arena it was handed ────────────────────────────────
  v = json_parse(`{{"a":[1,2,3],"b":{{"c":"x"}},"d":"e"}}`);
  assert(v.field("a").kind() == "JArray", "field returns a view");
  assert(v.field("a").item(1).kind() == "JInteger", "a view of a view");
  assert(v.field("b").field("c").kind() == "JString", "two fields deep");

  // The subject must survive every chain that read through it — an accessor result freed
  // as if it were owned takes the parsed arena with it, and the NEXT read is the tell.
  m = 0;
  for i in 0..500 {
    if v.field("a").item(1).kind() == "JInteger" { m += 1; }
    if v.field("b").field("c").kind() == "JString" { m += 1; }
  }
  assert(m == 1000, "accessor chains keep answering after repetition");
  assert(v.field("d").kind() == "JString", "the subject is intact at the end");

  // ── the struct surface built on the same machinery ─────────────────────────────────
  it = Item { value: 7 };
  j = it.to_json();
  assert(Item.parse(j).value == 7, "to_json / parse round-trip");
  k = 0;
  for i in 0..200 {
    if Item.parse(`{{"value":3}}`).value == 3 { k += 1; }
  }
  assert(k == 200, "a parse per iteration neither leaks nor goes stale");
}
