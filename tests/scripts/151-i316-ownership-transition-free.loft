// #316 regression — reassigning a Reference local that OWNS its store with a
// BORROW (a view of a vector element) must free the owned store first.
// Pre-fix, the dep merge made the var's static type a borrow, which
// suppressed codegen's pre-Set free — one store leaked per call (the
// mon_choose / m_one shape leaked ~3 per call, 65k-exhausting long runs).
// The wrap suite's leak gate enforces the zero-leak expectation here.

struct M {
  hp: integer,
  depth: integer,
  name: text,
}

fn m_none() -> M {
  M { hp: 0, depth: 0, name: "" }
}

fn m_table() -> vector<M> {
  t: vector<M> = [];
  t += [
    M { hp: 5, depth: 3, name: "rat" },
  ];
  t += [
    M { hp: 8, depth: 5, name: "bat" },
  ];
  t += [
    M { hp: 12, depth: 7, name: "orc" },
  ];
  t
}

fn m_pool(table: vector<M>, eff: integer) -> vector<M> {
  out: vector<M> = [];
  for mi in 0..len(table) {
    m = table[mi] ?? m_none();
    if m.hp > 0 && m.depth <= eff { out += [m]; }
  }
  out
}

// The leaking shape: an owned dead-init (`chosen = m_none()`), then a
// conditional reassignment with a view of a local vector.
fn m_one(table: vector<M>, eff: integer, salt: integer) -> M {
  pool = m_pool(table, eff);
  np = len(pool);
  chosen = m_none();
  if np > 0 {
    idx = salt % np ?? 0;
    chosen = pool[idx] ?? m_none();
  }
  chosen
}

fn m_choose(table: vector<M>, eff: integer, salt: integer) -> M {
  best = m_none();
  bestdepth = -1;
  d = 0;
  while d < 3 {
    cand = m_one(table, eff, salt * 131 + d * 17);
    if cand.hp > 0 && cand.depth > bestdepth {
      bestdepth = cand.depth;
      best = cand;
    }
    d += 1;
  }
  best
}

fn main() {
  t = m_table();
  total = 0;
  for i in 0..50 {
    m = m_choose(t, 9, i);
    total += m.depth;
    assert(len(t) == 3, "iter {i}: len(t) = {len(t)} (expect 3)");
    assert(m.depth == 7, "iter {i}: m.depth = {m.depth} (expect 7)");
  }
  assert(total == 350, "total = {total} (expect 350)");
  println("i316 ownership-transition free: ok");
}
