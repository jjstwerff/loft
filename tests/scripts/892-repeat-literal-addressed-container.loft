//
// The repeat literal `[x; n]` must fill the container it was written in, whenever that
// container is ADDRESSED (a struct field, an indexed element, a capture) rather than
// named by a local.
//
// `OpNewRecord`/`OpFinishRecord` can locate a struct field indirectly — enclosing record
// plus field number — but `OpAppendCopy` copies WITHIN one vector and so must be handed
// that vector's own handle. The copy was given the enclosing RECORD and appended into
// whichever vector that resolved to, which is the FIRST vector field. So
// `Pair { a: [7; 3], b: [9; 5] }` built `a` with seven elements (its own 3 plus b's 4)
// and `b` with one — wrong length, wrong field, silently, on both backends and on the
// published 2026.8.0.
//
// The same derivation has a second face. `is_field` looks through a span; the container
// did not, so a SPANNED field read fell through to `Value::Var(u16::MAX)` and indexed the
// variable table out of bounds — `q.a = [7; 3]`, `q.a += [7; 3]` and `vv[i] += [7; 3]`
// each aborted the compiler with an internal error, on the published build too. Rows c5,
// c6 and c7 are those three shapes; they are part of THIS defect, not neighbours of it.
//
// And a third face, which is why the empty-neighbour row is here: when the wrongly
// chosen container is EMPTY, the copy's source offset `length * size - size` underflows
// at length 0, so c4 was a process-killing panic rather than a wrong length.
//
// The controls carry the weight. A single-field struct (c3) resolves to the only vector
// there is, so the wrong container IS the right one and the bug is invisible — that is
// why this went unnoticed. c13/c14 pin the ordering luck: a repeat literal in the FIRST
// vector field also lands correctly by accident, so only the SECOND field, or a repeat
// following a comprehension, exposes it. Without both orders a fix that always targeted
// field 0 would pass.

struct Pair { a: vector<integer>, b: vector<integer> }
struct One { a: vector<integer> }
struct Trio { a: vector<integer>, b: vector<integer>, c: vector<integer> }
struct Inner { a: vector<integer>, b: vector<integer> }
struct Outer { inner: Inner, tag: integer }
struct Sing { a: vector<single>, b: vector<single> }
struct Nest { a: vector<vector<integer>>, b: vector<vector<integer>> }
struct Item { n: integer }
struct Rec { a: vector<Item>, b: vector<Item> }
struct Txt { a: vector<text>, b: vector<text> }

/// Sum, not just length: a slot that was never written has the right length and the
/// wrong contents, which is the half a length check alone cannot see.
fn r892_sum(v: vector<integer>) -> integer {
  t = 0;
  for e in v { t += e; }
  t
}

fn r892_build() -> Pair { Pair { a: [7; 3], b: [9; 5] } }

fn main() {
  // c1 — the filed shape. Distinct counts AND distinct values, so a wrong length and a
  //      wrong field are told apart: b's copies landing in `a` is what made `a` seven.
  c1 = Pair { a: [7; 3], b: [9; 5] };
  assert(len(c1.a) == 3, "c1 a len = {len(c1.a)}, want 3");
  assert(len(c1.b) == 5, "c1 b len = {len(c1.b)}, want 5");
  assert(r892_sum(c1.a) == 21, "c1 a sum = {r892_sum(c1.a)}, want 21");
  assert(r892_sum(c1.b) == 45, "c1 b sum = {r892_sum(c1.b)}, want 45");

  // c2 — CONTROL: a plain local names its container and was always correct.
  c2: vector<integer> = [7; 3];
  assert(len(c2) == 3, "c2 plain local len = {len(c2)}, want 3");
  assert(r892_sum(c2) == 21, "c2 plain local sum = {r892_sum(c2)}, want 21");

  // c3 — CONTROL: one vector field, so the record resolves to it. Hides the defect.
  c3 = One { a: [7; 3] };
  assert(len(c3.a) == 3, "c3 single-field len = {len(c3.a)}, want 3");

  // c4 — the crash row: the repeat sits in the MIDDLE field and its neighbours are
  //      empty, so the wrongly chosen container had length 0 and the copy's source
  //      offset underflowed. Both neighbours must stay empty.
  c4 = Trio { a: [], b: [9; 4], c: [] };
  assert(len(c4.a) == 0, "c4 a len = {len(c4.a)}, want 0");
  assert(len(c4.b) == 4, "c4 b len = {len(c4.b)}, want 4");
  assert(len(c4.c) == 0, "c4 c len = {len(c4.c)}, want 0");
  assert(r892_sum(c4.b) == 36, "c4 b sum = {r892_sum(c4.b)}, want 36");

  // c5 — assignment to a field. Spanned field read: aborted the compiler.
  c5 = Pair { a: [], b: [] };
  c5.a = [7; 3];
  c5.b = [9; 5];
  assert(len(c5.a) == 3, "c5 a len = {len(c5.a)}, want 3");
  assert(len(c5.b) == 5, "c5 b len = {len(c5.b)}, want 5");
  assert(r892_sum(c5.b) == 45, "c5 b sum = {r892_sum(c5.b)}, want 45");

  // c6 — compound append onto a NON-EMPTY field: the existing elements must survive
  //      and the copies must follow them, in the field they were written in.
  c6 = Pair { a: [1, 2], b: [3, 4] };
  c6.a += [7; 3];
  c6.b += [9; 5];
  assert(len(c6.a) == 5, "c6 a len = {len(c6.a)}, want 5");
  assert(len(c6.b) == 7, "c6 b len = {len(c6.b)}, want 7");
  assert(r892_sum(c6.a) == 24, "c6 a sum = {r892_sum(c6.a)}, want 24");
  assert(r892_sum(c6.b) == 52, "c6 b sum = {r892_sum(c6.b)}, want 52");

  // c7 — an indexed element (#246). The copy must reach the INNER vector, and the outer
  //      vector must neither grow nor lose its other element.
  c7: vector<vector<integer>> = [[1], [2]];
  c7[1] += [7; 3];
  assert(len(c7) == 2, "c7 outer len = {len(c7)}, want 2");
  c7i0 = c7[0] ?? [];
  c7i1 = c7[1] ?? [];
  assert(len(c7i0) == 1, "c7 untouched element len = {len(c7i0)}, want 1");
  assert(len(c7i1) == 4, "c7 appended element len = {len(c7i1)}, want 4");
  assert(r892_sum(c7i1) == 23, "c7 appended element sum = {r892_sum(c7i1)}, want 23");

  // c8 — a field one struct deeper, with a scalar neighbour that must not be disturbed.
  c8 = Outer { inner: Inner { a: [7; 3], b: [9; 5] }, tag: 42 };
  assert(len(c8.inner.a) == 3, "c8 nested a len = {len(c8.inner.a)}, want 3");
  assert(len(c8.inner.b) == 5, "c8 nested b len = {len(c8.inner.b)}, want 5");
  assert(c8.tag == 42, "c8 scalar neighbour = {c8.tag}, want 42");

  // c9 — a 4-byte element. Width is not the axis, but a mis-strided copy shows here.
  c9 = Sing { a: [7.5f; 3], b: [9.25f; 5] };
  assert(len(c9.a) == 3, "c9 a len = {len(c9.a)}, want 3");
  assert(len(c9.b) == 5, "c9 b len = {len(c9.b)}, want 5");
  assert((c9.a[2] ?? 0.0f) == 7.5f, "c9 a last = {c9.a[2] ?? 0.0f}, want 7.5");
  assert((c9.b[4] ?? 0.0f) == 9.25f, "c9 b last = {c9.b[4] ?? 0.0f}, want 9.25");

  // c10 — elements that are HANDLES (@PLAN58 cluster-I). The inner vectors must be
  //       reachable, not just counted: the wrong container left b's last inner empty.
  c10 = Nest { a: [[7]; 3], b: [[9]; 5] };
  assert(len(c10.a) == 3, "c10 a len = {len(c10.a)}, want 3");
  assert(len(c10.b) == 5, "c10 b len = {len(c10.b)}, want 5");
  c10a = c10.a[2] ?? [];
  c10b = c10.b[4] ?? [];
  assert(len(c10a) == 1, "c10 a inner len = {len(c10a)}, want 1");
  assert(len(c10b) == 1, "c10 b inner len = {len(c10b)}, want 1");
  assert((c10a[0] ?? 0) == 7, "c10 a inner value = {c10a[0] ?? 0}, want 7");
  assert((c10b[0] ?? 0) == 9, "c10 b inner value = {c10b[0] ?? 0}, want 9");

  // c11 — the template is a RECORD, not a scalar, so the copy carries a whole element.
  c11 = Rec { a: [Item { n: 7 }; 3], b: [Item { n: 9 }; 5] };
  assert(len(c11.a) == 3, "c11 a len = {len(c11.a)}, want 3");
  assert(len(c11.b) == 5, "c11 b len = {len(c11.b)}, want 5");
  assert((c11.a[2] ?? Item { n: 0 }).n == 7, "c11 a last = {(c11.a[2] ?? Item { n: 0 }).n}, want 7");
  assert((c11.b[4] ?? Item { n: 0 }).n == 9, "c11 b last = {(c11.b[4] ?? Item { n: 0 }).n}, want 9");

  // c12 — the same literal in return position, where the record is the returned value.
  c12 = r892_build();
  assert(len(c12.a) == 3, "c12 a len = {len(c12.a)}, want 3");
  assert(len(c12.b) == 5, "c12 b len = {len(c12.b)}, want 5");
  assert(r892_sum(c12.b) == 45, "c12 b sum = {r892_sum(c12.b)}, want 45");

  // c13 — repeat SECOND, after a comprehension. The comprehension is correct on its own,
  //       so any miscounting here is the repeat's copies landing in field `a`.
  c13 = Pair { a: [for i in 0..3 { i + 100 }], b: [9; 5] };
  assert(len(c13.a) == 3, "c13 a len = {len(c13.a)}, want 3");
  assert(len(c13.b) == 5, "c13 b len = {len(c13.b)}, want 5");
  assert(r892_sum(c13.a) == 303, "c13 a sum = {r892_sum(c13.a)}, want 303");

  // c14 — repeat FIRST, comprehension second: the ordering that passed by luck. Keeping
  //       both directions is what stops a fix that simply always targets field 0.
  c14 = Pair { a: [7; 3], b: [for i in 0..5 { i + 100 }] };
  assert(len(c14.a) == 3, "c14 a len = {len(c14.a)}, want 3");
  assert(len(c14.b) == 5, "c14 b len = {len(c14.b)}, want 5");
  assert(r892_sum(c14.b) == 510, "c14 b sum = {r892_sum(c14.b)}, want 510");

  // c15 — an element with indirect content, to keep the copy honest about what it copies.
  c15 = Txt { a: ["hi"; 3], b: ["yo"; 5] };
  assert(len(c15.a) == 3, "c15 a len = {len(c15.a)}, want 3");
  assert(len(c15.b) == 5, "c15 b len = {len(c15.b)}, want 5");
  assert((c15.a[2] ?? "?") == "hi", "c15 a last = {c15.a[2] ?? \"?\"}, want hi");
  assert((c15.b[4] ?? "?") == "yo", "c15 b last = {c15.b[4] ?? \"?\"}, want yo");

  println("892 ok");
}
