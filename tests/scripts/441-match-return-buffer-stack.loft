// Regression — a `match` whose arms deliver into the function's return buffer and
// exit at DIFFERENT stack levels miscomputed the `OpReturn` `discard`, so the
// interpreter's `fn_return` read the saved return address from the wrong slot and
// derailed (deterministic crash under allocation churn; `--native` was unaffected
// because it returns on the Rust call stack).  @PLN85 P2.
//
// Root cause was in `gen_if`'s B5 arm-join: it joined both arms at the SHORTER
// arm's stack level but (a) only ever shrank the FALSE arm — a taller TRUE arm
// (heavy arm first, `deliver`) was never shrunk, stranding a whole result slot;
// and (b) sized the shrink by the raw result bytes instead of the step-rounded
// slot, stranding a taller FALSE arm (heavy arm second, `deliver_rev`) by the
// 12->16 padding.  Either way the function-tail `discard` came out short.  Fix:
// shrink whichever arm is taller, with `discard = (arm_stack - target) +
// step(ret_size)`, routing a taller already-emitted true arm through a shrink
// trampoline.
//
// The churn loop (fresh allocations between calls) is load-bearing: it turned the
// short `discard` into a stack-pointer underflow / heap corruption.
//
// NOTE: the arms are written single-line on purpose.  A separate, pre-existing bug
// (@PLN85 P3 — def/type numbering across SEVERAL multi-line match-return functions
// defined together) is orthogonal to this fix and tracked apart; keeping the arms
// single-line isolates this regression to the B5 stack-join.
struct E { hp: integer not null, name: text }
enum Cell { Empty, Filled { items: vector<E> } }

// Heavy (vector-yielding) arm FIRST -> the taller arm is the TRUE arm.
fn deliver(e: Cell) -> vector<E> { match e { Filled { items } => { o: vector<E> = []; o += items; o }, _ => { [] } } }

// Heavy arm SECOND -> the taller arm is the FALSE arm (the other ordering).
fn deliver_rev(e: Cell) -> vector<E> { match e { Empty => { [] }, Filled { items } => { o: vector<E> = []; o += items; o } } }

// Match + local promoted to the buffer but NO append -> still a taller true arm.
fn empty_local(e: Cell) -> vector<E> { match e { Filled { items } => { o: vector<E> = []; o }, _ => { [] } } }

fn main() {
  inner: vector<E> = [];
  for k in 0..3 { inner += [E{hp: k, name: "e"}]; }
  cell = Filled { items: inner };

  // Repeated calls with allocation churn between them: pre-fix this drove the
  // interpreter stack pointer to underflow within ~8 iterations.
  for i in 0..20 {
    r = deliver(cell);
    assert(len(r) == 3, "deliver i{i}: len={len(r)}");
    assert(r[0].hp == 0 && r[2].hp == 2, "deliver i{i}: values wrong");

    rr = deliver_rev(cell);
    assert(len(rr) == 3, "deliver_rev i{i}: len={len(rr)}");
    assert(rr[1].hp == 1, "deliver_rev i{i}: values wrong");

    el = empty_local(cell);
    assert(len(el) == 0, "empty_local i{i}: len={len(el)}");

    // churn: fresh records each iteration so a stale buffer slot is reused.
    j: vector<E> = [];
    for q in 0..12 { j += [E{hp: q, name: "churn"}]; }
    assert(len(j) == 12, "churn i{i}: len={len(j)}");
  }

  // The Empty path (shorter arm taken) must stay correct too.
  e2 = deliver(Empty {});
  assert(len(e2) == 0, "deliver(Empty): len={len(e2)}");

  println("ok");
}
