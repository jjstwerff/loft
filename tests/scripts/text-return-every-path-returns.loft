// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Regression: a `text`-returning function whose body is a single conditional with a
// `return` in EVERY branch failed to compile on `--native` with
// `E0282: type annotations needed`, while the interpreter ran it fine.  A plain
// `if`/`else` was enough — no enum, no match, no recursion.
//
// @PLN104's targeted promotion routes a text return through a hidden `&text` buffer.
// For every operator BUT the last it rewrites each inner `return <e>` into
// `__tret = e; return __tret`; the last one it binds as a VALUE
// (`__tret = <tail>`).  When the whole body IS that conditional, the tail yields no
// value — both arms are `never` — so the emitted Rust read
// `*var___tret = (if … { return … } else { return … }).to_string()`, an assignment
// control can never reach.  The interpreter survives that (the `return` leaves before
// the store completes); rustc cannot type `.to_string()` on `!`.
//
// The fix is to give the tail the same treatment as every earlier operator when it
// diverges.  The controls below matter as much as the cases: a ONE-ARMED `if` falls
// through and must still be bound as a value, or the function loses its result.

fn rr_if(n: integer) -> text {
  if n < 0 { return "neg"; } else { return "pos"; }
}

fn rr_scalar_match(n: integer) -> text {
  match n { 1 => { return "one"; }, 2 => { return "two"; }, _ => { return "other"; } };
}

enum RRTag { RrA, RrB, RrC }

fn rr_enum_match(t: RRTag) -> text {
  match t { RrA => { return "a"; }, RrB => { return "b"; }, _ => { return "c"; } };
}

// The returned text is BUILT, not a literal — an interpolation is delivered through a
// work buffer of its own, so it exercises the buffer path rather than a constant.
fn rr_built(n: integer) -> text {
  if n < 0 { return "neg{n}!"; } else { return "pos{n}!"; }
}

// A nullable return: the `null` arm carries no text at all.
fn rr_nullable(n: integer) -> text? {
  if n < 0 { return null; } else { return "pos"; }
}

// CONTROL — a one-armed guard falls THROUGH to a value tail.  Treating this as
// diverging would drop the tail and lose the result.
fn rr_guard(n: integer) -> text {
  if n < 0 { return "neg"; }
  "nonneg"
}

// CONTROL — an early return, then a diverging conditional tail: both halves at once.
fn rr_early_then_diverging(n: integer) -> text {
  if n < 0 { return "neg"; }
  if n == 0 { return "zero"; } else { return "pos"; }
}

// CONTROL — a value-yielding conditional tail (no `return` anywhere) must keep working.
fn rr_value_tail(n: integer) -> text {
  if n < 0 { "neg" } else { "pos" }
}

// CONTROL — a return from inside a LOOP, then a value tail.
fn rr_loop(v: vector<integer>) -> text {
  for x in v { if x > 2 { return "big{x}"; } }
  "none"
}

fn test_text_return_every_path_returns() {
  assert(rr_if(-1) == "neg", "if/else returns: {rr_if(-1)}");
  assert(rr_if(1) == "pos", "if/else returns: {rr_if(1)}");

  assert(rr_scalar_match(1) == "one", "scalar match: {rr_scalar_match(1)}");
  assert(rr_scalar_match(2) == "two", "scalar match: {rr_scalar_match(2)}");
  assert(rr_scalar_match(9) == "other", "scalar match: {rr_scalar_match(9)}");

  assert(rr_enum_match(RrA) == "a", "enum match: {rr_enum_match(RrA)}");
  assert(rr_enum_match(RrB) == "b", "enum match: {rr_enum_match(RrB)}");
  assert(rr_enum_match(RrC) == "c", "enum match: {rr_enum_match(RrC)}");

  assert(rr_built(-3) == "neg-3!", "built text: {rr_built(-3)}");
  assert(rr_built(4) == "pos4!", "built text: {rr_built(4)}");

  assert(rr_nullable(-1) == null, "nullable null arm: {rr_nullable(-1) ?? "NOTNULL"}");
  assert(rr_nullable(1) == "pos", "nullable value arm: {rr_nullable(1) ?? "NUL"}");

  assert(rr_guard(-1) == "neg", "one-armed guard, taken: {rr_guard(-1)}");
  assert(rr_guard(1) == "nonneg", "one-armed guard, fallthrough: {rr_guard(1)}");

  assert(rr_early_then_diverging(-1) == "neg", "early: {rr_early_then_diverging(-1)}");
  assert(rr_early_then_diverging(0) == "zero", "then zero: {rr_early_then_diverging(0)}");
  assert(rr_early_then_diverging(5) == "pos", "then pos: {rr_early_then_diverging(5)}");

  assert(rr_value_tail(-1) == "neg", "value tail: {rr_value_tail(-1)}");
  assert(rr_value_tail(1) == "pos", "value tail: {rr_value_tail(1)}");

  assert(rr_loop([1, 5, 2]) == "big5", "return from loop: {rr_loop([1, 5, 2])}");
  assert(rr_loop([1, 2]) == "none", "loop falls through: {rr_loop([1, 2])}");
}
