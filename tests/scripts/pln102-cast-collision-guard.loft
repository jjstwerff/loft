// @PLN102 null-model keystone, step 3b (D-op-null-2) — a cast whose value can't
// be represented in the target reports + yields null (like ÷0), not a silent
// saturate/NUL. Guards OpCastIntFromFloat/OpConvCharacterFromInt/OpCastIntFromText.
fn main() {
  // float→integer out of range → null (was: saturate to i64::MAX / silent null)
  assert((1e30 as integer ?? -1) == -1, "1e30 as integer -> null, not saturated");
  assert((-1e30 as integer ?? -1) == -1, "-1e30 as integer -> null");
  // in-range float cast still works
  assert((9.9 as integer) == 9, "9.9 as integer truncates to 9");
  assert((-3.5 as integer) == -3, "-3.5 as integer truncates toward zero");
  // int→character invalid codepoint → null (char 0), not a silent wrong char
  assert(!(999999999 as character), "invalid codepoint -> null character");
  assert((65 as character) == 'A', "valid codepoint 65 -> 'A'");
  // text→integer: valid number equal to the reserved sentinel → null (collision)
  assert(("-9223372036854775808" as integer ?? -1) == -1, "i64::MIN text -> null (reserved)");
  // representable near-min still parses
  assert(("-9223372036854775807" as integer ?? 0) == -9223372036854775807, "i64::MIN+1 text parses");
  // unparseable text → null (DN3-nullable, unchanged)
  assert(("abc" as integer ?? -1) == -1, "unparseable text -> null");
  print("cast-collision-guard ok\n");
}
