//
// Regression: the IMPLICIT return (last-expression) of a REASSIGNED vector local
// returned the FIRST store, not the last.  Root cause: NRVO promoted the returned
// local to the caller's buffer and built into it in place, so a second `z = [..]`
// appended onto the buffer instead of replacing — `z=[9,9]; z=[1,2]; z` returned
// [9,9].  Fix: `ref_return` does NOT NRVO-promote a local that is assigned a vector
// literal more than once; it stays a normal local (the `__vdb` + return-copy path,
// which explicit `return z;` already used correctly).

fn two() -> vector<integer> {
  z: vector<integer> = [9, 9]; z = [1, 2]; z
}
fn three() -> vector<integer> {
  z: vector<integer> = [9, 9]; z = [1, 2]; z = [3, 4]; z
}
fn diff_len() -> vector<integer> {
  z: vector<integer> = [0]; z = [1, 2, 3]; z
}
fn nested() -> vector<vector<integer>> {
  z: vector<vector<integer>> = [[9]]; z = [[1], [2]]; z
}

fn main() {
  a = two();
  assert(a[0] == 1 && a[1] == 2, "two: [{a[0]}, {a[1]}] expect [1, 2]");
  b = three();
  assert(b[0] == 3 && b[1] == 4, "three: [{b[0]}, {b[1]}] expect [3, 4]");
  c = diff_len();
  assert(len(c) == 3 && c[0] == 1 && c[2] == 3, "diff_len: len={len(c)} expect 3");
  d = nested();
  assert(len(d) == 2 && d[0][0] == 1 && d[1][0] == 2, "nested: len={len(d)} d00={d[0][0]}");
  println("reassign-return ok");
}
