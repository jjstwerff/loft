// SPDX-License-Identifier: LGPL-3.0-or-later
//
// loft#872 — a `vector<T>`-returning function delivers an EMPTY vector when its
// result initialises a struct-literal field in an append. IGNORED: this is the
// open repro, not a guard. Drop the `#[ignore]` in `tests/wrap.rs` when it passes.
//
// WHAT IT SHOWS. `empty_cells()` is called twice in one run. Called directly it
// answers 1024 (`CTRL=1024`). Called as `Layer { …, ly_cells: empty_cells() }`
// inside `w.w_chunks[ci].ck_layers += [ … ]` it answers 0 (`CELLS=0`) — same
// function, same run, two lengths. The later `ly_cells[ix] = …` write then goes
// out of bounds SILENTLY, which is how the consumer saw it: content lost from a
// sibling layer, with every write reporting success.
//
// THE AXIS IS NOT THE ONE FILED. The report reads "append behaves differently
// from comprehension"; it is neither. What decides it is how the callee hands its
// local back:
//
//     ec = [for i in 0..N { StoredHex {} }];  ec        // FAILS  (tail expression)
//     ec = [for i in 0..N { StoredHex {} }];  return ec; // WORKS (explicit return)
//     ec: vector<StoredHex> = []; for … { ec += … }; ec        // FAILS
//     ec: vector<StoredHex> = []; for … { ec += … }; return ec; // WORKS
//
// So both spellings fail as a tail expression and both work with `return`. The
// consumer's two forms happened to differ in the tail, not in how they built.
//
// MECHANISM (as far as it is pinned). Under the tail-expression spelling the
// @PLAN59/H1 NRVO in `classify_ret_promotion` picks `RetPromotion::Rename` and
// renames the signature-time `__retbuf` onto `ec`, so the buffer parameter is
// typed as the raw `vector<StoredHex>` and the comprehension builds elements
// straight into it. Under `return ec;` the buffer stays `ref(main_vector<…>)` —
// the WRAPPER — and the callee emits `OpDatabase` + `OpGetField(…,0,…)` +
// `OpReplaceVector` to install what it built. Compare the two with
// `loft introspect` on this file with each spelling, or `LOFT_VAR_TABLE=empty_cells`.
//
// The rename alone is not sufficient: a compact hand-written version reproduces
// the same renamed callee var table and still answers 1024, so a caller-side
// condition is also required and is not yet isolated. Note the caller here has TWO
// variables named `__ref_2` — its own renamed return buffer (`ref(ColumnWrite)`)
// and the work ref passed to `empty_cells` (`vector<StoredHex>`) — and the
// attr↔var coupling in the Rename path is BY NAME.
//
// PROVENANCE. Mechanically reduced (delta debugging against a two-sided oracle:
// `CELLS=0` AND `CTRL=1024` AND the append really landing) from `hex_voxel` in
// jjstwerff/moros, where it failed 4 of that package's own dressing tests and 2
// in `hex_editor`. The empty function bodies below (`cell_index`, `chunk_key`)
// are reduction artefacts — they are load-bearing: restoring them makes the
// reduction stop reproducing. Reproduces on the published loft 2026.8.0, so it
// predates the #866/#867/#869/#870 fixes.

pub struct Hex {
  h_height:        u16,
  h_material:      u8,
  h_item:          u8,
  h_wall_ne:       u8,
  h_wall_e:       u8,
}
pub struct StoredHex {
  sv_height:        u16,
  sv_material:      u8,
  sv_item:          u8,
  sv_item_rotation: u8,
  sv_wall_ne:       u8,
  sv_wall_e:       u8,
}
pub fn hex_occupied(h: Hex) -> boolean { h.h_material != 0 }
pub const KIND_DRESSING = 1;
pub const LABEL_FIRST   = 2;
pub const CHUNK_CELLS = 1024;
pub const CHUNK_W_SHIFT = 5;
pub struct Layer {
  ly_id:    integer,
  ly_kind:  integer,
  ly_ver:   integer,
  ly_cells: vector<StoredHex>,
}
pub struct VoxelChunk {
  ck_cx:     integer,
  ck_cz:     integer,
  ck_base:   integer,
  ck_layers: vector<Layer>,
}
pub struct ChunkAt { ca_key: integer, ca_at: integer }
pub struct VoxelWorld {
  w_chunks: vector<VoxelChunk>,
  w_index:  hash<ChunkAt[ca_key]>,
  w_unit:   float,
  w_reserve: integer,
  w_eps:     integer,
  w_theta:   integer,
  w_next_id: integer,
  w_tau:     integer,
}
pub struct Column {
  co_q:     integer,
  co_r:     integer,
  co_cells: vector<Hex>,
}
pub struct WorldNew { wn_code: integer, wn_world: VoxelWorld }
pub fn world_new(unit: float, reserve: integer, eps: integer, theta: integer) -> WorldNew {
  WorldNew {
    wn_world: VoxelWorld { w_chunks: [], w_unit: unit, w_reserve: reserve,
                      w_eps: eps, w_theta: theta, w_next_id: LABEL_FIRST, w_tau: 1 },
  }
}
pub fn world_chunk_of(v: integer) -> integer { v >> CHUNK_W_SHIFT }
pub fn cell_index(q: integer, r: integer) -> integer {
}
fn chunk_key(cx: integer, cz: integer) -> integer {
}
fn find_chunk(w: VoxelWorld, cx: integer, cz: integer) -> integer {
  e = w.w_index[chunk_key(cx, cz)];
  e.ca_at
}
fn empty_cells() -> vector<StoredHex> {
  ec = [for i in 0..CHUNK_CELLS { StoredHex {} }];
  ec
}
fn hex_of(base: integer, e: StoredHex) -> Hex {
  return Hex { h_height: (base + e.sv_height) as u16? ?? 0,
               h_wall_ne: e.sv_wall_ne, h_wall_e: e.sv_wall_e };
}
fn fresh_label(w: VoxelWorld) -> integer {
  id = w.w_next_id;
  id
}
pub const CW_OK        = 0;
pub const CW_RESERVE   = 4;
pub struct ColumnWrite { cw_code: integer, cw_layer: integer, cw_detail: text }
fn ok_write() -> ColumnWrite { ColumnWrite { cw_code: CW_OK, cw_layer: 0 - 1, cw_detail: "" } }
pub fn world_set_dressing(w: VoxelWorld, col: Column) -> ColumnWrite {
  for i in 0..len(col.co_cells) {
    c = col.co_cells[i];
    if hex_occupied(c) && c.h_height < w.w_reserve {
      return ColumnWrite { cw_code: CW_RESERVE, cw_layer: i,
                           cw_detail: "dressing at {c.h_height} is below the reserve {w.w_reserve}" };
    }
  }
  cx = world_chunk_of(col.co_q);
  cz = world_chunk_of(col.co_r);
  ix = cell_index(col.co_q, col.co_r);
  ci = find_chunk(w, cx, cz);
  if ci < 0 {
    nb = 0;
    w.w_chunks += [VoxelChunk { ck_cx: cx, ck_cz: cz, ck_base: nb, ck_layers: [] }];
    ci = len(w.w_chunks) - 1;
  }
  slots: vector<integer> = [];
  while len(slots) < len(col.co_cells) {
    w.w_chunks[ci].ck_layers += [Layer { ly_id: fresh_label(w), ly_kind: KIND_DRESSING,
                                         ly_ver: 0, ly_cells: empty_cells() }];
    slots += [len(w.w_chunks[ci].ck_layers) - 1];
    println("LAYERS={len(w.w_chunks[ci].ck_layers)} CHUNKS={len(w.w_chunks)} CI={ci} CELLS={len(w.w_chunks[ci].ck_layers[len(w.w_chunks[ci].ck_layers) - 1].ly_cells)}");
  }
  base = w.w_chunks[ci].ck_base;
  for k in 0..len(col.co_cells) {
    c3 = col.co_cells[k];
    l = slots[k];
    nv = StoredHex { sv_height: (c3.h_height - base) as u16? ?? 0,
                     sv_wall_e: c3.h_wall_e };
    prev = w.w_chunks[ci].ck_layers[l].ly_cells[ix];
    if prev.sv_height != nv.sv_height || prev.sv_material != nv.sv_material
       || prev.sv_item != nv.sv_item || prev.sv_item_rotation != nv.sv_item_rotation {
    }
  }
  ok_write()
}

fn main() {
  n = world_new(0.25, 100, 8, 3);
  w = n.wn_world;
  r = world_set_dressing(w, Column { co_q: 0, co_r: 0, co_cells: [Hex { h_height: (300 as u16? ?? 0), h_material: 7, h_item: (4 as u8? ?? 0) }] });

  // The SAME function, called directly. This one is right, and it is what makes
  // the pair a contradiction rather than a slow path: 1024 here, 0 in the field.
  direct = len(empty_cells());
  assert(direct == CHUNK_CELLS, "called directly, empty_cells answered {direct}");

  // The field the append initialised. `world_set_dressing` prints the same number
  // as it goes; this re-reads it after the call, so a caller-side re-read cannot
  // be blamed.
  stored = len(w.w_chunks[0].ck_layers[0].ly_cells);
  assert(stored == CHUNK_CELLS,
         "as a struct-literal field, empty_cells answered {stored} — the write that "
         + "follows then lands out of bounds, silently");
}