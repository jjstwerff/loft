// @PLN25 (N-Store) tuples — the ACCEPT twins of the 102-expected-errors tuple rejects.
// A tuple stores ELEMENT-WISE: an Optional/null element is rejected at a non-null
// element slot (return / field / nested — see 102), and ACCEPTED when discharged
// (`?? d`) or when the slot's element type is declared `τ?`.

// Discharged element into a non-null tuple return — the migration idiom.
fn parse_pair(s: text) -> (integer, integer) {
  pp_q = s as integer;
  (pp_q ?? 0, 1)
}

// Declared `τ?` element carries the nullable honestly.
fn parse_pair_nullable(s: text) -> (integer?, integer) {
  pn_q = s as integer;
  (pn_q, 1)
}

// A bare null element into a declared `τ?` element slot.
fn null_first() -> (integer?, integer) {
  (null, 2)
}

// Nested tuple: the inner discharged element satisfies the inner non-null slot.
fn nested(s: text) -> ((integer, integer), integer) {
  ns_q = s as integer;
  ((ns_q ?? 0, 1), 2)
}

// A tuple FIELD with a discharged element (the field-construct accept twin).
struct PairBox { t: (integer, integer) }

fn boxed(s: text) -> integer {
  bx_q = s as integer;
  bx_b = PairBox { t: (bx_q ?? 7, 1) };
  bx_b.t.0
}

fn main() {
  tp_a = parse_pair("42");
  assert(tp_a.0 == 42 && tp_a.1 == 1, "discharged elem: {tp_a.0} {tp_a.1}");
  tp_bad = parse_pair("nope");
  assert(tp_bad.0 == 0, "discharged elem defaults on bad parse: {tp_bad.0}");

  tp_n = parse_pair_nullable("42");
  assert((tp_n.0 ?? -1) == 42, "nullable elem carries value: {tp_n.0 ?? -1}");
  tp_nn = parse_pair_nullable("nope");
  assert((tp_nn.0 ?? -1) == -1, "nullable elem carries null on bad parse");

  tp_f = null_first();
  assert((tp_f.0 ?? -1) == -1 && tp_f.1 == 2, "null into declared nullable elem");

  tp_x = nested("5");
  assert(tp_x.0.0 == 5 && tp_x.0.1 == 1 && tp_x.1 == 2, "nested discharged elem");
  assert(boxed("9") == 9, "field tuple discharged elem: {boxed(\"9\")}");
  assert(boxed("nope") == 7, "field tuple default on bad parse: {boxed(\"nope\")}");

  println("tuple-nstore ok");
}
