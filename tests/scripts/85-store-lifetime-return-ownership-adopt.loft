//
// @PLN85 Cluster A.3 — regression guard: the struct-Reference call-bind
// adopt-vs-copy decision now reads the carried return-ownership fact
// (Definition::returns_borrowed_view(), OWNERSHIP_MODEL row 102) instead of the
// coarse "callee has any visible ref param" proxy (has_ref_params) the 11 sites
// used to re-derive.
//
// The refinement only ever turns COPY into ADOPT for a callee that HAS a ref
// param but does NOT borrow it in its return (returns a fresh store): such a
// bind no longer wastefully deep-copies, it adopts the fresh store. Both the
// adopt case (fresh return) and the copy case (borrowed return) must keep value
// semantics and leak-freedom on BOTH backends.

struct Box { v: vector<integer> }

// ADOPT case: has a ref param `seed` but returns a FRESH owned Box. The bind
// `c = mk_from(s)` adopts the fresh store (returns_borrowed_view == false).
fn mk_from(seed: Box) -> Box { Box { v: [len(seed.v), 100, 200] } }

// ADOPT case, deeper: returns a fresh struct whose field is a NEW vector built
// from the param's field (the `+1` materialises a new vector — no alias).
fn grow_from(x: Box) -> Box { s = Box { v: [x.v[0] + 1, x.v[1] + 1] }; s }

// COPY case: returns the WHOLE param (returns_borrowed_view == true). The bind
// must deep-copy so mutating the source does not affect the bound value.
fn idb(b: Box) -> Box { b }

fn main() {
  // ADOPT: fresh return, ignores the param's store.
  s = Box { v: [1, 2] };
  c = mk_from(s);
  s.v += [9];
  assert(c.v[0] == 2, "mk_from adopt: c.v[0] == len(seed.v) == 2");
  assert(c.v[1] == 100, "mk_from adopt: c.v[1] == 100");
  assert(len(s.v) == 3, "source mutated independently to len 3");

  // ADOPT: fresh-from-field return.
  src = Box { v: [1, 2] };
  r = grow_from(src);
  src.v += [9, 9];
  assert(r.v[0] == 2, "grow_from adopt: r.v[0] == 2");
  assert(r.v[1] == 3, "grow_from adopt: r.v[1] == 3");
  assert(len(src.v) == 4, "source mutated independently to len 4");

  // COPY: whole-param return must still copy on bind.
  bx = Box { v: [1, 2, 3] };
  d = idb(bx);
  bx.v += [9];
  assert(len(d.v) == 3, "idb borrowed-return must COPY (d.v len 3)");
  assert(len(bx.v) == 4, "source mutated to len 4");
}
