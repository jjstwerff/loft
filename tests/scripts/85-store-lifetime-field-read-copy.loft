//
// @PLN85 / #415 — regression guard (graduated from probes/06): binding or
// returning a heap vector FIELD must COPY (establish a new owner), not alias the
// field's store. Before the fix `a = bx.v` and `a = getv(b){ b.v }` both aliased
// (len 4 after the source mutated) while plain `a = x` copied. Fixes: (1) the
// bind-site @P292/@P394 branch now admits a struct vector-field read (parse_assign_op);
// (2) the implicit-tail block_result vector arm copies a struct-field-of-argument
// return into __retbuf. Both narrowed to STRUCT field reads (a vector index read's
// nested-element stride must not take the append-copy path). Guards: value
// semantics + no leak, BOTH backends.

struct Box { v: vector<integer> }

fn getv(b: Box) -> vector<integer> { b.v }

fn main() {
  // control: plain local copy already honoured value semantics
  x: vector<integer> = [1, 2, 3];
  a = x;
  x += [9];
  assert(len(a) == 3, "control a = x must COPY (a.len 3)");
  assert(len(x) == 4, "x mutated to 4");

  // read a vector FIELD of a struct (no function)
  bx = Box { v: [1, 2, 3] };
  af = bx.v;
  bx.v += [9];
  assert(len(af) == 3, "a = bx.v must COPY (af.len 3)");

  // a fn returning a parameter's vector field (implicit tail)
  by = Box { v: [1, 2, 3] };
  ag = getv(by);
  by.v += [9];
  assert(len(ag) == 3, "a = getv(by) must COPY (ag.len 3)");
}
