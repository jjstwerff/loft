//
// Iterating an `ordered` collection answers what iterating a `sorted` one answers,
// in both directions and over a key range.
//
// A `sorted<T[k]>` is laid out as an `ordered` — 4-byte record-id slots instead of
// inline elements — as soon as its element type is record-backed, which happens as
// soon as ANY keyed collection over that element type exists anywhere in the program.
// The `ordered` iteration arm implemented only the unbounded forward walk, so which
// of the two a program got decided whether iteration worked at all (loft#904):
//
//   * `rev()` was accepted and silently ignored — the loop walked forward;
//   * a bounded range read EVERY element with every value zero, the bound never
//     applied;
//   * a bounded reverse range SIGSEGV'd.
//
// Identical on both backends and on the published 2026.8.0.
//
// One root, two missing halves. `State::iterate` computed `on = 3`'s bounded and
// reverse cursors as slot INDICES (`vector::ordered_find`), while the stepper reads
// the cursor as a BYTE OFFSET — index 1 read as byte offset 1 lands inside the slot
// vector's header, which is the zeros and then the crash. And `vector::step_ordered`
// took no direction and consulted no bound: the byte-offset mirror of
// `vector::vector_step_rev` did not exist, and `finish` was never compared.
//
// Both backends had their OWN copy of the cursor derivation and had already drifted
// apart from each other — invisibly, because neither was ever consumed. There is now
// one: `vector::ordered_range_cursors`, the way `tree::range_cursors` is shared for
// an `index`. `finish == 0` means no bound in either direction (it is below every
// valid position), which is what an unbounded walk returns and what keeps an `on = 4`
// hash / spatial / trie scratch walking to its end unchanged.
//
// **Rows a and b run the same cells over `sorted`, `ordered` and `index` and assert
// the SAME answer.** That is the point of the file: a collection's kind must not
// change what a range means, and the `sorted` and `index` columns were correct before
// this fix — so a repair that moved the shared cursor would fail there rather than
// pass quietly. Row d does the same for the `on = 4` kinds, whose one working cell
// (unbounded forward) must stay working.
//
// Each element type is used by exactly one row: the promotion is keyed on the element
// type across the whole program, so sharing one would let a row that needs `sorted`
// silently get `ordered`.

struct Ea { k: integer, n: text }
struct Eb { k: integer, n: text }
struct Ec { k: integer, n: text }
struct Ed { k: integer, n: text }
struct Ee { k: integer, n: text }
struct Ef { k: integer, n: text }
struct Eg { k: integer, n: text }
struct Eh { k: integer, n: text }
struct Ew { w: text, n: integer }
struct Ep { x: integer, y: integer, n: integer }

struct Sorted1 { a: sorted<Ea[k]> }
struct Index1 { a: index<Eb[k]> }
struct Ordered1 { a: sorted<Ec[k]> }
struct Force1 { h: hash<Ec[k]> }             // promotes Ordered1.a to an `ordered`

struct Sorted2 { a: sorted<Ed[k]> }
struct Index2 { a: index<Ee[k]> }
struct Ordered2 { a: sorted<Ef[k]> }
struct Force2 { h: hash<Ef[k]> }

struct Ordered3 { a: sorted<Eg[k]> }
struct Force3 { h: hash<Eg[k]> }
struct Ordered4 { a: sorted<Eh[k]> }
struct Force4 { h: hash<Eh[k]> }

struct TrieHolder { t: trie<Ew[w]> }
struct SpatialHolder { r: spatial<Ep[x,y]> }

/// Unbounded, forward and reverse, over all three kinds. `rev()` was accepted and
/// ignored on the `ordered` column only.
fn row_a() {
  s = Sorted1 { a: [] };
  s.a = [Ea{k:1,n:"n1"}, Ea{k:2,n:"n2"}, Ea{k:3,n:"n3"}, Ea{k:4,n:"n4"}, Ea{k:5,n:"n5"}];
  i = Index1 { a: [] };
  i.a = [Eb{k:1,n:"n1"}, Eb{k:2,n:"n2"}, Eb{k:3,n:"n3"}, Eb{k:4,n:"n4"}, Eb{k:5,n:"n5"}];
  o = Ordered1 { a: [] };
  o.a = [Ec{k:1,n:"n1"}, Ec{k:2,n:"n2"}, Ec{k:3,n:"n3"}, Ec{k:4,n:"n4"}, Ec{k:5,n:"n5"}];

  fs = ""; for es in s.a { fs += "{es.k}"; }
  fi = ""; for ei in i.a { fi += "{ei.k}"; }
  fo = ""; for eo in o.a { fo += "{eo.k}"; }
  assert(fs == "12345", "a sorted forward [{fs}], want [12345]");
  assert(fi == "12345", "a index forward [{fi}], want [12345]");
  assert(fo == "12345", "a ordered forward [{fo}], want [12345]");

  rs = ""; for es in rev(s.a) { rs += "{es.k}"; }
  ri = ""; for ei in rev(i.a) { ri += "{ei.k}"; }
  ro = ""; for eo in rev(o.a) { ro += "{eo.k}"; }
  assert(rs == "54321", "a sorted reverse [{rs}], want [54321]");
  assert(ri == "54321", "a index reverse [{ri}], want [54321]");
  assert(ro == "54321", "a ordered reverse [{ro}], want [54321] — rev() was ignored");
}

/// The same bounded range over all three kinds. The `ordered` column read `00000`
/// forward and SIGSEGV'd in reverse.
fn row_b_kinds() {
  s = Sorted2 { a: [] };
  s.a = [Ed{k:1,n:"n1"}, Ed{k:2,n:"n2"}, Ed{k:3,n:"n3"}, Ed{k:4,n:"n4"}, Ed{k:5,n:"n5"}];
  i = Index2 { a: [] };
  i.a = [Ee{k:1,n:"n1"}, Ee{k:2,n:"n2"}, Ee{k:3,n:"n3"}, Ee{k:4,n:"n4"}, Ee{k:5,n:"n5"}];
  o = Ordered2 { a: [] };
  o.a = [Ef{k:1,n:"n1"}, Ef{k:2,n:"n2"}, Ef{k:3,n:"n3"}, Ef{k:4,n:"n4"}, Ef{k:5,n:"n5"}];

  x1 = ""; for es in s.a[2..4] { x1 += "{es.k}"; }
  y1 = ""; for ei in i.a[2..4] { y1 += "{ei.k}"; }
  z1 = ""; for eo in o.a[2..4] { z1 += "{eo.k}"; }
  assert(x1 == "23", "b sorted [2..4] [{x1}], want [23]");
  assert(y1 == "23", "b index [2..4] [{y1}], want [23]");
  assert(z1 == "23", "b ordered [2..4] [{z1}], want [23]");

  x2 = ""; for es in rev(s.a[2..4]) { x2 += "{es.k}"; }
  y2 = ""; for ei in rev(i.a[2..4]) { y2 += "{ei.k}"; }
  z2 = ""; for eo in rev(o.a[2..4]) { z2 += "{eo.k}"; }
  assert(x2 == "32", "b sorted rev [2..4] [{x2}], want [32]");
  assert(y2 == "32", "b index rev [2..4] [{y2}], want [32]");
  assert(z2 == "32", "b ordered rev [2..4] [{z2}], want [32] — this one SIGSEGV'd");
}

/// Every bound spelling over an `ordered`: `ex` and the empty-`from` / empty-`till`
/// branches are separate paths in the cursor derivation, and loft#691 got exactly
/// those wrong for a `sorted` once already.
fn row_b_bounds() {
  o = Ordered2 { a: [] };
  o.a = [Ef{k:1,n:"n1"}, Ef{k:2,n:"n2"}, Ef{k:3,n:"n3"}, Ef{k:4,n:"n4"}, Ef{k:5,n:"n5"}];

  x3 = ""; for e in o.a[2..=4] { x3 += "{e.k}"; }
  y3 = ""; for e in rev(o.a[2..=4]) { y3 += "{e.k}"; }
  assert(x3 == "234", "b ordered [2..=4] [{x3}], want [234]");
  assert(y3 == "432", "b ordered rev [2..=4] [{y3}], want [432]");

  x4 = ""; for e in o.a[3..] { x4 += "{e.k}"; }
  y4 = ""; for e in rev(o.a[3..]) { y4 += "{e.k}"; }
  assert(x4 == "345", "b ordered [3..] [{x4}], want [345]");
  assert(y4 == "543", "b ordered rev [3..] [{y4}], want [543]");

  x5 = ""; for e in o.a[..3] { x5 += "{e.k}"; }
  y5 = ""; for e in rev(o.a[..3]) { y5 += "{e.k}"; }
  assert(x5 == "12", "b ordered [..3] [{x5}], want [12]");
  assert(y5 == "21", "b ordered rev [..3] [{y5}], want [21]");

  x6 = ""; for e in o.a[..] { x6 += "{e.k}"; }
  y6 = ""; for e in rev(o.a[..]) { y6 += "{e.k}"; }
  assert(x6 == "12345", "b ordered [..] [{x6}], want [12345]");
  assert(y6 == "54321", "b ordered rev [..] [{y6}], want [54321]");

  x7 = ""; for e in o.a[3..=3] { x7 += "{e.k}"; }
  assert(x7 == "3", "b ordered [3..=3] [{x7}], want [3]");

  // Bounds that select nothing, and bounds wider than the keys on either side. An
  // empty selection must be an empty loop, not a walk from the not-started sentinel.
  x8 = ""; for e in o.a[6..8] { x8 += "{e.k}"; }
  y8 = ""; for e in rev(o.a[6..8]) { y8 += "{e.k}"; }
  assert(x8 == "", "b ordered [6..8] [{x8}], want empty");
  assert(y8 == "", "b ordered rev [6..8] [{y8}], want empty");

  x9 = ""; for e in o.a[0..9] { x9 += "{e.k}"; }
  y9 = ""; for e in rev(o.a[0..9]) { y9 += "{e.k}"; }
  assert(x9 == "12345", "b ordered [0..9] [{x9}], want [12345]");
  assert(y9 == "54321", "b ordered rev [0..9] [{y9}], want [54321]");
}

/// The short collections a stepper's off-by-one hides at length 3 and above.
fn row_c() {
  o = Ordered3 { a: [] };
  e0 = ""; for e in rev(o.a) { e0 += "{e.k}"; }
  assert(e0 == "", "c ordered empty reverse [{e0}], want empty");
  o.a += [Eg{k:1,n:"n1"}];
  e1 = ""; for e in rev(o.a) { e1 += "{e.k}"; }
  assert(e1 == "1", "c ordered one reverse [{e1}], want [1]");
  o.a += [Eg{k:2,n:"n2"}];
  e2 = ""; for e in rev(o.a) { e2 += "{e.k}"; }
  assert(e2 == "21", "c ordered two reverse [{e2}], want [21]");
}

/// The `on = 4` kinds share the stepper and must not move. Their one working cell is
/// the unbounded forward walk, and a range over them is refused at compile time — so
/// if a fix had changed their cursor, nothing in rows a-c would have said so.
fn row_d() {
  t = TrieHolder { t: [] };
  t.t = [Ew{w:"ant",n:1}, Ew{w:"ape",n:2}, Ew{w:"bee",n:3}, Ew{w:"cat",n:4}];
  ts = ""; for ew in t.t { ts += "{ew.n}"; }
  assert(ts == "1234", "d trie [{ts}], want [1234] in key order");

  p = SpatialHolder { r: [] };
  p.r = [Ep{x:1,y:1,n:1}, Ep{x:5,y:5,n:2}, Ep{x:9,y:9,n:3}];
  pc = 0; pt = 0; for ep in p.r { pc += 1; pt += ep.n; }
  assert(pc == 3, "d spatial visited {pc}, want 3");
  assert(pt == 6, "d spatial sum {pt}, want 6");
}

/// `e#remove` under `rev()`. loft#903's `ordered` arm rewound the cursor FORWARD on
/// purpose while the stepper ignored `reverse`; now that it walks backwards the
/// rewind follows it, and this row is what decides that.
fn row_e() {
  o = Ordered4 { a: [] };
  o.a = [Eh{k:1,n:"n1"}, Eh{k:2,n:"n2"}, Eh{k:3,n:"n3"}, Eh{k:4,n:"n4"}, Eh{k:5,n:"n5"}];
  seen = "";
  for e in rev(o.a) { seen += "{e.k}"; if e.k == 3 { e#remove; } }
  left = ""; for e in o.a { left += "{e.k}"; }
  assert(seen == "54321", "e visited [{seen}], want [54321]");
  assert(left == "1245", "e left [{left}], want [1245]");
  for e in rev(o.a) { e#remove; }
  assert(len(o.a) == 0, "e drained to {len(o.a)}, want 0");
}

fn main() {
  row_a();
  row_b_kinds();
  row_b_bounds();
  row_c();
  row_d();
  row_e();
  println("904 ok");
}
