//
// loft#960 — destructuring the result of a function declared LOWER in the same file.
//
// `a = later(…)` has always worked, tuple return included; `(a, b, c) = later(…)` did not,
// and the message named the LEFT-hand names — *"Unknown variable 'a'"*, three times — while
// the cure was to move the callee.  In a real file that reads as "you used an undefined
// variable", so the obvious response is to rename locals, which does nothing.
//
// The names in a `( … ) =` LHS are BEING BOUND, but they were run through the check that
// asks whether a name being READ resolves.  That check passed only because pass 1 had
// already typed the binding — which it can do only when the callee is above the caller.
// Move the callee down and pass 1 has no return type, the binding stays untyped, and pass 2
// reported it as unknown before the destructuring below could type it.
//
// ⚠ EVERY WIDTH AND ELEMENT TYPE FAILED, so this file varies both.  A 2-tuple of scalars
// lowers through `TupleGet`; anything past 8 bytes becomes the synthetic `__tuple<…>`
// struct and lowers through per-attribute offsets.  The bug sits before that split, but a
// file testing one path would leave the other unguarded — and the two DO diverge, which is
// exactly what loft#959 turned on.
//
// The refusals stay refusals: a non-tuple RHS and an arity mismatch are pinned in
// `959-tuple-destructure-arity-is-refused.loft` and `36-parse-errors.loft`.

fn main() {
  // Scalars, 8 bytes — the `TupleGet` path.
  (i, j) = two_ints(2, 3);
  assert(i + j == 5, "two ints destructured from a later fn: {i} + {j}");

  // Past 8 bytes — the synthetic `__tuple<…>` struct path.
  (x, y, z) = three_singles(1.0f, 2.0f, 3.0f);
  assert(x + y + z == 6.0f, "three singles from a later fn: {x} {y} {z}");

  // A heap element, so the destructure has to materialise rather than copy a word.
  (name, count) = a_pair();
  assert(name == "hi", "text element from a later fn: '{name}'");
  assert(count == 7, "scalar element beside it: {count}");

  // Re-binding a name that already exists must still take the tuple's value.
  i = 99;
  (i, j) = two_ints(10, 20);
  assert(i == 10, "re-bound destructure target is {i}");

  print("960 ok\n");
}

fn two_ints(p: integer, q: integer) -> (integer, integer) { (p, q) }

fn three_singles(p: single, q: single, r: single) -> (single, single, single) { (p, q, r) }

fn a_pair() -> (text, integer) { ("hi", 7) }
