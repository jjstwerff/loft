// #481 (the consumer-free half): a heap-ref coroutine yield is a DbRef into
// the generator's state store — the consumer loop var binds as a BORROW of
// the generator, never freed per iteration.  Before the fix every iteration
// whole-store-freed the generator's state store (recycled under allocation
// pressure → corrupted worklists) and tripped the BUG(#306) stack-store
// guard on the exhausted null.  The wrap harness leak-checks both cells.

struct CyNode { cy_v: integer, cy_kids: vector<CyNode> }

// Grow-only struct worklist generator — yielded elements are views into the
// state store.
fn cy_gen_walk(cg_root: CyNode) -> iterator<CyNode> {
    cg_front = [cg_root];
    for cg_i in 0..100 {
        if cg_i >= len(cg_front) { cg_i#break; }
        cg_cur = cg_front[cg_i] ?? cg_root;
        yield cg_cur;
        for cg_k in cg_cur.cy_kids {
            cg_front += [cg_k];
        }
    }
}

fn test_yielded_views_borrow() {
    cy4 = CyNode { cy_v: 4, cy_kids: [] };
    cy5 = CyNode { cy_v: 5, cy_kids: [] };
    cy6 = CyNode { cy_v: 6, cy_kids: [] };
    cy2 = CyNode { cy_v: 2, cy_kids: [cy4, cy5] };
    cy3 = CyNode { cy_v: 3, cy_kids: [cy6] };
    cy1 = CyNode { cy_v: 1, cy_kids: [cy2, cy3] };
    cy_t = 0;
    cy_c = 0;
    for cy_w in cy_gen_walk(cy1) {
        cy_t += cy_w.cy_v;
        cy_c += 1;
    }
    assert(cy_c == 6 && cy_t == 21, "yielded views: count={cy_c} total={cy_t}");
}

// Owned-yield control: freshly constructed records also live in the state
// store (freed with the generator) — correct values, no leak.
struct CyBox { cb_v: integer }
fn cy_gen_fresh() -> iterator<CyBox> {
    for cf_i in 0..3 {
        yield CyBox { cb_v: cf_i * 10 + 7 };
    }
}

fn test_owned_yields_no_leak() {
    cf_t = 0;
    for cf_b in cy_gen_fresh() { cf_t += cf_b.cb_v; }
    assert(cf_t == 51, "owned yields: {cf_t}");
}
