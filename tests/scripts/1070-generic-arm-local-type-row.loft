//
// loft#1070 — a monomorph must not keep a TYPE ROW the template baked while the type was
// still `T`.
//
// A schema id is a `const u16` ARGUMENT (`OpDatabase(v, db_tp)`, `OpCopyRecord(src, dst,
// tp)`, …), not a type — so type substitution, which rewrites the variable table and every
// type annotation, walks straight past it.  A site the template lowered against `T` kept
// pointing at `__typevar_T`'s row, and the record it allocated had the type VARIABLE's
// layout: reading a field landed on another word.
//
// `f<T>(x: T, c: boolean) -> T { if c { y: T = x; y } else { z: T = x; z } }` answered
// `4294967198` — `-98` read as an unsigned 32-bit word — for a `-7` it was handed.  Both
// backends, no diagnostic, and one leaked `__typevar_T` store per call.  The only signal
// was the leak warning naming a store type, which says nothing about a wrong value.
//
// The cure is total rather than a list of sites: after substitution the type variable does
// not exist, so EVERY surviving reference to its row is stale by construction.  The rows
// are found from each op's own declaration (an argument named `tp` or `…_tp`), so an op
// added later is covered without being enumerated.
//
// What made it hard to see: the arm-LOCAL was right and the return WRAPPER was wrong, in
// the same arm.  A local declared in source re-derives its row from the substituted
// variable table; the compiler-built `materialized_view_return` block around it was
// constructed once, at template parse, from the type the arm had then.  So the cells below
// sweep where the value is BUILT, not where it is returned.

struct S1070 { a: integer }
struct T1070 { a: integer, b: text }

pub fn arms1070<T>(x: T, c: boolean) -> T {
  if c { y: T = x; y } else { z: T = x; z }
}
pub fn outside1070<T>(x: T, c: boolean) -> T { r: T = x; if c { r } else { r } }
pub fn nested1070<T>(x: T, n: integer) -> T {
  if n > 1 { a: T = x; a } else { if n == 1 { b: T = x; b } else { c: T = x; c } }
}

fn test_a_local_declared_inside_each_arm() {
  // The filed repro. `-7` and not `4294967198`: the arm's record must carry S1070's
  // layout, not the type variable's.
  v = S1070 { a: -7 };
  assert(arms1070(v, true).a == -7, "the taken arm: got {arms1070(v, true).a}");
  assert(arms1070(v, false).a == -7, "the other arm: got {arms1070(v, false).a}");
}

fn test_a_local_declared_outside_the_if() {
  // This one always answered correctly — it is the control that says the axis is WHERE the
  // local is declared, not that generics-with-`if` are broken wholesale.
  v = S1070 { a: -8 };
  assert(outside1070(v, true).a == -8, "declared outside, taken: got {outside1070(v, true).a}");
  assert(outside1070(v, false).a == -8, "declared outside, other: got {outside1070(v, false).a}");
}

fn test_arms_nested_two_deep() {
  // The rewrite walks the whole body, so a row buried in an inner arm is reached too.
  v = S1070 { a: -9 };
  assert(nested1070(v, 2).a == -9, "outer arm: got {nested1070(v, 2).a}");
  assert(nested1070(v, 1).a == -9, "inner then: got {nested1070(v, 1).a}");
  assert(nested1070(v, 0).a == -9, "inner else: got {nested1070(v, 0).a}");
}

fn test_a_struct_carrying_a_text_field() {
  // A wrong row is a wrong LAYOUT, so a type whose fields are not all one width is where a
  // half-retargeted body shows a different wrong answer than the integer-only cells.
  t = T1070 { a: -11, b: "carried" };
  r = arms1070(t, true);
  assert(r.a == -11, "text-carrying struct, integer field: got {r.a}");
  assert(r.b == "carried", "text-carrying struct, text field: got {r.b}");
}

fn test_two_instantiations_keep_their_own_rows() {
  // Each monomorph is retargeted from its OWN bindings; one T must not be given another's
  // row. Distinct values so a crossed row cannot read as a pass.
  assert(arms1070(S1070 { a: -12 }, true).a == -12, "instantiation S: got {arms1070(S1070 { a: -12 }, true).a}");
  assert(arms1070(T1070 { a: -13, b: "x" }, true).a == -13, "instantiation T: got {arms1070(T1070 { a: -13, b: "x" }, true).a}");
}

fn main() {
  test_a_local_declared_inside_each_arm();
  test_a_local_declared_outside_the_if();
  test_arms_nested_two_deep();
  test_a_struct_carrying_a_text_field();
  test_two_instantiations_keep_their_own_rows();
}
