//
// @PLN114 — a `par` worker reads its tuple element rows from STORAGE, so it must
// use the storage layout.  Both readers (`parallel.rs::read_tuple_at_wide` and the
// native `generation/ops/parallel.rs::tuple_arg_prep`) used the STACK view, which
// was indistinguishable while the two coincided — every integer 8 bytes.  Once
// narrow elements got their declared width (`u8` = 1 byte) the readers walked the
// row at the wrong stride: this sum returned 1012184093813119760 instead of 36, on
// both backends, silently.
//
// No test covered a par over a vector of NARROW tuples, which is why the whole
// suite stayed green while it was broken.

fn add2(p: (u8, u16)) -> integer { p.0 + p.1 }
fn wide(p: (integer, integer)) -> integer { p.0 + p.1 }

fn test_par_over_narrow_tuple_vector() {
  v: vector<(u8, u16)> = [(1, 2), (3, 4), (5, 6), (7, 8)];
  total = 0;
  for e in v par(r = add2(e), 1) { total += r; }
  assert(total == 36, "par over vector<(u8,u16)>: expected 36, got {total}");
}

fn test_par_over_wide_tuple_vector() {
  // The shape that always worked — stack and storage widths agree here, so this
  // guards against a fix that breaks the coinciding case.
  v: vector<(integer, integer)> = [(10, 20), (30, 40)];
  total = 0;
  for e in v par(r = wide(e), 1) { total += r; }
  assert(total == 100, "par over vector<(integer,integer)>: expected 100, got {total}");
}
