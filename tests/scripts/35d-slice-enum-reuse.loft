// SPDX-License-Identifier: LGPL-3.0-or-later
// @PLN35 — regression for a PRE-EXISTING interpret-only miscompile of `v[lo..hi]` slicing on
// struct-enum vectors, isolated by the `..rest` reuse axis (rest-store-lifetime/ANALYSIS.md).
//
// The compile-time `#Slice materialise` path (parser/expressions.rs::materialize_iterator) read
// each element into a `comp` intermediate whose `= for_var` assignment DROPPED the read's borrow-
// dep.  For a STRUCT-ENUM element the read DEREFERENCES the record pointer, so `comp` — now typed
// as a plain owned `ref(T)` — was freed by the free-analysis (`OpFreeRef`), freeing the subject's
// OWN enum record.  A single slice hid it (the corruption is only visible on a LATER read of the
// same range); slicing the same subject TWICE returned a corrupt (empty/short) second slice on the
// interpreter, while native paid a redundant copy and stayed correct.  Fixed by materialising the
// element ONCE (deep-copy the dep-carrying `for_var` straight into the fresh record), so native
// borrows (no leak) and the interpreter never frees the subject's record.  Guard on BOTH backends.

enum Detail { Ship { carrier: text }, Pickup { store: integer } }
struct P { x: integer, y: integer }

fn nslice(v: vector<Detail>, lo: integer, hi: integer) -> integer { s = v[lo..hi]; s.len() }
fn first_carrier(v: vector<Detail>, lo: integer, hi: integer) -> text {
  s = v[lo..hi];
  match s[0] { Ship { carrier } => carrier, _ => "?" }
}

fn main() {
  d = [Ship { carrier: "acme" }, Pickup { store: 2 }, Pickup { store: 3 }, Pickup { store: 4 }];

  // reuse the SAME subject: both slices must have the same length (the bug returned 0 on the 2nd)
  assert(nslice(d, 1, 4) == 3, "1st struct-enum slice len: {nslice(d, 1, 4)}");
  assert(nslice(d, 1, 4) == 3, "2nd struct-enum slice len (reuse — subject must be intact): {nslice(d, 1, 4)}");
  assert(nslice(d, 1, 4) == 3, "3rd struct-enum slice len (reuse): {nslice(d, 1, 4)}");

  // payload of a sliced element must survive reuse too (the freed record's field read garbage)
  assert(first_carrier(d, 0, 2) == "acme", "1st sliced payload: {first_carrier(d, 0, 2)}");
  assert(first_carrier(d, 0, 2) == "acme", "2nd sliced payload (reuse): {first_carrier(d, 0, 2)}");

  // the subject itself must be unchanged after all the slicing
  assert(d.len() == 4, "subject length intact: {d.len()}");
  match d[0] { Ship { carrier } => assert(carrier == "acme", "subject head intact: {carrier}"), _ => assert(false, "subject head corrupted") }

  // control: plain-struct slice reuse was always fine — assert it stays fine
  ps = [P { x: 1, y: 1 }, P { x: 2, y: 2 }, P { x: 3, y: 3 }];
  psa = ps[0..2];
  psb = ps[0..2];
  assert(psa.len() == 2 && psb.len() == 2, "plain-struct slice reuse: {psa.len()},{psb.len()}");

  print("35d-slice-enum-reuse: PASS");
}
