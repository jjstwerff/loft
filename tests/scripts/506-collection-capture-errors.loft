//
// @PLN93 (#511) — read, key/index lookup, iteration, and point-assignment
// (`h[key] = value`) through a captured collection all work (see 505).  The one
// remaining gap is APPEND (`h += …`): the assign target resolves to a throwaway
// local, not the captured store, so the insert would be silently lost — rejected
// at parse time with a pointer to the working `h[key] = value` form.
// @EXPECT_ERROR: cannot append (`+=`) to a collection captured into a closure

struct K { id: integer, v: integer }
fn c0(cb: fn() -> integer) -> integer { cb() }

fn test_reject_append() {
  h: hash<K[id]> = [];
  _ = c0(fn() -> integer { h += K { id: 1, v: 1 }; 0 });
}
