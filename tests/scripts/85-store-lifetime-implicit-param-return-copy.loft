//
// @PLN85 Cluster-A.2 (OWNERSHIP_MODEL row 104) — regression guard: a fn that
// returns one of its vector PARAMETERS via an IMPLICIT tail (`{ v }`, no
// `return` keyword) must deliver an independent COPY to the caller, not alias
// the caller's value.  This is the implicit-tail sibling of the explicit
// `return v` case (85-store-lifetime-param-return-copy.loft): the explicit path
// already copied in `parse_return`, but the implicit-tail path went through
// `block_result` → `ref_return`, which recorded the param as a BORROW dep
// (`vector<u8>["v"]`) so the caller aliased the arg.
//
// Before the A.2 funnel, `a = idv(x); x += [9]` mutated `a` too (a.len became
// 4) on BOTH backends (matrix cell a2).  Fix: the implicit whole-arg vector
// tail funnels to the same copy-into-`__retbuf` the struct-field tail (#415)
// and the explicit `return v` use — one funnelled return path.

fn idv(v: vector<u8>) -> vector<u8> {
  v
}

fn main() {
  x: vector<u8> = [1, 2, 3];
  a = idv(x);
  x += [9];
  assert(a.len() == 3, "implicit param-return must COPY: a stays length 3, not alias x's growth");
  assert(x.len() == 4, "x grew to 4");
}
