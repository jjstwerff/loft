// @PLN97 Phase B — dynamic both-backend layout parity.
struct Scalars { b: boolean, c: character, s: single, f: float, i: integer, t: text }
struct Narrow { a: i32, b: u8, c: u16 }
struct Wide { s: i16 }
struct VecNest { vv: vector<vector<integer>> }
struct Tup { pair: (integer, text) }
enum Color { Red, Green, Blue }
enum Shape { Circle { radius: integer }, Rect { width: integer, height: integer } }

fn shape_val(s: Shape) -> integer {
  match s { Circle { radius } => radius, Rect { width, height } => width * height }
}

fn main() {
  // Base widths + field reads (a wrong offset on either backend corrupts a value).
  sc = Scalars { b: true, c: 'Z', s: 1.5 as single, f: 2.5, i: 42, t: "hi" };
  assert(sc.b && sc.c == 'Z' && sc.i == 42 && sc.t == "hi", "scalars fields");

  // Narrow storage widths — distinctive per-width values near the edges.
  nw = Narrow { a: 2000000000, b: 200, c: 60000 };
  assert(nw.a == 2000000000 && nw.b == 200 && nw.c == 60000, "narrow i32/u8/u16");
  wd = Wide { s: -30000 };
  assert(wd.s == -30000, "narrow i16");

  // Nested-vector element stride at RUNTIME (the #477 surface).
  vn = VecNest { vv: [[1, 2, 3], [4, 5], [6]] };
  assert(vn.vv[0][2] == 3 && vn.vv[1][0] == 4 && vn.vv[2][0] == 6, "nested vector reads");
  assert(vn.vv[0].len() == 3 && vn.vv[1].len() == 2 && vn.vv[2].len() == 1, "nested vector lens");

  // Tuple element packing.
  tp = Tup { pair: (7, "seven") };
  assert(tp.pair.0 == 7 && tp.pair.1 == "seven", "tuple packing");

  // Enum tag + variant-field layout.
  col = Color.Green;
  assert(col == Color.Green && col != Color.Red, "plain enum tag");
  ci = Circle { radius: 5 };
  rc = Rect { width: 3, height: 4 };
  assert(shape_val(ci) == 5 && shape_val(rc) == 12, "enum with data");

  println("layout-parity ok");
}
