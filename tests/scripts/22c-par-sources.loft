// par() over every iterable source — vector, range, and the keyed
// collections (hash / sorted / index).  Non-vector sources are materialised
// into a flat vector before the par dispatcher partitions it.  Reductions
// are order-independent (sum / count), so the hash's unordered par walk is
// fine.  See @P270 (the range case once hung the parser).
//
// The result variable `r` is deliberately REUSED across loops with conflicting
// return types (integer / float / boolean / text / struct) — this guards the
// two-pass result-var fix: a global-counter-named `b_var` mis-typed `r` across
// many mixed par loops (`r.len()` on a text result seen as integer).  The
// per-loop-keyed name keeps the var two-pass-stable.

struct Rec {
  k: integer,
  v: integer,
}

fn dbl(x: integer) -> integer {
  return x * 2;
}
fn half(x: integer) -> float {
  return(x as float) / 2.0;
}
fn even(x: integer) -> boolean {
  return x % 2 == 0;
}
fn rec_dbl(r: const Rec) -> integer {
  return r.v * 2;
}
fn char_one(c: character) -> integer {
  if c == ' ' { return 0; } return 1;
}
fn label(x: integer) -> text {
  return "v{x}";
}
fn wrap(s: text) -> text {
  return "[{s}]";
}
// literal-returning text worker (@P205 nwb / #273): no work buffer, owned String.
fn lit(x: integer) -> text {
  if x > 1 { return "big"; } return "sm";
}
fn mk_box(x: integer) -> Rec {
  return Rec { k: x, v: x * 2 };
}
fn add5(n: integer) -> integer {
  return n + 5;
}
// fn-ref-returning worker (#281): native must lower QueueStitch::Fn.
fn pick(x: integer) -> fn(integer) -> integer {
  return add5;
}

fn main() {
  // --- range source, integer worker ---
  s1 = 0;
  for i in 0..5 par(r = dbl(i), 3) { s1 += r; }
  assert(s1 == 20, "range int par: {s1}");

  // --- range source, float worker ---
  s2 = 0.0;
  for i in 0..4 par(r = half(i), 2) { s2 += r; }
  assert(s2 == 3.0, "range float par: {s2}");

  // --- range source, boolean worker ---
  c = 0;
  for i in 0..6 par(r = even(i), 2) {
    if r { c += 1; }
  }
  assert(c == 3, "range bool par: {c}");

  // --- plain vector<integer> source ---
  v = [1, 2, 3, 4, 5];
  s3 = 0;
  for i in v par(r = dbl(i), 2) { s3 += r; }
  assert(s3 == 30, "vector int par: {s3}");

  // --- text source, character worker ---
  n = 0;
  for ch in "hello" par(r = char_one(ch), 2) { n += r; }
  assert(n == 5, "text source par: {n}");

  // --- text-RETURNING worker over a primitive (range) source ---
  // Guards the interpreter text-queue input ladder: a primitive element must
  // reach the worker as its value, not as a DbRef ("v0","v1","v2" each len 2).
  tn = 0;
  for i in 0..3 par(r = label(i), 2) { tn += r.len(); }
  assert(tn == 6, "text-return par over range: {tn}");

  // --- text-INPUT worker over a vector<text> source ---
  // The worker's `text` parameter must receive the element as a string, not the
  // raw element DbRef (both backends).  Each "[{s}]" is len(s)+2.
  tv = ["a", "bb", "ccc"];
  ti = 0;
  for s in tv par(r = wrap(s), 2) { ti += r.len(); }
  assert(ti == 12, "text-input par: {ti}");

  // --- literal-returning text worker (#273): no work buffer, owned String ---
  // Must compile + run on --native (the closure must not pass a work buffer the
  // worker lacks).  0..3 -> "sm","sm","big" -> total length 2+2+3 = 7.
  lt = 0;
  for i in 0..3 par(r = lit(i), 2) { lt += r.len(); }
  assert(lt == 7, "literal text-return par: {lt}");

  // --- struct/reference-RETURNING worker over a primitive (range) source ---
  // Guards the ref-return queue input ladder: a primitive element must reach the
  // worker as its value, not the element DbRef.  v = 2*i -> sum 0+2+4+6 = 12.
  bs = 0;
  for i in 0..4 par(b = mk_box(i), 2) { bs += b.v; }
  assert(bs == 12, "ref-return par over range: {bs}");

  // --- fn-ref-RETURNING worker (#281): native QueueStitch::Fn lowering ---
  // Each worker returns the (non-capturing) fn `add5`; the body calls it.
  // 3 rows x add5(10)=15 -> 45.
  fsum = 0;
  for i in 0..3 par(fr = pick(i), 2) { fsum += fr(10); }
  assert(fsum == 45, "fn-ref-return par: {fsum}");

  // --- hash source (unordered par walk; sum is order-independent) ---
  h: hash<Rec[k]> = [];
  h += [
    Rec { k: 3, v: 30 },
    Rec { k: 1, v: 10 },
    Rec { k: 2, v: 20 },
  ];
  hs = 0;
  for x in h par(r = rec_dbl(x), 2) { hs += r; }
  assert(hs == 120, "hash par: {hs}");

  // --- sorted source ---
  srt: sorted<Rec[k]> = [];
  srt += [
    Rec { k: 2, v: 20 },
    Rec { k: 1, v: 10 },
  ];
  ss = 0;
  for x in srt par(r = rec_dbl(x), 2) { ss += r; }
  assert(ss == 60, "sorted par: {ss}");

  // --- index source ---
  ix: index<Rec[k]> = [];
  ix += [
    Rec { k: 1, v: 10 },
    Rec { k: 2, v: 20 },
  ];
  ixs = 0;
  for x in ix par(r = rec_dbl(x), 2) { ixs += r; }
  assert(ixs == 60, "index par: {ixs}");
}
