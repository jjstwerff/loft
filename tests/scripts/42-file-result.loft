// L3: FileResult enum for filesystem operations
// @PLN9: cwd-relative paths — this test creates and reads scratch files in the cwd.
#cwd

fn main() {
  // Cleanup from any previous failed run
  delete("test_loft_fr.txt");
  delete("test_loft_fr2.txt");

  // --- delete() returns FileResult ---
  // Delete a non-existent file returns NotFound
  assert(delete("nonexistent_fr_xyz.txt") == FileResult.NotFound, "delete non-existent");
  assert(!delete("nonexistent_fr_xyz.txt").ok(), "delete non-existent not ok");

  // loft#712: a `..` path is resolved, not filtered — deleting through one
  // reports on the FILE, so an absent target is NotFound like any other.
  assert(delete("../nonexistent_fr_712.txt") == FileResult.NotFound, "delete .. absent is NotFound");

  // Create a file, then delete it successfully
  {
    f = file("test_loft_fr.txt");
    f += "test content";
  }
  assert(delete("test_loft_fr.txt") == FileResult.Ok, "delete existing file");
  assert(!delete("test_loft_fr.txt").ok(), "delete already deleted");

  // --- mkdir_all() returns FileResult ---
  // mkdir_all is idempotent — safe even if dir exists from a prior run
  assert(mkdir_all("test_loft_fr_dir/a/b").ok(), "mkdir_all nested");

  // --- mkdir() returns FileResult ---
  // mkdir on already-existing directory is not ok
  r = mkdir("test_loft_fr_dir");
  assert(!r.ok(), "mkdir on existing dir not ok");

  // delete() on a directory returns IsDirectory (remove_file refuses a directory).
  // @PLN102 H9 — the classified variants (IsDirectory, PermissionDenied) are now
  // produced by the runtime, not collapsed to Other. (PermissionDenied is not
  // asserted here: CI may run as root, which bypasses the permission check.)
  assert(delete("test_loft_fr_dir") == FileResult.IsDirectory, "delete directory -> IsDirectory");

  // --- rmdir() returns FileResult, and this test now cleans up after itself ---
  // loft#1256: until `rmdir` existed there was no way to remove a directory, so this file
  // left `test_loft_fr_dir/a/b` on disk on EVERY run and only looked idempotent because
  // `mkdir_all` is.  The removal is deepest-first, which is the walk the primitive is meant
  // to make writable.
  assert(rmdir("test_loft_fr_dir") == FileResult.NotEmpty, "rmdir a non-empty dir -> NotEmpty");
  assert(rmdir("test_loft_fr_dir/a/b").ok(), "rmdir the deepest level");
  assert(rmdir("test_loft_fr_dir/a").ok(), "rmdir the middle level");
  assert(rmdir("test_loft_fr_dir").ok(), "rmdir the root of it");
  assert(rmdir("test_loft_fr_dir") == FileResult.NotFound, "rmdir an absent dir -> NotFound");
  assert(!exists("test_loft_fr_dir"), "the directory tree is gone");
  // A FILE handed to rmdir is not a directory question, so it is Other rather than a
  // silent success — the mirror of delete()'s IsDirectory above.
  {
    fdir = file("test_loft_fr_notadir.txt");
    fdir += "x";
  }
  assert(rmdir("test_loft_fr_notadir.txt") == FileResult.Other, "rmdir a FILE -> Other");
  assert(exists("test_loft_fr_notadir.txt"), "and the file is still there");
  assert(delete("test_loft_fr_notadir.txt").ok(), "clean up the file");

  // --- move() returns FileResult ---
  {
    f2 = file("test_loft_fr.txt");
    f2 += "move test";
  }
  assert(move("test_loft_fr.txt", "test_loft_fr2.txt").ok(), "move succeeds");
  assert(!move("nonexistent_fr_src.txt", "dst.txt").ok(), "move missing source");

  // --- ok() convenience method ---
  assert(FileResult.Ok.ok() == true, "Ok.ok() is true");
  assert(FileResult.NotFound.ok() == false, "NotFound.ok() is false");
  assert(FileResult.PermissionDenied.ok() == false, "PermissionDenied.ok() is false");

  // Cleanup
  delete("test_loft_fr2.txt");
}
