//
// loft#988 — a `par` worker declared BELOW its loop typed the result variable `b` as
// `integer`, whatever it returns.
//
// On pass 1 an unresolved worker answers `(u32::MAX, Unknown)` — both of the conditions
// `b_type` tests, and the wrong one won.  The slot was pinned to `integer`, and pass 2
// refines only a slot that is still unknown, so it stayed.  What made it visible was a
// COMPOUND assignment: `t += b` retyped a float accumulator to integer and the pass-1
// error aborted the parse, while `t = t + b` coerces and passed.  Both spellings, and
// every return type, belong here.
//
// The loop is the last statement of each function on purpose: a par loop with a
// below-declared worker also reads as a VALUE rather than a statement, so anything
// after it demands a `;`.  That is its own defect and its own fix; keeping the loop
// last means this file measures the TYPE and nothing else.

fn test_988_float_compound() {
  t = 0.0;
  for a in 1..=4 par(b = i988_half(a), 4) {
    t += b;
    // Results reach the body in SOURCE order (@F33), so the last row sees the total.
    if a == 4 { assert(t == 5.0, "float += expected 5.0, got {t}"); }
  }
}

fn test_988_float_plain() {
  t = 0.0;
  for a in 1..=4 par(b = i988_half(a), 4) {
    t = t + b;
    if a == 4 { assert(t == 5.0, "float = t + b expected 5.0, got {t}"); }
  }
}

fn test_988_float_other_compounds() {
  d = 64.0;
  for a in 1..=4 par(b = i988_half(a), 4) {
    d /= b;
    if a == 4 {
      assert(d > 42.66 && d < 42.67, "float /= expected 42.666…, got {d}");
    }
  }
}

fn test_988_integer_compound() {
  n = 0;
  for a in 1..=4 par(b = i988_sq(a), 4) {
    n += b;
    if a == 4 { assert(n == 30, "integer += expected 30, got {n}"); }
  }
}

fn test_988_text_compound() {
  s = "";
  for a in 1..=3 par(b = i988_name(a), 4) {
    s += b;
    if a == 3 { assert(s == "n1n2n3", "text += expected n1n2n3, got {s}"); }
  }
}

fn test_988_boolean_result() {
  c = 0;
  for a in 1..=4 par(b = i988_big(a), 4) {
    if b { c += 1; }
    if a == 4 { assert(c == 2, "boolean result expected 2 hits, got {c}"); }
  }
}

fn test_988_vector_accumulate() {
  v: vector<float> = [];
  for a in 1..=3 par(b = i988_half(a), 4) {
    v += [b];
    if a == 3 {
      assert(len(v) == 3, "vector accumulate expected 3 elements, got {len(v)}");
      assert(v[2] == 1.5, "vector accumulate expected 1.5 last, got {v[2]}");
    }
  }
}

// Every worker below its loop — that is the whole axis under test.
fn i988_half(v: integer) -> float { v * 0.5 }
fn i988_sq(v: integer) -> integer { v * v }
fn i988_name(v: integer) -> text { "n{v}" }
fn i988_big(v: integer) -> boolean { v > 2 }
