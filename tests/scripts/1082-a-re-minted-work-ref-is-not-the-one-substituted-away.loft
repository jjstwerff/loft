//
// A `__ref_N` return-buffer name that PASS 1 substituted away and PASS 2 re-mints for a
// different call.
//
// `ref_return`'s `Bind { substitute: true }` replaces every use of a site-value work-ref
// with the return buffer and calls `unregister_work_ref`, which drops the registry entry
// AND sets `skip_free` — sound for the pass that just removed every use.  But the two
// parser passes do not agree on the `__ref_N` numbering: a call whose callee is declared
// LATER in the file returns an unresolved type on pass 1, so no buffer is minted for it,
// and on pass 2 one is — shifting every `__ref_N` after it by one.  `add_variable` already
// says in its own comment that the same generated NAME can denote a DIFFERENT SITE per
// pass, and lets pass 2 win on the TYPE.  The per-site FLAGS were not given the same
// treatment: re-minting re-registers the ref but left `skip_free` standing.
//
// `skip_free` is a free-time fact ("do not emit OpFreeRef"), but `gen_set_first_vector_null`
// also reads it as "borrows, do not allocate".  So the buffer reached the callee as
// `DbRef::NULL` and the callee's `OpAppendVector(__retbuf, …)` indexed `stores[u16::MAX]` —
// a release-build panic naming neither the variable nor the type, since the `debug_assert!`
// above it is compiled out.  Found by `drawing::parse_fronds` (loft#1082), where pass 1's
// `__ref_11` became pass 2's buffer for a `smooth_vals` call.
//
// The three return SITES are what push the numbering far enough for pass 1's tail ref to
// collide with a pass-2 vector buffer; the forward reference is what shifts it.  Both are
// load-bearing — this file is worth nothing if either is dropped.

struct M1082 { ok: boolean, pts: vector<float> }

fn no_mark1082() -> M1082 { M1082 { ok: false, pts: [] } }
fn head1082(a: integer) -> M1082 { M1082 { ok: true, pts: [a as float, 9.5] } }

fn parse1082(n: integer) -> M1082 {
  w = build1082(n);
  if n > 0 { return head1082(len(w)) }
  if n < -5 { return no_mark1082() }
  no_mark1082()
}

// Declared AFTER its caller on purpose — see above.  Two append SITES, because one leaves
// the callee on the rename path where its own buffer is never consulted.
fn build1082(n: integer) -> vector<float> {
  o: vector<float> = [];
  o += [n as float];
  o += [2.0];
  o
}

// The same shape with the callee declared FIRST — no drift, and it must stay clean.
fn build_early1082(n: integer) -> vector<float> {
  o: vector<float> = [];
  o += [n as float];
  o += [4.0];
  o
}
fn parse_nodrift1082(n: integer) -> M1082 {
  w = build_early1082(n);
  if n > 0 { return head1082(len(w)) }
  if n < -5 { return no_mark1082() }
  no_mark1082()
}

fn test_the_forward_declared_buffer_is_allocated() {
  // `build1082` answers two elements, so `head1082` is handed 2 and its first point is
  // 2.0 — a value that only exists if the callee actually wrote into a real store.
  m = parse1082(1);
  assert(m.ok, "the n>0 arm answers ok");
  assert(len(m.pts) == 2, "head1082 answers 2 points, got {len(m.pts)}");
  assert((m.pts[0] ?? -1.0) == 2.0, "build1082 answered 2 elements, got {m.pts[0] ?? -1.0}");
  assert((m.pts[1] ?? -1.0) == 9.5, "the second point is 9.5, got {m.pts[1] ?? -1.0}");
}

fn test_the_other_return_sites_still_answer() {
  a = parse1082(-1);
  assert(!a.ok, "the fall-through tail answers not-ok");
  assert(len(a.pts) == 0, "the tail answers no points, got {len(a.pts)}");
  b = parse1082(-9);
  assert(!b.ok, "the mid return answers not-ok");
  assert(len(b.pts) == 0, "the mid return answers no points, got {len(b.pts)}");
}

fn test_the_undrifted_twin_is_unchanged() {
  m = parse_nodrift1082(1);
  assert(m.ok, "the no-drift twin answers ok");
  assert((m.pts[0] ?? -1.0) == 2.0, "the no-drift twin answers 2 elements too");
}

fn test_many_calls_do_not_accumulate_stores() {
  // Per CALL: the buffer is minted once per call, so a loop is what makes a missing free
  // visible to the harness's leak gate, and the sum is what makes an over-free visible.
  t = 0;
  for i in 0..30 {
    m = parse1082(if i % 3 == 0 { 1 } else { -1 });
    t += len(m.pts);
  }
  assert(t == 20, "ten ok-arms answer two points each, got {t}");
}
