//
// @P300 — assigning the result of a call that RETURNS a keyed
// collection (`sorted`/`hash`/`index<T[K]>`) to a local, on BOTH
// backends.  Used to panic in codegen (`Incorrect var x[65535]`): the
// @P295 reassignment lowering fired for the FIRST assignment too and
// dropped the `Set` node, so the local got no stack slot.  Fixed by
// prepending `Set(x, Null)` in the keyed-assignment branch — `scan_set`
// keeps it on a first assignment (store init) and elides it on a
// reassignment (bare `OpReplaceKeyed` reuses the existing store).

struct Item {
  k: integer,
}
struct HRec {
  ck: integer,
  v: integer,
}
struct IRec {
  n: integer,
}

fn mk_hash() -> hash<HRec[ck]> {
  h: hash<HRec[ck]> = [];
  h += [
    HRec { ck: 5, v: 9 },
  ];
  h += [
    HRec { ck: 8, v: 12 },
  ];
  h
}

fn mk_sorted() -> sorted<Item[k]> {
  s: sorted<Item[k]> = [];
  s += [
    Item { k: 3 },
  ];
  s += [
    Item { k: 1 },
  ];
  s += [
    Item { k: 2 },
  ];
  s
}

fn mk_index() -> index<IRec[n]> {
  ix: index<IRec[n]> = [];
  ix += [
    IRec { n: 7 },
  ];
  ix += [
    IRec { n: 3 },
  ];
  ix
}

fn main() {
  // --- hash return, untyped first-assign + key lookup ---
  xh = mk_hash();
  assert(len(xh) == 2, "hash return len");
  assert(xh[5].v == 9 && xh[8].v == 12, "hash return lookup");

  // --- hash return, typed first-assign ---
  yh: hash<HRec[ck]> = mk_hash();
  assert(len(yh) == 2, "typed hash return len");

  // --- sorted return, ordered read ---
  xs = mk_sorted();
  s_out = "";
  for it in xs { s_out += "{it.k} "; }
  assert(s_out == "1 2 3 ", "sorted return ordered: {s_out}");

  // --- index return ---
  xi = mk_index();
  assert(len(xi) == 2, "index return len");

  // --- Var-RHS alias first-assign: deep-copy keeps both usable ---
  ns = mk_hash();
  alias = ns;
  assert(len(alias) == 2, "alias len");
  assert(len(ns) == 2, "source still readable after alias");

  // --- reassign-from-call: existing store reused, no leak ---
  r: sorted<Item[k]> = [];
  r += [
    Item { k: 99 },
  ];
  r = mk_sorted();
  assert(len(r) == 3, "reassign-from-call len");

  println("120-keyed-return-assign ok");
}
