// @P285 — json_parse must combine UTF-16 surrogate pairs and skip a leading BOM.
//
// JSON encodes a non-BMP character as a `\uHI\uLO` surrogate pair (Python's
// default `json.dumps(ensure_ascii=True)` emits this for every non-ASCII char).
// loft used to decode each `\uXXXX` independently; a surrogate code unit is not
// a scalar, so each half became U+FFFD and `😀` came back as `��` (6 bytes, not
// 4).  A leading UTF-8 BOM (`EF BB BF`, common from Windows/.NET editors) was
// also not skipped, so a BOM-prefixed document failed to parse.
// Locks both fixes on every backend (interpreter / native / wasm).
//
// Each `json_parse` result is bound to a `JsonValue` local (freed at scope end)
// rather than left as a chained temporary, which the program-end scope-free gap
// (@P322) would otherwise leak.
fn main() {
  // (1) escaped surrogate pair decodes to the same scalar as raw UTF-8.
  jesc = json_parse("\"\\uD83D\\uDE00\"");
  jraw = json_parse("\"😀\"");
  escaped = jesc.as_text();
  raw = jraw.as_text();
  assert(escaped == raw, "escaped pair must equal raw UTF-8");
  assert(escaped == "😀", "pair decodes to U+1F600");
  assert(escaped.size() == 4, "U+1F600 is 4 UTF-8 bytes (was 6 = two U+FFFD)");

  // (2) mixed BMP + non-BMP + ASCII in one string, pair not at the end.
  jmix = json_parse("\"a\\u2192b\\uD83D\\uDE00c\"");
  assert(jmix.as_text() == "a→b😀c", "mixed BMP/non-BMP/ASCII round-trips");

  // (3) lone/half surrogates and BMP escapes still behave (regression guard).
  jhi = json_parse("\"\\uD83D\""); // lone high  → U+FFFD
  assert(jhi.as_text().size() == 3, "lone high surrogate is one U+FFFD");
  jlo = json_parse("\"\\uDE00\""); // lone low   → U+FFFD
  assert(jlo.as_text().size() == 3, "lone low surrogate is one U+FFFD");
  jha = json_parse("\"\\uD83D\\u0041\""); // high + 'A' (not a low surrogate)
  assert(jha.as_text().size() == 4, "lone high (U+FFFD) + 'A' = 4 bytes");
  jbmp = json_parse("\"\\u2192\""); // → (BMP, unchanged)
  assert(jbmp.as_text() == "→", "BMP \\u escape unchanged");

  // (4) a single leading UTF-8 BOM is ignored at parse entry.
  bom = json_parse("\u{FEFF}{{\"a\": 1}}");
  assert(bom.kind() == "JObject", "BOM-prefixed object parses");
  assert(bom.field("a").as_long() == 1, "BOM-prefixed object field value");

  println("json surrogate-pair + BOM: ok");
}
