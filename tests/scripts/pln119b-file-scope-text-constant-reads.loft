//
// The far side of `pln119-assign-to-file-scope-text.loft`: WRITING a file-scope text
// constant is refused, and READING one still answers its value — the constant is inlined
// at the use.
//
// Its own file because the refusal's is a file that never executes: a firing
// `@EXPECT_ERROR` stops `wrap` at "errors consumed" and drops the file from the native
// suite, so this assertion was compiled and never run while it lived beside the refusal.

PLN119_CONST_TEXT: text = "";

fn main() {
  assert(len(PLN119_CONST_TEXT) == 0, "a file-scope text constant reads as its value");
}
