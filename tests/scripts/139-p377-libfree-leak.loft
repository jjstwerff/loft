// Regression for @P377 — under `--interpret`, a function with a struct VALUE
// parameter returning a freshly-allocated store-backed struct via an
// intermediate local (`fn render_struct(p: P) -> Canvas { cv = alloc_canvas(...); cv }`)
// leaks ONE store per call.  The identical fn with only SCALAR params is clean,
// and `--native` is clean.  Dryopea-surfaced: the editor's per-frame
// `render_to_canvas(cam, world, …) -> Canvas` matches this shape exactly.
//
// Root mechanism (see PROBLEMS.md @P377): the struct param makes
// `has_ref_params == true` in `src/state/codegen.rs:gen_set_first_ref_call_copy`,
// routing through the deep-copy path where `is_borrowed_view` (the dep-chain
// gate) AND `has_hidden_ref` BOTH suppress the `0x8000` source-free.  The
// callee's returned `__ref_N` store therefore orphans every call.
//
// The leak is detected by `tests/wrap.rs::run_test`'s exit-time
// "stores not freed" gate (Canvas×9 under the loop below).

struct P { a: integer }
struct Canvas {
  data: vector<integer>,
  w: integer,
}

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

// CONTROL — scalar-only param.  Returned Canvas is freed cleanly.
fn render_scalar(a: integer) -> Canvas {
  cv = alloc_canvas(64, 48, a); cv
}

// TRIGGER — one struct param.  Returned Canvas LEAKS one store per call.
fn render_struct(p: P) -> Canvas {
  cv = alloc_canvas(64, 48, p.a); cv
}

fn main() {
  // CONTROL loop (clean baseline).
  for ci in 0..9 {
    cv = render_scalar(ci); _ = len(cv.data);
  }
  // TRIGGER loop — pre-fix: leaks `Canvas×9`.
  p = P { a: 1 };
  for ti in 0..9 {
    cv = render_struct(p); _ = len(cv.data);
  }
  println("done");
}
