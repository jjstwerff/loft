//
// Regression (plan-58 cluster IV): a NESTED-vector comprehension
// `[for i in 0..n { [..] }]` panicked "Write to read-only store (CONST_STORE
// init)".  Two coupled defects: (1) the per-element write used the scalar
// `set_field` path → `OpSetInt4` wrote 4 of a 12-byte handle → eval-stack skew →
// garbage rec-id into the locked CONST_STORE; (2) the comprehension's `known`
// over-wrapped one level (`vector(def(ed_nr).known_type)`) vs the proven
// `vv += [inner]` path, so `record_new` strided the outer slot by the 4-byte
// handle while the read strided by 8 → off-by-one (empty/lagged rows).
// Fix: deep-copy the inner record (OpCopyRecord) for a vector element, and use
// the element-type `known` (`vector_of(in_t)`, matching `new_record`).

struct Pt {
  x: integer,
  y: integer,
}

fn main() {
  // int element, const range
  vv: vector<vector<integer>> = [for i in 0..4 { [i, i * 2, i * 3] }];
  assert(len(vv) == 4, "len {len(vv)}");
  assert(vv[0][0] == 0 && vv[0][1] == 0 && vv[0][2] == 0, "row0 {vv[0]}");
  assert(vv[1][0] == 1 && vv[1][1] == 2 && vv[1][2] == 3, "row1 {vv[1]}");
  assert(vv[3][0] == 3 && vv[3][1] == 6 && vv[3][2] == 9, "row3 {vv[3]}");

  // runtime range (not const-foldable)
  n: integer = 3;
  rr: vector<vector<integer>> = [for i in 0..n { [i, i + 100] }];
  assert(rr[2][0] == 2 && rr[2][1] == 102, "runtime {rr[2]}");

  // single element
  sv: vector<vector<single>> = [for i in 0..3 { [1.5f, 2.5f] }];
  assert(sv[2][0] == 1.5f && sv[2][1] == 2.5f, "single {sv[2]}");

  // struct element
  pv: vector<vector<Pt>> = [for i in 0..3 { [
    Pt { x: i, y: i },
  ] }];
  assert(pv[2][0].x == 2 && pv[2][0].y == 2, "struct {pv[2][0].x},{pv[2][0].y}");

  println("nested-comprehension ok");
}
