// Probe 02 — Cluster I canonical: `vec[i] ?? "default"` (P383 reproducer)
//
// The LHS `h.items[0]` is non-trivial, so src/parser/operators.rs:1234-1244
// builds a value-block:
//
//     {#ncc:text
//       _ncc_N = OpGetText(h.items[0]);
//       if (_ncc_N != null) _ncc_N else "fallback";
//       OpFreeText(_ncc_N);    ← scopes::get_free_vars adds this
//     }
//
// Bytecode order (verified via `LOFT_LOG=fn:main`):
//   PC 99:  VarText(var[_ncc_N]) → "present"  ← push Str(ptr, len) on stack
//   PC 122: FreeText(var[_ncc_N])             ← drop _ncc_N's String
//   PC 125: AppendText(var[a], <raw:0x…>)     ← outer consumer; dangling ptr
//
// The `<raw:0x…>` marker is Str::try_str's escape-hatch for an unreadable
// pointer, confirming the use-after-free.  On macOS + rustc 1.96 the freed
// bytes are zeroed → `a` reads back 7 NUL bytes.  On Linux glibc, the
// freed bytes typically survive → test "passes" by accident.
//
// Expected (rustc 1.96 / macOS):
//   --interpret: FAIL with `a=\0\0\0\0\0\0\0`
//   --native:    PASS — emit.rs:1292 materialises `_ret.to_string()` inside
//                the block (the @P321e/@P323 fix; native escape).
// Status: P383 canonical, cluster I.

struct H { items: vector<text> }

fn main() {
  h = H { items: [] };
  h.items += ["present"];
  a = h.items[0] ?? "fallback";
  assert(a == "present", "probe 02: got '{a}', want 'present'");
  println("probe 02 PASSED");
}
