// Probe 53 — lambda that captures a variable from outer scope.
//
// Probe 30's lambda has no captures.  This probe adds a captured
// integer to test whether the dispatch gap is capture-related.
//
// Capturing lambdas in loft use the fn-ref's closure_capture DbRef
// field — a 16-byte (d_nr, closure_DbRef) layout vs. 4-byte fn-ref
// for non-capturing.  If the codegen path differs, the dispatch
// arms might be emitted for one shape but not the other.

fn main() {
  factor = 3;
  multiply = fn(x: integer) -> integer {
    x * factor
  };
  for i in 0..6 {
    v = multiply(i);
    assert(v == i * 3, "iter {i}: v = {v}");
  }
  println("probe 53 PASSED");
}
