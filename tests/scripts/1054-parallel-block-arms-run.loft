//
// loft#1054 — `parallel { … }` had no native lowering: it was emitted as a COMMENT, so
// the arms never ran and the program exited 0 having done none of the work.  Three
// existing files use the construct and all three PASSED natively while it did nothing,
// because nothing they check could tell a completed block from a skipped one:
// `80-parallel-block.loft` asserts `true` after the block, and `81`'s and `171`'s real
// oracles live INSIDE an arm, where a discarded result cannot reach the parent.
//
// So this file checks the one thing those cannot: that an arm RAN, from outside it.  An
// arm may not write enclosing state (that is a compile error — see
// `170-parallel-capture-soundness.loft`), and the block discards arm results, which
// leaves an EXTERNAL side effect as the only channel back.  Each arm writes its own file
// and the parent reads them.
//
// The content is `"A{outer}"`, not a fixed marker, so one assert covers both halves: the
// arm ran, AND it observed the enclosing variable at its declared value (the P245
// guarantee that `81-parallel-outer-vars.loft` states inside an arm and therefore cannot
// enforce from there).
//
// Separate files per arm, deliberately — two arms appending to ONE file race, and a test
// whose expected value depends on scheduling reports a bug it does not have.

// @PLN9: cwd-relative paths — this test does cwd-relative file I/O.
#cwd
fn cleanup() {
  delete("t1054_arm_a.txt");
  delete("t1054_arm_b.txt");
}

fn mark(path: text, payload: text) {
  f = file(path);
  f += payload;
  f.sync();
}

fn main() {
  cleanup();
  outer = 42;
  parallel {
    mark("t1054_arm_a.txt", "A{outer}");
    mark("t1054_arm_b.txt", "B{outer}");
  }

  a = file("t1054_arm_a.txt");
  assert(a#size == 3, "arm A left {a#size} bytes, expected 3 — the arm did not run");
  assert(a#read(3) as text == "A42", "arm A saw outer as something other than 42");

  b = file("t1054_arm_b.txt");
  assert(b#size == 3, "arm B left {b#size} bytes, expected 3 — the arm did not run");
  assert(b#read(3) as text == "B42", "arm B saw outer as something other than 42");

  cleanup();
  print("ok\n");
}
