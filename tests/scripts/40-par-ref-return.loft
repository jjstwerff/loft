// Parallel workers returning struct references.

struct Item {
  name: text,
  value: integer,
}

struct Items {
  list: vector<Item>,
}

struct Result {
  label: text,
  doubled: integer,
}

fn transform(src: const Item) -> Result {
  Result { label: "v{src.value}", doubled: src.value * 2 }
}

struct Pair {
  a: integer,
  b: integer,
}

fn make_pair(src: const Item) -> Pair {
  Pair { a: src.value, b: src.value * 3 }
}

fn test_par_struct_simple() {
  data = Items {};
  data.list += [
    Item { name: "x", value: 10 },
    Item { name: "y", value: 20 },
  ];
  total = 0;
  for par_s in data.list par(par_p = make_pair(par_s), 1) { total += par_p.a + par_p.b; }
  assert(total == 120, "simple struct: {total}");
}

fn test_par_struct_return_single_thread() {
  data = Items {};
  data.list += [
    Item { name: "a", value: 10 },
    Item { name: "b", value: 20 },
    Item { name: "c", value: 30 },
  ];
  total = 0;
  labels = "";
  for par_item in data.list par(par_res = transform(par_item), 1) {
    total += par_res.doubled;
    labels += "{par_res.label},";
  }
  assert(total == 120, "single thread total: {total}");
  assert(labels == "v10,v20,v30,", "single thread labels: {labels}");
}

fn test_par_struct_return_multi_thread() {
  data = Items {};
  data.list += [
    Item { name: "a", value: 5 },
    Item { name: "b", value: 15 },
    Item { name: "c", value: 25 },
    Item { name: "d", value: 35 },
  ];
  total = 0;
  for par_mt in data.list par(par_r2 = transform(par_mt), 4) { total += par_r2.doubled; }
  assert(total == 160, "multi thread total: {total}");
}

fn test_par_struct_return_empty() {
  data = Items {};
  count = 0;
  for par_empty in data.list par(par_r3 = transform(par_empty), 1) {
    count += par_r3.doubled * 0 + 1;
  }
  assert(count == 0, "empty: {count}");
}

// Workers returning a vector<T> — the ref path deep-copies each result into the
// `main_vector<T>` wrapper.  Regression guard for the native ref-return bug: the
// scalar path used to cast `DbRef as i64` (E0605), and row 0 read len 0 because
// its result landed at buffer pos 0 (a vector's null sentinel).
fn worker_vec(src: const Item) -> vector<integer> {
  v: vector<integer> = [];
  v += [src.value];
  v += [src.value * 2];
  v
}

fn worker_vec_text(src: const Item) -> vector<text> {
  v: vector<text> = [];
  v += ["a{src.value}"];
  v += ["bb{src.value}"];
  v
}

fn test_par_vector_return() {
  data = Items {};
  data.list += [
    Item { name: "a", value: 3 },
    Item { name: "b", value: 7 },
  ];
  total = 0;
  count = 0;
  for it in data.list par(vr = worker_vec(it), 2) {
    count += len(vr);          // row 0 (pos 0) MUST read len 2, not 0
    for x in vr { total += x; }
  }
  // rows [3,6] and [7,14]
  assert(count == 4, "vector return count: {count}");
  assert(total == 30, "vector return contents: {total}");
}

fn test_par_vector_text_return() {
  data = Items {};
  data.list += [
    Item { name: "a", value: 1 },
    Item { name: "b", value: 2 },
    Item { name: "c", value: 3 },
  ];
  nch = 0;
  for it in data.list par(vr = worker_vec_text(it), 2) {
    for s in vr { nch += len(s); }
  }
  // each row: "a{v}" (2 chars) + "bb{v}" (3 chars) = 5, over 3 rows = 15
  assert(nch == 15, "vector<text> return chars: {nch}");
}

// A variable (not literal) thread count — the native emitter used to leave it an
// i64 where the runtime helper wants i32 (E0308).
fn test_par_variable_thread_count() {
  data = Items {};
  data.list += [
    Item { name: "a", value: 5 },
    Item { name: "b", value: 15 },
    Item { name: "c", value: 25 },
  ];
  th = 2;
  scalar_total = 0;
  for it in data.list par(d = make_pair(it), th) { scalar_total += d.a + d.b; }
  // make_pair(v) = Pair { a: v, b: v*3 } → v + 3v = 4v; 4*(5+15+25) = 180
  assert(scalar_total == 180, "variable-thread scalar: {scalar_total}");

  vec_total = 0;
  for it in data.list par(vr = worker_vec(it), th) {
    for x in vr { vec_total += x; }
  }
  // worker_vec(v) = [v, 2v] → 3v; 3*(5+15+25) = 135
  assert(vec_total == 135, "variable-thread vector: {vec_total}");
}
