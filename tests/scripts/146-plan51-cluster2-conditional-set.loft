// Probe 28 — hidden buffer is ONLY Set inside a conditional, no initial Set.
//
//   fn render(p: P) -> Canvas {
//     cv: Canvas = Canvas { data: [], w: 0 };  // declared, default-init
//     if p.tag > 0 {
//       cv = alloc_canvas(4, 5, p.tag);
//     }
//     cv
//   }
//
// Compare with probe 26 (cond-never): probe 26 had `cv = alloc_canvas(...)`
// BEFORE the if and the if-false never fires.  Probe 26 leaks Canvas×6.
//
// This probe has a default-init Set, then a conditional Set.  Each iter
// the conditional fires (i>0 for 5 of 6 iters).  Tests whether the leak
// shifts to a default-init Canvas being orphaned, AND whether the leak
// count tracks if-firings.

struct P {
  tag: integer,
}
struct Canvas {
  data: vector<integer>,
  w: integer,
}

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render(p: P) -> Canvas {
  cv: Canvas = Canvas { data: [], w: 0 };
  if p.tag > 0 { cv = alloc_canvas(4, 5, p.tag); }
  cv
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv = render(p);
    if i > 0 {
      assert(cv.w == 4, "iter {i}: w = {cv.w}");
      assert(cv.data[0] == i, "iter {i}: data[0] = {cv.data[0]}");
    } else { assert(cv.w == 0, "iter {i}: default w = {cv.w}"); }
  }
  println("probe 28 PASSED");
}
