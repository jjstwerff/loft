//
// loft#762 — `_` is the universal discard, and one function may discard several
// different types.  `change_var_type` therefore retypes it silently and the C61
// shadow guards exempt it, both deliberately.  But there was only ONE `_` slot,
// so a `for _ in …` binding SHARED it with any earlier `_ = call()`.
//
// The interpreter retypes the slot and copes.  Native declares `let mut var__`
// once, with whichever type came first, and then assigns the other — E0308.  A
// program that runs correctly interpreted and does not compile.
//
// Filed as a `hash` bound with `store_persist_bind`, because that is where it
// was met: the bind is preceded by `_ = delete(path)`, which is what typed `_`
// as the FileResult the loop then contradicted.  Neither the store nor the hash
// is involved — a plain call and a plain vector do it.
//
// The ASSIGNMENT form never had the hole: `_ = f(); _ = mk()` with two types is
// rejected at parse time.  It is the loop path, exempt from that check, that
// retyped without complaint.

struct Rec { v: integer }
struct Oth { w: text }

fn bump(x: integer) -> integer { return x + 1; }

fn main() {
  // `_` is an integer here — this is what fixed its type before the loop.
  _ = bump(1);

  rs: vector<Rec> = [];
  for i in 0..3 { rs += [Rec { v: i }]; }

  // ... and a `ref(Rec)` here.  The two must not be the same slot.
  n = 0;
  for _ in rs { n += 1; }
  assert(n == 3, "discard loop after a discard assignment: {n}, want 3");

  // Two discard loops over DIFFERENT element types, which already worked and
  // must keep working — the guard would be half a guard without it.
  os: vector<Oth> = [];
  os += [Oth { w: "a" }];
  os += [Oth { w: "b" }];
  m = 0;
  for _ in rs { m += 1; }
  for _ in os { m += 1; }
  assert(m == 5, "two discard loops, two element types: {m}, want 5");

  // `_` is READABLE, and stays so: the loop's binding owns the name while its
  // body is parsed.  `anon-loop-counters.loft` pins this too; it is repeated
  // here because it is exactly what a per-loop slot could have broken.
  r = 0;
  for _ in 0..4 { r = r + _; }
  assert(r == 6, "the discard binding still reads as the current value: {r}, want 6");

  // A NAMED loop variable is unaffected — the shape that compiled all along.
  k = 0;
  for rec in rs { k += rec.v; }
  assert(k == 3, "named loop variable still binds: {k}, want 3");

  // And the outer discard is itself again after the loops: this assigns an
  // integer, not a `ref(Rec)`, because the loop's binding did not outlive it.
  _ = bump(2);

  println("762 discard loop binding ok");
}
