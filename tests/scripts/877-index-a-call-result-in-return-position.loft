//
// loft#877 — a return-position expression that INDEXES the result of a call.
//
// `fn head(n) -> Cell { make(n)[0] ?? Cell {} }` answered its `??` fallback for every
// input on the interpreter and indexed out of bounds on native. The `??` block's value
// depends on the vector `make` returned, and that vector has no further deps, so the
// #306 view test read it as owned and the delivery selector RENAMED it onto the return
// buffer. A `vector<Cell>` then WAS the `Cell`-shaped buffer the caller allocated:
// `make` cleared the caller's record as a vector, and the index that followed read
// absent. It is the promotion moros H12 hit through a field projection, reached here
// through an index — hence the guard is on the buffer's SHAPE, not on another tail
// walker (`ls_can_be_record_buffer`).
//
// The report named "tail position" as the axis; an explicit `return` fails identically
// (its own delivery arm carried the same rung), so both spellings are checked. What
// actually decides it is a NON-NULL record return: `-> Cell?` takes another delivery
// path and was always right.
//
// A `??` fallback is where a wrong answer is designed to look plausible, so every cell
// checks the VALUE. `q` is seeded `i + 7` so element 0 and element 1 are told apart,
// and the fallback is `-1` — a value no real element can take.

struct I877Cell { q: integer, r: integer }
struct I877Bag { b_cells: vector<I877Cell>, b_n: integer }

fn i877_make(n: integer) -> vector<I877Cell> {
  mk_out: vector<I877Cell> = [];
  for mk_i in 0..n { mk_out += [I877Cell { q: mk_i + 7, r: 0 }]; }
  mk_out
}
fn i877_bag(n: integer) -> I877Bag { I877Bag { b_cells: i877_make(n), b_n: n } }
fn i877_hash(n: integer) -> hash<I877Cell[q, r]> {
  mh: hash<I877Cell[q, r]> = [];
  for mh_i in 0..n { mh[mh_i + 7, 0] = I877Cell { q: mh_i + 7, r: 0 }; }
  mh
}

// The reported shape: the index of a call's result IS the tail expression.
fn i877_tail(n: integer) -> I877Cell { i877_make(n)[0] ?? I877Cell { q: -1, r: -1 } }
// The same expression under an explicit `return` — a different delivery arm.
fn i877_return(n: integer) -> I877Cell { return i877_make(n)[1] ?? I877Cell { q: -1, r: -1 }; }
// Inside an `if` arm that is itself the tail.
fn i877_if_arm(n: integer) -> I877Cell {
  if n > 0 { i877_make(n)[0] ?? I877Cell { q: -1, r: -1 } } else { I877Cell { q: -2, r: -2 } }
}
// The fallback is a local rather than a literal (it is not what selects the arm).
fn i877_bound_fallback(n: integer) -> I877Cell {
  fb = I877Cell { q: -1, r: -1 };
  i877_make(n)[0] ?? fb
}
// A keyed collection indexes through the same delivery.
fn i877_keyed(n: integer) -> I877Cell { i877_hash(n)[7, 0] ?? I877Cell { q: -1, r: -1 } }
// The container is a FIELD of the call's result, not the result itself.
fn i877_field_of_call(n: integer) -> I877Cell { i877_bag(n).b_cells[0] ?? I877Cell { q: -1, r: -1 } }

// Controls — these were correct before the fix and must stay correct.
//
// A PARAMETER is not a placement question: the return BORROWS it, so the rename must
// still happen and the caller's vector must survive the call intact.
fn i877_param(v: vector<I877Cell>) -> I877Cell { v[0] ?? I877Cell { q: -1, r: -1 } }
// Bound to a local first, then indexed in the tail.
fn i877_bound(n: integer) -> I877Cell {
  all = i877_make(n);
  all[0] ?? I877Cell { q: -1, r: -1 }
}
// A nullable return takes another delivery path entirely.
fn i877_nullable(n: integer) -> I877Cell? { i877_make(n)[0] ?? I877Cell { q: -1, r: -1 } }
// The mirror shape: a VECTOR return whose tail views into a record local.
fn i877_vec_of_record(n: integer) -> vector<I877Cell> {
  b = i877_bag(n);
  b.b_cells
}
// A scalar element never allocates a record buffer, so it never had the question.
fn i877_scalar(n: integer) -> integer { i877_make(n)[0].q ?? -1 }
// A nullable record returned through a local, whose value came from a call that
// answered null. The guard above decides between renaming a candidate onto the return
// buffer and COPYING it in; copy the wrong thing here and `null` becomes a freshly
// allocated empty record, so a function that says "there is none" answers one instead.
// That is what a first, wider spelling of the guard did to `-> Dialect?` in the sqldb
// fixture, and no `??`-shaped test could have seen it.
fn i877_pick(want: boolean) -> I877Cell? {
  if want { p = I877Cell { q: 7, r: 0 }; return p }
  return null;
}
fn i877_relay(want: boolean) -> I877Cell? {
  rl = i877_pick(want);
  return rl;
}

fn i877_is(c: I877Cell, q: integer, what: text) {
  assert(c.q == q, "{what}: q is {c.q}, expected {q}");
  assert(c.r == 0, "{what}: r is {c.r}, expected 0");
}

fn main() {
  i877_is(i877_tail(3), 7, "tail expression");
  i877_is(i877_return(3), 8, "explicit return");
  i877_is(i877_if_arm(3), 7, "if arm at the tail");
  i877_is(i877_bound_fallback(3), 7, "bound fallback");
  i877_is(i877_keyed(3), 7, "keyed collection");
  i877_is(i877_field_of_call(3), 7, "field of the call's result");

  i877_is(i877_bound(3), 7, "bound local");
  // Bound before the check on purpose: a coalesce written INLINE in an argument
  // leaks its temporary, which has nothing to do with this issue (it reproduces
  // unchanged on 2026.8.0) and would make this file report someone else's defect.
  nl = i877_nullable(3) ?? I877Cell { q: -9, r: -9 };
  i877_is(nl, 7, "nullable return");
  i877_is(i877_scalar_cell(3), 7, "scalar field");

  // The borrow control: the parameter's vector belongs to the CALLER and must read
  // back unchanged — a copy here would be as wrong as a dangling view.
  own = i877_make(3);
  i877_is(i877_param(own), 7, "vector parameter");
  assert(len(own) == 3, "the caller's vector lost elements: {len(own)}");
  i877_is(own[2] ?? I877Cell { q: -1, r: -1 }, 9, "the caller's last element");

  vr = i877_vec_of_record(3);
  assert(len(vr) == 3, "vector-of-record returned {len(vr)} elements");
  i877_is(vr[0] ?? I877Cell { q: -1, r: -1 }, 7, "vector-of-record first");

  // Past the first element and past one allocation, so a buffer that is really the
  // wrong store cannot pass by holding a plausible first record.
  big = i877_tail(300);
  i877_is(big, 7, "n=300 first");

  // A relayed absence stays absent, and a relayed value still arrives.
  none = i877_relay(false);
  assert(none == null, "a relayed null must stay null, not become an empty record");
  some = i877_relay(true);
  assert(some != null, "a relayed value must still arrive");
  i877_is(some ?? I877Cell { q: -9, r: -9 }, 7, "relayed value");

  println("done");
}

fn i877_scalar_cell(n: integer) -> I877Cell {
  I877Cell { q: i877_scalar(n), r: 0 }
}
