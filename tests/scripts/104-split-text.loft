//
// @PLAN37 phase 10.4 — text.split_text(text) overload.  Pre-fix
// only split(text, character) existed; multi-char separators
// like "](" or ", " required char-by-char loops in user code.

fn test_basic() {
  a = "a, b, c".split_text(", ");
  assert(a.len() == 3, "got {a.len()} parts, expected 3");
  assert(a[0] == "a", "[0]");
  assert(a[1] == "b", "[1]");
  assert(a[2] == "c", "[2]");
}

fn test_link_pattern() {
  // The pattern scan.loft cared about — finding `](` in
  // markdown links so the URL portion can be extracted.
  s = "see [text](url) here";
  parts = s.split_text("](");
  assert(parts.len() == 2, "two parts around ]( ");
  assert(parts[0] == "see [text", "left of ](");
  assert(parts[1] == "url) here", "right of ](");
}

fn test_no_match() {
  a = "no match here".split_text(",,");
  assert(a.len() == 1, "no-match returns whole input");
  assert(a[0] == "no match here", "no-match preserves content");
}

fn test_separator_at_start() {
  a = ",x".split_text(",");
  assert(a.len() == 2, ",x → 2 parts");
  assert(a[0] == "", "leading empty");
  assert(a[1] == "x", "after");
}

fn test_separator_at_end() {
  a = "x,".split_text(",");
  assert(a.len() == 2, "x, → 2 parts");
  assert(a[0] == "x", "before");
  assert(a[1] == "", "trailing empty");
}

fn test_consecutive_separators() {
  a = ",,".split_text(",");
  assert(a.len() == 3, ",, → 3 parts (all empty)");
  assert(a[0] == "", "[0]");
  assert(a[1] == "", "[1]");
  assert(a[2] == "", "[2]");
}

fn test_empty_input() {
  a = "".split_text(",");
  assert(a.len() == 0, "empty input → empty result");
}

fn test_empty_separator() {
  a = "abc".split_text("");
  assert(a.len() == 1, "empty separator → [self]");
  assert(a[0] == "abc", "empty separator preserves content");
}

fn test_separator_longer_than_input() {
  a = "ab".split_text("abc");
  assert(a.len() == 1, "no match (sep longer)");
  assert(a[0] == "ab", "preserves content");
}

fn test_multiline() {
  s = "first\nsecond\nthird";
  a = s.split_text("\n");
  assert(a.len() == 3, "newline split: 3 lines");
  assert(a[0] == "first", "line 0");
  assert(a[1] == "second", "line 1");
  assert(a[2] == "third", "line 2");
}

fn main() {
  test_basic();
  test_link_pattern();
  test_no_match();
  test_separator_at_start();
  test_separator_at_end();
  test_consecutive_separators();
  test_empty_input();
  test_empty_separator();
  test_separator_longer_than_input();
  test_multiline();
  println("split-text: ok");
}
