// @P338 regression: a vector index whose expression itself uses `&mut stores`
// — a checked division `v[n / 2]` (the div-by-zero guard calls raise_runtime) —
// must compile under --native (was E0499: two live `&mut stores` borrows, the
// vec-get receiver and the div guard).  The OpGetVector / OpVectorRef `#rust`
// templates bind BOTH the receiver and the index to locals before the call.
fn main() {
  v: vector<integer> = [];
  v += [10];
  v += [20];
  v += [30];
  n = 4;
  // division in index
  a = v[n / 2]; // v[2] = 30
  // modulo in index
  b = v[n % 3]; // v[1] = 20
  // nested: division over a vector-read value
  c = v[v[0] / 10]; // v[1] = 20
  assert(a == 30, "div index: {a}");
  assert(b == 20, "mod index: {b}");
  assert(c == 20, "nested div index: {c}");
  print("ok");
}
