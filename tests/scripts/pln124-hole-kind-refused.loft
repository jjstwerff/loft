//
// @EXPECT_ERROR: Q has no `fn hole_point(self: Q, v: Point)`
// @EXPECT_ERROR: a format spec has no meaning on a Q hole
//
// @PLN124 — a hole kind the target does not accept is REFUSED, naming the
// method to add.
//
// This is the rule the whole hook rests on, and it is the one that would be
// cheapest to soften: a quiet fall back to `hole_text` for an unhandled kind
// would render the value and put it back on the TEXT path — which is precisely
// the erasure this exists to close, and it would do it silently, on the one
// value the author never declared a home for.
//
// The second cell is its companion. A spec asks for a RENDERING, and a hole is
// handed over rather than rendered, so there is nothing for a spec to format; a
// silently ignored `:>8` would report a formatting that never happened.

struct Point { x: integer, y: integer }
struct Ident { nm: text }

struct Q { const parts: vector<text> }

fn lit(self: Q, s: text) { self.parts += [s]; }
fn hole_ident(self: Q, v: Ident) { self.parts += [v.nm]; }

fn main() {
  p = Point { x: 3, y: 4 };
  t = Ident { nm: "orders" };

  // Accepted: `Ident` asks for `hole_ident`, which Q defines.
  ok: Q = "FROM {t}";
  println("{len(ok.parts)}");

  // Refused: Q defines no `hole_point`, and the diagnostic names it.
  bad: Q = "at {p}";
  println("{len(bad.parts)}");

  // Refused: a spec on a value that is handed over, not rendered.
  spec: Q = "{t:>8}";
  println("{len(spec.parts)}");
}
