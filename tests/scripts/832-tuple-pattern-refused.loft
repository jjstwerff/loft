//
// A tuple pattern the parser cannot make sense of is REFUSED, not spun on.
//
// Both shapes below used to hang the parser outright (loft#832): the element loop left the
// cursor parked mid-pattern, and the arm loop re-parsed that same token forever — silently,
// because first-pass diagnostics are suppressed. loft is unbounded by default, so an editor
// invoking the compiler simply stopped responding.
//
// The guard asserts the REJECTION, not merely that the run terminates: a test that only
// bounded the time would pass for the wrong reason the moment the parser started accepting
// these patterns and silently matching the wrong thing.
//
// Every `..` position is listed because the hang was reachable from each of them, and pass 1
// walks the whole file (it suppresses diagnostics rather than stopping), so each function
// below still exercises the loop that used to spin even though pass 2 stops at the first
// error. `(.., last)` is the one that also proves the refusal is not classified as a
// wildcard arm — as a wildcard it would end the arm loop and report a missing `}` instead.

// @EXPECT_ERROR: a `..` rest pattern is not supported in a tuple pattern
fn rest_at_the_tail() -> text {
  t: (integer, integer, integer) = (1, 2, 3);
  match t { (first, ..) => "got {first}", _ => "no" }
}

// One `@EXPECT_ERROR` per occurrence, not per message: the harness consumes one declared
// pattern per diagnostic, so five identical refusals need five declarations.
//
// The arm bodies below do not read the names the refused pattern would have bound: the
// refusal makes them undefined, and an "Unknown variable" cascade would bury the message
// this file exists to pin.

// @EXPECT_ERROR: a `..` rest pattern is not supported in a tuple pattern
fn rest_at_the_head() -> text {
  t: (integer, integer, integer) = (1, 2, 3);
  match t { (.., last) => "head", _ => "no" }
}

// @EXPECT_ERROR: a `..` rest pattern is not supported in a tuple pattern
fn rest_in_the_middle() -> text {
  t: (integer, integer, integer) = (1, 2, 3);
  match t { (a, .., c) => "middle", _ => "no" }
}

// @EXPECT_ERROR: a `..` rest pattern is not supported in a tuple pattern
fn rest_alone() -> text {
  t: (integer, integer, integer) = (1, 2, 3);
  match t { (..) => "any", _ => "no" }
}

// @EXPECT_ERROR: a `..` rest pattern is not supported in a tuple pattern
fn rest_spelled_with_three_dots() -> text {
  t: (integer, integer, integer) = (1, 2, 3);
  match t { (a, ...) => "got {a}", _ => "no" }
}

// @EXPECT_ERROR: tuple pattern has more elements than the 3-element subject tuple
fn more_elements_than_the_subject_has() -> text {
  t: (integer, integer, integer) = (1, 2, 3);
  match t { (a, b, c, d) => "got {a}{b}{c}", _ => "no" }
}

fn main() {
  println(rest_at_the_tail());
}
