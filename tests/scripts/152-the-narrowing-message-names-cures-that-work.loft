//
// @PLN152 N1/N2 — the implicit-narrow message advertised a cure that is always refused.
//
// It said *"cast explicitly with `as u8`"*, and it fires exactly when the value does NOT
// provably fit — which is exactly when `as u8` is itself refused (*"narrowing cast … may not
// fit at runtime; use `u8?` for a checked cast"*).  So following the first message earned a
// second refusal, and the reader had to make two hops to reach a cure the first could have
// named.
//
// This file is the standing check that every cure the message names actually WORKS.  It is
// the point of the change: a diagnostic that prescribes something untrue is worse than one
// that prescribes nothing, because the reader spends the trip.
//
// ⚠ The `?? <value>` cure has TWO lowerings and both must work, which is what caught the first
// attempt at this fix.  A non-trivial subject binds to an `__ncc_N` temp; a bare VARIABLE
// subject is read twice and lowers to a plain `if` with no temp.  The first version handled
// only the temp shape, so `b ?? 255` on a bare variable stayed refused while `(b + 1) ?? 255`
// worked — the message would have been advertising a cure that failed on the simplest possible
// spelling of it.
//
// @falsified-at: none — every row here is a cure the message NAMES, so the file cannot fail on
//   a build that predates the message without also predating the cures.  It is a LOCK on the
//   message and the behaviour staying in step: what moves it is a future edit that adds a cure
//   to the text without making it work, which is the defect being fixed.

fn a_the_fallback_cure_works_in_both_lowerings() {
  b: integer = 400;
  bare: u8 = b ?? 255;
  assert(bare == 255, "a bare variable subject — the `if` lowering, no temp");
  expr: u8 = (b + 1) ?? 254;
  assert(expr == 254, "a computed subject — the `__ncc_N` temp lowering");
}

fn b_the_checked_cast_cure_works() {
  b: integer = 400;
  c: u8 = (b as u8?) ?? 253;
  assert(c == 253, "`as u8?` answers null out of range, and `??` takes it from there");
}

fn c_the_provably_fits_cure_works() {
  b: integer = 400;
  d: u8 = (b & 255) as u8;
  assert(d == 144, "a mask makes the value provably fit, so the plain cast is accepted");
}

fn d_a_defended_store_reports_nothing() {
  // (E-Report)'s guarded-site rule: the author said what happens, so there is no undefended
  // fault to announce — and the old wording would have claimed the slot "took its default"
  // when it took the author's value.  Pinned by there being no @EXPECT_WARNING here at all.
  a: u8 = 250;
  a = (a + 10) ?? 255;
  assert(a == 255, "the author's fallback, silently");
}

fn main() {
  a_the_fallback_cure_works_in_both_lowerings();
  b_the_checked_cast_cure_works();
  c_the_provably_fits_cure_works();
  d_a_defended_store_reports_nothing();
  print("152 N1/N2 ok\n");
}
