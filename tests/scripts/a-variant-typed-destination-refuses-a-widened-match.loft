//
// A slot declared as ONE variant refuses a `match` whose arms joined to the enum.
//
// The soundness half of `a-variant-arm-joins-with-its-enum.loft`.  `(C-Var)` converts an enum
// to nothing narrower, so once the arms have widened, a variant-typed destination is exactly
// the declaration that must fail.  The `match` join used to keep the FIRST arm's variant
// whatever the later arms answered, so this program was ACCEPTED and `v.r` read a `Square`'s
// bytes at `Circle`'s offsets with nothing said — loft#980's class, which the `if` twin
// (`v: Circle = if c { Square{…} } else { Circle{…} }`) has refused throughout.
//
// @EXPECT_ERROR: cannot change type from Circle to Sh
//
// @falsified-at: 32e36462 — the program compiled and printed `v.r=7`, a `Square`'s `s` read
//   through `Circle`'s `r`.

enum Sh { Circle { r: integer }, Square { s: integer, extra: text } }

fn main() {
  e: Sh = Square{s: 7, extra: "hello"};
  v: Circle = match e { Circle{r} => Circle{r: r + 1}, Square{s} => Square{s: s, extra: "x"} };
  println("v.r={v.r}");
}
