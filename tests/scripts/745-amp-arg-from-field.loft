//
// Regression (loft#745) — a struct FIELD passed to a `&`-parameter, in a call
// that ALSO carries an inline object literal.
//
// The parser lowers a non-`Var` `&`-argument to a work-ref plus
// `OpCreateStack(__ref_N)`: the callee gets a REFERENCE to that work-ref's
// stack slot and writes through it for the whole call.  Two things did not
// carry that fact, and each produced its own fault:
//
//   * Live-interval analysis ended the work-ref at its `OpCreateStack` — its
//     last textual read — instead of at the call.  The slot allocator then gave
//     the same slot to a temporary built by a LATER argument (the object
//     literal's element record), so the callee wrote through a reference to
//     that temporary: the caller's struct was never updated and reads through
//     the parameter returned whatever the element record held.  SILENT, and on
//     BOTH backends' shared slot layout.
//
//   * `scan_args` hoists that work-ref write out of the argument so its slot
//     lives at function scope, but matched only a BARE `Set`.  A work-ref that
//     already holds a value carries an overwrite-`OpFreeRef`, so the write
//     arrives wrapped in an `Insert` and stayed inside the argument — native
//     then had no `OpCreateStack(Var(_))` to recognise, hoisted the whole
//     argument into a `let _pre_N = …` binding whose value is the assignment's
//     `()`, and rustc rejected the call (E0308, expected `&mut DbRef`).
//
// The axes below vary ONE thing each and every expected value is hand-computed.
// Binding the field to a local first (`lw = lr.wl_world`) always worked, so it
// is carried as the control: a cell that agrees with it is the real answer.

struct Hex { h_height: integer, h_material: integer }
struct World { w_seed: integer, w_hexes: vector<Hex> }
struct WorldLoad { wl_code: integer, wl_world: World }
struct Column { co_q: integer, co_cells: vector<Hex> }
struct ColumnWrite { cw_code: integer, cw_layer: integer }

fn load() -> WorldLoad {
  return WorldLoad { wl_code: 0, wl_world: World { w_seed: 42, w_hexes: [] } };
}

// Mutates fields through the `&`-parameter and READS back through it — the read
// is what exposed the aliased slot, since a write alone can go unnoticed.
fn set_col(w: &World, col: Column) -> ColumnWrite {
  w.w_seed = col.co_q;
  for c in col.co_cells { w.w_hexes += [Hex { h_height: c.h_height, h_material: c.h_material }]; }
  return ColumnWrite { cw_code: 0, cw_layer: len(w.w_hexes) };
}

fn set_col_int(w: &World, col: Column) -> integer {
  w.w_seed = col.co_q;
  for c in col.co_cells { w.w_hexes += [Hex { h_height: c.h_height, h_material: c.h_material }]; }
  return len(w.w_hexes);
}

// A `&`-parameter FORWARDED to another one — hex_world's shape, where the
// report came from.
fn set_col_fwd(w: &World, col: Column) -> ColumnWrite {
  set_col(w, col)
}

// --- control: the local-bind form, which was correct throughout ---
fn check_local_bind() {
  lr = load();
  lw = lr.wl_world;
  cw = set_col(lw, Column { co_q: 3, co_cells: [ Hex { h_height: 40, h_material: 1 } ] });
  assert(cw.cw_layer == 1, "control: layer {cw.cw_layer}, want 1");
  assert(lw.w_seed == 3, "control: seed {lw.w_seed}, want 3");
}

// --- the reported shape: field arg + inline object literal, struct return ---
fn check_field_arg() {
  lr = load();
  cw = set_col(lr.wl_world, Column { co_q: 3, co_cells: [ Hex { h_height: 40, h_material: 1 } ] });
  assert(cw.cw_layer == 1, "field arg: layer {cw.cw_layer}, want 1");
  assert(lr.wl_world.w_seed == 3, "field arg: seed {lr.wl_world.w_seed}, want 3");
  assert(len(lr.wl_world.w_hexes) == 1, "field arg: hexes {len(lr.wl_world.w_hexes)}, want 1");
}

// --- a SCALAR return drops the hidden work-ref argument: native compiled this
//     one, so it isolates the slot-aliasing half on its own ---
fn check_scalar_return() {
  lr = load();
  n = set_col_int(lr.wl_world, Column { co_q: 7, co_cells: [ Hex { h_height: 40, h_material: 1 } ] });
  assert(n == 1, "scalar return: n {n}, want 1");
  assert(lr.wl_world.w_seed == 7, "scalar return: seed {lr.wl_world.w_seed}, want 7");
}

// --- element count drives how large the colliding temporary is; 0 elements
//     builds no element record at all and was the one passing cell ---
fn check_element_counts() {
  a = load();
  ca = set_col(a.wl_world, Column { co_q: 1, co_cells: [] });
  assert(ca.cw_layer == 0, "0 cells: layer {ca.cw_layer}, want 0");
  assert(a.wl_world.w_seed == 1, "0 cells: seed {a.wl_world.w_seed}, want 1");

  b = load();
  cb = set_col(b.wl_world, Column { co_q: 2,
    co_cells: [ Hex { h_height: 40, h_material: 1 }, Hex { h_height: 7, h_material: 2 } ] });
  assert(cb.cw_layer == 2, "2 cells: layer {cb.cw_layer}, want 2");
  assert(b.wl_world.w_seed == 2, "2 cells: seed {b.wl_world.w_seed}, want 2");
  assert(len(b.wl_world.w_hexes) == 2, "2 cells: hexes {len(b.wl_world.w_hexes)}, want 2");
}

// --- forwarding the `&`-parameter onward, and the CONTENTS written through it ---
fn check_forwarded() {
  lr = load();
  cw = set_col_fwd(lr.wl_world, Column { co_q: 9,
    co_cells: [ Hex { h_height: 40, h_material: 1 }, Hex { h_height: 7, h_material: 2 } ] });
  assert(cw.cw_layer == 2, "forwarded: layer {cw.cw_layer}, want 2");
  assert(lr.wl_world.w_seed == 9, "forwarded: seed {lr.wl_world.w_seed}, want 9");
  h0 = lr.wl_world.w_hexes[0] ?? Hex { h_height: 0, h_material: 0 };
  h1 = lr.wl_world.w_hexes[1] ?? Hex { h_height: 0, h_material: 0 };
  assert(h0.h_height == 40 && h0.h_material == 1, "forwarded: hex0 {h0.h_height}/{h0.h_material}");
  assert(h1.h_height == 7 && h1.h_material == 2, "forwarded: hex1 {h1.h_height}/{h1.h_material}");
}

// --- the same call in a LOOP: the work-ref is re-assigned each iteration, which
//     is what puts the overwrite-`OpFreeRef` in front of the write ---
fn check_in_a_loop() {
  total = 0;
  for i in 1..4 {
    lr = load();
    cw = set_col(lr.wl_world, Column { co_q: i, co_cells: [ Hex { h_height: i, h_material: 1 } ] });
    assert(cw.cw_layer == 1, "loop {i}: layer {cw.cw_layer}, want 1");
    assert(lr.wl_world.w_seed == i, "loop {i}: seed {lr.wl_world.w_seed}, want {i}");
    total += lr.wl_world.w_seed;
  }
  assert(total == 6, "loop total {total}, want 6");
}

fn main() {
  check_local_bind();
  check_field_arg();
  check_scalar_return();
  check_element_counts();
  check_forwarded();
  check_in_a_loop();
  println("745 ok");
}
