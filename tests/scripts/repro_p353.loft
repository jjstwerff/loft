// @P353 regression: an EMPTY `vector<fn(...)>` literal must COMPILE under
// `--native`.  The synthetic wrapper struct `main_vector<fn(integer) -> integer>`
// is registered before its synthetic narrow-int element type (`int<0,false>`),
// so the element's runtime type id is HIGHER than the wrapper struct's — the
// single-pass type-init emitter referenced `t{N}` for the element before its
// `db.int(...)` creation, producing `error[E0425]: cannot find value t{N}`.
// Fix: `emit_field` flushes the bare content type (`flush_bare_through`) before
// emitting `db.vector(content)`.  Interning makes the later redundant flush a
// no-op.  The interpreter was always correct (len=0); this guards the native
// codegen path.

fn dbl(x: integer) -> integer {
  return x * 2;
}

fn empty_fn_vec_len() -> integer {
  fs: vector<fn(integer) -> integer> = [];
  return len(fs);
}

fn seeded_fn_vec_len() -> integer {
  // a non-empty fn-ref vector literal must still work (the common case)
  fs: vector<fn(integer) -> integer> = [dbl];
  return len(fs);
}

fn main() {
  e = empty_fn_vec_len();
  s = seeded_fn_vec_len();
  print("empty={e} seeded={s}\n");
  assert(e == 0, "empty fn-ref vector literal must have len 0");
  assert(s == 1, "seeded fn-ref vector literal must have len 1");
}
