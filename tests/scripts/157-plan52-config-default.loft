// Probe 24 — Cluster V real-library extraction: config-key-with-default
//
// Scan of `lib/*/src/*.loft` (2026-05-29) finds NO text-coalesce
// patterns in production library code today — `lib/audience_crystal`,
// `lib/gridmesh`, and similar use only integer-typed `??` (`vec[i] ?? 0`)
// which is value-typed and unaffected by cluster I.  So the user-visible
// exposure of cluster I in shipped lib code is currently NIL.
//
// However, the shape is a COMMON pattern for config / argument /
// environment-variable lookup, which library code will need as soon as
// HTTP middleware, CLI flag parsing, or config-file consumers land.
// This probe extracts a representative "config key with default" shape
// from a hypothetical config library — exactly what `lib/server`'s
// future HTTP-header / query-param lookup methods will likely use.
//
// loft uses struct-keyed hashes (`hash<Pair[name]>`), so the realistic
// shape is to look up the struct, project the value field, then
// fall-back via `??`.
//
// Pairing: diff against 02 (vec-index) and 17 (hash-keyed deep chain).
// Status: cluster V real-library shape; latent exposure documentation.

struct Pair {
  name: text,
  value: text,
}
struct Config {
  entries: hash<Pair[name]>,
}

fn lookup(c: Config, k: text) -> text {
  // Look up the entry, project its value field, fall back to "FINAL".
  // The hash[k].value is the non-trivial LHS that builds the ncc-block.
  return c.entries[k].value ?? "FINAL";
}

fn main() {
  c = Config { entries: [] };
  c.entries["theme"] = Pair { name: "theme", value: "dark" };
  c.entries["lang"] = Pair { name: "lang", value: "en" };

  a = lookup(c, "theme");
  assert(a == "dark", "probe 24a: theme = '{a}', want 'dark'");

  b = lookup(c, "lang");
  assert(b == "en", "probe 24b: lang = '{b}', want 'en'");

  // Note: looking up a missing key in a hash returns null/sentinel; the
  // `?? "FINAL"` should catch it via the ncc path.  This is the shape
  // where the bug bites a hypothetical config library.
  d = lookup(c, "missing");
  assert(d == "FINAL", "probe 24c: missing = '{d}', want 'FINAL'");

  println("probe 24 PASSED");
}
