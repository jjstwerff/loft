// A generator stays LAZY when it writes a TEXT field of a heap parameter.
//
// `formal/coroutines.md` (G-Next) says one advance runs until the NEXT yield, so a
// generator's side effects interleave with its consumer's.  `--native` compiles a
// generator to a state machine only for loop shapes `detect_lazy_for` recognises, and
// everything it rejects falls back to an eager buffer that runs the whole body up front.
// That fallback is not semantics-preserving — it changes WHEN the side effects happen —
// so a shape landing there wrongly is a (G-Next) deviation, not a missed optimisation.
//
// This shape was landing there, and the author could not have known why: it has ONE
// yield, and the yield IS the last statement written.  In the IR it is not, because a
// text field write lifts the field into a temp whose free is placed at block exit:
//
//     _field_1 = OpGetText(t, 0);  OpAppendText(_field_1, "x");
//     OpSetText(t, 0, _field_1);   yield i;   OpFreeText(_field_1);   <-- after the yield
//
// The same generator with an INTEGER field was lazy, because `OpSetInt` leaves nothing
// trailing.  `hoist_trailing_frees` moves a dead temp's free above the suspend — sound
// exactly when the yield does not read what is freed, and strictly better for a generator
// the consumer abandons, which used to strand the last iteration's temp.
//
// This is the SECOND time a compiler-generated cleanup op has silently demoted a
// generator to eager; `detect_yield_from`'s own comment records the first.
//
// Every trace here is recorded through a heap-struct parameter — a heap parameter shares
// its record (calls.md F-ParamHeap) and a record is not a frame, so a generator can write
// it across a yield.  The VALUES are identical either way, which is the whole reason this
// needs an interleaving assertion rather than a sum.

struct GltfWords { w: text }
struct GltfCount { n: integer }

fn gltf_text_field(t: GltfWords) -> iterator<integer> {
  for i in 0..5 { t.w += "q{i} "; yield i; }
}

fn gltf_int_field(t: GltfCount) -> iterator<integer> {
  for i in 0..5 { t.n = t.n * 10 + i; yield i; }
}

fn gltf_yield_reads_the_field(t: GltfWords) -> iterator<text> {
  // The cell the hoist must REFUSE: the suspended value names the store being released,
  // so its free may not move above the yield.  Whether this ends up lazy or eager is not
  // the claim — the claim is that it answers correctly and identically on both backends.
  for i in 0..3 { t.w += "x"; yield t.w; }
}

fn test_a_text_field_write_keeps_the_generator_lazy() {
  t = GltfWords { w: "" };
  for x in gltf_text_field(t) { t.w += "c{x} "; if x >= 1 { break; } }
  // Eager gives `q0 q1 q2 q3 q4 c0 c1 ` — the producer's whole loop before the consumer
  // sees anything, and five iterations where the consumer asked for two.
  assert(t.w == "q0 c0 q1 c1 ", "one slice per advance, and the break stops the producer; got `{t.w}`");
}

fn test_an_integer_field_write_is_unchanged() {
  // The control: this shape was always lazy, pinned so the hoist cannot disturb it.
  t = GltfCount { n: 1 };
  for x in gltf_int_field(t) { t.n = t.n * 10 + 9; if x >= 1 { break; } }
  assert(t.n == 10919, "1,0,9,1,9 — produce, consume, produce, consume; got {t.n}");
}

fn test_a_yield_that_reads_the_field_still_answers_correctly() {
  t = GltfWords { w: "" };
  o = "";
  for v in gltf_yield_reads_the_field(t) { o += "[{v}]"; if len(v) >= 2 { break; } }
  assert(o == "[x][xx]", "the field grows by one per yield and is read back intact; got `{o}`");
}

fn test_the_generator_runs_to_completion_when_nobody_breaks() {
  // Laziness must not become truncation: with no `break` every iteration still runs.
  t = GltfWords { w: "" };
  for x in gltf_text_field(t) { t.w += "c{x} "; }
  assert(t.w == "q0 c0 q1 c1 q2 c2 q3 c3 q4 c4 ", "all five interleaved; got `{t.w}`");
}
