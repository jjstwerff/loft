//
// A branch arm that projects a COLLECTION gets the copy its record twin already gets, so the
// binding keeps the value its container held when that container is reassigned (loft#1399).
//
//     b = if d.covered > 0 { d.tiles.proto } else { [] };
//     d = derive(5);                                   // b still reads 10, not 50
//
// loft#1396 gave a projecting arm its own temp — `Scopes::arm_bind` binds `h.inner` into an
// owned `__lift_N` once the view walk has named the binding — and matched `Reference` and
// struct-`Enum`, answering `None` for a `Vector`.  So a collection arm got no temp, and the
// deps-strip route that would otherwise reach it is (correctly) not taken for a branch-valued
// binding, which leaves nothing to copy: `--interpret` read the NEW container while `--native`
// answered correctly by its own route, off empty deps.  `(O-NoDiverge)` forbids the split and
// `(B-View-Base)` settles the value — *a projection is a VIEW at every element type, not only
// a struct-typed one* — so the arm is copied, by the same buffer-and-refill
// (`ArmBind::CopyVector`, `OpReplaceVector` into a `__lift_N`) a whole-vector copy already
// uses.
//
// ⚠ The BOUNDARY between this and its record twin is the interesting part, and cells 7 and 8
// are it.  For a RECORD tail an undisturbed projection ALIASES — a write through the binding
// reaches the container — and that must not change.  For a COLLECTION tail it does NOT:
// `(B-Copy)` makes a whole-value vector bind a copy, so a write through it reaching nothing is
// the documented answer, in the branch spelling exactly as in the plain one.  An "undisturbed
// arms must still alias" control is therefore right for a record and INVERTED for a
// collection, and reading it the record way is how this fix would be mistaken for an
// over-wide one.  Both spellings of both kinds are pinned below.
//
// @falsified-at: c22c318f — interpret exit 1 -> 0, one assertion failure -> 0
//   (`test_a_branch_arm_projecting_a_collection`, reading 50 where 10 is right).  NATIVE reads
//   INERT there, and that is the correct verdict rather than a gap in the guard: native
//   already answered 10 by its own route, so only one side of a backend divergence can move.
//   Every other cell is unmoved at that commit, including the two alias controls — the
//   unbranched two-level cell is loft#1377 + loft#1391's and was already right, and is here as
//   the thing this must not disturb.

struct Tiles { proto: vector<integer>, n: integer }
struct Dv { tiles: Tiles, covered: integer }
struct Pay { a: integer }
struct Hold { inner: Pay, t: text }

fn derive(n: integer) -> Dv { Dv{tiles: Tiles{proto: [n * 10, n * 20], n: n}, covered: n} }

// THE DEFECT — a collection projection as a branch arm, live across its container's rebind.
fn test_a_branch_arm_projecting_a_collection() {
  d = derive(1);
  b = if d.covered > 0 { d.tiles.proto } else { [] };
  d = derive(5);
  assert((b[0] ?? -1) == 10, "branch arm: got {b[0] ?? -1}, want the 10 the container held");
}

fn test_the_same_in_a_loop() {
  seen = "";
  p: vector<integer> = [];
  for k in 1..4 {
    dv = derive(k);
    seen += "{p[0] ?? -1},";
    p = if dv.covered > 0 { dv.tiles.proto } else { [] };
  }
  assert(seen == "-1,10,20,", "loop: got {seen}, want -1,10,20,");
}

// CONTROL — the UNBRANCHED two-level projection, which loft#1377 and loft#1391 already fixed.
// This must not move.
fn test_the_unbranched_two_level_projection() {
  d = derive(1);
  l = d.tiles.proto;
  d = derive(5);
  assert((l[0] ?? -1) == 10, "unbranched: got {l[0] ?? -1}, want 10");
}

// CONTROL — one level off an owned local was always right.
fn test_one_level_off_an_owned_local() {
  t = derive(1).tiles;
  p = t.proto;
  assert((p[0] ?? -1) == 10, "one level: got {p[0] ?? -1}, want 10");
}

// CONTROL — a SCALAR tail holds no store and needs no copy.
fn test_a_scalar_tail() {
  d = derive(1);
  n = d.tiles.n;
  d = derive(5);
  assert(n == 1, "scalar tail: got {n}, want 1");
}

// CONTROL — a STRUCT tail takes the record arm, which is unchanged.
fn test_a_struct_tail() {
  h = Hold{inner: Pay{a: 1}, t: "h"};
  e = if h.inner.a > 0 { h.inner } else { Pay{a: 0} };
  h = Hold{inner: Pay{a: 5}, t: "k"};
  assert(e.a == 1, "struct tail: got {e.a}, want 1");
}

// CONTROL — an UNDISTURBED record arm still ALIASES: the write reaches the container, and a
// copy here would be the over-wide version of this fix.
fn test_an_undisturbed_record_arm_still_aliases() {
  h = Hold{inner: Pay{a: 1}, t: "h"};
  r = if h.inner.a > 0 { h.inner } else { Pay{a: 0} };
  r.a = 99;
  assert(h.inner.a == 99, "record arm alias: got {h.inner.a}, want 99");
}

// CONTROL — an undisturbed COLLECTION arm does NOT alias, and that is `(B-Copy)` rather than a
// gap: a whole-value vector bind copies, in the branch spelling as in the plain one below.
fn test_an_undisturbed_collection_arm_copies() {
  t = Tiles{proto: [1, 2], n: 1};
  a = if t.n > 0 { t.proto } else { [] };
  a += [99];
  assert(len(t.proto) == 2, "collection arm copy: got {len(t.proto)}, want 2");
}

fn test_the_plain_collection_bind_copies_too() {
  t = Tiles{proto: [1, 2], n: 1};
  a = t.proto;
  a += [99];
  assert(len(t.proto) == 2, "plain collection copy: got {len(t.proto)}, want 2");
}

fn main() {
  test_a_branch_arm_projecting_a_collection();
  test_the_same_in_a_loop();
  test_the_unbranched_two_level_projection();
  test_one_level_off_an_owned_local();
  test_a_scalar_tail();
  test_a_struct_tail();
  test_an_undisturbed_record_arm_still_aliases();
  test_an_undisturbed_collection_arm_copies();
  test_the_plain_collection_bind_copies_too();
}
