// The user-visible `integer` = i64 contract (formal/types.md D2, closed by
// reconciliation; DESIGN_DECISIONS.md C83 — internal storage stays the compact
// Int/Long encoding, never widened for convenience).  A value above i32 range
// must survive EVERY observable round-trip, identically on interp and --native.
// This locks the contract so a future representation change can't silently clip it.

struct Box {
  v: integer,
}
fn ident(x: integer) -> integer {
  return x;
}

fn test_438_i64_arithmetic() {
  assert(3000000000 * 3 == 9000000000, "mul over i32 range");
  assert(9000000000 / 3 == 3000000000, "div i64");
  assert(9000000001 % 9000000000 == 1, "mod i64");
  assert(9000000000 - 1 == 8999999999, "sub i64");
  assert(9000000000 > 2147483647, "compare past i32::MAX");
  neg: integer = -9000000000;
  assert(neg == -9000000000, "negative i64");
}

fn test_438_i64_storage_roundtrip() {
  big: integer = 9000000000;
  b: Box = Box { v: big };
  assert(b.v == 9000000000, "struct field holds i64");
  b.v = big + 1;
  assert(b.v == 9000000001, "struct field mutate i64");
  vec: vector<integer> = []; vec += [big];
  assert((vec[0] ?? 0) == 9000000000, "vector element holds i64");
  assert(ident(big) == 9000000000, "fn arg + return preserve i64");
  assert((9000000000, 7).0 == 9000000000, "tuple element holds i64");
}
