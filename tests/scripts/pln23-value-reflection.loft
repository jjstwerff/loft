//
// @PLN23 S5 — `field_value(x, position)`: the VALUE half of reflection.
//
// `type_of` says a record has a `text` at byte 16; this reads it. The pair is
// what an ORM's write half needs, and what the @PLN127 consumer gate ended by
// naming as the missing piece.
//
// Two claims are asserted here, and they pull in opposite directions:
//
//   1. **null is not the empty string, and not zero, and not false.** Every
//      spelling of "nothing" a field can hold is a DIFFERENT answer from the
//      ordinary value that looks like it, because an ORM that confused them
//      writes the wrong row and no later reader can tell.
//   2. **A position is checked against the type's own descriptor, never
//      trusted.** No argument reads bytes the layout did not name.
//
// The cells for 2 are what keep this from passing vacuously: they are the ones
// that must NOT answer, and a reading that ignored the descriptor would give
// them a plausible number instead.

struct Every {
  id: integer,     // 4242
  nm: text,        // "ada"
  score: float,    // 0.125
  flag: boolean,   // true
  note: text?,     // null   — must not read as ""
  empty: text,     // ""     — must not read as null
  zero: integer,   // 0      — must not read as null
  off: boolean,    // false  — must not read as null
  ch: character,   // 'q'
  small: i32,      // -7     — narrow: 4 bytes, and i32::MIN is ITS null
  gone: integer?,  // null   — must not read as 0
}

struct Inner { a: integer }
struct Outer { one: integer, nest: Inner }

/// One field rendered the way a walk over a whole record would render it.
///
/// `-` covers the two answers that are not a value: `OtherKind` (no field
/// begins there) and a kind with no scalar reading (a nested record, a vector,
/// a keyed collection, a stored reference).
fn cell(v: ValueInfo) -> text {
  if v.is_null { return "null" }
  if v.kind == TextKind { return "[{v.t}]" }
  if v.kind == FloatKind || v.kind == SingleKind { return "{v.f}" }
  if v.kind == IntegerKind || v.kind == LongKind
    || v.kind == BooleanKind || v.kind == CharacterKind { return "{v.i}" }
  return "-";
}

/// The value of the field CALLED `name`, found through the type's own field
/// list — which is how a consumer joins the two halves.
fn by_name(t: TypeInfo, e: Every, name: text) -> text {
  for f in t.fields {
    if f.name == name {
      // Bound to a local rather than `return cell(field_value(…))`: inside a
      // loop, `--native` fails to COMPILE a text-returning call whose argument
      // is a freshly returned record (loft#TBD). The interpreter is correct;
      // the local is the workaround, and it changes nothing here.
      v = field_value(e, f.position);
      return cell(v);
    }
  }
  return "?no-such-field";
}

fn main() {
  e = Every { id: 4242, nm: "ada", score: 0.125, flag: true, note: null,
              empty: "", zero: 0, off: false, ch: 'q', small: -7, gone: null };
  t = type_of(e);

  // --- claim 1: every spelling of "nothing" stays distinct -------------------
  assert(by_name(t, e, "id") == "4242", "id: {by_name(t, e, "id")}");
  assert(by_name(t, e, "nm") == "[ada]", "nm: {by_name(t, e, "nm")}");
  assert(by_name(t, e, "score") == "0.125", "score: {by_name(t, e, "score")}");
  assert(by_name(t, e, "flag") == "1", "flag: {by_name(t, e, "flag")}");
  assert(by_name(t, e, "ch") == "113", "ch: {by_name(t, e, "ch")}");

  // The four pairs that carry the claim. Each line is one value and its
  // look-alike, and they must differ.
  assert(by_name(t, e, "note") == "null", "null text: {by_name(t, e, "note")}");
  assert(by_name(t, e, "empty") == "[]", "empty text: {by_name(t, e, "empty")}");
  assert(by_name(t, e, "gone") == "null", "null integer: {by_name(t, e, "gone")}");
  assert(by_name(t, e, "zero") == "0", "zero: {by_name(t, e, "zero")}");
  assert(by_name(t, e, "off") == "0", "false: {by_name(t, e, "off")}");

  // A narrow field is read at ITS width. Reading it as 8 bytes would take the
  // neighbouring field's bytes with it, and `-7` is negative on purpose so a
  // sign-extension error cannot look like a pass.
  assert(by_name(t, e, "small") == "-7", "narrow i32: {by_name(t, e, "small")}");

  // --- claim 2: the position is checked, so these must NOT answer ------------
  // `id` is an 8-byte integer at 0, so byte 4 is its INTERIOR: a reading that
  // trusted the number would hand back half an integer.
  assert(cell(field_value(e, 4)) == "-", "interior offset answered");
  assert(cell(field_value(e, 9999)) == "-", "offset past the record answered");
  assert(cell(field_value(e, -1)) == "-", "negative offset answered");

  // A field with no scalar reading says so rather than inventing one.
  o = Outer { one: 11, nest: Inner { a: 22 } };
  ot = type_of(o);
  nested = "";
  for f in ot.fields { nested += "{f.name}={cell(field_value(o, f.position))} " }
  assert(nested == "one=11 nest=- ", "nested: {nested}");

  // --- the walk an ORM actually performs -------------------------------------
  // Names no field and no position of its own: the type supplies both. This is
  // the shape @PLN23 S5 writes a row from.
  row = "";
  for f in t.fields {
    if row != "" { row += "," }
    row += cell(field_value(e, f.position));
  }
  assert(row == "4242,[ada],0.125,1,null,[],0,0,113,-7,null", "row: {row}");

  println("value reflection ok");
}
