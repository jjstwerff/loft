//
// P246 follow-up — UPPER_CASE locals without `const` should warn.
// This script PASSES (just executes) but the parser emits a warning
// for the FOO line.  The actual diagnostic-shape test lives in the
// rust harness; here we just verify the program still runs (warning
// ≠ error) and that the silent forms don't trip false positives.

fn main() {
  // Silent — has the const keyword.
  const SIZE = 5;
  // Silent — leading underscore (synthetic / explicit-throwaway names).
  _SCRATCH = "x";
  // Silent — lower_case (the conventional form).
  total = SIZE * 2;
  assert(total == 10, "no-runtime-impact from the warning");
}
