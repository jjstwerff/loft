//
// @PLAN37 phase 10.5 — text.starts_with_at(pos, prefix).
// Sugar over `self[pos..pos+prefix.len()] == prefix` for the
// common "is this token at this offset?" pattern in scanners.
// Replaces the per-char dispatch in scan.loft's @PLAN matcher.

fn test_match_at_origin() {
  s = "hello world";
  assert(s.starts_with_at(0, "hello"), "match at 0");
  assert(!s.starts_with_at(0, "world"), "no match at 0");
}

fn test_match_at_offset() {
  s = "hello world";
  assert(s.starts_with_at(6, "world"), "match at 6");
  assert(!s.starts_with_at(6, "hello"), "no match at 6");
}

fn test_at_offset_partial() {
  s = "abcdef";
  assert(s.starts_with_at(2, "cde"), "abc[def] / cde at 2");
  assert(s.starts_with_at(2, "c"), "single-char prefix at 2");
}

fn test_prefix_too_long() {
  s = "hi";
  assert(!s.starts_with_at(0, "hi!"), "prefix longer than self");
  assert(!s.starts_with_at(1, "i!"), "prefix longer than tail");
}

fn test_pos_out_of_range() {
  s = "abc";
  assert(!s.starts_with_at(10, "x"), "pos beyond end");
  assert(!s.starts_with_at(100, ""), "pos far beyond end (even empty prefix)");
}

fn test_negative_pos() {
  s = "abc";
  assert(!s.starts_with_at(-1, "a"), "negative pos returns false");
  assert(!s.starts_with_at(-100, ""), "very negative pos returns false");
}

fn test_empty_prefix() {
  s = "abc";
  assert(s.starts_with_at(0, ""), "empty prefix at 0");
  assert(s.starts_with_at(2, ""), "empty prefix mid-text");
  assert(s.starts_with_at(3, ""), "empty prefix at end");
}

fn test_plan_pattern() {
  // The exact pattern scan.loft uses for @PLAN matching:
  // is "@PLAN" present at position i?
  line = "see @PLAN37 here";
  assert(line.starts_with_at(4, "@PLAN"), "@PLAN at 4");
  assert(!line.starts_with_at(0, "@PLAN"), "no @PLAN at 0");
  assert(!line.starts_with_at(3, "@PLAN"), "no @PLAN at 3 (off by one)");
}

fn test_unicode_byte_position() {
  // starts_with_at uses byte positions (matches text.len()
  // semantics); a 3-byte BMP codepoint at the start shifts
  // every subsequent prefix by 3.
  s = "→ arrow";
  assert(s.starts_with_at(3, " arrow"), "after BMP arrow (3 bytes)");
}

fn main() {
  test_match_at_origin();
  test_match_at_offset();
  test_at_offset_partial();
  test_prefix_too_long();
  test_pos_out_of_range();
  test_negative_pos();
  test_empty_prefix();
  test_plan_pattern();
  test_unicode_byte_position();
  println("starts-with-at: ok");
}
