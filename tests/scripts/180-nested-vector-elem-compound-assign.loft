//
// Regression (GitHub #246 / @P397): `vv[i] += [...]` — a compound-assign that
// appends to a VECTOR ELEMENT — used to panic at parse time ("Unknown
// definition", data.rs:3036). The LHS is `is_field` (an indexed access) but its
// parent is a vector, not a struct, so it routed through the struct-only
// new_record_field_op. The fix detects the vector parent (its type_def_nr is
// u32::MAX) and appends directly to the inner vector read, with fld = u16::MAX,
// like the plain-local path.
//
// NOTE: 3+ deep element-of-element compound-assign (`vvv[0][0] += [...]`) is the
// SEPARATE #250 type-id-divergence bug and is deliberately not exercised here.

struct Holder {
  vv: vector<vector<integer>>,
  tag: integer,
}

fn main() {
  // basic
  a: vector<vector<integer>> = [[1], [2], [3]];
  a[0] += [9];
  assert(len(a[0]) == 2 && a[0][0] == 1 && a[0][1] == 9, "basic: {a[0]}");

  // multi-element append, different index, repeated append to same element
  b: vector<vector<integer>> = [[1], [2], [3]];
  b[0] += [9, 8];
  b[2] += [7];
  b[0] += [5];
  assert(len(b[0]) == 4 && b[0][3] == 5, "multi: {b[0]}");
  assert(len(b[2]) == 2 && b[2][1] == 7, "idx2: {b[2]}");
  assert(len(b[1]) == 1, "untouched: {b[1]}");

  // (NOTE: `c[0] += vector_var` — appending a vector VARIABLE to an element —
  // is a separate native-only OpAppendVector double-borrow bug, tracked apart
  // from #246; interpret handles it. Not exercised here.)

  // text elements
  t: vector<vector<text>> = [["a"]];
  t[0] += ["b"];
  assert(len(t[0]) == 2 && t[0][1] == "b", "text: {t[0]}");

  // empty append is a no-op
  e: vector<vector<integer>> = [[1, 2]];
  e[0] += [];
  assert(len(e[0]) == 2, "empty: {e[0]}");

  // vector element reached THROUGH a struct field
  h = Holder { vv: [[1], [2]], tag: 0 };
  h.vv[0] += [9];
  assert(len(h.vv[0]) == 2 && h.vv[0][1] == 9, "struct-field: {h.vv[0]}");

  println("nested-vector-elem-compound-assign ok");
}
