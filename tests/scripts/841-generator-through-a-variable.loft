//
// A generator iterated through a VARIABLE, not only where it is created.
//
// `for x in steps()` took the coroutine path because the loop header was syntactically a
// CALL.  Bind the same generator first and the subject is a `Value::Var`, which fell
// through to the collection-cursor advance: nothing ran the generator, nothing tested its
// exhausted state, and the loop yielded `u16::MAX` forever — one run wrote 1.5 GB to
// stdout before it was killed.  On `--native` the same program did not compile (loft#841).
//
// The subject's TYPE is what decides it: a collection loop arrives with its container type,
// so a subject that already is `iterator<T>` can only be a generator handle.  A range is
// the one other thing typed `iterator<T>`, and it arrives as an inline iterator carrying
// its own bound test — hence the range cases below, which must NOT pick up a coroutine
// exhaustion test.
//
// Every generator here is driven to exhaustion: an abandoned one leaks its backing store,
// which is loft#835 and has its own file.

fn from_vector() -> iterator<integer> {
  v = [10, 20, 30];
  for x in v { yield x; }
}

fn from_range() -> iterator<integer> {
  for i in 0..3 { yield i; }
}

fn straight_line() -> iterator<integer> {
  yield 1;
  yield 2;
}

fn sum_bound_vector() -> integer {
  g = from_vector();
  total = 0;
  for x in g { total += x; }
  total
}

fn sum_bound_range() -> integer {
  g = from_range();
  total = 0;
  for x in g { total += x; }
  total
}

fn sum_bound_straight_line() -> integer {
  g = straight_line();
  total = 0;
  for x in g { total += x; }
  total
}

// A handle reaching the loop as a PARAMETER — `next(g)` on one already worked
// (`776-generator-heap-locals.loft`); the for-loop over one did not.
fn sum_parameter(g: iterator<integer>) -> integer {
  total = 0;
  for x in g { total += x; }
  total
}

// Two loops, two handles of the same generator: each advances its own.
fn two_handles() -> integer {
  a = from_vector();
  b = from_vector();
  first = 0;
  for x in a { first += x; }
  second = 0;
  for x in b { second += x; }
  first * 1000 + second
}

// Controls — a plain range loop is typed `iterator<integer>` too and must keep counting
// its own bound rather than asking a generator whether it is exhausted.
fn plain_range() -> integer {
  total = 0;
  for i in 1..5 { total += i; }
  total
}

fn plain_range_with_break() -> integer {
  total = 0;
  for i in 1..100 { total += i; if i >= 4 { break; } }
  total
}

fn main() {
  assert(sum_bound_vector() == 60, "bound generator over a vector runs and ends");
  assert(sum_bound_range() == 3, "bound generator over a range runs and ends");
  assert(sum_bound_straight_line() == 3, "bound generator with straight-line yields");
  assert(sum_parameter(from_vector()) == 60, "generator handle iterated as a parameter");
  assert(two_handles() == 60060, "two handles advance independently");

  // The anonymous form has always worked and must keep working.
  total = 0;
  for x in from_vector() { total += x; }
  assert(total == 60, "control: generator iterated where it is created");

  assert(plain_range() == 10, "control: plain range loop");
  assert(plain_range_with_break() == 10, "control: range loop with a break");

  println("841 ok");
}
