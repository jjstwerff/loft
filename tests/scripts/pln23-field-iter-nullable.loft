//
// `for f in s#fields` must iterate EVERY declared field, including the nullable
// ones.
//
// It did not. `text?` is `Type::Optional(Text)` (@PLN25), which the variant
// match in `parse_field_iteration` did not name, so it fell into the `_ =>
// continue` meant for records and vectors and the field was skipped without a
// word — the loop simply ran fewer times. A field holding a REAL value
// (`b: text? = "y"`) vanished exactly like a null one, so the axis was the
// DECLARATION, not the value.
//
// Two things made it worth a guard of its own. It was silent: nothing reports a
// loop that runs fewer times than the struct has fields. And it made `#fields`
// disagree with `type_of(x).fields`, which reports the nullable ones — two
// accounts of one layout, which is the drift reflection exists to prevent. An
// ORM walking `#fields` to build a row wrote fewer columns than the schema it
// had just generated from `type_of`.

struct Mixed {
  a: text,        // "x"   plain
  b: text?,       // "y"   NULLABLE, holding a real value — the cell that fell
  c: text?,       // null  NULLABLE, holding null
  d: integer,     // 7     plain
  e: integer?,    // 5     NULLABLE, holding a real value
  g: integer?,    // null  NULLABLE, holding null
  h: boolean?,    // true  NULLABLE, holding a real value
  k: float?,      // null
}

fn main() {
  m = Mixed { a: "x", b: "y", c: null, d: 7, e: 5, g: null, h: true, k: null };

  // ONE `#fields` loop collects all three answers on purpose. The unroll makes
  // two work-refs per field per loop and they live until scope exit, so three
  // loops over eight fields sit above the store-count warning threshold — and a
  // guard that always warns is a guard nobody reads when the warning is real.
  names = "";
  flags = "";
  got = "";
  n = 0;
  for f in m#fields {
    if names != "" { names += "," }
    names += f.name;
    // The DECLARATION, so a reader knows a sentinel is possible. This is what
    // stands in for a nullable payload type: `FvText` carries a `text`, and for
    // a nullable field that text may be loft's null.
    flags += if f.nullable { "?" } else { "." };
    got += "{f.name}=";
    if f.value is FvText { v } { got += "[{v}]"; }
    if f.value is FvInt { v } { got += "{v}"; }
    if f.value is FvLong { v } { got += "{v}"; }
    if f.value is FvBool { v } { got += "{v}"; }
    if f.value is FvFloat { v } { got += "{v}"; }
    got += " ";
    n += 1;
  }

  // Every declared field is visited, in declaration order.
  assert(names == "a,b,c,d,e,g,h,k", "visited: {names}");
  assert(n == 8, "field count: {n}");
  assert(flags == ".??.????", "nullable flags: {flags}");

  // The values arrive, and a real one in a nullable field is not lost — `b` and
  // `e` are the cells the bug ate: nullable AND non-null.
  assert(got == "a=[x] b=[y] c=[null] d=7 e=5 g=null h=true k=null ", "values: {got}");

  // `#fields` and `type_of` must agree about what the fields ARE — the whole
  // point of the fix. Same count, same names, same order.
  t = type_of(m);
  assert(len(t.fields) == n, "type_of says {len(t.fields)}, #fields says {n}");
  refl = "";
  for rf in t.fields {
    if refl != "" { refl += "," }
    refl += rf.name;
  }
  assert(refl == names, "type_of order {refl} vs #fields {names}");

  println("field-iter nullable ok");
}
