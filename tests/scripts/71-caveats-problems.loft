// Runtime reproducers for known CAVEATS and PROBLEMS entries.
// Failing tests are annotated so they pass once the underlying bug is fixed.
// Parse-error tests are in 72-parse-error-caveats.loft (separate file).

// --- C54: file.lines() drops content without trailing newline ---

// @PLN9: cwd-relative paths — this test does cwd-relative file I/O.
#cwd
fn test_c54_file_lines_no_trailing_newline() {
  {
    c54_f = file("test_c54.txt"); c54_f += "no trailing newline";
  }
  c54_lines = file("test_c54.txt").lines();
  delete("test_c54.txt");
  assert(c54_lines.len() >= 1, "C54 file.lines no trailing newline: got {c54_lines.len()} lines");
}

fn test_c54_file_lines_with_trailing_newline_ok() {
  {
    c54w_f = file("test_c54w.txt"); c54w_f += "has trailing newline\n";
  }
  c54w_lines = file("test_c54w.txt").lines();
  delete("test_c54w.txt");
  assert(c54w_lines.len() >= 1, "C54 guard: with newline got {c54w_lines.len()} lines");
}

// --- P85: Struct-enum local variable — guard (was debug assertion, may be fixed) ---

enum P85Val {
  P85Int { n: integer },
  P85Text { t: text },
}

fn p85_extract() -> integer {
  p85_v = P85Int { n: 42 };
  if p85_v is P85Int { n } { return n; }
  0
}

fn test_p85_struct_enum_local() {
  p85_result = p85_extract();
  assert(p85_result == 42, "P85 struct-enum local: {p85_result}");
}

// --- P91: moved to 72-parse-error-caveats.loft (now a compile error) ---

// --- P98: a descending key orders every query, and `sorted` is the oracle ---
//
// The `-` on a key field is the comparator's business and is applied exactly once, so a
// range names its bounds in the COLLECTION's own key order.  On `[-cat]` the walk runs
// "c" -> "a": `["c".."a"]` is the non-empty half and `["a".."c"]` the inverted, empty
// one.  `index` and `sorted` must answer identically -- that is what makes them two
// implementations of one ordered contract instead of two behaviours, so the sorted twin
// below is the oracle rather than a second copy of the same claim.
//
// These rows assert WHICH records, in which order.  The guard they replace summed the
// scores of `["a".."c"]` and read 3, which is `{a,b}` -- the ascending answer, and a
// value a sum cannot tell apart from `{c}` (loft#1267).

struct P98Item {
  cat: text,
  score: integer,
}
struct P98Db {
  idx: index<P98Item[-cat]>,
}
struct P98SortedDb {
  srt: sorted<P98Item[-cat]>,
}

fn test_p98_index_range_descending_key() {
  p98_db = P98Db {
    idx: [
      P98Item { cat: "a", score: 1 },
      P98Item { cat: "b", score: 2 },
      P98Item { cat: "c", score: 3 },
    ],
  };
  p98_walk = "";
  for p98_e in p98_db.idx["c".."a"] { p98_walk += p98_e.cat; }
  assert(p98_walk == "cb", "P98 descending range [c..a]: expected cb got {p98_walk}");
  p98_back = "";
  for p98_b in p98_db.idx["a".."c"] { p98_back += p98_b.cat; }
  assert(p98_back == "", "P98 inverted range [a..c] must be empty: got {p98_back}");
}

fn test_p98_sorted_answers_the_same() {
  p98s_db = P98SortedDb {
    srt: [
      P98Item { cat: "a", score: 1 },
      P98Item { cat: "b", score: 2 },
      P98Item { cat: "c", score: 3 },
    ],
  };
  p98s_walk = "";
  for p98s_e in p98s_db.srt["c".."a"] { p98s_walk += p98s_e.cat; }
  assert(p98s_walk == "cb", "P98 sorted oracle [c..a]: expected cb got {p98s_walk}");
  p98s_back = "";
  for p98s_b in p98s_db.srt["a".."c"] { p98s_back += p98s_b.cat; }
  assert(p98s_back == "", "P98 sorted oracle [a..c] must be empty: got {p98s_back}");
}

fn test_p98_full_iteration_ok() {
  p98a_db = P98Db {
    idx: [
      P98Item { cat: "a", score: 1 },
      P98Item { cat: "b", score: 2 },
      P98Item { cat: "c", score: 3 },
    ],
  };
  p98a_walk = "";
  p98a_total = 0;
  for p98a_e in p98a_db.idx { p98a_walk += p98a_e.cat; p98a_total += p98a_e.score; }
  assert(p98a_total == 6, "P98 guard: full iteration sum {p98a_total}");
  assert(p98a_walk == "cba", "P98 guard: full iteration order {p98a_walk}");
}
