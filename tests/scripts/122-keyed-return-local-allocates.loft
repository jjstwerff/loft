//
// @PLN85 A.1 companion-fix guard — the `skip_free` / `is_inline_ref`
// de-conflation at the keyed codegen init site (`gen_keyed_null`).
//
// The keyed no-alloc sentinel path is gated on `is_inline_ref` ALONE — the
// genuine "borrow, don't allocate" signal — NOT `is_skip_free` (whose only
// contract is "don't emit `OpFreeRef`").  This guard pins BOTH sides of the
// boundary so the overload can never silently come back:
//
//   OWNS its store  → must ALLOCATE  (`OpDatabase`; store_nr != u16::MAX).
//                      Conflating the two flags suppressed the alloc for a
//                      keyed return-local that owns-then-transfers, leaving
//                      store_nr=65535 → OOB panic at allocation.rs (the crash
//                      A.1's gate-flip exposes; this fix unblocks it).
//   BORROWS a store → must stay no-alloc (sentinel / borrowed view), and must
//                      NOT allocate a fresh store that then leaks.  The vector
//                      init site keeps the `skip_free` no-alloc gate precisely
//                      so the match-bind (`_mv_*`) and `??`-coalesce (`__ncc_*`)
//                      borrowed views below do not allocate-then-leak.
//
// All sections must run clean (correct result + no store leak at exit) on BOTH
// the interpreter and --native.

struct Item { k: integer }
struct HRec { ck: integer, v: integer }

// --- OWNS: keyed return-local. The store is allocated in mk_* and transferred
//     on return; the receiving local must read a real (allocated) store. ---
fn mk_hash() -> hash<HRec[ck]> {
  h: hash<HRec[ck]> = [];
  h += [HRec{ck: 5, v: 9}];
  h += [HRec{ck: 8, v: 12}];
  h
}
fn mk_sorted() -> sorted<Item[k]> {
  s: sorted<Item[k]> = [];
  s += [Item{k: 3}];
  s += [Item{k: 1}];
  s += [Item{k: 2}];
  s
}

// --- BORROWS (skip_free, dep empty): match-bind of a vector held inside an
//     enum payload. The bind temp aliases the payload store; it must NOT
//     allocate a fresh store (which, being skip_free, would never be freed). ---
enum Box { Empty, Full { v: vector<integer> } }
fn sum_full(n: integer) -> integer {
  t = 0;
  if n > 0 {
    b: Box = Full { v: [11, 22, 33] };
    match b {
      Full { v } => t += v[0] + v[2],
      Empty => t += 0,
    };
  }
  t
}

// --- BORROWS (skip_free, dep non-empty): `??` coalesce returning a vector view
//     into an existing container — a borrowed view, not an owned store. ---
struct Outer { lists: vector<vector<Item>> }
fn coalesce_pick() -> integer {
  o = Outer { lists: [] };
  inner: vector<Item> = [Item { k: 42 }];
  o.lists += [inner];
  fallback: vector<Item> = [Item { k: 0 }];
  a = o.lists[0] ?? fallback;
  a[0].k
}

fn main() {
  // OWNS — keyed return-locals read a real allocated store.
  xh = mk_hash();
  assert(len(xh) == 2, "hash return len");
  assert(xh[5].v == 9 && xh[8].v == 12, "hash return lookup");

  yh: hash<HRec[ck]> = mk_hash();
  assert(len(yh) == 2, "typed hash return len");

  xs = mk_sorted();
  out = "";
  for it in xs { out += "{it.k} "; }
  assert(out == "1 2 3 ", "sorted return ordered: {out}");

  // BORROWS — match-bind, looped to surface any per-call allocation leak.
  total = 0;
  for _ in 0..50 { total += sum_full(5); }
  assert(total == 50 * 44, "match-bind borrow sum: {total}");

  // BORROWS — coalesce vector view.
  assert(coalesce_pick() == 42, "coalesce vector view");

  println("122-keyed-return-local-allocates ok");
}
