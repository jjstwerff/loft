// Regression for #437's NRVO return-aliasing class (investigation plan-90).
//
// #437 made vector-returning fns NRVO (a fn returns its caller-provided `["??"]`
// buffer). When a multi-arm vector `match` delivers arms into one return buffer, OR
// a binding adopts a callee's NRVO buffer, a coexisting result could alias a store
// that was freed while still returned -> silent corruption (interp wrong value,
// native empty buffer). This surfaced in the cbor/ztcbor libraries (the zero-trust
// consumer); cbor's own suite never exercised CMap, the coverage gap that hid it.
//
// One O-Move invariant ("every arm/binding that transfers a heap store out must not
// be freed"), three sites that were re-deriving it inconsistently (STABILITY_REDFLAGS
// cluster 1): I-a control.rs:906 (raw match), I-b control.rs:4101 (materialized match),
// I-c scopes.rs witness-pairing (vector adopt, freed only when it does NOT escape).

fn head(major: integer, arg: integer) -> vector<u8> {
  buf: vector<u8> = [];
  if arg < 24 { buf += [(major * 32 + arg) as u8]; }
  else { buf += [(major * 32 + 24) as u8]; buf += [arg as u8]; }
  return buf;
}
fn blt(a: vector<u8>, b: vector<u8>) -> boolean { return (a[0] ?? 0) < (b[0] ?? 0); }

// --- I-a: raw multi-arm match, every arm tail-calls a __retbuf fn ---
enum Cia { CiaNull, CiaInt { value: integer not null } }
fn encode_ia(v: Cia) -> vector<u8> {
  match v { CiaNull => head(7, 22), CiaInt { value } => head(0, value) }
}
fn test_437_ia_raw_multiarm_match() {
  ki = encode_ia(CiaInt { value: 1 });             // ki LIVE
  z = blt(encode_ia(CiaInt { value: 3 }), ki);     // temp coexists with ki
  assert((ki[0] ?? 99) == 1, "I-a: ki clobbered to {ki[0] ?? 99} (expect 1)");
  assert(!z, "I-a: blt(3,1) should be false");
}

// --- I-b: a block-bodied arm forces the match to MATERIALIZE ---
enum Cib { CibNull, CibInt { value: integer not null }, CibBytes { value: vector<u8> } }
fn encode_ib(v: Cib) -> vector<u8> {
  match v {
    CibNull => head(7, 22),
    CibInt { value } => head(0, value),
    CibBytes { value } => { buf = head(2, len(value)); buf += value; buf },
  }
}
fn test_437_ib_materialized_match() {
  ki = encode_ib(CibInt { value: 1 });
  z = blt(encode_ib(CibInt { value: 3 }), ki);
  assert((ki[0] ?? 99) == 1, "I-b: ki clobbered to {ki[0] ?? 99} (expect 1)");
  assert(!z, "I-b: blt(3,1) should be false");
}

// --- I-c: `buf = head()` adopts the NRVO buffer; coexisting CMap encode ---
struct Ent { k: integer, v: integer }
enum Cic { CicInt { value: integer not null }, CicMap { entries: vector<Ent> } }
fn encode_map_ic(entries: vector<Ent>) -> vector<u8> {
  n = len(entries);
  buf = head(5, n);
  for i in 0..n { buf += head(0, entries[i].k); buf += head(0, entries[i].v); }
  return buf;
}
fn encode_ic(v: Cic) -> vector<u8> {
  match v { CicInt { value } => head(0, value), CicMap { entries } => encode_map_ic(entries) }
}
fn test_437_ic_vector_adopt_free() {
  c: vector<Ent> = []; c += [ Ent { k: 3, v: 42 } ];
  a = encode_ic(CicMap { entries: c });            // a must survive...
  b = encode_ic(CicMap { entries: c });            // ...the coexisting second encode
  // head(5,1)=[161], head(0,3)=[3], head(0,42)=[24,42] -> [161,3,24,42]
  assert(len(a) == 4, "I-c: a clobbered to len {len(a)} (expect 4)");
  assert((a[1] ?? 0) == 3, "I-c: a[1]={a[1] ?? 0} (expect 3, the adopted key byte)");
  assert(len(b) == 4, "I-c: b len {len(b)} (expect 4)");
}
