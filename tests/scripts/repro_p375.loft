//
// @P375 regression (dryopea-surfaced) — `{x:j}` / `to_json()` dropped
// present-but-empty fields (empty string "", empty vector []), producing
// partial JSON that broke the save→load round-trip and confused consumers
// who hand-edit the file.  Fixed by tightening the formatter's `is_null`:
// only a genuinely-unset text (s_rec 0) is null; an allocated "" emits as ""
// and a vector (no nullable flag) always emits at least [].

struct S {
  a: text,
  b: vector<integer>,
  c: integer,
}

fn main() {
  // The @P375 regression is on the EMIT side: every declared field must
  // appear, including a present empty string and an empty vector.
  s = S { a: "", b: [], c: 0 };
  assert("{s:j}" == `{{"a":"","b":[],"c":0}}`, "all declared fields emitted");

  // populated values still emit correctly
  s2 = S { a: "hi", b: [1, 2], c: 5 };
  assert("{s2:j}" == `{{"a":"hi","b":[1,2],"c":5}}`, "populated fields emit");

  print("ok");
}
