// Regression — @PLN85 P3.  A `match` that returns into the function's buffer, with
// an empty `_ => { [] }` arm written MULTI-LINE, used to crash the interpreter when
// that empty arm was taken at runtime (`deliver(Empty)`).
//
// Root: the multi-line empty-vector arm reduces to a block whose only operator is a
// bare `Line` marker, yet it is typed to yield the vector result.  `generate_block`
// claimed the result slot (`stack.position = after`) without emitting any push, so
// at runtime the taken empty arm left the eval stack one result slot short — the
// enclosing `OpReturn` discard over-counted and `fn_return` misread the saved return
// address → stack-pointer underflow / heap corruption.  (`--native` was unaffected;
// it returns on the Rust call stack.  The SINGLE-line spelling became a Null else
// that `gen_if` already padded, which is why only multi-line crashed.)
//
// Fix: `generate_block` pushes a typed null of the result when a value-typed block's
// operators leave nothing on the eval stack — mirroring `gen_if`'s null-else arm.
struct E { hp: integer not null, name: text }
enum Cell { Empty, Filled { items: vector<E> } }

// Empty arm SECOND (the `_` wildcard).
fn deliver(e: Cell) -> vector<E> {
  match e {
    Filled { items } => { o: vector<E> = []; o += items; o },
    _ => { [] },
  }
}

// Empty arm FIRST (named), heavy arm second.
fn deliver_rev(e: Cell) -> vector<E> {
  match e {
    Empty => { [] },
    Filled { items } => { o: vector<E> = []; o += items; o },
  }
}

fn main() {
  inner: vector<E> = [];
  for k in 0..3 { inner += [E{hp: k, name: "e"}]; }
  cell = Filled { items: inner };

  // The crash needed the EMPTY arm taken at runtime; churn makes a short discard fatal.
  for i in 0..12 {
    a = deliver(Empty {});
    assert(len(a) == 0, "deliver(Empty) i{i}: len={len(a)}");
    ra = deliver_rev(Empty {});
    assert(len(ra) == 0, "deliver_rev(Empty) i{i}: len={len(ra)}");

    // Filled path must stay correct too (the other arm).
    b = deliver(cell);
    assert(len(b) == 3, "deliver(Filled) i{i}: len={len(b)}");
    assert(b[0].hp == 0 && b[2].hp == 2, "deliver(Filled) i{i}: values wrong");
    rb = deliver_rev(cell);
    assert(len(rb) == 3, "deliver_rev(Filled) i{i}: len={len(rb)}");

    j: vector<E> = [];
    for q in 0..12 { j += [E{hp: q, name: "x"}]; }
  }
  println("ok");
}
