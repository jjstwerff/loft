//
// loft#1205's NEGATIVE half.  A NULL DISCHARGE on the left of an assignment is refused, in
// every spelling of the discharge (`x?`, `x ?? d`), for every target kind, and for both `=`
// and a compound operator.
//
// `(N-Default)` (@FR-N-Default) defines `e?` as `e ?? construct_default(τ)`, so a discharge
// answers the slot when it holds a value and a FRESH default when it does not: on the null
// path a write through it lands in a temporary nothing can read back.  The refusal is
// therefore what the rules already said, not a new restriction — @FR-N-NotPlace names it.
//
// In its own file because a firing `@EXPECT_ERROR` stops the file before execution; the
// positive half — the cure this message names, actually computing the right answer — is
// `1205-a-nullable-slot-is-written-through-its-own-name.loft`.  Pass-2 diagnostics only, so
// it belongs beside `102-expected-errors.loft`'s rule: nothing here may report during pass 1.
//
// The four cells are the four DIFFERENT wrong answers the one defect produced before the
// refusal existed, which is why each is scored separately rather than trusting one to stand
// for the rest: a `vector` field appended the record TWICE (the filed symptom), a `text`
// target reached codegen through a minted work variable and SIGSEGV'd, an `integer` one was
// turned away by arithmetic dispatch with a message about the operator, and a plain `=` on a
// null slot lost the write in silence.  One message now covers all four.
//
// @falsified-at: 251d405f — MEASURED, and `scripts/falsify.sh` is the wrong instrument here:
//   it reads exit/asserts/leak/panic, all of which answer 1|0|none|none on both trees, and it
//   prints INERT (its own BULK path skips an annotation-scored file for exactly this reason).
//   The channel that moves is `check_diagnostics`.  Run through the 251d405f binary the whole
//   file reports ONE diagnostic — "Not implemented operation + for type integer" at the `??`
//   cell — so all FIVE `@EXPECT_ERROR` lines go unmatched and `tests/wrap.rs` fails the file.
//   The other four report nothing at all on that build: they compiled, and answered 2 /
//   SIGSEGV'd / lost the write / mutated the `const` parameter at RUNTIME.  The `const` cell
//   was measured on its own too, since this file aborts before reaching it there: the same
//   function over a `const` parameter printed 99 on the control with no diagnostic at all.

struct Ic1205 { x: integer }
struct Nc1205 { i: Ic1205? }
struct Dt1205 { k: integer, nm: text }
struct Nb1205 { d: vector<Dt1205>?, t: text?, n: integer? }

// The filed shape: a `?`-discharged vector FIELD under `+=`.  It appended the record twice
// and skipped the keyed sibling of its collection group.
// @EXPECT_ERROR: the left side of this assignment is a discharged value, not a place
fn test_1205_vector_field_compound_is_refused() {
  b1205a = Nb1205 { d: [] };
  b1205a.d? += [Dt1205 { k: 7, nm: "seven" }];
  assert(true, "unreached");
}

// A `text` target: the same discharge, but `assign_var_nr` MINTS a work variable for a text
// `+=`, so the "left side is a value" guard one level down never saw it and the write reached
// codegen against a variable that names no slot.
// @EXPECT_ERROR: the left side of this assignment is a discharged value, not a place
fn test_1205_text_field_compound_is_refused() {
  b1205b = Nb1205 { t: "ab" };
  b1205b.t? += "cd";
  assert(true, "unreached");
}

// A scalar target, and the OTHER spelling of the discharge — `?? d` rather than `?`.  Both
// lower to the same conditional, so both are the same question; before the refusal this one
// was turned away by arithmetic dispatch, which named the operator instead of the target.
// @EXPECT_ERROR: the left side of this assignment is a discharged value, not a place
fn test_1205_coalesce_spelling_is_refused() {
  b1205c = Nb1205 { n: 5 };
  b1205c.n ?? 0 += 1;
  assert(true, "unreached");
}

// A plain `=`.  `E-Asgn` writes its place once, so the double-evaluation cannot fire here —
// and the write was still lost whenever the slot was null, which is what makes this a
// question about the TARGET rather than about compound assignment.  A discharged LOCAL, so
// the cell also covers the bare-variable lowering (a plain `if`, no temp).
// @EXPECT_ERROR: the left side of this assignment is a discharged value, not a place
fn test_1205_plain_assign_to_a_discharged_local_is_refused() {
  v1205d: vector<Dt1205>? = null;
  v1205d? = [Dt1205 { k: 3, nm: "three" }];
  assert(true, "unreached");
}

// The FIFTH answer, and the one that is not about the target being a discharge at all: here the
// discharge sits INSIDE the place (`h.i?.x`), so the target IS a place and the write is legal —
// but `const` has to keep binding through it.  It did not: `lhs_base_var` walked the place to
// find the binding a write reaches, hit the `ncc` block and answered "no variable", so
// `validate_write` had nothing to check and the write went through.  A `const` parameter was
// mutated, in silence, and the caller saw 99.  The dense twin one field over — `h.i.x = 99` with
// `i: I` — was refused the whole time, which is what named the discharge as the cause.
// @EXPECT_ERROR: Cannot modify const parameter 'h1205e'
fn cn1205_touch(h1205e: const Nc1205) {
  h1205e.i? .x = 99;
}

fn main() {
  test_1205_vector_field_compound_is_refused();
  test_1205_text_field_compound_is_refused();
  test_1205_coalesce_spelling_is_refused();
  test_1205_plain_assign_to_a_discharged_local_is_refused();
  cn1205_touch(Nc1205 { i: Ic1205 { x: 1 } });
}
