//
// loft#1236 — a lambda nested inside a lambda names the enclosing function's scope, and a write
// through it reaches the binding.
//
// `total = 0; outer = fn(b) { inner = fn(x) { total += x; }; … }` answered `total=0` on
// `--interpret` — silent, exit 0 — and would not compile on `--native` at all (E0425: the
// inner lambda's generated Rust named a variable nothing had captured).  The symptom depended
// on WHAT the inner lambda named: a scalar or a collection got a fresh binding and a silent
// wrong answer, a struct got *"Unknown variable"*.  A single lambda over the same variable is
// correct, which is what every test in the corpus writes — which is why this stayed unfound.
//
// Four things had to hold, and each fails differently:
//
//   * RESOLUTION — the inner body's capture scope is the enclosing function's variables PLUS
//     everything that function can see.  Without the second half the name does not resolve at
//     all, and where the resolver recovers by binding a fresh local, the write lands in
//     something that dies with the call.
//   * RELAY — a closure record is filled by the scope that BUILDS it, from what that scope can
//     name.  An inner lambda reaching past its enclosing lambda therefore needs that lambda to
//     capture the name too, or there is nothing here to fill the inner record from.
//   * THE FILL — and it comes from how THIS scope names the capture, its own closure field
//     FIRST.  A lambda that names an outer binding gets a placeholder variable in its own
//     table which pass 2 never assigns, because the read goes through the record; filling from
//     that placeholder handed the inner record an unallocated slot.
//   * OWNERSHIP — the `__cell_<T>` a mutated capture is boxed into belongs to the frame that
//     HOLDS the variable, not to the closure that passes it along.  Boxed in the enclosing
//     closure, the owner's local stayed an unboxed scalar while every capture of it was a cell
//     handle; adopted by the inner record, the cell was freed when the enclosing lambda
//     RETURNED — so the second call read a released store.
//
// The `n = 50` cell is the one that needs all four at once: the enclosing lambda both WRITES
// the relayed name and nests a lambda that reads it, so the placeholder, the boxing and the
// ownership questions are all live in one function.
//
// The one-level cells are the controls: each was correct before, and the nesting must not be
// bought by breaking them.
//
// @falsified-at: 7d9b3723 — interpret exit 1 -> 0, native exit 1 -> 0.  On the control the
//   first cell answers 0 where it owes 62 and the file stops there.  The EXIT channel is the
//   one that moves and the assertion channel does not: an `assert` that fires ends the run at
//   the first cell, so the count `falsify.sh` reads is the same 0 on both trees.

struct Acc1236 {
  n: integer,
}

fn bump1236(acc: Acc1236, by: integer) {
  acc.n = acc.n + by;
}

fn main() {
  // The filed shape: a scalar mutated by a lambda two levels down.
  t1236 = 0;
  o1236 = fn(b: integer) {
    i1236 = fn(x: integer) { t1236 += x; };
    i1236(b);
    i1236(b + 1);
  };
  o1236(10);
  o1236(20);
  assert(t1236 == 62, "nested scalar mutation {t1236}");

  // The one-level control, correct throughout.
  u1236 = 0;
  a1236 = fn(x: integer) { u1236 += x; };
  a1236(10);
  a1236(11);
  a1236(20);
  a1236(21);
  assert(u1236 == 62, "one-level control {u1236}");

  // A COLLECTION two levels down: it answered length 0, silently.
  v1236: vector<integer> = [];
  ov1236 = fn(b: integer) {
    iv1236 = fn(x: integer) { v1236 += [x]; };
    iv1236(b);
    iv1236(b + 1);
  };
  ov1236(10);
  ov1236(20);
  assert(len(v1236) == 4, "nested collection appends {len(v1236)}");
  assert(v1236[0] == 10, "nested collection [0] {v1236[0]}");
  assert(v1236[3] == 21, "nested collection [3] {v1236[3]}");

  // A STRUCT handed to a function: this one did not resolve at all.
  s1236 = Acc1236 { n: 0 };
  os1236 = fn(b: integer) {
    is1236 = fn(x: integer) { bump1236(s1236, x); };
    is1236(b);
    is1236(b + 1);
  };
  os1236(10);
  os1236(20);
  assert(s1236.n == 62, "nested struct through a call {s1236.n}");

  // READ-ONLY, which needs the resolution half and none of the boxing.
  r1236 = 5;
  or1236 = fn(b: integer) -> integer {
    ir1236 = fn(x: integer) -> integer { x + r1236 };
    ir1236(b)
  };
  assert(or1236(10) == 15, "nested read-only capture {or1236(10)}");

  // THREE levels, because two is the case a fix can serve by accident.
  w1236 = 0;
  l1a1236 = fn(a: integer) {
    l2a1236 = fn(b: integer) {
      l3a1236 = fn(c: integer) { w1236 += c; };
      l3a1236(b);
    };
    l2a1236(a);
  };
  l1a1236(5);
  l1a1236(7);
  assert(w1236 == 12, "three levels {w1236}");

  // `text`, whose cell and whose append are both their own path.
  x1236: text = "";
  ox1236 = fn(s: text) {
    ix1236 = fn(t: text) { x1236 += t; };
    ix1236(s);
    ix1236("!");
  };
  ox1236("a");
  ox1236("b");
  assert(x1236 == "a!b!", "nested text appends {x1236}");

  // The inner lambda names BOTH the grandparent's binding and its own parent's parameter.
  b1236 = 100;
  ob1236 = fn(p: integer) -> integer {
    ib1236 = fn(q: integer) -> integer { q + p + b1236 };
    ib1236(1)
  };
  assert(ob1236(10) == 111, "grandparent and parent together {ob1236(10)}");

  // All four halves at once: the enclosing lambda WRITES the relayed name and nests a lambda
  // that reads it.
  y1236 = 3;
  oy1236 = fn(p: integer) -> integer {
    y1236 = 50;
    iy1236 = fn(q: integer) -> integer { q + y1236 };
    iy1236(p)
  };
  assert(oy1236(1) == 51, "write and nest in one lambda {oy1236(1)}");
  assert(y1236 == 50, "and the write reached the binding {y1236}");

  // The one-level twin of that write, correct before and after.
  z1236 = 3;
  oz1236 = fn(p: integer) -> integer {
    z1236 = 50;
    p + z1236
  };
  assert(oz1236(1) == 51, "one-level write control {oz1236(1)}");
  assert(z1236 == 50, "one-level write reached the binding {z1236}");

  println("1236-a-lambda-inside-a-lambda-sees-the-enclosing-scope ok");
}
