// loft#957 regression — a tail `return <call>` whose value lives in NO variable,
// in a frame that has cleanup to run.
//
// `read_bytes` and `list_dir` are bodiless `#rust` natives returning a collection.
// Return promotion never runs for such a tail — there is no local candidate to
// promote — so nothing bound the result, and `free_vars` lowered the return to
// the legacy shape:
//
//     read_bytes(p);        // the call, as a statement — value dropped
//     OpFreeRef(<local>);   // the frame's cleanup
//     return null;
//
// That shape relies on `OpReturn(value=N)` reading the eval-stack top, which is a
// bytecode-only accident: the interpreter answered correctly because the call had
// left its result there, while native emitted the typed null sentinel and the
// bytes were simply gone.  So this was silent, native-only, and invisible to a
// `loft test --interpret` gate — the filed symptom was an empty `read_bytes`, and
// the same stale reference panicked in `keys.rs` once it flowed on.
//
// The trigger is ANY heap local forcing cleanup, not a vector one: `text` and
// `vector<integer>` locals reproduce it just as a `vector<u8>` local does, which
// is wider than the report's "local vector".  A non-heap local needs no cleanup
// and was always correct — it is the control that says the CLEANUP, not the extra
// declaration, is the axis.
//
// ⚠ THE RETURN MUST BE BARE.  Writing `return read_bytes(p) ?? []` here does not
// test anything: the `??` discharge binds the value to a variable, which is
// exactly the `ret_var` case P236 already handled, so the guard passes with the
// fix reverted.  The first version of this file did that and was inert.  The
// functions therefore return `vector<u8>?` and the discharge happens at the CALL
// site — which also keeps the file free of the nullable-into-non-null warning.
//
// Each subject pairs with a `_bare` control that has no local, because the bug is
// a DIFFERENCE between them: without the controls a tree that stopped calling
// `read_bytes` at all would pass.  Runs on both backends through
// tests/native.rs::native_scripts.

fn cleanup() {
  delete("p957_dir/blob.bin");
  delete("p957_dir");
}

// --- the reported shape: a vector local, then a bare `return read_bytes(p)` ---
fn vec_local(p: text) -> vector<u8>? {
  e: vector<u8> = [];
  return read_bytes(p);
}
fn vec_bare(p: text) -> vector<u8>? {
  return read_bytes(p);
}

// --- the axis is the CLEANUP, so a text local must reproduce it too -----------
fn text_local(p: text) -> vector<u8>? {
  t = "some text that owns a store";
  return read_bytes(p);
}

// --- and a local of an unrelated element type --------------------------------
fn other_vec_local(p: text) -> vector<u8>? {
  v: vector<integer> = [9, 8, 7];
  return read_bytes(p);
}

// --- the control: a NON-heap local needs no cleanup and always worked ---------
fn int_local(p: text) -> vector<u8>? {
  n = 0;
  if n != 0 { return null; }
  return read_bytes(p);
}

// --- the tail-EXPRESSION form (no `return` keyword) takes the same path -------
fn tail_expr(p: text) -> vector<u8>? {
  e: vector<u8> = [];
  read_bytes(p)
}

// --- a second bodiless native returning a collection, so the guard is on the
//     CLASS and not on `read_bytes` ------------------------------------------
fn dir_local(d: text) -> vector<text>? {
  e: vector<u8> = [];
  return list_dir(d);
}
fn dir_bare(d: text) -> vector<text>? {
  return list_dir(d);
}

fn main() {
  cleanup();
  assert(mkdir_all("p957_dir") == FileResult.Ok, "mkdir_all should succeed");
  blob: vector<u8> = [0, 255, 1, 254, 128];
  assert(write_bytes("p957_dir/blob.bin", blob), "write_bytes should succeed");
  p = "p957_dir/blob.bin";

  // The value must survive the cleanup, and must equal what the no-local form
  // answers — an empty vector was the bug, so length AND content are asserted.
  assert(len(vec_bare(p) ?? []) == 5, "control: no local, 5 bytes");
  assert(len(vec_local(p) ?? []) == 5, "a vector local must not cost the return value");
  assert(len(text_local(p) ?? []) == 5, "a text local must not cost the return value");
  assert(len(other_vec_local(p) ?? []) == 5, "a vector<integer> local must not either");
  assert(len(int_local(p) ?? []) == 5, "control: a non-heap local needs no cleanup");
  assert(len(tail_expr(p) ?? []) == 5, "the tail-expression form takes the same path");

  got = vec_local(p) ?? [];
  assert(got[0] == 0, "byte 0 survives");
  assert(got[1] == 255, "byte 1 survives");
  assert(got[4] == 128, "byte 4 survives");

  // The class, not the instance: `list_dir` is the other bodiless native
  // returning a collection, and must agree with its own control.
  assert(len(dir_local("p957_dir") ?? []) == len(dir_bare("p957_dir") ?? []),
         "list_dir with a local agrees with list_dir without one");
  assert(len(dir_local("p957_dir") ?? []) == 1, "and both see the one file written above");

  cleanup();
  print("957 ok\n");
}
