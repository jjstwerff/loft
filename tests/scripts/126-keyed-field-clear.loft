//
// @P307 — clearing a keyed-collection STRUCT FIELD with `s.h = []`, on
// BOTH backends.  Used to be (1) a COMPILE error through a `&` param
// ("Parameter 'b' has & but is never modified" — the keyed-field write
// was not recognised), (2) a runtime NO-OP (no clear op emitted; native
// emitted a dead `var_fresh;`), and (3) a store leak.  The keyed-LOCAL
// clear (`s = []`) was already fixed (@P302, via OpDatabase); a field is
// a claim INSIDE its struct's store, so it needs an in-place free.
// Fixed by lowering the empty-literal keyed-field clear to a new
// `OpClearKeyed(field, kt)` op (interp `#rust` body + native
// `codegen_runtime::OpClearKeyed`, both calling `remove_claims`), and
// recognising it as a first-arg write in `check_ref_mutations`.

struct HRec {
  ck: integer,
  v: integer,
}
struct SRec {
  sk: integer,
}
struct IRec {
  ik: integer,
}

// All three keyed kinds as fields, mutated through a `&` param.
struct Bag {
  h: hash<HRec[ck]>,
  s: sorted<SRec[sk]>,
  i: index<IRec[ik]>,
}

fn bag_fill(b: &Bag) {
  b.h += [
    HRec { ck: 1, v: 10 },
  ];
  b.h += [
    HRec { ck: 2, v: 20 },
  ];
  b.s += [
    SRec { sk: 7 },
  ];
  b.i += [
    IRec { ik: 9 },
  ];
}

// The crux: clearing keyed fields through a `&` param must (a) compile,
// (b) actually empty them, (c) not leak.
fn bag_clear(b: &Bag) {
  b.h = [];
  b.s = [];
  b.i = [];
}

fn main() {
  b = Bag { h: [], s: [], i: [] };
  bag_fill(b);
  assert(len(b.h) == 2, "hash field filled");
  assert(len(b.s) == 1, "sorted field filled");
  assert(len(b.i) == 1, "index field filled");

  // lookup works before clear
  r = b.h[1];
  assert(r != null, "hash lookup before clear");
  assert(r.v == 10, "hash value before clear");

  bag_clear(b);
  assert(len(b.h) == 0, "hash field cleared");
  assert(len(b.s) == 0, "sorted field cleared");
  assert(len(b.i) == 0, "index field cleared");
  assert(b.h[1] == null, "hash lookup after clear is null");

  // re-fill after clear must work (the field re-initialises in place)
  bag_fill(b);
  assert(len(b.h) == 2, "hash field re-filled after clear");
  assert(len(b.s) == 1, "sorted field re-filled after clear");
  assert(len(b.i) == 1, "index field re-filled after clear");
  r2 = b.h[2];
  assert(r2 != null, "hash lookup after re-fill");
  assert(r2.v == 20, "hash value after re-fill");

  // selective clear: clearing one keyed field leaves the others intact
  b.h = [];
  assert(len(b.h) == 0, "selective clear: hash empty");
  assert(len(b.s) == 1, "selective clear: sorted untouched");
  assert(len(b.i) == 1, "selective clear: index untouched");

  print("p307 ok\n");
}
