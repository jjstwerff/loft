//
// loft#1366 — a `vector<τ>?` stored into a non-null `vector<τ>` FIELD of a struct literal is
// reported.  A scalar into a field always was; the vector took the struct literal's deep-copy
// lowering (`OpAppendVector`), which never reaches `convert`, so it asks `(N-Store)` for
// itself — the one lowering of @PLN153 phase 3's fold that stores without converting.
//
// @falsified-at: 806a8d84 → here (warnings 0 → 1): silent on the build this guard was
//   written to catch, same value on both.
// @EXPECT_WARNING: is stored into the field of the non-null type `vector<integer>`
struct H { f: vector<integer> }
fn main() {
  i = 0;
  w: vector<vector<integer>> = [[1, 2, 3]];
  h = H { f: w[i] };
  assert(len(h.f) == 3, "the field holds the copy: {len(h.f)}");
  println("vector field reported");
}
