//
// loft#977 — writing a COLLECTION field of a struct-enum value panicked inside the store
// layer on both backends: `index out of bounds: the len is 83 but the index is 65535`.
//
// `c.limbs` on `enum Shape { Circle { limbs: vector<float> }, … }` is written through the
// ENUM type, but the field lives in the `Circle` variant's own record.  The enum type is
// `Parts::Enum` — a variant list, no fields — so resolving the field against it missed, and
// both resolvers answered their not-found sentinel: `field_nr` said `0`, which is a real
// field number, and `field_type` said `u16::MAX`, which `record_new` then used to index the
// type table.  `new_record_field_op` now redirects to the variant that declares the field,
// exactly as it already did for a synth `__nullable<S>` payload (@PLN25's `key_owner`).
//
// FILED SCOPE WAS A TENTH OF IT.  The issue reads "appending to a vector payload"; the
// boundary matrix says EVERY allocating write to EVERY collection payload field, through
// EVERY route.  Both halves of that are pinned below:
//   container kind — vector<float>, vector<record>, hash<T[k]>, sorted<T[k]>,
//                    vector<vector<…>>, vector<another struct-enum>
//   operation      — `+=`, whole-assign (`= [a, b]`), `.remove(i)`, and `+=` in a loop
//   route          — a local, an element of a vector<Shape>, a fn parameter, a struct field,
//                    a struct field two hops down
//   variant        — first or second in the enum, and NOT the first field of its variant
//
// The two rows that already worked are kept as CONTROLS, because they are what says the
// defect was in the allocating path and not in struct-enum field access at large: an
// element write (`c.limbs[0] = …`) and a scalar field write (`c.s = …`) never call
// `record_new`, and both answered correctly throughout.
//
// The variant is resolved by the field's byte OFFSET **and** its content TYPE, never the
// offset alone: two variants each holding a collection put it at the same offset, because
// every collection field is one 4-byte handle sitting straight after the discriminant.
// `I977Box` below is that cell, and the content type is what carries it — measured, on a
// build of the resolver keyed on the offset alone: `Keyed.ys` then resolves to `Listed.xs`,
// the record is appended to a VECTOR instead of a hash, and the keyed lookup answers
// nothing.  That build reads `1 p 0 miss 0` for the four values this cell asserts, where
// they should read `1 p 1 q 2`.
//
// NOT pinned here, because it is older and wider than this fix: field access on a
// struct-enum does not check the discriminant, so `c.limbs` on a `Square` value reads and
// writes `Circle`'s slot.  That is the READ's long-standing behaviour (`len(c.limbs)` on a
// `Square` answered `0`, silently, before this fix too) and the write now merely agrees
// with it.  Filed on its own as loft#980.

enum I977Shape {
  Circle { limbs: vector<float> },
  Square { s: float },
}

// The target variant is SECOND — a wrong redirect that simply took the first variant
// would still pass every cell above.
enum I977Flip {
  Sq { s: float },
  Ci { limbs: vector<float> },
}

// Both variants hold a collection, so both fields sit at the SAME byte offset and only
// their content types tell them apart — one a vector, one a hash.  Resolving on the offset
// alone appends the keyed record into the vector, and nothing says so at the write: it
// shows up later, as a lookup that finds nothing.
enum I977Box {
  Listed { xs: vector<I977Item> },
  Keyed  { ys: hash<I977Item[name]> },
}

struct I977Item {
  name: text,
  v:    integer,
}

enum I977Records {
  Many { items: vector<I977Item> },
  One  { n: integer },
}

enum I977Keyed {
  Bag   { items: hash<I977Item[name]> },
  Empty { n: integer },
}

enum I977Nested {
  Grid { rows: vector<vector<float>> },
  Flat { n: integer },
}

// `limbs` is NOT the first field of its variant: a wrong field INDEX lands on `tag` or
// `extra`, so reading those back is what catches it.
enum I977Offset {
  Tagged { tag: integer, extra: float, limbs: vector<float> },
  Bare   { n: integer },
}

// A keyed payload whose collection ORDERS its records: the append has to reach
// `record_finish`'s key maintenance through the variant too, not just allocate.
enum I977Store {
  Ordered { items: sorted<I977Item[name]> },
  Loose   { n: integer },
}

// A struct-enum whose payload holds ANOTHER struct-enum — the redirect has to hold for
// the element type as well as the container.
enum I977Inner {
  Leaf { vals: vector<float> },
  Nil  { n: integer },
}

enum I977Outer {
  Wrap  { kids: vector<I977Inner> },
  Empty { n: integer },
}

struct I977Holder {
  shape: I977Shape,
}

struct I977Mid {
  shape: I977Shape,
}

struct I977Top {
  inner: I977Mid,
}

fn i977_via_param(c: I977Shape) {
  c.limbs += [1.0];
}

fn main() {
  // append to a vector payload — the filed shape
  a = Circle { limbs: [] };
  a.limbs += [1.0];
  assert(len(a.limbs) == 1, "append: len {len(a.limbs)}");
  assert(a.limbs[0] == 1.0, "append: value {a.limbs[0]}");

  // whole-vector assign — the same panic, and NOT in the filed scope
  b = Circle { limbs: [] };
  b.limbs = [1.0, 2.0];
  assert(len(b.limbs) == 2, "assign: len {len(b.limbs)}");
  assert(b.limbs[1] == 2.0, "assign: value {b.limbs[1]}");

  // CONTROL: an element write allocates nothing and always worked
  c = Circle { limbs: [5.0, 6.0] };
  c.limbs[0] = 9.0;
  assert(len(c.limbs) == 2, "element write: len {len(c.limbs)}");
  assert(c.limbs[0] == 9.0, "element write: value {c.limbs[0]}");

  // CONTROL: a scalar payload field, likewise
  d = Square { s: 1.0 };
  d.s = 3.0;
  assert(d.s == 3.0, "scalar field: {d.s}");

  // the variant is second AND its sibling packs a float at the same offset
  e = Ci { limbs: [] };
  e.limbs += [7.0];
  assert(len(e.limbs) == 1, "second variant: len {len(e.limbs)}");
  assert(e.limbs[0] == 7.0, "second variant: value {e.limbs[0]}");

  // a payload of RECORDS, not scalars
  f = Many { items: [] };
  f.items += [I977Item { name: "hi", v: 4 }];
  assert(len(f.items) == 1, "record elements: len {len(f.items)}");
  assert(f.items[0].name == "hi", "record elements: name {f.items[0].name}");
  assert(f.items[0].v == 4, "record elements: v {f.items[0].v}");

  // a KEYED payload — `record_finish` maintains the key from the same field entry
  g = Bag { items: [] };
  g.items += [I977Item { name: "hi", v: 7 }];
  assert(len(g.items) == 1, "keyed: len {len(g.items)}");
  got = g.items["hi"] ?? I977Item { name: "", v: 0 };
  assert(got.v == 7, "keyed: lookup answers {got.v}");

  // a NESTED collection payload
  h = Grid { rows: [] };
  h.rows += [[1.0, 2.0]];
  assert(len(h.rows) == 1, "nested: outer len {len(h.rows)}");
  assert(len(h.rows[0]) == 2, "nested: inner len {len(h.rows[0])}");
  assert(h.rows[0][1] == 2.0, "nested: value {h.rows[0][1]}");

  // the field is not the first of its variant — the neighbours must be untouched
  i = Tagged { tag: 7, extra: 2.5, limbs: [] };
  i.limbs += [1.0];
  assert(len(i.limbs) == 1, "later field: len {len(i.limbs)}");
  assert(i.limbs[0] == 1.0, "later field: value {i.limbs[0]}");
  assert(i.tag == 7, "later field: tag survived as {i.tag}");
  assert(i.extra == 2.5, "later field: extra survived as {i.extra}");

  // two variants whose collection fields share a byte offset — the content type is the
  // only thing that separates them, and getting it wrong is silent until the lookup
  j = Listed { xs: [] };
  j.xs += [I977Item { name: "p", v: 1 }];
  k = Keyed { ys: [] };
  k.ys += [I977Item { name: "q", v: 2 }];
  assert(len(j.xs) == 1, "shared offset: the vector variant holds {len(j.xs)}");
  assert(j.xs[0].name == "p", "shared offset: vector element {j.xs[0].name}");
  assert(len(k.ys) == 1, "shared offset: the hash variant holds {len(k.ys)}");
  found = k.ys["q"] ?? I977Item { name: "miss", v: 0 };
  assert(found.name == "q", "shared offset: the key resolves to {found.name}");
  assert(found.v == 2, "shared offset: and carries {found.v}");

  // route: an element of a vector<enum>
  v: vector<I977Shape> = [Circle { limbs: [] }];
  v[0].limbs += [1.0];
  assert(len(v[0].limbs) == 1, "in a vector: len {len(v[0].limbs)}");
  assert(v[0].limbs[0] == 1.0, "in a vector: value {v[0].limbs[0]}");

  // route: through a function parameter
  p = Circle { limbs: [] };
  i977_via_param(p);
  assert(len(p.limbs) == 1, "via a parameter: len {len(p.limbs)}");

  // route: a struct field holding the enum
  q = I977Holder { shape: Circle { limbs: [] } };
  q.shape.limbs += [1.0];
  assert(len(q.shape.limbs) == 1, "struct field: len {len(q.shape.limbs)}");
  assert(q.shape.limbs[0] == 1.0, "struct field: value {q.shape.limbs[0]}");

  // a KEYED payload that also ORDERS: iteration must come back in key order
  r = Ordered { items: [] };
  r.items += [I977Item { name: "b", v: 2 }];
  r.items += [I977Item { name: "a", v: 1 }];
  order = "";
  for it in r.items { order += it.name; }
  assert(len(r.items) == 2, "sorted payload: len {len(r.items)}");
  assert(order == "ab", "sorted payload: iteration order '{order}'");
  keyed = r.items["a"] ?? I977Item { name: "miss", v: 0 };
  assert(keyed.v == 1, "sorted payload: the key answers {keyed.v}");

  // the elements are themselves a struct-enum
  w = Wrap { kids: [] };
  w.kids += [Leaf { vals: [1.0] }];
  assert(len(w.kids) == 1, "enum elements: len {len(w.kids)}");
  assert(len(w.kids[0].vals) == 1, "enum elements: inner len {len(w.kids[0].vals)}");
  assert(w.kids[0].vals[0] == 1.0, "enum elements: value {w.kids[0].vals[0]}");

  // two field hops down to the enum
  t = I977Top { inner: I977Mid { shape: Circle { limbs: [] } } };
  t.inner.shape.limbs += [1.0];
  t.inner.shape.limbs += [2.0];
  assert(len(t.inner.shape.limbs) == 2, "two hops: len {len(t.inner.shape.limbs)}");
  assert(t.inner.shape.limbs[1] == 2.0, "two hops: value {t.inner.shape.limbs[1]}");

  // repeated appends: the vector has to keep growing through the redirect, not restart
  m = Circle { limbs: [] };
  for x in 0..50 { m.limbs += [x as float]; }
  assert(len(m.limbs) == 50, "loop append: len {len(m.limbs)}");
  assert(m.limbs[0] == 0.0, "loop append: first {m.limbs[0]}");
  assert(m.limbs[49] == 49.0, "loop append: last {m.limbs[49]}");

  // removal through the same field
  n = Circle { limbs: [1.0, 2.0, 3.0] };
  n.limbs.remove(1);
  assert(len(n.limbs) == 2, "remove: len {len(n.limbs)}");
  assert(n.limbs[0] == 1.0, "remove: first {n.limbs[0]}");
  assert(n.limbs[1] == 3.0, "remove: second {n.limbs[1]}");

  print("977 struct-enum collection field write OK\n");
}
