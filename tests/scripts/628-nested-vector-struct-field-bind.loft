//
// Regression for #628 — binding a `vector<vector<T>>` into a struct field must
// copy the inner rows, not lose them.
//
// The struct-literal field bind lowers to `OpAppendVector(field, src, elem_tp)`,
// where `elem_tp` is the store type of ONE element — the stride `vector_add`
// copies by.  It was computed as `content(vector_of(content))`, which peels one
// level too many for a NESTED field: it yielded the inner scalar (`Parts::Base`,
// size 8) where an element of a `vector<vector<T>>` is really a 4-byte vector
// HANDLE (`Parts::Vector`).  `vector_add` then strode 8 bytes over 4-byte
// handles, so the destination reported the right OUTER length with every inner
// row empty — and walked off the populated region into a SIGSEGV once the struct
// carried three such fields.  `db_type` is the canonical recursive resolver
// (#250) and is narrow-aware, so scalar and narrow fields are unchanged.
//
// Same class as #624 (a whole-collection op handed the wrong content type) and
// as @P314 — the width/lifetime family that keeps recurring.  Both backends: the
// bug reproduced on `--interpret` and `--native` alike.
//
// SECOND KNOWN GAP: a NARROW inner type (`vector<vector<u8>>`) is correct on
// `--interpret` after this fix but still wrong on `--native` (it reads a short
// row) — a pre-existing native-only defect on the same field, unchanged by this
// fix, so it is not asserted here.  `integer` and `text` — the two shapes the
// issue reports — are correct on BOTH backends.
//
// KNOWN GAP, still open, deliberately NOT asserted here: when the source vector
// is used ONLY in the struct literal (no prior read), the parser inlines its
// construction into the FIRST field, and any further field bound to the same
// expression is left empty — `Bag { a: v, b: v, c: v }` then reads `bg.a`
// correctly and `bg.b` / `bg.c` empty.  That is a separate pre-existing defect
// (the loft#437 shape) in the inlining/store-placement substrate, not the stride
// resolved here; every test below reads the source first, as the #628 reporter's
// own reproducer does.

struct Bag {
  a: vector<vector<integer>>,
  b: vector<vector<integer>>,
  c: vector<vector<integer>>,
}

struct One { a: vector<vector<integer>> }
struct Flat { a: vector<integer> }
struct Texts { a: vector<vector<text>> }

fn rows() -> vector<vector<integer>> {
  v: vector<vector<integer>> = [];
  for i in 0..3 {
    r: vector<integer> = [];
    for j in 0..4 { r += [(i * 4) + j + 1]; }
    v += [r];
  }
  return v;
}

fn total(v: vector<vector<integer>>) -> integer {
  s = 0;
  for i in 0..len(v) {
    row = v[i] ?? [];
    for j in 0..len(row) { s = s + (row[j] ?? 0); }
  }
  return s;
}

// 1+2+…+12 — a sum no truncated copy can reach, so a lost row is loud.
fn test_628_nested_vector_into_one_struct_field() {
  v = rows();
  assert(total(v) == 78, "source total={total(v)} (expect 78)");
  bg = One { a: v };
  assert(len(bg.a) == 3, "outer len={len(bg.a)} (expect 3)");
  // The pre-fix read gave the right outer length with every inner row EMPTY,
  // so a length assert alone passed over lost data.
  assert(total(bg.a) == 78, "one-field total={total(bg.a)} (expect 78)");
}

// Three nested fields is where the wrong stride ran off the region: pre-fix this
// shape SIGSEGV'd rather than reading empty.
fn test_628_three_nested_fields_all_survive() {
  v = rows();
  assert(total(v) == 78, "source total={total(v)} (expect 78)");
  bg = Bag { a: v, b: v, c: v };
  assert(len(bg.a) == 3 && len(bg.b) == 3 && len(bg.c) == 3, "outer lens");
  assert(total(bg.a) == 78, "field a total={total(bg.a)} (expect 78)");
  assert(total(bg.b) == 78, "field b total={total(bg.b)} (expect 78)");
  assert(total(bg.c) == 78, "field c total={total(bg.c)} (expect 78)");
}

// Distinct sources per field — pre-fix this SIGSEGV'd too, so the fault was the
// stride, not aliasing one source vector into three fields.
fn test_628_three_fields_from_distinct_sources() {
  a = rows();
  b = rows();
  c = rows();
  assert(total(a) + total(b) + total(c) == 234, "sources");
  bg = Bag { a: a, b: b, c: c };
  assert(total(bg.a) == 78 && total(bg.b) == 78 && total(bg.c) == 78, "distinct sources");
}

// A `text` inner type — a heap element, the other shape the issue names.
fn test_628_text_inner_type() {
  t: vector<vector<text>> = [];
  for i in 0..2 {
    tr: vector<text> = [];
    for j in 0..2 { tr += ["r{i}c{j}"]; }
    t += [tr];
  }
  assert(len(t) == 2, "text source outer len");
  bt = Texts { a: t };
  assert(len(bt.a) == 2, "text outer len={len(bt.a)} (expect 2)");
  first = bt.a[0] ?? [];
  assert(len(first) == 2, "text row len={len(first)} (expect 2)");
  assert((first[1] ?? "") == "r0c1", "text elem={first[1] ?? \"\"} (expect r0c1)");
}

// A FLAT `vector<integer>` field resolved correctly before the fix and must keep
// doing so — `db_type` returns the same id there, so this pins that the recursive
// resolver did not change the scalar case.
fn test_628_flat_vector_field_unaffected() {
  f: vector<integer> = [];
  for i in 0..5 { f += [i + 1]; }
  bf = Flat { a: f };
  assert(len(bf.a) == 5, "flat len={len(bf.a)} (expect 5)");
  s = 0;
  for i in 0..len(bf.a) { s = s + (bf.a[i] ?? 0); }
  assert(s == 15, "flat total={s} (expect 15)");
}

// Field ASSIGNMENT was the working baseline the fix was derived from — keep it
// green so the two paths cannot drift apart again.
fn test_628_field_assignment_still_works() {
  v = rows();
  bg = One { a: [] };
  bg.a = v;
  assert(total(bg.a) == 78, "assigned total={total(bg.a)} (expect 78)");
}
