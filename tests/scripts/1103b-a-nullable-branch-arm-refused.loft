//
// A nullable arm anywhere in a branch must reach the DECLARATION, which refuses it (loft#1103,
// `types.md` D-Null-Join).  Separated from `1103-a-nullable-in-a-later-branch-arm.loft` because
// these are compile errors and an error stops the other test functions in a file from running;
// that file holds the value half, this one holds the refusals.
//
// Both halves are needed and neither implies the other.  The value file declares `integer?`
// everywhere, which is what the rules say the author must write — and it PASSES on a pre-fix
// binary, because a join that wrongly types non-null still stores into a nullable slot happily.
// What changed is that a NON-NULL declaration is no longer silently accepted, and only a file
// that asserts the refusal can score that.
//
// `(N-Decl)`: "a DECLARED slot `x: τ` is a COMMITMENT ... declaring non-null FORBIDS a later
// nullable write."  The direct spelling `x: integer = maybe(k)` always obeyed it.  Every cell
// below is that same store moved into a branch arm, where the join used to drop the `Optional`
// before the declaration ever saw it.

fn maybe1103b(k: integer) -> integer? { if k > 5 { 7 } else { null } }
fn maybe_text1103b(k: integer) -> text? { if k > 5 { "a" } else { null } }
fn maybe_u8_1103b(k: integer) -> u8? { if k > 5 { 7 as u8 } else { null } }

// The reported shape: a nullable call in the ELSE arm.
// @EXPECT_ERROR: cannot change type from integer to integer?
fn test_else_arm_is_refused() {
  x: integer = if maybe1103b(1) == null { 1 } else { maybe1103b(2) };
  assert(x == 1, "unreachable — the declaration above is refused");
}

// An `else if` CHAIN arm.  The chain keeps its SHAPE out of the join deliberately, so its
// nullability had to be carried separately to reach here.
// @EXPECT_ERROR: cannot change type from integer to integer?
fn test_else_if_chain_arm_is_refused() {
  k = 1;
  x: integer = if k == 9 { 1 } else if k == 8 { 2 } else { maybe1103b(k) };
  assert(x == 1, "unreachable — the declaration above is refused");
}

// A LATER `match` arm.  A `match` is the same nesting, reached through its own six arm sites
// rather than through `parse_if`, which is why the fold has one home.
// @EXPECT_ERROR: cannot change type from integer to integer?
fn test_later_match_arm_is_refused() {
  k = 1;
  x: integer = match k { 9 => { 1 }, _ => { maybe1103b(k) } };
  assert(x == 1, "unreachable — the declaration above is refused");
}

// The nullable arm need not be a CALL — an out-of-range index read is `integer?` too.
// @EXPECT_ERROR: cannot change type from integer to integer?
fn test_an_index_read_arm_is_refused() {
  k = 4;
  v = [5];
  x: integer = if k == 9 { 1 } else { v[k] };
  assert(x == 1, "unreachable — the declaration above is refused");
}

// A heap element type, to show the refusal is not a scalar special case.
// @EXPECT_ERROR: cannot change type from text to text?
fn test_a_text_arm_is_refused() {
  k = 1;
  x: text = if k == 9 { "a" } else { maybe_text1103b(k) };
  assert(x == "a", "unreachable — the declaration above is refused");
}

// THE CELL THAT MOST HAD TO BE REACHED.  `types.md` keeps `(N-Store)` a hard ERROR for u8…u32
// because "the null would collide with a real value" — the sentinel is a real `u8`, so a null
// in a non-null narrow slot cannot be told from `255`.  Every other cell here is recoverable
// with a warning by the rule; this one is not, and it was reachable through an else arm.
// @EXPECT_ERROR: cannot change type from integer(0, 255) to integer(0, 255)?
fn test_a_narrow_width_arm_is_refused() {
  k = 1;
  x: u8 = if k == 9 { 1 as u8 } else { maybe_u8_1103b(k) };
  assert(x as integer == 1, "unreachable — the declaration above is refused");
}
