//
// A nullable arm anywhere in a branch must reach the DECLARATION, which reports it (loft#1103,
// `types.md` D-Null-Join).  Separated from `1103-a-nullable-in-a-later-branch-arm.loft`
// because that file holds the value half — it declares `integer?` everywhere, which is what
// the rules say the author must write — and it PASSES on a pre-fix binary, because a join
// that wrongly types non-null still stores into a nullable slot happily.  What changed is
// that a NON-NULL declaration is no longer silently accepted, and only a file that asserts
// the report can score that.
//
// `(N-Decl)`: "a DECLARED slot `x: τ` is a COMMITMENT ... declaring non-null FORBIDS a later
// nullable write."  The direct spelling `x: integer = maybe(k)` always obeyed it.  Every cell
// below is that same store moved into a branch arm, where the join used to drop the `Optional`
// before the declaration ever saw it.
//
// The severity is `(N-Store)`'s: at full width a WARNING and the store PROCEEDS — so these
// cells RUN, and each asserts the value the slot then holds (@PLN153 phase 3b; the declared
// local used to be a hard error at every width).  The narrow-width cell, which stays an
// ERROR because a `u8` has no bit pattern left for null, is
// `1103c-a-nullable-narrow-branch-arm-is-refused.loft` — an error stops a file before it runs.

fn maybe1103b(k: integer) -> integer? { if k > 5 { 7 } else { null } }
fn maybe_text1103b(k: integer) -> text? { if k > 5 { "a" } else { null } }

// The reported shape: a nullable call in the ELSE arm.
// @EXPECT_WARNING: a nullable `integer?` is stored into the local `x1` of the non-null type `integer`
fn test_else_arm_is_reported() {
  x1: integer = if maybe1103b(1) == null { 1 } else { maybe1103b(2) };
  assert(x1 == 1, "the null test took the first arm: {x1}");
}

// An `else if` CHAIN arm.  The chain keeps its SHAPE out of the join deliberately, so its
// nullability had to be carried separately to reach here.
// @EXPECT_WARNING: a nullable `integer?` is stored into the local `x2` of the non-null type `integer`
fn test_else_if_chain_arm_is_reported() {
  k = 1;
  x2: integer = if k == 9 { 1 } else if k == 8 { 2 } else { maybe1103b(k) };
  assert(x2 == null, "the last arm's null reached the slot: {x2}");
}

// A LATER `match` arm.  A `match` is the same nesting, reached through its own six arm sites
// rather than through `parse_if`, which is why the fold has one home.
// @EXPECT_WARNING: a nullable `integer?` is stored into the local `x3` of the non-null type `integer`
fn test_later_match_arm_is_reported() {
  k = 1;
  x3: integer = match k { 9 => { 1 }, _ => { maybe1103b(k) } };
  assert(x3 == null, "the default arm's null reached the slot: {x3}");
}

// The nullable arm need not be a CALL — an out-of-range index read is `integer?` too.
// @EXPECT_WARNING: a nullable `integer?` is stored into the local `x4` of the non-null type `integer`
fn test_an_index_read_arm_is_reported() {
  k = 4;
  v = [5];
  x4: integer = if k == 9 { 1 } else { v[k] };
  assert(x4 == null, "the out-of-range read's null reached the slot: {x4}");
}

// A heap element type, to show the refusal is not a scalar special case.
// @EXPECT_WARNING: a nullable `text?` is stored into the local `x5` of the non-null type `text`
fn test_a_text_arm_is_reported() {
  k = 1;
  x5: text = if k == 9 { "a" } else { maybe_text1103b(k) };
  assert(x5 == null, "the text null reached the slot: {x5}");
}
