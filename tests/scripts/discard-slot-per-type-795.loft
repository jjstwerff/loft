//
// Regression (loft#795): `_` shared ONE slot per function, which made it the single
// name exempt from the one-type-per-name rule — and the two backends then disagreed
// about what that exemption meant.
//
// The interpreter re-typed the shared slot per assignment and ran. Native takes the
// Rust local's type from the FIRST assignment, so a later assignment of a different
// type was emitted with the wrong lowering and the program did not compile at all
// (E0308, `bool` into a `u8` slot). THREE assignments were needed — two types
// ALTERNATING — which is why a discard-heavy function could work for a long time and
// then stop compiling when one more `_` was added.
//
// `_` now gets a slot per assignment. That is the compatible direction: making `_`
// obey the rule instead would reject programs that run today, for the one name whose
// entire purpose is to be written more than once. It is the same treatment `for _`
// loops already needed for their hidden counter (see anon-loop-counters.loft), and for
// the same reason — one shared companion for a binder people write repeatedly.
//
// The `for _` cells below are not decoration: `_` binders and `_` discards resolve
// through different paths, and the visible `for _` binding must keep reading back
// (`reads_underscore` in anon-loop-counters.loft covers that half directly).

struct S { const nm: text }

fn mk() -> S { return S { nm: "s" }; }
fn flag() -> boolean { return true; }
fn num() -> integer { return 7; }
fn txt() -> text { return "t"; }
fn pair() -> (integer, text) { return (1, "a"); }

fn test_discard_slots() {
  // A — the reported shape: a type ALTERNATION across three assignments. Two
  //     assignments of two types always compiled; the return to the first is what
  //     produced the bad lowering.
  _ = delete("loft795_a.tmp");
  _ = flag();
  _ = delete("loft795_b.tmp");

  // B — more types through the same discard, including a re-run of each.
  _ = num();
  _ = txt();
  _ = flag();
  _ = num();

  // C — HEAP discards. Each gets its own slot, so each must still be freed exactly
  //     once; a leak here shows up as the run's unfreed-stores report.
  _ = mk();
  _ = mk();

  // D — a discard inside a tuple LHS, the other spelling of the same thing.
  (_, b) = pair();
  assert(b == "a", "D tuple discard {b}");

  assert(num() == 7, "A-C compiled and ran");
}

fn test_underscore_binders_unaffected() {
  // E — CONTROL: `for _` binders resolve through their own path and must be untouched.
  n = 0;
  for _ in 0..3 { n += 1 }
  for _ in [10, 20] { n += 1 }
  assert(n == 5, "E for-_ binders {n} want 5");

  // F — CONTROL: nested `for _`, whose hidden counters had to become unique for the
  //     same underlying reason. 3 x 4 = 12.
  m = 0;
  for _ in 0..3 { for _ in 0..4 { m += 1 } }
  assert(m == 12, "F nested for-_ {m} want 12");

  // G — CONTROL: `_` as a match wildcard is a pattern, not a binding.
  k = match num() { 7 => { "seven" }, _ => { "other" } };
  assert(k == "seven", "G match wildcard {k}");

  println("795 ok");
}
