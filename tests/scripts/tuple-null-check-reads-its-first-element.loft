// A `vector<(…)>` element discharged with `??` answered the FALLBACK for a PRESENT
// element whenever the tuple's FIRST element was a collection.
//
// A tuple carries no `.rec` discriminant of its own, so the convention (@PLAN52 cluster
// IV-Tuple) is that a tuple is null when its FIRST field holds its type's null sentinel.
// `coalesce_not_null` built that test with the GENERIC `convert(first_tp, Boolean)` — and
// the heap-DbRef branch three lines below it exists precisely because that generic path
// has no registered `OpConv*FromX -> Boolean` for a collection: it hands back the bare
// Var, and the interpreter then tests raw BYTES instead of `.rec != 0`.  So the carve-out
// comment describing the hole sat immediately under the call that fell into it.
//
// Consequences, `--interpret` only (`--native` was correct throughout, so the workhorse
// differential COULD see this one — the corpus simply had no cell for it):
//   * a present element read as absent, so the program silently took its default;
//   * the whole tuple was replaced, so the SCALAR half was lost too — `([1,2], 9)` came
//     back as `([0], 0)`, and nothing said so.
//
// A `Reference` (struct) first element HID it: that type does have a generic path.  The
// cells therefore sweep the first element's type, which is the axis the convention names,
// and each collection cell asserts BOTH halves — reading only the first element would
// pass on a fallback whose first element happens to match.
//
// The fix recurses into `coalesce_not_null` instead of asking `convert`, so the null test
// and the heap-DbRef branch cannot drift apart.

struct TnQ { n: integer }

fn test_scalar_first_still_works() {
  v: vector<(integer, integer)> = [(7, 8)];
  p = v[0] ?? (0, 0);
  assert(p.0 == 7, "scalar-first .0: {p.0}");
  assert(p.1 == 8, "scalar-first .1: {p.1}");
}

fn test_text_first_still_works() {
  v: vector<(text, integer)> = [("k", 8)];
  p = v[0] ?? ("", 0);
  assert(p.0 == "k", "text-first .0: {p.0}");
  assert(p.1 == 8, "text-first .1: {p.1}");
}

// The cell that HID the defect: a struct first element has a generic Boolean path.
fn test_struct_first_still_works() {
  v: vector<(TnQ, integer)> = [(TnQ { n: 3 }, 8)];
  p = v[0] ?? (TnQ { n: 0 }, 0);
  assert(p.0.n == 3, "struct-first .0.n: {p.0.n}");
  assert(p.1 == 8, "struct-first .1: {p.1}");
}

// The defect: a collection first element. Both halves, because the fallback replaced
// the WHOLE tuple.
fn test_vector_first_is_not_null() {
  v: vector<(vector<integer>, integer)> = [([1, 2], 9)];
  p = v[0] ?? ([0], 0);
  assert(p.1 == 9, "vector-first lost the scalar half: {p.1}");
  assert(len(p.0) == 2, "vector-first .0 length: {len(p.0)}");
  assert((p.0[0] ?? 0) == 1, "vector-first .0[0]: {p.0[0] ?? 0}");
}

fn test_two_collection_elements() {
  v: vector<(vector<integer>, vector<integer>)> = [([1, 2], [3, 4])];
  p = v[0] ?? ([0], [0]);
  assert(len(p.0) == 2, "two-collection .0 length: {len(p.0)}");
  assert(len(p.1) == 2, "two-collection .1 length: {len(p.1)}");
  assert((p.0[0] ?? 0) == 1, "two-collection .0[0]: {p.0[0] ?? 0}");
  assert((p.1[0] ?? 0) == 3, "two-collection .1[0]: {p.1[0] ?? 0}");
}

// The REFERENCE ROUTE: the loop reads the same element without `??` and was always
// correct, so it says what the `??` route must answer rather than a hand-guessed value.
fn test_loop_route_agrees() {
  v: vector<(vector<integer>, integer)> = [([1, 2], 9)];
  seen = 0;
  for e in v {
    assert(e.1 == 9, "loop route .1: {e.1}");
    assert(len(e.0) == 2, "loop route .0 length: {len(e.0)}");
    seen += 1;
  }
  assert(seen == 1, "the loop ran {seen} times");
  p = v[0] ?? ([0], 0);
  assert(p.1 == 9, "the two routes disagree: loop 9, ?? {p.1}");
}

// An ABSENT element must still take the fallback — the fix must not make everything
// non-null.
fn test_absent_element_still_takes_the_fallback() {
  v: vector<(vector<integer>, integer)> = [([1, 2], 9)];
  p = v[7] ?? ([0], 42);
  assert(p.1 == 42, "out-of-range element did NOT take the fallback: {p.1}");
}
