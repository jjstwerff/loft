//
// A `sorted<T[k]>` BECOMES an `ORDERED<T[k]>` — the by-reference twin — as soon as
// anything else in the program declares an `index<T[..]>` FIELD over the same element
// type.  So the same source line lowers differently because of a declaration somewhere
// else entirely, and every rule that lists the keyed kinds has to list this one too.
//
// `towards_set`'s INSERT arm did not.  `s[k] = v` fell through to the update-only
// `OpCopyRecord` on a lookup that misses, so every insert was silently dropped: `len(s)`
// answered 0 and every lookup its `??` fallback — in a program that never mentions the
// struct whose second field caused the promotion.  It is loft#719's omission one function
// over; the REMOVAL arm (`towards_set_hash_remove`) had already been given `Ordered` and
// the insert arm beside it had not.
//
// The trigger is a pair of FIELDS, so the promotion is what the cells vary: declaration
// order, one struct or two, and the collections that must NOT promote (a different
// element type, a `hash` sibling, an index field with no sorted anywhere).  Elements are
// seeded `q = i + 7`; the `??` fallback is -1, which no element can hold.

struct I891Cell { q: integer, r: integer }
struct I891Other { q: integer, r: integer }

// The promoting declarations.  Neither struct is ever constructed — declaring them is
// the whole input.
struct I891Both { a: sorted<I891Cell[q]>, b: index<I891Cell[q]> }
struct I891SortedOnly { c: sorted<I891Other[q]> }
struct I891IndexOnly { d: index<I891Other[q]> }
struct I891Hash { e: hash<I891Other[q, r]>, f: index<I891Other[q]> }

fn i891_sorted(n: integer) -> sorted<I891Cell[q]> {
  s: sorted<I891Cell[q]> = [];
  for i in 0..n { s[i + 7] = I891Cell { q: i + 7, r: 0 }; }
  s
}
fn i891_index(n: integer) -> index<I891Cell[q]> {
  x: index<I891Cell[q]> = [];
  for i in 0..n { x[i + 7] = I891Cell { q: i + 7, r: 0 }; }
  x
}
// The same collection built with `+= [..]`, which never went through the broken arm and
// so tells a lowering fault from a storage one.
fn i891_appended(n: integer) -> sorted<I891Cell[q]> {
  s: sorted<I891Cell[q]> = [];
  for i in 0..n { s += [I891Cell { q: i + 7, r: 0 }]; }
  s
}
// The OTHER element type, promoted by its own pair of single-field structs.
fn i891_other(n: integer) -> sorted<I891Other[q]> {
  s: sorted<I891Other[q]> = [];
  for i in 0..n { s[i + 7] = I891Other { q: i + 7, r: 0 }; }
  s
}

fn i891_is(got: integer, want: integer, what: text) {
  assert(got == want, "{what}: {got}, expected {want}");
}

fn main() {
  s = i891_sorted(3);
  i891_is(len(s), 3, "a promoted sorted keeps its inserts");
  i891_is((s[7] ?? I891Cell { q: -1, r: -1 }).q, 7, "and answers the first of them");
  i891_is((s[9] ?? I891Cell { q: -1, r: -1 }).q, 9, "and the last");

  // Insert order is not key order: the collection must still read back sorted.
  d: sorted<I891Cell[q]> = [];
  d[9] = I891Cell { q: 9, r: 0 };
  d[7] = I891Cell { q: 7, r: 0 };
  d[8] = I891Cell { q: 8, r: 0 };
  i891_is(len(d), 3, "descending inserts");
  first = 0;
  for c in d { first = c.q; break; }
  i891_is(first, 7, "iteration is still in key order");

  // A REPLACE of an existing key updates rather than growing.
  d[8] = I891Cell { q: 8, r: 5 };
  i891_is(len(d), 3, "a replace does not grow the collection");
  i891_is((d[8] ?? I891Cell { q: -1, r: -1 }).r, 5, "and the replaced value is the new one");

  // Removal — the arm that already listed `Ordered` (loft#719) and must keep working.
  d[8] = null;
  i891_is(len(d), 2, "a removal still removes");
  assert(d[8] == null, "and the removed key is gone");

  // `+= [..]` was never routed through the broken arm.
  i891_is(len(i891_appended(3)), 3, "the append spelling");

  // The sibling that did the promoting must itself be intact.
  x = i891_index(3);
  i891_is(len(x), 3, "the index sibling");
  i891_is((x[7] ?? I891Cell { q: -1, r: -1 }).q, 7, "the index sibling reads back");

  // A different element type, promoted by two single-field structs rather than one
  // two-field struct: the pairing is program-wide, not per-struct.
  o = i891_other(3);
  i891_is(len(o), 3, "promoted across two structs");
  i891_is((o[7] ?? I891Other { q: -1, r: -1 }).q, 7, "and reads back");

  println("891 promoted sorted OK");
}
