// Probe 31 — Cluster I consumer border: hash key insert
//    `h[k] = (vec[i] ?? "x")` — RHS is the ncc-block, LHS is a hash slot
//
// The consumer is `OpSetKeyed` (or `OpInsertKeyed`), which reads the
// stack value and inserts it into the keyed collection.  Different
// opcode than Set / OpAppendText / OpFormatText — so a different
// memory-write path.  If this fails with NUL, cluster I has a "store
// data into a fresh allocation" sub-mode too.  If with garbage, the
// keyed-insert reuses the freed slot during its bytes-write.
//
// Pairing: diff against 02 (Set consumer) and 26 (OpAppendText consumer).
// Status: cluster I consumer-border probe.

struct Entry {
  name: text,
  value: text,
}
struct DB { entries: hash<Entry[name]> }

fn main() {
  src = DB { entries: [] };
  src.entries["k"] = Entry { name: "k", value: "present" };

  dst = DB { entries: [] };
  // The RHS of the entry construction is the ncc-block.
  dst.entries["k"] = Entry { name: "k", value: src.entries["k"].value ?? "fallback" };

  v = dst.entries["k"].value;
  assert(v == "present", "probe 31: got '{v}', want 'present'");
  println("probe 31 PASSED");
}
