// Regression — a `??` null-coalesce whose DEFAULT is a vector literal (`?? []`,
// `?? [99]`) used to panic in codegen ("Incorrect var _vec_N[65535]") on BOTH
// backends.  The default literal builds into its own work-ref `_vec_N` whose only
// `Set` lives in the ncc else-branch block, which the slot scan does not walk — so
// the work-ref got no stack slot (the #319 unwalked-block gap, here for the DEFAULT
// literal, not the subject temp).  Fix: register that work-ref and clear its
// borrow-dep so the function-entry preamble reserves + owned-inits its slot.
//
// Covers the cells that work on both backends: the BIND path (`x = expr ?? []`),
// a non-empty-literal default in LEN (`len(expr ?? [99])`), and a plain (non-
// nested) vector-field default.  (The dense/nullable LEN-empty + for-loop cells
// stay native-E0308 — a separate, pre-existing @PLN25 branch-unification gap.)
struct B {
  v: vector<integer>,
}

fn main() {
  out: vector<vector<integer>> = [[1, 2], [3]];

  // bind, empty default — was: panic both backends.
  inner = out[1] ?? [];
  assert(len(inner) == 1, "inner len={len(inner)}");

  // len of a non-empty-literal default — was: panic both backends.
  n = len(out[0] ?? [99]);
  assert(n == 2, "n={n}");

  // plain (non-nested) vector field, empty default — was: panic both backends.
  b = B { v: [1, 2] };
  iv = b.v ?? [];
  assert(len(iv) == 2, "iv len={len(iv)}");

  println("440 ok");
}
