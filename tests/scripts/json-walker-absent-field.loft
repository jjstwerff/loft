//
// `T.parse(json_parse(txt))` answers the same as `T.parse(txt)` about a field the
// document does not give a value.
//
// loft ships two JSON walkers — the `text` one (`Stores::parse`, the P54-U unified
// path) and the `JsonValue` one (`populate_struct_from_jsonvalue`, what the two-stage
// form and the engine's event decoder use).  Only the first asked the DECLARATION what
// an absent field holds; the second answered per type on its own, and drifted on every
// count:
//
//   struct D { u: u8?, b: boolean?, i: integer, t: text, d: u8 = 9 }  ..parse("{}")
//     two-stage was  u=0     b=false  i=null  t=null  d=0
//     one-stage      u=null  b=null   i=0     t=""    d=9
//
// so an absent `u8?` read back as the VALUE 0, a non-null `integer` read back null in a
// slot `(N-Decl)` says cannot hold one, and a declared default was ignored.  Worse, the
// same missing dispatch dropped narrow fields that WERE given a value: a `u8?` handed
// 42 read back 0, a `u16?` handed 300 read back null, and `vector<u8?>` given
// `[1,null,3]` read back `[0,0,0]`.
//
// The cure is formal/layout.md `(L-Null)` — absence is a sentinel in the slot's own
// bytes, so the sentinel is part of the layout and belongs at ONE address.  Both
// walkers now ask `Stores::write_absent_value` / `Stores::write_narrow_value`.
//
// Every assertion below compares the two routes against a hand-computed value, so a
// regression in either one fails whichever way they drift.

struct Inner { p: u8?, q: i16?, r: boolean? }

struct W {
  tag: text,
  a: u8?, b: u16?, c: i8?, d: i16?,
  e: integer?, g: integer limit(10,255)?,
  h: float?, i: text?, j: boolean?,
  nn: u8, nl: integer limit(10,255),
  dflt: u8 = 7, dtx: text = "dd", dfl: float = 1.5, dbo: boolean = true,
  inner: Inner
}

struct VW { xs: vector<u8?> }

// The other two narrow encodings.  `Parts::Int` is an `i32` struct field (raw, null
// `i32::MIN`); `Parts::ShortRaw` is a 2-byte VECTOR ELEMENT (direct, no `+1` shift) —
// a `u16` struct FIELD is `Parts::Short` instead, so the element is the only way here.
struct E4 { s4: i32?, n4: i32 }
struct EV { u2: vector<u16?>, i2: vector<i16?> }

// The shape `engine_host.rs`'s live build swap runs on: snapshot the world with
// `to_json()`, restore it with `parse(json_parse(...))`.  Both halves are loft's own, so
// when the write side spells a narrow null one way and the read side another, a hot
// reload brings the world back CHANGED with nothing said.
struct World {
  name: text,
  hp: u8, shield: u16?, mood: i8?, drift: i16?,
  score: integer, ratio: float, alive: boolean, flagged: boolean?,
  tier: integer limit(10,255), pick: integer limit(10,255)?,
  tiles: vector<u8?>
}

// One text per struct, so a single comparison covers every field at once.
fn show(w: W) -> text {
  "{w.a}/{w.b}/{w.c}/{w.d}/{w.e}/{w.g}/{w.h}/{w.i}/{w.j}|{w.nn}/{w.nl}|{w.dflt}/{w.dtx}/{w.dfl}/{w.dbo}|{w.inner.p}/{w.inner.q}/{w.inner.r}"
}

// Nullable widths absent, non-null widths at their zero, declared defaults honoured.
const ABSENT: text =
  "null/null/null/null/null/null/null/null/null|0/10|7/dd/1.5/true|null/null/null";

fn test_absent_key() {
  bare = "{{\"tag\":\"x\"}}";
  assert(show(W.parse(json_parse(bare))) == ABSENT, "two-stage, key omitted");
  assert(show(W.parse(bare)) == ABSENT, "one-stage, key omitted");
}

fn test_explicit_null() {
  // An explicit `null` is the same question as an omitted key, so it gets the same
  // answer — including for the fields that DECLARE a default.
  nul = "{{\"tag\":\"x\",\"a\":null,\"b\":null,\"c\":null,\"d\":null,\"e\":null,\"g\":null,\"h\":null,\"i\":null,\"j\":null,\"nn\":null,\"nl\":null,\"dflt\":null,\"dtx\":null,\"dfl\":null,\"dbo\":null,\"inner\":{{\"p\":null,\"q\":null,\"r\":null}}}}";
  assert(show(W.parse(json_parse(nul))) == ABSENT, "two-stage, explicit null");
  assert(show(W.parse(nul)) == ABSENT, "one-stage, explicit null");
}

fn test_wrong_kind_is_absent_and_reported() {
  // A value the field's type cannot hold is not a value: the field takes its absent
  // value, and the mismatch is REPORTED.  The narrow fields used to do neither — they
  // fell to a silent catch-all, so `a` and `g` were the two the report never named.
  bad = "{{\"tag\":\"x\",\"a\":\"hello\",\"g\":\"hello\",\"j\":\"hello\"}}";
  assert(show(W.parse(json_parse(bad))) == ABSENT, "two-stage, wrong kind reads absent");
  errs = json_errors();
  assert(errs.contains("W.a: expected JNumber"), "narrow byte mismatch is named");
  assert(errs.contains("W.g: expected JNumber"), "ranged narrow mismatch is named");
  assert(errs.contains("W.j: expected JBool"), "boolean mismatch is named");
}

fn test_present_narrow_values_survive() {
  // The half that was pure data loss: a narrow field with a value in the document.
  t = "{{\"tag\":\"x\",\"a\":42,\"b\":300,\"c\":-42,\"d\":-300,\"e\":7,\"g\":99,\"nn\":7,\"nl\":11,\"j\":true}}";
  two = W.parse(json_parse(t));
  one = W.parse(t);
  assert(two.a == 42 && two.b == 300 && two.c == -42 && two.d == -300,
         "two-stage keeps the narrow values it was given");
  assert(two.g == 99 && two.nn == 7 && two.nl == 11 && two.e == 7 && two.j,
         "ranged, non-null and wide fields too");
  assert(show(two) == show(one), "both routes agree field for field");
}

fn test_narrow_vector_elements() {
  // `vector<u8?>` had no element arm at all, so every element kept the appended zero
  // bytes — the nulls AND the values.
  vt = "{{\"xs\":[1,null,3]}}";
  two = VW.parse(json_parse(vt));
  one = VW.parse(vt);
  assert("{two.xs}" == "[1,null,3]", "two-stage narrow elements");
  assert("{one.xs}" == "[1,null,3]", "one-stage narrow elements");
  assert(len(two.xs) == 3 && two.xs[0] == 1 && two.xs[1] == null && two.xs[2] == 3,
         "the element reads agree with the render");
}

fn test_remaining_narrow_encodings() {
  bare = "{{}}";
  a2 = E4.parse(json_parse(bare));
  a1 = E4.parse(bare);
  assert(a2.s4 == null && a2.n4 == 0, "4-byte narrow, absent");
  assert(a1.s4 == null && a1.n4 == 0, "4-byte narrow, absent, reference route");
  t = "{{\"s4\":70000,\"n4\":-70000}}";
  p2 = E4.parse(json_parse(t));
  assert(p2.s4 == 70000 && p2.n4 == -70000, "4-byte narrow keeps values past the 2-byte range");

  vt = "{{\"u2\":[300,null,7],\"i2\":[-300,null,7]}}";
  v2 = EV.parse(json_parse(vt));
  v1 = EV.parse(vt);
  assert("{v2.u2}" == "[300,null,7]" && "{v2.i2}" == "[-300,null,7]",
         "2-byte raw elements, both signs");
  assert("{v1.u2}" == "{v2.u2}" && "{v1.i2}" == "{v2.i2}", "both routes agree on elements");
}

fn show_world(w: World) -> text {
  "{w.name}|{w.hp}/{w.shield}/{w.mood}/{w.drift}|{w.score}/{w.ratio}/{w.alive}/{w.flagged}|{w.tier}/{w.pick}|{w.tiles}"
}

fn test_snapshot_restore_is_the_identity() {
  w = World { name: "w", hp: 200, shield: 60000, mood: -100, drift: -30000,
              score: 123456789, ratio: 2.5, alive: true, flagged: null,
              tier: 200, pick: null, tiles: [1, null, 3] };
  back = World.parse(json_parse(w.to_json()));
  // Every narrow field used to come back 0 (or its slot's lowest value) here, and the
  // nulls came back as numbers, so a live build swap silently reset the world.
  assert(show_world(back) == show_world(w), "the world survives snapshot then restore");
}
