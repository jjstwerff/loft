//
// What a tuple LITERAL member may say about a `fn(…)` value (loft#1073).
//
// Two refusals, both specific to the literal-member position and both fixed here.  Every
// other position for the same value already accepted these, which is what made the
// literal the odd one out rather than a missing feature:
//
//   1. A short lambda one level in.  loft#1067 made a tuple member's declared type an
//      inference context, but the seeding read the TOP-LEVEL members only — a nested
//      member is a `Type::Tuple`, not a `Type::Function`, so nothing reached the inner
//      literal and `x` had no type:
//
//        t: (fn(integer) -> integer, integer)          = (|x| { x * 2 }, 1);      // OK
//        u: ((fn(integer) -> integer, integer), text)  = ((|x| { x * 2 }, 1), "z");
//        // error: Cannot infer type for lambda parameter 'x'
//
//      The cure is one predicate that sees a member which merely CONTAINS a `fn(…)` as a
//      step on the way to one, plus reading the member's declared type off the `⇐`
//      channel — a nested literal re-enters the parse through `expression`, which starts
//      its `var_tp` from `Unknown`, so the outer declaration is not there to read.
//
//   2. A forward-referenced fn NAME.  Not about nesting: it failed flat and nested alike.
//
//        t: (fn(integer) -> integer, integer) = (later, 1);
//        // error: 't' cannot change type … to (unknown, integer)
//        fn later(x: integer) -> integer { x * 2 }
//
//      Pass 1 has not seen `later` yet, so the literal types as `(unknown, integer)` —
//      and `change_var_type` measured that placeholder against the declared type instead
//      of waiting for pass 2.  A BARE `Unknown` source was already accepted there; the
//      same fact inside a tuple was not, because `is_unknown()` does not see through a
//      composite.  That is the mirror of loft#944, which made the identical statement
//      about the variable's own type.
//
// The asymmetry is the point of the second half.  Measured on both backends before the
// fix, the same forward reference was accepted as a plain local (`g: fn(integer) ->
// integer = later`), as a call argument (`takes(later)`) and as a member ASSIGNMENT
// (`t.0 = later`) — only the LITERAL refused it.
//
// The controls matter as much as the cells.  `test_a_nested_tuple_with_no_fn_is_unchanged`
// and `test_a_parenthesised_expression_is_unchanged` pin the two things the seeding must
// NOT touch: a `(` also opens an ordinary parenthesised expression, and clearing the
// expectation there once silently retyped one (a text build became "No matching operator
// '&' on 'text' and 'integer'").  Only a member on the way to a `fn(…)` touches the
// channel at all.
//
// Storage at depth — a nested fn member built, read back and assigned into — is
// `tests/scripts/fn-ref-in-a-nested-tuple.loft`.  This file is the TYPING half: what the
// literal is allowed to say.

fn tlm_named_above(x: integer) -> integer { x * 3 }

fn test_a_short_lambda_flat() {
  t: (fn(integer) -> integer, integer) = (|x| { x * 3 }, 5);
  assert(t.0(t.1) == 15, "a flat short lambda member: got {t.0(t.1)}");
}

fn test_a_short_lambda_in_the_second_position() {
  t: (integer, fn(integer) -> integer) = (5, |x| { x * 3 });
  assert(t.1(t.0) == 15, "a short lambda after a scalar: got {t.1(t.0)}");
}

fn test_a_short_lambda_one_level_in() {
  u: ((fn(integer) -> integer, integer), text) = ((|x| { x * 3 }, 5), "z");
  assert(u.0.0(u.0.1) == 15, "a nested short lambda: got {u.0.0(u.0.1)}");
  assert(u.1 == "z", "the outer member after it: got {u.1}");
}

fn test_a_short_lambda_in_a_nested_second_position() {
  // The nested tuple is itself the second member, and the lambda is second inside it —
  // so neither index is 0 on either level.
  u: (text, (integer, fn(integer) -> integer)) = ("z", (5, |x| { x * 3 }));
  assert(u.1.1(u.1.0) == 15, "a nested short lambda, both indices non-zero: got {u.1.1(u.1.0)}");
  assert(u.0 == "z", "the outer member before it: got {u.0}");
}

fn test_a_short_lambda_two_levels_in() {
  w: (((fn(integer) -> integer, integer), text), integer) = (((|x| { x * 3 }, 5), "z"), 9);
  assert(w.0.0.0(w.0.0.1) == 15, "a short lambda at depth 3: got {w.0.0.0(w.0.0.1)}");
  assert(w.0.1 == "z", "one level out: got {w.0.1}");
  assert(w.1 == 9, "the outermost member: got {w.1}");
}

fn test_two_nested_short_lambdas_stay_distinct() {
  p: ((fn(integer) -> integer, fn(integer) -> integer), integer) =
    ((|x| { x * 3 }, |y| { y + 7 }), 5);
  assert(p.0.0(p.1) == 15, "the first nested lambda: got {p.0.0(p.1)}");
  assert(p.0.1(p.1) == 12, "the second nested lambda: got {p.0.1(p.1)}");
}

fn test_a_nested_capturing_short_lambda() {
  k = 4;
  u: ((fn(integer) -> integer, integer), text) = ((|x| { x * 3 + k }, 5), "z");
  assert(u.0.0(u.0.1) == 19, "a nested capturing short lambda: got {u.0.0(u.0.1)}");
  assert(u.0.0(1) == 7, "the capture survives a second call: got {u.0.0(1)}");
  assert(u.1 == "z", "the outer member after it: got {u.1}");
}

fn test_a_long_form_lambda_one_level_in() {
  // Control for the seeding: a long-form lambda states its own parameter types, so it
  // never needed the hint.  It must keep working through the same path.
  u: ((fn(integer) -> integer, integer), text) = ((fn(x: integer) -> integer { x * 3 }, 5), "z");
  assert(u.0.0(u.0.1) == 15, "a nested long-form lambda: got {u.0.0(u.0.1)}");
  assert(u.1 == "z", "the outer member after it: got {u.1}");
}

fn test_a_named_fn_declared_above_one_level_in() {
  u: ((fn(integer) -> integer, integer), text) = ((tlm_named_above, 5), "z");
  assert(u.0.0(u.0.1) == 15, "a nested named fn: got {u.0.0(u.0.1)}");
  assert(u.1 == "z", "the outer member after it: got {u.1}");
}

fn test_a_forward_referenced_fn_name_flat() {
  t: (fn(integer) -> integer, integer) = (tlm_named_below, 5);
  assert(t.0(t.1) == 15, "a forward-referenced fn in a flat literal: got {t.0(t.1)}");
}

fn test_a_forward_referenced_fn_name_in_the_second_position() {
  t: (integer, fn(integer) -> integer) = (5, tlm_named_below);
  assert(t.1(t.0) == 15, "a forward-referenced fn after a scalar: got {t.1(t.0)}");
}

fn test_a_forward_referenced_fn_name_one_level_in() {
  u: ((fn(integer) -> integer, integer), text) = ((tlm_named_below, 5), "z");
  assert(u.0.0(u.0.1) == 15, "a forward-referenced fn one level in: got {u.0.0(u.0.1)}");
  assert(u.1 == "z", "the outer member after it: got {u.1}");
}

fn test_the_positions_that_always_accepted_a_forward_reference() {
  // The asymmetry the issue was filed on.  These three were never broken, and they are
  // here so a future narrowing of the fix cannot quietly take them with it.
  g: fn(integer) -> integer = tlm_named_below;
  assert(g(5) == 15, "a plain local: got {g(5)}");
  assert(tlm_takes(tlm_named_below, 5) == 15, "a call argument: got {tlm_takes(tlm_named_below, 5)}");
  t: (fn(integer) -> integer, integer) = (tlm_named_above, 5);
  t.0 = tlm_named_below;
  assert(t.0(t.1) == 15, "a member assignment: got {t.0(t.1)}");
}

fn test_a_nested_tuple_with_no_fn_is_unchanged() {
  // Control: the seeding keys on a member that leads to a `fn(…)`, so an ordinary nested
  // tuple must take exactly the path it always did.
  q: ((integer, text), integer) = ((5, "a"), 9);
  assert(q.0.0 == 5, "plain nested integer: got {q.0.0}");
  assert(q.0.1 == "a", "plain nested text: got {q.0.1}");
  assert(q.1 == 9, "plain outer integer: got {q.1}");
}

fn test_a_parenthesised_expression_is_unchanged() {
  // Control: `(` also opens an ordinary parenthesised expression, which INHERITS the
  // ambient expectation.  Touching the channel unconditionally retyped one.
  a = 2;
  b = (a + 3) * 4;
  assert(b == 20, "a parenthesised expression: got {b}");
  s = "n" + "{(a + 3)}";
  assert(s == "n5", "a parenthesised expression inside a format string: got {s}");
}

fn tlm_takes(f: fn(integer) -> integer, n: integer) -> integer { f(n) }

fn tlm_named_below(x: integer) -> integer { x * 3 }

fn main() {
  test_a_short_lambda_flat();
  test_a_short_lambda_in_the_second_position();
  test_a_short_lambda_one_level_in();
  test_a_short_lambda_in_a_nested_second_position();
  test_a_short_lambda_two_levels_in();
  test_two_nested_short_lambdas_stay_distinct();
  test_a_nested_capturing_short_lambda();
  test_a_long_form_lambda_one_level_in();
  test_a_named_fn_declared_above_one_level_in();
  test_a_forward_referenced_fn_name_flat();
  test_a_forward_referenced_fn_name_in_the_second_position();
  test_a_forward_referenced_fn_name_one_level_in();
  test_the_positions_that_always_accepted_a_forward_reference();
  test_a_nested_tuple_with_no_fn_is_unchanged();
  test_a_parenthesised_expression_is_unchanged();
}
