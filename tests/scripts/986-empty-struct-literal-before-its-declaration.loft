//
// loft#986 — `T { }` parses wherever `T` is declared.
//
// An EMPTY struct literal was a parse error when its type was declared BELOW the use:
//
//     fn main() { a = Cfg { }; }        // error: Expect token ;
//     struct Cfg { port: integer }
//
// while `Cfg { port: 0 }` in the same position was fine, and `Cfg { }` was fine with the
// struct declared above. Legality by declaration ORDER, for the spelling a reader reaches
// for first — and the message pointed at the line rather than at the type, so it read as a
// syntax mistake in code that has none.
//
// The cause: a type that pass 1 cannot resolve falls to a fallback that consumes the
// `Name { … }` body, and that fallback recognised a literal by its SHAPE — an identifier
// followed by `:` or `,`. An empty body has no field to shape-check, so it did not match,
// the `{` went unconsumed, and the statement failed. (This is the fourth member of the
// family where a pass-1 fallback accepts fewer spellings than the construct has; the other
// three were named arguments in the method spelling, the shared argument-list skipper, and
// the compound-key index.)
//
// The shape check is what keeps a control-flow body from being read as a literal, and an
// empty body cannot be told from one that way — `if b { }` with an undefined `b` looks
// identical. So the head of an `if` / `while` / `for` sets `in_control_head`, and the
// empty-literal case defers to it. The controls at the bottom are that half: those
// programs are broken either way, and they must keep saying WHICH name is unknown rather
// than reporting a missing block.

fn i986_used(c: I986Cfg) -> integer { c.port }

struct I986Above {
  k: integer,
}

fn main() {
  // The reported case: an empty literal, type declared below.
  a = I986Cfg { };
  assert(a.port == 0, "an empty literal takes the type's defaults: {a.port}");
  assert(a.name == "", "every field, not just the first: '{a.name}'");

  // The same literal with a field named — this always worked, and must keep working.
  b = I986Cfg { port: 8080 };
  assert(b.port == 8080, "a named field still parses below its declaration: {b.port}");

  // A declared DEFAULT is what the empty literal is for.
  d = I986Dflt { };
  assert(d.retries == 3, "an empty literal takes a declared field default: {d.retries}");

  // More than one forward type in a row — the fallback registers a stub per name.
  e = I986Other { };
  assert(e.n == 0, "a second forward empty literal parses too: {e.n}");

  // In an argument position and as a return value, not only as an assignment RHS.
  assert(i986_used(I986Cfg { }) == 0, "as a call argument");
  assert(i986_mk().port == 0, "as a return value: {i986_mk().port}");

  // Nested inside another literal.
  w = I986Wrap { inner: I986Cfg { }, tag: 1 };
  assert(w.inner.port == 0, "nested in another literal: {w.inner.port}");

  // A type declared ABOVE its use — the case that always worked.
  z = I986Above { k: 5 };
  assert(z.k == 5, "a type declared above is unaffected: {z.k}");
  z2 = I986Above { };
  assert(z2.k == 0, "including its empty literal: {z2.k}");

  print("986 empty struct literal OK\n");
}

fn i986_mk() -> I986Cfg { I986Cfg { } }

struct I986Cfg {
  port: integer,
  name: text,
}

struct I986Dflt {
  retries: integer = 3,
}

struct I986Other {
  n: integer,
}

struct I986Wrap {
  inner: I986Cfg,
  tag: integer,
}
