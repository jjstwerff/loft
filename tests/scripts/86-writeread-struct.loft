// @PLN85 p9 regression — write+read struct binary I/O (interp+native parity).
//
// `f += s` then `f#read as S` in one program used to be interp-only broken: the
// write serialised the record's DbRef bytes (not its fields) and the read filled
// the eval stack (not the record), so the reader leaked the record and delivered
// a stale store — right only by coincidence (garbage under LOFT_POISON), wrong
// outright for an inline literal (a3) or a one-field struct (c1). Fixed by
// derefing the slot to the record in both assemble_write_data and
// dispatch_read_data (mirroring the vector arm). Value asserts catch a
// regression; the suite leak-gate catches the record leak.
#cwd
struct P {
  x: integer,
  y: integer,
}
struct One {
  v: integer,
}
struct M {
  a: i32,
  b: i16,
  c: u8,
  d: integer,
}
struct Inner {
  a: integer,
  b: integer,
}
struct Outer {
  tag: u8,
  inner: Inner,
}

fn main() {
  // variable write + read (a1)
  {
    f = file("wr86.bin"); f#format = LittleEndian; f.set_file_size(0); p = P { x: 5, y: 6 }; f += p; f.sync();
  }
  {
    f = file("wr86.bin"); f#format = LittleEndian; q = f#read as P; assert(q.x == 5, "a1 x"); assert(
      q.y == 6,
      "a1 y"
    );
  }

  // inline-literal write + read (a3 — was 16)
  {
    f = file("wr86.bin"); f#format = LittleEndian; f.set_file_size(0); f += P { x: 11, y: 22 }; f.sync();
  }
  {
    f = file("wr86.bin"); f#format = LittleEndian; q = f#read as P; assert(q.x == 11, "a3 x"); assert(
      q.y == 22,
      "a3 y"
    );
  }

  // one-field struct (c1 — was null)
  {
    f = file("wr86.bin"); f#format = LittleEndian; f.set_file_size(0); o = One { v: 42 }; f += o; f.sync();
  }
  {
    f = file("wr86.bin"); f#format = LittleEndian; r = f#read as One; assert(r.v == 42, "c1 v");
  }

  // mixed widths (c2)
  {
    f = file("wr86.bin"); f#format = LittleEndian; f.set_file_size(0); m = M {
      a: 100000,
      b: -3000,
      c: 250,
      d: 9000000000,
    }; f += m; f.sync();
  }
  {
    f = file("wr86.bin"); f#format = LittleEndian; s = f#read as M; assert(s.a == 100000, "c2 a"); assert(
      s.b == -3000,
      "c2 b"
    ); assert(s.c == 250, "c2 c"); assert(s.d == 9000000000, "c2 d");
  }

  // nested (c3)
  {
    f = file("wr86.bin"); f#format = LittleEndian; f.set_file_size(0); w = Outer {
      tag: 9,
      inner: Inner { a: 5, b: 6 },
    }; f += w; f.sync();
  }
  {
    f = file("wr86.bin"); f#format = LittleEndian; u = f#read as Outer; assert(u.tag == 9, "c3 tag"); assert(
      u.inner.a == 5,
      "c3 a"
    ); assert(u.inner.b == 6, "c3 b");
  }

  delete("wr86.bin");
  print("writeread-struct ok\n");
}
