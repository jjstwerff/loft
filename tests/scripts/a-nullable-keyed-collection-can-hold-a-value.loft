//
// A keyed collection declared `?` can be CONSTRUCTED, not merely declared and set to null.
//
// @FR-Col-Cons states empty-literal construction for ALL kinds — `c: <kind><…> = []` — and
// @FR-L-Null states `layout(τ) = layout(τ?)`, so a nullable keyed collection owns the same
// store its dense twin owns and is built the same way.  The code asked "is this keyed?" and
// "which store type does this local need?" through hand-spelled variant lists that matched the
// type BARE, so every one of them answered no for a `τ?` and the type became declarable but not
// constructible: five routes to giving it a value, five different failures.
//
// The cells below are those five routes plus every keyed kind, because the routes fail
// independently — the empty literal ICE'd where the element-bearing one was refused, and the
// two assignment forms failed differently again.  A guard built from one route would have
// locked one of the five.
//
// The cure is three `.base()` peels, one per home that answers a question about the local's
// shape: `vectors::is_keyed` (which of the five kinds is this?), `codegen::gen_keyed_null`
// (which registered store type does the slot get?) and `generation/dispatch`'s allocation
// scrutinee (does this local own a store to allocate?).  They are three because the question is
// asked once per backend plus once in the parser — not because it is three questions.
//
// Axes this file MOVES:   construction route (empty literal / element literal / assign-after-
//                         null / from a dense local / from a call), keyed kind (hash / sorted /
//                         spatial / trie), element count (0 / 1 / 2), and post-construction
//                         append.  Backend is moved by the harness.
// Axes it HOLDS FIXED:    `index<T[k]>?` is deliberately ABSENT — it is refused for an unrelated
//                         reason (its tree bookkeeping lands at offset 0, loft#1125, measured
//                         pre-existing by A/B against a build with these peels reverted), so a
//                         cell here would lock that defect rather than guard this one.
//                         Element type is one struct per kind: sharing one struct across two
//                         keyed kinds gives it conflicting hidden index fields, a different
//                         fault that masks this one.
//
// @falsified-at: e3f78c47 — the EXIT channel, and it moves for a different reason per route:
// `= []` is an ICE (`Incorrect var c[65535]`, the unregistered store type), `= [rec]` is refused
// ("cannot change type from hash<CH,[\"k\"]>? to vector<CH>"), `= a dense local` panics, and
// `= a call` trips `BUG (#306)` on interpret and panics on native.  Because exit says nothing
// about whether the VALUES are asserted, each assertion was also mutated in turn on the fixed
// build (`nk_hash_empty()` to 1, `nk_hash_one()` to 34, `nk_trie()` to 56, `nk_append()` to 3)
// and each fails on the assert channel here.

struct NkH { k: integer = 0, v: integer = 0 }
struct NkO { k: integer = 0, v: integer = 0 }
struct NkP { x: integer = 0, y: integer = 0, v: integer = 0 }
struct NkT { name: text = "", v: integer = 0 }

fn nk_mk() -> hash<NkH[k]> { [NkH { k: 1, v: 11 }] }

// the five construction routes, on one kind
fn nk_hash_empty()  -> integer { c: hash<NkH[k]>? = []; len(c ?? []) }
fn nk_hash_one()    -> integer { c: hash<NkH[k]>? = [NkH { k: 3, v: 33 }]; (c[3] ?? NkH {}).v }
fn nk_assign_after()-> integer { c: hash<NkH[k]>? = null; c = []; len(c ?? []) }
fn nk_from_local()  -> integer { d: hash<NkH[k]> = [NkH { k: 1, v: 11 }]; c: hash<NkH[k]>? = d; len(c ?? []) }
fn nk_from_call()   -> integer { c: hash<NkH[k]>? = nk_mk(); len(c ?? []) }

// every keyed kind holding an element
fn nk_sorted()  -> integer { c: sorted<NkO[k]>? = [NkO { k: 4, v: 44 }]; (c[4] ?? NkO {}).v }
fn nk_spatial() -> integer { c: spatial<NkP[x,y]>? = [NkP { x: 1, y: 1, v: 9 }]; len(c ?? []) }
fn nk_trie()    -> integer { c: trie<NkT[name]>? = [NkT { name: "a", v: 55 }]; (c["a"] ?? NkT {}).v }

// still a collection afterwards
fn nk_append()  -> integer { c: hash<NkH[k]>? = [NkH { k: 1, v: 1 }]; c += [NkH { k: 2, v: 2 }]; len(c ?? []) }
fn nk_append0() -> integer { c: sorted<NkO[k]>? = []; c += [NkO { k: 7, v: 7 }]; len(c ?? []) }

// absence still works — the peels must not have cost the null the type is declared for
fn nk_null()    -> boolean { c: hash<NkH[k]>? = null; c == null }
fn nk_null_tr() -> boolean { c: trie<NkT[name]>? = null; c == null }

// dense twins, so the peels are not scored on the nullable side alone
fn nk_dense()   -> integer { c: hash<NkH[k]> = [NkH { k: 2, v: 22 }]; c[2].v }
fn nk_dense_sp()-> integer { c: spatial<NkP[x,y]> = [NkP { x: 1, y: 1, v: 9 }]; len(c) }

fn main() {
  assert(nk_hash_empty() == 0, "an empty literal into a nullable hash, got {nk_hash_empty()}");
  assert(nk_hash_one() == 33, "an element literal into a nullable hash, got {nk_hash_one()}");
  assert(nk_assign_after() == 0, "assigned after null, got {nk_assign_after()}");
  assert(nk_from_local() == 1, "from a dense local, got {nk_from_local()}");
  assert(nk_from_call() == 1, "from a call returning the dense twin, got {nk_from_call()}");

  assert(nk_sorted() == 44, "a nullable sorted holding an element, got {nk_sorted()}");
  assert(nk_spatial() == 1, "a nullable spatial holding an element, got {nk_spatial()}");
  assert(nk_trie() == 55, "a nullable trie holding an element, got {nk_trie()}");

  assert(nk_append() == 2, "append onto a constructed nullable hash, got {nk_append()}");
  assert(nk_append0() == 1, "append onto an empty nullable sorted, got {nk_append0()}");

  assert(nk_null(), "a nullable hash set to null is still null");
  assert(nk_null_tr(), "a nullable trie set to null is still null");

  assert(nk_dense() == 22, "the dense hash twin is unchanged, got {nk_dense()}");
  assert(nk_dense_sp() == 1, "the dense spatial twin is unchanged, got {nk_dense_sp()}");
}
