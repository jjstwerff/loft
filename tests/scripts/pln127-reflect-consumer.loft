//
// @PLN127 arc E — the dogfood gate: a real consumer written ONLY through the
// reflection API, which is what decides whether the API is sufficient rather
// than merely present.
//
// The consumer is an ORM's schema half: generate `CREATE TABLE` from a loft
// struct. It is the plan's own motivating case, it needs nothing but shapes, and
// the table name arrives as a runtime value — so it exercises `type_named` for
// the reason `type_named` exists rather than as a demonstration.
//
// What it found is recorded at the bottom, because a gate that only passes has
// not been used as a gate.

struct Person { id: integer, name: text?, height: float, active: boolean }
struct Note { id: integer, body: text }

// The SQL type for a loft field. Every branch is decided by `kind` — the
// reflected discriminant — never by parsing `type_name`, which would be a second
// derivation of a fact the API already gives.
fn sql_type(k: TypeKind) -> text {
  if k == IntegerKind { return "BIGINT" }
  if k == TextKind { return "TEXT" }
  if k == FloatKind { return "DOUBLE PRECISION" }
  if k == SingleKind { return "REAL" }
  if k == BooleanKind { return "BOOLEAN" }
  if k == CharacterKind { return "CHAR(1)" }
  return "";
}

// `CREATE TABLE <name> (...)` for the type called `name`, or "" if this program
// has no such type — the absence `type_named` reports rather than invents.
fn create_table(name: text) -> text {
  t = type_named(name);
  if t == null { return "" }
  if t.kind != RecordKind { return "" }
  out = "CREATE TABLE {t.name} (";
  for f in t.fields {
    if f#count > 0 { out += ", " }
    ty = sql_type(f.kind);
    if ty == "" { return "" }          // a kind this generator has no column for
    out += "{f.name} {ty}";
    // @PLN127 arc D — the column constraint the generator could not emit until
    // nullability was reported. A DDL without it is not merely less detailed: it
    // accepts rows the loft type would refuse.
    if !f.nullable { out += " NOT NULL" }
  }
  out += ")";
  return out;
}

fn main() {
  // The whole point: the table name is a RUNTIME value. An ORM reads it from a
  // config file or a catalogue, so there is no value to call `type_of` on.
  wanted = "Person";
  ddl = create_table(wanted);
  assert(ddl == "CREATE TABLE Person (id BIGINT NOT NULL, name TEXT, height DOUBLE PRECISION NOT NULL, active BOOLEAN NOT NULL)",
         "ddl: {ddl}");

  // A second type through the same generic code, so the generator is not one
  // type's shape written out by hand.
  ddl2 = create_table("Note");
  assert(ddl2 == "CREATE TABLE Note (id BIGINT NOT NULL, body TEXT NOT NULL)", "ddl2: {ddl2}");

  // A name this program has no type for is refused, not guessed at.
  assert(create_table("NoSuchTable") == "", "an unknown type has no table");

  // A type that is not a record has no table either — `kind` is what decides,
  // and it is asked before anything that only a record has is read.
  assert(create_table("text") == "", "a scalar is not a table");

  // The field ORDER is the declared order, which a migration depends on: a
  // generator that sorted or hashed would produce a different table for the
  // same struct on a different day.
  t = type_named("Person");
  if t == null { assert(false, "Person must exist") } else {
    f0 = t.fields[0] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind };
    f3 = t.fields[3] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind };
    assert(f0.name == "id" && f3.name == "active", "declared order: {f0.name}..{f3.name}");
    // Offsets ascend with the declaration, which is what makes them usable as a
    // layout check rather than only as documentation.
    assert(f0.position < f3.position, "offsets ascend");
  }

  println("reflect consumer ok");
}

// --- What the gate found ------------------------------------------------------
//
// Written first, this generator was complete and correct and could NOT emit
// `NOT NULL` — and a DDL without it is not merely less detailed, it accepts rows
// the loft type would refuse. That is what made @PLN127 arc D concrete rather
// than theoretical, and arc D was then built: nullability is deposited by the
// parser, replayed by the native generator, carried by the descriptor WITHOUT
// being rendered, and read back here. `name: text?` is the cell that proves it —
// every other column carries the constraint and that one does not.
//
// `const` is deliberately still absent. It constrains loft CODE, not the data,
// so an ORM has no use for it, and admitting it would make reflection a mirror of
// the source text rather than of what a value can be.
//
// The remaining limit, and the reason this consumer is a schema generator rather
// than the plan's "generic serialiser": reflection describes a TYPE, and there is
// no way to read a VALUE's field by name. A serialiser needs both. That is the
// write-access question the plan already deferred, arriving from the read side.
