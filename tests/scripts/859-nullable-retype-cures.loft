// Every cure `859-nullable-retype-advice.loft`'s message names must compile and run.
//
// A diagnostic that prescribes a fix is only as good as the fix, and the reason
// loft#859 was worth filing is that the previous message named two that do not work.
// So the three this one names — `?`, `?? <default>`, and declaring the variable `τ?` —
// each get a cell here, on both `float` and `integer`, and each cell asserts the VALUE
// rather than merely compiling: a cure that parses but computes something else would
// send the next reader back around the same loop.

fn cure_default(x: float) -> float {
  g = x / 2.0;
  g = (x / g)?;                 // `?` — the type's default when null
  g
}

fn cure_coalesce(x: float) -> float {
  g = x / 2.0;
  g = x / g ?? 0.0;             // `?? <default>` — an explicit fallback
  g
}

fn cure_declare(x: float) -> float? {
  g: float? = x / 2.0;          // widen the variable instead of the value
  g = x / g;
  g
}

fn int_default(x: integer) -> integer {
  g = x / 2;
  g = (x / g)?;
  g
}

fn int_modulo(x: integer) -> integer {
  g = x / 2;
  g = (x % g)?;                 // `%` widens exactly like `/`
  g
}

fn main() {
  // 2.0 / 2.0 = 1.0, then 2.0 / 1.0 = 2.0 — no null on this path, so all three
  // cures must agree on the same answer.
  assert(cure_default(2.0) == 2.0, "`?` cure: {cure_default(2.0)}");
  assert(cure_coalesce(2.0) == 2.0, "`??` cure: {cure_coalesce(2.0)}");
  assert((cure_declare(2.0) ?? -1.0) == 2.0, "declared-nullable cure: {cure_declare(2.0) ?? -1.0}");

  // 8 / 2 = 4, then 8 / 4 = 2.
  assert(int_default(8) == 2, "integer `?` cure: {int_default(8)}");
  // 9 / 2 = 4, then 9 % 4 = 1.
  assert(int_modulo(9) == 1, "integer `%` cure: {int_modulo(9)}");

  // And the null path the refusal exists to protect: a zero divisor discharges to the
  // default rather than storing null into a non-null slot.
  z = 0;
  assert((10 / z)? == 0, "`?` on a zero divisor gives the type default");
  assert((10 / z ?? -5) == -5, "`??` on a zero divisor gives the stated fallback");

  // CONTROLS — the operators and operand shapes that never widen, so these stores are
  // plain non-null assignments and must keep compiling untouched.
  a = 3.0;
  a = a / 2.0;                  // literal divisor: not nullable
  assert(a == 1.5, "a literal divisor never widens: {a}");
  b = 3.0;
  b = b * b;                    // multiplication never widens
  assert(b == 9.0, "multiplication never widens: {b}");
  c = 3.0;
  c = c + c;
  assert(c == 6.0, "addition never widens: {c}");
}
