//
// @PLAN37 phase 10.13 — `s[i] ?? '<char>'` chain-compare must
// type-check under --native.  Pre-fix the OpConvIntFromCharacter
// template emitted `_v_v1 == char::from(0)` against an `i32`
// `_v_v1` (block result was emitted as `i32` even though loft
// types it `Character`) → rustc E0308.  Fix: wrap a
// Block-returning-Character argument with `ops::to_char()`,
// same as Var/Call/TupleGet character receivers already do.
// @P276.

fn test_basic_eq() {
  s = "abc";
  i = 0;
  assert((s[i] ?? ' ') == 'a', "[0] == 'a'");
}

fn test_oob_falls_to_default() {
  s = "abc";
  assert((s[10] ?? ' ') == ' ', "OOB falls to ' '");
}

fn test_bind_then_compare() {
  s = "abc";
  i = 1;
  c = s[i] ?? '*';
  assert(c == 'b', "bound c == 'b'");
}

fn test_chain_else_if() {
  s = "abc";
  j = 2;
  label = "";
  if(s[j] ?? '?') == 'a' { label = "a"; } else if(s[j] ?? '?') == 'c' { label = "c"; }
  assert(label == "c", "chain picks 'c'");
}

fn test_lt_compare() {
  s = "abc";
  assert((s[0] ?? '\0') < 'z', "'a' < 'z'");
}

fn main() {
  test_basic_eq();
  test_oob_falls_to_default();
  test_bind_then_compare();
  test_chain_else_if();
  test_lt_compare();
  println("null-coalesce-char: ok");
}
