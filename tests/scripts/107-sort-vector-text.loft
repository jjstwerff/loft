//
// @PLAN37 phase 10.8 — sort() now accepts vector<text> via
// `vector::sort_text_vector` in src/vector.rs.  Pre-fix only
// integer / float / single were supported; text required
// rolling your own insertion sort or wrapping in a
// sorted<TagSlot[name]>.

fn test_basic_text_sort() {
  v: vector<text> = ["banana", "apple", "cherry"];
  sort(v);
  assert(v[0] == "apple", "[0]");
  assert(v[1] == "banana", "[1]");
  assert(v[2] == "cherry", "[2]");
}

fn test_already_sorted() {
  v: vector<text> = ["a", "b", "c"];
  sort(v);
  assert(v[0] == "a" && v[1] == "b" && v[2] == "c", "stable on sorted input");
}

fn test_reverse_sorted() {
  v: vector<text> = ["c", "b", "a"];
  sort(v);
  assert(v[0] == "a" && v[1] == "b" && v[2] == "c", "reverses worst case");
}

fn test_duplicates() {
  v: vector<text> = ["b", "a", "a", "b"];
  sort(v);
  assert(v[0] == "a", "dup [0]");
  assert(v[1] == "a", "dup [1]");
  assert(v[2] == "b", "dup [2]");
  assert(v[3] == "b", "dup [3]");
}

fn test_empty() {
  v: vector<text> = [];
  sort(v);
  assert(v.len() == 0, "empty stays empty");
}

fn test_single_element() {
  v: vector<text> = ["only"];
  sort(v);
  assert(v.len() == 1, "single stays single");
  assert(v[0] == "only", "single value preserved");
}

fn test_lexicographic_unicode() {
  // Unicode codepoints sort by UTF-8 byte ordering; for BMP
  // chars this matches codepoint order.
  v: vector<text> = ["b", "a", "z"];
  sort(v);
  assert(v[0] == "a" && v[1] == "b" && v[2] == "z", "ascii sort");
}

fn test_mixed_lengths() {
  v: vector<text> = ["aaa", "a", "ab", "aa"];
  sort(v);
  // Lexicographic: "a" < "aa" < "aaa" < "ab"
  assert(v[0] == "a", "[0]=a");
  assert(v[1] == "aa", "[1]=aa");
  assert(v[2] == "aaa", "[2]=aaa");
  assert(v[3] == "ab", "[3]=ab");
}

fn test_int_sort_still_works() {
  // Regression guard — phase 10.8 added text dispatch but
  // primitive paths must still work.
  v = [3, 1, 4, 1, 5, 9, 2, 6];
  sort(v);
  assert(v[0] == 1 && v[1] == 1, "leading 1s");
  assert(v[7] == 9, "trailing 9");
}

fn main() {
  test_basic_text_sort();
  test_already_sorted();
  test_reverse_sorted();
  test_duplicates();
  test_empty();
  test_single_element();
  test_lexicographic_unicode();
  test_mixed_lengths();
  test_int_sort_still_works();
  println("sort-vector-text: ok");
}
