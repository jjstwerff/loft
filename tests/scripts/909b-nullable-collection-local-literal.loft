// @TITLE: an empty collection literal initialises a nullable LOCAL
// @EXPECT_WARNING: of the non-null type `vector`
//
// The loft#909 shape from the other side.  There a nullable FIELD given a NON-empty
// literal aborted the compiler; here a nullable LOCAL given an EMPTY one did, with the
// same message (*"Incorrect var v[65535]"*) and for the same reason — an `Optional`
// selector that never peeled.
//
// Whether the target needs a record-pointer BACKING is a question about its storage, and
// `Optional(τ)` shares τ's storage exactly, so `create_vector` matching `Type::Vector`
// unpeeled did not recognise a `vector<T>?` local as one.  A NON-empty literal was
// rescued by its elements, whose own `build_vector_list` allocates the backing; `[]` has
// no element to do it, so nothing ever defined the variable and it reached codegen with
// no stack slot at all.
//
// The two halves swap between the field and the local case, which is why each of them
// shipped with the other's shape working.

fn empty_local() -> integer {
    v: vector<integer>? = [];
    len(v)
}

fn empty_then_append() -> text {
    v: vector<integer>? = [];
    v += [5];
    v += [7];
    "{len(v)}:{v[0]}:{v[1]}"
}

fn nonempty_local() -> integer {
    v: vector<integer>? = [1, 2, 3];
    len(v)
}

fn empty_text_local() -> integer {
    v: vector<text>? = [];
    v += ["a"];
    len(v)
}

struct Nine09 { a: integer }

fn empty_struct_local() -> text {
    v: vector<Nine09>? = [];
    v += [Nine09 { a: 4 }];
    "{len(v)}:{v[0].a}"
}

fn empty_nested_local() -> integer {
    v: vector<vector<integer>>? = [];
    len(v)
}

fn reassign_empty_over_full() -> integer {
    v: vector<integer>? = [1, 2];
    v = [];
    len(v)
}

// A local already tells `[]` and `null` apart — an empty one owns a backing record while
// an absent one is the DbRef sentinel.  That is the read loft#917 wants for a FIELD, and
// it is pinned here so the local half cannot regress while that is decided.
fn empty_is_not_null() -> boolean {
    v: vector<integer>? = [];
    v == null
}

fn null_is_null() -> boolean {
    v: vector<integer>? = null;
    v == null
}

// The non-nullable twin of every cell above, so a fix that reaches only the `?` form
// cannot pass by breaking the plain one.
fn non_null_control() -> text {
    v: vector<integer> = [];
    v += [8];
    "{len(v)}:{v[0]}"
}

fn main() {
    a = empty_local();
    assert(a == 0, "empty_local {a}");
    b = empty_then_append();
    assert(b == "2:5:7", "empty_then_append {b}");
    c = nonempty_local();
    assert(c == 3, "nonempty_local {c}");
    d = empty_text_local();
    assert(d == 1, "empty_text_local {d}");
    e = empty_struct_local();
    assert(e == "1:4", "empty_struct_local {e}");
    f = empty_nested_local();
    assert(f == 0, "empty_nested_local {f}");
    g = reassign_empty_over_full();
    assert(g == 0, "reassign_empty_over_full {g}");
    h = empty_is_not_null();
    assert(!h, "an empty vector is not null, got {h}");
    i = null_is_null();
    assert(i, "a null vector is null, got {i}");
    j = non_null_control();
    assert(j == "1:8", "non_null_control {j}");
}
