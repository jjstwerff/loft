//
// loft#744, the other side of the boundary. Refusing a constant whose
// initialiser needs a frame slot only counts as a fix if the constants that
// carry no slot keep working — otherwise the crash was traded for a removed
// feature, and the reporter's actual ask ("derive a constant from the one list
// that is the authority") would still be unavailable.
//
// `const N = count();` is exactly that ask, and it is the cell that must stay
// green: a scalar-returning call carries no temporary, so its IR holds no
// numbering to mis-paste.
//
// Each cell is a DIFFERENT reason a constant carries no slot, so a fix that
// narrowed to "no calls at all" would fail here too.

struct S { s_r: float }

fn items() -> vector<S> { [S { s_r: 0.3 }] }
fn count() -> integer { return len(items()); }
fn scale() -> float { return 2.5; }
fn label() -> text { return "lbl"; }

// The reporter's shape: one list is the authority, a constant derives from it.
const N = count();
// A float-returning call.
const F = scale();
// A text-returning call — the carrier that already had its own rebind, so this
// pins that the new refusal did not swallow it.
const L = label();
// Arithmetic over a call result: still no temporary of its own.
const N2 = count() * 2;
// A plain literal, the simplest cell.
const Z = 7;
// A vector constant — the other carrier with its own path (`OpConstRef`).
const V = [1, 2, 3];

fn main() {
  assert(N == 1, "a scalar call in a constant still evaluates");
  assert(F == 2.5, "a float call in a constant still evaluates");
  assert(L == "lbl", "a text call keeps its own rebind path");
  assert(N2 == 2, "arithmetic over a call result still evaluates");
  assert(Z == 7, "a literal constant is unaffected");
  assert(len(V) == 3, "a vector constant keeps its OpConstRef path");

  // Referenced TWICE: a constant is re-evaluated per reference, so the second
  // read exercises the paste a second time.
  assert(N + N == 2, "a constant pasted twice is still correct");

  println("const slot-free initialisers ok");
}
