//
// @PLN85 / D-own — regression guard for #457 (graduated from
// probes/457-adopt-free-min.loft).  A returned `vector<text>` local `out` is
// reassigned to a recursive return in BOTH if/else arms, then `out += [..]`,
// then `return out`.  Before the fix the callee freed BOTH per-arm NRVO buffers
// (`__ref_1`, `__ref_2`) UNCONDITIONALLY at exit — including the one `out`
// adopted and returned — so the caller's `p` held a freed store; a later
// `vector<u8>` build (`mleaf`: `b = [0]; b += b2b(x)` → len 2) reused the freed
// slot and `len(p)` read 2 (wrong result), or SIGSEGV'd non-deterministically.
//
// The fix extends the adopt/free witness-pairing (Reference/Enum) to vector
// adopters: the buffer's exit free becomes `OpFreeRefIfDistinct(__ref_N, out)`
// (no-op when `out` adopted it), and a non-return-source adopter's own store is
// freed by an explicit `OpFreeRef`.  Asserts the VALUE (length) — a leak-only
// check would miss the double-append; both backends must read len == 1.
fn b2b(s: text) -> vector<u8> {
  r: vector<u8> = []; for c in s { r += [1]; } return r;
}
fn mleaf(x: text) -> text {
  b: vector<u8> = [0]; b += b2b(x); return "h";
}
fn path(m: integer, lo: integer, hi: integer) -> vector<text> {
  out: vector<text> = []; n = hi - lo;
  if n <= 1 { return out; }
  k = 1;
  if m < k {
    out = path(m, lo, lo + k); out += [mleaf("a")];
  }
  else {
    out = path(m - k, lo + k, hi); out += [mleaf("b")];
  }
  return out;
}
fn main() {
  p = path(0, 0, 2);
  r = mleaf("e");
  assert(len(p) == 1, "len corrupted: {len(p)} (want 1) — #457");
  println("457 ok len={len(p)}");
}
