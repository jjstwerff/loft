//
// A tuple RETURN naming a type declared lower in the file is refused, by name, with the
// cure — not with an internal compiler error, and not silently (loft#944).
//
// It is the one shape of forward-reference-inside-a-tuple that does not work; every other
// one is exercised in `944-forward-reference-inside-a-tuple.loft`. The refusal exists
// because removing the ICE without it left something worse: the body compiled, ran on the
// interpreter, and read its first member back as 0 on `--native`.

// @EXPECT_ERROR: returns a tuple containing `Q944b`, which is declared later in the file
fn r944b_ret() -> (integer, Q944b) { (71, Q944b { n: 82 }) }

fn main() {
  t = r944b_ret();
  println("{t.0}");
}

struct Q944b { n: integer }
