// @PLN85 / #462 — a dense Reference local OWNED-initialized, then CONDITIONALLY
// reassigned with a nullable-element unwrap view, then RETURNED.
//
//   chosen = m_none();                       // owned
//   if np > 0 { chosen = pool[i] ?? m_none(); }  // nullable-unwrap of a LOCAL pool
//   chosen                                   // returned
//
// `chosen = pool[i] ?? m_none()` unwrapped to a payload sub-ref (OpGetField) — a
// VIEW into the local `pool`. Returned, the view dangled when `pool` was freed at
// exit; the caller's bind-copy then read a freed store (the crawler #462 SIGSEGV at
// slot-reuse scale: mon_one → mon_choose). Fix: the nullable→dense reassign of an
// OWNING Reference local now deep-COPIES the unwrapped payload into an owned store,
// so `chosen` stays owned (the #316 pre-Set free still fires — see
// 151-i316-ownership-transition-free.loft) AND owns an independent copy (no dangling
// view). Drives the same shape under allocation pressure that recycles a wrongly
// freed slot, asserting both the subject table and the returned value stay intact.

struct M {
  hp: integer,
  depth: integer,
  name: text,
}

fn m_none() -> M {
  M { hp: 0, depth: 0, name: "" }
}

fn pool_of(t: vector<M>) -> vector<M> {
  out: vector<M> = [];
  for i in 0..len(t) { out += [t[i] ?? m_none()]; }
  out
}

fn one(t: vector<M>, salt: integer) -> M {
  pool = pool_of(t); // a LOCAL vector, freed at fn exit
  chosen = m_none(); // owned-init
  np = len(pool);
  if np > 0 {
    chosen = pool[salt % np ?? 0] ?? m_none(); // nullable-unwrap view of the local
  }
  chosen// returned — must be an owned copy, not a dangling view
}

fn choose(t: vector<M>, salt: integer) -> M {
  best = m_none();
  bestdepth = -1;
  d = 0;
  while d < 3 {
    cand = one(t, salt * 131 + d * 17);
    if cand.depth > bestdepth {
      bestdepth = cand.depth; best = cand;
    }
    d += 1;
  }
  best
}

fn filler(n: integer) -> integer {
  es: vector<M> = [];
  for j in 0..n { es += [
    M { hp: j, depth: j, name: "RECYCLE-{j}" },
  ]; }
  return len(es);
}

fn main() {
  t: vector<M> = [];
  for k in 0..8 { t += [
    M { hp: k, depth: k, name: "mon{k}" },
  ]; }
  for i in 0..24 {
    r = choose(t, i);
    acc = 0;
    for f in 0..8 { acc += filler(8); } // recycle any wrongly-freed slot
    assert(len(t) == 8, "iter {i}: len(t)={len(t)} (subject intact, no over-free)");
    assert(r.depth >= 0 && r.depth < 8, "iter {i}: r.depth={r.depth} (returned value not corrupt)");
    e3 = t[3] ?? m_none();
    assert(e3.depth == 3, "iter {i}: t[3] intact, depth={e3.depth}");
  }
  println("nullable-unwrap-reassign-overfree ok");
}
