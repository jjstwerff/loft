//
// Regression: `r = f(r, …)` on a runtime-Join local passed the callee a NULL
// store (zero-trust `client/ztedit`).
//
// A "runtime-Join" local — one with an owned init AND a borrow reassign — is
// emitted through the owned-store tracker (`_own_store_<name>`, @PLN90 #495).
// Its owned-reassign branch freed the tracked store and set
// `var_r.store_nr = u16::MAX` BEFORE emitting the value.  When the value is
// computed FROM `r`, the callee therefore received the null sentinel and
// indexed `stores[65535]`:
//
//     thread 'main' panicked at src/database/allocation.rs:980:34:
//     index out of bounds: the len is 20 but the index is 65535
//
// Native only — the interpreter has no such prelude and was always correct.
//
// Two things made this expensive to see, and both are why the matrix below is
// wider than the one failing line.  The identical statement is FINE in a
// function whose `r` is not a Join local, so it looked like the same call site
// worked in one place and not another.  And what makes `r` a Join local is
// another assignment ELSEWHERE in the same body — so adding an unrelated
// statement could turn a working function into a crashing one, which reads as
// the fault scaling with code volume rather than as a shape.

struct Doc { buf: vector<integer>, n: integer }
struct Ed { doc: Doc, caret: integer, undo: vector<integer>, clip: text }

fn mk(n: integer) -> Ed {
  b: vector<integer> = [];
  for i in 0..n { b += [i]; }
  return Ed { doc: Doc { buf: b, n: n }, caret: 0, undo: [], clip: "" };
}

// Owned: builds a fresh Ed from the old one — the self-feeding shape.
fn set_caret(e: Ed, a: integer) -> Ed {
  return Ed { doc: e.doc, caret: a, undo: e.undo, clip: e.clip };
}

// Borrow: returns its argument unchanged.  Its presence is what makes the
// local a runtime-Join local and routes the assignments through the tracker.
fn keep(e: Ed) -> Ed { return e; }

fn test_self_feeding_owned_reassign() {
  ed = mk(3);
  ed = set_caret(ed, 2);   // ← crashed here: `ed` was freed + nulled first
  ed = keep(ed);           // the borrow reassign that makes `ed` a Join local
  assert(ed.caret == 2, "caret={ed.caret} expect 2");
  assert(ed.doc.n == 3, "doc.n={ed.doc.n} expect 3 — the doc must survive the reassign");
  assert(len(ed.doc.buf) == 3, "buf len={len(ed.doc.buf)} expect 3");
}

// Repeated self-feeding: each reassign must read the value the previous one
// produced, so a store freed one step too early shows as a wrong caret.
fn test_repeated_self_feeding() {
  ed = mk(4);
  ed = set_caret(ed, 1);
  ed = set_caret(ed, 2);
  ed = set_caret(ed, 3);
  ed = keep(ed);
  assert(ed.caret == 3, "caret={ed.caret} expect 3");
  assert(ed.doc.n == 4, "doc.n={ed.doc.n} expect 4 — carried through three reassigns");
}

// A Join local reassigned from a value that does NOT read it keeps the old
// emission: the displaced store is freed, and nothing may read it after.
fn test_owned_reassign_not_self_feeding() {
  ed = mk(2);
  assert(ed.doc.n == 2, "first doc.n={ed.doc.n} expect 2");
  ed = mk(5);
  ed = keep(ed);
  assert(ed.doc.n == 5, "doc.n={ed.doc.n} expect 5");
  assert(len(ed.doc.buf) == 5, "buf len={len(ed.doc.buf)} expect 5");
}

// The control: the same statement in a body with no borrow reassign is NOT a
// Join local, took the plain path, and was always correct.  It must stay so.
fn test_plain_local_same_statement() {
  ed = mk(3);
  ed = set_caret(ed, 2);
  assert(ed.caret == 2, "plain caret={ed.caret} expect 2");
  assert(ed.doc.n == 3, "plain doc.n={ed.doc.n} expect 3");
}

fn main() {
  test_self_feeding_owned_reassign();
  test_repeated_self_feeding();
  test_owned_reassign_not_self_feeding();
  test_plain_local_same_statement();
  println("join-own-self-feeding-call ok");
}
