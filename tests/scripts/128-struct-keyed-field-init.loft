//
// @P308 — a keyed-collection HASH field initialised from an EXPRESSION in a
// struct literal (`F{ h: build() }` / `F{ h: c }`), and whole-field
// assignment `s.h = expr`, must DEEP-COPY the source into the field.  Before
// the fix the value was dropped (field silently empty, `len == 0`) and a
// call source leaked its return store.  Fixed by emitting `OpReplaceKeyed`
// against the field ref at both sites (constructor `handle_field`,
// assignment `towards_set`), mirroring the keyed-LOCAL deep-copy path.
// HASH only — sorted/index struct-field deep-copy is tracked as @P309
// (a content-struct-mutation hang); not exercised here.

struct Ent { ck: integer, v: integer }
struct F { h: hash<Ent[ck]> }

fn mk() -> hash<Ent[ck]> {
  r: hash<Ent[ck]> = [];
  r += [Ent{ck: 1, v: 10}];
  r += [Ent{ck: 2, v: 20}];
  r
}

fn main() {
  // (a) constructor from a CALL — deep-copied, not empty; no leak
  f = F{ h: mk() };
  assert(len(f.h) == 2, "ctor from call: populated");
  assert(f.h[1].v == 10, "ctor from call: value 1");
  assert(f.h[2].v == 20, "ctor from call: value 2");

  // (b) constructor from a LOCAL hash — deep-copied
  c: hash<Ent[ck]> = [];
  c += [Ent{ck: 7, v: 70}];
  g = F{ h: c };
  assert(len(g.h) == 1, "ctor from local: populated");
  assert(g.h[7].v == 70, "ctor from local: value");

  // (c) deep copy is INDEPENDENT — mutating the source doesn't touch the field
  c += [Ent{ck: 8, v: 80}];
  assert(len(c) == 2, "source grew");
  assert(len(g.h) == 1, "field unchanged by source mutation (deep copy)");

  // (d) whole-field assignment `s.h = expr`
  g.h = mk();
  assert(len(g.h) == 2, "field assign from call: populated");
  assert(g.h[2].v == 20, "field assign value");
  g.h = c;
  assert(len(g.h) == 2, "field assign from local: populated");
  assert(g.h[8].v == 80, "field assign from local: value");

  // (e) empty-literal init still yields an empty field (then += works)
  e = F{ h: [] };
  assert(len(e.h) == 0, "empty-init field empty");
  e.h += [Ent{ck: 9, v: 90}];
  assert(len(e.h) == 1, "append after empty-init works");

  print("p308 ok\n");
}
