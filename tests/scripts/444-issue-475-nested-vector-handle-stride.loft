//
// Issue #475 — a nested-vector element (`vector<vector<T>>`) is a 4-byte rec-id
// HANDLE, but three emit sites strided it by the INNER scalar size instead:
// index (`parser/fields.rs`), iteration (`parser/collections.rs`), and local
// construction (`parser/vectors.rs`).  For an 8-byte inner (`integer`/`float`)
// the index/iteration walked off the stride-4 storage once the outer vector
// grew — silent data loss / wrong iteration, then a SIGSEGV at larger sizes.
// Small sizes and a `boolean` inner (which the old `< 4` guard already fixed on
// the construction side) hid it.  Fixed by striding every nested-vector element
// access by the handle (4).  These build past the old break point and exercise
// struct/local × inner width × iteration × nesting × mixed fields.

fn test_local_append_read_len() {
  n = 300;
  adj: vector<vector<integer>> = [];
  for i in 0..n { r: vector<integer> = []; adj += [r]; }
  for j in 0..n { adj[j] += [j * 2]; }
  total = 0;
  for j in 0..n {
    assert(len(adj[j]) == 1, "row {j} holds exactly its one append");
    assert(adj[j][0] == j * 2, "row {j} holds its OWN value, not a neighbour's");
    total += adj[j][0];
  }
  assert(total == n * (n - 1), "sum of 0,2,..,2(n-1)");
}

fn test_local_iteration() {
  n = 300;
  adj: vector<vector<integer>> = [];
  for i in 0..n { r: vector<integer> = []; adj += [r]; }
  for j in 0..n { adj[j] += [j]; adj[j] += [j + 1]; }
  // iteration strided by a wrapper size (16) pre-fix — read every other element.
  s = 0;
  for row in adj { for v in row { s += v; } }
  assert(s == n * n, "sum of (j)+(j+1) over 0..n = n*n");
}

// The reporter's exact shape: struct with a hash field beside the nested vector,
// mutated through a `&` reference parameter.
struct Ent { coord: text not null, idx: integer not null }
struct G { m: hash<Ent[coord]>, adj: vector<vector<integer>> }
fn add(g: &G, i: integer, x: integer) { g.adj[i] += [x]; }

fn test_struct_ref_with_hash() {
  n = 300;
  g = G { m: [], adj: [] };
  for i in 0..n { g.m += [Ent { coord: "n{i}", idx: i }]; r: vector<integer> = []; g.adj += [r]; }
  for j in 0..n { add(g, j, j); }
  t = 0;
  for j in 0..n { assert(len(g.adj[j]) == 1, "row {j} one element"); t += g.adj[j][0]; }
  assert(t == n * (n - 1) / 2, "sum 0..n-1");
}

// A vector-typed element is a 4-byte handle whatever the inner width — lock
// inner>4 (float, 8 bytes; the old fix only covered inner<4 booleans).
fn test_inner_widths() {
  bs: vector<vector<boolean>> = [];
  fs: vector<vector<float>> = [];
  for i in 0..200 { b: vector<boolean> = []; bs += [b]; f: vector<float> = []; fs += [f]; }
  for j in 0..200 { bs[j] += [true]; fs[j] += [j as float]; }
  tb = 0;
  fsum = 0.0;
  for j in 0..200 {
    assert(len(bs[j]) == 1 && bs[j][0], "boolean row {j}");
    tb += 1;
    fsum += fs[j][0];
  }
  assert(tb == 200, "all boolean rows");
  assert(fsum == 19900.0, "float rows sum 0..199");
}

fn test_double_index_and_empty_rows() {
  n = 200;
  adj: vector<vector<integer>> = [];
  for i in 0..n { r: vector<integer> = []; adj += [r]; }
  for j in 0..n { if j % 2 == 0 { adj[j] += [j]; adj[j] += [j + 1]; } }  // only even rows
  filled = 0;
  s = 0;
  for j in 0..n {
    if j % 2 == 0 {
      assert(len(adj[j]) == 2, "even row {j} has both appends");
      s += adj[j][0] + adj[j][1];
      filled += 1;
    } else {
      assert(len(adj[j]) == 0, "odd row {j} stayed empty");
    }
  }
  assert(filled == 100, "100 filled rows");
}

fn test_triple_nesting() {
  n = 50;
  a: vector<vector<vector<integer>>> = [];
  for i in 0..n { r: vector<vector<integer>> = []; a += [r]; }
  for j in 0..n { inner: vector<integer> = [j, j + 1]; a[j] += [inner]; }
  t = 0;
  for j in 0..n {
    assert(len(a[j]) == 1, "outer row {j}");
    assert(len(a[j][0]) == 2 && a[j][0][0] == j, "inner-inner values row {j}");
    t += 1;
  }
  assert(t == n, "all triple rows");
}
