//
// @PLAN37 phase 10.10b — format-string interpolation of a
// self-slice-reassigned text PARAMETER must work on both
// backends.  Pre-fix:
//   * Interp SIGSEGV at op=116 (`OpAppendText` reading a
//     `RefVar(Text)` work-buffer slot as a local `String`).
//   * Native rustc E0368 (`var___work_N += &*(...)` where the
//     work-buffer is `&mut String`).
// Fix: codegen rewrites `OpAppendText` / `OpClearText` /
// `OpFormatText` / `OpFormat{Int,Float,Single,Database}` /
// `OpAppendCharacter` to their `Stack` variants when the
// destination is a `RefVar(Text)` work-buffer arg promoted
// by `text_return`.  Mirrored in both `src/state/codegen.rs`
// (bytecode dispatch for interp) and
// `src/generation/dispatch.rs` (native emit dispatch).
// @P283.

fn render(rb: text, id: text) -> text {
    full_pref = "**@P" + id + "** — ";
    plen = full_pref.len();
    olen = rb.len();
    if rb.starts_with(full_pref) {
        rb = rb[plen..olen];
    }
    "[{id}] {rb}"
}

fn test_with_prefix() {
    out = render("**@P259** — body text", "259");
    assert(out == "[259] body text", "prefix stripped + formatted");
}

fn test_without_prefix() {
    out = render("plain body", "300");
    assert(out == "[300] plain body", "no slice, just format");
}

fn test_two_calls_same_buffer() {
    a = render("**@P1** — first", "1");
    b = render("**@P22** — second body", "22");
    assert(a == "[1] first", "a survives second call");
    assert(b == "[22] second body", "b correct");
}

fn main() {
    test_with_prefix();
    test_without_prefix();
    test_two_calls_same_buffer();
    println("format-string-self-slice: ok");
}
