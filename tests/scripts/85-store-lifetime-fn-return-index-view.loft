//
// @PLN85 / #426B — regression guard: a fn returning a vector INDEX of its
// argument (`fn idx0(w) -> vector { w[0] }`) returns a VIEW that borrows the
// argument's backing store.  Binding it (`b = idx0(ww)`) makes `b` a view-of-a-
// view: `b` deps `ww`, and `ww` deps its `__vdb` store.  The reclaim pass'
// holder model only walked ONE dep hop, so it never saw `b` holding `ww`'s
// store and freed that store right after the call — before `b`'s last read.  The
// freed slot was then recycled into the next allocation, corrupting `b`
// (store-reuse-after-free: `b` read back as []).  Fix: `reclaim_safe` walks the
// TRANSITIVE dep closure (scopes.rs), so the borrowed source store keeps its
// scope-exit free instead of an early reclaim.
//
// RED before the fix on BOTH backends: `b` reads back as [] once any later
// allocation recycles the prematurely-freed source store.  Guards value + no leak.

struct Box { v: vector<integer> }

fn idx0(w: vector<vector<integer>>) -> vector<integer> { w[0] }

fn main() {
  // The view-from-fn-return must survive a following allocation (a fresh local
  // vector) that would recycle the prematurely-freed source store.
  ww: vector<vector<integer>> = [[11, 22, 33]];
  b = idx0(ww);
  d: vector<integer> = [4, 5, 6];
  assert(len(b) == 3, "b = idx0(ww) view must survive a later alloc (len 3)");
  assert(b[0] == 11, "b[0] must stay 11");
  assert(b[2] == 33, "b[2] must stay 33");
  assert(len(d) == 3, "control d unaffected");

  // The same view followed by a #415 borrowing-read COPY (which frees a store
  // the freelist recycles) must stay intact, and the copy stays an owned copy.
  ww2: vector<vector<integer>> = [[44, 55, 66]];
  b2 = idx0(ww2);
  by = Box { v: [7, 8, 9] };
  c = by.v;                 // #415 borrowing-read copy — frees by's store
  assert(len(b2) == 3, "b2 view must survive the by.v copy (len 3)");
  assert(b2[1] == 55, "b2[1] must stay 55");
  assert(len(c) == 3, "c = by.v must be an owned copy (len 3)");
}
