// P265 minimal reproducer — fn-ref dispatcher emit site bound the
// hoisted `_farg_N` locals to whatever the arg expression returned
// (often `Str` for text-returning user-fn calls), then dispatched
// through `match var_callback.0 { … => candidate(cell, _farg_0) }`
// to candidates expecting `&str`.  rustc rejected with E0308
// ("expected `&str`, found `Str`") in every match arm.  Same root
// cause as P262 (Str→&str mismatch) but a DIFFERENT emit site:
// P262 patched the direct-call arg path in
// `src/generation/calls.rs::user_fn_call_body`; P265 patches the
// fn-ref dispatcher in `src/generation/emit.rs::output_call_ref`.
// CLOSED 2026-05-13 by binding text-typed `_farg_N` via a holder +
// `&*` deref: `let _farg_N_h = expr; let _farg_N: &str = &*_farg_N_h;`
// so the per-arm calls pass a `&str` regardless of whether `expr`
// produced `Str`, `String`, or already-`&str`.
//
// Reproducer minimal shape: a fn-typed local `cb: fn(text)`
// dispatches a text-returning native call result.  Without the
// fix, `--native` rejects every callee in the dispatch table.

fn p265_make_text() -> text {
  "p265 ok"
}

fn p265_consume(s: text) {
  assert(s == "p265 ok", "p265: s={s}");
}

fn p265_fn_ref_text_dispatcher_compiles_under_native() {
  cb: fn(text) = p265_consume;
  cb(p265_make_text());
}
