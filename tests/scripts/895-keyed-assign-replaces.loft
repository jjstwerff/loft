//
// `=` to a keyed collection REPLACES its contents; only `+=` appends.
//
// A collection literal lowers to element-construction ops that append, so the
// assignment needs a clear in front of them. The vector path emits one; the keyed
// path emitted it only for the EMPTY literal (`s.h = []`), so `s.h = [a, b]` added to
// whatever the field already held and `=` silently meant `+=`. Assigning twice left
// four elements, and every reader saw a length and a set of keys the program never
// wrote — silently, on both backends and on the published 2026.8.0.
//
// It is not a struct-field defect: a keyed LOCAL took the same append (c6-c9). The
// filed shape was a struct holding two keyed fields, which is only the loudest way to
// notice — those two fields share their records by design, so filling either fills
// both and the next assignment adds to a collection the reader believes it replaced.
// That multi-index case is loft#898 and is NOT fixed here: its records are shared, and
// the clear frees records rather than one route to them, so clearing one view would
// leave the other reading freed memory. c15 pins that it is left alone deliberately.
//
// The controls carry the weight. A single assignment after `[]` is correct either way
// (c1) — that is why this went unnoticed, and why every row assigns TWICE. A plain
// `vector` field always cleared (c10), so a fix that widened the vector branch instead
// of the keyed one would pass a vector-only guard.

struct E { k: integer, n: text }
struct FH { h: hash<E[k]>, tag: integer }
struct FS { s: sorted<E[k]>, tag: integer }
struct FI { i: index<E[k]>, tag: integer }
struct FV { v: vector<E>, tag: integer }
struct Group { a: hash<E[k]>, b: sorted<E[k]>, tag: integer }

fn main() {
  // `keys` collects the keys actually present, in iteration order — a length alone
  // cannot tell a collection that replaced its two elements from one that kept the
  // old pair too.
  keys = "";
  // c1 — CONTROL: one assignment onto a fresh `[]` field is correct either way.
  c1 = FH { h: [], tag: 0 };
  c1.h = [E{k:1,n:"a"}, E{k:2,n:"b"}];
  assert(len(c1.h) == 2, "c1 len = {len(c1.h)}, want 2");

  // c2 — hash FIELD assigned twice. The second literal replaces the first.
  c2 = FH { h: [], tag: 0 };
  c2.h = [E{k:1,n:"a"}, E{k:2,n:"b"}];
  c2.h = [E{k:5,n:"e"}, E{k:6,n:"f"}];
  assert(len(c2.h) == 2, "c2 len = {len(c2.h)}, want 2");
  keys = ""; for e in c2.h { keys += "{e.k}"; }
  assert(keys == "56", "c2 keys = {keys}, want 56");

  // c3 — sorted FIELD. Distinct counts, so an append (4) and a replace (2) differ.
  c3 = FS { s: [], tag: 0 };
  c3.s = [E{k:1,n:"a"}, E{k:2,n:"b"}, E{k:3,n:"c"}];
  c3.s = [E{k:9,n:"i"}];
  assert(len(c3.s) == 1, "c3 len = {len(c3.s)}, want 1");
  keys = ""; for e in c3.s { keys += "{e.k}"; }
  assert(keys == "9", "c3 keys = {keys}, want 9");

  // c4 — index (b-tree) FIELD.
  c4 = FI { i: [], tag: 0 };
  c4.i = [E{k:1,n:"a"}, E{k:2,n:"b"}];
  c4.i = [E{k:7,n:"g"}];
  assert(len(c4.i) == 1, "c4 len = {len(c4.i)}, want 1");
  keys = ""; for e in c4.i { keys += "{e.k}"; }
  assert(keys == "7", "c4 keys = {keys}, want 7");

  // c5 — replacing with a LONGER literal, so a stale clear reads as a short answer
  //      rather than a long one. Sorted, so the order is fixed and checkable.
  c5 = FS { s: [], tag: 0 };
  c5.s = [E{k:4,n:"d"}];
  c5.s = [E{k:3,n:"c"}, E{k:1,n:"a"}, E{k:2,n:"b"}];
  assert(len(c5.s) == 3, "c5 len = {len(c5.s)}, want 3");
  keys = ""; for e in c5.s { keys += "{e.k}"; }
  assert(keys == "123", "c5 keys = {keys}, want 123");

  // c6 — hash LOCAL assigned twice. No struct, no sibling: the same defect.
  c6: hash<E[k]> = [];
  c6 = [E{k:1,n:"a"}, E{k:2,n:"b"}];
  c6 = [E{k:5,n:"e"}, E{k:6,n:"f"}];
  assert(len(c6) == 2, "c6 len = {len(c6)}, want 2");
  keys = ""; for e in c6 { keys += "{e.k}"; }
  assert(keys == "56", "c6 keys = {keys}, want 56");

  // c7 — sorted LOCAL.
  c7: sorted<E[k]> = [];
  c7 = [E{k:8,n:"h"}, E{k:9,n:"i"}];
  c7 = [E{k:2,n:"b"}, E{k:1,n:"a"}];
  assert(len(c7) == 2, "c7 len = {len(c7)}, want 2");
  keys = ""; for e in c7 { keys += "{e.k}"; }
  assert(keys == "12", "c7 keys = {keys}, want 12");

  // c8 — index LOCAL.
  c8: index<E[k]> = [];
  c8 = [E{k:8,n:"h"}, E{k:9,n:"i"}];
  c8 = [E{k:3,n:"c"}];
  assert(len(c8) == 1, "c8 len = {len(c8)}, want 1");
  keys = ""; for e in c8 { keys += "{e.k}"; }
  assert(keys == "3", "c8 keys = {keys}, want 3");

  // c9 — a LOCAL whose first assignment is a non-empty literal at its declaration.
  //      The clear is also what gives the slot its init here, so a fix that only
  //      prepended to reassignments would leave this one uninitialised.
  c9: hash<E[k]> = [E{k:1,n:"a"}, E{k:2,n:"b"}];
  assert(len(c9) == 2, "c9 len = {len(c9)}, want 2");
  keys = ""; for e in c9 { keys += "{e.k}"; }
  assert(keys == "12", "c9 keys = {keys}, want 12");

  // c10 — CONTROL: a plain `vector` field always replaced. A fix aimed at the vector
  //       branch rather than the keyed one would still pass this row.
  c10 = FV { v: [], tag: 0 };
  c10.v = [E{k:1,n:"a"}, E{k:2,n:"b"}];
  c10.v = [E{k:5,n:"e"}];
  assert(len(c10.v) == 1, "c10 len = {len(c10.v)}, want 1");

  // c11 — CONTROL: `+=` still APPENDS. The clear must not have been added to it.
  c11 = FH { h: [], tag: 0 };
  c11.h = [E{k:1,n:"a"}, E{k:2,n:"b"}];
  c11.h += [E{k:5,n:"e"}];
  assert(len(c11.h) == 3, "c11 len = {len(c11.h)}, want 3");

  // c12 — CONTROL: `+=` on a LOCAL still appends.
  c12: sorted<E[k]> = [];
  c12 = [E{k:2,n:"b"}];
  c12 += [E{k:1,n:"a"}];
  assert(len(c12) == 2, "c12 len = {len(c12)}, want 2");
  keys = ""; for e in c12 { keys += "{e.k}"; }
  assert(keys == "12", "c12 keys = {keys}, want 12");

  // c13 — the empty literal still clears, field and local (@P307 / P193). The clear
  //       is what a later `+=` re-initialises from, so a refill must land.
  c13 = FH { h: [], tag: 0 };
  c13.h = [E{k:1,n:"a"}, E{k:2,n:"b"}];
  c13.h = [];
  assert(len(c13.h) == 0, "c13 field cleared len = {len(c13.h)}, want 0");
  c13.h += [E{k:3,n:"c"}];
  assert(len(c13.h) == 1, "c13 field refilled len = {len(c13.h)}, want 1");

  // c14 — a keyed LOCAL whose element type is `linked` because ANOTHER struct holds
  //       two keyed fields over it. The local has no sibling of its own, so it must
  //       replace like any other — the multi-index exclusion is a property of the
  //       FIELD, not of the element type.
  c14: hash<E[k]> = [];
  c14 = [E{k:1,n:"a"}];
  c14 = [E{k:2,n:"b"}];
  assert(len(c14) == 1, "c14 len = {len(c14)}, want 1");
  keys = ""; for e in c14 { keys += "{e.k}"; }
  assert(keys == "2", "c14 keys = {keys}, want 2");

  // c15 — the multi-indexed group (loft#898) is deliberately NOT cleared here, because
  //       the clear frees records the sibling view still points at. Pinning the append
  //       keeps this row honest: it must be updated by whoever fixes #898, rather than
  //       silently starting to pass.
  c15 = Group { a: [], b: [], tag: 0 };
  c15.a = [E{k:1,n:"a"}, E{k:2,n:"b"}];
  c15.b = [E{k:2,n:"b"}, E{k:1,n:"a"}];
  assert(len(c15.a) == 2, "c15 primary len = {len(c15.a)}, want 2 (#898)");
  assert(len(c15.b) == 4, "c15 view len = {len(c15.b)}, want 4 until #898 lands");

  println("ok");
}
