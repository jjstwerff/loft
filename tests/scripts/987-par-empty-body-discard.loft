//
// loft#987 — a `par` loop whose body is EMPTY takes the discard route, and that route
// had no native lowering at all.  `--native` emitted `n_parallel_discard`'s loft
// DECLARATION, whose body is empty: workers that never run.  A six-argument call site
// against a five-parameter declaration is the only thing that turned that into a rustc
// error instead of a silent no-op, and an arity patch would have taken the error away
// and left the no-op.
//
// Fixing the lowering made the two backends comparable for the first time, and the
// INTERPRETER's half of the route turned out to be wrong in two ways nothing could
// witness — a route that drops every result produces nothing to compare:
//
//   - the row reached the worker as its 12-byte `DbRef` whatever the worker's first
//     parameter says, so a `fn w(n: integer)` read the pointer's bits;
//   - a text-returning worker's hidden `__work_N` buffer parameter (and a
//     heap-returning worker's hidden destination) was never pushed, which shifted
//     every slot the worker reads — the text case SEGFAULTED the interpreter.
//
// So each worker here ASSERTS the row it was handed.  That oracle works only because a
// worker's fault now stops the whole program (loft#1053) — before that fix a falsified
// in-worker assertion still exited 0, and this file's claim that "an assertion inside a
// worker is observable" was false for as long as it stood.  The queue-route control at
// the bottom is what pinned these workers in the meantime, by reading the same workers
// through a body that NAMES the result so the parent can assert on it.
//
// The first thing the assertions caught once they COULD fail was loft#1055: a wide row
// (a tuple) into a worker with a hidden parameter (any text or heap return) fell through
// to the reference spelling, and the worker read the pointer's bits as its value.  The
// four tuple/text tests below are that bug's guards, one per shape it took.

fn i987_scalar(n: integer) -> integer {
  assert(n >= 10 && n <= 30 && n % 10 == 0, "discard worker got row {n}, expected 10/20/30");
  n * n
}

fn i987_float(n: integer) -> float {
  assert(n >= 10 && n <= 30 && n % 10 == 0, "float worker got row {n}");
  n * 0.5
}

fn i987_text(n: integer) -> text {
  assert(n >= 10 && n <= 30 && n % 10 == 0, "text worker got row {n}");
  "row{n}"
}

fn i987_text_in(s: text) -> text {
  assert(s == "p" || s == "q" || s == "r", "text-input worker got row {s}");
  "{s}{s}"
}

struct I987Point { x: integer, y: integer }

fn i987_struct(n: integer) -> I987Point {
  assert(n >= 10 && n <= 30 && n % 10 == 0, "struct worker got row {n}");
  I987Point { x: n, y: n * 2 }
}

fn i987_vector(n: integer) -> vector<integer> {
  assert(n >= 10 && n <= 30 && n % 10 == 0, "vector worker got row {n}");
  [n, n + 1]
}

fn i987_bool(n: integer) -> boolean {
  assert(n >= 10 && n <= 30 && n % 10 == 0, "boolean worker got row {n}");
  n > 15
}

fn i987_rows() -> vector<integer> {
  [10, 20, 30]
}

// One test per return shape.  The loop is the last statement of its function because a
// `par` loop is what is under test, not what follows it.

fn test_987_discard_scalar() {
  for a in i987_rows() par(b = i987_scalar(a), 2) { }
}

fn test_987_discard_float() {
  for a in i987_rows() par(b = i987_float(a), 2) { }
}

fn test_987_discard_text() {
  for a in i987_rows() par(b = i987_text(a), 2) { }
}

fn test_987_discard_text_input() {
  words = ["p", "q", "r"];
  for a in words par(b = i987_text_in(a), 2) { }
}

fn test_987_discard_struct() {
  for a in i987_rows() par(b = i987_struct(a), 2) { }
}

fn test_987_discard_vector() {
  for a in i987_rows() par(b = i987_vector(a), 2) { }
}

fn test_987_discard_boolean() {
  for a in i987_rows() par(b = i987_bool(a), 2) { }
}

/// An empty input takes the route with nothing to dispatch — no workers, no panic.
fn test_987_discard_empty() {
  none: vector<integer> = [];
  for a in none par(b = i987_scalar(a), 2) { }
}

/// A TUPLE row is WIDE — bigger than any single value slot — and it is paired with a
/// text return, which gives the worker a hidden `__work_N` parameter.  That pairing is
/// the whole point: a wide row alone was always delivered correctly, and a hidden
/// parameter alone was too.  Only together did the row fall through to the reference
/// spelling and the worker read the pointer's bits as its tuple (loft#1055).
fn i987_tuple(p: const(integer, integer)) -> text {
  assert(p.0 * 10 == p.1, "tuple worker got row ({p.0}, {p.1})");
  "t{p.0}"
}

// This was the first thing the in-worker assertions caught once loft#1053 made them
// capable of failing at all — which is precisely what this file's header had claimed they
// already did.  It stayed here live and `@EXPECT_FAIL` until #1055 was fixed.
fn test_987_discard_tuple_row() {
  pairs: vector<(integer, integer)> = [(1, 10), (2, 20), (3, 30)];
  for a in pairs par(b = i987_tuple(a), 2) { }
}

/// A THREE-element tuple, so the width is not a multiple of the reference's.  The same
/// fall-through underflowed the worker's stack here rather than answering wrong —
/// "No elements left on the stack" — which is the same defect with a louder ending.
fn i987_triple(p: const(integer, integer, integer)) -> text {
  assert(p.0 * 10 == p.1 && p.0 * 100 == p.2, "triple worker got ({p.0}, {p.1}, {p.2})");
  "t{p.0}"
}

fn test_987_discard_triple_row() {
  rows: vector<(integer, integer, integer)> = [(1, 10, 100), (2, 20, 200), (3, 30, 300)];
  for a in rows par(b = i987_triple(a), 2) { }
}

/// A TEXT element into a worker that returns a STRUCT.  Neither of those is wide, so
/// this is the other half of the same missing decision: the route that carries heap
/// returns had no text spelling either, and this shape SIGSEGV'd the interpreter.
struct I987Cell { v: text }

fn i987_cell(p: const text) -> I987Cell {
  assert(len(p) == 2, "cell worker got text of length {len(p)}: [{p}]");
  I987Cell { v: p }
}

fn test_987_queue_text_into_struct_worker() {
  names: vector<text> = ["aa", "bb", "cc"];
  seen = 0;
  for a in names par(b = i987_cell(a), 2) {
    assert(len(b.v) == 2, "cell {seen} came back as [{b.v}]");
    seen += 1;
  }
  assert(seen == 3, "expected 3 cells, got {seen}");
}

/// A wide row into a worker whose return is a VECTOR — the third hidden-parameter
/// shape (a destination parameter rather than a text buffer).
fn i987_pair_out(p: const(integer, integer)) -> vector<integer> {
  [p.0, p.1]
}

fn test_987_queue_tuple_into_vector_worker() {
  pairs: vector<(integer, integer)> = [(1, 10), (2, 20), (3, 30)];
  total = 0;
  for a in pairs par(b = i987_pair_out(a), 2) {
    total += b[0] * 10 + b[1];
  }
  assert(total == 120, "expected 20+40+60 = 120, got {total}");
}

/// The control the discard route cannot be: a body that NAMES the result routes through
/// the Queue family instead, so the same workers can be checked for count and value.
/// If the discard tests above ever went vacuous (workers not running at all), this is
/// what still pins that the workers themselves answer what the asserts assume.
fn test_987_queue_control() {
  total = 0;
  seen = 0;
  for a in i987_rows() par(b = i987_scalar(a), 2) {
    total += b;
    seen += 1;
  }
  assert(seen == 3, "queue control expected 3 rows, got {seen}");
  assert(total == 1400, "queue control expected 100+400+900, got {total}");
}
