// @PLN35 Phase 6.3 (P-Lit) — a LITERAL element in a slice pattern matches by equality against
// v[pos].  On a SCALAR element (`vector<integer>`, `vector<text>`) it is a direct `==`; a "_"
// placeholder keeps the position count and length gate aligned, so it composes with bindings and
// `..rest`.  (Struct-enum token literals via `#lexeme` are 35k.)  Cross-mode + leak-checked.
// Returns are integers to steer clear of the pre-existing #557 text-arm-unification bug (a
// `vector<text>` subject with mixed interpolation/literal text returns).

// integer-literal dispatch on the head element, with following binds / rest.
fn dispatch(v: vector<integer>) -> integer {
  match v {
    [1, x] => x, // head literal 1, bind x
    [0, y, z] => y * 10 + z, // head literal 0, two binds
    [2, ..rest] => 200 + len(rest), // head literal 2, then rest
    [-1, w] => -w, // negative literal
    _ => -999,
  }
}

// two literal head elements then a bind.
fn two(v: vector<integer>) -> integer {
  match v { [7, 8, a] => a, _ => -1 }
}

// text-literal elements on a vector<text> (integer return avoids #557).
fn kw(v: vector<text>) -> integer {
  match v { ["set", name] => len(name), ["get"] => 0, _ => -1, }
}

fn main() {
  assert(dispatch([1, 9]) == 9, "one-9: {dispatch([1, 9])}");
  assert(dispatch([0, 3, 4]) == 34, "zero-3-4: {dispatch([0, 3, 4])}");
  assert(dispatch([2, 5, 6, 7]) == 203, "two + rest 3: {dispatch([2, 5, 6, 7])}");
  assert(dispatch([-1, 8]) == -8, "neg literal: {dispatch([-1, 8])}");
  assert(dispatch([9, 9]) == -999, "no literal head matches: {dispatch([9, 9])}");

  assert(two([7, 8, 42]) == 42, "two literals: {two([7, 8, 42])}");
  assert(two([7, 9, 0]) == -1, "second literal 8 mismatched: {two([7, 9, 0])}");

  assert(kw(["set", "abc"]) == 3, "text literal + bind: {kw([\"set\", \"abc\"])}");
  assert(kw(["get"]) == 0, "text literal only: {kw([\"get\"])}");
  assert(kw(["nope"]) == -1, "no text literal matches: {kw([\"nope\"])}");

  print("35l-literal-slice-elements: PASS");
}
