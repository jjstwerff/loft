//
// A generic may return `iterator<T>`, and a generator call may be back-patched (loft#1032).
//
// Four defects met in the filed repro; only the first is about generics at all, which is
// why the filed scope named the wrong boundary on three of them:
//
//   1. `substitute_type` (both twins — `Parser`'s and the variable table's `Function`'s)
//      had arms for `vector<T>` / `(T, T)` / `T?` and none for `iterator<T>`, so the
//      return kept the type VARIABLE.  formal/interfaces.md `(G-Mono)` requires
//      `[T ↦ C]` to reach "attribute, RETURN, and body types", so this was a deviation.
//   2. The forward-call back-patch re-derived the target operand as
//      `opcode(1) + d_nr(8) + args_size(2)`, but an opcode is TWO bytes at or above 255
//      and `OpCoroutineCreate` is one of those — so the i64 landed a byte early, over
//      `args_size`.  NO GENERICS NEEDED: any generator called above its declaration read
//      a multi-kilobyte frame size and underflowed `stack_pos - args_size`.
//   3. `--native`'s argument-hoist call path applied the per-parameter coercions but not
//      the RETURN side, so it emitted a bare call into a `DbRef` local instead of
//      wrapping it in `alloc_coroutine`.  Also no generics: the hoist fires on a
//      store-mutating argument, which a vector literal is.
//   4. `OpCoroutineNext` pairs a SIZE with a CHANNEL, both a function of the yielded
//      type.  A template lowered `for y in inner(v)` while `T` was still the type
//      variable and baked the 12-byte DbRef channel; substitution retyped the loop
//      variable and left the pairing behind — the same shape as loft#1016 / #1020 /
//      #1028, an operation whose choice depends on `τ` decided before `τ` was known.
//
// The sweep is over SCALAR T on purpose.  At `T = text` or a struct the DbRef channel is
// the right answer anyway, so every cell here passes before the fix at those types —
// that is exactly the missing axis formal/interfaces.md records for this doc's oracle.
// `text` is kept as the control that passed for the wrong reason.
//
// Every cell asserts the COUNT and the accumulated VALUE, never just the count: a yield
// channel reading the wrong width still advances the right number of times.
//
// Not covered here, deliberately: yielding a struct/vector from a generator's LOOP body
// (a documented `--native` refusal, generic-independent) and a `text?` generator
// parameter (loft#1035) — neither is this issue's.

pub fn gen1032<T>(v: vector<T>) -> iterator<T> { for e in v { yield e; } }

// The filed repro's shape: a `T?` parameter with a `null` default, discharged into a yield.
pub fn opt1032<T>(v: vector<T>, a: T? = null) -> iterator<T> { _ = len(v); yield a?; }

// A generic whose body iterates ANOTHER generic's generator — defect 4.  At the inner
// instantiation `T` is still the outer's type variable, so the channel must be decided
// at the outer monomorph, not at the template.
pub fn inner1032<T>(v: vector<T>) -> iterator<T> { for e in v { yield e; } }
pub fn outer1032<T>(v: vector<T>) -> integer { c = 0; for y in inner1032(v) { c += 1; _ = y; } c }

// Defect 2 has nothing to do with generics: this generator is declared BELOW its caller.
fn fwd1032() -> iterator<integer> { yield 11; yield 22; yield 33; }

// Defect 3 has nothing to do with generics either: the vector literal mutates a store, so
// the argument is hoisted and the call takes the duplicated emission path.
fn arg1032(v: vector<integer>) -> iterator<integer> { for e in v { yield e; } }

fn test_generic_iterator_return_monomorphises_per_scalar_type() {
  n = 0; s = 0;
  for y in gen1032([1, 2, 3]) { n += 1; s += y; }
  assert(n == 3, "integer count: got {n}");
  assert(s == 6, "integer sum: got {s}");

  fn_ = 0; fs = 0.0;
  for y in gen1032([1.5, 2.25, 3.0]) { fn_ += 1; fs += y; }
  assert(fn_ == 3, "float count: got {fn_}");
  assert(fs == 6.75, "float sum: got {fs}");

  bn = 0; bt = 0;
  for y in gen1032([true, false, true]) { bn += 1; if y { bt += 1; } }
  assert(bn == 3, "boolean count: got {bn}");
  assert(bt == 2, "boolean trues: got {bt}");

  // The control: right before the fix too, because a reference IS the DbRef channel.
  tn = 0; ts = "";
  for y in gen1032(["ab", "cd", "ef"]) { tn += 1; ts += y; }
  assert(tn == 3, "text count: got {tn}");
  assert(ts == "abcdef", "text concat: got {ts}");
}

fn test_generic_iterator_element_is_usable_at_the_instantiation() {
  // The report's second symptom: the loop variable stayed `T`, so it could be neither
  // summed nor FORMATTED even at a fully concrete instantiation.
  s = "";
  for y in gen1032([7, 8]) { s += "{y};"; }
  assert(s == "7;8;", "formatted yield: got {s}");
}

fn test_generic_iterator_with_a_nullable_defaulted_parameter() {
  n = 0;
  for y in opt1032([1]) { n += 1; _ = y; }
  assert(n == 1, "defaulted T? count: got {n}");
}

fn test_two_monomorphs_of_one_generator_in_one_program() {
  a = 0;
  for y in gen1032([1, 2, 3]) { a += y; }
  b = "";
  for z in gen1032(["p", "q"]) { b += z; }
  assert(a == 6, "first monomorph: got {a}");
  assert(b == "pq", "second monomorph: got {b}");
}

fn test_generic_iterating_another_generics_generator() {
  assert(outer1032([1, 2, 3]) == 3, "nested integer: got {outer1032([1, 2, 3])}");
  assert(outer1032([1.5, 2.5]) == 2, "nested float: got {outer1032([1.5, 2.5])}");
  assert(outer1032([true, false]) == 2, "nested boolean: got {outer1032([true, false])}");
  assert(outer1032(["x", "y"]) == 2, "nested text: got {outer1032(["x", "y"])}");
}

fn test_generator_called_above_its_declaration() {
  n = 0; s = 0;
  for y in fwd1032() { n += 1; s += y; }
  assert(n == 3, "forward-declared count: got {n}");
  assert(s == 66, "forward-declared sum: got {s}");
}

fn test_generator_called_with_a_store_mutating_argument() {
  n = 0; s = 0;
  for y in arg1032([4, 5, 6]) { n += 1; s += y; }
  assert(n == 3, "hoisted-argument count: got {n}");
  assert(s == 15, "hoisted-argument sum: got {s}");
}
