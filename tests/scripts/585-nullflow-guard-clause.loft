//
// @PLN25/#585 — the (N-Store) null-flow lint narrowed only the POSITIVE `if s { … }` THEN
// branch, so the idiomatic GUARD CLAUSE `if !s { return } … sink(s)` false-positived: the guard
// proves `s` non-null on the fall-through (the null case has already left the block) exactly like
// the positive form, yet the lint still warned. The fix records the tested var non-null on the
// fall-through after an `if <null-test> { <unconditional exit> }` with no else. This runs
// identically on --interpret and --native.
//
// The strict both-direction guard (silent guard-clause AND still-warning boundary) is
// tests/callarg_nstore.rs::guard_clause_narrows_*_585 — the wrap harness does not fail on an
// UNEXPECTED warning, so it cannot lock the no-warning direction. This file exercises the guard
// shapes for value-correctness on both backends and locks the must-still-warn negative via #warn.

fn sink(s: text) -> integer {
  len(s)
}

// Guard clause with `return` + `!s` — the classic form. No warning: `s` is non-null at `sink`.
fn use_return_bang(s: text?) -> integer {
  if !s { return 0; }
  sink(s)
}

// Guard clause with `return` + `s == null`. No warning.
fn use_return_eqnull(s: text?) -> integer {
  if s == null { return 0; }
  sink(s)
}

// Guard clause with `break` inside a loop. No warning: `s` is non-null past the guard.
fn use_break_bang(s: text?) -> integer {
  t = 0;
  for i in 0..3 {
    if !s { break; }
    t = t + sink(s);
  }
  t
}

// Guard clause with `continue` inside a loop. No warning.
fn use_continue_bang(s: text?) -> integer {
  t = 0;
  for i in 0..3 {
    if !s { continue; }
    t = t + sink(s);
  }
  t
}

// Must STILL warn: the `if !s { … }` body does NOT exit, so `s` may still be null at `sink`.
// #warn is stored into parameter 1 of `sink`
fn use_body_noexit(s: text?) -> integer {
  if !s { print("still nullable"); }
  sink(s)
}

fn main() {
  assert(use_return_bang("hi") == 2, "return/!s guard narrows: {use_return_bang(\"hi\")}");
  assert(use_return_eqnull("hi") == 2, "return/==null guard narrows");
  assert(use_break_bang("hi") == 6, "break/!s guard narrows: {use_break_bang(\"hi\")}");
  assert(use_continue_bang("hi") == 6, "continue/!s guard narrows: {use_continue_bang(\"hi\")}");
  assert(use_body_noexit("hi") == 2, "non-exiting body still runs correctly");
}
