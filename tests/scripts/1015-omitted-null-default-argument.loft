//
// An OMITTED parameter whose default is `null` arrived as the wrong kind of null.
//
// The parser fills a bare `Value::Null` for the omitted argument, and each backend gives it
// the parameter's width and sentinel afterwards. The interpreter's `emit_typed_null` matched
// the UNPEELED type, so every `τ?` fell past the scalar arms to the catch-all "generic null"
// and pushed a zero-filled DbRef where a scalar was expected. `types.md` pins what the `?`
// discharge must then answer: `(D-Scalar) construct_default(Integer[r]) = 0`.
//
// Measured before the fix: `integer? = null` omitted then `a?` gave **65535**, and
// `float?` gave a denormal — silent wrong numbers, not crashes. `--native` was right for both
// (it peels), and wrong for `boolean?`, where it wrote a 2-state `false` into a slot its own
// signature declares as the @PLN17 tri-state `u8` — so that program did not compile at all.
//
// The two halves are why both backends are asserted here: neither alone would have caught it.
//
// The boolean sentinel is 255, not the integer null: a null-capable `boolean` is the
// tri-state byte (0/1/255). The interpreter's arm said `i64::MIN`, which the tri-state cannot
// hold — invisible while the peel was missing, because nothing reached the arm.

fn i1015(a: integer? = null) -> integer { a? }
fn f1015(a: float? = null) -> float { a? }
fn b1015(a: boolean? = null) -> boolean { a? }
fn t1015(a: text? = null) -> text { a? }
fn bnull1015(a: boolean? = null) -> boolean { a == null }
fn inull1015(a: integer? = null) -> boolean { a == null }

fn test_omitted_null_default_discharges_to_the_types_zero() {
  assert(i1015() == 0, "integer? omitted discharges to 0, got {i1015()}");
  assert(f1015() == 0.0, "float? omitted discharges to 0.0");
  assert(b1015() == false, "boolean? omitted discharges to false");
  assert(t1015() == "", "text? omitted discharges to the empty text");
}

fn test_a_supplied_argument_is_unaffected() {
  // The control: passing the argument must still deliver it, not the default.
  assert(i1015(7) == 7, "a supplied integer arrives");
  assert(f1015(2.5) == 2.5, "a supplied float arrives");
  assert(b1015(true) == true, "a supplied true arrives");
  assert(t1015("x") == "x", "a supplied text arrives");
}

fn test_the_omitted_argument_really_is_null() {
  // The discharge above would also pass if the parameter held a NON-null zero, so this is
  // the cell that says the value is the null the declaration asked for.
  assert(inull1015() == true, "an omitted integer? = null IS null");
  assert(inull1015(7) == false, "a supplied integer? is not null");
  assert(bnull1015() == true, "an omitted boolean? = null IS null");
  assert(bnull1015(true) == false, "a supplied boolean? is not null");
  assert(bnull1015(false) == false, "a supplied FALSE is not null — the tri-state's whole point");
}
