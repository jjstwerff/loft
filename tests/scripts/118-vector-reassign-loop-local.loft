//
// @P292 regression — reassigning an outer-scope vector local to a
// loop-scoped local (`v = new_v`) must DEEP-COPY, not alias.  Before
// the fix the outer `v` aliased the loop-local's storage, which was
// freed at end-of-iteration → `v` dangled → next-iteration reads
// returned length 0 or SEGV'd.  The fix (parse_assign_op) emits
// OpClearVector(v) + OpAppendVector(v, new_v) for Var-RHS vector
// reassignment.  This locks it in across BOTH backends for integer
// AND struct element types, with indexed reads (the shape that
// surfaced the bug in projector.loft::pick_centers).

struct Pt { x: integer, y: integer }

fn main() {
  // --- integer vector: rebuild-from-loop-local, read by index. ---
  v: vector<integer> = [];
  v += [10];
  for i in 0..3 {
    nv: vector<integer> = [];
    for j in 0..len(v) { nv += [v[j]]; }   // copy loop reads v
    nv += [i];
    v = nv;                                 // reassign from loop-local
  }
  assert(len(v) == 4, "int: 4 elements after 3 rebuilds");
  assert(v[0] == 10, "int: v[0] initial preserved");
  assert(v[1] == 0,  "int: v[1] iter 0");
  assert(v[2] == 1,  "int: v[2] iter 1");
  assert(v[3] == 2,  "int: v[3] iter 2");

  // --- struct vector: same shape; element copy must be a deep copy. ---
  pts: vector<Pt> = [];
  pts += [Pt{x: 0, y: 0}];
  for i in 1..5 {
    np: vector<Pt> = [];
    for p in pts { np += [Pt{x: p.x, y: p.y}]; }
    np += [Pt{x: i, y: i * 10}];
    pts = np;
  }
  assert(len(pts) == 5, "struct: 5 elements after 4 rebuilds");
  assert(pts[0].x == 0 && pts[0].y == 0, "struct: pts[0] initial");
  assert(pts[4].x == 4 && pts[4].y == 40, "struct: pts[4] last");
  // Verify the middle survived (would be garbage if storage dangled).
  k = 0;
  while k < pts.len() {
    assert(pts[k].x == k, "struct: pts[{k}].x == {k}");
    k += 1;
  }

  println("118-vector-reassign-loop-local ok");
}
