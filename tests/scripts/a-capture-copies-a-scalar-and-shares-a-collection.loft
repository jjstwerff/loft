//
// Which captures are COPIED into a closure and which are SHARED with it.
//
// The Closures chapter teaches the split in two sentences — a scalar or a text is copied at
// definition time, a collection or struct is shared — and shows one cell for each side.  It
// stops there on purpose: the page is read by someone meeting closures for the first time,
// and the lesson is the shape of the rule, not every type it covers.
//
// This is where the rest of it lives, and the split is worth pinning completely because the
// two halves fail in opposite directions.  A reader who believes everything is copied writes
// a closure over a vector and is surprised when a later append changes what it counts.  A
// reader who believes everything is shared writes an accumulator over an integer, reads it
// after the loop, and gets a number nobody wrote.  Neither mistake produces a diagnostic:
// both programs compile and answer, and the answer is simply not the one the author meant.
//
// The chapter said "if a variable changes after the lambda is written, the lambda still sees
// the original value" without qualifying it, which is true of the scalar rows below and false
// of every collection row.  That sentence is what these cells now hold up.
//
// @falsified-at: none — this guard states where a boundary IS, and both halves have been in
//   these places for as long as the corpus records; there is no build on which it fails, which
//   makes it a LOCK rather than a regression test.  Checked by hand in both directions: every
//   assert below was inverted one at a time and each one failed, naming its own row.  Its
//   value is the day someone makes a collection capture copy, or a scalar capture share, and
//   the Closures chapter silently stops being true.

struct Counter {
  hits: integer,
}

struct Row {
  k: text,
  n: integer,
}

struct Cell {
  x: integer,
  y: integer,
  n: integer,
}

// --- Copied: every scalar type, and text -------------------------------------------------

fn a_scalar_capture_keeps_the_value_it_had_at_definition_time() {
  i = 10;
  f = 1.5;
  b = true;
  c = 'a';
  read_i = fn() -> integer { i + 0 };
  read_f = fn() -> float { f + 0.0 };
  read_b = fn() -> boolean { b };
  read_c = fn() -> character { c };
  i = 99;
  f = 99.5;
  b = false;
  c = 'z';
  assert(read_i() == 10, "integer capture: {read_i()}");
  assert(read_f() == 1.5, "float capture: {read_f()}");
  assert(read_b(), "boolean capture: {read_b()}");
  assert(read_c() == 'a', "character capture: {read_c()}");
}

fn a_text_capture_is_a_deep_copy() {
  t = "Hello";
  read = fn() -> text { "{t}!" };
  t = "Goodbye";
  assert(read() == "Hello!", "after reassigning the source: {read()}");
  t += " again";
  assert(read() == "Hello!", "after growing the source: {read()}");
}

// --- Shared: every collection kind, and a struct ------------------------------------------

fn a_vector_capture_sees_a_later_append() {
  v = [1, 2, 3];
  total = fn() -> integer {
    s = 0;
    for e in v { s += e; }
    s
  };
  assert(total() == 6, "before the append: {total()}");
  v += [10];
  assert(total() == 16, "after the append: {total()}");
  v[0] = 100;
  assert(total() == 115, "after an element write: {total()}");
}

fn a_hash_capture_sees_a_later_append() {
  h: hash<Row[k]> = [];
  h += Row { k: "one", n: 1 };
  count = fn() -> integer {
    s = 0;
    for e in h { s += e.n; }
    s
  };
  assert(count() == 1, "before the append: {count()}");
  h += Row { k: "two", n: 2 };
  assert(count() == 3, "after the append: {count()}");
}

fn a_sorted_capture_sees_a_later_append() {
  s: sorted<Row[k]> = [];
  s += Row { k: "b", n: 2 };
  count = fn() -> integer {
    t = 0;
    for e in s { t += e.n; }
    t
  };
  assert(count() == 2, "before the append: {count()}");
  s += Row { k: "a", n: 5 };
  assert(count() == 7, "after the append: {count()}");
}

fn an_index_capture_sees_a_later_append() {
  ix: index<Row[n]> = [];
  ix += Row { k: "b", n: 2 };
  count = fn() -> integer {
    t = 0;
    for e in ix { t += e.n; }
    t
  };
  assert(count() == 2, "before the append: {count()}");
  ix += Row { k: "a", n: 5 };
  assert(count() == 7, "after the append: {count()}");
}

fn a_spatial_capture_sees_a_later_append() {
  sp: spatial<Cell[x,y]> = [];
  sp += Cell { x: 1, y: 1, n: 4 };
  count = fn() -> integer {
    t = 0;
    for e in sp { t += e.n; }
    t
  };
  assert(count() == 4, "before the append: {count()}");
  sp += Cell { x: 2, y: 2, n: 5 };
  assert(count() == 9, "after the append: {count()}");
}

fn a_struct_capture_shares_the_record_both_ways() {
  c = Counter { hits: 0 };
  write_in = fn() { c.hits += 5; };
  read_out = fn() -> integer { c.hits };
  write_in();
  assert(c.hits == 5, "the closure's write reaches the enclosing scope: {c.hits}");
  c.hits = 40;
  assert(read_out() == 40, "and the enclosing scope's write reaches the closure: {read_out()}");
}

fn two_closures_over_one_collection_share_one_store() {
  v = [1];
  add_nine = fn() { v += [9]; };
  add_eight = fn() { v += [8]; };
  add_nine();
  add_eight();
  assert(len(v) == 3, "both appends land in the one vector: {len(v)}");
  assert(v[1] == 9, "v[1]: {v[1]}");
  assert(v[2] == 8, "v[2]: {v[2]}");
}

// --- The third regime: a scalar the closure WRITES is shared, not copied -------------------

fn a_written_scalar_capture_is_shared_with_the_enclosing_scope() {
  n = 0;
  bump = fn() { n += 1; };
  bump();
  bump();
  bump();
  assert(n == 3, "the closure's writes are visible outside: {n}");
  n = 10;
  bump();
  assert(n == 11, "and the enclosing scope's write is visible inside: {n}");
}

// --- What a returned closure and a captured parameter owe the caller -----------------------

// Takes a parameter so the suite does not collect it as a test of its own: it asserts
// nothing, and a cell that asserts nothing passes for the wrong reason.
fn make_total(base: integer) -> fn() -> integer {
  v = [base, 2, 3];
  fn() -> integer {
    s = 0;
    for e in v { s += e; }
    s
  }
}

fn keep_length(v: vector<integer>) -> fn() -> integer {
  fn() -> integer { len(v) }
}

fn a_returned_closure_still_holds_its_captures() {
  t = make_total(1);
  assert(t() == 6, "first call: {t()}");
  assert(t() == 6, "and the second reads the same store: {t()}");
}

fn capturing_a_parameter_leaves_the_caller_s_value_whole() {
  xs = [1, 2, 3];
  k = keep_length(xs);
  assert(k() == 3, "the closure reads the captured length: {k()}");
  assert(len(xs) == 3, "and the caller's vector is untouched: {len(xs)}");
  assert(xs[0] == 1 && xs[2] == 3, "with its elements intact: {xs[0]} {xs[2]}");
}
