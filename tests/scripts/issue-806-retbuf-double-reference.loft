// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A hidden `&text` buffer that is ALREADY a reference is handed over, not wrapped.
//
// `OpCreateStack(v)` is how a variable that OWNS its text hands out a reference to
// it. The call site that fills a callee's hidden `&text` return buffer picks that
// buffer BY NAME (`__work_cN`), so it never looked at the variable's type — and the
// name can already belong to a `&text` PARAMETER of the calling function, because
// `text_return` promotes a text local the return value depends on into a
// caller-allocated buffer (loft#662) and the promotion persists across the pass
// boundary. Wrapping it a second time built a DbRef pointing at the reference SLOT;
// the callee's single deref then read that slot as text — a SIGSEGV on the
// interpreter, while `--native` passed the reference by the Rust ABI and answered
// correctly, so the two backends disagreed instead of both crashing (loft#806).
//
// The filed shape was `return t.m(i) ?? "x"` with the enclosing function returning
// `text`. The boundary is wider than that on two axes the report pinned as required,
// so both are cells here: the enclosing function may return `text?`, and the
// fallback may be the EMPTY literal (which skips the buffer-append entirely, and so
// proves the fault is the reference wrap rather than anything written through it).
//
// Every cell is a value assertion, not a "did not crash" check: the interpreter's
// wrong reads are as likely to answer "" as to fault.

struct T { n: integer, tag: text }

fn src(i: integer) -> text? {
  if i == 0 { return null }
  return "value-{i}";
}

pub fn take(self: T, i: integer) -> text? { if self.n < 0 { return null } return src(i); }
pub fn take2(self: T, i: integer) -> text? { if i == 9 { return null } return "second{self.n}"; }
pub fn takes(self: T, s: text) -> text? { if s == "" { return null } return "got:{s}{self.tag}"; }

// The filed instance: a method call coalesced in RETURN position.
fn tail_method(t: T, i: integer) -> text { return t.take(i) ?? "<none>"; }

// The control the report gives: a FREE function in the same position is fine,
// because no method receiver means no promoted buffer at this call site.
fn tail_free(i: integer) -> text { return src(i) ?? "<none>"; }

// The documented workaround, kept as the value oracle for the cells above.
fn via_local(t: T, i: integer) -> text { got = t.take(i); return got ?? "<none>"; }

// Axis: the enclosing function returns `text?` rather than `text`. The report
// listed `-> text` as required; it is not.
fn tail_optional(t: T, i: integer) -> text? { return t.take(i) ?? "<none>"; }

// Axis: an EMPTY fallback. The buffer-append is skipped for it, so a cell that
// still fails here says the wrap is the fault, not the text written through it.
fn tail_empty(t: T, i: integer) -> text { return t.take(i) ?? ""; }

// Axis: the method takes a TEXT argument, so the frame carries another text slot.
fn tail_textarg(t: T, s: text) -> text { return t.takes(s) ?? "<none>"; }

// Axis: chained `??`, two promoted buffers at two call sites in one tail.
fn tail_chain(t: T, i: integer) -> text { return t.take(i) ?? t.take2(i) ?? "<none>"; }

// Axis: the receiver is a FIELD read rather than a plain variable.
struct Holder { inner: T }
fn tail_field(h: Holder, i: integer) -> text { return h.inner.take(i) ?? "<none>"; }

// Control: a promoted `&text` local forwarded to a `&text` PARAMETER. This is the
// lowering the fix reuses — an ordinary call site already forwards such a variable
// with no wrap — so it must keep working, and it is what says the fix did not
// simply delete the wrap everywhere.
fn app(s: &text, x: text) { s += x; }
fn forwarded_buffer(i: integer) -> text {
  buf = "";
  app(buf, "fwd-{i}");
  return buf;
}

fn main() {
  // The null side is the arm that took the fallback through the promoted buffer.
  assert(tail_method(d(), 0) == "<none>", "tail method, null: [{tail_method(d(), 0)}]");
  assert(tail_method(d(), 0) == via_local(d(), 0), "tail method vs local, null");

  // …and the present side, which must not have been disturbed.
  assert(tail_method(d(), 3) == "value-3", "tail method, present: [{tail_method(d(), 3)}]");
  assert(tail_method(d(), 3) == via_local(d(), 3), "tail method vs local, present");

  assert(tail_free(0) == "<none>", "tail free, null: [{tail_free(0)}]");
  assert(tail_free(2) == "value-2", "tail free, present: [{tail_free(2)}]");

  assert((tail_optional(d(), 0) ?? "NULL") == "<none>", "tail optional, null");
  assert((tail_optional(d(), 4) ?? "NULL") == "value-4", "tail optional, present");

  assert(tail_empty(d(), 0) == "", "tail empty fallback, null: [{tail_empty(d(), 0)}]");
  assert(tail_empty(d(), 5) == "value-5", "tail empty fallback, present");

  assert(tail_textarg(d(), "") == "<none>", "tail text arg, null");
  assert(tail_textarg(d(), "x") == "got:xtg", "tail text arg, present: [{tail_textarg(d(), "x")}]");

  assert(tail_chain(d(), 0) == "second1", "tail chain, first null: [{tail_chain(d(), 0)}]");
  assert(tail_chain(d(), 1) == "value-1", "tail chain, first present");

  hh = Holder { inner: d() };
  assert(tail_field(hh, 0) == "<none>", "tail field receiver, null");
  assert(tail_field(hh, 6) == "value-6", "tail field receiver, present");

  assert(forwarded_buffer(1) == "fwd-1", "forwarded buffer: [{forwarded_buffer(1)}]");

  // The returned text must survive being USED, not merely compared: a reference
  // into a slot that no longer holds text can compare equal by luck while its
  // bytes are gone. Accumulating across calls also re-enters the promoted buffer
  // once per call, which is what the per-invocation clear has to cover.
  joined = "";
  for n in 0..4 { joined += "{tail_method(d(), n)}|" }
  assert(joined == "<none>|value-1|value-2|value-3|", "accumulated: [{joined}]");

  println("issue-806-retbuf-double-reference ok");
}

fn d() -> T { return T { n: 1, tag: "tg" }; }
