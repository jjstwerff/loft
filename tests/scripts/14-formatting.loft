// Format specifiers: integers, floats, booleans, text, long, single, vectors.
// @FTR-044 — `{expr}` interpolation and the format specifiers: width, fill, precision,
// sign, and the radix forms
fn main() {
  // --- Brace escaping ---
  // "ab{cd}e" would treat {cd} as a format expression in loft.
  // Use {{/}} escapes on both sides, or build the expected value via a variable:
  cd_word = "cd";
  assert("ab{{cd}}e" == "ab{{{cd_word}}}e", "escaped braces");
  // --- Integer formats ---
  assert("{42}" == "42", "int default");
  assert("{42:#x}" == "0x2a", "int hex");
  assert("{35:#x}" == "0x23", "int hex 35");
  assert("{12:o}" == "14", "int octal");
  assert("{42:b}" == "101010", "int binary");
  assert("{12:+4}" == " +12", "int signed width");
  assert("{1:03}" == "001", "int zero-padded");
  // --- Long formats ---
  assert("{2:+4}" == "  +2", "long signed width");
  assert("{12 as integer}" == "12", "long cast to int");
  // --- Float formats ---
  assert("{1.2:4.2}" == "1.20", "float width.precision");
  assert("{334.1:.2}" == "334.10", "float precision only");
  assert("{1.4:5}" == "  1.4", "float width only");
  assert("{1.34}" == "1.34", "float default");
  // --- Single (f32) ---
  assert("{0.1f + 2 * 1.0f}" == "2.1", "single default format");
  // --- Boolean ---
  assert("{true:^7}" == " true  ", "bool centered 7");
  assert("{false}" == "false", "bool default");
  // --- Text formats ---
  vr = "abc";
  assert("{vr:<5}" == "abc  ", "text left-aligned 5");
  assert("{vr:6}" == "abc   ", "text width 6");
  assert("{vr:>7}" == "    abc", "text right-aligned 7");
  assert("{vr:4}" == "abc ", "text width 4");
  // --- Inline expression ---
  assert("{1 + 2 * 3:#x}" == "0x7", "inline expr hex: 7");
  assert("a{12}b" == "a12b", "int interpolation");
  // --- Vector format ---
  assert("{for n in 1..7 {n*2}:02}" == "[02,04,06,08,10,12]", "vector formatted");
  // --- Sub-string in format ---
  txt = "12😊🙃45";
  assert("{txt[2..-1]}" == "😊🙃4", "substring in format");
  // --- Character iteration with #index ---
  // Nested \" inside format expressions is not supported in .loft files;
  // build the result incrementally instead.
  citer = "";
  for c in txt[2.. - 1] {
    if citer != "" { citer += ","; }
    citer += "{c#index}:{c}";
  }
  assert(citer == "0:😊,4:🙃,8:4", "char iter indices built as string");
  // --- Null integer formatting ---
  zero_div = 0;
  null_int = 1 / zero_div ?? null;
  assert("{null_int}" == "null", "null integer formats as 'null'");
  // --- Negative integer formats ---
  assert("{-42}" == "-42", "negative int default");
  assert("{-1:03}" == "-01", "negative zero-padded: sign before zeros");
  assert("{-42:+6}" == "   -42", "negative with sign and width");
  // --- Float edge cases in format ---
  assert("{0.0:.2}" == "0.00", "zero float precision");
  assert("{-1.5:.1}" == "-1.5", "negative float precision");
  // --- Long formatting ---
  assert("{0}" == "0", "long zero format");
  assert("{-5}" == "-5", "negative long format");
  assert("{1000000}" == "1000000", "large long format");
  // --- Width smaller than content ---
  assert("{12345:3}" == "12345", "width smaller than int: no truncation");
  // Note: {\"hello\":3} triggers the nested-quote parse bug (issue 9); use a variable.
  hw = "hello";
  assert("{hw:3}" == "hello", "width smaller than text: no truncation");
  // --- :d explicit decimal specifier (alias for default integer format) ---
  nd = 42;
  assert("{nd:d}" == "42", ":d is decimal same as default");
  assert("{nd:5d}" == "   42", ":5d has width");
  // --- :f float specifier (alias for default float format) ---
  ff = 3.14;
  assert("{ff:5f}" == " 3.14", ":f with width pads left");
  // --- Bare precision .N without explicit width ---
  pi_v = 3.14159;
  assert("{pi_v:.2}" == "3.14", "bare precision .2 rounds to 2 decimal places");
  assert("{pi_v:.4}" == "3.1416", "bare precision .4");
  assert("{0.0:.2}" == "0.00", "bare precision .2 on zero");
  // --- String literal inside format expression {} ---
  assert("{\"hello\"}" == "hello", "string literal in format no specifier");
  assert("{\"hi\":5}" == "hi   ", "string literal in format with width");
  // --- Loop #count inside format string ---
  cnt_r = "";
  vcnt = [10, 20, 30];
  for e in vcnt {
    if !e#first { cnt_r += ","; }
    cnt_r += "{e#count}:{e}";
  }
  assert(cnt_r == "0:10,1:20,2:30", "loop #count in format string: {cnt_r}");
  // --- Variable use after assignment in format (not before) ---
  late = 5;
  assert("{late}" == "5", "variable used after assignment in format");

  // --- loft#767: a string literal written INSIDE a hole interpolates too ---
  //
  // Its own `{…}` used to be copied out as text: `"{"{y}"}"` produced `{y}`.
  // No error and no warning — a plausible wrong VALUE that survived being
  // consumed, which is how it was found (a probe read `{x}` back as
  // unparseable text and reported that a float does NOT round-trip).
  y = 5;
  assert("{"{y}"}" == "5", "nested literal interpolates: {"{y}"}");
  assert("{"n={y}"}" == "n=5", "nested literal, text around the hole");
  assert("{"lit"}" == "lit", "nested literal with NO hole is unchanged");
  assert("{"a" + "b"}" == "ab", "two nested literals in one hole");
  // Opened with `\"`, which is then also what closes it — the same string,
  // reached by the other spelling, must give the same answer.
  assert("{\"{y}\"}" == "5", "escaped-delimiter nested literal interpolates");
  // A brace escape inside a nested literal now collapses like any other:
  // it was emitted doubled, so there was no way to write a literal brace.
  // (the expected value needs its own escaping — `"{y}"` would interpolate)
  assert("{"{{y}}"}" == "{{y}}", "escape collapses inside a nested literal");
  // Depth two: a flag can answer "resume which string?" one level down and
  // can only be wrong deeper, silently — so the answer is a stack.
  assert("{"{"{y}"}"}" == "5", "nested literal inside a nested literal");
  // The shape that made the bug expensive: the wrong text reaches a consumer
  // that correctly refuses it, and the default hides the loss.
  f = 5.0;
  round = ("{"{f}"}" as float?) ?? 0.0;
  assert(round == 5.0, "nested literal survives being consumed: {round}");

  // A backtick literal inside a hole is a nested literal in exactly the same
  // way, and was unusable there at all — even with no hole of its own.
  assert("{`abc`}" == "abc", "backtick literal inside a hole, no hole of its own");
  assert("{`{y}`}" == "5", "backtick literal inside a hole interpolates");
  assert("{`n={y}`}" == "n=5", "backtick literal, text around the hole");
  // Mixed, both directions, and a backtick inside a backtick's own hole: the
  // resume decision is a stack, so the kinds can interleave to any depth.
  assert(`plain {"{y}"} done` == "plain 5 done", "plain literal inside a backtick hole");
  assert(`outer {`{y}`} done` == "outer 5 done", "backtick inside a backtick hole");
  assert("{"a" + `b{y}`}" == "ab5", "the two spellings mix in one hole");

  // `+` — "always show a sign on a NUMBER" (formal/formatting.md F-Spec).  It was
  // honoured for an integer and dropped for a float and a single, on both backends and
  // with nothing said: the float format opcodes had no sign operand to put it in.  A
  // template asked for a character and got a string missing it, which no differential
  // oracle over the two backends can see — they agreed.
  fplus = 0.5;
  fminus = -0.5;
  splus = 1.25f;
  sminus = -1.25f;
  assert("{fplus:+}" == "+0.5", "float sign: {fplus:+}");
  assert("{fplus:+.3}" == "+0.500", "float sign with precision: {fplus:+.3}");
  assert("{fplus:+8.3}" == "  +0.500", "float sign inside the field: {fplus:+8.3}");
  // A negative number keeps its own sign — the flag adds one, it does not replace one.
  assert("{fminus:+.3}" == "-0.500", "negative float keeps its sign: {fminus:+.3}");
  // ... and without the flag nothing is added, which is the control for all of the above.
  assert("{fplus:.3}" == "0.500", "no flag, no sign: {fplus:.3}");
  assert("{splus:+.2}" == "+1.25", "single sign: {splus:+.2}");
  assert("{sminus:+.2}" == "-1.25", "negative single keeps its sign: {sminus:+.2}");
  // Signed zero prints its OWN sign, so a `+` must be decided on the rendered text and
  // not on `value >= 0` — which is true for -0.0 and would have produced `+-0.0`.
  fzero = 0.0;
  assert("{fzero:+.1}" == "+0.0", "positive zero takes the sign: {fzero:+.1}");
  // `null` is the float's NaN sentinel and is not a number, so it takes no sign at all.
  fnull = nullable_float();
  assert("{fnull:+.2}" == "null", "a null float takes no sign: {fnull:+.2}");

  // A spec's flags are read in any ORDER.  They used to be read in a fixed one, and a
  // flag written out of that order was left in the stream for the WIDTH expression:
  // `{f:+<8.3}` read `+`, then parsed `<8.3` as a comparison.  The interpreter rendered
  // `0.5` — no sign, no width, no precision — and the native backend emitted a
  // comparison between an i64 and an f64, so the program failed to COMPILE with rustc
  // errors about loft's own internals.  Neither said the spec was the problem.
  assert("{fplus:+<8.3}" == "+0.500  ", "sign before alignment: {fplus:+<8.3}");
  assert("{fplus:<+8.3}" == "+0.500  ", "alignment before sign: {fplus:<+8.3}");
  assert("{12:+<6}" == "+12   ", "the same pair on an integer: {12:+<6}");
  assert("{12:<+6}" == "+12   ", "and the other order: {12:<+6}");
}

fn nullable_float() -> float? { null }
