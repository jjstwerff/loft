//
// Regression (loft#772) — assigning a whole vector to a `&` parameter.
//
// A `&` vector parameter shares the CALLER's store in place, so `=` on it means
// "replace what the caller sees": clear the shared store and copy the right-hand
// side back into it.  Only the LITERAL form did that.  Every other right-hand
// side fell through to a plain `Set(v, …)` that codegen discarded, so the write
// vanished — reported as "Parameter 'v' has & but is never modified" when nothing
// else in the body touched `v`, and SILENTLY when something did.  Taking that
// diagnostic at its word (dropping the `&`) turns a rejected program into a
// quietly wrong one, which is why the silence is the dangerous half.
//
// The sibling the same probe uncovered: `w = v` gave the LOCAL `w` the type
// `&vector<T>`.  `&τ` is a parameter-passing mode, so a local carrying it got no
// stack slot at all (slot 65535) — a wrong answer, an ICE, or a SIGSEGV
// depending on what the body did with `w` next.
//
// Every cell below is hand-computed, and each varies ONE axis of the right-hand
// side: literal / comprehension / local / call / self / borrow-of-self, over
// scalar, struct, and nested element types.

struct P772 { n: integer }

fn fresh_ints() -> vector<integer> { [1, 2, 3] }
fn fresh_parts() -> vector<P772> { [P772 { n: 4 }, P772 { n: 5 }] }
fn fresh_rows() -> vector<vector<integer>> { [[1, 2], [3]] }

// --- the right-hand-side axis, each on a `&vector<integer>` -----------------

fn by_literal(v: &vector<integer>) { v = [1, 2, 3]; }
fn by_comprehension(v: &vector<integer>) { v = [for n in 1..4 { n * 2 }]; }
fn by_local(v: &vector<integer>) { t = [7, 8]; v = t; }
fn by_call(v: &vector<integer>) { v = fresh_ints(); }
// `v = v` on its own is genuinely not a modification, and the `&`-redundancy
// check still says so; the append is what earns the `&` here.
fn by_self(v: &vector<integer>) { v += [6]; v = v; }
fn by_borrow(v: &vector<integer>) { w = v; v = w; }

// The same replacements AFTER an append, so the clear is proven to run: without
// it the copy would pile onto what the append left behind.
fn append_then_local(v: &vector<integer>) { v += [99]; t = [7, 8]; v = t; }
fn append_then_call(v: &vector<integer>) { v += [99]; v = fresh_ints(); }

// --- element-type axis ------------------------------------------------------

fn parts_by_call(v: &vector<P772>) { v += [P772 { n: 9 }]; v = fresh_parts(); }
fn rows_by_call(v: &vector<vector<integer>>) { v = fresh_rows(); }
fn texts_by_call(v: &vector<text>) { v += ["z"]; t = ["a", "b", "c"]; v = t; }

// --- reading a `&` parameter into a local (the sibling) ---------------------

// `w = v` reads the parameter as a VALUE, which copies — the same answer a
// by-value `v: vector<integer>` gives, so the `&` changes how the caller's
// vector is reached, not what a second local name means.
fn read_len(v: &vector<integer>) -> integer { v += [7]; w = v; return w.len(); }
fn read_then_grow(v: &vector<integer>) -> integer { v += [7]; w = v; w += [9]; return w.len(); }

fn main() {
  a: vector<integer> = [];
  by_literal(a);
  assert(a.len() == 3, "literal: {a.len()}, want 3");
  assert(a[2] == 3, "literal: a[2] is {a[2]}, want 3");

  b: vector<integer> = [];
  by_comprehension(b);
  assert(b.len() == 3, "comprehension: {b.len()}, want 3");
  assert(b[0] == 2 && b[2] == 6, "comprehension: got {b}, want [2,4,6]");

  c: vector<integer> = [];
  by_local(c);
  assert(c.len() == 2, "local: {c.len()}, want 2");
  assert(c[0] == 7 && c[1] == 8, "local: got {c}, want [7,8]");

  d: vector<integer> = [];
  by_call(d);
  assert(d.len() == 3, "call: {d.len()}, want 3");
  assert(d[0] == 1 && d[2] == 3, "call: got {d}, want [1,2,3]");

  // `v = v` replaces the store with itself — a no-op, NOT a clear.  The append
  // before it stays, which is what proves no clear ran.
  e: vector<integer> = [4, 5];
  by_self(e);
  assert(e.len() == 3, "self: {e.len()}, want 3");
  assert(e[0] == 4 && e[2] == 6, "self: got {e}, want [4,5,6]");

  // The right-hand side BORROWS the destination, so it must be materialised
  // before the clear or the copy would read an emptied store.
  f: vector<integer> = [4, 5];
  by_borrow(f);
  assert(f.len() == 2, "borrow: {f.len()}, want 2");
  assert(f[0] == 4 && f[1] == 5, "borrow: got {f}, want [4,5]");

  // The clear must actually run: the appended 99 is gone, not a prefix.
  g: vector<integer> = [];
  append_then_local(g);
  assert(g.len() == 2, "append+local: {g.len()}, want 2 (the 99 must be cleared)");
  assert(g[0] == 7 && g[1] == 8, "append+local: got {g}, want [7,8]");

  h: vector<integer> = [];
  append_then_call(h);
  assert(h.len() == 3, "append+call: {h.len()}, want 3 (the 99 must be cleared)");
  assert(h[0] == 1 && h[2] == 3, "append+call: got {h}, want [1,2,3]");

  // A pre-filled caller vector: the replacement must not append to it either.
  i: vector<integer> = [100, 200, 300, 400];
  by_call(i);
  assert(i.len() == 3, "prefilled: {i.len()}, want 3");
  assert(i[0] == 1 && i[2] == 3, "prefilled: got {i}, want [1,2,3]");

  // Struct elements deep-copy, so the caller reads the callee's field values.
  p: vector<P772> = [];
  parts_by_call(p);
  assert(p.len() == 2, "parts: {p.len()}, want 2");
  assert(p[0].n == 4 && p[1].n == 5, "parts: got {p[0].n},{p[1].n}, want 4,5");

  // Nested vectors copy at both levels.
  r: vector<vector<integer>> = [];
  rows_by_call(r);
  assert(r.len() == 2, "rows: {r.len()}, want 2");
  assert(r[0].len() == 2 && r[1].len() == 1, "rows: got {r[0].len()},{r[1].len()}, want 2,1");
  assert(r[0][1] == 2 && r[1][0] == 3, "rows: got {r[0][1]},{r[1][0]}, want 2,3");

  // Text elements carry their own storage through the copy.
  t: vector<text> = [];
  texts_by_call(t);
  assert(t.len() == 3, "texts: {t.len()}, want 3");
  assert(t[0] == "a" && t[2] == "c", "texts: got {t}, want [a,b,c]");

  // Reading the parameter into a local sees the value the append left behind.
  u: vector<integer> = [1, 2];
  ul = read_len(u);
  assert(ul == 3, "read_len: {ul}, want 3");
  assert(u.len() == 3, "read_len: caller sees {u.len()}, want 3");

  // …and it is a COPY, so growing the local leaves the caller alone.
  w: vector<integer> = [1, 2];
  wl = read_then_grow(w);
  assert(wl == 4, "read_then_grow: local is {wl}, want 4");
  assert(w.len() == 3, "read_then_grow: caller sees {w.len()}, want 3 (the local is a copy)");

  println("772 amp-vector reassign OK");
}
