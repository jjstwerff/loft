//
// #556 — a slice-pattern match arm whose body is a `{ … }` block returned the WRONG value on
// native (0/null): the trailing result expression was DROPPED.  The vector match parsed its arm
// body through `self.expression`, which delegates a `{ … }` to `parse_block(…, &Type::Void)` —
// and a Void-result block wraps EVERY statement, including the trailing one, in `Drop`
// (`{ c = 5; c }` → `c = 5; drop c`).  The block then yielded void → native delivered 0 (the
// interpreter happened to still surface the value, so this was native-only).  Fix: parse a `{`
// arm body as a `match_arm` block with an inferred (`Unknown`) result type, exactly as the
// enum/scalar match arm already does.  Reported as `for e in rest` (a red herring — the loop RAN;
// its enclosing block just didn't return the counter).  Both backends.

// trailing bare local
fn lit(v: vector<integer>) -> integer {
  match v { [ _, x ] => { c: integer = 5; c }, _ => -1 }
}

// mutate then return the local
fn mutated(v: vector<integer>) -> integer {
  match v { [ _, x ] => { c: integer = 5; c = c + x; c }, _ => -1 }
}

// the originally-reported shape: a `for` over `..rest`, returning the counter
fn count_rest(v: vector<integer>) -> integer {
  match v { [ _, ..rest ] => { c: integer = 0; for e in rest { c = c + 1; } c }, _ => -1 }
}

// a `for` over `..rest` that SUMS (also reads each element — the struct-enum driver's scalar twin)
fn sum_rest(v: vector<integer>) -> integer {
  match v { [ _, ..rest ] => { s: integer = 0; for e in rest { s = s + e; } s }, _ => -1 }
}

// nested match arm inside the for body (the Phase-6 struct-enum driver)
enum Tok { Num { n: integer }, Op { o: integer } }
fn sum_nums(v: vector<Tok>) -> integer {
  match v {
    [ _, ..rest ] => { s: integer = 0; for e in rest { match e { Num { n } => { s = s + n; }, _ => {} } } s },
    _ => -1,
  }
}

fn main() {
  assert(lit([1, 2]) == 5, "lit: {lit([1, 2])}");
  assert(mutated([1, 4]) == 9, "mutated 5+4: {mutated([1, 4])}");     // x = v[1] = 4
  assert(count_rest([9, 5, 6]) == 2, "count_rest: {count_rest([9, 5, 6])}");        // rest=[5,6]
  assert(sum_rest([9, 5, 6]) == 11, "sum_rest 5+6: {sum_rest([9, 5, 6])}");
  assert(sum_nums([Op { o: 0 }, Num { n: 5 }, Num { n: 6 }]) == 11, "sum_nums: {sum_nums([Op { o: 0 }, Num { n: 5 }, Num { n: 6 }])}");
  print("556 slice-arm-block-result ok\n");
}
