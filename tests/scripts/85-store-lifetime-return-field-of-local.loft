//
// @PLN85 / #425 — regression guard (cbor-free analog of `cbor::decode_value`).
// A function that returns a struct/enum FIELD projected from an OWNED LOCAL must
// COPY the field into the return buffer: the local (the container) is freed at
// scope exit, so returning the bare sub-ref dangles. Before the fix, `--native`
// re-encoded the returned value to garbage (the cbor repro: `wrapped=0` instead
// of `11`); the interpreter accidentally read freed-but-intact memory.
//
// Root cause: NRVO mis-promoted the container local `d` (`d = mk()`) to BE this
// fn's return buffer, but the fn returns its inner field — so the field was
// dropped and `d` freed. Fix: `ref_return` no longer renames a local to the
// return buffer when the return value is a field projection OF that local
// (`returns_own_field`); the candidate falls through to the copy-into-buffer leg
// (`materialize_return_into` → `OpCopyRecord(d.field → __retbuf)`), extended to
// heap `Type::Enum` returns. Guards value semantics on BOTH backends.
//
// `Holder` ~ CborValue (enum with a vector payload); `Box` ~ Decoded (struct
// whose field is the enum); `mk` ~ decode (returns a freshly-OWNED local). The
// inner vector's length re-read is the "re-encode": 0 / null means corruption.

enum Holder {
  Bytes { v: vector<u8> },
}
struct Box {
  value: Holder,
}

fn relen(h: Holder) -> integer {
  match h {
    Bytes { v } => len(v)
  }
}

fn mk() -> Box {
  bs: vector<u8> = [];
  for i in 0..8 { bs += [((i + 1)&255) as u8]; }
  return Box {
    value: Bytes { v: bs },
  };
}

// THE #425 SHAPE: return the enum field of a freshly-decoded OWNED LOCAL.
fn decode_value() -> Holder {
  d = mk();
  return d.value;
}

// Works-baseline: field of an ARGUMENT (caller owns the record). This case must
// STAY on the no-copy path — forcing a copy here would orphan the buffer.
fn field_of_arg(d: Box) -> Holder {
  return d.value;
}

// A shallow SCALAR-payload enum field of a local (depth axis).
enum Num {
  N { n: integer },
}
struct Wrap {
  value: Num,
}
fn mk_num() -> Wrap {
  return Wrap { value: N { n: 77 } };
}
fn num_val(x: Num) -> integer {
  match x {
    N { n } => n
  }
}
fn shallow_field_of_local() -> Num {
  d = mk_num(); return d.value;
}

// #425 SIBLING — return a heap field projected from an INLINE-CALL result
// (`return mk().value`) rather than a named local (`d = mk(); return d.value`).
// The call result is an anonymous owned temporary (lifted to `__lift_N`) that is
// freed at scope exit, so the projected sub-ref dangles the same way. Before the
// sibling fix, `--native` returned the null sentinel here (`inline=0`) while the
// named-local form (above) was already fixed. Same OWNERSHIP_MODEL row-104 class:
// copy the field's record into `__retbuf` before the temporary's free.
struct Nested {
  inner: Box,
}
fn mk_nested() -> Nested {
  bs: vector<u8> = [];
  for i in 0..8 { bs += [((i + 1)&255) as u8]; }
  return Nested {
    inner: Box {
      value: Bytes { v: bs },
    },
  };
}
// enum field of an inline-call result.
fn inline_enum_field() -> Holder {
  return mk().value;
}
// struct field of an inline-call result (Reference twin of the enum case).
fn inline_struct_field() -> Box {
  return mk_nested().inner;
}
// CHAINED projection (`mk().a.b`) — the intermediate Reference is materialised,
// so this path was already sound; guard it stays so.
fn inline_chained_field() -> Holder {
  return mk_nested().inner.value;
}

fn main() {
  // #425 — the returned enum's vector field must survive `d`'s free.
  assert(relen(decode_value()) == 8, "return d.value (field-of-local) must COPY (len 8)");

  // f(g(x)) — the returned-field value passed straight as an arg (one call later).
  h = decode_value();
  assert(relen(h) == 8, "decode_value() result reused as an arg must be intact (len 8)");

  // works-baseline must STAY working (no over-copy / no regression).
  b = mk();
  assert(relen(field_of_arg(b)) == 8, "field-of-arg must stay valid (len 8)");

  // shallow scalar enum field of a local.
  assert(num_val(shallow_field_of_local()) == 77, "shallow field-of-local (val 77)");

  // #425 SIBLING — enum field of an inline-call result must COPY (was null native).
  assert(
    relen(inline_enum_field()) == 8,
    "return mk().value (enum field-of-call) must COPY (len 8)"
  );

  // #425 SIBLING — struct field of an inline-call result (Reference twin).
  assert(
    relen(inline_struct_field().value) == 8,
    "return mk().field (struct field-of-call) must COPY (len 8)"
  );

  // #425 SIBLING — chained projection must stay valid (already-sound path).
  assert(relen(inline_chained_field()) == 8, "return mk().a.b (chained field-of-call) (len 8)");
}
