//
// `text.char_slice(from, to)` — a slice that counts CHARACTERS, where
// `self[a..b]` counts BYTES.
//
// ⚠ It exists because THREE trees hand-rolled the same walk and one of them
// shipped the bug it exists to prevent.  `len(text)` counts characters, `s[a..b]`
// slices bytes, and loft snaps a byte cut outward — so a count computed from
// `len` and applied as a byte range fits FEWER characters than it measured.  The
// failure is quiet: the text comes back SHORT, never mojibake, and only when it
// is not ASCII, so an all-ASCII suite stays green over it.
//
// Measured 2026-08-20: `text2d` wrote `take_chars` after `fit_text` shipped with
// `s[0..keep]` (@PLN145 B2); `stage`'s text field needed the same walk twice
// (@PLN145 D2); and moros's `lavition_ui/src/font.loft` still carries it across
// seven call sites — every button label, every hotkey, every list entry, the
// status line, the subject line and both verb slots.

// THE CELL THE WHOLE FUNCTION IS FOR: the same numbers, the two units.
fn test_the_character_slice_and_the_byte_slice_differ() {
  s = "héllo";
  assert(len(s) == 5, "five characters");
  assert(size(s) == 6, "six bytes — which is what makes the two disagree");
  assert(s.char_slice(0, 4) == "héll", "by characters: {s.char_slice(0, 4)}");
  assert(s[0..4] == "hél", "by bytes, the SAME numbers give one character less: {s[0..4]}");
  // ⚠ And the byte cut is not corrupt — it is short.  That is why it hides.
  assert(len(s[0..4]) == 3, "the byte slice under-fills rather than mojibake-ing");
}

fn test_ranges_and_bounds() {
  s = "héllo";
  assert(s.char_slice(1, 3) == "él", "a middle range");
  assert(s.char_slice(0, 0) == "", "an empty range");
  assert(s.char_slice(3, 1) == "", "a reversed range answers empty, not an error");
  assert(s.char_slice(0, 99) == s, "past the end clamps");
  assert(s.char_slice(-99, 99) == s, "and clamps at both ends");
  assert("".char_slice(0, 3) == "", "an empty input");
}

// Negative bounds count from the end, as a byte slice's do — one convention, not
// two.
fn test_negative_bounds_count_from_the_end() {
  s = "héllo";
  assert(s.char_slice(-2, 5) == "lo", "the last two characters");
  assert(s.char_slice(-99, 2) == "hé", "a negative start clamps to the beginning");
  assert(s.char_slice(0, -1) == "héll", "a negative end drops the last character");
}

// Wider characters, because two bytes is the easy case.
fn test_it_counts_characters_of_every_width() {
  assert("日本語".char_slice(1, 3) == "本語", "three-byte characters");
  assert("a😃b".char_slice(1, 2) == "😃", "a four-byte character");
  assert("a♥b".char_slice(0, 2) == "a♥", "mixed widths");
  assert(len("a😃b".char_slice(0, 2)) == 2, "the count is characters throughout");
}

// The three shapes the libraries hand-rolled, all composable from this one.
fn test_it_covers_what_the_libraries_wrote_by_hand() {
  s = "héllo";
  // text2d's `take_chars(s, n)`
  assert(s.char_slice(0, 4) == "héll", "a prefix");
  // stage's `chars_between(s, a, b)`
  assert(s.char_slice(1, 3) == "él", "a range");
  // stage's `splice(s, from, to, ins)` — replace [1,3) with "X"
  spliced = s.char_slice(0, 1) + "X" + s.char_slice(3, len(s));
  assert(spliced == "hXlo", "and a splice, from two slices: {spliced}");
}
