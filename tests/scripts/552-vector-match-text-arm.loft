//
// #552 — a native vector-match arm mixing a text-returning CALL (an owned `Str`) with a bare
// text LITERAL (`&str`) generated a non-unifying `if`/`else` (E0308 "expected `Str`, found
// `&str`").  The desugar now unifies both arms to owned `String`.  --native-only bug; interp
// was always correct.  Runs on both backends.
fn g(n: integer) -> text {
  if n > 0 { "pos" } else { "neg" }
}
fn h(v: vector<integer>) -> text {
  match v { [x, ..] => g(x), _ => "empty" }
}
fn litfirst(v: vector<integer>) -> text {
  match v { [x, ..] => "has", _ => g(len(v)) }
}
fn main() {
  assert(h([5]) == "pos", "call-then-literal (h(5))");
  assert(h([0]) == "neg", "call arm negative (h(0))");
  assert(h([] as vector<integer>) == "empty", "literal arm (h empty)");
  assert(litfirst([7]) == "has", "literal-then-call (has)");
  assert(litfirst([] as vector<integer>) == "neg", "literal-then-call (g(0)=neg)");
  print("552 vector-match text arm ok\n");
}
