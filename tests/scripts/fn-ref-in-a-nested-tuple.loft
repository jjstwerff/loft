//
// A `fn(…)` member of a tuple nested INSIDE another tuple, at any depth.
//
// loft#1069 taught the tuple literal that a fn-ref member is the whole 20-byte pair —
// an 8-byte d_nr plus a 12-byte closure DbRef — and not the lone d_nr a bare name lowers
// to.  It read the TOP-LEVEL members, so nesting depth is the axis that fix held fixed,
// and one level in everything it repaired was broken again:
//
//   t: ((fn(integer) -> integer, integer), text) = ((dbl, 1), "z");
//
// That program has no assignment in it at all.  The LITERAL alone panicked
// `fn_call_ref: fn_var=16 < 20` on `--interpret`, and on `--native` rustc refused it —
// `((710_i64, 1_i64), "z".to_string())` against `(((u32, DbRef), i64), String)`.
//
// Three sites had the same shallow reading, and each is worth naming because they fail
// in different places:
//
//   * the interpreter's literal push was GATED by `elems.iter().any(is Function)`, which
//     is false for `[Tuple([Function, Integer]), Text]` — so the member-aware path was
//     skipped entirely and the whole literal went through the plain push;
//   * the native emitter TAKES its declared-slot list per tuple, so the inner arm ran
//     with an empty list and never asked for the pair — and its gate in dispatch.rs had
//     the same shallow `any(is Function)`, so the list was never populated to begin with;
//   * the native fn-ref REACHABILITY walk read top-level members only, so a function
//     reachable only through a nested member was pruned and left with no arm in the
//     dispatch: `invalid fn-ref: 710` at the call, after the other two were fixed.
//
// All three now decide with ONE predicate, `data::tuple_carries_fn_ref`, which sees
// through nesting.  That it is one function and not three copies is deliberate: loft#1006
// was two copies of a tuple element list disagreeing, and this is the same hazard.
//
// `test_a_nested_tuple_with_no_fn_member_is_unchanged` is the control — the fix keys on a
// member that CARRIES a fn-ref, so an ordinary nested tuple must take exactly the path it
// always did.  `test_a_nested_capturing_lambda` is the other control: a capturing source
// already emits the pair, so it must not be double-wrapped.
//
// `test_reading_a_plain_member_beside_a_nested_fn` is the reading that showed the blast
// radius in loft#1069 and shows it again here, harder.  It calls nothing — and on the
// pre-fix tree it is the cell that fails WORST: not a runtime fault but an ICE,
// `attempt to subtract with overflow` in codegen, on both backends, while the cells that
// actually call a nested fn merely panicked or failed to compile.  An under-pushed member
// moves every later member's offset and the tuple's own base with it, so the damage lands
// on whoever reads next, and that reader need have nothing to do with functions.
//
// (Measured on a pristine tree at 84b37676: `((dbl, 1), "z")` called → panic
// `fn_var=16 < 20` on `--interpret` and rustc E0308 on `--native`; depth 3 → the same;
// plain-member read → the ICE.  All three are this one cause.)
//
// ⚠ EVERY cell here READS the tuple back, and on this bug that is not a stylistic
// preference — it is what makes the interpret half of the file mean anything.  The two
// backends fail at different TIMES: `--native` fails at compile time, so merely
// constructing a nested fn-carrying tuple is enough to fail it, while `--interpret` only
// faults when the value is actually read.  So a probe that builds the tuple and never
// touches it prints "built" on the interpreter and reports the bug as native-only — which
// is exactly what a second measurement of this shape did, with
// `warning[never-read]: Variable t is never read` sitting in its own output as the tell.
// A construct-only cell here would pass VACUOUSLY on one backend while reading as though
// it covered both.

fn nst_dbl(x: integer) -> integer { x * 2 }
fn nst_inc(x: integer) -> integer { x + 1 }

fn test_a_fn_in_the_inner_tuple() {
  t: ((fn(integer) -> integer, integer), text) = ((nst_dbl, 1), "z");
  assert(t.0.0(3) == 6, "the nested fn member: got {t.0.0(3)}");
  assert(t.0.1 == 1, "the member beside it: got {t.0.1}");
  assert(t.1 == "z", "the outer member after it: got {t.1}");
}

fn test_the_nested_tuple_in_the_second_position() {
  t: (integer, (fn(integer) -> integer, integer)) = (5, (nst_dbl, 2));
  assert(t.0 == 5, "the outer member before it: got {t.0}");
  assert(t.1.0(3) == 6, "the nested fn member: got {t.1.0(3)}");
  assert(t.1.1 == 2, "the member beside it: got {t.1.1}");
}

fn test_two_nested_fn_members_stay_distinct() {
  t: ((fn(integer) -> integer, fn(integer) -> integer), integer) = ((nst_dbl, nst_inc), 1);
  assert(t.0.0(3) == 6, "the first nested fn: got {t.0.0(3)}");
  assert(t.0.1(3) == 4, "the second nested fn: got {t.0.1(3)}");
  assert(t.1 == 1, "the member after them: got {t.1}");
}

fn test_depth_three() {
  t: (((fn(integer) -> integer, integer), integer), integer) = (((nst_dbl, 1), 2), 3);
  assert(t.0.0.0(3) == 6, "a fn two levels in: got {t.0.0.0(3)}");
  assert(t.0.0.1 == 1, "beside it: got {t.0.0.1}");
  assert(t.0.1 == 2, "one level out: got {t.0.1}");
  assert(t.1 == 3, "the outermost member: got {t.1}");
}

fn test_reading_a_plain_member_beside_a_nested_fn() {
  // Calls nothing.  It faulted anyway before the fix — the member that broke the tuple
  // was not the member being read.
  t: ((fn(integer) -> integer, integer), text) = ((nst_dbl, 1), "z");
  assert(t.0.1 == 1, "a plain inner member: got {t.0.1}");
  assert(t.1 == "z", "a plain outer member: got {t.1}");
}

fn test_a_nested_capturing_lambda() {
  // Control: a capturing source already emits the pair, so this must not be double-wrapped.
  k = 10;
  t: ((fn(integer) -> integer, integer), text) = ((fn(x: integer) -> integer { x + k }, 1), "z");
  assert(t.0.0(3) == 13, "a nested capturing lambda: got {t.0.0(3)}");
  assert(t.0.0(5) == 15, "the capture survives a second call: got {t.0.0(5)}");
  assert(t.0.1 == 1, "the member beside it: got {t.0.1}");
  assert(t.1 == "z", "the outer member after it: got {t.1}");
}

fn test_assigning_into_a_nested_fn_member() {
  t: ((fn(integer) -> integer, integer), text) = ((nst_dbl, 1), "z");
  assert(t.0.0(3) == 6, "before the assignment: got {t.0.0(3)}");
  t.0.0 = nst_inc;
  assert(t.0.0(3) == 4, "after assigning a bare name: got {t.0.0(3)}");
  assert(t.0.1 == 1, "the member beside it: got {t.0.1}");
  assert(t.1 == "z", "the outer member after it: got {t.1}");
}

// Declared BEFORE its use on purpose.  A forward-referenced fn name in a tuple LITERAL
// member resolves to `unknown` and the literal is rejected — measured flat AND nested, so
// it is NOT the nesting axis this file is about, and it is not a workaround being hidden
// either: the same forward reference is accepted as a plain local, as a call argument, and
// as a member ASSIGNMENT, which is what makes the literal position the odd one out
// (loft#1073).  Orthogonal to what this file pins, so the declaration is simply moved up.
fn nst_only_nested(x: integer) -> integer { x + 30 }

fn test_a_fn_reachable_only_through_a_nested_member() {
  // `nst_only_nested` is named NOWHERE else.  Before the reachability walk learned to
  // recurse, it was pruned and the call panicked `invalid fn-ref` on `--native` while
  // `--interpret` ran it.
  t: ((fn(integer) -> integer, integer), text) = ((nst_only_nested, 1), "z");
  assert(t.0.0(3) == 33, "a fn reachable only through a nested member: got {t.0.0(3)}");
  assert(t.1 == "z", "the outer member after it: got {t.1}");
}

fn test_a_nested_tuple_with_no_fn_member_is_unchanged() {
  // Control: the fix keys on a member that CARRIES a fn-ref, so this must take exactly the
  // path it always did.
  t: ((integer, integer), text) = ((1, 2), "z");
  assert(t.0.0 == 1, "plain nested integer: got {t.0.0}");
  assert(t.0.1 == 2, "plain nested integer: got {t.0.1}");
  assert(t.1 == "z", "plain outer text: got {t.1}");
}

fn main() {
  test_a_fn_in_the_inner_tuple();
  test_the_nested_tuple_in_the_second_position();
  test_two_nested_fn_members_stay_distinct();
  test_depth_three();
  test_reading_a_plain_member_beside_a_nested_fn();
  test_a_nested_capturing_lambda();
  test_assigning_into_a_nested_fn_member();
  test_a_fn_reachable_only_through_a_nested_member();
  test_a_nested_tuple_with_no_fn_member_is_unchanged();
}
