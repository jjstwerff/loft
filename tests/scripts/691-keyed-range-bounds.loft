//
// Regression (loft#691): a keyed range slice honours BOTH its bounds, in both
// directions, on `sorted` and `index` alike.
//
// The filed symptom was `rev(coll[lo..])` ignoring its lower bound, but the matrix
// found four faults sharing one cause — the cursors were derived per direction, so
// reverse drifted from forward:
//
//   1. `sorted` reverse never compared the cursor against `finish` at all, so every
//      reverse range ran on to the first element.
//   2. `index` reverse put `finish` one node BELOW the lower bound, so it yielded
//      exactly one element too many.
//   3. An INCLUSIVE upper bound stepped one too far in reverse: `rev(c[2..=4])`
//      began at 5.
//   4. `tree::find` returned the leaf the descent ended on, which for a key NOT in
//      the tree sits on whichever side the tree shape put it.  That is a FORWARD
//      bug too, and the common case rather than an edge one — bounds rarely match
//      stored keys exactly.  `ix[15..35]` over keys 10,20,30,40 returned 40.
//
// So `iterate` now derives ONE pair of facts — the lowest and highest node the range
// contains — and each direction names which end it starts from; an empty range is
// signalled distinctly, because `0` already means "walk to that end of the tree".
// That sentinel is also why an ABSENT bound stays `0` rather than the concrete
// first/last node: `#remove` during iteration restructures the tree under the walk,
// and a baked end node stops it early.
//
// Axes: collection kind (`sorted` / `index`), direction (forward / `rev`), which side
// is bounded (both / open end / open start / fully open), bound exclusivity
// (`..` / `..=`), and where the bound falls relative to stored keys (on a key,
// BETWEEN keys, outside the range entirely, inverted).  Keys are 1..5 so an
// off-by-one is visible; the gapped block below uses 10,20,30,40 so a bound can land
// between keys.  Every expectation is hand-computed; the upper bound is EXCLUSIVE
// unless written `..=`.

struct R691 { k: integer, v: integer }

// Visit `slice` and return the keys in visit order, so both membership AND
// direction are asserted.
fn s691_walk_sorted(h: sorted<R691[k]>, which: integer) -> text {
  if which < 11 { return s691_walk_sorted_lo(h, which); }
  s691_walk_sorted_hi(h, which)
}

fn s691_walk_sorted_lo(h: sorted<R691[k]>, which: integer) -> text {
  s = "";
  if which == 0  { for a in h[2..4]      { s = "{s}{a.k}"; } }
  if which == 1  { for b in rev(h[2..4]) { s = "{s}{b.k}"; } }
  if which == 2  { for c in h[2..=4]     { s = "{s}{c.k}"; } }
  if which == 3  { for d in rev(h[2..=4]){ s = "{s}{d.k}"; } }
  if which == 4  { for e in h[2..]       { s = "{s}{e.k}"; } }
  if which == 5  { for f in rev(h[2..])  { s = "{s}{f.k}"; } }
  if which == 6  { for g in h[..4]       { s = "{s}{g.k}"; } }
  if which == 7  { for i in rev(h[..4])  { s = "{s}{i.k}"; } }
  if which == 8  { for j in h[..]        { s = "{s}{j.k}"; } }
  if which == 9  { for l in rev(h[..])   { s = "{s}{l.k}"; } }
  if which == 10 { for m in h[..=4]      { s = "{s}{m.k}"; } }
  s
}

fn s691_walk_sorted_hi(h: sorted<R691[k]>, which: integer) -> text {
  s = "";
  if which == 11 { for n in rev(h[..=4]) { s = "{s}{n.k}"; } }
  if which == 12 { for o in h[3..=3]     { s = "{s}{o.k}"; } }
  if which == 13 { for p in rev(h[3..=3]){ s = "{s}{p.k}"; } }
  if which == 14 { for q in h[0..9]      { s = "{s}{q.k}"; } }
  if which == 15 { for t in rev(h[0..9]) { s = "{s}{t.k}"; } }
  if which == 16 { for u in h[9..]       { s = "{s}{u.k}"; } }
  if which == 17 { for w in rev(h[9..])  { s = "{s}{w.k}"; } }
  if which == 18 { for x in h[0..1]      { s = "{s}{x.k}"; } }
  if which == 19 { for y in rev(h[0..1]) { s = "{s}{y.k}"; } }
  if which == 20 { for z in h[3..3]      { s = "{s}{z.k}"; } }
  if which == 21 { for aa in rev(h[3..3]){ s = "{s}{aa.k}"; } }
  s
}

fn s691_walk_index(h: index<R691[k]>, which: integer) -> text {
  if which < 11 { return s691_walk_index_lo(h, which); }
  s691_walk_index_hi(h, which)
}

fn s691_walk_index_lo(h: index<R691[k]>, which: integer) -> text {
  s = "";
  if which == 0  { for a in h[2..4]      { s = "{s}{a.k}"; } }
  if which == 1  { for b in rev(h[2..4]) { s = "{s}{b.k}"; } }
  if which == 2  { for c in h[2..=4]     { s = "{s}{c.k}"; } }
  if which == 3  { for d in rev(h[2..=4]){ s = "{s}{d.k}"; } }
  if which == 4  { for e in h[2..]       { s = "{s}{e.k}"; } }
  if which == 5  { for f in rev(h[2..])  { s = "{s}{f.k}"; } }
  if which == 6  { for g in h[..4]       { s = "{s}{g.k}"; } }
  if which == 7  { for i in rev(h[..4])  { s = "{s}{i.k}"; } }
  if which == 8  { for j in h[..]        { s = "{s}{j.k}"; } }
  if which == 9  { for l in rev(h[..])   { s = "{s}{l.k}"; } }
  if which == 10 { for m in h[..=4]      { s = "{s}{m.k}"; } }
  s
}

fn s691_walk_index_hi(h: index<R691[k]>, which: integer) -> text {
  s = "";
  if which == 11 { for n in rev(h[..=4]) { s = "{s}{n.k}"; } }
  if which == 12 { for o in h[3..=3]     { s = "{s}{o.k}"; } }
  if which == 13 { for p in rev(h[3..=3]){ s = "{s}{p.k}"; } }
  if which == 14 { for q in h[0..9]      { s = "{s}{q.k}"; } }
  if which == 15 { for t in rev(h[0..9]) { s = "{s}{t.k}"; } }
  if which == 16 { for u in h[9..]       { s = "{s}{u.k}"; } }
  if which == 17 { for w in rev(h[9..])  { s = "{s}{w.k}"; } }
  if which == 18 { for x in h[0..1]      { s = "{s}{x.k}"; } }
  if which == 19 { for y in rev(h[0..1]) { s = "{s}{y.k}"; } }
  if which == 20 { for z in h[3..3]      { s = "{s}{z.k}"; } }
  if which == 21 { for aa in rev(h[3..3]){ s = "{s}{aa.k}"; } }
  s
}

fn s691_expected(which: integer) -> text {
  if which == 0  { return "23"; }     // [2,4)         forward
  if which == 1  { return "32"; }     // same set, reversed
  if which == 2  { return "234"; }    // [2,4]         inclusive upper
  if which == 3  { return "432"; }
  if which == 4  { return "2345"; }   // [2, end)      open end
  if which == 5  { return "5432"; }
  if which == 6  { return "123"; }    // (start, 4)    open start
  if which == 7  { return "321"; }
  if which == 8  { return "12345"; }  // fully open
  if which == 9  { return "54321"; }
  if which == 10 { return "1234"; }   // (start, 4]
  if which == 11 { return "4321"; }
  if which == 12 { return "3"; }      // [3,3]         one element
  if which == 13 { return "3"; }
  if which == 14 { return "12345"; }  // bounds OUTSIDE the key range
  if which == 15 { return "54321"; }
  if which == 16 { return ""; }       // lower bound above every key
  if which == 17 { return ""; }
  if which == 18 { return ""; }       // upper bound below every key
  if which == 19 { return ""; }
  if which == 20 { return ""; }       // [3,3) — degenerate, empty
  if which == 21 { return ""; }
  ""
}

fn main() {
  s: sorted<R691[k]> = [];
  x: index<R691[k]> = [];
  for i in 1..6 {
    s += R691 { k: i, v: i };
    x += R691 { k: i, v: i };
  }

  // The core invariant: `rev(X)` visits exactly the set `X` visits, reversed — and
  // both match the hand-computed answer.  Run BOTH collection kinds over the same
  // table, because the two took different wrong turns for the same slice.
  for w in 0..22 {
    want = s691_expected(w);
    got_s = s691_walk_sorted(s, w);
    got_x = s691_walk_index(x, w);
    assert(got_s == want, "sorted case {w}: expected '{want}', got '{got_s}'");
    assert(got_x == want, "index case {w}: expected '{want}', got '{got_x}'");
  }

  // GAPPED keys — a bound that falls BETWEEN stored keys.  This is the ordinary
  // case (bounds rarely land on a stored key), and it was wrong FORWARD too:
  // `ix[15..35]` returned key 40, one past the exclusive upper bound.
  g: index<R691[k]> = [];
  g += R691 { k: 10, v: 1 };
  g += R691 { k: 20, v: 2 };
  g += R691 { k: 30, v: 3 };
  g += R691 { k: 40, v: 4 };

  gf = "";
  for a in g[15..35] { gf = "{gf}{a.k}-"; }
  assert(gf == "20-30-", "gapped forward [15,35) is 20,30 — got '{gf}'");

  gr = "";
  for b in rev(g[15..35]) { gr = "{gr}{b.k}-"; }
  assert(gr == "30-20-", "gapped reverse [15,35) is 30,20 — got '{gr}'");

  gi = "";
  for c in g[15..=30] { gi = "{gi}{c.k}-"; }
  assert(gi == "20-30-", "gapped forward [15,30] is 20,30 — got '{gi}'");

  gj = "";
  for d in rev(g[15..=30]) { gj = "{gj}{d.k}-"; }
  assert(gj == "30-20-", "gapped reverse [15,30] is 30,20 — got '{gj}'");

  // An INVERTED range must terminate empty, not run off the end of the tree.
  gk = "";
  for e in g[35..15] { gk = "{gk}{e.k}-"; }
  assert(gk == "", "inverted forward range is empty — got '{gk}'");

  gl = "";
  for f in rev(g[35..15]) { gl = "{gl}{f.k}-"; }
  assert(gl == "", "inverted reverse range is empty — got '{gl}'");

  // `tree::find` is shared with the exact-key lookup, so pin that it still answers
  // correctly for keys present, absent-between, and absent-outside.
  hit = g[20];
  assert(hit != null, "an exact key still resolves");
  assert(hit.v == 2, "exact lookup value, got {hit.v}");
  assert(g[25] == null, "a key BETWEEN stored keys is absent");
  assert(g[5] == null, "a key below every stored key is absent");
  assert(g[45] == null, "a key above every stored key is absent");

  // An empty collection answers every form without faulting.
  e691: index<R691[k]> = [];
  ec = 0;
  for m in e691[1..9] { ec += m.v; }
  for n in rev(e691[..]) { ec += n.v; }
  assert(ec == 0, "every form over an empty collection yields nothing, got {ec}");

  // A single element, reached from both ends and through an inclusive range.
  o691: index<R691[k]> = [];
  o691 += R691 { k: 7, v: 7 };
  os = "";
  for o in o691[..]        { os = "{os}{o.k}"; }
  for p in rev(o691[..])   { os = "{os}{p.k}"; }
  for q in o691[7..=7]     { os = "{os}{q.k}"; }
  for t in rev(o691[7..=7]){ os = "{os}{t.k}"; }
  assert(os == "7777", "single element from every direction, got '{os}'");

  println("691-keyed-range-bounds ok");
}
