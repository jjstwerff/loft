//
// A generic reached ONLY through another generic was never monomorphised.
//
// Instantiation happens at a call site with a CONCRETE argument type, and inside
// a generic template that argument is the type variable — so `fn outer<S>(s: S)
// { inner(s) }` is the one shape where nobody ever names `inner`'s concrete
// form.  The monomorph of `outer` kept its call pointed at the generic template,
// which nothing emits: native could not find `n_inner`, and the interpreter
// entered a template whose frame did not match the call and lost it whole — no
// output, exit 0.  Through the @PLN23 SQL fixtures it read as a corrupt
// `store_nr` and a SIGSEGV.
//
// Adding ANY direct `inner(box)` call elsewhere in the program hid it, which is
// why it survived: the fixtures that exercise nested generics happen to call the
// inner one directly too.  So every cell below is written WITHOUT a direct call
// — that absence is the test.
//
// Not covered here: a SELF-recursive generic panics `variables/mod.rs`
// independently of this (a direct call panics too) — loft#761.

interface Shape {
  fn area(self: Self) -> integer
  fn tag(self: Self) -> text
}

struct Box { w: integer, h: integer }
fn area(self: Box) -> integer { return self.w * self.h; }
fn tag(self: Box) -> text { if self.w > 0 { return "B" } return "b"; }

struct Disc { r: integer }
fn area(self: Disc) -> integer { return self.r * self.r * 3; }
fn tag(self: Disc) -> text { if self.r > 0 { return "D" } return "d"; }

// --- depth 2: the plain shape -----------------------------------------------
fn inner_int <S: Shape> (s: S) -> integer { return s.area() + 1; }
fn outer_int <S: Shape> (s: S) -> integer { return inner_int(s) * 10; }

// --- depth 3: the middle generic is reached only from the outer one ----------
fn lvl3 <S: Shape> (s: S) -> integer { return s.area() + 1; }
fn lvl2 <S: Shape> (s: S) -> integer { return lvl3(s) * 2; }
fn lvl1 <S: Shape> (s: S) -> integer { return lvl2(s) * 10; }

// --- a `text` return, which travels through a HIDDEN `&text` buffer ----------
//
// The callee is promoted to deliver its text through a retbuf, so a call that
// was built before the promotion is one argument short of the ABI it now
// targets.  Retargeting alone left "Too few parameters on t_3Box_inner_text
// (got 1, need 2)" — the same ICE shape loft#733 named.
fn inner_text <S: Shape> (s: S) -> text { return s.tag() + "!"; }
fn outer_text <S: Shape> (s: S) -> text { return "<" + inner_text(s) + ">"; }

// --- a text leaf under an integer middle, so both ABIs meet in one chain -----
fn leaf <S: Shape> (s: S) -> text { return s.tag(); }
fn mid <S: Shape> (s: S) -> integer { return size(leaf(s)) + s.area(); }
fn top <S: Shape> (s: S) -> integer { return mid(s) * 2; }

fn main() {
  b = Box { w: 3, h: 4 };
  c = Disc { r: 5 };

  // 3*4=12 -> inner 13 -> outer 130
  assert(outer_int(b) == 130, "depth 2: {outer_int(b)}, want 130");

  // The SAME nested generic instantiated for a second concrete type:
  // 5*5*3=75 -> inner 76 -> outer 760
  assert(outer_int(c) == 760, "depth 2, second type: {outer_int(c)}, want 760");

  // 12 -> 13 -> 26 -> 260
  assert(lvl1(b) == 260, "depth 3: {lvl1(b)}, want 260");

  // "B" -> "B!" -> "<B!>"
  assert(outer_text(b) == "<B!>", "text return: {outer_text(b)}, want <B!>");
  assert(outer_text(c) == "<D!>", "text return, second type: {outer_text(c)}, want <D!>");

  // Disc: area 75, tag "D" (1 byte) -> mid 76 -> top 152
  assert(top(c) == 152, "mixed returns: {top(c)}, want 152");

  println("nested-generic monomorph ok");
}
