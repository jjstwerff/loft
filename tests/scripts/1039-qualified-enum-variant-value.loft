// loft#1039 — a library-qualified enum variant in VALUE position (`lib::Enum.Variant`).
//
// Every other qualified spelling resolved: `std::abs(-5)` (a function), `lib::CONST` (a
// constant), `lib::Struct { … }` (a literal), and `f: std::Format = NotExists` (the enum
// as a TYPE).  Only the VALUE spelling fell through to the variable resolver, which was
// handed the QUALIFIER — so `std::Format.NotExists` reported *"Unknown variable 'std'"*,
// naming the library while the enum sat one token to its right.  It bites hardest under
// an alias-only `use lib as a;`, where the qualifier is the whole point and the bare
// spelling is not imported at all.
fn main() {
  // The value spelling, and the bare spelling it has to agree with.
  f = std::Format.NotExists;
  b = Format.NotExists;
  assert(f == b, "qualified variant == bare variant");
  assert("{f}" == "NotExists", "qualified variant renders as itself");

  // Two variants of the same enum, so the resolution is really per-variant and not a
  // constant that happens to land on the first one.
  d = std::Format.Directory;
  assert(d != f && "{d}" == "Directory", "a second qualified variant of the same enum");

  // The type position kept working; both spellings still meet in one comparison.
  t: std::Format = NotExists;
  assert(t == f, "type-position spelling meets the value-position one");

  // The qualified enum is also usable where an enum VALUE is expected.
  assert(match std::Format.Directory { Directory => true, _ => false }, "matched");
}
