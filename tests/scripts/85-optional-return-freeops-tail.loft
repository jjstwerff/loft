// @PLN85 / routing feedback (2026-07-02): a `-> τ?` (Optional scalar/text) function whose
// TAIL is a call with pending scope free-ops (here: the `__work_N` free of a CONSTRUCTED
// text argument) must claim the call result via the B5-L3 `__ret_N` wrap.  Before the
// `is_value_return_type`/text-arm `.base()` peels in scopes.rs, an Optional return fell
// through the wrap: the tail call was emitted as a DISCARDED statement + a fabricated
// `return null` — interp read stale TOS (accidentally right), native returned `0.0`, a
// SILENT NON-NULL corruption (`h != null` saw a value).  The nastiest failure class for
// the null model: no crash, no leak, no null — a wrong value.
//
// Cells: value path + null path, for float? / integer? / text?; literal-arg twins were
// never broken (no free-ops pending) but pin the contrast.

fn getf(v: vector<float>, key: text) -> float? {
  if key == "5" { return v[0]; }
  null
}

fn midf(v: vector<float>) -> float? {
  n = 5;
  getf(v, "{n}")   // constructed arg → __work free runs before the return
}

fn midf_null(v: vector<float>) -> float? {
  n = 7;
  getf(v, "{n}")
}

fn midf_lit(v: vector<float>) -> float? {
  getf(v, "5")
}

fn geti(v: vector<integer>, key: text) -> integer? {
  if key == "5" { return v[0]; }
  null
}

fn midi(v: vector<integer>) -> integer? {
  n = 5;
  geti(v, "{n}")
}

fn gett(key: text) -> text? {
  if key == "5" { return "hello"; }
  null
}

fn midt() -> text? {
  n = 5;
  gett("{n}")
}

fn midt_null() -> text? {
  n = 7;
  gett("{n}")
}

fn main() {
  vf: vector<float> = [];
  vf += [42.5];
  vi: vector<integer> = [];
  vi += [4242];

  hf = midf(vf);
  assert(hf != null, "float? value path is non-null");
  assert((hf ?? -1.0) == 42.5, "float? value: {hf ?? -1.0} (expect 42.5)");

  hn = midf_null(vf);
  assert(hn == null, "float? null path stays null (got {hn ?? -1.0})");

  hl = midf_lit(vf);
  assert((hl ?? -1.0) == 42.5, "float? literal twin: {hl ?? -1.0}");

  hi = midi(vi);
  assert((hi ?? -1) == 4242, "integer? value: {hi ?? -1} (expect 4242)");

  st = midt();
  assert((st ?? "MISS") == "hello", "text? value: {st ?? "MISS"}");
  sn = midt_null();
  assert(sn == null, "text? null path stays null");

  println("optional-return-freeops-tail ok");
}
