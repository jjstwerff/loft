// Pass-2 wave 5 regression (STABILITY_PASS2.md): `assign_text`'s
// self-reference protection used a private walker
// (`code_references_var`) that missed If / Block / Loop descent — a
// text Set whose RHS reads the assigned var only inside one of those
// shapes skipped the protective work-text wrapping, and the
// clear-before-evaluate Set semantics could read the var AFTER it had
// been cleared.  The predicate is now the shared `Value::reads_var`
// (full descent).  These pin the widened shapes on both backends.

fn test_if_rhs() {
  s = "abc";
  flag = true;
  s = if flag { s + "def" } else { "x" };
  assert(s == "abcdef", "if-rhs self-append: got {s}");
}

fn test_block_rhs() {
  t = "base";
  t = { extra = "-tail"; t + extra };
  assert(t == "base-tail", "block-rhs self-append: got {t}");
}

fn test_loop_built() {
  u = "x";
  for i in 0..3 {
    u = if i % 2 == 0 { u + "a" } else { u + "b" };
  }
  assert(u == "xaba", "loop if-rhs: got {u}");
}
