//
// `return <text-fn>(<record-returning-call>(…))` inside a loop must COMPILE on
// `--native`.
//
// It did not. The record call is lifted into a `__lift_N` temp, which makes the
// assignment's right-hand side an `Insert`; the `Set(var, Insert(…))` arm in
// `src/generation/dispatch.rs` emitted its tail with no storage-form coercion,
// so a text-returning callee's `Str` landed in a local declared `String` and
// rustc refused the generated file with E0308. The interpreter was correct
// throughout — this was a native BUILD failure, not a wrong answer.
//
// It is the exact shape loft#672 fixed for `boolean` ("the boolean landed here
// uncast"), one type over: that fix tested the tail per-shape instead of keying
// on the variable's type, which is what left the hole. The coercion is now
// keyed on the variable's type like the other three text-assignment paths in
// that function.
//
// **Both axes are needed**, which is why the passing cells are here beside the
// failing one: hoisting the record into a local removes the lift, and outside a
// loop the assignment never reaches the `Insert` arm. A guard with only the
// failing shape would not show that.

struct V { kind: integer, t: text }

fn make(s: text) -> V { return V { kind: 6, t: s }; }

/// Several returns, some interpolated — the shape that makes the callee answer
/// `Str` rather than an owned `String`.
fn cell(v: V) -> text {
  if v.kind == 6 { return "[{v.t}]" }
  return "-";
}

/// THE CELL THAT BROKE: in a loop, and the argument is freshly returned.
fn lifted_in_loop(name: text) -> text {
  for _ in 0..2 { return cell(make(name)) }
  return "?unreached";
}

/// Same call, outside a loop — passed before, must keep passing.
fn lifted_bare(name: text) -> text { return cell(make(name)); }

/// In a loop, but the record is a local — passed before, must keep passing.
fn local_in_loop(name: text) -> text {
  v = make(name);
  for _ in 0..2 { return cell(v) }
  return "?unreached";
}

/// In a loop, nested one deeper — the shape the @PLN23 value-reflection guard
/// originally walked into.
fn lifted_in_loop_if(name: text) -> text {
  for i in 0..2 {
    if i == 0 { return cell(make(name)) }
  }
  return "?unreached";
}

fn main() {
  assert(lifted_in_loop("ada") == "[ada]", "lifted in loop: {lifted_in_loop("ada")}");
  assert(lifted_bare("ada") == "[ada]", "lifted bare: {lifted_bare("ada")}");
  assert(local_in_loop("ada") == "[ada]", "local in loop: {local_in_loop("ada")}");
  assert(lifted_in_loop_if("ada") == "[ada]", "lifted in loop+if: {lifted_in_loop_if("ada")}");

  // The loop must still be able to fall through rather than always returning on
  // the first pass — otherwise the four cells above would pass for a reason
  // that has nothing to do with the fix.
  assert(lifted_in_loop("") == "[]", "empty name: {lifted_in_loop("")}");

  println("text call on lifted record ok");
}
