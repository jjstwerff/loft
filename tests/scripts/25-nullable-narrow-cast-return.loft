// SPDX-License-Identifier: LGPL-3.0-or-later
// @PLN25 — `e as τ?` (checked narrowing cast) returned directly as a function's tail
// expression, into a nullable-narrow return type (`u8?`/`u16?`/`i16?`).
// The cast now types `Optional(τ)` (dn4_checked_cast), so returning it into a `τ?` slot
// is an exact type match — not an implicit narrow of a bare integer. Before, the cast
// typed as the full source integer, so the tail form was rejected ("cannot implicitly
// narrow integer to u8") even though the identical `r = e as τ?; r` local form worked.
// Both-backend guard: it must behave identically on --interpret and --native.
fn tail_u8(i: integer) -> u8? {
  i as u8?
}
fn tail_u16(i: integer) -> u16? {
  i as u16?
}
fn tail_i16(i: integer) -> i16? {
  i as i16?
}

fn main() {
  // A RETURN is a slot, so the reserved edge is null there (@FR-N-Reserve).
  //
  // This file used to assert the opposite — *"255 is a VALUE, not null — the nullable narrow
  // is carried full-width (i64), so the top-of-range value stays distinct from null"* — and
  // that reasoning runs the model backwards.  `formal/types.md` § Representation says how a
  // null is stored "follows from the base type and is NOT part of the type", so which
  // register a value happens to sit in cannot decide what values the type has; the same
  // section says the narrow sentinel is "excluded from `τ?`'s non-null range", full stop.
  // Reading it off the representation is what let a `u8?` hold 255 in a local and read back
  // null the moment it reached a field, with an in-range `250 + 5` destroyed on the way
  // (loft#1249).  A CAST in flight still keeps it — `255 as u8?` is 255 — because an
  // expression is not a slot; it is the `-> u8?` that spends the edge here.
  assert(tail_u8(255) == null, "255 returned as a u8? is null, got {tail_u8(255)}");
  assert(tail_u8(254) == 254, "254 is a u8? value, got {tail_u8(254)}");
  // out of the u8 range -> the checked cast yields null, as it always did.
  assert(tail_u8(300) == null, "tail_u8(300) should be null");
  // u16 (2-byte): the same, one width up.
  assert(tail_u16(65535) == null, "65535 is the null of a u16?, got {tail_u16(65535)}");
  assert(tail_u16(65534) == 65534, "65534 is a u16? value, got {tail_u16(65534)}");
  assert(tail_u16(70000) == null, "tail_u16(70000) should be null");
  // A SIGNED narrow spends its BOTTOM code, so its top stays a value — the cell that
  // separates "reserve the edge that matches the sign" from "reserve the top".
  assert(tail_i16(-5) == -5, "tail_i16(-5)={tail_i16(-5)}");
  assert(tail_i16(-32768) == null, "-32768 is the null of an i16?, got {tail_i16(-32768)}");
  assert(tail_i16(32767) == 32767, "an i16? keeps its top value, got {tail_i16(32767)}");
  assert(tail_i16(999999) == null, "tail_i16(999999) should be null");
}
