// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Regression: a function-returned `text` passed straight into a callee that COPIES
// its bytes was handed a buffer the callee then overwrote — `wrap(src())` returned
// "[[i]" instead of "[hi]" on the interpreter, and on `--native` the backing String
// was dropped while a `&str` still pointed into it, a null-pointer copy (loft#671).
//
// Both calls in the expression were given the SAME caller-allocated `&text`
// out-param buffer.  @PLN104 Phase B (`patch_tret_callers`) injects that buffer into
// an ALREADY-PARSED caller, whose pooling counters were reset to 0 when it was
// stored — so its first mint re-handed out the buffer the parse had already given to
// the outer call.  The phase syncs those counters past the names already present to
// prevent exactly this, but it synced only `__work_N`; the caller retbuf had moved to
// its own `__work_cN` counter (loft#662) and silently stopped being covered.
//
// Fixed by syncing EVERY pooled work-name counter at that re-entry.
//
// Note the masking property: any earlier use of the same callee gives the second call
// site a different buffer, so a program that touches the value first stays green over
// a broken path.  The `..._cold` cases below are therefore the first use in their
// function, deliberately.

// Returns owned text with no hidden retbuf of its own — the shape @PLN104 promotes.
fn t671_src() -> text { return "hi"; }
fn t671_src_arg(p: text) -> text { return "<{p}>"; }

// Callees that MATERIALISE the parameter's bytes (the ones that read from the buffer).
fn t671_wrap(x: text) -> text { return "[{x}]"; }
fn t671_concat(x: text) -> text { return "[" + x + "]"; }
fn t671_append(x: text) -> text { r = ""; r += x; return r; }
fn t671_two(a: text, b: text) -> text { return "[{a}{b}]"; }

// Pass-through and length-only callees never read the bytes — they stayed correct
// even while aliased, so they are the negative controls.
fn t671_id(x: text) -> text { return x; }
fn t671_len(x: text) -> integer { return len(x); }

fn t671_interpolate_cold() -> text { return t671_wrap(t671_src()); }
fn t671_concat_cold() -> text { return t671_concat(t671_src()); }
fn t671_append_cold() -> text { return t671_append(t671_src()); }

// The temporary in argument position 2, then position 1: the corruption differed per
// position ("[A[A]" vs "[[iA]"), which is what pinned the callee's output buffer and
// its argument to the same memory.
fn t671_second_arg_cold() -> text { return t671_two("A", t671_src()); }
fn t671_first_arg_cold() -> text { return t671_two(t671_src(), "A"); }

// TWO promoted calls plus the copying callee in one expression — three buffers that
// must all be distinct.
fn t671_both_args_cold() -> text { return t671_two(t671_src(), t671_src_arg("q")); }

// Nested through a pass-through, and through a second copying callee.
fn t671_nested_cold() -> text { return t671_wrap(t671_id(t671_src())); }
fn t671_double_cold() -> text { return t671_wrap(t671_wrap(t671_src())); }

// Every iteration reuses the caller buffer; the second pass over it must still read
// the value the call just delivered.
fn t671_in_loop_cold() -> text {
  acc = "";
  k = 0;
  while k < 3 { acc += t671_wrap(t671_src()); k += 1; }
  return acc;
}

// Controls that were correct before the fix and must stay correct.
fn t671_via_local() -> text { t = t671_src(); return t671_wrap(t); }
fn t671_literal_arg() -> text { return t671_wrap("hi"); }
fn t671_passthrough() -> text { return t671_id(t671_src()); }
fn t671_warmed() -> text { n = t671_len(t671_src()); return t671_wrap(t671_src()) + "{n}"; }

fn test_caller_retbuf_alias() {
  assert(t671_interpolate_cold() == "[hi]", "interpolating callee: {t671_interpolate_cold()}");
  assert(t671_concat_cold() == "[hi]", "concatenating callee: {t671_concat_cold()}");
  assert(t671_append_cold() == "hi", "appending callee: {t671_append_cold()}");
  assert(t671_second_arg_cold() == "[Ahi]", "temporary in arg 2: {t671_second_arg_cold()}");
  assert(t671_first_arg_cold() == "[hiA]", "temporary in arg 1: {t671_first_arg_cold()}");
  assert(t671_both_args_cold() == "[hi<q>]", "two temporaries: {t671_both_args_cold()}");
  assert(t671_nested_cold() == "[hi]", "through a pass-through: {t671_nested_cold()}");
  assert(t671_double_cold() == "[[hi]]", "two copying callees: {t671_double_cold()}");
  assert(t671_in_loop_cold() == "[hi][hi][hi]", "in a loop: {t671_in_loop_cold()}");

  assert(t671_via_local() == "[hi]", "bound to a local first: {t671_via_local()}");
  assert(t671_literal_arg() == "[hi]", "literal argument: {t671_literal_arg()}");
  assert(t671_passthrough() == "hi", "pass-through callee: {t671_passthrough()}");
  assert(t671_warmed() == "[hi]2", "warmed-up call site: {t671_warmed()}");
}
