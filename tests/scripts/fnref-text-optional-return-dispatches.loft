//
// A `-> text?` lambda called through a fn-ref compiles and answers on `--native`.
//
// The `?` does not change how a text return is DELIVERED. `Parser::text_return` peels
// `Optional` before it converts the body, so a `-> text?` call site appends exactly the same
// hidden `&text` work buffers a `-> text` one does. The native fn-ref dispatch's candidate
// filter asked the same question of the RAW return type, so it counted those buffers as
// user-visible arguments, no candidate matched its arity, and the dispatch collapsed to
// `_ => unreachable!()`. A `match` with no value-producing arm has no type, so rustc answered
//
//     error[E0282]: type annotations needed
//
// pointing at generated Rust — a whole class of loft program that would not compile, reported
// as a rustc diagnostic naming nothing about loft. The filter's own doc records this exact
// failure for the arity it fixed earlier; this is the same one a wrapper out, which is why
// both reads are now the one `is_text_return` and peel together.
//
// ⚠ THE INTERPRETER IS NOT A CONTROL FOR THIS ONE — it answered correctly throughout, on
// every cell. The whole defect is in what `--native` emits, so a cell scored on the
// interpreter alone reads green on the broken build. What scores it is the native run's
// EXIT, and the values beside it are what would catch a dispatch that found the wrong
// candidate rather than none.
//
// ⚠ AND `null` IS THE CELL THAT COULD HAVE BEEN TRADED AWAY. Making the call site treat a
// `text?` return as a text return also wraps each dispatch arm in `.to_string()`, which is
// exactly the shape that turns an absent text into `""`. It does not — a null arm still reads
// `== null`, and an EMPTY string still reads `!= null` — but nothing about the fix says so,
// so both are cells.
//
// @falsified-at: f437c1f2 — native exit 1 -> 0 (rustc E0282 on the generated crate, so no
//   cell runs at all on that build); interpret INERT, which is expected and is the point of
//   the note above: only one side can move for a native codegen defect.

fn mk_named(i: integer) -> text? { if i > 0 { "v{i}" } else { null } }

fn test_a_text_optional_lambda_dispatches_through_a_fn_ref() {
  // The filed shape: the whole crate failed to compile on `--native`.
  m = fn(i: integer) -> text? { "v{i}" };
  x = m(1);
  assert(x == "v1", "the returned value: got {x ?? \"NULL\"}");
}

fn test_both_arms_of_a_text_optional_lambda() {
  // A present arm and an absent one through the same fn-ref, so the dispatch is exercised
  // on the value it delivers AND on the one it does not.
  m = fn(i: integer) -> text? { if i > 0 { "v{i}" } else { null } };
  a = m(3);
  b = m(0);
  assert(a == "v3", "the present arm: got {a ?? \"NULL\"}");
  assert(b == null, "the absent arm is null: got {b ?? \"NULL\"}");
}

fn test_an_empty_text_is_not_null() {
  // The traded-away cell. `.to_string()` on each arm is the shape that would collapse an
  // absent text into an empty one; these two must stay distinguishable.
  m = fn(i: integer) -> text? { if i > 0 { "" } else { null } };
  e = m(1);
  n = m(0);
  assert(e != null, "an empty text is not null: got null");
  assert(n == null, "an absent text is null: got {n ?? \"<empty>\"}");
}

fn test_the_named_function_twin_is_unmoved() {
  // Correct throughout — the control that says the missing thing was the fn-ref DISPATCH.
  // A direct call resolves its callee statically and never consults the candidate filter.
  a = mk_named(3);
  b = mk_named(0);
  assert(a == "v3", "the present arm: got {a ?? \"NULL\"}");
  assert(b == null, "the absent arm is null: got {b ?? \"NULL\"}");
}

fn test_the_non_nullable_text_lambda_is_unmoved() {
  // The other control, and the one that names the axis: the same lambda without the `?`
  // compiled and answered on both backends the whole time, so what was missing was the peel
  // and not the text-return machinery.
  m = fn(i: integer) -> text { "v{i}" };
  x = m(7);
  assert(x == "v7", "the returned value: got {x}");
}
