//
// Regression (GitHub #250 / @P384): copying a 3+-deep nested-vector element
// (`vector<vector<vector<X>>>`) panicked/corrupted on BOTH backends — the
// type-id diverged. Two-part fix: (1) `db_type` resolves `Type::Vector`
// recursively (it mis-resolved nested vectors to an unrelated default-library
// id, e.g. FieldValue); (2) native OpCopyRecord resolves the vector type-id at
// RUNTIME via the order-independent `stores.vector(...)` chain (a `let`-chain to
// avoid double-borrow), instead of the parser literal that diverged from native
// registration order at depth >= 2.
//
// NOTE: `vector<vector<vector<single>>>` is a SEPARATE compounding bug (the
// @P380 single-NaN-sentinel-as-rec-id family) and is not exercised here.

struct Holder {
  box: vector<vector<vector<integer>>>,
}

fn main() {
  // 3-deep, element is a variable (the OpCopyRecord path)
  vvv: vector<vector<vector<integer>>> = [];
  inner: vector<vector<integer>> = [[1, 2]];
  vvv += [inner];
  assert(vvv[0][0][0] == 1 && vvv[0][0][1] == 2, "3-deep var: {vvv[0][0]}");

  // 3-deep, literal element
  lit: vector<vector<vector<integer>>> = [];
  lit += [[[7], [8]]];
  assert(lit[0][0][0] == 7 && lit[0][1][0] == 8, "3-deep lit: {lit[0]}");

  // 3-deep text base
  tt: vector<vector<vector<text>>> = [];
  at: vector<vector<text>> = [["hi"]];
  tt += [at];
  assert(tt[0][0][0] == "hi", "3-deep text: {tt[0][0]}");

  // 4-deep
  q: vector<vector<vector<vector<integer>>>> = [];
  a4: vector<vector<vector<integer>>> = [[[5]]];
  q += [a4];
  assert(q[0][0][0][0] == 5, "4-deep: {q[0][0][0]}");

  // 3-deep through a struct field
  h = Holder { box: [] };
  ab: vector<vector<integer>> = [[3]];
  h.box += [ab];
  assert(h.box[0][0][0] == 3, "struct-field 3-deep: {h.box[0][0]}");

  // 2-deep still works (depth < 2 keeps the literal id)
  vv: vector<vector<integer>> = [[1], [2]];
  v: vector<integer> = [9];
  vv += [v];
  assert(vv[2][0] == 9, "2-deep: {vv[2]}");

  println("deep-nested-vector-copy ok");
}
