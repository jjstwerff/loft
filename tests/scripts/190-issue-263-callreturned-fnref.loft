//
// Regression for issue #263 — a non-capturing fn-ref that becomes a RUNTIME
// VALUE (a call-return, or a fn-ref local copied into a collection element)
// used to crash on both backends.  A direct fn-ref LITERAL (`[dbl]`,
// `[fn(){7}]`) always worked; only the value form broke.
//
// Root cause was two sites sharing one invariant — a fn-ref var slot is
// 20 bytes ([d_nr 8B][closure DbRef 12B]); the d_nr half is a DEFINITION
// number, never a store_nr, and the 4-byte vector-element slot stores only
// the d_nr:
//   1. A fn-ref returned as a bare d_nr (`return dbl` → `Int(d_nr)`) left the
//      20-byte return slot's closure half uninitialised — a later
//      OpFreeRef/store_mut dereferenced that garbage as a store_nr (OOB /
//      SIGSEGV).  Fixed by padding the return value with a null-ref sentinel
//      (interp: gen_return / generate_block; native: fn_ref_context on the
//      return value + reachability of a bare-d_nr fn-ref return).
//   2. Storing a fn-ref VALUE (a Var or a call result) into a 4-byte element
//      via `OpSetInt4(elm, 0, value)` read the WRONG 4 bytes (the high end of
//      the 20-byte slot).  Fixed by projecting the d_nr (FnRefDnr for a Var;
//      materialise-to-temp-then-FnRefDnr for a Call) in the element write.
//
// The matrix that surfaced the whole class (all now PASS on both backends):
// named/lambda × literal/local-copy/call-return × local/vec-elem/append/arg/
// return-again, plus immediate-call-of-a-call-return and the bind-only case
// that crashed with NO container at all.

fn dbl(x: integer) -> integer {
  x * 2
}
fn trp(x: integer) -> integer {
  x * 3
}
fn getdbl() -> fn(integer) -> integer {
  dbl
}
fn gettrp() -> fn(integer) -> integer {
  trp
}
fn mkseven() -> fn() -> integer {
  fn() -> integer {
    7
  }
}
fn passthru() -> fn(integer) -> integer {
  getdbl()
} // return-again layer
fn apply(f: fn(integer) -> integer, n: integer) -> integer {
  f(n)
}

fn main() {
  // ── direct fn-ref literals in a vec (always worked — guard against regress) ──
  ga: vector<fn(integer) -> integer> = [dbl];
  assert(ga[0](5) == 10, "literal named in vec");
  gb: vector<fn(integer) -> integer> = [fn(y: integer) -> integer {
    y + 7
  }];
  assert(gb[0](5) == 12, "literal lambda in vec");

  // ── fn-ref LOCAL copied into a vec element, then called (#263 var site) ──
  f = dbl;
  assert(f(5) == 10, "named->local call (no container)");
  gc: vector<fn(integer) -> integer> = [f];
  assert(len(gc) == 1, "named->local stored, len only");
  assert(gc[0](5) == 10, "named->local stored + read-call");

  // append a fn-ref local into a vec
  gd: vector<fn(integer) -> integer> = [];
  gd += [f];
  assert(gd[0](5) == 10, "named->local append");

  // ── CALL-RETURNED fn-ref, NO container — used to crash on the bind ──
  cf = getdbl();
  assert(cf(5) == 10, "call-return->local call");
  assert(getdbl()(5) == 10, "direct call of a call-return");

  // bind-only-then-late-call (no container) — the bind crashed at free_named
  // on scope exit BEFORE the value was ever called.
  bind_only = getdbl();
  assert(bind_only(4) == 8, "call-return bound, called late");

  // ── CALL-RETURNED fn-ref into a vec element (the filed reproducer) ──
  ge: vector<fn(integer) -> integer> = [getdbl()];
  assert(ge[0](5) == 10, "call-return in vec literal");

  gf: vector<fn(integer) -> integer> = [];
  gf += [getdbl()];
  assert(gf[0](5) == 10, "call-return appended to vec");

  // a call-returned NON-capturing lambda (mkpair-shape) into a vec
  gg: vector<fn() -> integer> = [mkseven()];
  assert(gg[0]() == 7, "call-returned lambda in vec");

  // ── multiple call-returns of DIFFERENT fns in one literal ──
  gh: vector<fn(integer) -> integer> = [getdbl(), gettrp()];
  assert(gh[0](5) == 10, "multi: getdbl");
  assert(gh[1](5) == 15, "multi: gettrp");

  // ── call-return passed as a fn argument ──
  assert(apply(getdbl(), 5) == 10, "call-return as fn arg");
  assert(apply(f, 5) == 10, "var fn-ref as fn arg");

  // ── chained: store call-return, read element into a local, call the local ──
  gi: vector<fn(integer) -> integer> = [getdbl()];
  g = gi[0];
  assert(g(5) == 10, "read stored call-return into local, call");

  // ── return-again: a fn that returns a call-returned fn-ref ──
  pf = passthru();
  assert(pf(5) == 10, "return-again call-return");

  print("issue-263 call-returned / value fn-ref: ok\n");
}
