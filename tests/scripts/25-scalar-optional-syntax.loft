//
// @PLN25 Phase 0 (EXPAND) — the postfix `?` nullable marker parses on SCALAR and
// struct types (`integer?`, `text?`, `S?`) in every type position: struct field,
// parameter, return type, and `as`-cast. EXPAND is purely additive: plain types
// are still nullable by default, so `?` is a behaviour-preserving no-op here — its
// job is to let genuinely-nullable sites be pre-annotated (Phase 1 MIGRATE) before
// the Phase-2 default flip gives the marker teeth. So this script asserts the SAME
// observable behaviour the unmarked types give today. The vector element `?`
// (`vector<S?>`) is a separate, already-shipped opt-in (see the 85-* tests).
// Design: doc/claude/plans/25-nullable-sequences/implementation-steps.md § Phase 0.

struct S {
  a: integer?,
  b: text?,
  c: integer,
}

fn pick(x: integer?, y: text?) -> integer? {
  x
}
fn label() -> text? {
  "z"
}

fn main() {
  // `?` field stores null and reads back as null; the unmarked field is unaffected.
  s = S { a: null, b: "hi", c: 5 };
  assert(s.a == null, "nullable field holds null");
  assert((s.b ?? "-") == "hi", "nullable text field reads its value");
  assert(s.c == 5, "unmarked field unchanged");

  // `?` parameter + `?` return parse and pass values through.
  assert((pick(7, "q") ?? -1) == 7, "nullable param/return pass-through");
  assert((label() ?? "-") == "z", "nullable return type");

  // `?` coexists with the vector-element opt-in and the dense cast.
  d = "[1,2,3]" as vector<integer>;
  assert(len(d) == 3, "dense cast unaffected");

  println("scalar-optional-syntax ok");
}
