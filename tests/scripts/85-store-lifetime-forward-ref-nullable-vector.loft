// @PLN85 / loft#417 — regression guard for forward-ref nullable vector elements.
// ENUM-FIRST trigger: `enum CV` has a `CM { entries: vector<Entry> }` variant, and
// `struct Entry` (holding CV fields) is defined AFTER the enum.  The element struct
// is thus a forward-ref when the variant field parses, so the parse-time nullable
// rewrite (`e2_nullable_elem`) was skipped and the deferred resolver
// (`copy_unknown_fields`) materialized the field DENSE — while the same `vector<Entry>`
// as a param/local resolved nullable `vector<__nullable<Entry>>`.  That element-stride
// mismatch corrupted enum-discriminant reads on BOTH backends.  Fixed by routing both
// resolvers through ONE home (`typedef::nullable_vector_elem`).  This guard READS the
// fields (no append) so it stays leak-free; the @P377 append-leak is a separate issue.
enum CV {
  CN,
  CI { value: integer },
  CM { entries: vector<Entry> },
}
struct Entry {
  key: CV,
  value: CV,
}

fn val(c: CV) -> integer {
  match c {
    CN => 0, CI { value } => value, CM { entries } => 99,
  }
}

fn main() {
  m = CM {
    entries: [
      Entry { key: CI { value: 1 }, value: CI { value: 2 } },
      Entry { key: CI { value: 3 }, value: CI { value: 4 } },
    ]
  };
  match m {
    CM { entries } => {
      assert(val(entries[0].key) == 1, "entry0.key reads CI 1 (not a corrupt discriminant)");
      assert(val(entries[0].value) == 2, "entry0.value reads CI 2");
      assert(val(entries[1].key) == 3, "entry1.key reads CI 3");
      assert(val(entries[1].value) == 4, "entry1.value reads CI 4");
    },
    _ => { assert(false, "m must be CM"); },
  }
}
