//
// loft#1051 — destructuring a tuple LOCAL holding struct elements leaked one record per
// element, per execution, on the interpreter.  In a loop that is unbounded.
//
// The cause is an ownership.md O-Deps violation, not a missing `free`.  Codegen's
// tuple-destructure arm deep-copied a `Type::Reference` element UNCONDITIONALLY, which
// allocates a store and puts the binding in charge of it — but the binding's `deps` said
// BORROW (it inherited the source tuple through `change_var_type`), and a borrow is
// skip-free.  So the copy had an owner nobody frees.  O-Deps says the free placement
// DERIVES from `deps`; a codegen condition that re-derives it is the bug, and this one
// re-derived "copy" without ever consulting the fact.  The element-read arm beside it
// already carried the right guard, which is why `c = v[i]` never had this.
//
// It was also a backend divergence, the other half of O-Deps: `--native` reads the same
// deps and aliases a borrow, so native was always clean here.
//
// ⚠ THE FILED HYPOTHESIS WAS WRONG, and it is worth saying so where the next person
// looks.  The issue named `Parser::materialize_tuple_element` and framed the fix as a
// design call ("should the destructure release the source, or should the binding
// borrow?").  Instrumented, that function is NEVER reached for this shape — it serves the
// tuple-RETURN path (`t = pair()`), which was already clean.  The copy is inserted during
// IR-to-bytecode, and does not appear in the IR dump at all.  A matrix built from the
// filed repro inherits its misconception; this one was built by moving one axis at a time
// and reading the store timeline.
//
// Every function here is a LEAK guard, so each must run under a leak-checking harness —
// `wrap.rs` and the native leak check both provide one.  Values are asserted too: a leak
// fix that quietly changed what the program computes would otherwise pass.

struct Cell { data: vector<integer>, w: integer }

fn i1051_mk(w: integer) -> Cell {
  c = Cell { data: [], w: w };
  for _i in 0..3 { c.data += [w]; }
  c
}

/// The filed repro: a tuple LOCAL of two structs, destructured, in a loop.  Leaked two
/// `Cell` records per iteration — 80 for this trip count.
fn test_1051_destructure_tuple_local() {
  n = 0;
  for _i in 0..40 {
    a = i1051_mk(1);
    b = i1051_mk(2);
    t = (a, b);
    (ca, cb) = t;
    n += ca.w + cb.w;
  }
  assert(n == 120, "expected 40 * (1 + 2) = 120, got {n}");
}

/// One struct element and one scalar — the leak was PER STRUCT ELEMENT, so this leaked
/// one record per iteration rather than two.  It pins that the fix is per element and not
/// keyed on the tuple having two of them.
fn test_1051_destructure_mixed_tuple() {
  n = 0;
  for _i in 0..40 {
    a = i1051_mk(1);
    t = (a, 7);
    (ca, k) = t;
    n += ca.w + k;
  }
  assert(n == 320, "expected 40 * (1 + 7) = 320, got {n}");
}

/// Three elements, to pin that the count scales with ARITY and nothing caps it at two.
fn test_1051_destructure_three_elements() {
  n = 0;
  for _i in 0..40 {
    a = i1051_mk(1);
    b = i1051_mk(2);
    c = i1051_mk(3);
    t = (a, b, c);
    (ca, cb, cc) = t;
    n += ca.w + cb.w + cc.w;
  }
  assert(n == 240, "expected 40 * (1 + 2 + 3) = 240, got {n}");
}

/// The destructured names are never READ.  The leak did not depend on using them, and a
/// fix that only cured the used case would pass every test above.
fn test_1051_destructure_unused_bindings() {
  for _i in 0..40 {
    a = i1051_mk(1);
    b = i1051_mk(2);
    t = (a, b);
    (ca, cb) = t;
  }
  assert(true, "reached the end without leaking");
}

// ── The cells that were ALREADY clean, kept as controls ──────────────────────
//
// Each differs from the leaking shape by ONE axis.  They are here so a future change that
// "fixes" the leak by removing the copy everywhere fails on the ones that need it.

/// Destructuring a tuple EXPRESSION: the bindings OWN (empty deps), so the copy is
/// correct and IS still emitted.  This is the cell that must not lose its copy.
fn test_1051_destructure_tuple_expression() {
  n = 0;
  for _i in 0..40 {
    (ca, cb) = (i1051_mk(1), i1051_mk(2));
    n += ca.w + cb.w;
  }
  assert(n == 120, "expected 120, got {n}");
}

/// A tuple returned by a FUNCTION, destructured.  This is the shape the issue's named
/// suspect actually serves, and it needs its copy for a different reason: the buffer
/// belongs to the call site and is reused on the next turn of the loop (loft#941).
fn i1051_pair() -> (Cell, Cell) {
  (i1051_mk(1), i1051_mk(2))
}

fn test_1051_destructure_function_return() {
  n = 0;
  for _i in 0..40 {
    t = i1051_pair();
    (ca, cb) = t;
    n += ca.w + cb.w;
  }
  assert(n == 120, "expected 120, got {n}");
}

/// Reading the elements positionally instead of destructuring — the documented
/// workaround, and the behaviour the destructure now matches.
fn test_1051_positional_read() {
  n = 0;
  for _i in 0..40 {
    a = i1051_mk(1);
    b = i1051_mk(2);
    t = (a, b);
    n += t.0.w + t.1.w;
  }
  assert(n == 120, "expected 120, got {n}");
}

/// VECTOR and TEXT elements were clean throughout — they take other arms entirely.  Kept
/// so a change to the shared destructure path has to answer for them too.
fn i1051_vec(w: integer) -> vector<integer> {
  v: vector<integer> = [];
  for _i in 0..3 { v += [w]; }
  v
}

fn test_1051_destructure_vector_elements() {
  n = 0;
  for _i in 0..40 {
    a = i1051_vec(1);
    b = i1051_vec(2);
    t = (a, b);
    (ca, cb) = t;
    n += len(ca) + len(cb);
  }
  assert(n == 240, "expected 40 * (3 + 3) = 240, got {n}");
}

fn test_1051_destructure_text_elements() {
  n = 0;
  for _i in 0..40 {
    t = ("row1", "row2");
    (ca, cb) = t;
    n += len(ca) + len(cb);
  }
  assert(n == 320, "expected 40 * (4 + 4) = 320, got {n}");
}
