//
// A tuple's record shape must exist however the tuple's type was ARRIVED AT, and the
// `Rewritten` build-in-place marker must never survive into a tuple member's type.
//
// Two defects, one report (loft#943), because a vector literal of tuples needs both.
//
// 1. A tuple is stored as the synthetic `__tuple<…>` struct, and every consumer that
//    needs its record shape resolves it BY NAME. A DECLARED tuple registers that struct
//    while its type is parsed (`sub_type`), so only an INFERRED one could be missing:
//    `v = [(7, 8)]` names no type anywhere. `type_def_nr` answered `u32::MAX` and the
//    literal was refused outright — "cannot build this record — its type never
//    resolved". `vector_def` now registers from the element type, which is the point
//    both the vector def's `parent` and the literal's `new_record` need it.
//
//    The filed report called this a defect of tuple LITERALS. It is not: c5 builds the
//    element from a tuple LOCAL and failed identically, so the axis is inference, not
//    the spelling.
//
// 2. A struct-literal member arrives typed `Rewritten(Reference(S))` (#319). That
//    wrapper says the value was built in place — a signal to the expression that parsed
//    it, not a type a member can HAVE — and every consumer matching on the constructor
//    missed it: `set_field` refused "Cannot assign to field '_0' of type S", `get_val`
//    refused "Field access not supported on type S", and a bare `t = (S { … }, k)`
//    reached codegen as the internal error "emit_tuple_put_ops: unsupported elem
//    Rewritten(…)" — an ICE, on released 2026.8.0, for a tuple that never mentions a
//    vector at all. c9 is that row. The tuple literal now peels it, exactly as
//    `parse_vector` already peels it from a vector's element type.
//
// c10-c13 are controls: they pass BEFORE either fix, so a change that traded one of
// them for the rows above would show up here rather than in a consumer.

struct P943 { n: integer, tag: integer }

fn r943_mk(n: integer) -> (integer, integer) { (n, n + 1000) }

// Churn the store between build and read, so an element left holding plausible bytes
// cannot pass by accident.
fn r943_churn() -> integer {
  n = 0;
  for i in 0..40 {
    h: vector<integer> = [i, i + 1, i + 2, i + 3];
    n = n + len(h) + i;
  }
  n
}

fn main() {
  // c1 — the filed shape: an all-scalar tuple element, type inferred.
  c1 = [(71, 82), (93, 104)];
  r943_churn();
  assert(len(c1) == 2, "c1 len = {len(c1)}, want 2");
  assert(c1[0].0 == 71, "c1[0].0 = {c1[0].0}, want 71");
  assert(c1[1].1 == 104, "c1[1].1 = {c1[1].1}, want 104");

  // c2 — a member whose storage is not an integer.
  c2 = [(71, "ate")];
  assert(len(c2) == 1, "c2 len = {len(c2)}, want 1");
  assert(c2[0].0 == 71, "c2[0].0 = {c2[0].0}, want 71");
  assert(c2[0].1 == "ate", "c2[0].1 = {c2[0].1}, want ate");

  // c3 — three members: arity is not the axis.
  c3 = [(71, 82, 93)];
  assert(c3[0].0 == 71, "c3 first = {c3[0].0}, want 71");
  assert(c3[0].2 == 93, "c3 third = {c3[0].2}, want 93");

  // c4 — a nested tuple registers inside-out; the inner shape needs its own def.
  c4 = [((71, 82), 93)];
  r943_churn();
  assert(c4[0].0.0 == 71, "c4 inner first = {c4[0].0.0}, want 71");
  assert(c4[0].0.1 == 82, "c4 inner second = {c4[0].0.1}, want 82");
  assert(c4[0].1 == 93, "c4 outer = {c4[0].1}, want 93");

  // c5 — the row that widened the filed scope: the element is a tuple LOCAL, not a
  //      tuple literal. Inference is the axis, so this failed too.
  t5 = (71, 82);
  c5 = [t5];
  assert(len(c5) == 1, "c5 len = {len(c5)}, want 1");
  assert(c5[0].0 == 71, "c5[0].0 = {c5[0].0}, want 71");
  assert(c5[0].1 == 82, "c5[0].1 = {c5[0].1}, want 82");

  // c6 — a struct member FIRST, inferred. Needs both fixes: the def to exist, and the
  //      member's `Rewritten` peeled so the write reaches `set_field`'s Reference arm.
  c6 = [(P943 { n: 71, tag: 7 }, 82)];
  r943_churn();
  assert(len(c6) == 1, "c6 len = {len(c6)}, want 1");
  assert(c6[0].0.n == 71, "c6 n = {c6[0].0.n}, want 71");
  assert(c6[0].0.tag == 7, "c6 tag = {c6[0].0.tag}, want 7");
  assert(c6[0].1 == 82, "c6 k = {c6[0].1}, want 82");

  // c7 — a struct member SECOND. Member position is not the axis here (it was for
  //      loft#942, whose guard pins that half).
  c7 = [(71, P943 { n: 82, tag: 8 })];
  r943_churn();
  assert(c7[0].0 == 71, "c7 k = {c7[0].0}, want 71");
  assert(c7[0].1.n == 82, "c7 n = {c7[0].1.n}, want 82");
  assert(c7[0].1.tag == 8, "c7 tag = {c7[0].1.tag}, want 8");

  // c8 — appending to an inferred vector of tuples, and a nested vector of them.
  c8 = [(71, 82)];
  c8 += [(93, 104)];
  assert(len(c8) == 2, "c8 len = {len(c8)}, want 2");
  assert(c8[1].0 == 93, "c8[1].0 = {c8[1].0}, want 93");
  c8n = [[(71, 82)]];
  assert(len(c8n[0]) == 1, "c8n inner len = {len(c8n[0])}, want 1");
  assert(c8n[0][0].1 == 82, "c8n = {c8n[0][0].1}, want 82");

  // c9 — no vector anywhere: a bare tuple local with a struct-literal member. This was
  //      an internal compiler error, not a refusal, and it reproduced on the released
  //      binary.
  c9 = (P943 { n: 71, tag: 7 }, 82);
  assert(c9.0.n == 71, "c9 n = {c9.0.n}, want 71");
  assert(c9.0.tag == 7, "c9 tag = {c9.0.tag}, want 7");
  assert(c9.1 == 82, "c9 k = {c9.1}, want 82");

  // c10 (control) — the DECLARED element type, which the report calls fine. It must
  //       stay fine: registering from the element type must not disturb the path that
  //       registers from the declaration.
  c10: vector<(integer, integer)> = [(71, 82)];
  c10 += [(93, 104)];
  s10 = 0;
  for e in c10 { s10 = s10 + e.0 + e.1; }
  assert(s10 == 350, "c10 sum = {s10}, want 350");

  // c11 (control) — an inferred vector whose element is a plain struct. The element
  //       type is inferred here too, and it always worked; the tuple registration must
  //       not change what a non-tuple element does.
  c11 = [P943 { n: 71, tag: 7 }, P943 { n: 82, tag: 8 }];
  assert(len(c11) == 2, "c11 len = {len(c11)}, want 2");
  assert(c11[1].n == 82, "c11 n = {c11[1].n}, want 82");

  // c12 (control) — the tuple's type comes from a CALL's declared return type, so the
  //       def already existed. Pins that the new registration is idempotent rather
  //       than minting a second shape beside it.
  c12 = [r943_mk(71), r943_mk(82)];
  assert(len(c12) == 2, "c12 len = {len(c12)}, want 2");
  assert(c12[0].0 == 71, "c12[0].0 = {c12[0].0}, want 71");
  assert(c12[1].1 == 1082, "c12[1].1 = {c12[1].1}, want 1082");

  // c13 (control) — a bare tuple local with no struct member, and a plain vector.
  //       Neither goes near either fix; both must be untouched.
  c13 = (71, 82);
  assert(c13.0 == 71, "c13.0 = {c13.0}, want 71");
  c13v = [71, 82];
  assert(len(c13v) == 2, "c13v len = {len(c13v)}, want 2");

  println("943 ok");
}
