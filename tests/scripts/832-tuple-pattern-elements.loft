//
// Tuple element patterns: the forms that ARE supported, matched against their values.
//
// The positive twin of `832-tuple-pattern-refused.loft`. Nothing in the corpus exercised a
// tuple element pattern at all — `28-tuples.loft` carries no `match` — which is why a parser
// hang in `parse_tuple_match` reached a release (loft#832). The refusal guard alone would not
// have caught it either: a fix that rejected every tuple pattern would satisfy it.
//
// Fixed arity is the design (TUPLES.md § "What is NOT supported"), so `_` is how a position
// goes unbound — these cases are what the refusal's message tells the author to write.
//
// Two shapes this file deliberately leaves to their own regressions, each of which was a
// separate defect found from here: an `if` guard on a tuple arm
// (`839-match-arm-guards.loft`) and a tuple containing `text` reaching the match as a
// function PARAMETER (`840-tuple-arg-owned-crossing.loft`).  The subject below stays a
// local so a failure here means what this file is about.

fn describe(n: integer, name: text, flag: boolean) -> text {
  t: (integer, text, boolean) = (n, name, flag);
  match t {
    (1, "one", true) => "all three literals",
    (2, other, _) => "second is 2, name {other}",
    (m, _, _) => "just {m}",
  }
}

fn bind_every_position(a: integer, b: integer) -> integer {
  t: (integer, integer) = (a, b);
  match t { (x, y) => x * 100 + y }
}

fn wildcard_arm_still_reachable(a: integer, b: integer) -> text {
  t: (integer, integer) = (a, b);
  match t { (1, 1) => "ones", _ => "other" }
}

fn main() {
  println(describe(1, "one", true));
  println(describe(2, "two", false));
  println(describe(7, "x", false));
  println("{bind_every_position(3, 4)}");
  println(wildcard_arm_still_reachable(1, 1));
  println(wildcard_arm_still_reachable(9, 9));
}
