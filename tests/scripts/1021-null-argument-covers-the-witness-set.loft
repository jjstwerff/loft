//
// An OMITTED `τ? = null` argument made the caller keep its conservative never-free answer.
//
// loft#981/#982 built the runtime split for a callee whose return dep names a visible
// parameter: it may hand back that parameter's store (the caller must not free it) or one it
// minted itself (the caller must), and no static bit can carry that — so a bracket protects the
// arguments and `OpCopyRecord`'s source-free bit decides per execution path.  The bracket needs
// a SLOT to name, so `protectable_ref_args` reads a non-`Var` argument as leaving the witness
// set incomplete, and the caller then never frees.
//
// A `null` argument holds NO STORE, so nothing the callee returns can be a borrow of it — it
// neither needs protecting nor breaks coverage.  Reading it as uncovered leaked one record per
// call for the shape the parser produces for every omitted `= null` parameter:
//
//     fn f(a: P? = null) -> P { a? }
//     b = f();            // the record the null path built was owned by no one
//
// The same call with a bare VAR holding null was always clean, which is what localised it: the
// two differ only in what the CALL SITE spells, not in anything either function does.
//
// The harness's leak check is what this file asserts (loft#1021).

struct P1021 { x: integer = 3, y: integer = 4 }

fn f1021(a: P1021? = null) -> P1021 { a? }
fn q1021(a: P1021? = null) -> P1021 { a ?? P1021 { x: 7 } }

fn test_an_omitted_record_argument_discharged_and_returned_is_freed() {
  b = f1021();
  assert(b.x == 3, "the null path answers the record zero");
  assert(b.y == 4, "every field defaults");
}

fn test_the_explicit_coalesce_spelling_too() {
  // Not `?`-specific: `a ?? P{…}` leaked identically, because the free decision is at the
  // CALL site and neither spelling changes what the caller was told.
  b = q1021();
  assert(b.x == 7, "the explicit default answers");
}

fn test_a_supplied_argument_still_borrows_rather_than_being_freed_twice() {
  // The other side of the split: the caller must NOT free what it still owns.  A supplied
  // record takes the borrow arm, and freeing that would be a use-after-free, not a leak.
  p = P1021 { x: 5, y: 6 };
  b = f1021(p);
  assert(b.x == 5, "a supplied record is answered, not the default");
  assert(p.x == 5, "and the caller's own record is still readable afterwards");
}

fn test_it_does_not_scale_with_the_call_count() {
  t = 0;
  for i in 0..6 { t += f1021().x; }
  assert(t == 18, "six calls each build and release one record, got {t}");
}
