//
// loft#718 + loft#719 — removing from a keyed collection whose elements own
// heap data.  Both were crashes, both on BOTH backends, and both hinged on a
// `DbRef` being read against the wrong layout.
//
// #718: `#remove` in a filtered loop over an `index<T[..]>`.  The loop cursor
//   carries the red-black link's offset (tree navigation needs it), and
//   `remove_owned` handed that cursor to `remove_claims`, which walked the
//   element's fields from there — so a `text` landed past the record, corrupted
//   the free tree, and `fl_insert_node` recursed forever (SIGSEGV on the
//   interpreter, stack overflow on --native).  Needed an OWNED heap child on
//   the record to show, which is why `label` is here.
//
// #719: a `sorted<T[k]>` becomes an `ORDERED<T[k]>` as soon as anything else in
//   the program declares an `index<T[..]>` over the same element type — so
//   `Both` below, which is never constructed, changes how `by_id` behaves.
//   `Ordered` was missing from the keyed-remove lowering list, so
//   `coll[key] = null` silently did nothing on the interpreter and failed to
//   compile on --native; and its runtime removal read the element record's
//   position as an inline index.

struct Rec { const id: integer, const n: integer, const label: text }

// Declared, never constructed.  Its presence is what turns a `sorted<Rec[id]>`
// into an ordered secondary — the whole point of the #719 half.
struct Both { const by_key: sorted<Rec[id]>, const by_n: index<Rec[n, -id]> }

fn count_ix(c: index<Rec[n, -id]>) -> integer { k = 0; for r in c { k += r.id * 0 + 1 } k }
fn count_st(c: sorted<Rec[id]>) -> integer { k = 0; for r in c { k += r.id * 0 + 1 } k }

fn main() {
  // --- #718: `#remove` over an index, elements owning a text ---------------
  ix: index<Rec[n, -id]> = [];
  for i in 0..40 { ix += [Rec { id: i, n: i % 7, label: "label-{i}-xxxxxxxx" }] }
  for r in ix if r.id >= 4 { r#remove }
  assert(count_ix(ix) == 4, "index #remove keeps exactly the survivors");
  // The survivors must still READ — a corrupted walk shows up here, not in the count.
  sum718 = 0;
  for s in ix { sum718 = sum718 + s.id + len(s.label) }
  assert(sum718 == 70, "index survivors still read their own fields");

  // --- #719: keyed removal from a sorted-turned-ordered --------------------
  by_id: sorted<Rec[id]> = [];
  for j in 0..30 { by_id += [Rec { id: j, n: j % 5, label: "l-{j}-yyyy" }] }
  by_id[7] = null;
  assert(count_st(by_id) == 29, "keyed removal from an ordered secondary removes one");
  gone = by_id[7];
  assert(gone == null, "and the removed key is gone");
  kept = by_id[8];
  assert(kept != null, "while its neighbour stays");
  assert(len(kept.label) == 8, "and still owns its text");

  // A spread of removals, since the container shifts on every one.
  for d in 0..30 { if d % 3 == 0 { by_id[d] = null } }
  assert(count_st(by_id) == 19, "a spread of keyed removals leaves the right count");
  sum719 = 0;
  for t in by_id { sum719 = sum719 + t.id + len(t.label) }
  assert(sum719 == 459, "and every survivor still reads");
}
