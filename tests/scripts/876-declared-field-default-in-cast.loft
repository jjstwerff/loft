//
// loft#876 — a declared field default (`height: float = 1.5`) was honoured by a struct
// literal and ignored by a `text as Struct` cast, so the same field had two different
// absent values depending on how the record was made.
//
// The default lives parser-side as an IR node, and the JSON walker sits below the
// parser with no evaluator, so it wrote the TYPE's zero instead. It is now folded to a
// constant at registration and carried on the schema `Field`, which is the same route
// `nullable` takes (@PLN127 arc D) and for the same reason: nothing in the store
// implies it.
//
// The CONTRACT this pins, in both directions:
//   * a CONSTANT default (`= 1.5`, `= 7`, `= "hi"`, `= true`) is part of the type, so
//     it answers a missing key, an explicit `null`, and a struct literal alike;
//   * a COMPUTED default (`= 1 + 2`, `= mk()`, `= [1, 2]`) needs an evaluator the store
//     layer does not have, so it keeps applying exactly where the constructor runs.
//     That split is deliberate — `d876_computed` below is the cell that states it.
//
// A key the document actually CARRIES must still beat the default (`d876_present`), and
// a field with NO default must still get the type's zero / the null sentinel — the
// loft#870 contract this builds on, re-checked here so a default that leaked into every
// field would not pass.

struct D876 {
  d_name:   text,
  d_height: float   = 1.5,
  d_slope:  integer = 7,
  d_label:  text    = "hi",
  d_flag:   boolean = true,
}

// No defaults anywhere — the loft#870 answers must survive unchanged.
struct D876Bare {
  b_name:  text,
  b_plain: integer,
  b_opt:   integer?,
  b_text:  text,
}

// A default that is not a constant: honoured by the constructor, not by a cast.
struct D876Computed {
  c_name: text,
  c_n:    integer = 1 + 2,
}

// A declared default on a NULLABLE field — the declaration says what absence means,
// so it wins over the sentinel; a nullable field WITHOUT one still reads null.
struct D876Nullable {
  n_name: text,
  n_with: integer? = 4,
  n_without: integer?,
}

const J876_MISS: text = `{{ "d_name": "x" }}`;
const J876_NULL: text = `{{ "d_name": "x", "d_height": null, "d_slope": null, "d_label": null, "d_flag": null }}`;
const J876_FULL: text = `{{ "d_name": "x", "d_height": 9.25, "d_slope": 3, "d_label": "no", "d_flag": false }}`;
const J876_BARE: text = `{{ "b_name": "x" }}`;
const J876_COMP: text = `{{ "c_name": "x" }}`;
const J876_NULLABLE: text = `{{ "n_name": "x" }}`;
const J876_VEC: text = `[{{ "d_name": "a" }}, {{ "d_name": "b", "d_height": 2.5 }}]`;

fn check_defaults(d: D876, where_from: text) {
  assert(d.d_height == 1.5, "{where_from}: d_height={d.d_height}");
  assert(d.d_slope == 7, "{where_from}: d_slope={d.d_slope}");
  assert(d.d_label == "hi", "{where_from}: d_label={d.d_label}");
  assert(d.d_flag == true, "{where_from}: d_flag={d.d_flag}");
}

fn main() {
  // The path that always worked — a struct literal omitting the fields.
  lit = D876 { d_name: "x" };
  check_defaults(lit, "literal");

  // A key the document OMITS is the same question, and now gets the same answer.
  check_defaults(J876_MISS as D876, "key-missing");

  // So is a key written explicitly `null`.
  check_defaults(J876_NULL as D876, "json-null");

  // ...but a key the document CARRIES still wins over the default.
  full = J876_FULL as D876;
  assert(full.d_height == 9.25, "present d_height={full.d_height}");
  assert(full.d_slope == 3, "present d_slope={full.d_slope}");
  assert(full.d_label == "no", "present d_label={full.d_label}");
  assert(full.d_flag == false, "present d_flag={full.d_flag}");

  // A struct literal that SPELLS the field still wins over its default.
  given = D876 { d_name: "x", d_slope: 42 };
  assert(given.d_slope == 42, "literal override d_slope={given.d_slope}");

  // loft#870 unchanged: no declared default means the type's zero, and a nullable
  // field still reads null rather than being swept up by the default machinery.
  bare = J876_BARE as D876Bare;
  assert(bare.b_plain == 0, "bare b_plain={bare.b_plain}");
  assert(bare.b_opt == null, "bare b_opt={bare.b_opt}");
  assert(bare.b_text == "", "bare b_text={bare.b_text}");

  // The contract: a computed default reaches the constructor and not the cast.
  comp_lit = D876Computed { c_name: "x" };
  assert(comp_lit.c_n == 3, "computed literal c_n={comp_lit.c_n}");
  comp_cast = J876_COMP as D876Computed;
  assert(comp_cast.c_n == 0, "computed cast c_n={comp_cast.c_n}");

  // A nullable field with a declared default takes it; one without stays null.
  nl = J876_NULLABLE as D876Nullable;
  assert(nl.n_with == 4, "nullable-with n_with={nl.n_with}");
  assert(nl.n_without == null, "nullable-without n_without={nl.n_without}");

  // The vector cast walks the same missing-key loop — length AND values.
  v = J876_VEC as vector<D876>;
  assert(len(v) == 2, "vector len={len(v)}");
  assert(v[0].d_height == 1.5, "vector[0] d_height={v[0].d_height}");
  assert(v[1].d_height == 2.5, "vector[1] d_height={v[1].d_height}");
  assert(v[0].d_label == "hi", "vector[0] d_label={v[0].d_label}");

  println("876 declared-default ok");
}
