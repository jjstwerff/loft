//
// Regression (loft#752) — a BOUND store's file must be sized by its CONTENT
// once the binding is released, not by the rung of the growth ladder the build
// happened to stop on.
//
// A store bound with `store_persist_bind` FIRST has its FILE as the live arena,
// and the arena grows by 7/3 and never shrinks by itself.  So the file left
// behind was quantized to a ladder: it could sit 57% (`1 − 3/7`) above what it
// held, two builds one rung apart differed by 133% with identical records, and
// — measured on this shape — 40 000 and 60 000 features produced a file of
// exactly the same size while the data grew by half.  loft#710 decided a
// persisted store's size must follow its content and fixed the IMAGE-write
// path; this is that decision on the path the fix never reached.
//
// The cost of not making it was a consumer's plan: `jjstwerff/routing` measured
// ordered vs scattered key insertion, saw 2.3x with byte-identical read-back,
// and concluded that ordering input was the worse strategy.  Both numbers were
// rungs.
//
// The driver runs this with RECLAIM=1 and RECLAIM=0 and requires the two files
// to be the SAME SIZE: an explicit `store_reclaim` may no longer find anything
// the release did not already hand back.  It also runs two feature counts and
// requires them to DIFFER — the ladder's signature is two different data sets
// agreeing to the byte, so equal sizes there is the failure this guards.
//
// Env in:
//   LOFT_PERSIST_TEST_PATH   the store file
//   N                        features (default 40000)
//   RECLAIM                  "1" to call store_reclaim before release

struct Road { const rd_id: integer, const rd_pts: vector<integer> }
struct Tile { const tkey: integer, roads: vector<Road> }

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH") ?? "";
  if path == "" { println("FAIL no path"); return }
  n = (env_variable("N") ?? "") as integer ?? 40000;
  reclaim = (env_variable("RECLAIM") ?? "") == "1";

  world: hash<Tile[tkey]> = [];
  if !store_persist_bind(world, path) { println("FAIL bind"); return }

  for i in 0..n {
    k = i % 500;
    t = world[k];
    if t == null { world += [Tile { tkey: k, roads: [] }]; t = world[k]; }
    if t != null { t.roads += [Road { rd_id: i, rd_pts: [i, i + 1, i + 2] }]; }
  }
  if reclaim { store_reclaim(world); }

  // Count what was actually stored, so the driver can prove the two runs hold
  // the SAME data — a size comparison between different contents proves nothing.
  tiles = 0; roads = 0; sum = 0;
  for tile in world {
    tiles += 1;
    for r in tile.roads { roads += 1; for p in r.rd_pts { sum += p; } }
  }
  println("reclaim {reclaim} tiles {tiles} roads {roads} sum {sum} verify {store_verify(world)}");
}
