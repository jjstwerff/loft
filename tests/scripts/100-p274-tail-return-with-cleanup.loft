// @P274 regression — heap-typed tail return with intervening
// scope cleanup.
//
// Bug A (native): patch_hoisted_returns Pass 2 collapsed
// `[Call(parse_row, …, var___ref_1), OpFreeRef(var___ref_1),
// Return(Null)]` into `[OpFreeRef(var___ref_1),
// Return(Call(parse_row, …, var___ref_1))]` — emitting use-after-
// free that crashed at `src/keys.rs:249` with "index out of
// bounds: the len is N but the index is 65535" (u16::MAX
// sentinel).  Triggered when a heap-typed (vector / reference /
// enum-ref) function early-returns through a Call whose argument
// list still contains a local that the scope is about to free.
//
// Bug B (both backends): parse_append_text dispatched only on
// Text / Character — integer parts in `text + integer` fell
// through to OpAppendText with the wrong operand type, SIGSEGV
// in interp and rustc E0614 in native.  The `nh=` + `len()`
// concat below pins this path.
//
// Both bugs must run cleanly in --interpret AND --native; this
// file is wired into tests/native.rs::native_scripts which walks
// every `tests/scripts/*.loft` through both backends.

fn parse_row(raw: text) -> vector<text> {
  out: vector<text> = [];
  out += [raw];
  out
}

fn find_headers(lines: vector<text>) -> vector<text> {
  empty: vector<text> = [];
  if lines.len() > 0 { return parse_row(lines[0]); }
  empty
}

fn main() {
  lines: vector<text> = ["a", "b"];
  headers: vector<text> = find_headers(lines);
  println("nh=" + headers.len());
}
