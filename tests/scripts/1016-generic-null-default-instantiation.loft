//
// `x?` on a GENERIC parameter discharged with the type VARIABLE's default, not `T`'s.
//
// `x?` is `x ?? construct_default(T)` (types.md `(N-Default)`), and `construct_default` is a
// function of the CONCRETE type.  Inside a template `T` is an attribute-less placeholder
// STRUCT, and `build_default`'s record arm defaulted it perfectly happily — to an empty record
// of the placeholder's own store type.  Substitution then retyped the slot and left the
// allocation, so the monomorph read a `__typevar_T` record back as whatever `T` became:
//
//   T = integer  →  34359738369        (a zero-filled DbRef read as a number)
//   T = float    →  a denormal
//   T = P        →  4294967198, plus a leaked `__typevar_T` record
//   T = text     →  SIGSEGV
//
// The rule was not being applied where it is decidable.  `build_default` now MARKS such a site
// and `rewrite_generic_type_defaults` answers it per monomorph, where `T` is concrete.  A
// nested generic (`concrete` still a type variable) re-marks and stays deferred.
//
// #1015 fixed the same shape for a parameter whose type is written out; this is the half that
// remained once the type is a variable (loft#1016).

struct P1016 { x: integer = 3, y: integer = 4 }

pub fn g1016 < T > (v: vector<T>, a: T? = null) -> T { _ = len(v); a? }

fn test_a_generic_default_discharges_to_the_instantiations_zero() {
  assert(g1016([1]) == 0, "T = integer discharges to 0, got {g1016([1])}");
  assert(g1016([1.5f]) == 0.0f, "T = single discharges to 0.0");
  assert(g1016([1.5]) == 0.0, "T = float discharges to 0.0");
  assert(g1016(["q"]) == "", "T = text discharges to the empty text");
}

fn test_a_supplied_generic_argument_is_unaffected() {
  // The control: the fill must only happen for an OMITTED argument.
  assert(g1016([1], 9) == 9, "a supplied integer arrives");
  assert(g1016([1.5f], 2.5f) == 2.5f, "a supplied single arrives");
  assert(g1016([1.5], 2.5) == 2.5, "a supplied float arrives");
  assert(g1016(["q"], "z") == "z", "a supplied text arrives");
}

fn test_a_generic_record_default_is_the_records_own_zero() {
  // `(D-Rec)` — every field defaulted.  The template could only have built the PLACEHOLDER's
  // empty record, which is why this cell read 4294967198 before.
  d = g1016([P1016 { x: 1, y: 2 }]);
  assert(d.x == 3, "T = P discharges to the record zero, got {d.x}");
  assert(d.y == 4, "the second field defaults too");
  given = P1016 { x: 8, y: 9 };
  s = g1016([P1016 { x: 1, y: 2 }], given);
  assert(s.x == 8, "a supplied record arrives");
}

// The marker is answered wherever it SITS, not only where the walk happened to look.
//
// `rewrite_generic_type_defaults` used to enumerate the carriers it descended, and listed
// ten of the seventeen `Value` variants that hold children.  `Tuple` was among the seven it
// missed, so a marker inside one was never answered and the monomorph shipped the
// placeholder: `t = (a?, 1)` read the placeholder's bytes as data.  Silently at
// `T = integer` (34359738369), and as a SIGSEGV in `OpFreeText` at `T = text`.
//
// Each cell asserts against its NON-tuple twin rather than a constant, because the claim is
// that position does not change the answer — a constant would still pass if both regressed
// together.
pub fn tup1016 < T > (v: vector<T>, a: T? = null) -> T { _ = len(v); t = (a?, 1); t.0 }
pub fn tp21016 < T > (v: vector<T>, a: T? = null) -> T { _ = len(v); t = (1, a?); t.1 }
pub fn tpu1016 < T > (v: vector<T>, a: T? = null) -> T { _ = len(v); t = (a?, 1); t.0 = a?; t.0 }

fn test_a_deferred_default_inside_a_tuple_is_still_answered() {
  assert(tup1016([1]) == g1016([1]), "tuple elem 0, integer: {tup1016([1])} vs {g1016([1])}");
  assert(tp21016([1]) == g1016([1]), "tuple elem 1, integer: {tp21016([1])} vs {g1016([1])}");
  assert(tpu1016([1]) == g1016([1]), "tuple ASSIGN, integer: {tpu1016([1])} vs {g1016([1])}");

  assert(tup1016([1.5]) == g1016([1.5]), "tuple elem 0, float");
  assert(tup1016([1.5f]) == g1016([1.5f]), "tuple elem 0, single");

  // A SUPPLIED argument never reaches the marker, so it must be unaffected — without this
  // cell a rewrite that discharged every argument would satisfy the three above.
  assert(tup1016([1], 9) == 9, "a supplied argument is untouched, got {tup1016([1], 9)}");
}

// NOT covered here, deliberately: `T = text`. The interpreter answers it correctly now,
// but `--native` still refuses the program, because a tuple element's emitter flag means
// two things at once (append `.to_string()` to a literal; do not borrow a `TupleGet`) and
// a text literal nested inside the element takes the first while the element takes the
// second — `&*("".to_string())`, a borrow of a temporary (E0716). Separating those two
// facts is its own change; a cell here would fail the native half of the suite.
