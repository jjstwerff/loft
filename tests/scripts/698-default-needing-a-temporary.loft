//
// Regression (loft#698): a struct field default whose value needs a TEMPORARY.
//
// A default is lowered in the STRUCT's context, which has no frame, and replayed inside
// whatever function builds the record.  Any temporary it needed was therefore numbered in
// a variable table that no longer existed at replay, and the indices resolved against
// whatever locals the construction site happened to have: `= [1, 2]` re-allocated the
// record mid-construction (a HANG), `= "a" + "b"` used the record as a text buffer (a
// SIGSEGV), and a keyed one PANICKED.  The refusal that replaced those crashes is now
// lifted — such a default is lowered into a function of its own, so its temporaries are
// numbered in that function's table and never leave it, and the stored default is the
// var-free call to it.
//
// The value comes back BY RETURN, not written in place.  That is what keeps `Ou698`
// below working: the caller writes the field, so it applies its own `pos + fld` offset —
// a default writing through the record could only bake offsets right at the top level.
//
// Axes: the collection KIND (scalar / struct / text elements), literal DEPTH
// (`vector<vector<T>>`, three temporaries), a NON-collection temporary (text concat),
// field ORDER, CARDINALITY (two such defaults in one record), struct DEPTH (the defaulted
// field one struct down), and the construction CONTEXT — two sites, a loop, a called
// function that returns the record.  Controls: a supplied literal (which always worked),
// the empty `= []` (loft#697) and plain literal defaults (which never needed a temporary).
//
// `tests/scripts/102-expected-errors.loft` pins the two shapes that stay refused: a
// non-empty KEYED default (loft has no keyed literal as a value at all — a plain local
// `h: hash<K[k]> = [K { … }]` is refused identically) and one that reads `$` AND needs a
// temporary (it cannot move into a function that has no record).

struct It698 { it_a: integer, it_b: integer }

// The reported shape, and the element kinds around it.
struct Vi698 { vi_x: integer, vi_ids: vector<integer> = [1, 2] }
struct Vs698 { vs_x: integer, vs_items: vector<It698> = [It698 { it_a: 3, it_b: 4 }] }
struct Vt698 { vt_x: integer, vt_words: vector<text> = ["p", "q"] }

// Literal depth: the inner vectors need a temporary each, on top of the outer one.
struct Nd698 { nd_x: integer, nd_m: vector<vector<integer>> = [[7], [8]] }

// A temporary that is not a collection at all — this one SIGSEGV'd.
struct Tx698 { tx_x: integer, tx_s: text = "a" + "b" }

// Field ORDER (the defaulted field first) and CARDINALITY (two of them in one record).
struct Or698 { or_ids: vector<integer> = [1, 2], or_x: integer, or_more: vector<integer> = [3] }

// Struct DEPTH: the defaulted field one struct down, reached through the omitted-field
// recursion that writes at an offset.
struct In698 { in_q: integer, in_ids: vector<integer> = [4, 5] }
struct Ou698 { ou_x: integer, ou_inner: In698 }

// A default that CALLS something — the same class, since the call's return buffer belongs
// to the frame that replays it, not to the struct.
fn mk698() -> vector<integer> { [6, 7, 8] }
struct Ca698 { ca_x: integer, ca_ids: vector<integer> = mk698() }

// Controls that never needed a temporary.
struct Ct698 { ct_x: integer, ct_e: vector<integer> = [], ct_s: text = "d", ct_n: integer = 7 }

fn make698(n: integer) -> Vi698 { Vi698 { vi_x: n } }

fn main() {
  // The element kinds.
  a = Vi698 { vi_x: 9 };
  assert(a.vi_x == 9, "scalar field survives, got {a.vi_x}");
  assert(len(a.vi_ids) == 2, "the defaulted vector has its elements, got {len(a.vi_ids)}");
  assert(a.vi_ids[0] == 1 && a.vi_ids[1] == 2, "and their values, got {a.vi_ids[0]} {a.vi_ids[1]}");

  b = Vs698 { vs_x: 9 };
  assert(len(b.vs_items) == 1, "struct elements: length, got {len(b.vs_items)}");
  assert(b.vs_items[0].it_a == 3, "struct elements: first field, got {b.vs_items[0].it_a}");
  assert(b.vs_items[0].it_b == 4, "struct elements: second field, got {b.vs_items[0].it_b}");

  c = Vt698 { vt_x: 9 };
  assert(len(c.vt_words) == 2, "text elements: length, got {len(c.vt_words)}");
  assert(c.vt_words[0] == "p" && c.vt_words[1] == "q", "text elements: values, got {c.vt_words[0]} {c.vt_words[1]}");

  // Literal depth — every inner row must hold its own element, not read back empty.
  d = Nd698 { nd_x: 9 };
  assert(len(d.nd_m) == 2, "nested: outer length, got {len(d.nd_m)}");
  assert(len(d.nd_m[0]) == 1 && len(d.nd_m[1]) == 1, "nested: inner lengths, got {len(d.nd_m[0])} {len(d.nd_m[1])}");
  assert(d.nd_m[0][0] == 7 && d.nd_m[1][0] == 8, "nested: values, got {d.nd_m[0][0]} {d.nd_m[1][0]}");

  // A non-collection temporary.
  e = Tx698 { tx_x: 9 };
  assert(e.tx_x == 9, "text concat: sibling field survives, got {e.tx_x}");
  assert(e.tx_s == "ab", "text concat: the default is built, got {e.tx_s}");

  // Field order and two defaults in one record — each gets its own collection.
  f = Or698 { or_x: 9 };
  assert(len(f.or_ids) == 2 && f.or_ids[1] == 2, "order: leading default, got {len(f.or_ids)}");
  assert(f.or_x == 9, "order: the scalar between them survives, got {f.or_x}");
  assert(len(f.or_more) == 1 && f.or_more[0] == 3, "order: trailing default, got {len(f.or_more)}");
  f.or_ids += [99];
  assert(len(f.or_ids) == 3 && len(f.or_more) == 1, "order: they are separate collections");

  // Struct depth — the inner default is written at the outer record's offset.
  o = Ou698 { ou_x: 9, ou_inner: In698 { in_q: 8 } };
  assert(o.ou_x == 9, "nested struct: outer scalar survives, got {o.ou_x}");
  assert(o.ou_inner.in_q == 8, "nested struct: inner scalar survives, got {o.ou_inner.in_q}");
  assert(len(o.ou_inner.in_ids) == 2, "nested struct: inner default, got {len(o.ou_inner.in_ids)}");
  assert(o.ou_inner.in_ids[0] == 4 && o.ou_inner.in_ids[1] == 5, "nested struct: inner values");

  // A calling default — its return buffer belongs to this frame.
  g = Ca698 { ca_x: 9 };
  assert(len(g.ca_ids) == 3, "call default: length, got {len(g.ca_ids)}");
  assert(g.ca_ids[2] == 8, "call default: value, got {g.ca_ids[2]}");

  // Two construction sites: each record owns its own collection.
  p = Vi698 { vi_x: 1 };
  q = Vi698 { vi_x: 2 };
  p.vi_ids += [3];
  assert(len(p.vi_ids) == 3, "two sites: the appended-to record grew, got {len(p.vi_ids)}");
  assert(len(q.vi_ids) == 2, "two sites: the other did not, got {len(q.vi_ids)}");
  assert(q.vi_ids[1] == 2, "two sites: and still holds its default, got {q.vi_ids[1]}");

  // Construction in a LOOP — the temporary is reused each iteration.
  t = 0;
  for i in 0..3 {
    lp = Vi698 { vi_x: i };
    t += len(lp.vi_ids) + lp.vi_ids[0];
  }
  assert(t == 9, "loop: every iteration built the default, got {t}");

  // Construction inside a called function that RETURNS the record.
  r1 = make698(1);
  r2 = make698(2);
  assert(r1.vi_x == 1 && r2.vi_x == 2, "returned: scalars, got {r1.vi_x} {r2.vi_x}");
  assert(len(r1.vi_ids) == 2 && len(r2.vi_ids) == 2, "returned: both defaults built");
  assert(r1.vi_ids[1] == 2, "returned: values survive the return, got {r1.vi_ids[1]}");

  // Controls: a SUPPLIED literal wins over the default, and the no-temporary defaults
  // keep working.
  s = Vi698 { vi_x: 9, vi_ids: [7, 8, 9] };
  assert(len(s.vi_ids) == 3 && s.vi_ids[2] == 9, "control: supplied literal wins, got {len(s.vi_ids)}");
  w = Ct698 { ct_x: 9 };
  assert(len(w.ct_e) == 0, "control: the empty default stays empty, got {len(w.ct_e)}");
  w.ct_e += [1];
  assert(len(w.ct_e) == 1 && w.ct_e[0] == 1, "control: and is still usable");
  assert(w.ct_s == "d", "control: literal text default, got {w.ct_s}");
  assert(w.ct_n == 7, "control: literal scalar default, got {w.ct_n}");

  println("698-default-needing-a-temporary ok");
}
