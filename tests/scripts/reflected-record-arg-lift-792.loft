//
// Regression (loft#792): a record allocated by a NATIVE — `type_of(x)` / `type_named(n)`
// — leaked when it was passed straight as a call argument instead of being bound to a
// local first.
//
// The inline-argument lift that owns a call's result temp required the callee to have a
// BODY, so a body-less native fell through it: the value was bound to nothing and
// nothing freed it. `--native` frees the record through its own drop path, so the leak
// was interpreter-only — and it CASCADED, because the leaked argument kept the callee's
// frame alive: with a callee that returns a struct holding a freshly built vector, that
// vector leaked once per call after the first, so a loop calling `f(type_of(x))` grew
// the heap without bound.
//
// It is the TEMPORARY that is at fault, not reflection and not the shape: binding the
// same value to a local and passing that leaked nothing, and a hand-written struct of
// the same shape passed as a temporary leaked nothing either. That is why this reads as
// a reflection quirk until you notice the missing lift.
//
// The leak is what this file guards, and a `.loft` test cannot read the store table
// directly — the harness fails the run on unfreed stores at exit, so every cell below
// is a leak assertion by being run at all. The COUNTS are asserted too, since a lift
// that freed too eagerly would answer wrong rather than leak.

struct Person { const id: integer, const nm: text }
struct Col { const nm: text, k: integer }
struct Tab { const nm: text, const columns: vector<Col> }

fn width(t: TypeInfo) -> integer { return len(t.fields); }
fn width_opt(t: TypeInfo?) -> integer { return len((t ?? type_of(0)).fields); }

// A callee that builds a FRESH vector of its own — the cascade's other half. The vector
// never comes from `t`; only the parameter is reflected.
fn mk(t: TypeInfo) -> Tab {
  cs: vector<Col> = [];
  for i in 0..2 { cs += [Col { nm: "x{i}", k: i }] }
  return Tab { nm: t.name, columns: cs };
}

fn test_reflected_temporary_is_owned() {
  p = Person { id: 1, nm: "a" };

  // A — the reported shape: the reflected record as a direct call argument.
  assert(width(type_of(p)) == 2, "A inline type_of {width(type_of(p))}");

  // B — `type_named` is the same native family reached by a RUNTIME name, so it needs
  //     the same lift. Its return is nullable, which is a separate arm from A's.
  assert(width_opt(type_named("Person")) == 2, "B inline type_named");

  // C — the CASCADE: three calls whose callee returns a struct holding a fresh vector.
  //     N calls used to leak N-1 vectors, so one call could never show it.
  a = mk(type_of(p));
  b = mk(type_of(p));
  c = mk(type_of(p));
  assert(a.nm == "Person" and b.nm == "Person" and c.nm == "Person", "C names");
  assert(len(a.columns) == 2 and len(b.columns) == 2 and len(c.columns) == 2, "C columns");

  // D — repetition is the axis that made this unbounded rather than a one-off.
  n = 0;
  for _ in 0..60 { n += width(type_of(p)) }
  assert(n == 120, "D loop {n} want 120");

  // E — CONTROL: bound to a local first. Correct before the fix; it is the shape whose
  //     ownership the lift reproduces, so it must stay correct.
  ti = type_of(p);
  assert(width(ti) + width(ti) + width(ti) == 6, "E via-local control");

  println("792 ok");
}

fn test_view_returning_natives_untouched() {
  // F — CONTROL: keyed collections are reordered by natives that hand back a BORROW of
  //     the collection they were given. They are bounded out of the lift by returning
  //     the untyped `reference` rather than a named struct; if that bound ever slips,
  //     the lift frees a store the program still owns and this cell is where it shows.
  h: hash<Col[nm]> = [];
  h += [Col { nm: "b", k: 2 }];
  h += [Col { nm: "a", k: 1 }];
  total = 0;
  for e in h { total += e.k }
  assert(total == 3, "F hash still whole {total}");
  assert((h["a"] ?? Col { nm: "-", k: 0 }).k == 1, "F keyed read survives");

  s: sorted<Col[nm]> = [];
  s += [Col { nm: "b", k: 2 }];
  s += [Col { nm: "a", k: 1 }];
  first = "";
  for e in s { if e#first { first = e.nm } }
  assert(first == "a", "F sorted order {first}");

  println("792 controls ok");
}
