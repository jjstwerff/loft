//
// Regression for @P315 — a `vector<single>` must store its elements at the
// 4-byte `single` stride, and survive RELOCATION (struct-field assign, keyed
// insert, concat) with EXACT values.  Before the fix, a `vector<single>`
// element written from a wider value used an 8-byte OpSetFloat write that
// overflowed the 4-byte slot → heap corruption once the vector was copied.
//
// The fix makes a float literal in a `vector<single>` a COMPILE ERROR (no
// silent truncation); single values reach the vector via the `f`-suffix single
// literal (`1.0f`), an explicit `as single` cast, or a single-typed variable.

struct V { a: vector<single> }
struct Ent { k: integer, m: V }

fn isum(v: vector<single>) -> integer {
  // exact-value checksum: each single quantised at f32 resolution
  s = 0;
  for i in 0..len(v) { s = s + (((v[i] ?? 0.0f) as float) * 1000.0) as integer; }
  s
}

// vector<single> from single LITERALS (f suffix), embedded in a struct literal
// then relocated by the assignment to `e` — must round-trip exactly.
fn test_p315_single_literal_struct_field() {
  e = Ent{k: 1, m: V{a: [1.5f, 2.5f, 3.5f, 4.5f]}};
  assert(len(e.m.a) == 4, "p315 lit: len={len(e.m.a)} (expect 4)");
  assert(isum(e.m.a) == 12000, "p315 lit: sum={isum(e.m.a)} (expect 12000)");
}

// vector<single> from explicit `as single` casts of float values.
fn test_p315_cast_struct_field() {
  x = 2.25; y = 4.75;   // float vars
  e = Ent{k: 2, m: V{a: [x as single, y as single]}};
  assert(isum(e.m.a) == 7000, "p315 cast: sum={isum(e.m.a)} (expect 7000)");
}

// Relocation through a KEYED collection + concat (the gridmesh SegMesh shape):
// build per-key, then iterate + concatenate, asserting exact values survive.
fn test_p315_keyed_insert_and_concat() {
  h: hash<Ent[k]> = [];
  for k in [10, 20, 30] {
    cm: vector<single> = [];
    for j in 0..5 { cm += [(k + j) as single]; }   // single var append
    h[k] = Ent{k: k, m: V{a: cm}};
  }
  per = 0; for ce in h { per = per + isum(ce.m.a); }
  out: vector<single> = [];
  for ce in h { out += ce.m.a; }                    // concat from keyed-nested
  assert(len(out) == 15, "p315 keyed: concat len={len(out)} (expect 15)");
  assert(isum(out) == per, "p315 keyed: concat sum={isum(out)} != per-entry sum={per}");
}

// `[1, 2]` (int literals) is still a valid vector<single> (int→single implicit).
fn test_p315_int_literals_ok() {
  e = Ent{k: 3, m: V{a: [1, 2, 3]}};
  assert(isum(e.m.a) == 6000, "p315 int: sum={isum(e.m.a)} (expect 6000)");
}
