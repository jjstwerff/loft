// D-tup-2 — a `&(…)` reference tuple outside a PARAMETER.
//
// `tuples.md` T-Ref-El names the element types a reference tuple admits, and
// `data::ref_tuple_element_ok` is the one list that answers it — but only the SIGNATURE
// asked.  A `&`-annotated LOCAL was built at a second site that never did, so the same
// `&(text, text)` a parameter refuses reached codegen and died there as an internal
// compiler error on BOTH backends.
//
// Underneath that, the whole binding was unimplemented at every element type, admitted
// ones included.  `binding.md` B-Ref-Alias says the `&` annotation makes ANY binding a
// live LINK to its source, and B-Ref-Uniform says a `&τ` variable is used exactly like a
// `τ` one; measured, a tuple was the one type where NEITHER `&` position obeyed either:
//
//   b = &a                    the `&` was DROPPED — a plain copy, so `b.0 = 5` left `a`
//                             unchanged, with no diagnostic on either backend
//   b: &(integer, integer) = a   typed a reference over a value: the interpreter read an
//                             ELEMENT as a store index (`index out of bounds ... index is
//                             9` for the tuple `(7, 9)`) and `--native` handed the user a
//                             raw rustc `E0308`
//   b: &(boolean, boolean) = a   answered `truefalse` where the swap says `falsetrue`,
//                             exit code 0 — the silent-wrong cell
//
// Both backends agreed on every one of those, so the `--interpret`/`--native`
// differential — the workhorse gate for tuples (D-op-1) — was structurally blind to it.
//
// A tuple local lives in the FRAME, so it joins the scalars at `OpCreateStack`: the same
// stack ref a `&(…)` parameter is handed at its call site, read at the same
// `(ref, offset)` pair.  The refusals now come from `Parser::ref_var_type`, the one place
// a `&` in source becomes a `Type::RefVar`, so a `&` refused at a signature cannot be
// accepted at a local.
//
// `102-expected-errors.loft` carries the refusals; this file carries what must WORK.

fn swap_through_a_ref_tuple_param(p: &(integer, integer)) { t = p.0; p.0 = p.1; p.1 = t; }

fn test_an_annotated_ref_tuple_local_writes_through() {
  a = (1, 2);
  b: &(integer, integer) = a;
  t = b.0; b.0 = b.1; b.1 = t;
  // The link is the point: the SOURCE is what has to have changed.
  assert(a.0 == 2 && a.1 == 1, "the source tuple is swapped, got {a.0}{a.1}");
  assert(b.0 == 2 && b.1 == 1, "the link reads the source, got {b.0}{b.1}");
}

fn test_a_prefix_amp_tuple_bind_writes_through() {
  // `b = &a` and `b: &(…) = a` are the same binding written two ways (B-Ref-Intro), and
  // this one used to differ from the other by SILENTLY copying.
  a = (1, 2);
  b = &a;
  b.0 = 5;
  assert(a.0 == 5, "the prefix-& bind links rather than copies, got {a.0}");
  assert(b.0 == 5, "the link reads 5, got {b.0}");
}

fn test_a_ref_tuple_local_reads_the_sources_current_value() {
  // B-Ref-Read — the link is live, so a write to the SOURCE is visible through it.
  a = (7, 9);
  b: &(integer, integer) = a;
  a.0 = 11;
  assert(b.0 == 11 && b.1 == 9, "the link sees the source's current value, got {b.0} {b.1}");
}

fn test_every_admitted_element_type_links_at_a_local() {
  // The five kinds `ref_tuple_element_ok` admits, at the position that never asked it.
  i: (integer, integer) = (1, 2);
  bi: &(integer, integer) = i;
  bi.0 = 8;
  assert(i.0 == 8, "integer element links, got {i.0}");

  f = (1.5, 2.5);
  bf: &(float, float) = f;
  bf.0 = 9.5;
  assert(f.0 == 9.5, "float element links, got {f.0}");

  s = (1.5 as single, 2.5 as single);
  bs: &(single, single) = s;
  bs.0 = 9.5 as single;
  assert(s.0 == 9.5 as single, "single element links, got {s.0}");

  c = ('a', 'b');
  bc: &(character, character) = c;
  bc.0 = 'z';
  assert(c.0 == 'z', "character element links, got {c.0}");

  // The silent-wrong cell: this one answered with the tuple UNCHANGED and exit code 0.
  bo = (true, false);
  bb: &(boolean, boolean) = bo;
  t = bb.0; bb.0 = bb.1; bb.1 = t;
  assert(!bo.0 && bo.1, "boolean elements are swapped in the source, got {bo.0}{bo.1}");
}

fn test_a_ref_tuple_local_forwards_to_a_ref_tuple_param() {
  // The composition: native represents the local link as a raw `*mut (…)` and the
  // parameter as `&mut (…)`, so handing one to the other has to re-borrow through it.
  // Without that the program did not compile at all (`expected &mut (i64, i64), found
  // &mut *mut (i64, i64)`) while `--interpret` answered correctly.
  a = (1, 2);
  b: &(integer, integer) = a;
  swap_through_a_ref_tuple_param(b);
  assert(a.0 == 2 && a.1 == 1, "the callee wrote the original through two links, got {a.0}{a.1}");
}

fn test_a_mixed_element_ref_tuple_local() {
  a = (1, true, 'x');
  b: &(integer, boolean, character) = a;
  b.0 = 9; b.1 = false; b.2 = 'q';
  assert(a.0 == 9 && !a.1 && a.2 == 'q', "every element writes through, got {a.0}{a.1}{a.2}");
}

fn test_a_for_loop_over_tuples_is_untouched() {
  // The record-backed `RefVar(Tuple)` a `for` builds is a DIFFERENT construction — it
  // reaches its elements through a real record, so it admits `text` where the
  // stack-backed annotation does not.  Pinned here because the T-Ref-El gate must not
  // reach it.
  v = [("a", "b"), ("c", "d")];
  seen = "";
  for t in v { seen += "{t.0}{t.1}|"; }
  assert(seen == "ab|cd|", "the for-loop tuple binding is unchanged, got {seen}");

  w = [(1, 2), (3, 4)];
  for t in w { t.0 = 9; }
  assert(w[0].0 == 9, "a for-loop tuple element still writes through, got {w[0].0}");
}

// A VALUE ENUM is a scalar, so a `&(…)` admits it — it was refused purely because two
// spellings of "is this a scalar" had drifted.  `generation`'s own `is_scalar` included
// `Enum(_, false, _)`; `data::ref_tuple_element_ok` did not; and `element_stack_size` gives
// a value enum and a `boolean` the SAME 1-byte slot.  So `&(boolean, boolean)` worked while
// `&(Col, Col)` was refused with "may only hold scalar elements".  Both now read one
// predicate, `data::is_scalar` (formal/IMPLEMENTATIONS.md #1).
//
// The boolean cell is the control: it is what made the refusal read as a rule rather than a
// gap.  A `text` element stays refused — that is D-bind-11, a real representation difference
// (a 16-byte `Str` borrow against a 4-byte record handle), not drift.

enum RtlCol { RtlRed, RtlGreen }

fn rtl_swap_value_enum(p: &(RtlCol, RtlCol)) {
  t = p.0;
  p.0 = p.1;
  p.1 = t;
}

fn test_a_value_enum_is_admitted_as_a_reference_tuple_element() {
  a = (RtlCol.RtlRed, RtlCol.RtlGreen);
  rtl_swap_value_enum(a);
  assert(a.0 == RtlCol.RtlGreen, "value-enum .0 after swap");
  assert(a.1 == RtlCol.RtlRed, "value-enum .1 after swap");
}

fn rtl_swap_boolean(p: &(boolean, boolean)) {
  t = p.0;
  p.0 = p.1;
  p.1 = t;
}

fn test_the_boolean_control_still_works() {
  b = (true, false);
  rtl_swap_boolean(b);
  assert(!b.0, "boolean .0 after swap");
  assert(b.1, "boolean .1 after swap");
}
