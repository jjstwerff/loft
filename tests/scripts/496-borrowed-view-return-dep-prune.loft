//
// #496 — a struct temp fed from a BORROWED-VIEW-returning finder must not free
// the lender / the source.  The crawler's `mon_find` (`x = table[i] ?? none();
// return x`, a `none()` CALL tail) returns a view of a vector param; two shapes
// broke, one per backend, and both are guarded here.
//
// NATIVE half — return-dep STALE-PRUNE (@PLN85 D-own-2, `parser/control.rs`).
// With a CALL tail (a `one_buffer_chain`) the block-tail `expanded` source set is
// built from the buffer only and missed the param a MID-BODY `return x` borrows
// THROUGH a view local, so `body_return_borrows` reported "no borrow" and the
// prune dropped the `table` dep.  `returns_borrowed_view()` then read false, the
// native first-bind OR-ed the `0x8000` source-free bit, and a second
// `sb = find(gm, ..)` WHOLE-STORE-FREED `gm`.  Fix: `body_return_borrows` now
// recognises a `return <view-local>` (its transitive type deps reach the param).
// A struct-COPY local (`r = x; return r`) keeps empty deps, so a genuine stale
// copy-return dep still prunes (D-own-2 kept — `copy_indep` guards it).
//
// INTERPRETER half — the `md = sa; if c { md = sb }` reassignment (`state/
// codegen.rs`).  Because the finder's `??` makes its result join-typed, the
// interp reassignment took the @PLN85 join-own `OpBindOrCopy` path for a plain
// `Value::Var` RHS — which ADOPTS (moves) the source.  Adopting a REUSED named
// local aliased `md` onto `sb`'s store, then `md`'s owned `OpFreeRef` killed
// `sb` (silent: mixed sa/sb fields, then a freed-store read).  Fix: the join-own
// guard fires only for a CALL return (a fresh temporary), never a `Var` — the
// `Var` copies via the #306 path, matching native (whose join-own already nests
// in a `Value::Call` gate).

struct Mon {
  m_key: text,
  m_hp: integer,
  m_name: text,
}

fn mon_none() -> Mon {
  Mon { m_key: "", m_hp: 0, m_name: "none" }
}

// Borrowed-view return with a CALL tail (`mon_none()`) — the pruning trigger,
// and (via `??`) the join-typed result that drove the interp adopt.
fn find_join(table: vector<Mon>, key: text) -> Mon {
  for i in 0..len(table) {
    x = table[i] ?? mon_none();
    if x.m_key == key { return x; } // returns a VIEW of `table` through `x`
  }
  mon_none()
}

// The issue's other shape: `x = table[i]; if x != null ... return x as Mon` with
// a CALL tail — still a view of `table`, the cast does not copy on this path.
fn find_cast(table: vector<Mon>, key: text) -> Mon {
  for i in 0..len(table) {
    x = table[i];
    if x != null && x.m_key == key { return x as Mon; }
  }
  mon_none()
}

fn mk_hp(md: Mon, bonus: integer) -> integer {
  md.m_hp + bonus
}

// D-own-2: a struct-COPY return. `r` owns its store, so `src` is NOT a live view
// and must stay prunable — mutating the copy must not touch the source.
fn copy_ret(src: Mon) -> Mon {
  r = src; r
}

// NATIVE half: two consecutive borrowed-view first-sets from ONE vector must
// leave it intact — the second call's owned-local bind must not free the lender
// the first still borrows.
fn two_first_sets(use_join: boolean) {
  gm: vector<Mon> = [
    Mon { m_key: "a", m_hp: 5, m_name: "adder" },
    Mon { m_key: "b", m_hp: 9, m_name: "viper" },
  ];
  sa = if use_join { find_join(gm, "a") } else { find_cast(gm, "a") };
  sb = if use_join { find_join(gm, "b") } else { find_cast(gm, "b") };
  g0 = gm[0] ?? mon_none();
  g1 = gm[1] ?? mon_none();
  assert(g0.m_name == "adder", "gm[0] intact, got '{g0.m_name}'");
  assert(g1.m_name == "viper", "gm[1] intact, got '{g1.m_name}'");
  assert(sa.m_name == "adder" && sa.m_hp == 5, "sa intact, got '{sa.m_name}'/{sa.m_hp}");
  assert(sb.m_name == "viper" && sb.m_hp == 9, "sb intact, got '{sb.m_name}'/{sb.m_hp}");
}

// INTERPRETER half: the crawler's original infestation shape — a struct temp
// `md = sa; if c { md = sb }` reassigned across a loop from borrowed-view
// results.  Reassigning `md = sb` must COPY, not adopt-and-free `sb`.
fn reassign_loop() {
  gm: vector<Mon> = [
    Mon { m_key: "a", m_hp: 5, m_name: "adder" },
    Mon { m_key: "b", m_hp: 9, m_name: "viper" },
  ];
  sa = find_join(gm, "a");
  sb = find_join(gm, "b");
  out: vector<integer> = [];
  for i in 0..6 {
    md = sa;
    if(i % 2 ?? 0) == 1 { md = sb; }
    if md.m_hp > 0 { out += [mk_hp(md, 100)]; }
  }
  assert(len(out) == 6, "all six placed, got {len(out)}");
  sum = 0;
  for j in 0..len(out) { sum += out[j] ?? 0; }
  // 3 × adder(105) + 3 × viper(109) = 642; a clobber mixes sa/sb fields.
  assert(sum == 642, "no clobber (sb not freed by md's reassign), sum={sum}");
  // The sources survive their reuse in the loop.
  assert(sa.m_name == "adder" && sb.m_name == "viper", "sa/sb intact after loop");
}

fn copy_indep() {
  base = Mon { m_key: "s", m_hp: 1, m_name: "orig" };
  cp = copy_ret(base);
  cp.m_hp = 99;
  assert(base.m_hp == 1, "copy_ret is independent: base untouched, got {base.m_hp}");
  assert(cp.m_hp == 99, "copy mutated, got {cp.m_hp}");
}

fn main() {
  two_first_sets(true);
  two_first_sets(false);
  reassign_loop();
  copy_indep();
  println("ok");
}
