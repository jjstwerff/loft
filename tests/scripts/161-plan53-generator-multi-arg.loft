// 161 — @PLAN53: multi-argument generator reading its arguments across yields.
//
// Promoted from cluster-2 probe 2a-11.  UNIQUE vs the single-arg generator
// tests in `tests/issues.rs` (p210/p211/p218 each take one argument): a
// generator with TWO and THREE arguments, each read on a separate `yield`.
// The aligned-stack fix (2a) corrected the args/locals boundary in the
// coroutine frame; the multi-arg form is what confirmed the shift is ONE
// boundary (every argument moves together), not a per-slot error.
//
// Long-run value: a generator-frame regression guard, AND a V2 differential
// seed — under `LOFT_ALIGN=1 LOFT_SLOT_V2=drive` the args occupy stepped slots.

fn pair_gen(a: integer, b: integer) -> iterator < integer > {
  yield a;
  yield b;
}

fn triple_gen(a: integer, b: integer, c: integer) -> iterator < integer > {
  yield a;
  yield b;
  yield c;
}

fn main() {
  // Two arguments, read on two yields.
  s = 0;
  for v in pair_gen(3, 5) { s += v; }
  assert(s == 8, "pair: got {s}, want 8");

  // Three arguments, read on three yields.
  s = 0;
  for v in triple_gen(10, 20, 30) { s += v; }
  assert(s == 60, "triple: got {s}, want 60");

  println("161-plan53-generator-multi-arg PASSED");
}
