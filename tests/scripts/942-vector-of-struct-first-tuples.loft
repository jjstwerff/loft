//
// A vector element of TUPLE type is built member-by-member, so it must never be
// offered as a whole-record in-place construction target.
//
// `parse_item` hands the element slot (`Var(_elm_1)`, carved out by `OpNewRecord`)
// to the element expression so a struct element builds straight into it —
// `parse_object` takes that path whenever it is given a `Var` that owns a store.
// A tuple element is not one record: `emit_tuple_set_ops` writes each member at its
// own offset. Offering the slot let the tuple literal's FIRST member consume it, so
// `[(S { … }, k)]` wrote S's fields directly into the element and then handed that
// valueless statement list to `OpCopyRecord` as its SOURCE.
//
// Only the first member could ever fail this way, because `(a, b, …)` parses member
// zero into the caller's value and every later member into a fresh one. That is the
// whole reason `vector<(integer, S)>` was correct while `vector<(S, integer)>` was
// not — c8 pins that sibling.
//
// The filed report (loft#942) read as four unrelated bugs because the one defect
// surfaces differently per construction path, and each row below is one of them:
// reading one back panicked using the tuple's SECOND member value as a record index
// (`--native` refused the generated Rust outright), a 2+ element literal aborted the
// compiler with `Incorrect var _elm_1[56] versus 40`, a single `+=` silently zeroed
// the struct's fields, and a second `+=` SIGSEGV'd.
//
// The guard keys on the `(` token, not on the element TYPE, because a literal in
// RETURN position infers its element type from itself: the type is still unknown when
// member zero is seeded and only resolves by member one. c6 is that case, and it is
// the row a type-keyed guard passes every other row while failing.

struct Pair { id: integer, tag: integer }
struct Trio { a: integer, b: integer, c: integer }

// Hand a wrongly-built record's slot to the next allocation and write over it, so a
// zeroed or aliased field cannot pass by still holding plausible bytes.
fn r942_churn() -> integer {
  n = 0;
  for i in 0..40 {
    h: vector<integer> = [i, i + 1, i + 2, i + 3];
    n = n + len(h) + i;
  }
  n
}

fn r942_mk() -> vector<(Pair, integer)> {
  [(Pair { id: 10, tag: 1 }, 101), (Pair { id: 20, tag: 2 }, 202)]
}

fn main() {
  // c1 — the filed shape: read one back. Before the fix this panicked in
  //      `allocation.rs` using 33 (the tuple's SECOND member) as a record index.
  c1: vector<(Pair, integer)> = [(Pair { id: 11, tag: 22 }, 33)];
  r942_churn();
  assert(len(c1) == 1, "c1 len = {len(c1)}, want 1");
  assert(c1[0].0.id == 11, "c1 id = {c1[0].0.id}, want 11");
  assert(c1[0].0.tag == 22, "c1 tag = {c1[0].0.tag}, want 22");
  assert(c1[0].1 == 33, "c1 k = {c1[0].1}, want 33");

  // c2 — two or more elements aborted the compiler outright.
  c2: vector<(Pair, integer)> = [(Pair { id: 1, tag: 1 }, 10), (Pair { id: 2, tag: 2 }, 20)];
  r942_churn();
  assert(len(c2) == 2, "c2 len = {len(c2)}, want 2");
  assert(c2[0].0.id == 1, "c2[0] id = {c2[0].0.id}, want 1");
  assert(c2[1].0.id == 2, "c2[1] id = {c2[1].0.id}, want 2");
  assert(c2[1].1 == 20, "c2[1] k = {c2[1].1}, want 20");

  // c3 — a single `+=` append silently zeroed the struct's fields: `id` read back 0
  //      with no diagnostic at all, which is the worst of the four symptoms.
  c3: vector<(Pair, integer)> = [];
  c3 += [(Pair { id: 11, tag: 22 }, 33)];
  r942_churn();
  assert(len(c3) == 1, "c3 len = {len(c3)}, want 1");
  assert(c3[0].0.id == 11, "c3 id = {c3[0].0.id}, want 11");
  assert(c3[0].1 == 33, "c3 k = {c3[0].1}, want 33");

  // c4 — a second append SIGSEGV'd on the interpreter.
  c4: vector<(Pair, integer)> = [];
  c4 += [(Pair { id: 1, tag: 1 }, 10)];
  c4 += [(Pair { id: 2, tag: 2 }, 20)];
  r942_churn();
  assert(len(c4) == 2, "c4 len = {len(c4)}, want 2");
  assert(c4[0].0.id == 1, "c4[0] id = {c4[0].0.id}, want 1");
  assert(c4[1].0.id == 2, "c4[1] id = {c4[1].0.id}, want 2");

  // c5 — a THREE-member tuple, so more than one member trails the struct.
  c5: vector<(Pair, integer, integer)> = [(Pair { id: 5, tag: 0 }, 6, 7)];
  r942_churn();
  assert(c5[0].0.id == 5, "c5 id = {c5[0].0.id}, want 5");
  assert(c5[0].1 == 6, "c5 b = {c5[0].1}, want 6");
  assert(c5[0].2 == 7, "c5 c = {c5[0].2}, want 7");

  // c6 — the literal directly in RETURN position, where the element type is inferred
  //      from the literal itself. A guard keyed on the element type cannot see this
  //      one: the type is still unknown when member zero is seeded. An earlier
  //      type-keyed attempt turned the compiler abort into a SILENTLY EMPTY vector,
  //      which is why this row asserts the length as well as the values.
  c6 = r942_mk();
  r942_churn();
  assert(len(c6) == 2, "c6 len = {len(c6)}, want 2");
  assert(c6[0].0.id == 10, "c6[0] id = {c6[0].0.id}, want 10");
  assert(c6[1].0.id == 20, "c6[1] id = {c6[1].0.id}, want 20");
  assert(c6[1].1 == 202, "c6[1] k = {c6[1].1}, want 202");

  // c7 — BOTH members are structs, so the fix cannot be "special-case member zero
  //      into a scalar slot".
  c7: vector<(Pair, Pair)> = [(Pair { id: 3, tag: 0 }, Pair { id: 4, tag: 0 })];
  r942_churn();
  assert(c7[0].0.id == 3, "c7 first = {c7[0].0.id}, want 3");
  assert(c7[0].1.id == 4, "c7 second = {c7[0].1.id}, want 4");

  // c8 — CONTROL: the struct SECOND. Member zero is a scalar, so nothing ever
  //      inherited the element slot and this spelling was always correct. It pins
  //      that the fix did not disturb the working sibling.
  c8: vector<(integer, Pair)> = [(7, Pair { id: 11, tag: 1 }), (8, Pair { id: 22, tag: 2 })];
  r942_churn();
  assert(c8[0].0 == 7, "c8[0] k = {c8[0].0}, want 7");
  assert(c8[0].1.id == 11, "c8[0] id = {c8[0].1.id}, want 11");
  assert(c8[1].1.id == 22, "c8[1] id = {c8[1].1.id}, want 22");

  // c9 — CONTROL: a PARENTHESISED struct literal as a vector element. This is a
  //      `(`-leading element that is NOT a tuple, so the guard gives up the in-place
  //      build for it and it takes the allocate-then-copy path instead. It must stay
  //      correct, and the file's leak gate is what proves the extra temp is freed.
  c9: vector<Pair> = [(Pair { id: 11, tag: 1 }), (Pair { id: 33, tag: 2 })];
  r942_churn();
  assert(len(c9) == 2, "c9 len = {len(c9)}, want 2");
  assert(c9[0].id == 11, "c9[0] = {c9[0].id}, want 11");
  assert(c9[1].id == 33, "c9[1] = {c9[1].id}, want 33");

  // c10 — CONTROL: the ordinary unparenthesised struct element keeps the in-place
  //       build. It is by far the common spelling, so a fix that gave it up for
  //       everything would be a silent cost on every program.
  c10: vector<Trio> = [Trio { a: 1, b: 2, c: 3 }, Trio { a: 4, b: 5, c: 6 }];
  r942_churn();
  assert(len(c10) == 2, "c10 len = {len(c10)}, want 2");
  assert(c10[1].b == 5, "c10[1].b = {c10[1].b}, want 5");

  // c11 — CONTROL: a plain tuple LOCAL, no vector and so no element slot to inherit.
  //       Always worked; pins that the defect needed the vector-element seed.
  c11: (Pair, integer) = (Pair { id: 11, tag: 22 }, 33);
  r942_churn();
  assert(c11.0.id == 11, "c11 id = {c11.0.id}, want 11");
  assert(c11.1 == 33, "c11 k = {c11.1}, want 33");

  println("ok");
}
