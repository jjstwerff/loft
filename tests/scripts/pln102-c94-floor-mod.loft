//
// @PLN102 C94 — integer `/` truncates toward zero and `%` takes the DIVIDEND's
// sign (the C/Rust convention, frozen at contract 1); `floor_mod` is the
// wrap-around helper whose remainder takes the DIVISOR's sign, landing in
// [0, divisor).  `/` or `%` by zero is a null (C80), never a fault.
fn main() {
  // --- `/` truncates toward zero (not floor) ---
  assert(-7 / 2 == -3, "int div truncates toward zero (not -4)");
  assert(7 / -2 == -3, "int div truncates toward zero, negative divisor");
  assert(-7 / -2 == 3, "int div both negative");

  // --- `%` takes the dividend's sign ---
  assert(-7 % 2 == -1, "rem takes dividend sign (negative dividend)");
  assert(7 % -2 == 1, "rem takes dividend sign (positive dividend)");
  assert(-1 % 3 == -1, "rem -1 %% 3 is -1, not 2");

  // --- the division identity holds ---
  assert((-7 / 2)*2 + (-7 % 2) == -7, "a == (a/b)*b + a%%b");

  // --- floor_mod wraps into [0, divisor) (divisor's sign) ---
  assert((-1).floor_mod(3) == 2, "floor_mod(-1, 3) wraps to 2");
  assert((-4).floor_mod(3) == 2, "floor_mod(-4, 3) wraps to 2");
  assert((-7).floor_mod(3) == 2, "floor_mod(-7, 3) wraps to 2");
  assert((4).floor_mod(3) == 1, "floor_mod(4, 3) is 1");
  assert((0).floor_mod(3) == 0, "floor_mod(0, 3) is 0");
  assert(floor_mod(7, 3) == 1, "floor_mod free-fn form");

  // circular indexing: (i - 1) wraps to the last index instead of going negative
  w = 5;
  assert((0 - 1).floor_mod(w) == 4, "wrap-around index lands on last, not -1");

  // --- div/mod/floor_mod by zero is a null, dischargeable with `??` ---
  zero = 0;
  assert(! (5 / zero ?? null), "div by zero is null");
  assert(! (5 % zero ?? null), "mod by zero is null");
  assert(((5).floor_mod(zero) ?? -99) == -99, "floor_mod by zero is null");
}
