//
// @PLN22 Phase 2 — prelude shadowing.  A user definition shadows a stdlib name
// of the same key (the "pick a different name" wall is gone): the main program
// parses under its own source (MAIN_SOURCE = 1), distinct from the stdlib prelude
// (source 0), so bare names resolve to the user's defs while `std::Name` still
// reaches the prelude.  Built-in type-keywords (`integer`, `vector`, …) stay a
// hard error (see 102-expected-errors.loft) — shadowing them is never intended.
enum E {
  Red,
  Green,
} // shadows the math constant E
pub PI = 3; // shadows the math constant PI
struct File {
  tag: integer,
} // shadows the stdlib struct File
enum Format {
  Compact,
  Pretty,
} // shadows the stdlib enum Format

fn test_pln22_prelude_shadowing() {
  // user enum E wins bare resolution; std::E still reaches Euler's number.
  x: E = Red;
  assert(x is Red, "user enum E shadows the constant");
  assert(std::E > 2.718 && std::E<2.719, "std::E still reaches the prelude constant");

  // user const PI wins; std::PI still reaches the math constant.
  assert(PI == 3, "user const PI shadows");
  assert(std::PI > 3.141 && std::PI<3.142, "std::PI still reaches the prelude constant");

  // user struct File wins (its own fields, no DB-layer clash with stdlib File).
  f = File { tag: 7 };
  assert(f.tag == 7, "user struct File shadows the stdlib struct");

  // user enum Format wins.
  fmt = Format.Pretty;
  assert(fmt is Pretty, "user enum Format shadows the stdlib enum");
}
