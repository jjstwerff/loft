// A collection key is read at TWO places — the record side (`keys::get_key` /
// `hash_ref`) and the lookup side (the interpreter's `get_key`, the native
// generator's `emit_content`) — and both must answer the same `Content` for the
// same stored bytes.  Two widths were missing an arm and fell to a catch-all,
// each of which lost records SILENTLY:
//
//  - `float` / `single` keys: `get_key` had no arm, so it read ONE BYTE and called
//    it a `Content::Long`.  Every key whose low byte is zero — 0.5, 1.5, 2.0, …,
//    which is nearly every float a program writes — became the same key, so a
//    `sorted<T[k]>` collapsed to its LAST insert and a `hash<T[k]>` probed a bucket
//    `hash_ref` never filled.  Both backends.
//  - narrow (`u8` / `u16` / `i32`) keys: the NATIVE generator had no arm
//    in `emit_content`, so every lookup searched for `Content::Long(0)` (loft#811).
//    A `hash` missed records that were present; a `sorted`/`index` answered a
//    reference whose fields all read null.  Interpreter-only correct.
//
// The cells assert VALUE and LENGTH and a MISS, at sizes on both sides of the first
// hash resize, because a degenerate key answers a plausible length right up to the
// point where two keys collide.
//
// The widths NOT covered here are the ones whose storage carries a non-zero start —
// `i8`, `i16`, `integer limit(min, max)` — which cannot be looked up on EITHER
// backend (loft#812): the record side decodes them with the start hardcoded to 0
// while the lookup side reads the raw value, so the two differ by exactly that
// start.  That needs `Key` to carry the field's start, which is a schema surface.

struct KFloat  { k: float, n: integer }
struct KSingle { k: single, n: integer }
struct KByte   { k: u8, n: integer }
struct KShort  { k: u16, n: integer }
struct KInt    { k: i32, n: integer }
struct KText   { k: text, n: integer }
struct KWide   { k: integer, n: integer }

// Every value the loop writes is distinct, so `len` alone catches a key that
// collapses, and the per-key read catches one that is merely misplaced.
fn f_hash(n: integer) -> integer {
  h: hash<KFloat[k]> = [];
  for i in 0..n { h += KFloat { k: i + 0.5, n: i * 3 }; }
  bad = 0;
  for j in 0..n { e = h[j + 0.5]; if e == null || e.n != j * 3 { bad += 1; } }
  if h[0.25] != null { bad += 1000; }
  return len(h) * 10000 + bad;
}

fn f_sorted(n: integer) -> integer {
  s: sorted<KFloat[k]> = [];
  for i in 0..n { s += KFloat { k: (n - i) + 0.5, n: i * 3 }; }
  // Key order must be ascending even though the inserts descend.
  last = 0.0;
  bad = 0;
  for e in s { if e.k <= last { bad += 1; } last = e.k; }
  return len(s) * 10000 + bad;
}

fn main() {
  // --- float, across the first resizes -----------------------------------------
  for n in 1..25 {
    r = f_hash(n);
    assert(r == n * 10000, "float hash at {n}: len={r / 10000} bad={r % 10000}");
    rs = f_sorted(n);
    assert(rs == n * 10000, "float sorted at {n}: len={rs / 10000} bad={rs % 10000}");
  }

  // --- single ------------------------------------------------------------------
  g: hash<KSingle[k]> = [];
  for i in 0..24 { g += KSingle { k: (i as single) + 0.5f, n: i * 3 }; }
  assert(len(g) == 24, "single hash len {len(g)}");
  gbad = 0;
  for j in 0..24 { ge = g[(j as single) + 0.5f]; if ge == null || ge.n != j * 3 { gbad += 1; } }
  assert(gbad == 0, "single hash lookups: {gbad} wrong");

  gs: sorted<KSingle[k]> = [];
  for i in 0..24 { gs += KSingle { k: (24 - (i as single)) + 0.5f, n: i * 3 }; }
  assert(len(gs) == 24, "single sorted len {len(gs)}");

  // --- narrow integer keys (loft#811 — native-only before the fix) --------------
  hb: hash<KByte[k]> = [];
  sb: sorted<KByte[k]> = [];
  for i in 0..24 {
    hb += KByte { k: ((i + 200) as u8?)?, n: i * 3 };
    sb += KByte { k: ((i + 200) as u8?)?, n: i * 3 };
  }
  assert(len(hb) == 24 && len(sb) == 24, "u8 key len {len(hb)}/{len(sb)}");
  bbad = 0;
  for j in 0..24 {
    bk = ((j + 200) as u8?)?;
    be = hb[bk];
    bs = sb[bk];
    if be == null || be.n != j * 3 || bs == null || bs.n != j * 3 { bbad += 1; }
  }
  assert(bbad == 0, "u8 key lookups: {bbad} wrong");
  assert(!hb[((7) as u8?)?], "u8 key miss");

  hs: hash<KShort[k]> = [];
  for i in 0..24 { hs += KShort { k: ((i * 300) as u16?)?, n: i * 3 }; }
  assert(len(hs) == 24, "u16 key len {len(hs)}");
  sbad = 0;
  for j in 0..24 {
    se = hs[((j * 300) as u16?)?];
    if se == null || se.n != j * 3 { sbad += 1; }
  }
  assert(sbad == 0, "u16 key lookups: {sbad} wrong");

  hi: hash<KInt[k]> = [];
  for i in 0..24 { hi += KInt { k: ((100000 - (i * 7)) as i32?)?, n: i * 3 }; }
  assert(len(hi) == 24, "i32 key len {len(hi)}");
  ibad = 0;
  for j in 0..24 {
    ie = hi[((100000 - (j * 7)) as i32?)?];
    if ie == null || ie.n != j * 3 { ibad += 1; }
  }
  assert(ibad == 0, "i32 key lookups: {ibad} wrong");

  // --- the widths that already worked, so the fix cannot have moved them ---------
  hw: hash<KWide[k]> = [];
  ht: hash<KText[k]> = [];
  for i in 0..24 { hw += KWide { k: i * 5, n: i * 3 }; ht += KText { k: "k{i}", n: i * 3 }; }
  assert(len(hw) == 24 && len(ht) == 24, "control len {len(hw)}/{len(ht)}");
  wbad = 0;
  for j in 0..24 {
    we = hw[j * 5];
    te = ht["k{j}"];
    if we == null || we.n != j * 3 || te == null || te.n != j * 3 { wbad += 1; }
  }
  assert(wbad == 0, "control lookups: {wbad} wrong");

  println("811-collection-key-widths ok");
}
