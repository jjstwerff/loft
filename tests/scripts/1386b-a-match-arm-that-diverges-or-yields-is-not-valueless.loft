//
// The ACCEPTING side of loft#1386's boundary: what a value-position `match` must still take.
// The refusal itself is `1386-a-value-position-match-needs-a-value-from-every-arm.loft`; this
// file is what stops it widening.
//
// The cell that matters most is the DIVERGENT arm.  `match k { 1 => 5, _ => { return -1; } }`
// has an arm that yields no value, and refusing it would break the commonest early-exit shape
// in the language.  It is admissible because a divergent arm is `Type::Never`, not
// `Type::Void` — the path does not continue, so there is no value for it to owe — and the
// refusal tests `Void` alone.  The two are easy to lump together, which is why this is pinned
// rather than left to the reader.
//
// The other cells cover the six arm-join sites the fix had to reach — the enum arms, the
// wildcard, and the scalar, vector and tuple forms — because a guard exercising only the
// scalar form cannot tell a five-site fix from a six-site one.
//
// @falsified-at: none — every cell here is a shape that WORKED before loft#1386 and must keep
//   working; it is the negative control of that fix, not a fix of its own, so no earlier build
//   is a control for it.

enum Colour1386 { Red, Green }
struct Pt1386 { x: integer, y: integer }

fn early(k: integer) -> integer {
  v = match k { 1 => { 5 }, _ => { return -1; } };
  v
}

fn early_bare(k: integer) -> integer {
  v = match k { 1 => 5, _ => { return -1; } };
  v
}

fn early_if(k: integer) -> integer {
  v = if k == 1 { 5 } else { return -1; };
  v
}

fn main() {
  // A DIVERGENT arm is not a valueless one: `Never`, not `Void`.
  assert(early(1) == 5 && early(2) == -1, "a return arm, block form");
  assert(early_bare(1) == 5 && early_bare(2) == -1, "a return arm, bare form");
  assert(early_if(1) == 5 && early_if(2) == -1, "a return arm in the `if` twin");

  // The SCALAR form at two element types.
  k = 2;
  vi = match k { 1 => { 5 }, _ => { 7 } };
  assert(vi == 7, "a scalar value match at integer, vi={vi}");
  vt = match k { 1 => { "a" }, _ => { "b" } };
  assert(vt == "b", "a scalar value match at text, vt={vt}");

  // The ENUM-subject form.
  c = Colour1386::Green;
  ve = match c { Colour1386::Red => { 1 }, Colour1386::Green => { 2 } };
  assert(ve == 2, "an enum-subject value match, ve={ve}");

  // The VECTOR form.
  xs: vector<integer> = [1, 2];
  vv = match xs { [] => { 0 }, _ => { len(xs) } };
  assert(vv == 2, "a vector-subject value match, vv={vv}");

  // The TUPLE form.
  t = (1, 2);
  vp = match t { (1, _) => { 10 }, _ => { 20 } };
  assert(vp == 10, "a tuple-subject value match, vp={vp}");

  // A STATEMENT match still discards either arm, in either order (loft#1382).
  match k { 1 => { println("x") }, _ => { 5 } };
  match k { 1 => { 5 }, _ => { println("y") } };

  println("1386b OK");
}
