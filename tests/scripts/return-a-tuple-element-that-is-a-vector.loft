//
// A function whose tail PROJECTS a container out of a local must copy the projection
// into the caller's buffer, whichever way the projection is written.
//
// The NRVO promotion ladder refuses to rename a local onto `__retbuf` when the tail
// merely projects a value OUT of that local (#425): the local holds the whole
// container while the function returns a part of it, so renaming would make the
// caller's buffer be the container and free the part at scope exit. That refusal
// asked `return_field_base_var`, which matched the op-call spelling of a projection
// (`OpGetField(Var(base), …)`) and not the tuple-element one — `TupleGet` carries its
// base as a var NUMBER and is a `Value` variant, so no call pattern can see it.
//
// A tuple-element tail therefore renamed the TUPLE local onto a vector-shaped
// `__retbuf`: the prologue cleared a stack tuple slot as a vector, the tail became a
// discarded statement and the function returned null. The interpreter answered the
// right elements off the eval stack and then panicked on a corrupt reference at exit;
// `--native` refused to compile the program at all (the parameter typed `DbRef`,
// assigned a `(DbRef, i64)`).
//
// BINDING the projection first (`e = t.0; e`) is a DIFFERENT gate and still hands back
// a view — as does the vector-element spelling of it (`e = vv[0]; e`, which answers an
// empty vector). That shape is not tuple-specific and is loft#1101; the rows below are
// the tail forms.
//
// Each row asserts the value AND the length, and every projection runs before a churn
// that recycles freed records — a dangling read answers stale bytes otherwise, and
// every row would pass over a store that is already free. `tests/wrap.rs` fails this
// file on a store-leak warning at exit, so the copy this needs cannot be paid for by
// simply not freeing.

struct Bag { items: vector<integer>, n: integer }

// c1 — the defect: an implicit tail projecting element 0 of a tuple LOCAL.
fn rt_first() -> vector<integer> {
  v = [11, 22, 33];
  t = (v, 7);
  t.0
}

// c2 — the vector as the SECOND member, so the fault is not tied to offset 0.
fn rt_second() -> vector<integer> {
  v = [44, 55];
  t = (7, v);
  t.1
}

// c3 — a text element: the text ladder carries its own tuple-local carve-out, and it
//      must keep answering after the vector side learned the same rule.
fn rt_text() -> text {
  s = "hello";
  t = (s, 7);
  t.0
}

// c4 — vector<text>, so the element type is itself heap-backed.
fn rt_text_vector() -> vector<text> {
  v = ["a", "bb"];
  t = (v, 7);
  t.0
}

// c5 — the EXPLICIT return of the same projection was always sound; it must stay so.
fn rt_explicit() -> vector<integer> {
  v = [11, 22, 33];
  t = (v, 7);
  return t.0;
}

// c6 — the sibling spelling of the same projection (a struct FIELD), which the
//      op-call pattern already saw. It is the control that says the two spellings of
//      one projection now agree.
fn rt_field() -> vector<integer> {
  b = Bag { items: [11, 22, 33], n: 7 };
  b.items
}

// c7 — the tuple element is a scalar: nothing is projected out of the heap, so the
//      rename question does not arise and the value must simply arrive.
fn rt_scalar() -> integer {
  v = [11, 22, 33];
  t = (v, 7);
  t.1
}

// Hand a wrongly-freed slot to the next allocation and write over it, so a dangling
// read cannot answer the bytes it used to hold.
fn rt_churn() -> integer {
  n = 0;
  for i in 0..40 {
    h: vector<integer> = [i, i + 1, i + 2, i + 3];
    n = n + len(h) + i;
  }
  n
}

fn main() {
  a1 = rt_first();
  rt_churn();
  assert(len(a1) == 3, "c1 len = {len(a1)}, want 3");
  assert(a1[0] == 11, "c1[0] = {a1[0]}, want 11");
  assert(a1[2] == 33, "c1[2] = {a1[2]}, want 33");

  a2 = rt_second();
  rt_churn();
  assert(len(a2) == 2, "c2 len = {len(a2)}, want 2");
  assert(a2[1] == 55, "c2[1] = {a2[1]}, want 55");

  a3 = rt_text();
  rt_churn();
  assert(a3 == "hello", "c3 = {a3}, want hello");

  a4 = rt_text_vector();
  rt_churn();
  assert(len(a4) == 2, "c4 len = {len(a4)}, want 2");
  assert(a4[1] == "bb", "c4[1] = {a4[1]}, want bb");

  a5 = rt_explicit();
  rt_churn();
  assert(len(a5) == 3, "c5 len = {len(a5)}, want 3");
  assert(a5[1] == 22, "c5[1] = {a5[1]}, want 22");

  a7 = rt_field();
  rt_churn();
  assert(len(a7) == 3, "c6 len = {len(a7)}, want 3");
  assert(a7[2] == 33, "c6[2] = {a7[2]}, want 33");

  a8 = rt_scalar();
  assert(a8 == 7, "c7 = {a8}, want 7");
}
