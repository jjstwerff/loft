//
// A destructured tuple element must be a value the binding OWNS, not a view into
// the buffer the call answered in.
//
// A tuple return wider than 8B lands in a synthetic `__tuple<…>` record held by a
// work-ref belonging to the CALL SITE, so one site reuses one buffer. Reassigning
// that work-ref frees the store it named — and that is exactly what the next turn of
// a loop does, BEFORE the call it feeds. A binding left pointing into the buffer
// therefore dangles from the second iteration on. Reading a freed store answers its
// cleared contents, so `(xs, n) = passthrough(xs)` silently reported `len` 0 while
// `--native` answered correctly; appending onto a record the arena had recycled
// panicked in `vector_append`. One use-after-free, two symptoms.
//
// loft#941 filed it as a vector defect tied to the tuple crossing a loop back-edge.
// It is neither: c6 shows a plain STRUCT element fails identically, so the axis is
// any element read back as a pointer, and c3 shows the `xs = f(xs)` spelling is not
// needed — any binding that names the buffer and is read after the site runs again
// will do. What IS load-bearing is the SITE repeating: c10 alternates two distinct
// call sites, each with its own buffer, and was always correct.
//
// Each row asserts the value AND the length, and `tests/wrap.rs` fails this file on
// a store-leak warning at exit. Both halves are needed: the copy this fix introduces
// is a new allocation, so a version that simply stopped freeing the buffer would pass
// every value row and leak c11/c12 instead.

struct P { x: integer, tag: integer }

fn r941_pass(v: vector<integer>) -> (vector<integer>, integer) { (v, len(v)) }
fn r941_grow(v: vector<integer>) -> (vector<integer>, integer) { v += [1]; (v, len(v)) }
fn r941_swap(v: vector<integer>) -> (integer, vector<integer>) { (len(v), v) }
fn r941_bump(p: P) -> (P, integer) { (p, p.x) }
fn r941_txt(v: vector<text>) -> (vector<text>, integer) { (v, len(v)) }
fn r941_nest(v: vector<vector<integer>>) -> (vector<vector<integer>>, integer) { (v, len(v)) }
fn r941_two(a: vector<integer>, b: vector<integer>) -> (vector<integer>, vector<integer>) { (a, b) }
fn r941_fresh(seed: integer) -> (vector<integer>, integer) {
  w: vector<integer> = [seed, seed + 1];
  (w, 2)
}
fn r941_plain(v: vector<integer>) -> vector<integer> { v }
fn r941_site2(v: vector<integer>) -> (vector<integer>, integer) { (v, len(v)) }

// Hand a wrongly-freed slot to the next allocation and write over it. Without this a
// dangling read can still answer the old bytes, and every row below passes while the
// store is already free.
fn r941_churn() -> integer {
  n = 0;
  for i in 0..40 {
    h: vector<integer> = [i, i + 1, i + 2, i + 3];
    n = n + len(h) + i;
  }
  n
}

fn main() {
  // c1 — the filed shape. The callee never touches the vector, so every iteration
  //      must see all three elements; before the fix iteration 2 onward saw none.
  c1: vector<integer> = [7, 8, 9];
  seen1 = 0;
  for q1 in 0..3 {
    (c1, n1) = r941_pass(c1);
    seen1 = seen1 + n1;
  }
  r941_churn();
  assert(seen1 == 9, "c1 callee saw {seen1} elements over 3 iterations, want 9");
  assert(len(c1) == 3, "c1 len = {len(c1)}, want 3");
  assert(c1[0] == 7, "c1[0] = {c1[0]}, want 7");
  assert(c1[2] == 9, "c1[2] = {c1[2]}, want 9");

  // c2 — the loud half of the same fault: the callee APPENDS, so the write lands on
  //      the recycled record instead of reading it. Two iterations were enough to
  //      panic in `vector_append`.
  c2: vector<integer> = [];
  for q2 in 0..4 { (c2, n2) = r941_grow(c2); }
  r941_churn();
  assert(len(c2) == 4, "c2 len = {len(c2)}, want 4");

  // c3 — the binding fed back is NOT the one the loop started from, so the
  //      `xs = f(xs)` spelling the report used is not the axis: a binding that names
  //      the buffer is enough.
  c3src: vector<integer> = [7, 8, 9];
  (c3, m3) = r941_pass(c3src);
  for q3 in 0..3 { (c3, n3) = r941_pass(c3); }
  r941_churn();
  assert(len(c3) == 3, "c3 len = {len(c3)}, want 3");
  assert(c3[1] == 8, "c3[1] = {c3[1]}, want 8");

  // c4 — the vector is the SECOND tuple member, so the defect is not tied to
  //      offset 0.
  c4: vector<integer> = [7, 8, 9];
  for q4 in 0..3 { (n4, c4) = r941_swap(c4); }
  r941_churn();
  assert(len(c4) == 3, "c4 len = {len(c4)}, want 3");
  assert(c4[2] == 9, "c4[2] = {c4[2]}, want 9");

  // c5 — a `while` back-edge, not a `for` one.
  c5: vector<integer> = [7, 8, 9];
  i5 = 0;
  while i5 < 3 {
    (c5, n5) = r941_pass(c5);
    i5 = i5 + 1;
  }
  r941_churn();
  assert(len(c5) == 3, "c5 len = {len(c5)}, want 3");

  // c6 — a plain STRUCT element. The report named `vector<T>`; a record read back
  //      from the buffer is the same pointer and failed the same way, answering a
  //      zeroed field rather than an empty collection.
  c6 = P { x: 5, tag: 987654321987 };
  for q6 in 0..3 { (c6, n6) = r941_bump(c6); }
  r941_churn();
  assert(c6.x == 5, "c6.x = {c6.x}, want 5");
  assert(c6.tag == 987654321987, "c6.tag = {c6.tag}, want 987654321987");

  // c7 — TWO collections in one tuple: both are bindings into the one buffer, and
  //      both were emptied, so a fix that materialised only the first would pass c1
  //      and fail here.
  c7a: vector<integer> = [1, 2, 3];
  c7b: vector<integer> = [4, 5];
  for q7 in 0..3 { (c7a, c7b) = r941_two(c7a, c7b); }
  r941_churn();
  assert(len(c7a) == 3, "c7a len = {len(c7a)}, want 3");
  assert(len(c7b) == 2, "c7b len = {len(c7b)}, want 2");
  assert(c7b[1] == 5, "c7b[1] = {c7b[1]}, want 5");

  // c8 — a `text` element type, whose elements are themselves stored.
  c8: vector<text> = ["alpha", "beta"];
  for q8 in 0..3 { (c8, n8) = r941_txt(c8); }
  r941_churn();
  assert(len(c8) == 2, "c8 len = {len(c8)}, want 2");
  assert(c8[0] == "alpha", "c8[0] = {c8[0]}, want alpha");

  // c9 — a nested collection, where the copy has to reach the inner vectors too.
  c9: vector<vector<integer>> = [[1, 2], [3]];
  for q9 in 0..3 { (c9, n9) = r941_nest(c9); }
  r941_churn();
  assert(len(c9) == 2, "c9 len = {len(c9)}, want 2");
  assert(len(c9[0]) == 2, "c9[0] len = {len(c9[0])}, want 2");

  // c10 — CONTROL: two DISTINCT call sites alternating in one loop. Each site owns
  //       its own buffer, so no site ever reassigns one a live binding names. This
  //       was always correct and pins that the fix did not change it.
  c10: vector<integer> = [7, 8, 9];
  for q10 in 0..3 {
    (c10, a10) = r941_pass(c10);
    (c10, b10) = r941_site2(c10);
  }
  r941_churn();
  assert(len(c10) == 3, "c10 len = {len(c10)}, want 3");

  // c11 — CONTROL: the callee IGNORES its argument and answers a fresh collection,
  //       so the buffer's own store must still be freed. The leak gate is what
  //       proves it is: a fix that stopped freeing the buffer would pass every value
  //       row above and leak here.
  c11: vector<integer> = [];
  for q11 in 0..3 { (c11, n11) = r941_fresh(q11); }
  r941_churn();
  assert(len(c11) == 2, "c11 len = {len(c11)}, want 2");
  assert(c11[0] == 2, "c11[0] = {c11[0]}, want 2");

  // c12 — CONTROL: the result goes to a DIFFERENT binding, so the argument never
  //       names the buffer. Correct before the fix, and still must not leak.
  c12src: vector<integer> = [7, 8, 9];
  c12: vector<integer> = [];
  for q12 in 0..3 { (c12, n12) = r941_pass(c12src); }
  r941_churn();
  assert(len(c12) == 3, "c12 len = {len(c12)}, want 3");
  assert(len(c12src) == 3, "c12 source len = {len(c12src)}, want 3");

  // c13 — CONTROL: a plain (non-tuple) collection return is a different lowering
  //       with no buffer at all, and was always correct.
  c13: vector<integer> = [7, 8, 9];
  for q13 in 0..3 { c13 = r941_plain(c13); }
  r941_churn();
  assert(len(c13) == 3, "c13 len = {len(c13)}, want 3");

  println("ok");
}
