//
// @PLN85 / D-own — regression guard for the mid-body-return self-copy.
// A function whose body ends in a tail return but ALSO has a mid-body
// `return out` (after `out += [..]`) where `out` aliases the NRVO buffer:
// the return machinery delivered it with `OpClearVector(buf); OpAppendVector(
// buf, out)`, but `out` IS `buf`, so the clear emptied it and the append
// copied from the now-empty source — the mid-body return came back EMPTY.
// `OpReplaceVector` makes the delivery aliasing-safe (a no-op when source and
// dest are the same backing vector), so a non-empty aliasing `return out`
// keeps its elements.  This was the root of the RFC-6962 consistency-proof
// failure (the `m == n` base case returned an empty commit).
fn pick(x: integer) -> vector<text> {
  out: vector<text> = [];
  if x == 0 { out += ["a"]; return out; }   // mid-body return; out aliases the buffer
  out += ["b"]; out += ["c"];
  return out;                                // tail return
}
fn main() {
  a = pick(0);
  assert(len(a) == 1, "mid-body return lost its element: len={len(a)} (want 1)");
  assert((a[0] ?? "?") == "a", "mid-body return wrong value");
  b = pick(1);
  assert(len(b) == 2, "tail return wrong: len={len(b)} (want 2)");
  println("mid-return aliasing-deliver ok: pick(0)=[{a[0] ?? \"?\"}] pick(1) len={len(b)}");
}
