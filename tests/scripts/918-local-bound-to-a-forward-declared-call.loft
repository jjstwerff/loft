//
// A local bound to a call declared LOWER in the file compiles, and the value it
// returns is the value the callee produced.
//
// Pass 1 registers declarations as it reads them, so a call to a function further
// down the file has nothing to resolve against and the local it binds reads
// `Unknown` for the rest of pass 1. Two things then went wrong, and both are here.
//
// The local returned as a text tail is promoted into a hidden `&text` work buffer,
// and that decision is made from the local's TYPE — so it happened on pass 2 alone.
// The signature grew one argument after pass 2 had lowered calls against the old
// one: with the caller below the callee that aborted the compiler on the H5
// two-pass contract, and with the caller above it the call really did pass one
// argument too few (loft#918). The promotion is now settled between the passes,
// where the callee exists, so both passes see one signature.
//
// The second half is the same missing type reaching an OPERATOR: `w + "!"` on a
// pass-1-untyped `w` matched nothing and was rejected as "No matching operator '+'
// on 'unknown' and 'text'", ending the parse before the pass that resolves it. No
// operator match plus an untyped operand is a deferral on pass 1, not a reject —
// a genuinely unmatchable operand reaches the same reject on pass 2, where the
// message names the type it really has.
//
// Both halves are needed to trigger either: the forward reference alone is fine
// (`fwd_direct_tail`), and the local binding alone is fine.

// --- the filed shape: caller below, bare-name tail ---------------------------

fn fwd_bound_tail(n: integer) -> text {
  b_t = fwd_text(n, 12);
  b_t
}

// --- the same through an explicit `return`, which types as Never -------------

fn fwd_bound_return(n: integer) -> text {
  r_t = fwd_text(n, 1);
  return r_t;
}

// --- `text?`, which shares text's storage and so the same buffer -------------

fn fwd_bound_optional(n: integer) -> text? {
  o_t = fwd_optional(n);
  o_t
}

// --- a chain: every link binds a local to the link below it ------------------

fn fwd_chain_a(n: integer) -> text { c_a = fwd_chain_b(n); c_a }
fn fwd_chain_b(n: integer) -> text { c_b = fwd_chain_c(n); c_b }
fn fwd_chain_c(n: integer) -> text { "c{n}" }

// --- the operand half: the local is read by an operator, not returned bare ---

fn fwd_bound_operand(n: integer) -> text {
  p_t = fwd_text(n, 9);
  p_t + "!"
}

// --- controls: the same shapes that never broke, so a regression shows here --

fn fwd_direct_tail(n: integer) -> text { fwd_text(n, 4) }

fn fwd_bound_integer(n: integer) -> integer {
  i_v = fwd_int(n);
  i_v
}

fn fwd_bound_unreturned(n: integer) -> integer {
  u_t = fwd_text(n, 5);
  len(u_t)
}

fn fwd_bound_struct(n: integer) -> FwdPoint {
  s_p = fwd_point(n);
  s_p
}

fn fwd_bound_vector(n: integer) -> vector<integer> {
  v_v = fwd_vector(n);
  v_v
}

// --- a method, whose def is mangled `t_<LEN><Type>_<fn>` rather than `n_<fn>` -

fn describe(self: FwdPoint) -> text {
  d_t = fwd_text(self.x, 7);
  d_t
}

// --- everything the shapes above forward-reference --------------------------

fn fwd_text(a: integer, b: integer) -> text { "{a}/{b}" }
fn fwd_optional(a: integer) -> text? { "o{a}" }
fn fwd_int(a: integer) -> integer { a + 100 }
fn fwd_point(a: integer) -> FwdPoint { FwdPoint { x: a } }
fn fwd_vector(a: integer) -> vector<integer> { [a, a + 1] }

struct FwdPoint { x: integer }

fn main() {
  assert(fwd_bound_tail(3) == "3/12", "bound tail gave {fwd_bound_tail(3)}, want 3/12");
  assert(fwd_bound_return(3) == "3/1", "bound return gave {fwd_bound_return(3)}, want 3/1");
  q_t = fwd_bound_optional(3) ?? "null";
  assert(q_t == "o3", "bound text? gave {q_t}, want o3");
  assert(fwd_chain_a(7) == "c7", "chained binds gave {fwd_chain_a(7)}, want c7");
  assert(fwd_bound_operand(3) == "3/9!", "bound operand gave {fwd_bound_operand(3)}, want 3/9!");

  assert(fwd_direct_tail(3) == "3/4", "direct tail gave {fwd_direct_tail(3)}, want 3/4");
  assert(fwd_bound_integer(3) == 103, "bound integer gave {fwd_bound_integer(3)}, want 103");
  assert(fwd_bound_unreturned(3) == 3, "bound unreturned gave {fwd_bound_unreturned(3)}, want 3");
  assert(fwd_bound_struct(3).x == 3, "bound struct gave {fwd_bound_struct(3).x}, want 3");
  assert(fwd_bound_vector(3)[1] == 4, "bound vector gave {fwd_bound_vector(3)[1]}, want 4");

  // The buffer is per call, so two calls in one expression must not share one.
  assert(fwd_bound_tail(1) + fwd_bound_tail(2) == "1/122/12",
         "two calls gave {fwd_bound_tail(1) + fwd_bound_tail(2)}, want 1/122/12");
  // And a promoted function called in a loop keeps answering afresh.
  l_s = "";
  for i in 0..3 { l_s += fwd_chain_a(i); }
  assert(l_s == "c0c1c2", "looped calls gave {l_s}, want c0c1c2");

  m_p = FwdPoint { x: 6 };
  assert(m_p.describe() == "6/7", "method bound tail gave {m_p.describe()}, want 6/7");

  println("918 ok");
}
