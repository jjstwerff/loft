//
// Regression (loft#701): a struct field whose default is a STRUCT LITERAL.
//
// The stored default was replayed in place after `object_init` rewrote its `Var(0)` to
// the record — but the block's field writes carry the NESTED struct's own offsets (0, 8),
// so they landed at the RECORD's, on whatever sibling sits there.  `A { x, p: P = P {…} }`
// read back `x` as `px`; with two siblings it was a SIGSEGV; and with `p` FIRST, where the
// offsets happen to line up, the supplied sibling was lost instead.
//
// So an `Object` default is not replayable, though it read as if it were, and it gets a
// frame of its own like any other default needing a temporary (loft#698): the caller then
// writes the field and applies its own `pos + fld`.  The verdict comes from the field's
// declared TYPE rather than the IR shape, because the two parser passes disagree about
// that shape — pass 1 has an offset-less `Insert`, pass 2 an `Object` block — and a
// definition that first appears in pass 2 is what the H5 guard rejects.
//
// Axes: field ORDER (the defaulted field first / last / between siblings), sibling
// CARDINALITY (one, two — two was the SIGSEGV), struct DEPTH (a literal holding a literal),
// and CARDINALITY of such defaults in one record.  Controls: naming the field at the
// construction site, letting the nested struct's OWN field defaults apply (the path that
// always recursed at the right offset), and the `= mk()` call default.

struct P701 { px: integer = 1, py: integer = 2 }
struct Q701 { qx: integer }

// The filed shape: one sibling before the defaulted field.
struct A701 { x: integer, p: P701 = P701 { px: 1, py: 2 } }
// Two siblings — this was the SIGSEGV.
struct B701 { x: integer, y: integer, p: P701 = P701 { px: 7, py: 8 } }
// The defaulted field FIRST, where the nested offsets line up with the record's.
struct C701 { p: P701 = P701 { px: 7, py: 8 }, x: integer }
// Two such defaults in one record.
struct D701 { x: integer, p: P701 = P701 { px: 1, py: 2 }, q: P701 = P701 { px: 3, py: 4 } }
// A literal holding a literal.
struct E701 { ex: integer, p: P701 = P701 { px: 5, py: 6 }, q: Q701 = Q701 { qx: 7 } }
// Control: no default at all — the nested struct's own field defaults apply.
struct F701 { x: integer, p: P701 }
// Control: a CALL default, which loft#698 already lowers into a frame of its own.
fn mk701() -> P701 { P701 { px: 8, py: 9 } }
struct G701 { x: integer, p: P701 = mk701() }

fn make701(n: integer) -> A701 { A701 { x: n } }

fn test() {
  // The filed shape: the default fills `p` and leaves the supplied sibling alone.
  a = A701 { x: 9 };
  assert(a.x == 9, "one sibling: x survives, got {a.x}");
  assert(a.p.px == 1 && a.p.py == 2, "one sibling: p filled, got {a.p.px} {a.p.py}");

  // Two siblings — the SIGSEGV shape.
  b = B701 { x: 9, y: 10 };
  assert(b.x == 9 && b.y == 10, "two siblings: both survive, got {b.x} {b.y}");
  assert(b.p.px == 7 && b.p.py == 8, "two siblings: p filled, got {b.p.px} {b.p.py}");

  // The defaulted field FIRST: the sibling AFTER it is what was lost.
  c = C701 { x: 9 };
  assert(c.p.px == 7 && c.p.py == 8, "field first: p filled, got {c.p.px} {c.p.py}");
  assert(c.x == 9, "field first: the sibling survives, got {c.x}");

  // Two such defaults in one record — each fills its own field.
  d = D701 { x: 9 };
  assert(d.x == 9, "two defaults: x survives, got {d.x}");
  assert(d.p.px == 1 && d.p.py == 2, "two defaults: p, got {d.p.px} {d.p.py}");
  assert(d.q.px == 3 && d.q.py == 4, "two defaults: q, got {d.q.px} {d.q.py}");

  // A literal holding a literal.
  e = E701 { ex: 9 };
  assert(e.ex == 9, "nested: ex survives, got {e.ex}");
  assert(e.p.px == 5 && e.p.py == 6, "nested: p, got {e.p.px} {e.p.py}");
  assert(e.q.qx == 7, "nested: q, got {e.q.qx}");

  // Two construction sites, and one inside a called function that returns the record.
  p = A701 { x: 1 };
  q = A701 { x: 2 };
  assert(p.x == 1 && q.x == 2, "two sites: scalars, got {p.x} {q.x}");
  assert(p.p.px == 1 && q.p.px == 1, "two sites: both defaults built");
  r = make701(5);
  assert(r.x == 5 && r.p.py == 2, "returned: survives the return, got {r.x} {r.p.py}");

  // Construction in a LOOP.
  t = 0;
  for i in 0..3 {
    lp = A701 { x: i };
    t += lp.x + lp.p.px + lp.p.py;
  }
  assert(t == 12, "loop: every iteration built the default, got {t}");

  // Controls.
  s = A701 { x: 9, p: P701 { px: 4, py: 5 } };
  assert(s.x == 9 && s.p.px == 4 && s.p.py == 5, "control: named at the site, got {s.x} {s.p.px}");
  f = F701 { x: 9 };
  assert(f.x == 9 && f.p.px == 1 && f.p.py == 2, "control: P's own defaults, got {f.x} {f.p.px}");
  g = G701 { x: 9 };
  assert(g.x == 9 && g.p.px == 8 && g.p.py == 9, "control: call default, got {g.x} {g.p.px}");

  println("701-nested-struct-literal-default ok");
}
