//
// H6 + Part 2 — narrow-int ALIAS storage (u8/i8/u16/i16) is a memory-allocation
// type: the byte width is fixed, and the value range bends to the null sentinel.
//
// * Null is the ALL-ONES byte (255 / 65535), uniform across narrow types; a
//   value decodes as `read + min`, and only `min` varies (by type + nullability).
// * NULLABLE reserves one edge for the sentinel: unsigned drops the TOP
//   (u8 0..=254, u16 0..=65534), signed drops the BOTTOM so the range stays
//   SYMMETRIC (i8 -127..=127, i16 -32767..=32767).  The sacrificed value is out
//   of range (a compile error, not a silent null) — see the `as`-required cases
//   that this file does NOT exercise.
// * NOT-NULL uses the full native range (u8 0..=255, i8 -128..=127,
//   u16 0..=65535, i16 -32768..=32767) — the not-null 2-byte path (`ShortFull`)
//   is what lets a not-null u16 hold 65535 (the +1 `Short` encoding overflowed).
//
// Reads go through a local first (`r = v.z`) rather than inline `Struct{..}.z`:
// the inline construct-and-read of a byte field hits a separate, pre-existing
// native pre-eval gap (tracked apart from this storage design).

struct U8N  { x: u8? }           struct U8NN  { x: u8 not null }
struct I8N  { y: i8? }           struct I8NN  { y: i8 not null }
struct U16N { z: u16? }          struct U16NN { z: u16 not null }
struct I16N { w: i16? }          struct I16NN { w: i16 not null }

fn main() {
  // ── nullable: usable edges + null round-trip (symmetric signed) ──
  a = U8N { x: 254 };   ra = a.x;   assert(ra == 254, "u8 nullable max usable 254");
  an = U8N { x: null };  rn = an.x;  assert(rn == null, "u8 nullable null round-trips");
  b = I8N { y: 127 };   rb = b.y;   assert(rb == 127, "i8 nullable +127 (symmetric)");
  bm = I8N { y: -127 };  rbm = bm.y; assert(rbm == -127, "i8 nullable -127 (symmetric)");
  bn = I8N { y: null };  rbn = bn.y; assert(rbn == null, "i8 nullable null round-trips");
  c = U16N { z: 65534 }; rc = c.z;  assert(rc == 65534, "u16 nullable max usable 65534");
  cn = U16N { z: null }; rcn = cn.z; assert(rcn == null, "u16 nullable null round-trips");
  d = I16N { w: 32767 }; rd = d.w;  assert(rd == 32767, "i16 nullable +32767 (symmetric)");
  dm = I16N { w: -32767 }; rdm = dm.w; assert(rdm == -32767, "i16 nullable -32767 (symmetric)");
  dn = I16N { w: null }; rdn = dn.w; assert(rdn == null, "i16 nullable null round-trips");

  // ── not-null: full native range (the max no longer swallowed as null) ──
  e = U8NN { x: 255 };  re = e.x;   assert(re == 255, "u8 not-null full range 255");
  e0 = U8NN { x: 0 };   re0 = e0.x; assert(re0 == 0, "u8 not-null 0");
  f = I8NN { y: -128 }; rf = f.y;   assert(rf == -128, "i8 not-null full range -128");
  f2 = I8NN { y: 127 }; rf2 = f2.y; assert(rf2 == 127, "i8 not-null 127");
  g = U16NN { z: 65535 }; rg = g.z; assert(rg == 65535, "u16 not-null full range 65535");
  h = I16NN { w: -32768 }; rh = h.w; assert(rh == -32768, "i16 not-null full range -32768");
  h2 = I16NN { w: 32767 }; rh2 = h2.w; assert(rh2 == 32767, "i16 not-null 32767");
}
