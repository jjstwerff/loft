// Probe 02 — double Set to hidden buffer before tail.
//
//   fn render_double(p: P) -> Canvas {
//     cv = alloc_canvas(3, 3, p.tag);     // First Set — NOT S1-substituted
//     cv = alloc_canvas(4, 5, p.tag + 1); // Second Set (penultimate; S1 substitutes)
//     cv
//   }
//
// S1 fires only on the IMMEDIATE penultimate `Set(cv, Call(...))`.  So:
// - First Set: `Set(cv, Call(alloc_canvas, [..., __ref_local_a]))` — args do
//   not contain Var(cv); S2's narrow gate doesn't fire; pre-Set OpFreeRef
//   on cv FIRES and frees the caller's buffer.
// - Second Set: S1-substituted; S2 fires; safe.
//
// The first Set leaves the caller's slot in a recycled-but-dangling state,
// which iter 1+ exposes when other allocations have shifted the slot map.
//
// Expected: FAIL on --interpret (corruption surfaces at iter 1 in
// `cv_a.data[0]` — reads the FIRST call's content (i) instead of the
// second (i+1), or null(oob)).  Native: PASS.
//
// Status: known broken.  Target for fix arc.

struct P {
  tag: integer,
}
struct Canvas {
  data: vector<integer>,
  w: integer,
}

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render_double(p: P) -> Canvas {
  cv = alloc_canvas(3, 3, p.tag);
  cv = alloc_canvas(4, 5, p.tag + 1);
  cv
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv_a = render_double(p);
    assert(cv_a.w == 4, "iter {i}: cv_a.w = {cv_a.w}");
    assert(len(cv_a.data) == 5, "iter {i}: len(cv_a) = {len(cv_a.data)}");
    assert(cv_a.data[0] == i + 1, "iter {i}: cv_a[0] = {cv_a.data[0]} (expect {i + 1})");
  }
  println("probe 02 PASSED");
}
