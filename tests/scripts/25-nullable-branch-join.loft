// @PLN25 — branch-join widening: `integer ⊔ integer? = integer?`. An if/match with one
// non-null `integer` arm and one `integer?` arm joins to `integer?` (the nullable arm
// absorbs the non-null one), no error — a widen, distinct from narrowing into a narrow
// nullable target. Both arm orders. Both backends.
fn pick(e: boolean, a: integer, b: integer?) -> integer? {
  if e { a } else { b }
}
fn pick_rev(e: boolean, a: integer, b: integer?) -> integer? {
  if e { b } else { a }
}
fn pick_local(e: boolean, a: integer, b: integer?) -> integer? {
  x = if e { a } else { b }; x
}

fn main() {
  assert(pick(true, 5, 9) == 5, "pick then={pick(true, 5, 9)}");
  assert(pick(false, 5, null) == null, "pick else should be null");
  assert(pick_rev(true, 5, null) == null, "pick_rev then should be null");
  assert(pick_rev(false, 5, 9) == 5, "pick_rev else={pick_rev(false, 5, 9)}");
  assert(pick_local(true, 5, 9) == 5, "pick_local={pick_local(true, 5, 9)}");
  assert(pick_local(false, 5, null) == null, "pick_local else should be null");
}
