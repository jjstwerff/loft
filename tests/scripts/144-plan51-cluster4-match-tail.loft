// Probe 18 — match-arm tail returning hidden buffer.
//
//   fn render_match(p: P) -> Canvas {
//     match p.tag % 3 {
//       0 => alloc_canvas(4, 5, 100),
//       1 => alloc_canvas(4, 5, 200),
//       _ => alloc_canvas(4, 5, 300),
//     }
//   }
//
// match arms each terminate with a hidden-buffer-returning call.
// match lowers to nested If, so this is similar to probe 08 (if-tail).
// Tests: does the @P236 unify_if_branches_work_refs machinery handle
// the match-lowered nested-If case correctly?

struct P {
  tag: integer,
}
struct Canvas {
  data: vector<integer>,
  w: integer,
}

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render_match(p: P) -> Canvas {
  match p.tag % 3 {
    0 => alloc_canvas(4, 5, 100),
    1 => alloc_canvas(4, 5, 200),
    _ => alloc_canvas(4, 5, 300),
  }
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv = render_match(p);
    expected = if i % 3 == 0 { 100 } else if i % 3 == 1 { 200 } else { 300 };
    assert(cv.w == 4, "iter {i}: w = {cv.w}");
    assert(len(cv.data) == 5, "iter {i}: len = {len(cv.data)}");
    assert(cv.data[0] == expected, "iter {i}: data[0] = {cv.data[0]} (expect {expected})");
  }
  println("probe 18 PASSED");
}
