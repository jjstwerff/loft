//
// H6 — a RUNTIME (non-literal) value that collides with the null sentinel of a
// nullable narrow field stores as null and does NOT crash.  The compile-time
// check only catches literals; a computed value routes through
// `set_byte_nullable` / `set_short_nullable`, which add a dev-only `Warn` (logged,
// rate-limited, silent in a shipped game) WITHOUT changing the result.  This
// guards that the store still produces null and the run continues — both backends.
//
// @PLN25 F2: the field must be explicitly NULLABLE (`u8?` / `u16?`) to reserve the
// sentinel — under the range reconciliation a plain non-`Optional` narrow scalar is
// non-null and uses the FULL range, so `255` / `65535` are ordinary values there (a
// plain `u8` field stores + reads `255` fine). This tests the nullable case, which is
// what "nullable narrow field" above means; it passes both gate-OFF and F2-ON.

struct B { x: u8? } struct S { z: u16? }

fn to_u8(v: integer) -> u8 {
  (v&255) as u8
}
fn to_u16(v: integer) -> u16 {
  (v&65535) as u16
}

fn main() {
  b = B { x: to_u8(255) }; // 255 = the all-ones byte sentinel → reads null
  assert(b.x == null, "runtime byte sentinel collision reads back null");
  s = S { z: to_u16(65535) }; // 65535 = the all-ones short sentinel → reads null
  assert(s.z == null, "runtime short sentinel collision reads back null");
  // an in-range computed value still round-trips
  b2 = B { x: to_u8(200) };
  assert(b2.x == 200, "runtime in-range byte round-trips");
}
