// @PLN48 S3 — spatial range slicing (no methods, no new functions): the bounding
// box `xs[(x1,y1)..(x2,y2)]`, the open onward walk `xs[(x,y)..]` with a break, and
// the count-limited `xs[(x,y)..:n]`.  Both backends, Morton order.  2D and 3D — the
// slice ABI carries up to MAX_AXES (3) coordinate axes.
//
// The cells below the 3D ones say WHICH records each form answers, not just how many.
// The count-only cells above them cannot see what the walk actually is: they all start
// at or below the lowest point, where the tail and an outward walk agree, and a `break`
// after 2 is satisfied by any 2 records.  Sweeping the ORIGIN along the curve is what
// separates the two, and it reads 3, 3, 3, 2, 1, 0 for a cap of 3 over five records —
// the open forms are the Morton TAIL, so a record one code behind the query is never
// returned however close it is, and a query past every record answers nothing
// (loft#1002).  A symmetric box is the form that covers every direction.
struct SLMob {
  x: integer,
  y: integer,
}
struct SLMob3 {
  x: integer,
  y: integer,
  z: integer,
}

fn main() {
  xs: spatial<SLMob[x, y]> = [];
  xs += [
    SLMob { x: 5, y: 5 },
  ];
  xs += [
    SLMob { x: 1, y: 1 },
  ];
  xs += [
    SLMob { x: 8, y: 8 },
  ];
  xs += [
    SLMob { x: 50, y: 50 },
  ];
  assert(xs.len() == 4, "len counts every inserted record");

  // bounding box (0,0)..(10,10): (1,1),(5,5),(8,8) — 3, excludes (50,50).
  boxn: integer = 0;
  for m in xs[(0, 0).. (10, 10)] { boxn += 1; }
  assert(boxn == 3, "2D box (0,0)..(10,10) holds 3 of 4");

  // open from (5,5).., break after 2 — approximate outward walk.
  seen: integer = 0;
  for m in xs[(5, 5)..] {
    seen += 1;
    if seen == 2 { break; }
  }
  assert(seen == 2, "open walk breaks after 2");

  // limited from (0,0)..:1 — at most one record.
  lim: integer = 0;
  for m in xs[(0, 0)..: 1] { lim += 1; }
  assert(lim == 1, "limit :1 yields one record");

  // 3D — the same slice forms carry a third axis.
  ps: spatial<SLMob3[x, y, z]> = [];
  ps += [
    SLMob3 { x: 1, y: 1, z: 1 },
  ];
  ps += [
    SLMob3 { x: 2, y: 2, z: 2 },
  ];
  ps += [
    SLMob3 { x: 8, y: 8, z: 8 },
  ];
  assert(ps.len() == 3, "3D len");

  box3: integer = 0;
  for p in ps[(0, 0, 0).. (3, 3, 3)] { box3 += 1; }
  assert(box3 == 2, "3D box (0,0,0)..(3,3,3) holds 2 of 3");

  cap3: integer = 0;
  for p in ps[(0, 0, 0)..: 2] { cap3 += 1; }
  assert(cap3 == 2, "3D limit :2");

  print("box={boxn} walk={seen} lim={lim} box3={box3} cap3={cap3}\n");

  which_records_each_slice_form_answers();
}

// Five points, named, so every assertion below names RECORDS rather than a count.
struct SLNamed {
  const x: integer,
  const y: integer,
  name: text,
}

fn named_scene() -> spatial<SLNamed[x, y]> {
  s: spatial<SLNamed[x, y]> = [];
  s += [SLNamed { x: 0, y: 0, name: "A" }];
  s += [SLNamed { x: 5, y: 5, name: "B" }];
  s += [SLNamed { x: 10, y: 10, name: "C" }];
  s += [SLNamed { x: 12, y: 11, name: "D" }];
  s += [SLNamed { x: 20, y: 20, name: "E" }];
  s
}

fn seq(s: spatial<SLNamed[x, y]>) -> text {
  out = "";
  for m in s { out += "{m.name} "; }
  out
}

// @FTR-028 — which records each spatial slice form answers, and where the open walk stops
fn which_records_each_slice_form_answers() {
  s = named_scene();

  // The collection's own order is the yardstick every open-form cell is read against.
  assert(seq(s) == "A B C D E ", "Morton order = '{seq(s)}', want 'A B C D E '");

  // The OPEN forms answer the SUFFIX of that order beginning at the query, so the same
  // cap answers a different number from each origin.  Written out per origin because the
  // shortfall is the point; a loop over origins would hide which one fell short.
  a = ""; for m in s[(0, 0)..: 3] { a += "{m.name} "; }
  assert(a == "A B C ", "(0,0)..:3 = '{a}', want 'A B C '");

  b = ""; for m in s[(10, 10)..: 3] { b += "{m.name} "; }
  assert(b == "C D E ", "(10,10)..:3 = '{b}', want 'C D E '");

  // From (12,11) the nearest other record is C, at distance ~2.2 and ONE CODE BEHIND.
  // It is not answered; E, at distance ~12, is.  This is the cell the count-only tests
  // above cannot express.
  c = ""; for m in s[(12, 11)..: 3] { c += "{m.name} "; }
  assert(c == "D E ", "(12,11)..:3 = '{c}', want 'D E ' — C is behind the query");

  // At the top of the curve a cap of 3 answers one record, and past every record it
  // answers none.  Both are silent: nothing distinguishes them from an empty
  // neighbourhood.
  d = ""; for m in s[(20, 20)..: 3] { d += "{m.name} "; }
  assert(d == "E ", "(20,20)..:3 = '{d}', want 'E '");

  e = ""; for m in s[(99, 99)..: 3] { e += "{m.name} "; }
  assert(e == "", "(99,99)..:3 = '{e}', want '' — a query past every record");

  // The open form with a `break`, which is the spelling the docs recommend, has the same
  // shape: the loop ends early rather than turning round.
  f = ""; n = 0;
  for m in s[(20, 20)..] { f += "{m.name} "; n += 1; if n == 3 { break; } }
  assert(f == "E ", "(20,20).. with break-at-3 = '{f}', want 'E '");

  // The BOX is exact and symmetric, and is therefore the form that covers every
  // direction (loft#800).  Same query point, same radius as the distance to C.
  g = "";
  for m in s[(12 - 4, 11 - 4)..(12 + 4, 11 + 4)] { g += "{m.name} "; }
  assert(g == "C D ", "symmetric box r=4 around (12,11) = '{g}', want 'C D '");

  // A corner-swapped box names the same box, so the caller need not order the corners.
  h = "";
  for m in s[(12 + 4, 11 + 4)..(12 - 4, 11 - 4)] { h += "{m.name} "; }
  assert(h == g, "corner-swapped box = '{h}', want '{g}'");

  // CONTROL — a box that holds everything, and one that holds nothing.  They are the two
  // shapes that pass whatever the implementation does, which is why they are marked.
  i = ""; for m in s[(-1, -1)..(100, 100)] { i += "{m.name} "; }
  assert(i == "A B C D E ", "all-enclosing box = '{i}'");

  j = ""; for m in s[(30, 30)..(40, 40)] { j += "{m.name} "; }
  assert(j == "", "empty box = '{j}'");
}
