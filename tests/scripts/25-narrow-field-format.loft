//
// Regression: a NON-null 2-byte narrow field (`u16 not null` / `i16 not null`, and — under
// @PLN25 F2 — a plain non-null `u16`) formats and round-trips CORRECTLY via the whole-struct
// path (`{x}` / `to_json` / `show_loft` / the debugger / store reload).
//
// Pre-existing bug (fixed 2026-07-02): the DB schema built the field as `Parts::Short` (the
// `+1` sentinel encoding), but the codegen chose `NarrowIntKind::ShortFull` — writing DIRECT
// via `OpSetShortRaw` and reading field access via `OpGetShortFull`. So field access was
// correct, but every schema-driven READ (the whole-struct formatter et al.) applied the `+1`
// shift the direct write never did → a non-null `u16` field read back OFF-BY-ONE (`7 -> 6`) and
// as `i32::MIN` at the top of range. The fix aligns the schema Part with the codegen: a non-null
// 2-byte field is `Parts::ShortRaw` (direct), matching `ShortFull`. Interp = typedef.rs; native
// = generation/mod.rs emit_field. Both backends.

struct NF {
  h: u16,
  w: i16,
  t: u8,
}

fn main() {
  x = NF { h: 7, w: -5, t: 1 };
  // whole-struct format reads each field via its schema Part (the bug's locus).
  assert("{x}" == "{{h:7,w:-5,t:1}}", "narrow field whole-struct format");
  // field access always worked — assert it agrees with the whole-struct read.
  assert(x.h == 7 && x.w == -5, "narrow field access agrees");

  // Top-of-range boundary values (the code that read back as i32::MIN / max-1 before).
  y = NF { h: 65535, w: 32767, t: 255 };
  assert("{y}" == "{{h:65535,w:32767,t:255}}", "narrow field boundary whole-struct format");
  assert(y.h == 65535 && y.w == 32767, "narrow field boundary access");

  print("25-narrow-field-format ok\n");
}
