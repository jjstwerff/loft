//
// @PLN97 arc G Phase 3b (safe-refusal, ongoing) — a `vector<struct>` field (a
// vector whose ELEMENTS carry their own pointers) still needs per-element
// recursion (3b.4b) and is not handled yet, so `store_load_key` must REFUSE it
// (return false, load nothing), never copy it with a dangling pointer. Inline
// nested structs (3b.4), text (3b.2) and vector<scalar> (3b.3) ARE handled. The
// refused-empty result stays structurally sound. Driven by `store_persist_loft.rs`.

struct Item { a: integer not null, b: text not null }
struct VSRec { id: integer not null, items: vector<Item> }

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH");
  mode = env_variable("LOFT_PERSIST_TEST_MODE");

  v: hash<VSRec[id]> = [];
  if mode == "write" {
    its: vector<Item> = [];
    its += [Item { a: 1, b: "one" }];
    its += [Item { a: 2, b: "two" }];
    v += VSRec { id: 13, items: its };
    if !store_persist_bind(v, path) { println("FAIL write-bind"); return }
    println("write ok");
  } else if mode == "loadkey" {
    ok = store_load_key(v, path, 13);
    println("vs loadkey={ok}");
    println("vs len={len(v)}");
    println("vs verify={store_verify(v)}");
  } else {
    println("FAIL unknown-mode")
  }
}
