//
// A collection build reads what its destination held when the statement began at the two
// destinations the snapshot could not NAME: a field reached through an ELEMENT
// (`xs[0].items`), and a collection a CLOSURE captured (loft#1391).
//
// `formal/iteration.md` `(I-Comp)` — *a build reads what its destination held when the
// statement began, whichever destination* — and `@FR-O-Detach`, which sequences the detach
// after every read of the destination by the value being assigned.  Both were closed for a
// local, a typed local, a parameter, a struct field and `+=`; these two were left because
// `Parser::field_place`, the one home for *is this the same place?*, named only a variable and
// a chain of `OpGetField`.  Everything else about them was already right, so they answered the
// EMPTIED result — `0,0` where `2,1` is the value — on both backends, silently.
//
// What the place had to gain, and what each addition is for:
//
//   * an ELEMENT step.  `xs[0].items` is `OpGetField(OpGetVector(xs, …, 0), …)`, so the place
//     is `(xs, [Elem(0), Field(0)])`.  The index must be one the statement cannot change — a
//     constant, or a VARIABLE, which no expression inside one statement rewrites — and a
//     computed index is not named at all.  Both element spellings normalise to one step: a
//     nullable read of an element is that element, and the parts read it either way.
//   * a CAPTURE step.  A closure reaches its capture through `OpGetDbRef(__closure, <offset>)`
//     (@PLN93's build-into-target), which is neither a variable nor a field — and the place
//     was gated on the caller SAYING it was a field, so this destination had no read test at
//     all.  Any destination that is not a bare variable is named by its place now.
//   * the ORDER.  A build-into-target literal ran its `OpClearVector` ahead of the whole
//     block, so the snapshot — taken at the block's head — copied an already-emptied
//     destination.  The clear goes inside the block after the snapshot, which is where the
//     field spelling has always put it.
//
// The CONTROLS are what keep the place from being over-wide, and each one is a redirection
// that must NOT happen: reading a SIBLING field of the same element (`xs[0].other`), reading
// ANOTHER element (`xs[1].items`), and a nested plain field (`w.inner.items`), which was
// already right and must stay so.
//
// @falsified-at: 00ff5bb5 — interpret exit 1 -> 0 with 7 assertion failures -> 0, native
//   exit 1 -> 0 with 1 -> 0 (native stops at the first failing test; the interpreter runs
//   them all).  The five controls unmoved on both.
//
// Not covered on purpose: a KEYED destination.  `snapshot_read_destination` declines one by
// construction — a keyed literal is built THROUGH its destination (loft#703) and a vector copy
// is not its kind — so it is outside this place question rather than a cell left out of it.

struct O { items: vector<integer>, other: vector<integer>, tag: text }
struct W { inner: O, n: integer }

fn shows(v: vector<integer>) -> text {
  out = "[";
  for i in 0..len(v) { if i > 0 { out += ","; } out += "{v[i] ?? -1}"; }
  out + "]"
}

fn test_a_field_through_an_element() {
  xs = [O{items: [1, 2], other: [], tag: "a"}];
  xs[0].items = [xs[0].items[1] ?? 0, xs[0].items[0] ?? 0];
  assert(shows(xs[0].items) == "[2,1]", "element-field: got {shows(xs[0].items)}");
}

fn test_a_field_through_a_variable_index() {
  xs = [O{items: [1, 2], other: [], tag: "a"}];
  k = 0;
  xs[k].items = [xs[k].items[1] ?? 0, xs[k].items[0] ?? 0];
  assert(shows(xs[0].items) == "[2,1]", "variable index: got {shows(xs[0].items)}");
}

fn test_a_field_through_an_element_appends() {
  xs = [O{items: [1, 2], other: [], tag: "a"}];
  xs[0].items += [len(xs[0].items)];
  assert(shows(xs[0].items) == "[1,2,2]", "element-field +=: got {shows(xs[0].items)}");
}

fn test_a_captured_collection() {
  v = [1, 2];
  f = fn() { v = [v[1] ?? 0, v[0] ?? 0]; };
  f();
  assert(shows(v) == "[2,1]", "captured: got {shows(v)}");
}

fn test_a_captured_append() {
  v = [1, 2];
  f = fn() { v += [len(v), len(v)]; };
  f();
  assert(shows(v) == "[1,2,2,2]", "captured +=: got {shows(v)}");
}

// The snapshot has to survive a surrounding LOOP: `OpDatabase` reuses the slot's current
// store, so on the second pass the buffer store IS the one the destination was left pointing
// at.  Each pass reverses what the pass before it left.
fn test_a_field_through_an_element_in_a_loop() {
  xs = [O{items: [1, 2], other: [], tag: "a"}];
  seen = "";
  for p in 0..3 { xs[0].items = [xs[0].items[1] ?? 0, xs[0].items[0] ?? 0]; seen += shows(xs[0].items); }
  assert(seen == "[2,1][1,2][2,1]", "element-field loop: got {seen}");
}

fn test_a_captured_collection_in_a_loop() {
  v = [1, 2];
  f = fn() { v = [v[1] ?? 0, v[0] ?? 0]; };
  seen = "";
  for p in 0..3 { f(); seen += shows(v); }
  assert(seen == "[2,1][1,2][2,1]", "captured loop: got {seen}");
}

// The COMPREHENSION at both destinations — the shape `(I-Comp)` is named for, which the
// literal is the same build of without the loop.
fn test_a_comprehension_through_an_element() {
  xs = [O{items: [1, 2, 3], other: [], tag: "a"}];
  xs[0].items = [for i in 0..len(xs[0].items) { (xs[0].items[i] ?? 0) * 2 }];
  assert(shows(xs[0].items) == "[2,4,6]", "element-field comprehension: got {shows(xs[0].items)}");
}

fn test_a_comprehension_through_a_capture() {
  v = [1, 2, 3];
  f = fn() { v = [for i in 0..len(v) { (v[i] ?? 0) * 2 }]; };
  f();
  assert(shows(v) == "[2,4,6]", "captured comprehension: got {shows(v)}");
}

fn test_a_field_through_an_element_in_an_if_arm() {
  xs = [O{items: [1, 2], other: [], tag: "a"}];
  c = true;
  if c { xs[0].items = [xs[0].items[1] ?? 0, xs[0].items[0] ?? 0]; }
  assert(shows(xs[0].items) == "[2,1]", "element-field if-arm: got {shows(xs[0].items)}");
}

// CONTROL — a SIBLING field of the same element is a different place and must be read as it
// stands, not redirected onto the snapshot.
fn test_a_sibling_field_of_the_same_element() {
  xs = [O{items: [1, 2], other: [7, 8], tag: "a"}];
  xs[0].items = [xs[0].other[1] ?? 0, xs[0].other[0] ?? 0];
  assert(shows(xs[0].items) == "[8,7]", "sibling field: got {shows(xs[0].items)}");
  assert(shows(xs[0].other) == "[7,8]", "sibling untouched: got {shows(xs[0].other)}");
}

// CONTROL — ANOTHER element's field is a different place too.
fn test_another_elements_field() {
  xs = [O{items: [1, 2], other: [], tag: "a"}, O{items: [5], other: [], tag: "b"}];
  xs[0].items = [xs[1].items[0] ?? 0, 9];
  assert(shows(xs[0].items) == "[5,9]", "other element: got {shows(xs[0].items)}");
  assert(shows(xs[1].items) == "[5]", "other element untouched: got {shows(xs[1].items)}");
}

// CONTROL — a nested plain field was already right (loft#1195) and must stay so.
fn test_a_nested_plain_field() {
  w = W{inner: O{items: [1, 2], other: [], tag: "a"}, n: 0};
  w.inner.items = [w.inner.items[1] ?? 0, w.inner.items[0] ?? 0];
  assert(shows(w.inner.items) == "[2,1]", "nested field: got {shows(w.inner.items)}");
}

// CONTROL — the plain local, closed in August, is the shape all of these are one step from.
fn test_a_plain_local() {
  v = [1, 2];
  v = [v[1] ?? 0, v[0] ?? 0];
  assert(shows(v) == "[2,1]", "plain local: got {shows(v)}");
}
