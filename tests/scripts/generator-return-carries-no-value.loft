// A generator's `return` carries no value, and a generator's body has no tail value.
//
// `formal/coroutines.md` (G-Call) makes ANY function whose return type is `iterator<T>` a
// generator, and in that model values come only from `yield`; (G-Done) says running off the
// end without a further yield leaves the iterator done.  Nothing a returned value could
// mean was ever specified — and both spellings of "return a value from a generator" were
// ACCEPTED and silently discarded:
//
//     fn make() -> iterator<integer> { return counting(1); }   // the keyword spelling
//     fn make() -> iterator<integer> { counting(1) }           // the tail-expression one
//
// Measured on both: `--interpret` answered an EMPTY sequence with no diagnostic (the
// author's delegation vanished), and `--native` panicked inside `alloc_coroutine` with
// "RefCell already borrowed".  The refusals are in `102-expected-errors.loft`; this file
// carries what must WORK, including the capability the refusal would otherwise remove.

fn counting_grcv(k: integer) -> iterator<integer> { yield k; yield k + 1; yield k + 2; }

// `break` ENDS a generator early — the body then runs off its end, which is (G-Done).
// A bare `return;` is refused with the same message as a valued one, and the message names
// `break` because that is the cure that was MEASURED to work on both backends: a `return`
// in a generator loop is rejected by `detect_lazy_for`, so the generator falls back to the
// eager buffer, whose factory cannot emit a mid-body return either.  Naming an untested
// cure in a diagnostic is worse than naming none.
fn upto_grcv(stop: integer) -> iterator<integer> {
  for i in 0..5 {
    if i == stop { break; }
    yield i;
  }
}

// The idiom the refusal names: forwarding another generator's values.
fn forward_grcv() -> iterator<integer> { for v in counting_grcv(1) { yield v; } }

fn test_a_break_ends_a_generator_early() {
  t = 0;
  for x in upto_grcv(2) { t += x; }
  assert(t == 1, "0 and 1 are yielded, then `break` ends it: 0+1 = 1, got {t}");
}

fn test_a_break_that_never_fires_yields_everything() {
  // The control: the same generator with a stop past the end runs to completion, so the
  // early break is doing the work above rather than the loop bound.
  t = 0;
  for x in upto_grcv(99) { t += x; }
  assert(t == 10, "0+1+2+3+4 = 10 when the break never fires, got {t}");
}

fn test_forwarding_another_generator_works() {
  t = 0;
  for x in forward_grcv() { t += x; }
  assert(t == 6, "1+2+3 = 6 forwarded one value at a time, got {t}");
}

fn test_a_generator_is_still_lazy_through_the_forward() {
  // Forwarding must not turn the inner generator eager: taking two values must run the
  // inner one twice, not three times.  Counted through a heap parameter, which a
  // generator can write across a yield (calls.md F-ParamHeap).
  seen = 0; got = 0;
  for x in forward_grcv() { seen += 1; got += x; if seen == 2 { break; } }
  assert(seen == 2, "the consumer stopped after two, got {seen}");
  assert(got == 3, "…and saw 1 and 2, not the third value: 1+2 = 3, got {got}");
}

fn test_consuming_a_generator_inline_and_bound_both_work() {
  // The two shapes that were never broken, pinned so a future refusal cannot widen onto
  // them: a generator consumed inline, and one bound to a local first.
  a = 0;
  for x in counting_grcv(1) { a += x; }
  it = counting_grcv(10);
  b = 0;
  for x in it { b += x; }
  assert(a == 6, "1+2+3 = 6 inline, got {a}");
  assert(b == 33, "10+11+12 = 33 through a bound local, got {b}");
}
