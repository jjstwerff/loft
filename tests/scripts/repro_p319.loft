// @P319 minimal reproducer — a lambda stored in a local that CAPTURES a
// struct (and helper sub-structs) and APPENDS a nested-constructed element
// to the captured struct's `vector<Struct>` field corrupted the interpreter.
//
// Root cause: the void-return closure write-back (parser/control.rs) reloaded
// EVERY capture after the call via `outer = OpGetDbRef(closure, off)`, even for
// shared-reference captures (the auto-Reference 12-byte DbRef encoding).  That
// reassignment freed the OLD store before writing the SAME DbRef back over
// itself — a premature free of a store the closure record still referenced.
// The next invocation reused the freed store, clobbering the captured struct:
// silent data loss when the trampled field sits at offset 0 (a `len` reads
// back 0 — `p319_offset0` below), or a SIGSEGV in `new_record` when it sits at
// a non-zero offset (`p319_offset_nonzero`).  Native compiled the same IR
// without the free, so only the interpreter corrupted.
//
// CLOSED 2026-05-23: the write-back now skips shared-reference captures
// (non-empty-dep `Reference` closure attributes), generalising the prior
// boxed-`__cell_*`-only skip.  Mutations already propagate through the shared
// store, so the reload was redundant as well as harmful.
//
// Isolated lib reproducer: lib/moros_render/tests/adversarial.loft
// (test_adv_lambda_mutates_mesh).

struct P319V3 { x: float, y: float, z: float }
struct P319V2 { x: float, y: float }
struct P319Vtx {
  pos: P319V3,
  normal: P319V3,
  uv: P319V2,
}

fn p319_v3(a: float, b: float, c: float) -> P319V3 {
  P319V3 { x: a, y: b, z: c }
}
fn p319_v2(a: float, b: float) -> P319V2 {
  P319V2 { x: a, y: b }
}
fn p319_vtx(p: P319V3, n: P319V3, u: P319V2) -> P319Vtx {
  P319Vtx { pos: p, normal: n, uv: u }
}

// Offset-0 variant: the captured struct's vector field is at byte offset 0.
// Pre-fix symptom: `len` read back as 0 after the second append (data loss).
struct P319MeshA {
  verts: vector<P319Vtx>,
}

fn p319_offset0() {
  m_a = P319MeshA { verts: [] };
  up_a = p319_v3(0.0, 1.0, 0.0);
  uv_a = p319_v2(0.5, 0.5);
  emit_a = fn(px: float, py: float, pz: float) {
    m_a.verts += [p319_vtx(p319_v3(px, py, pz), up_a, uv_a)];
  };
  emit_a(0.0, 0.0, 0.0);
  emit_a(1.0, 2.0, 3.0);
  assert(len(m_a.verts) == 2, "p319 offset0: len={len(m_a.verts)} (want 2)");
  // The nested sub-record fields must survive the deep copy intact.
  v1_a = m_a.verts[1];
  assert(v1_a.pos.x == 1.0, "p319 offset0: v1.pos.x={v1_a.pos.x} (want 1.0)");
  assert(v1_a.pos.z == 3.0, "p319 offset0: v1.pos.z={v1_a.pos.z} (want 3.0)");
  assert(v1_a.uv.x == 0.5, "p319 offset0: v1.uv.x={v1_a.uv.x} (want 0.5)");
}

// Non-zero-offset variant: a scalar field precedes the vector, so the vector
// header sits at a non-zero offset.  Pre-fix symptom: SIGSEGV in new_record.
struct P319MeshB {
  tag: integer,
  verts: vector<P319Vtx>,
}

fn p319_offset_nonzero() {
  m_b = P319MeshB { tag: 7, verts: [] };
  up_b = p319_v3(1.0, 0.0, 0.0);
  uv_b = p319_v2(0.25, 0.75);
  emit_b = fn(px: float, py: float, pz: float) {
    m_b.verts += [p319_vtx(p319_v3(px, py, pz), up_b, uv_b)];
  };
  emit_b(10.0, 11.0, 12.0);
  emit_b(20.0, 21.0, 22.0);
  emit_b(30.0, 31.0, 32.0);
  assert(len(m_b.verts) == 3, "p319 nonzero: len={len(m_b.verts)} (want 3)");
  assert(m_b.tag == 7, "p319 nonzero: tag={m_b.tag} (want 7)");
  v2_b = m_b.verts[2];
  assert(v2_b.pos.y == 31.0, "p319 nonzero: v2.pos.y={v2_b.pos.y} (want 31.0)");
  assert(v2_b.normal.x == 1.0, "p319 nonzero: v2.normal.x={v2_b.normal.x} (want 1.0)");
}
