//
// Removing one entry of a linked collection group removes it from every member,
// and frees its record exactly once.
//
// Two or more collections over one element type in one struct are auto-linked into
// several routes to a SINGLE record set (loft#843). loft#898 gave the CLEAR an owner
// for those shared records; removal never got one, and was wrong in both directions.
// Spelled through a VIEW it freed the record the primary still held — the vector kept
// the entry and its key, and the text read back null. Spelled through the PRIMARY it
// never reached the views, which went on reporting their old length over a record
// that was gone. Identical on both backends and on the published 2026.8.0.
//
// **A removal spelled through any member removes it from the group.** Like loft#898's
// clear, that is not a choice made here: `h.view += [e]` has appended to every member
// since loft#843, so an operation spelled through a view acts on the group. Dropping
// one index entry and leaving the record in the primary has no coherent successor
// state — `h.by_k[1] = null` then `h.by_k[1] = E{k:1,…}` would remove one entry and
// then add to the whole group, leaving the primary holding two records under one key
// with nothing able to repair it. Row d1 pins the `+=` fact that rests on.
//
// The ORDER is what makes it safe. Every unlink reads the record's key out of the
// record, so the free must come last and the record must stay reachable until then:
// the lookup runs ONCE into a temporary, every other member unlinks from it, and the
// member the removal was spelled through goes last and frees. The temporary is also
// what keeps the key expression evaluated once (@PLN102 F2) — repeating the lookup
// per member would re-run it.
//
// Two supporting facts had to be repaired for this to land, both pinned below:
// `Stores::remove`'s `Array` arm computed its slot by BY-VALUE arithmetic, so every
// unlink of a `vector` primary went to slot 0 (row a1); and `remove_owned` sent a
// grouped hash to `hash::free_entry`, which correctly declines to free a record the
// table only borrows — so spelling the removal through the hash leaked it (row a3).
//
// The controls carry the scope: b1/b2/b3 pin that an UNGROUPED keyed collection still
// removes and frees exactly as before, which a fix that made every removal
// unlink-only would break silently rather than loudly.
//
// Two shapes are deliberately NOT here, both PRE-EXISTING and filed rather than fixed,
// so this file's green is not read as covering them. A group with two `index` members
// panics on the first removal — the two share one set of red-black links, which live in
// fields of the element record (loft#902). And `e#remove` in a loop maintains no sibling,
// because `OpRemove` computes the element's record ref internally and the parser has
// nothing to hand the unlinks; over an `array<T>` it also removes two elements, with no
// group involved at all (loft#903).

struct E1 { k: integer, n: text }
struct E2 { k: integer, n: text }
struct E3 { k: integer, n: text }
struct E4 { k: integer, n: text }
struct E5 { k: integer, n: text }
struct E6 { k: integer, n: text }
struct E7 { k: integer, n: text }
struct E8 { k: integer, n: text }
struct E9 { k: integer, n: text }

struct VH { v: vector<E1>, by_k: hash<E1[k]> }
struct HS { keyed: hash<E2[k]>, ord: sorted<E2[k]>, tag: integer }
struct SI { ord: sorted<E3[k]>, idx: index<E3[k]> }
struct Trio { v: vector<E4>, by_k: hash<E4[k]>, idx: index<E4[k]> }
struct Inner { pad: integer, v: vector<E5>, by_k: hash<E5[k]> }
struct Outer { tag: text, inner: Inner }
struct VH2 { v: vector<E6>, by_k: hash<E6[k]> }
struct LoneH { h: hash<E7[k]>, tag: integer }
struct LoneI { i: index<E8[k]>, tag: integer }
struct LoneS { s: sorted<E9[k]>, tag: integer }

fn main() {
  // ---- a1: remove through the VIEW, `vector` primary ---------------------------
  // The pairing DATABASE.md documents by name, and the direction loft#900 filed:
  // the record was freed while the vector still held it, so `alpha` read back null.
  a1 = VH { v: [], by_k: [] };
  a1.v += [E1{k:1,n:"alpha"}];
  a1.v += [E1{k:2,n:"beta"}];
  a1.by_k[1] = null;
  assert(len(a1.v) == 1, "a1 vector len = {len(a1.v)}, want 1");
  assert(len(a1.by_k) == 1, "a1 hash len = {len(a1.by_k)}, want 1");
  s1 = ""; for e1 in a1.v { s1 += "{e1.k}:{e1.n} "; }
  assert(s1 == "2:beta ", "a1 vector holds [{s1}], want [2:beta ]");
  assert((a1.by_k[2] ?? E1{k:0,n:""}).n == "beta", "a1: key 2 lost from the hash");
  assert((a1.by_k[1] ?? E1{k:0,n:"MISS"}).n == "MISS", "a1: key 1 still in the hash");

  // ---- a2: remove through the PRIMARY — the view must not keep a freed record ---
  a2 = HS { keyed: [], ord: [], tag: 7 };
  a2.keyed = [E2{k:1,n:"alpha"}, E2{k:2,n:"beta"}];
  a2.keyed[1] = null;
  assert(len(a2.keyed) == 1, "a2 primary len = {len(a2.keyed)}, want 1");
  assert(len(a2.ord) == 1, "a2 view len = {len(a2.ord)}, want 1");
  s2 = ""; for e2 in a2.ord { s2 += "{e2.k}:{e2.n} "; }
  assert(s2 == "2:beta ", "a2 view holds [{s2}], want [2:beta ]");
  assert(a2.tag == 7, "a2 tag = {a2.tag}, want 7 — the struct around the group moved");

  // ---- a3: a grouped HASH spelled as the member that frees ----------------------
  // Its entries are one record each rather than arena slots (loft#901), so the free
  // has to go through `Store::delete`; `hash::free_entry` declines to free a record
  // the table only borrows, and taking that path leaked the record silently.
  a3 = SI { ord: [], idx: [] };
  a3.ord = [E3{k:1,n:"alpha"}, E3{k:2,n:"beta"}];
  a3.idx[2] = null;
  assert(len(a3.ord) == 1, "a3 ordered len = {len(a3.ord)}, want 1");
  assert(len(a3.idx) == 1, "a3 index len = {len(a3.idx)}, want 1");
  s3 = ""; for e3 in a3.ord { s3 += "{e3.k}:{e3.n} "; }
  assert(s3 == "1:alpha ", "a3 ordered holds [{s3}], want [1:alpha ]");

  // ---- a4: three members, one removal ------------------------------------------
  a4 = Trio { v: [], by_k: [], idx: [] };
  a4.v = [E4{k:1,n:"alpha"}, E4{k:2,n:"beta"}, E4{k:3,n:"gamma"}];
  a4.by_k[2] = null;
  assert(len(a4.v) == 2, "a4 vector len = {len(a4.v)}, want 2");
  assert(len(a4.by_k) == 2, "a4 hash len = {len(a4.by_k)}, want 2");
  assert(len(a4.idx) == 2, "a4 index len = {len(a4.idx)}, want 2");
  s4 = ""; for e4 in a4.idx { s4 += "{e4.k}:{e4.n} "; }
  assert(s4 == "1:alpha 3:gamma ", "a4 index holds [{s4}], want [1:alpha 3:gamma ]");

  // ---- a5: a group one level down ----------------------------------------------
  // The field site is resolved by walking the `OpGetField` chain, not by reading the
  // base variable's type — stopping at the bare `x.field` shape is what left
  // loft#898's nested case on the unsafe path.
  a5 = Outer { tag: "o", inner: Inner { pad: 3, v: [], by_k: [] } };
  a5.inner.v = [E5{k:1,n:"alpha"}, E5{k:2,n:"beta"}];
  a5.inner.by_k[1] = null;
  assert(len(a5.inner.v) == 1, "a5 nested vector len = {len(a5.inner.v)}, want 1");
  assert(len(a5.inner.by_k) == 1, "a5 nested hash len = {len(a5.inner.by_k)}, want 1");
  s5 = ""; for e5 in a5.inner.v { s5 += "{e5.k}:{e5.n} "; }
  assert(s5 == "2:beta ", "a5 nested vector holds [{s5}], want [2:beta ]");
  assert(a5.inner.pad == 3, "a5 pad = {a5.inner.pad}, want 3");

  // ---- c1: an ABSENT key is a no-op on every member ----------------------------
  c1 = VH2 { v: [], by_k: [] };
  c1.v = [E6{k:1,n:"alpha"}, E6{k:2,n:"beta"}];
  c1.by_k[7] = null;
  assert(len(c1.v) == 2, "c1 vector len = {len(c1.v)}, want 2 — an absent key removes nothing");
  assert(len(c1.by_k) == 2, "c1 hash len = {len(c1.by_k)}, want 2");
  sc = ""; for e6 in c1.v { sc += "{e6.k}:{e6.n} "; }
  assert(sc == "1:alpha 2:beta ", "c1 vector holds [{sc}], want it untouched");

  // ---- d1: remove every entry, then refill --------------------------------------
  // The fact the whole model rests on: an append through ANY member reaches the
  // group, so a removal through any member must too.
  c1.by_k[1] = null;
  c1.by_k[2] = null;
  assert(len(c1.v) == 0, "d1 vector len = {len(c1.v)}, want 0");
  assert(len(c1.by_k) == 0, "d1 hash len = {len(c1.by_k)}, want 0");
  c1.v += [E6{k:9,n:"zeta"}];
  assert(len(c1.v) == 1, "d1 refilled vector len = {len(c1.v)}, want 1");
  assert(len(c1.by_k) == 1, "d1 refilled hash len = {len(c1.by_k)}, want 1 — `+=` fills the group");
  assert((c1.by_k[9] ?? E6{k:0,n:""}).n == "zeta", "d1: the refilled record is not reachable by key");

  // ---- b1/b2/b3: an UNGROUPED keyed collection still removes AND frees ----------
  b1 = LoneH { h: [], tag: 1 };
  b1.h = [E7{k:1,n:"alpha"}, E7{k:2,n:"beta"}];
  b1.h[1] = null;
  assert(len(b1.h) == 1, "b1 lone hash len = {len(b1.h)}, want 1");
  assert((b1.h[2] ?? E7{k:0,n:""}).n == "beta", "b1: the survivor is gone");

  b2 = LoneI { i: [], tag: 2 };
  b2.i = [E8{k:1,n:"alpha"}, E8{k:2,n:"beta"}];
  b2.i[2] = null;
  assert(len(b2.i) == 1, "b2 lone index len = {len(b2.i)}, want 1");
  s6 = ""; for e8 in b2.i { s6 += "{e8.k}:{e8.n} "; }
  assert(s6 == "1:alpha ", "b2 lone index holds [{s6}], want [1:alpha ]");

  b3 = LoneS { s: [], tag: 3 };
  b3.s = [E9{k:1,n:"alpha"}, E9{k:2,n:"beta"}];
  b3.s[1] = null;
  assert(len(b3.s) == 1, "b3 lone sorted len = {len(b3.s)}, want 1");
  // Emptying a `sorted` BY REMOVAL and appending again: the collection keeps its
  // allocation, so the constructor's scratch slot and the slot `sorted_finish`
  // publishes have to agree at length 0. They did not, and the append read back the
  // last element removed with its text already freed.
  b3.s[2] = null;
  assert(len(b3.s) == 0, "b3 drained len = {len(b3.s)}, want 0");
  b3.s += [E9{k:5,n:"eps"}];
  s7 = ""; for e9 in b3.s { s7 += "{e9.k}:{e9.n} "; }
  assert(s7 == "5:eps ", "b3 refilled sorted holds [{s7}], want [5:eps ]");

  println("900 ok");
}
