//
// A lookup whose tuple has the wrong number of elements names the arity.
//
// It is worth its own message because the failure is a plain miscount, and the two spellings
// are hard to compare by eye in a call that has other arguments. The generic "Invalid index
// key" left the reader to do that comparison.
//
// Its own file: the error fires in pass 2, and an earlier error in a shared file would abort
// the pass before this line is reached.

struct Cell { pos: (integer, integer), name: text }

// @EXPECT_ERROR: this collection keys on (integer, integer) — a 2-element tuple, but 3 were given
fn too_many_key_elements() {
  h: hash<Cell[pos]> = [Cell { pos: (1, 2), name: "a" }];
  println("{h[(1, 2, 3)].name}");
}
