//
// Regression for issue #493 cell 3 — a NON-CAPTURING fn-ref stored as a
// TUPLE ELEMENT of a struct field, then READ BACK and CALLED.
//
// `exit_codes::p196_native_codegen_projects_fn_ref_d_nr` (tests/exit_codes.rs)
// covers the NATIVE codegen shape for this bug via `--introspect --show-rust`,
// but only STORES the value (it never reads it back), so it never exercised
// the interpreter's runtime behaviour.
//
// Pre-fix (INTERPRETER only — native already emitted the correct
// `i64::from((var.0).0)` projection): storing the tuple `(fn-ref, integer)`
// into `Pair.v` lowered the fn-ref element with `OpVarFnRef`, which pushes
// the full 20-byte fn-ref slot ([8B d_nr][12B closure DbRef]) into the
// 4-byte `OpSetInt4` d_nr write. That both wrote a GARBAGE d_nr (calling it
// back later produced a wrong result — silent corruption, not a crash) and
// overran into the tuple's FOLLOWING `integer` field, clobbering it too,
// plus left the struct's store unfreed at program exit (a leak). Fixed by
// projecting only the 8-byte d_nr via `OpVarInt` at the element's offset
// (`state/codegen.rs::generate_call`), mirroring native's
// `generation/calls.rs` special case.
//
// Verified pre-fix (commit a2562073, one commit before the fix): this exact
// repro's `result` read back as garbage (e.g. 7524) instead of 8, and a
// "1 stores not freed at program exit: kt=64 Pair×1" leak was printed.
// Keep this a NON-CAPTURING fn-ref — a capturing closure squeezed into a
// 4-byte field is inherently lossy and out of scope for this guard.

struct Pair {
  v: (fn(integer) -> integer, integer),
}

fn p_dbl(x: integer) -> integer {
  x + x
}
fn p_trp(x: integer) -> integer {
  x * 3
}
fn build(f: fn(integer) -> integer, n: integer) -> (fn(integer) -> integer, integer) {
  (f, n)
}

fn main() {
  // store: build a (fn-ref, integer) tuple, then store it into a struct field.
  pp = build(p_dbl, 21);
  p = Pair { v: pp };

  // read back both tuple elements.
  got_fn = p.v.0;
  got_n = p.v.1;

  // call the fn-ref read back from the struct — must be the ORIGINAL
  // function, not a garbage d_nr.
  result = got_fn(4);
  assert(result == 8, "fn-ref read back from struct tuple field: expected 8, got {result}");

  // the FOLLOWING integer field must be intact (bug's second symptom:
  // the fn-ref element write overran into the neighbouring tuple field).
  assert(got_n == 21, "following integer field corrupted: expected 21, got {got_n}");

  // second instance with a DIFFERENT function + value, to rule out a
  // coincidental match on the first Pair's layout.
  qq = build(p_trp, 99);
  q = Pair { v: qq };
  qres = q.v.0(4);
  assert(qres == 12, "second Pair: fn-ref call expected 12, got {qres}");
  assert(q.v.1 == 99, "second Pair: following integer expected 99, got {q.v.1}");

  print("issue-493 cell-3 struct-tuple fn-ref d_nr: ok\n");
}
