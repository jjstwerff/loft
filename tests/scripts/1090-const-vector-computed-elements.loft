//
// A file-scope const vector holds elements that are COMPUTED, and fields that are not
// integers, floats or text (loft#1090).
//
// The constant store pre-builds each element from the literal field writes its
// initialiser emits, and the use site references that store (`OpConstRef`) instead of
// re-running the initialiser. So a constant the builder cannot pre-build has no second
// way to exist: it read back `null` at every reference, with no error and no warning.
// Two shapes reached that state, and they fail differently:
//
//   * a value that is not a literal in the IR — `BASE + 1` is `OpAddInt` under a source
//     span per operand, `"a" + "b"` is a block that builds its value in a work buffer.
//     The whole constant came back empty: `len()` answered 0 and a `for` over it ran
//     zero times, so assertions inside held vacuously.
//   * a field the per-element writer had no arm for — `boolean` and `character`. Here
//     the element was built ANYWAY, from the fields the writer did know, so a row of a
//     table read back with the right `id` and a silently wrong `flag`. That is the worse
//     half: nothing about the length or the neighbouring fields says a field is missing.
//
// So these cells assert VALUES, field by field. A length cannot witness an element and a
// present element cannot witness its own fields.

const CE_BASE = 40;

const CE_LITERALS: vector<integer> = [11, 12, 13];
const CE_ADDS_TO_A_CONST: vector<integer> = [CE_BASE + 1, 22, CE_BASE * 2];
const CE_ADDS_LITERALS: vector<integer> = [21 + 1, 3 * 7];
const CE_NESTED_ARITHMETIC: vector<integer> = [(CE_BASE + 1) * 2, CE_BASE - 3 + 7];
const CE_JOINED_TEXT: vector<text> = ["a" + "c", "b"];
const CE_BOOLEANS: vector<boolean> = [true, false, true];
const CE_CHARACTERS: vector<character> = ['a', 'z'];

struct CeRow { ce_flag: boolean, ce_id: integer, ce_ch: character, ce_name: text }

const CE_ROWS: vector<CeRow> = [
  CeRow { ce_flag: true, ce_id: CE_BASE + 1, ce_ch: 'z', ce_name: "base+1" },
  CeRow { ce_flag: false, ce_id: CE_BASE + 2, ce_ch: 'q', ce_name: "base+2" },
];

fn main() {
  // c1 (control) — all-literal integers, the shape that always worked. Red here means
  //     the fix broke the path it was meant to leave alone.
  assert(len(CE_LITERALS) == 3, "c1 len = {len(CE_LITERALS)}, want 3");
  assert((CE_LITERALS[0] ?? -99) == 11, "c1[0] = {CE_LITERALS[0] ?? -99}, want 11");
  assert((CE_LITERALS[2] ?? -99) == 13, "c1[2] = {CE_LITERALS[2] ?? -99}, want 13");

  // c2 — the filed shape: arithmetic on a named constant. Every element checked, because
  //     the defect dropped all of them and a partial fix could drop only the computed one.
  assert(len(CE_ADDS_TO_A_CONST) == 3, "c2 len = {len(CE_ADDS_TO_A_CONST)}, want 3");
  assert((CE_ADDS_TO_A_CONST[0] ?? -99) == 41, "c2[0] = {CE_ADDS_TO_A_CONST[0] ?? -99}, want 41");
  assert((CE_ADDS_TO_A_CONST[1] ?? -99) == 22, "c2[1] = {CE_ADDS_TO_A_CONST[1] ?? -99}, want 22");
  assert((CE_ADDS_TO_A_CONST[2] ?? -99) == 80, "c2[2] = {CE_ADDS_TO_A_CONST[2] ?? -99}, want 80");

  // c3 — arithmetic on LITERALS ALONE. The named constant is not the axis: `21 + 1` is
  //     just as much a call in the IR as `CE_BASE + 1` is.
  assert(len(CE_ADDS_LITERALS) == 2, "c3 len = {len(CE_ADDS_LITERALS)}, want 2");
  assert((CE_ADDS_LITERALS[0] ?? -99) == 22, "c3[0] = {CE_ADDS_LITERALS[0] ?? -99}, want 22");
  assert((CE_ADDS_LITERALS[1] ?? -99) == 21, "c3[1] = {CE_ADDS_LITERALS[1] ?? -99}, want 21");

  // c4 — NESTED arithmetic, so the fold has to walk past a source span around each inner
  //     operand rather than only the outermost one.
  assert(len(CE_NESTED_ARITHMETIC) == 2, "c4 len = {len(CE_NESTED_ARITHMETIC)}, want 2");
  assert((CE_NESTED_ARITHMETIC[0] ?? -99) == 82,
         "c4[0] = {CE_NESTED_ARITHMETIC[0] ?? -99}, want 82");
  assert((CE_NESTED_ARITHMETIC[1] ?? -99) == 44,
         "c4[1] = {CE_NESTED_ARITHMETIC[1] ?? -99}, want 44");

  // c5 — a JOINED text element. Text is assembled in a work buffer, not written as a
  //     literal, so it needs a different fold from the arithmetic above.
  assert(len(CE_JOINED_TEXT) == 2, "c5 len = {len(CE_JOINED_TEXT)}, want 2");
  assert((CE_JOINED_TEXT[0] ?? "") == "ac", "c5[0] = {CE_JOINED_TEXT[0] ?? \"\"}, want ac");
  assert((CE_JOINED_TEXT[1] ?? "") == "b", "c5[1] = {CE_JOINED_TEXT[1] ?? \"\"}, want b");

  // c6 — BOOLEAN elements, all literal. No arithmetic anywhere: the writer simply had no
  //     arm for the field kind, and the whole constant came back null.
  assert(len(CE_BOOLEANS) == 3, "c6 len = {len(CE_BOOLEANS)}, want 3");
  assert((CE_BOOLEANS[0] ?? false) == true, "c6[0] = {CE_BOOLEANS[0] ?? false}, want true");
  assert((CE_BOOLEANS[1] ?? true) == false, "c6[1] = {CE_BOOLEANS[1] ?? true}, want false");
  assert((CE_BOOLEANS[2] ?? false) == true, "c6[2] = {CE_BOOLEANS[2] ?? false}, want true");

  // c7 — CHARACTER elements. A character literal is spelled as a conversion of its code
  //     point, so it is not a literal in the IR either.
  assert(len(CE_CHARACTERS) == 2, "c7 len = {len(CE_CHARACTERS)}, want 2");
  assert((CE_CHARACTERS[0] ?? ' ') == 'a', "c7[0] = {CE_CHARACTERS[0] ?? ' '}, want a");
  assert((CE_CHARACTERS[1] ?? ' ') == 'z', "c7[1] = {CE_CHARACTERS[1] ?? ' '}, want z");

  // c8 — the composed shape moros hit: a table of struct rows whose id is computed and
  //     which also carries a boolean and a character. This is the cell where the element
  //     was BUILT and a field silently was not — `ce_id` and `ce_name` were right while
  //     `ce_flag` read false and `ce_ch` read empty — so every field is asserted.
  assert(len(CE_ROWS) == 2, "c8 len = {len(CE_ROWS)}, want 2");
  ce_r0 = CE_ROWS[0] ?? CeRow { ce_flag: false, ce_id: -99, ce_ch: ' ', ce_name: "?" };
  assert(ce_r0.ce_flag == true, "c8[0].flag = {ce_r0.ce_flag}, want true");
  assert(ce_r0.ce_id == 41, "c8[0].id = {ce_r0.ce_id}, want 41");
  assert(ce_r0.ce_ch == 'z', "c8[0].ch = {ce_r0.ce_ch}, want z");
  assert(ce_r0.ce_name == "base+1", "c8[0].name = {ce_r0.ce_name}, want base+1");
  ce_r1 = CE_ROWS[1] ?? CeRow { ce_flag: true, ce_id: -99, ce_ch: ' ', ce_name: "?" };
  assert(ce_r1.ce_flag == false, "c8[1].flag = {ce_r1.ce_flag}, want false");
  assert(ce_r1.ce_id == 42, "c8[1].id = {ce_r1.ce_id}, want 42");
  assert(ce_r1.ce_ch == 'q', "c8[1].ch = {ce_r1.ce_ch}, want q");
  assert(ce_r1.ce_name == "base+2", "c8[1].name = {ce_r1.ce_name}, want base+2");

  // c9 — the SILENT half, made loud. Iteration is where the defect did its damage: an
  //     empty vector runs the body zero times and every assertion inside holds. Counting
  //     the turns from OUTSIDE the loop is what a vacuous pass cannot fake.
  ce_seen = 0;
  ce_sum = 0;
  for ce_row in CE_ROWS {
    ce_seen += 1;
    ce_sum += ce_row.ce_id;
  }
  assert(ce_seen == 2, "c9 iterated {ce_seen} times, want 2");
  assert(ce_sum == 83, "c9 sum = {ce_sum}, want 83");

  // c10 (oracle) — a LOCAL built from the same expressions, which was correct throughout.
  //     The constant must answer exactly what it does.
  ce_local = [CE_BASE + 1, 22, CE_BASE * 2];
  assert(len(ce_local) == 3, "c10 len = {len(ce_local)}, want 3");
  assert((ce_local[0] ?? -99) == (CE_ADDS_TO_A_CONST[0] ?? -98),
         "c10 local {ce_local[0] ?? -99} vs const {CE_ADDS_TO_A_CONST[0] ?? -98}");
  assert((ce_local[2] ?? -99) == (CE_ADDS_TO_A_CONST[2] ?? -98),
         "c10 local {ce_local[2] ?? -99} vs const {CE_ADDS_TO_A_CONST[2] ?? -98}");

  println("1090 ok");
}
