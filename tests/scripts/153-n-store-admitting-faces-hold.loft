//
// @PLN153 phase 3 — the HOLD half of @FR-N-Store's one-home fold: every read of a `τ?` below
// TESTS or DISCHARGES it — a comparison, a null test, a condition, `??`, `?`, `match`, a
// null-transparent callee, `&&`/`||`, an overload trial, interpolation, an `if` arm joining
// its sibling — and none is a store, so the rule says nothing.  These are the ADMITTING faces
// of `convert`'s `τ? ⤳ τ` arm (`convert_admitting`); a face missed there would warn here.
// Silence is the assertion, so the program also pins every value.
//
// @falsified-at: none — pins silence the compiler already keeps; the control is the
//   diagnostic count (0 on both the pre-fold build and this one).
struct S { n: integer }
fn maybe(k: integer) -> integer? { if k > 5 { 7 } else { null } }
fn maybe_s(k: integer) -> S? { if k > 5 { S { n: 1 } } else { null } }
fn takes(x: integer) -> integer { x }
fn main() {
  x = maybe(3);
  y = maybe(9);
  s = maybe_s(9);
  f: float? = if x == null { null } else { 1.5 };
  a = x == 5;                 // comparison with a literal
  b = x != null;              // null test
  c = if x { 1 } else { 2 };  // condition
  d = x ?? 0;                 // discharge
  e = match x { null => -1, v => v };
  g = abs(y);                 // null-transparent callee
  h = (x != null) && (y != null);
  i = (x == null) || (y == null);
  j = min(y, 3);              // overload trial on a nullable
  k = s != null;
  l = if f != null { f } else { 0.0 };
  m = takes(y ?? 0);
  n = "{x} {y}";
  o = f == null;
  p = if s != null { s.n } else { -1 };
  q = x?;                     // the type's default
  assert(!a && !b && c == 2 && d == 0 && e == -1, "the x cells {a} {b} {c} {d} {e}");
  assert(g == 7 && !h && i && j == 3 && k, "the y and s cells {g} {h} {i} {j} {k}");
  assert(l == 0.0 && m == 7 && n == "null 7" && o && p == 1 && q == 0, "the rest {l} {m} {n} {o} {p} {q}");
  println("admitting faces hold");
}
