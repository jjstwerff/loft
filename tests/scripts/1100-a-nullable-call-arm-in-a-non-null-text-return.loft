//
// A nullable value stored into a non-null `text` return WARNS, compiles and runs on both
// backends, and the return holds null (loft#1100).
//
// That is `@FR-N-Store` verbatim: storing `e:τ?` into a non-null `τ` slot is a warning
// "compiles + runs, the slot holds null" wherever the null is representable-and-distinct in
// τ's non-null form, and `types.md`'s per-type table puts `text` in that class (its null is
// out-of-band on the heap).  The narrow integer widths are the sole error case, because
// their sentinel collides with a real value.  So the question the issue framed as a design
// call — warn-and-coerce or refuse — is not open: only warn-and-run is admissible, and a
// backend that refuses is deviating.
//
//     fn maybe(k: integer) -> text? { if k == 0 { null } else { "z" } }
//     fn f(k: integer) -> text { a = "ab"; match k { -1 => maybe(k), _ => a } }
//
// `--interpret` warned and answered; `--native` would not compile it, so the DEFAULT backend
// refused a program the compiler had already type-checked.  `do_if_acc` promotes a per-arm
// text accumulator, and its nullability term declined to promote here on purpose: the rewrite
// retypes the tail as the accumulator, after which `block_result`'s `(N-Store)` check sees two
// non-null types and says nothing, so declining was what kept the diagnostic.  Without the
// accumulator each arm stays `&*(callee(…))` — a borrow of the `Str` temporary the callee
// returned, dead at the arm's `}` — which is E0716, or E0308 once the arms' Rust
// representations also disagree.
//
// The cure keeps both halves: report the store from the tail's OWN type before the rewrite,
// then promote.  A diagnostic describes the SOURCE program; which lowering the compiler picks
// for it cannot decide whether the program is diagnosed.

fn maybe1100(k: integer) -> text? { if k == 0 { null } else { "z" } }
fn sure1100(k: integer) -> text { if k == 0 { "y" } else { "z" } }

fn m_call(k: integer) -> text { a = "ab"; match k { -1 => maybe1100(k), _ => a } }
fn i_call(k: integer) -> text { a = "ab"; if k == -1 { maybe1100(k) } else { a } }
fn m_three(k: integer) -> text { a = "ab"; match k { -1 => maybe1100(k), 1 => "one", _ => a } }
fn m_reaches_null(k: integer) -> text { a = "ab"; match k { -1 => maybe1100(0), _ => a } }
fn v_arm(k: integer) -> text { a = "ab"; b = maybe1100(k); match k { -1 => b, _ => a } }

// The reported shape.  Its first job is to COMPILE on `--native`: before the fix the run
// never reached an assertion, it failed in rustc with E0716.
fn test_a_nullable_call_arm_runs_in_a_non_null_text_return() {
  assert(m_call(-1) == "z", "the calling arm answers its value, got {m_call(-1)}");
  assert(m_call(9) == "ab", "the other arm is untouched, got {m_call(9)}");
}

// The `if` spelling reached the same refusal by a different rustc error (E0308), because the
// arms' Rust representations disagree as well — a buffered call yields one shape and a local
// another.  Both spellings lower through the same accumulator, so both are pinned.
fn test_the_if_spelling_runs_too() {
  assert(i_call(-1) == "z", "the calling arm answers its value, got {i_call(-1)}");
  assert(i_call(9) == "ab", "the other arm is untouched, got {i_call(9)}");
}

// A third arm is what says the promotion is PER ARM: every arm has to write the accumulator,
// not just the two the smallest repro has.
fn test_a_third_arm_still_delivers() {
  assert(m_three(-1) == "z", "the calling arm, got {m_three(-1)}");
  assert(m_three(1) == "one", "the literal arm, got {m_three(1)}");
  assert(m_three(9) == "ab", "the local arm, got {m_three(9)}");
}

// The half `@FR-N-Store` is most specific about: "the slot holds null".  A warning that
// compiles is only correct if the null actually ARRIVES — coercing it to an empty text would
// satisfy the compiler and lose the value, so this cell asserts the null itself rather than
// merely that the program ran.
fn test_the_null_reaches_the_non_null_return() {
  assert(m_reaches_null(-1) == null, "the null survives the store, got {m_reaches_null(-1)}");
  assert(m_reaches_null(9) == "ab", "the other arm is untouched, got {m_reaches_null(9)}");
}

// The call BOUND to a variable first, then used as the arm.  It always compiled, and it is
// here because it now also warns: the report reads the tail's nullability rather than the
// shape that produced it, so binding the call no longer hides the store.
fn test_a_nullable_variable_arm_delivers() {
  assert(v_arm(-1) == "z", "the bound call's value, got {v_arm(-1)}");
  assert(v_arm(9) == "ab", "the other arm is untouched, got {v_arm(9)}");
}

// ---- controls ----

// A DECLARED-nullable return is a nullable value reaching a nullable destination: legitimate,
// no diagnostic, and it must keep the per-arm accumulator it already had — losing that is
// what loft#741 cost, and it is the reason the gate reads the DECLARED return and not the
// tail.
fn m_nullable_ret(k: integer) -> text? { a = "ab"; match k { -1 => maybe1100(k), _ => a } }

fn test_a_declared_nullable_return_is_untouched() {
  assert(m_nullable_ret(-1) == "z", "the calling arm, got {m_nullable_ret(-1) ?? "N"}");
  assert(m_nullable_ret(9) == "ab", "the local arm, got {m_nullable_ret(9) ?? "N"}");
}

// A NON-NULL call arm: nothing nullable is stored, so no diagnostic and no change.  It is
// what says this is about nullability and not about calls in arms.
fn m_nonnull_call(k: integer) -> text { a = "ab"; match k { -1 => sure1100(k), _ => a } }

fn test_a_non_null_call_arm_is_untouched() {
  assert(m_nonnull_call(-1) == "z", "the calling arm, got {m_nonnull_call(-1)}");
  assert(m_nonnull_call(9) == "ab", "the local arm, got {m_nonnull_call(9)}");
}

// The null LITERAL arm — loft#1099's shape.  It compiled before and still must, and its
// value must not move: this fix changes which cells the report speaks for, never what the
// program answers.
fn m_null_literal(k: integer) -> text { a = "ab"; match k { -1 => null, _ => a } }

fn test_the_null_literal_arm_still_answers_null() {
  assert(m_null_literal(-1) == null, "the null arm, got {m_null_literal(-1)}");
  assert(m_null_literal(9) == "ab", "the local arm, got {m_null_literal(9)}");
}
