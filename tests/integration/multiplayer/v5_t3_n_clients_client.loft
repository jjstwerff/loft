//
// TTT v5 — t3 client.  Connects, sends a hello with its label, then
// counts incoming hellos until it has seen N (one per connected
// client, including its own broadcast echo).
//
// Args: argv[1] = label (string)
// Env:
//   LOFT_TICTACTOE_PORT — server port (default 18093)
//   LOFT_T3_CLIENTS     — expected hello count (default 5)
//
// Stdout shape:
//   v5-t3c[<label>]: connecting
//   v5-t3c[<label>]: welcome seat=<n>
//   v5-t3c[<label>]: ok received=<n>

use web;

H_HELLO = 1;
H_WELCOME = 2;
H_READY = 3;

fn main() {
  args = arguments();
  label = if args.len() > 0 { args[0] } else { "?" };

  port_raw = env_variable("LOFT_TICTACTOE_PORT") ?? "";
  port = if port_raw == "" { 18093 } else { port_raw as integer? ?? 18093 };
  count_raw = env_variable("LOFT_T3_CLIENTS") ?? "";
  expected = if count_raw == "" { 5 } else { count_raw as integer? ?? 5 };
  url = "ws://127.0.0.1:{port}";

  println("v5-t3c[{label}]: connecting");
  h = web::ws_handler(url);
  if h == null {
    println("v5-t3c[{label}]: ws_handler-failed");
    return;
  }

  hellos = 0;
  welcomed = false;
  ready = false;
  hello_sent = false;
  idle = 0;
  while hellos < expected {
    raw = h.try_recv();
    if raw == null {
      idle += 1;
      if idle > 4000 {     // ~20s ceiling at 5ms/poll
        println("v5-t3c[{label}]: timeout hellos={hellos} ready={ready}");
        h.close();
        return;
      }
      web::sleep_ms(5);
      continue;
    }
    idle = 0;

    // Parse "<id>:<payload>" — same framing as v2.
    sep = raw.find(":");
    if sep == null { continue; }
    id_text = raw[..sep];
    msg_id = id_text as integer? ?? -1;
    payload = raw[sep + 1..];

    if msg_id == H_WELCOME && !welcomed {
      println("v5-t3c[{label}]: welcome seat={payload}");
      welcomed = true;
    } else if msg_id == H_READY && !ready {
      println("v5-t3c[{label}]: ready peers={payload}");
      ready = true;
      // Now send our hello — every peer is connected so no
      // broadcast can be missed.
      if !hello_sent {
        ok = h.send("{H_HELLO}:{label}");
        if !ok {
          web::sleep_ms(100);
          ok = h.send("{H_HELLO}:{label}");
        }
        if !ok {
          println("v5-t3c[{label}]: send-failed");
          h.close();
          return;
        }
        hello_sent = true;
      }
    } else if msg_id == H_HELLO {
      hellos += 1;
    }
  }

  println("v5-t3c[{label}]: ok received={hellos}");
  h.close();
}
