//
// Issue #248 fixture — a cross-package struct constructor that returns a
// struct with a runtime-built vector field, plus a `&self` method that takes
// a vector argument and writes a struct field.  Exercised from
// `tests/scripts/188-issue-248-xpkg-ctor-inline-arg.loft` where the method is
// called with an INLINE vector-returning helper call as its argument (the
// frame-growing arg that, before the fix, shifted the `&self` receiver's stack
// slot in the interpreter and landed the field write on CONST_STORE).

pub struct P248State {
  ps_keys: vector<boolean> not null,
  ps_scalar: integer not null
}

pub fn p248_new(seed: integer) -> P248State {
  keys: vector<boolean> = [];
  for _ in 0..4 {
    keys += [false];
  }
  P248State{
    ps_keys: keys,
    ps_scalar: seed
  }
}

// &self method that takes a vector argument and writes both a scalar field and
// vector elements from the argument.
pub fn p248_load(self: &P248State, v: integer, keys: vector<boolean>) {
  self.ps_scalar = v;
  n = len(keys);
  for i in 0..n {
    self.ps_keys[i] = keys[i];
  }
}

pub fn p248_scalar(self: const P248State) -> integer { self.ps_scalar }
pub fn p248_key(self: const P248State, i: integer) -> boolean { self.ps_keys[i] ?? false }
