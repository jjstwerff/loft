// @PLAN54 Arc N / N3 (B3) — a mixed library: `triple` is shared-store-dispatchable
// (compiles native) while `apply_inc` calls through a function reference (a
// lambda), which the gate conservatively excludes from native compilation
// (CallRef), so it stays interpreted.  The gate splits the library silently — no
// user-facing "can't compile this" error; the script calls both alike.

pub fn triple(x: integer) -> integer {
    x * 3
}

pub fn apply_inc(x: integer) -> integer {
    f = fn(a: integer) -> integer { a + 1 };
    f(x)
}
