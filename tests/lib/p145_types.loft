pub struct Hex { mat: integer, height: integer }
pub struct Chunk { cx: integer, cy: integer, cz: integer, hexes: vector<Hex> }
pub struct MatDef { name: text, r: integer }
pub struct WallDef { name: text, body: text }
pub struct ItemDef { name: text, kind: text }
pub struct Spawn { kind: text, count: integer }
pub struct Routine { name: text, npc: integer }
