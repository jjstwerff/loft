// H2 — a FIRST assignment from a call whose return is a runtime `??` JOIN (owned on one
// arm, a borrow of an argument on the other) chose adopt-vs-copy STATICALLY.  No static
// answer is right for both arms: `returns_borrowed_view()` said "borrow", the source-free
// was suppressed, and every execution taking the FRESH arm orphaned the store the callee
// had just minted.  A loop body re-declares its local each iteration, so the binding is a
// first Set every time and the leak scaled with the trip count.
//
// The orphans were also the CORRUPTION: recycled store slots were handed back out and
// written through while a vector element still pointed at them, which is how
// `for i in 0..3 { d = pick(t,i); out += [mk(d)] }` read back `1 null null`.  Fixed by
// binding through @PLN85's `OpBindOrCopy` runtime guard on the first-Set path too
// (`gen_set_first_ref_join`), as the reassignment path already did.
//
// Interpreter-only in its broken form, but this file runs on BOTH backends: native's
// equivalent guard must keep working, and freeing unconditionally instead would be a
// use-after-free of `t` on the borrow arm — which the value asserts below catch and a
// leak-only check would not.
struct M { hp: integer, name: text }
fn m_none() -> M { M{ hp: -1, name: "none" } }
fn seed() -> vector<M> {
  t: vector<M> = [];
  t += [M{hp:1, name:"a"}]; t += [M{hp:2, name:"b"}]; t += [M{hp:3, name:"c"}];
  t
}
// The join: a BORROW of `t` in range, a FRESH store out of range.
fn pick(t: vector<M>, i: integer) -> M { t[i] ?? m_none() }
fn scale(d: M) -> M { M{ hp: d.hp * 10, name: d.name } }
fn total_hp(out: vector<M>) -> integer {
  s = 0;
  for j in 0..len(out) { e = out[j] ?? m_none(); s += e.hp; }
  s
}

fn test() {
  t = seed();

  // FRESH arm every iteration — one orphaned fallback store per iteration before the fix.
  fresh: vector<M> = [];
  for i in 0..3 { e = pick(t, i + 100); fresh += [e]; }
  assert(len(fresh) == 3, "fresh arm: every element delivered");
  assert(total_hp(fresh) == -3, "fresh arm: three fallback records, not recycled memory");

  // BORROW arm every iteration — the half that must NOT free: `t` has to survive intact.
  borrowed: vector<M> = [];
  for i in 0..3 { e = pick(t, i); borrowed += [e]; }
  assert(len(borrowed) == 3, "borrow arm: every element delivered");
  assert(total_hp(borrowed) == 6, "borrow arm: 1+2+3 — the elements are copies, not orphans");

  // BOTH arms in one run — the case a per-execution guard passes and any static verdict
  // fails, whichever way it decides.
  mixed: vector<M> = [];
  for i in 0..3 { e = pick(t, if i == 1 { 100 } else { i }); mixed += [e]; }
  assert(total_hp(mixed) == 3, "mixed: 1 + (-1) + 3");

  // `t` itself is still whole after all three loops — an over-free of the borrow arm
  // shows up here rather than as a leak.
  assert(total_hp(t) == 6, "the lender survived every borrow");

  // H2's reported shape: the join result passed BY VALUE into another call whose result
  // is appended DIRECTLY.  Read back `1 null null` before the fix.  The element MUST come
  // from a CALL — with an inline `M{…}` literal here the corruption does not reproduce
  // and this assert is vacuous (measured, not assumed).
  direct: vector<M> = [];
  for i in 0..3 { d = pick(t, i); direct += [scale(d)]; }
  assert(len(direct) == 3, "direct append: every element delivered");
  assert(total_hp(direct) == 60, "direct append: 10+20+30, no element clobbered");
}
