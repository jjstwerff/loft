//
// @P310 regression fixture (NOT in tests/scripts — must not auto-run under
// loft_suite, which runs interp and would actually write the PNG / lacks a
// GL context).  Driven by `tests/codegen_emitter.rs::p310_graphics_vector_ffi_checks_clean`,
// which `--check`s it (native codegen typecheck, no run): a `vector<integer>`
// argument (`Canvas.data`) to the `vec<i64>` `loft_save_png` wrapper must
// lower to a `*const i64` pointer, not `*const i32` (else E0308).
use graphics;

fn main() {
  cv = graphics::canvas(8, 8, graphics::rgb(0, 0, 0));
  ok = graphics::save_png(cv, "/tmp/p310_guard.png");
  if !ok { println("save failed"); }
}
