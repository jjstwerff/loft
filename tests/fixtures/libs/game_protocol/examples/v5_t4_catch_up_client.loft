//
// TTT v5 — t4 client.  Stateless catch-up across a reconnect.
//
// 1. Connect (WS A); send "1:3" (subscribe to first 3 sessions).
// 2. Receive 3 binary blobs; record their session ids.  Close.
// 3. Reconnect (WS B); send "2:3" (catch_up since session 3).
// 4. Receive remaining sessions (4..=N); record their ids.
// 5. Verify the union is {1, 2, ..., N} contiguously, no holes,
//    no duplicates.  Print "ok last_session=N".
//
// Validates:
//   - The server's stateless catch-up replays the right sessions.
//   - A reconnecting client gets a fresh WS slot but the same
//     answer as if it had stayed connected.
//   - Binary blob session ids decode cleanly across the gap.
//
// Stdout shape:
//   v5-t4c: connecting-A port=<n>
//   v5-t4c: phase-A drained=<n> first_seen=<id> last_seen=<id>
//   v5-t4c: connecting-B port=<n>
//   v5-t4c: phase-B drained=<n> first_seen=<id> last_seen=<id>
//   v5-t4c: ok last_session=<n>

use web;

// LE u32 read at byte offset `off` of `buf` (mirrors t2 client).
fn read_u32_le(buf: text, off: integer) -> integer {
  rb0 = web::byte_at(off, buf);
  rb1 = web::byte_at(off + 1, buf);
  rb2 = web::byte_at(off + 2, buf);
  rb3 = web::byte_at(off + 3, buf);
  if rb0 < 0 || rb1 < 0 || rb2 < 0 || rb3 < 0 { return -1; }
  rb0| (rb1<<8)| (rb2<<16)| (rb3<<24)
}

// Drain expected blobs from a freshly-opened handler, recording
// each session id into `seen`.  Returns the count drained.  Stops
// after `expected` blobs OR after a 1-second idle gap.
fn drain_phase(h: web::WsHandler, seen: vector<integer>, expected: integer, label: text) -> integer {
  drained = 0;
  idle = 0;
  while drained < expected {
    raw = h.try_recv();
    if raw == null {
      idle += 1;
      if idle > 600 {
        // ~3s ceiling at 5ms/poll
        println("v5-t4c: {label}-timeout drained={drained} expected={expected}");
        return drained;
      }
      web::sleep_ms(5);
      continue;
    }
    idle = 0;
    op = h.last_opcode();
    if op != 2 { continue; } // skip text frames
    if raw.size() < 5 { continue; } // malformed blob
    sid = read_u32_le(raw, 1);
    seen += [sid];
    drained += 1;
  }
  drained
}

fn main() {
  port_raw = env_variable("LOFT_TICTACTOE_PORT") ?? "";
  port = if port_raw == "" { 18094 } else { port_raw as integer };
  total_raw = env_variable("LOFT_T4_SESSIONS") ?? "";
  total = if total_raw == "" { 5 } else { total_raw as integer };
  initial = total / 2; // half on phase A, half on phase B
  if initial < 1 { initial = 1; }
  url = "ws://127.0.0.1:{port}";

  seen: vector<integer> = [];

  // Phase A: connect, subscribe to first `initial` sessions.
  println("v5-t4c: connecting-A port={port}");
  h_a = web::ws_handler(url);
  if h_a == null {
    println("v5-t4c: ws_handler-A-failed"); return;
  }
  ok_a = h_a.send("1:{initial}");
  if!ok_a {
    web::sleep_ms(100);
    ok_a = h_a.send("1:{initial}");
  }
  if!ok_a {
    println("v5-t4c: subscribe-failed"); h_a.close(); return;
  }
  drained_a = drain_phase(h_a, seen, initial, "phase-A");
  if drained_a > 0 {
    println(
      "v5-t4c: phase-A drained={drained_a} first_seen={seen[0]} last_seen={seen[drained_a - 1]}"
    );
  } else { println("v5-t4c: phase-A drained=0"); }
  h_a.close();
  // Brief settle so the server's slot disconnect propagates before
  // the next ws_handler reuses the table.
  web::sleep_ms(50);

  // Phase B: reconnect, ask for catch_up since `initial`.
  println("v5-t4c: connecting-B port={port}");
  h_b = web::ws_handler(url);
  if h_b == null {
    println("v5-t4c: ws_handler-B-failed"); return;
  }
  ok_b = h_b.send("2:{initial}");
  if!ok_b {
    web::sleep_ms(100);
    ok_b = h_b.send("2:{initial}");
  }
  if!ok_b {
    println("v5-t4c: catch_up-failed"); h_b.close(); return;
  }
  remaining = total - initial;
  drained_b = drain_phase(h_b, seen, remaining, "phase-B");
  if drained_b > 0 {
    println(
      "v5-t4c: phase-B drained={drained_b} first_seen={seen[initial]} last_seen={seen[initial + drained_b - 1]}"
    );
  } else { println("v5-t4c: phase-B drained=0"); }
  h_b.close();

  // Verify the merged sequence covers 1..=total contiguously.
  if drained_a + drained_b != total {
    println("v5-t4c: count-mismatch a={drained_a} b={drained_b} total={total}");
    return;
  }
  for vi in 0..total {
    expect = vi + 1;
    got = seen[vi];
    if got != expect {
      println("v5-t4c: order-mismatch idx={vi} got={got} expect={expect}");
      return;
    }
  }
  println("v5-t4c: ok last_session={total}");
}
