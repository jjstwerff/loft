use sql;

// @PLN23 / @PLN24 arc G — a third backend, over a library that may not be here.
//
// Everything below is the same shape as the sqlite backend, with one addition
// that is the point of arc G: `available()`. The library is declared
// `[c] optional-libs`, so it is not linked and not opened until a symbol needs
// it — and a caller must ask before calling, because a `#c` symbol that cannot
// be resolved faults rather than returning null.

// --- the C surface, bound verbatim -----------------------------------------
// duckdb's handles are opaque pointers held as loft `integer`, the convention
// @PLN24 settled on: loft has no type that distinguishes a handle from an
// integer, so the declaration's C signature is what says which is which.
fn ddb_open(path: text, out: integer) -> integer;      #c "duckdb_open" "int(const char*, void*)"
fn ddb_connect(db: integer, out: integer) -> integer;  #c "duckdb_connect" "int(void*, void*)"
fn ddb_query(conn: integer, sql: text, res: integer) -> integer;
#c "duckdb_query" "int(void*, const char*, void*)"
fn ddb_destroy_result(res: integer);                   #c "duckdb_destroy_result" "void(void*)"
fn ddb_result_error(res: integer) -> text?;            #c "duckdb_result_error" "const char*(void*)"
fn ddb_column_count(res: integer) -> integer;          #c "duckdb_column_count" "unsigned long(void*)"
fn ddb_row_count(res: integer) -> integer;             #c "duckdb_row_count" "unsigned long(void*)"
fn ddb_value_is_null(res: integer, col: integer, row: integer) -> boolean;
#c "duckdb_value_is_null" "bool(void*, unsigned long, unsigned long)"
// The POINTER, not the text: this return is caller-frees, so loft takes the
// address, copies through `ld_str`, and hands it back to `ddb_free`.
fn ddb_value_ptr(res: integer, col: integer, row: integer) -> integer;
#c "duckdb_value_varchar" "char*(void*, unsigned long, unsigned long)"
fn ddb_free(p: integer);                               #c "duckdb_free" "void(void*)"
fn ddb_disconnect(out: integer);                       #c "duckdb_disconnect" "void(void*)"
fn ddb_close(out: integer);                            #c "duckdb_close" "void(void*)"

// --- S4: prepared statements ------------------------------------------------
// duckdb's placeholders are `?`, so the statement text is assembled the same way
// as sqlite's and mariadb's; only postgres numbers them.
fn ddb_prepare(conn: integer, sql: text, out: integer) -> integer;
#c "duckdb_prepare" "int(void*, const char*, void*)"
fn ddb_prepare_error(stmt: integer) -> text?;  #c "duckdb_prepare_error" "const char*(void*)"
fn ddb_nparams(stmt: integer) -> integer;      #c "duckdb_nparams" "unsigned long(void*)"
fn ddb_bind_varchar(stmt: integer, i: integer, v: text) -> integer;
#c "duckdb_bind_varchar" "int(void*, unsigned long, const char*)"
fn ddb_bind_int64(stmt: integer, i: integer, v: integer) -> integer;
#c "duckdb_bind_int64" "int(void*, unsigned long, long long)"
fn ddb_bind_null(stmt: integer, i: integer) -> integer;
#c "duckdb_bind_null" "int(void*, unsigned long)"
fn ddb_execute_prepared(stmt: integer, res: integer) -> integer;
#c "duckdb_execute_prepared" "int(void*, void*)"
fn ddb_destroy_prepare(out: integer);          #c "duckdb_destroy_prepare" "void(void*)"

// --- the shim's slots ------------------------------------------------------
fn slot_db() -> integer;     #c "ld_slot_db" "void*(void)"
fn slot_conn() -> integer;   #c "ld_slot_conn" "void*(void)"
fn take_db() -> integer;     #c "ld_take_db" "void*(void)"
fn take_conn() -> integer;   #c "ld_take_conn" "void*(void)"
fn slot_stmt() -> integer;   #c "ld_slot_stmt" "void*(void)"
fn take_stmt() -> integer;   #c "ld_take_stmt" "void*(void)"
fn result_buf() -> integer;  #c "ld_result" "void*(void)"
fn as_text(p: integer) -> text?; #c "ld_str" "const char*(void*)"

// The soname exactly as `[c] optional-libs` spells it — the availability query
// is keyed on the declaration, not on a guess about the file name.
pub const DUCKDB_SONAME = "libduckdb.so";

// --- the loft type that satisfies SqlDb ------------------------------------
pub struct Duck {
  db: integer,
  conn: integer,
  row: integer,
  rows: integer,
  live: boolean,
  stmt: integer,
  err: text,
  tx: Tx,
  // H7 — duckdb has no `CREATE PROCEDURE`, so the definitions live here, the
  // same answer sqlite gives and through the same shared registry.
  procs: Procs,
}

pub fn duck() -> Duck {
  return Duck { db: 0, conn: 0, row: 0, rows: 0, live: false, stmt: 0, err: "",
                tx: tx_new(), procs: procs_new() };
}

// Is this backend usable on this machine?
//
// Ask BEFORE anything else. A `#c` call into a library that is not installed is
// a fault, not a null — `#c` is the declared edge of loft's totality (@PLN24) —
// so this is the guard that keeps an optional backend inside the language's
// no-runtime-errors rule.
//
// A free function rather than a method, because the answer is about the machine
// and not about a connection: there is nothing to ask it of yet.
pub fn duckdb_available() -> boolean {
  return c_library_available(DUCKDB_SONAME);
}

pub fn db_open(self: Duck, target: text) -> boolean {
  if !c_library_available(DUCKDB_SONAME) {
    self.err = "libduckdb.so is not installed";
    return false
  }
  if ddb_open(target, slot_db()) != 0 { self.err = "open failed"; return false }
  self.db = take_db();
  if self.db == 0 { self.err = "open gave no handle"; return false }
  if ddb_connect(self.db, slot_conn()) != 0 { self.err = "connect failed"; return false }
  self.conn = take_conn();
  return self.conn != 0;
}

// Run a statement for its effect. The result still has to be destroyed — duckdb
// allocates one for every query, including a DDL statement that returns no rows.
pub fn db_exec(self: Duck, sql: text) -> boolean {
  if self.conn == 0 { return false }
  ok = ddb_query(self.conn, sql, result_buf()) == 0;
  if !ok { self.err = ddb_result_error(result_buf()) ?? "query failed" }
  ddb_destroy_result(result_buf());
  return ok;
}

// duckdb materialises the whole result, so the cursor is a row index rather
// than a step function. `db_next` is called BEFORE the first read, so the index
// starts one behind and the first call moves it to row 0.
pub fn db_select(self: Duck, sql: text) -> boolean {
  if self.conn == 0 { return false }
  if self.live { ddb_destroy_result(result_buf()); self.live = false }
  if ddb_query(self.conn, sql, result_buf()) != 0 {
    self.err = ddb_result_error(result_buf()) ?? "select failed";
    ddb_destroy_result(result_buf());
    return false
  }
  self.rows = ddb_row_count(result_buf());
  self.row = -1;
  self.live = true;
  return true;
}

pub fn db_next(self: Duck) -> boolean {
  if !self.live { return false }
  self.row += 1;
  if self.row < self.rows { return true }
  ddb_destroy_result(result_buf());
  self.live = false;
  return false;
}

// SQL NULL and the empty string are different answers, and this is where the
// difference is preserved: `duckdb_value_is_null` is asked FIRST, because
// `duckdb_value_varchar` renders both as something a pointer test alone would
// not separate reliably.
pub fn db_col(self: Duck, i: integer) -> text? {
  if !self.live { return null }
  if ddb_value_is_null(result_buf(), i, self.row) { return null }
  p = ddb_value_ptr(result_buf(), i, self.row);
  if p == 0 { return null }
  s = as_text(p);
  // duckdb allocated it, so duckdb frees it — after loft has copied the bytes.
  ddb_free(p);
  return s;
}

pub fn db_width(self: Duck) -> integer {
  if !self.live { return 0 }
  return ddb_column_count(result_buf());
}

pub fn db_last_error(self: Duck) -> text { return self.err; }

// --- S4: prepare, bind, execute ---------------------------------------------
//
// Unproven on the machine this was written on: libduckdb is not installed here,
// so the cells below have been read but never RUN, and the fixture reports SKIP.
// Said plainly rather than left to look covered — a skip that reads as a pass is
// how a dead binding stays green.

fn release(self: Duck) {
  if self.stmt != 0 { ddb_destroy_prepare(slot_stmt()); self.stmt = 0 }
}

fn prepare_bind(self: Duck, q: SqlText) -> boolean {
  // A refused identifier has no statement (H6) — nothing to prepare, nothing sent.
  stmt = q.statement(SQL_QMARK, "\"");
  if stmt == null { self.err = "an identifier was refused"; return false }
  return self.prepare_text(stmt, q);
}

// The same bind, given the statement TEXT rather than deriving it — which is
// what a registered procedure has: its body was assembled at deploy, and its
// values arrive later.
fn prepare_text(self: Duck, sql: text, q: SqlText) -> boolean {
  if self.conn == 0 { return false }
  self.release();
  if ddb_prepare(self.conn, sql, slot_stmt()) != 0 {
    self.stmt = take_stmt();
    self.err = ddb_prepare_error(self.stmt) ?? "prepare failed";
    self.release();
    return false
  }
  self.stmt = take_stmt();
  if self.stmt == 0 { self.err = "prepare gave no statement"; return false }
  // The driver's own count against the parser's — the same independent check
  // the other three backends make.
  if ddb_nparams(self.stmt) != q.params() {
    self.err = "statement wants {ddb_nparams(self.stmt)} parameters, {q.params()} were interpolated";
    return false
  }
  for b in q.binds {
    at = b#count + 1;                       // duckdb counts parameters from 1
    ok = if b.kind == SQL_NULL { ddb_bind_null(self.stmt, at) }
      else if b.kind == SQL_INT { ddb_bind_int64(self.stmt, at, b.i) }
      else if b.kind == SQL_BOOLEAN { ddb_bind_int64(self.stmt, at, b.i) }
      else { ddb_bind_varchar(self.stmt, at, b.as_text()) };
    if ok != 0 { self.err = "binding parameter {at} failed"; return false }
  }
  return true;
}

pub fn db_run(self: Duck, q: SqlText) -> boolean {
  if !self.prepare_bind(q) { return false }
  ok = ddb_execute_prepared(self.stmt, result_buf()) == 0;
  if !ok { self.err = ddb_result_error(result_buf()) ?? "execute failed" }
  ddb_destroy_result(result_buf());
  self.release();
  return ok;
}

pub fn db_rows(self: Duck, q: SqlText) -> boolean {
  if !self.prepare_bind(q) { return false }
  if self.live { ddb_destroy_result(result_buf()); self.live = false }
  if ddb_execute_prepared(self.stmt, result_buf()) != 0 {
    self.err = ddb_result_error(result_buf()) ?? "execute failed";
    ddb_destroy_result(result_buf());
    self.release();
    return false
  }
  self.rows = ddb_row_count(result_buf());
  self.row = -1;
  self.live = true;
  return true;
}

// --- T1–T3: transactions ----------------------------------------------------
//
// duckdb wants the `TRANSACTION` word — the one backend of the four whose
// keyword differs, which is why the keyword is the backend's to supply.
//
// UNPROVEN like the rest of this backend: libduckdb is not installed on the
// machine this was built on, so these three were read and never run.
pub fn db_begin(self: Duck) -> boolean { return tx_begin(self, self.tx, "BEGIN TRANSACTION"); }
pub fn db_commit(self: Duck) -> boolean { return tx_commit(self, self.tx); }
pub fn db_rollback(self: Duck) -> boolean { return tx_rollback(self, self.tx); }

// --- H7: procedures, kept in the process --------------------------------------
//
// duckdb has no `CREATE PROCEDURE` either, so it gives sqlite's answer through
// the SAME shared registry — including the refusal of a body needing procedural
// control flow. Two backends cannot drift apart about what "procedural" means
// when only one function decides it.
//
// UNPROVEN like the rest of this backend, and that is exactly why the logic is
// shared: what runs here is what sqlite's cell exercises on every run.
pub fn db_deploy(self: Duck, p: SqlProc) -> boolean {
  return proc_register(self.procs, p, "\"");
}

pub fn db_call(self: Duck, p: SqlProc, args: SqlText) -> boolean {
  if !p.proc_ok() { self.err = "no procedure"; return false }
  // The name goes through a LOCAL: a text returned across a package boundary is
  // empty if it is consumed where it is produced (loft#773).
  nm = p.proc_name();
  sql = self.procs.proc_lookup(nm);
  if sql == null { self.err = "no procedure {p.proc_name()}"; return false }
  if args.params() != p.proc_arity() { self.err = "wrong number of arguments"; return false }
  if !self.prepare_text(sql, args) { return false }
  ok = ddb_execute_prepared(self.stmt, result_buf()) == 0;
  if !ok { self.err = ddb_result_error(result_buf()) ?? "execute failed" }
  ddb_destroy_result(result_buf());
  self.release();
  return ok;
}

pub fn db_shut(self: Duck) {
  self.release();
  if self.live { ddb_destroy_result(result_buf()); self.live = false }
  if self.conn != 0 { ddb_disconnect(slot_conn()); self.conn = 0 }
  if self.db != 0 { ddb_close(slot_db()); self.db = 0 }
}
