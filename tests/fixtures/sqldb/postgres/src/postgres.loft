use sql;

fn pq_connect(conninfo: text) -> integer;      #c "PQconnectdb" "void*(const char*)"
fn pq_status(c: integer) -> integer;           #c "PQstatus" "int(void*)"
fn pq_finish(c: integer);                      #c "PQfinish" "void(void*)"
fn pq_errmsg(c: integer) -> text;              #c "PQerrorMessage" "char*(void*)"
fn pq_exec(c: integer, sql: text) -> integer;  #c "PQexec" "void*(void*, const char*)"
fn pq_res_status(r: integer) -> integer;       #c "PQresultStatus" "int(void*)"
fn pq_ntuples(r: integer) -> integer;          #c "PQntuples" "int(void*)"
fn pq_nfields(r: integer) -> integer;          #c "PQnfields" "int(void*)"
fn pq_getvalue(r: integer, row: integer, col: integer) -> text; #c "PQgetvalue" "char*(void*, int, int)"
fn pq_getisnull(r: integer, row: integer, col: integer) -> integer; #c "PQgetisnull" "int(void*, int, int)"
fn pq_clear(r: integer);                       #c "PQclear" "void(void*)"

// The same interface over a different result model: sqlite STEPS a statement,
// libpq materialises the whole result and indexes it by (row, col). The cursor
// the interface promises is kept here, in `at`, rather than by the library.
pub struct Postgres { conn: integer, res: integer, at: integer, n: integer }

pub fn postgres() -> Postgres { return Postgres { conn: 0, res: 0, at: -1, n: 0 }; }

pub fn db_open(self: Postgres, target: text) -> boolean {
  self.conn = pq_connect(target);
  return self.conn != 0 && pq_status(self.conn) == 0;   // 0 = CONNECTION_OK
}

pub fn db_exec(self: Postgres, sql: text) -> boolean {
  r = pq_exec(self.conn, sql);
  if r == 0 { return false }
  s = pq_res_status(r);
  pq_clear(r);
  return s == 1 || s == 2;                              // COMMAND_OK / TUPLES_OK
}

pub fn db_select(self: Postgres, sql: text) -> boolean {
  if self.res != 0 { pq_clear(self.res); self.res = 0; }
  self.res = pq_exec(self.conn, sql);
  if self.res == 0 || pq_res_status(self.res) != 2 { return false }
  self.n = pq_ntuples(self.res);
  self.at = -1;
  return true;
}

pub fn db_next(self: Postgres) -> boolean {
  if self.res == 0 { return false }
  self.at += 1;
  if self.at < self.n { return true }
  pq_clear(self.res);
  self.res = 0;
  return false;
}

pub fn db_col(self: Postgres, i: integer) -> text? {
  if pq_getisnull(self.res, self.at, i) == 1 { return null }
  return pq_getvalue(self.res, self.at, i);
}

pub fn db_width(self: Postgres) -> integer { return pq_nfields(self.res); }
pub fn db_last_error(self: Postgres) -> text { return pq_errmsg(self.conn); }
pub fn db_shut(self: Postgres) {
  if self.res != 0 { pq_clear(self.res); self.res = 0; }
  if self.conn != 0 { pq_finish(self.conn); self.conn = 0; }
}
