//
// @PLN23 — one contract, four C libraries, driven by `tests/native.rs`.
//
// `seed`, `dump` and `bound` below are the whole claim: they are generic over
// `SqlDb`, they never name a backend, and every backend runs them unchanged. If
// the uniform API were a fiction, these could not exist.
//
// **sqlite needs no server**, so it is the cell that keeps this honest: a
// machine with no database still proves the interface, the bindings, the shim
// loft compiled, and the NULL crossing. postgres and mariadb are conditional and
// say so — a skip is printed, never counted as a pass.
//
// Modes: `sqlite` (always), `postgres`, `maria`, `duckdb`.

use sql;
use sqlite;
use postgres;
use maria;
use duckdb;

// The rows every backend is given, so their outputs are comparable:
//   1 'ada'   an ordinary value
//   2 NULL    SQL NULL
//   3 ''      the empty string — NOT the same thing, and the distinction a SQL
//             binding exists to preserve
fn seed <D: SqlDb> (d: D, create: text) -> boolean {
  _ = d.db_exec("DROP TABLE IF EXISTS loft_u");
  if !d.db_exec(create) { return false }
  return d.db_exec("INSERT INTO loft_u VALUES (1,'ada'),(2,NULL),(3,'')");
}

fn dump <D: SqlDb> (d: D, sql: text) -> text {
  out = "";
  if !d.db_select(sql) { return "select failed: {d.db_last_error()}" }
  while d.db_next() {
    c = d.db_col(1);
    if c == null { out += "<null> " } else { out += "[{c ?? ""}] " }
  }
  return out;
}

// --- S4 -----------------------------------------------------------------
//
// The value that decides whether this is a real binding or a string builder.
// Spliced into SQL it closes the VALUES list and drops the table; bound, it is
// just four-and-twenty bytes of text that has to come back unchanged.
const ATTACK = "'); DROP TABLE loft_p; --";

// Longer than the 256-byte column buffer the mariadb result binds start with,
// so the truncation re-fetch is exercised rather than merely written.
fn long_value() -> text {
  s = "";
  for _n in 0..200 { s += "abcde" }
  return s;
}

// Prepared statements, over the same interface and with no backend named.
//
// Every statement here is built by loft's own format strings (@PLN124): the
// literal chunks the author wrote reach `lit`, the interpolated values reach
// `hole_*`, and the backend joins the chunks with its own placeholder. A value
// has no path into the statement text — which is what the ATTACK cell measures.
fn bound <D: SqlDb> (d: D, create: text) -> text {
  _ = d.db_exec("DROP TABLE IF EXISTS loft_p");
  if !d.db_exec(create) { return "FAIL create {d.db_last_error()}" }

  ada: text? = "ada";
  none: text? = null;
  empty: text? = "";
  attack: text? = ATTACK;
  big: text? = long_value();

  q1: SqlText = "INSERT INTO loft_p VALUES ({1}, {ada})";
  // The statement the backend will prepare, and the count the DRIVER must
  // agree with. Reported so a wrong one is visible rather than merely fatal.
  n = q1.params();
  if !d.db_run(q1) { return "FAIL i1 {d.db_last_error()}" }
  q2: SqlText = "INSERT INTO loft_p VALUES ({2}, {none})";
  if !d.db_run(q2) { return "FAIL i2 {d.db_last_error()}" }
  q3: SqlText = "INSERT INTO loft_p VALUES ({3}, {empty})";
  if !d.db_run(q3) { return "FAIL i3 {d.db_last_error()}" }
  q4: SqlText = "INSERT INTO loft_p VALUES ({4}, {attack})";
  if !d.db_run(q4) { return "FAIL i4 {d.db_last_error()}" }
  q5: SqlText = "INSERT INTO loft_p VALUES ({5}, {big})";
  if !d.db_run(q5) { return "FAIL i5 {d.db_last_error()}" }

  // The table is still here — so the ATTACK row was stored, not executed.
  rows = dump(d, "SELECT id, name FROM loft_p WHERE id < 5 ORDER BY id");

  // A bound value is COMPARED, not interpolated: the hostile text finds its own
  // row. It could only do that by arriving intact, as data.
  hit = "";
  q6: SqlText = "SELECT id FROM loft_p WHERE name = {attack}";
  if !d.db_rows(q6) { return "FAIL q6 {d.db_last_error()}" }
  while d.db_next() { hit += "{d.db_col(0) ?? "?"}" }

  // The long value round-trips at full length, through the prepared cursor.
  got = 0;
  q7: SqlText = "SELECT name FROM loft_p WHERE id = {5}";
  if !d.db_rows(q7) { return "FAIL q7 {d.db_last_error()}" }
  while d.db_next() { got = size(d.db_col(0) ?? "") }

  _ = d.db_exec("DROP TABLE loft_p");
  return "p={n} {rows}hit={hit} big={got}";
}

// --- T1–T3 ---------------------------------------------------------------
//
// Atomicity, over the same interface and with no backend named. This lands
// before the object mapping because writing a collection non-atomically is not
// a smaller step, it is a wrong one: a crash mid-write leaves rows that read
// back as a whole collection, and nothing afterwards can tell.
//
// Every claim in the returned line is separately checkable:
//
//   begin=true/true   two transactions opened, one after the other
//   nested=false      a `db_begin` INSIDE one is REFUSED, not silently ignored.
//                     The silent version is the dangerous one — the inner
//                     "rollback" would discard the OUTER transaction's work.
//   rows=0/1          rollback DISCARDED the row, commit KEPT it. The pair is
//                     what makes this non-vacuous: a backend whose `db_begin`
//                     quietly did nothing would answer 1/1, and one that
//                     discarded everything 0/0.
//   stray=false/false a commit or rollback with no transaction open is refused
//                     — the caller believes it has work, and it has none.
fn count_x <D: SqlDb> (d: D) -> integer {
  n = 0;
  if !d.db_select("SELECT id FROM loft_x") { return -1 }
  while d.db_next() { n += 1 }
  return n;
}

fn transact <D: SqlDb> (d: D, create: text) -> text {
  _ = d.db_exec("DROP TABLE IF EXISTS loft_x");
  if !d.db_exec(create) { return "FAIL create {d.db_last_error()}" }

  b1 = d.db_begin();
  _ = d.db_exec("INSERT INTO loft_x VALUES (1)");
  nested = d.db_begin();
  r1 = d.db_rollback();
  after_rollback = count_x(d);

  b2 = d.db_begin();
  _ = d.db_exec("INSERT INTO loft_x VALUES (2)");
  c1 = d.db_commit();
  after_commit = count_x(d);

  stray_c = d.db_commit();
  stray_r = d.db_rollback();

  _ = d.db_exec("DROP TABLE loft_x");
  return "begin={b1}/{b2} nested={nested} rollback={r1} commit={c1} rows={after_rollback}/{after_commit} stray={stray_c}/{stray_r}";
}

fn env_or(name: text, fallback: text) -> text {
  // `env_variable` answers "" for an unset variable, not null, so `??` never
  // fires on it — treating "" as absent is the caller's job.
  v = env_variable(name) ?? "";
  if v == "" { return fallback }
  return v;
}

fn main() {
  mode = env_variable("LOFT_SQLDB_MODE") ?? "";

  if mode == "sqlite" {
    ds = sqlite();
    if !ds.db_open(":memory:") { println("FAIL open"); return }
    if !seed(ds, "CREATE TABLE loft_u (id INTEGER PRIMARY KEY, name TEXT)") {
      println("FAIL seed {ds.db_last_error()}"); ds.db_shut(); return
    }
    println("sqlite {dump(ds, "SELECT id, name FROM loft_u ORDER BY id")}");
    println("sqlite bound {bound(ds, "CREATE TABLE loft_p (id INTEGER PRIMARY KEY, name TEXT)")}");
    println("sqlite tx {transact(ds, "CREATE TABLE loft_x (id INTEGER PRIMARY KEY)")}");
    ds.db_shut();
    return
  }

  if mode == "postgres" {
    dp = postgres();
    if !dp.db_open(env_or("LOFT_PG_CONN", "dbname=loft_test_pg")) {
      println("SKIP postgres {dp.db_last_error()}"); dp.db_shut(); return
    }
    if !seed(dp, "CREATE TABLE loft_u (id INT PRIMARY KEY, name TEXT)") {
      println("FAIL seed {dp.db_last_error()}"); dp.db_shut(); return
    }
    println("postgres {dump(dp, "SELECT id, name FROM loft_u ORDER BY id")}");
    println("postgres bound {bound(dp, "CREATE TABLE loft_p (id INT PRIMARY KEY, name TEXT)")}");
    println("postgres tx {transact(dp, "CREATE TABLE loft_x (id INT PRIMARY KEY)")}");
    _ = dp.db_exec("DROP TABLE loft_u");
    dp.db_shut();
    return
  }

  if mode == "maria" {
    dm = maria();
    if !dm.db_open(env_or("LOFT_MY_CONN", "host=127.0.0.1 user=loft pass=loft db=loft_test_uni")) {
      println("SKIP maria {dm.db_last_error()}"); dm.db_shut(); return
    }
    if !seed(dm, "CREATE TABLE loft_u (id BIGINT PRIMARY KEY, name VARCHAR(32))") {
      println("SKIP maria {dm.db_last_error()}"); dm.db_shut(); return
    }
    println("maria {dump(dm, "SELECT id, name FROM loft_u ORDER BY id")}");
    println("maria bound {bound(dm, "CREATE TABLE loft_p (id BIGINT PRIMARY KEY, name VARCHAR(2000))")}");
    println("maria tx {transact(dm, "CREATE TABLE loft_x (id BIGINT PRIMARY KEY) ENGINE=InnoDB")}");
    _ = dm.db_exec("DROP TABLE loft_u");
    dm.db_shut();
    return
  }

  // @PLN24 arc G — the backend whose C library may simply not be here.
  //
  // It ASKS first. Everything above this point needs its library installed to
  // run at all; this one runs either way, and that is the whole difference an
  // optional library makes. The skip is printed, never counted as a pass.
  if mode == "duckdb" {
    if !duckdb_available() { println("SKIP duckdb libduckdb.so not installed"); return }
    dd = duck();
    if !dd.db_open(env_or("LOFT_DUCKDB", ":memory:")) {
      println("SKIP duckdb {dd.db_last_error()}"); dd.db_shut(); return
    }
    if !seed(dd, "CREATE TABLE loft_u (id BIGINT PRIMARY KEY, name VARCHAR)") {
      println("FAIL seed {dd.db_last_error()}"); dd.db_shut(); return
    }
    println("duckdb {dump(dd, "SELECT id, name FROM loft_u ORDER BY id")}");
    println("duckdb bound {bound(dd, "CREATE TABLE loft_p (id BIGINT PRIMARY KEY, name VARCHAR)")}");
    println("duckdb tx {transact(dd, "CREATE TABLE loft_x (id BIGINT PRIMARY KEY)")}");
    dd.db_shut();
    return
  }

  println("FAIL unknown-mode");
}
