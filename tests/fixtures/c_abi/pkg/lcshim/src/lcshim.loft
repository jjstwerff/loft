//
// @PLN24 arc D — bound to the SHIM, never to the shape it wraps. Each of these
// is a signature the fixed trampolines cannot call directly.
//
// `int64_t` matches `lc_shim.c` verbatim. It said `long` on both sides, which is
// 32 bits on Windows — see the note beside `lcs_shim_scale`.

pub fn shim_scale(bits: integer, by_bits: integer) -> integer; #c "lcs_shim_scale" "int64_t(int64_t, int64_t)"
pub fn shim_mod(a: integer, b: integer) -> integer;            #c "lcs_shim_mod" "int64_t(int64_t, int64_t)"
pub fn shim_owned(n: integer) -> text;                         #c "lcs_shim_owned" "const char*(int64_t)"
