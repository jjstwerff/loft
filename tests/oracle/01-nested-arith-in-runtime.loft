//
// @PLN89 differential-oracle corpus — AXIS: arithmetic nested inside other
// runtime (`&mut`) calls. This is the shape that breaks `--native` codegen when
// an op is `&mut self` and inlined as an argument to another `&mut` call (the
// E0499 double-borrow this session's overflow-log attempt hit). The interpreter
// dispatches each op separately and never sees it; native inlines, so a nesting
// bug shows up here and NOWHERE in the interpreter. Both backends must agree.

fn at(t: text, i: integer) -> character {
  // index computed by arithmetic, nested in the `[]` runtime call
  return t[i - 1];
}

fn main() {
  s = "hello";
  // arithmetic (i - 1) nested inside text indexing
  built = "";
  for i in 1..6 { built += "{at(s, i)}"; print("{at(s, i)}"); }
  assert(built == "hello", "the offset index walks the whole word in order; got `{built}`");
  print("\n");

  // arithmetic nested inside vector indexing.  The `?? 0` is the C80 null model, not
  // decoration: a DYNAMIC index types nullable because it can be out of range, and
  // without the discharge this program stopped COMPILING — which the oracle read as the
  // two backends agreeing to reject it, so this whole axis silently stopped running.
  v = [10, 20, 30, 40];
  acc = 0;
  for j in 0..4 { acc += v[(j * 2) % 4] ?? 0; }
  assert(acc == 80, "(j*2)%4 walks 0,2,0,2 -> 10+30+10+30 = 80; got {acc}");
  print("acc={acc}\n");

  // arithmetic nested inside a fn argument, itself nested in another call
  inner = "{1 + 2 * 3}_{(8 - 1) / 7}";
  assert(inner == "7_1", "precedence inside interpolation: 1+2*3 = 7, (8-1)/7 = 1; got `{inner}`");
  assert(len(inner) == 3, "three characters; got {len(inner)}");
  print("len={len(inner)} inner={inner}\n");
}
