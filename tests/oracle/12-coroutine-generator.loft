// Coroutines/generators — the native state-machine lowering vs the interpreter's
// suspend/resume are two very different mechanisms; their observable sequence must
// agree. Covers a loop-driven numeric generator, a text generator, argument reads
// across yields, and early consumption.
fn squares(n: integer) -> iterator<integer> { for i in 0..n { yield i * i; } }
fn labels(prefix: text, n: integer) -> iterator<text> { for i in 0..n { yield prefix + "{i}"; } }
fn main() {
    sum = 0;
    for s in squares(5) { sum += s; }
    assert(sum == 30, "0+1+4+9+16 = 30; got {sum}");
    println("squares_sum={sum}");
    out = "";
    for l in labels("k", 3) { out = out + l + ","; }
    // The generator's ARGUMENT has to survive each yield: a prefix that came back empty
    // (or repeated) after a suspend is the divergence this cell exists for, and a sum
    // could not see it.
    assert(out == "k0,k1,k2,", "the prefix survives every yield; got `{out}`");
    println("labels={out}");
    // take only the first two of a longer generator
    seen = 0; acc = 0;
    for s in squares(100) { if seen >= 2 { } else { acc += s; seen += 1; } }
    assert(acc == 1, "only the first two squares are taken: 0+1 = 1; got {acc}");
    assert(seen == 2, "…and exactly two were consumed; got {seen}");
    println("first_all={acc}");
}
