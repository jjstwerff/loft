//
// @PLN89 differential-oracle corpus — AXIS: a vector fn whose tail is an explicit
// `return <fresh-owned vector>` must NRVO-deliver into __retbuf, exactly as the
// implicit tail does. This is the #448 c5 residual (the oracle's first catch was
// the headline #448 shape, program 08; this guards the rest of its matrix).
//
// An explicit `return [literal]` used to leave the fn's `returned` a BARE vector
// (it built a fresh __vdb store and returned THAT), while the equivalent implicit
// tail `{ [literal] }` delivered into __retbuf. A DIRECT caller copes (it owns the
// result), but an NRVO caller that CHAINS the bare-returning fn into its own buffer
// (`return wrap()` → `__retbuf = wrap(__retbuf)`) frees __retbuf and orphans the
// store wrap never wrote there. Fixed by delivering every fresh-owned vector return
// — tail (block_result #437 generalized to literals) AND mid-body (deliver_mid_-
// vector_returns) — into __retbuf. Guards leak-freedom + value on both backends.

// single-return literal fn (triple), chained by an NRVO wrapper (#448 c5)
fn triple(n: integer) -> vector<integer> {
  return [n, n, n];
}
fn wrap1(n: integer) -> vector<integer> {
  return triple(n);
}

// MULTI-return literal fn (dual), chained — both return paths must deliver
fn dual(c: boolean) -> vector<integer> {
  if c { return [1, 1]; }
  return [2, 2, 2];
}
fn wrap2(c: boolean) -> vector<integer> {
  return dual(c);
}

// MIRROR shape — an early `return [literal]` (mid-body) + a tail `return <call>`
// that NRVO-chains the buffer. The tail chain makes the fn buffer-bound via a
// parse_return MidReturn (NOT a tail rename), so the mid-body literal must still
// be delivered into __retbuf or the early path orphans its store. Pre-existing
// leak on main, both backends; fixed by the block_result buffer-bound mid-body
// delivery.
fn mixed(c: boolean, n: integer) -> vector<integer> {
  if c { return [n, n]; }
  return triple(n);
}

fn main() {
  // An orphaned return buffer keeps the VALUES right and loses the store, so the length
  // is the discriminating half on every line here — each arm returns a different one on
  // purpose, and a buffer delivered from the wrong path shows up as the other arm's.
  a = wrap1(7);
  a0 = a[0] ?? -1; a2 = a[2] ?? -1;
  assert(a0 == 7 && a2 == 7, "the chained literal arrives intact; got {a0} {a2}");
  assert(len(a) == 3, "triple gives three; got {len(a)}");
  print("a={a0}+{a2} alen={len(a)}\n");

  // multi-return literal, chained, take the TAIL path
  b = wrap2(false);
  b0 = b[0] ?? -1;
  assert(b0 == 2 && len(b) == 3, "the tail arm is [2,2,2]; got {b0} len {len(b)}");
  print("b={b0} blen={len(b)}\n");

  // multi-return literal, chained, take the EARLY path
  d = wrap2(true);
  d0 = d[0] ?? -1;
  assert(d0 == 1 && len(d) == 2, "the early arm is [1,1] — a different length; got {d0} len {len(d)}");
  print("d={d0} dlen={len(d)}\n");

  // mirror: early literal + tail call-chain, take the EARLY path (was the h4 leak)
  e = mixed(true, 7);
  e0 = e[0] ?? -1;
  assert(e0 == 7 && len(e) == 2, "the mid-body literal is [7,7]; got {e0} len {len(e)}");
  print("e={e0} elen={len(e)}\n");

  // mirror, take the TAIL (call) path
  f = mixed(false, 7);
  f0 = f[0] ?? -1;
  assert(f0 == 7 && len(f) == 3, "the tail chain delivers triple's three; got {f0} len {len(f)}");
  print("f={f0} flen={len(f)}\n");

  // consume so a downstream `+=` would surface any dropped/doubled rows
  sa = 0;
  for x in a { sa += x; }
  assert(sa == 21, "7*3 = 21, so no row was dropped or doubled; got {sa}");
  print("sa={sa}\n");
}
