// Higher-order + heap-capturing closures — the native closure record (a heap
// struct holding captures) vs the interpreter's closure frame, especially when a
// STRUCT is captured and a closure is passed to another function and re-applied.
// Results must agree with no leak.
struct Base { v: integer }
fn make_scaler(b: Base, factor: integer) -> fn(integer) -> integer {
    return fn(x: integer) -> integer { b.v + x * factor };
}
fn apply_all(f: fn(integer) -> integer, xs: vector<integer>) -> integer {
    total = 0;
    for i in 0..len(xs) { total += f(xs[i] ?? 0); }
    total
}
fn main() {
    s = make_scaler(Base { v: 10 }, 3);
    t = make_scaler(Base { v: 100 }, 2);   // a second record must not reuse the first's store
    sv = apply_all(s, [1, 2, 3]);
    tv = apply_all(t, [1, 2]);
    // The captured STRUCT is the axis: if the second factory call reused the first's
    // record, `s` would start reading base 100 and the totals swap character entirely.
    assert(sv == 48, "(10+3)+(10+6)+(10+9) = 48 from s's own captured Base; got {sv}");
    assert(tv == 206, "(100+2)+(100+4) = 206 from t's; got {tv}");
    println("s={sv} t={tv}");
    // a stored closure applied twice — the record must survive between calls
    inc = make_scaler(Base { v: 0 }, 1);
    iv = inc(5) + inc(5);
    assert(iv == 10, "5 + 5 — the capture record outlives the first application; got {iv}");
    println("inc={iv}");
}
