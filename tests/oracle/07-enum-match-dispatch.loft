//
// @PLN89 differential-oracle corpus — AXIS: enum/match dispatch with payload
// extraction. Struct-enum variant fields are laid out by codegen, and matching
// + destructuring them (especially as call args / vector elements) is a known
// interp-vs-native divergence surface (@P303). Both backends must agree.

enum Shape { Circle { radius: integer }, Rect { width: integer, height: integer } }

fn area(s: Shape) -> integer {
  return match s {
    Circle { radius } => radius * radius * 3,
    Rect { width, height } => width * height,
  };
}

fn main() {
  c = Circle { radius: 2 };
  r = Rect { width: 3, height: 4 };
  ac = area(c); ar = area(r);
  // The two happen to be equal, which is worth saying out loud: a reader cannot tell
  // from `12 12` which arm ran.  Dispatching a `Rect` through the Circle arm would read
  // `width` as `radius` and give 27, so the cell does discriminate — but the mixed
  // vector below is what actually separates the arms, and it is asserted too.
  assert(ac == 12, "a circle of radius 2 is 2*2*3 = 12; got {ac}");
  assert(ar == 12, "a 3 by 4 rect is 12 — the same number by a different arm; got {ar}");
  print("circle={ac} rect={ar}\n");

  // match over a vector of enum values (element destructuring path)
  shapes = [Circle { radius: 1 }, Rect { width: 5, height: 6 }, Circle { radius: 3 }];
  total = 0;
  for s in shapes { total += area(s); }
  assert(total == 60, "3 (circle 1) + 30 (rect 5x6) + 27 (circle 3) = 60; got {total}");
  print("total={total}\n");
}
