// heap.md H-Copy vs H-View — the copy-vs-alias boundary both backends must agree on
// (VERIFICATION worklist Stage 1). A whole-value / vector bind COPIES; a struct-typed
// projection is a VIEW. The native DbRef ABI and the interp store must agree.
struct In { v: integer }
struct Out { i: In, items: vector<integer> }
fn main() {
    o = Out { i: In { v: 1 }, items: [10, 20] };

    // COPY: whole-value local struct bind — independent
    cs = o;
    cs.i.v = 99;

    // COPY: vector-valued field projection — independent
    fv = o.items;
    fv[0] = 88;

    // VIEW: struct-typed field projection — aliases
    vi = o.i;
    vi.v = 77;

    // VIEW: struct element of a vector — aliases
    vec = [In { v: 5 }, In { v: 6 }];
    se = vec[0];
    se.v = 66;

    // Each of the four writes above has a DIFFERENT correct destination, and the whole
    // point of the file is that three of them are decided by rules a reader cannot see at
    // the write site (H-Copy vs H-View).  A backend that made the copies alias, or the
    // views copy, still agrees with a backend that made the same mistake.
    assert(o.i.v == 77, "the struct-field projection is a VIEW, so `vi.v = 77` reached `o`; got {o.i.v}");
    assert(o.i.v != 99, "…and the whole-value bind `cs = o` COPIED, so `cs.i.v = 99` did not");
    o0 = o.items[0] ?? -1;
    assert(o0 == 10, "a vector-valued field projection COPIES, so `fv[0] = 88` did not reach `o`; got {o0}");
    v0 = (vec[0] ?? In { v: -1 }).v;
    assert(v0 == 66, "a struct ELEMENT of a vector is a VIEW, so `se.v = 66` reached it; got {v0}");
    println("o_i_v={o.i.v} o_items0={o.items[0]} vec0={vec[0].v}");
}
