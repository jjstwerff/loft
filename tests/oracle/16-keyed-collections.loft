// Keyed collections (hash / sorted) — their word-addressed storage + the sorted
// walk order are intricate codegen; the reduction and the ORDER must agree across
// backends (native's over-free bugs in this class motivated @PLN85's leak fixes).
struct HRec { ck: integer, v: integer }
struct SRec { sk: integer }
fn build_hash() -> hash<HRec[ck]> {
    h: hash<HRec[ck]> = [];
    h += [HRec { ck: 5, v: 50 }];
    h += [HRec { ck: 8, v: 80 }];
    h += [HRec { ck: 2, v: 20 }];
    h
}
fn build_sorted() -> sorted<SRec[sk]> {
    s: sorted<SRec[sk]> = [];
    s += [SRec { sk: 3 }]; s += [SRec { sk: 1 }]; s += [SRec { sk: 2 }];
    s
}
fn main() {
    h = build_hash();
    total = 0; for r in h { total += r.v; }
    // A hash has no promised walk ORDER (concurrency.md C-Order), so only the
    // order-independent sum is asserted — asserting a hash order here would pin an
    // implementation detail the rules deliberately leave free.
    assert(total == 150, "50 + 80 + 20 = 150, in whatever order the hash walks; got {total}");
    s = build_sorted();
    order = ""; for e in s { order = order + "{e.sk}"; }
    // A `sorted` DOES promise key order, so here the order itself is the claim.
    assert(order == "123", "a sorted collection walks in ascending key order; got `{order}`");
    println("hash_sum={total} sorted_order={order}");
}
