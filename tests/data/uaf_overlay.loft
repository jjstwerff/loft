//
// Regression fixture for the captured-group materialisation fix + the
// `introspect --show-ownership` free-before-dependent-read overlay (plans/
// captured-group-elem-uaf.md). It carries BOTH:
//   - `bad`  — a captured-group element access. BEFORE the fix, the group's backing
//              store `__vdb_1` was freed before the arm dereferenced `arg[0]` (a UAF);
//              AFTER the fix the arm byte-copies into an owned buffer first, so the
//              overlay is silent. If the fix regresses, the overlay fires here.
//   - `good` — the IDENTICAL element access on a normal owned vector (already correct).
// The overlay's own firing is proved parser-free in `use_analysis::uaf_overlay_tests`;
// this fixture is the end-to-end regression gate (overlay must stay SILENT on both).

enum Token {
  Punct { #lexeme sym: text },
  Ident { name: text },
  Num { value: integer },
}
fn id(n: text) -> Token {
  Ident { name: n }
}
fn p(s: text) -> Token {
  Punct { sym: s }
}

// UAF: `arg` (a view into the freed `__vdb_1`) is dereferenced after the free.
fn bad(v: vector<Token>) -> text {
  match v {
    [_, "(", (arg: Ident)*(","), ")"] => match arg[0] { Ident { name } => name, _ => "?" },
    _ => "!",
  }
}

// CORRECT: the owned vector's backing store is freed after the element read.
fn good(a: text, b: text) -> text {
  ws: vector<Token> = [id(a), id(b)];
  match ws[0] { Ident { name } => name, _ => "?" }
}

fn main() {
  print(bad([id("foo"), p("("), id("a"), p(")")]));
  print(good("x", "y"));
}
