//
// Fixture for the `introspect --show-ownership` free-before-dependent-read overlay
// (the temporal extension of the @PLN103 lifetime inspector). It carries BOTH:
//   - `bad`  — the captured-group element-access use-after-free (plans/
//              captured-group-elem-uaf.md): the group's backing store `__vdb_1` is
//              freed before the arm dereferences `arg[0]`. The overlay MUST flag it.
//   - `good` — the IDENTICAL element access on a normal owned vector, where the
//              backing store is freed AFTER the read. The overlay must NOT flag it.
// So a single fixture is both the positive and the negative control.

enum Token {
  Punct { #lexeme sym: text },
  Ident { name: text },
  Num { value: integer },
}
fn id(n: text) -> Token {
  Ident { name: n }
}
fn p(s: text) -> Token {
  Punct { sym: s }
}

// UAF: `arg` (a view into the freed `__vdb_1`) is dereferenced after the free.
fn bad(v: vector<Token>) -> text {
  match v {
    [_, "(", (arg: Ident)*(","), ")"] => match arg[0] { Ident { name } => name, _ => "?" },
    _ => "!",
  }
}

// CORRECT: the owned vector's backing store is freed after the element read.
fn good(a: text, b: text) -> text {
  ws: vector<Token> = [id(a), id(b)];
  match ws[0] { Ident { name } => name, _ => "?" }
}

fn main() {
  print(bad([id("foo"), p("("), id("a"), p(")")]));
  print(good("x", "y"));
}
