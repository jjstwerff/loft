//
// loft#801 — a package module may name a type the entry declares after the `use`
// that pulled the module in, whether the name appears in a DECLARATION or only in
// an EXPRESSION.
//
// It used to depend on the spelling: `r: F801Roofs = F801Roofs { … }` compiled and
// the identical `r = F801Roofs { … }` did not, because only a written type left a
// forward-reference stub for the entry's declaration to adopt.
use fwd801;

fn main() {
    assert(f801_holder() == 11, "field declaration (the control that always worked)");
    assert(f801_local() == 22, "a local built by construction alone");
    assert(f801_vector() == 35, "construction inside a vector literal");
    assert(f801_for() == 44, "iterating a vector of the forward-declared type");
    assert(f801_sizeof() == 8, "the type named as a value argument");
    assert(f801_typedef() == 55, "a typedef the entry declares");
}
