# Optional cargo config — copy to `.cargo/config.toml` to opt in to the
# `mold` linker on Linux x64.  Cuts release-build link time by ~5x
# (typically 20s → 3s on incremental rebuilds).
#
# Why this is opt-in (and not the committed default):
# - mold isn't on the default Linux toolchain; `apt install mold` first.
# - CI runners (ubuntu-latest, macos-latest, windows-latest) don't have
#   mold preinstalled.  Activating it globally would break CI without
#   an additional install step in `.github/workflows/ci.yml`.
# - macOS and Windows use platform-native linkers; mold is Linux-only.
#
# How to activate:
#   1. Install mold: `sudo apt install mold` (Ubuntu / Debian)
#   2. Copy this file:  cp .cargo/config.toml.example .cargo/config.toml
#   3. Verify: `cargo build --release -v 2>&1 | grep fuse-ld`
#
# To revert: just delete `.cargo/config.toml`.  Cargo falls back to the
# system linker.
#
# `make iter TEST=...` already opts in to mold automatically when it's on
# PATH, so this global config is only useful if you also want plain
# `cargo test --release` / `cargo build --release` to use mold.

[target.x86_64-unknown-linux-gnu]
rustflags = ["-C", "link-arg=-fuse-ld=mold"]
