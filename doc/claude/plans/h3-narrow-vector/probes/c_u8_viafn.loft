// H3 via-fn path — the write reaches the element through a STRUCT PARAMETER, the shape
// crawler's collision field used.  Hand-computed: direct=200 via_fn=200.
struct S { a: vector<u8> }
fn poke(s: S, i: integer) { s.a[i] = 200 as u8? ?? 0; }
fn main() {
  s = S { a: [1, 2, 3] };
  s.a[0] = 200 as u8? ?? 0;
  poke(s, 1);
  print("got {s.a[0]},{s.a[1]} | 200,200\n");
}
