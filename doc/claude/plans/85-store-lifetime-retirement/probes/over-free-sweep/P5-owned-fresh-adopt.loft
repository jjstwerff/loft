struct M { hp: integer not null, depth: integer not null, name: text }
struct Box { rows: vector<M> }
fn m_none() -> M { M { hp: 0, depth: 0, name: "" } }
fn filler(n: integer) -> integer { es: vector<M> = []; for j in 0..n { es += [M{hp:j,depth:j,name:"f{j}"}]; } return len(es); }
fn mk(seed: integer) -> M { M{hp:seed,depth:seed+1,name:"mk{seed}"} }
fn choose(seed: integer) -> M { best = m_none(); cand = mk(seed); if cand.depth > best.depth { best = cand; } best }
fn main() {
  for i in 0..8 { r = choose(i); acc=0; for k in 0..6 { acc += filler(6); } assert(r.depth==i+1, "i{i}: r.depth={r.depth}"); }
  println("P5 ok");
}
