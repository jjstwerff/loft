struct M { hp: integer not null, depth: integer not null, name: text }
fn m_none() -> M { M { hp: 0, depth: 0, name: "" } }
fn pool_of(t: vector<M>) -> vector<M> { out: vector<M> = []; for i in 0..len(t) { out += [t[i] ?? m_none()]; } out }
fn filler(n: integer) -> integer { es: vector<M> = []; for j in 0..n { es += [M{hp:j,depth:j,name:"f"}]; } return len(es); }
fn one(t: vector<M>, salt: integer) -> M { pool = pool_of(t); chosen = m_none(); np = len(pool); if np > 0 { chosen = pool[salt % np ?? 0] ?? m_none(); } chosen }
fn main() { t: vector<M> = []; for k in 0..6 { t += [M{hp:k,depth:k,name:"m"}]; } for i in 0..20 { r = one(t, i); acc=0; for f in 0..6 { acc += filler(6); } assert(len(t)==6, "t={len(t)}"); } println("T1 ok"); }
