struct M { hp: integer not null, depth: integer not null, name: text }
struct Box { rows: vector<M> }
fn m_none() -> M { M{hp:0,depth:0,name:""} }
fn filler(n: integer) -> integer { es: vector<M> = []; for j in 0..n { es += [M{hp:j,depth:j,name:"f"}]; } return len(es); }
fn rows(b: Box) -> vector<M> { b.rows }
fn main() {
  boxes: vector<Box> = [];
  for k in 0..4 { bx = Box { rows: [] }; for j in 0..(k+1) { bx.rows += [M{hp:j,depth:j,name:"x"}]; } boxes += [bx]; }
  for i in 0..6 {
    best: vector<M> = [];
    for k in 0..len(boxes) { cur = rows(boxes[k] ?? Box{rows:[]}); if len(cur) > len(best) { best = cur; } }
    acc=0; for f in 0..6 { acc += filler(6); }
    assert(len(best)==4, "i{i}: best={len(best)}");
  }
  println("P15 ok");
}
