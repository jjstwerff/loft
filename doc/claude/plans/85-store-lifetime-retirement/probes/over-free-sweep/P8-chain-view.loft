struct M { hp: integer, depth: integer, name: text }
struct Box { rows: vector<M> }
enum Cell { Empty, Filled { items: vector<M> } }
fn m_none() -> M { M { hp: 0, depth: 0, name: "" } }
fn filler(n: integer) -> integer { es: vector<M> = []; for j in 0..n { es += [M{hp:j,depth:j,name:"f{j}"}]; } return len(es); }
fn lvl1(t: vector<M>, i: integer) -> M { t[i] ?? m_none() }
fn lvl2(t: vector<M>, i: integer) -> M { x = lvl1(t, i); x }
fn lvl3(t: vector<M>, i: integer) -> M { y = lvl2(t, i); best = m_none(); if y.depth > best.depth { best = y; } best }
fn main() {
  t: vector<M> = []; for k in 0..6 { t += [M{hp:k,depth:k,name:"m{k}"}]; }
  for i in 0..8 { r = lvl3(t, i % 6 ?? 0); acc=0; for f in 0..8 { acc += filler(7); } assert(len(t)==6, "i{i}: t={len(t)}"); assert(r.depth>=0, "i{i}: r={r.depth}"); }
  println("P8 ok");
}
