// EXPECT: no leak, prints done. Currently LEAKS N — the PLN47 driving case:
// write+read a struct each iteration; the read's `_read_N` block-temp leaks.
#cwd
struct P { x: integer, y: integer }
fn main() {
  for i in 0..5 {
    { f = file("p3b.bin"); f#format = LittleEndian; f.set_file_size(0); p = P{x:i,y:i}; f += p; f.sync(); }
    { f = file("p3b.bin"); f#format = LittleEndian; q = f#read as P; assert(q.x == i, "rt"); }
  }
  delete("p3b.bin");
  println("done");
}
