struct Box { v: integer }
struct Node { v: integer, kids: vector<Node> }
fn mixed(x: Box, v: vector<Box>) -> integer {
    r = x;                          // owned init (copy)
    total = 0;
    for i in 0..len(v) {
        r = v[i] ?? x;              // borrow reassign
        total += r.v;
        r = Box { v: total };       // OWNED reassign (literal) — 2nd owned assign
        total += r.v;
    }
    total
}
fn build_tree(n: integer) -> Node { root = Node { v: n, kids: [] }; root.kids += [Node { v: n + 1, kids: [] }]; root }
fn deep_pick(t: vector<Node>, i: integer) -> Node { chosen = Node { v: 0, kids: [] }; if len(t) > 0 { chosen = t[i % len(t) ?? 0] ?? Node { v: 0, kids: [] }; } chosen }
fn main() {
    a = Box { v: 5 };
    vs = [Box { v: 1 }, Box { v: 2 }, Box { v: 3 }];
    // total: i0: +1=1,+1=2 ; i1: +2=4,+4=8 ; i2: +3=11,+11=22
    assert(mixed(a, vs) == 22, "mixed {mixed(a, vs)}");
    assert(len(vs) == 3 && (vs[0] ?? a).v == 1, "vs survives {len(vs)}");
    tr = build_tree(10); assert(tr.v == 10, "tree");
    ts = [Node { v: 7, kids: [] }, Node { v: 8, kids: [] }]; dp = deep_pick(ts, 1); assert(dp.v == 8, "deep");
    println("r2 ok");
}
