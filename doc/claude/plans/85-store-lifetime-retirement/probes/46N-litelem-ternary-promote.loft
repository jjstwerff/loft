// FAMILY N — STILL FAILS (both, compile). Same nullable-over-promotion: a vector
// literal whose element is a TERNARY (if/else expression) yielding non-null S is
// promoted to `vector<__nullable<S>>`. Confirms the family is "any non-literal
// element", not fn-calls specifically. Should compile + R=1.
struct S { a: integer, b: text }
fn mk_s(i: integer) -> S { S { a: i, b: "n" } }
fn build() -> vector<S> { [if true { mk_s(1) } else { mk_s(2) }] }
fn main() {
  v = build();
  assert(len(v) == 1, "len={len(v)}");
  println("R={len(v)}");
}
