// D1: write once, then TWO reads (distinct result vars). One leak or two?
#cwd
struct P { x: integer, y: integer }
fn main() {
  { f = file("wr_d1.bin"); f#format = LittleEndian; f.set_file_size(0); p = P{x:5,y:6}; f += p; f.sync(); }
  { f = file("wr_d1.bin"); f#format = LittleEndian; q = f#read as P; println("{q.x}"); }
  { f = file("wr_d1.bin"); f#format = LittleEndian; r = f#read as P; println("{r.x}"); }
  delete("wr_d1.bin");
}
