// owned element 0 NEVER read (only r.1 consumed). The __tuple struct is bound to
// r; if r's store is freed at scope exit, element 0's text should free with it.
struct P { id: integer }
fn to_text(self: P) -> text { return "item-{self.id}"; }
fn pair<T: Printable>(x: T) -> (text, text) { return (x.to_text(), "m"); }
fn main() { for i in 0..3 { r = pair(P { id: i }); assert(r.1 == "m", "e1"); } }
