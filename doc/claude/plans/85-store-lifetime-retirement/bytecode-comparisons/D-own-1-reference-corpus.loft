// @PLN85 D-own-1 Reference return sub-thicket — one fn per delivery path, for the
// byte-identical before/after gate of the classify_reference_delivery collapse.
struct S { a: integer not null, b: integer not null, name: text }
fn s_none() -> S { S { a: 0, b: 0, name: "" } }

// path A — owned-fresh construction returned (ls empty / recover-hidden-refs + rename)
fn mk_fresh(seed: integer) -> S { S { a: seed, b: seed + 1, name: "fresh" } }

// path B — owned-fresh via a nested call (recover hidden refs from the tail Call)
fn mk_wrap(seed: integer) -> S { mk_fresh(seed) }

// path C — return views a LOCAL (a struct read from a local vector) → materialize-copy (#306)
fn pick_local(seed: integer) -> S {
  pool: vector<S> = [];
  pool += [S { a: seed, b: seed + 1, name: "local" }];
  found = pool[0] ?? s_none();
  found
}

// path D — nullable-unwrap tail (v[i] ?? d) → materialize_view_return
fn pick_unwrap(t: vector<S>, i: integer) -> S { t[i] ?? s_none() }

// path E — borrows a visible ARG returned directly (plain rename/borrow)
fn idb(s: S) -> S { s }

fn main() {
  a = mk_fresh(3);
  w = mk_wrap(4);
  c = pick_local(5);
  t: vector<S> = []; t += [S { a: 1, b: 2, name: "t0" }];
  u = pick_unwrap(t, 0);
  d = idb(S { a: 9, b: 8, name: "arg" });
  assert(a.b == 4 && w.b == 5 && c.b == 6 && u.b == 2 && d.b == 8, "values");
  println("reference-corpus ok");
}
