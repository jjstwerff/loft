struct E { hp: integer not null, name: text }
fn e_default() -> E { E{hp:0, name:""} }
fn filler(n: integer) -> integer { es: vector<E> = []; for j in 0..n { es += [E{hp:j, name:"e"}]; } return len(es); }
enum Cell { Empty, Filled { items: vector<E> } }
fn deliver(e: Cell) -> vector<E> { match e { Filled { items } => { items }, _ => { [] } } }
fn main() {
  inner: vector<E> = []; for k in 0..3 { inner += [E{hp:k, name:"e"}]; }
  cell = Filled { items: inner };
  for i in 0..8 { r = deliver(cell); acc=0; for f in 0..8 { acc += filler(7); } assert(len(r)==3, "del i{i}={len(r)}"); }
  println("ok");
}
