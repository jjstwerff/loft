struct E { hp: integer not null, name: text }
enum Cell { Empty, Filled { items: vector<E> } }
fn deliver(e: Cell) -> vector<E> { match e { Filled { items } => { o: vector<E> = []; for x in 0..len(items) { o += [items[x] ?? E{hp:0, name:""}]; } o }, _ => { [] } } }
fn main() { inner: vector<E> = []; for k in 0..3 { inner += [E{hp:k, name:"e"}]; } cell = Filled { items: inner };
  for i in 0..8 { r = deliver(cell); j: vector<E> = []; for q in 0..12 { j += [E{hp:q, name:"x"}]; } assert(len(r)==3, "i{i}"); } println("ok"); }
