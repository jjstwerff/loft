
=== ownership ===
fn n_k1_borrowed_arm -> Join(base=_mvcopy_1):
  #    arg  name                   ownership
  ------------------------------------------------------------------
  0    arg  e                      Borrowed(caller-arg)
  1         __retbuf               Owned
  2         _mv_items_1            Borrowed(base=e)
  3    arg  _mvcopy_1              Borrowed(caller-arg)
  4         _vec_1                 Owned (backing=__vdb_1)
  5         _elm_1                 Owned
  6         __vdb_1                Owned
  delivery: vector<ref(Tok)>["__retbuf"]  — materialised → return buffer

