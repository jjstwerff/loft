  a15: vector<integer> = [15, 16]; total += a15[0];
  a16: vector<integer> = [16, 17]; total += a16[0];
  a17: vector<integer> = [17, 18]; total += a17[0];
  a18: vector<integer> = [18, 19]; total += a18[0];
