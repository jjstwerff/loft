// @PLAN58 STRONG probe — distinctive byte-distinct values, every index, lengths,
// cross-row independence.  Catches stride/offset/length bugs a small-value probe hides.
fn main() {
  vv: vector<vector<integer>> = [[1000000001, 2000000002, 3000000003], [4000000004], [5000000005, 6000000006]];
  assert(len(vv) == 3, "outer len {len(vv)}");
  assert(len(vv[0]) == 3 && len(vv[1]) == 1 && len(vv[2]) == 2, "inner lens {len(vv[0])},{len(vv[1])},{len(vv[2])}");
  assert(vv[0][0] == 1000000001 && vv[0][1] == 2000000002 && vv[0][2] == 3000000003, "row0 {vv[0]}");
  assert(vv[1][0] == 4000000004, "row1 {vv[1]}");
  assert(vv[2][0] == 5000000005 && vv[2][1] == 6000000006, "row2 {vv[2]}");
  println("PASSED 70-strong-int");
}
