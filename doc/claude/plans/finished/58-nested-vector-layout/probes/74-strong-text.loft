// @PLAN58 STRONG probe — text elements (4-byte handles): distinct strings, all indices, lengths.
fn main() {
  vv: vector<vector<text>> = [["alpha", "bravo", "charlie"], ["delta"]];
  assert(len(vv[0]) == 3 && len(vv[1]) == 1, "lens");
  assert(vv[0][0] == "alpha" && vv[0][1] == "bravo" && vv[0][2] == "charlie", "row0 {vv[0]}");
  assert(vv[1][0] == "delta", "row1 {vv[1]}");
  println("PASSED 74-strong-text");
}
