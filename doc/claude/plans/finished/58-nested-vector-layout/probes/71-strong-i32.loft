// @PLAN58 STRONG probe — i32 (4-byte): values with non-zero high bytes so a
// stride-8 read at index>=1 yields a clearly-wrong number, not a coincidental 0.
fn main() {
  vv: vector<vector<i32>> = [[1076895760, 1212630597, 1347440720], [2003195204], [50462976, 117835012]];
  assert(len(vv[0]) == 3 && len(vv[1]) == 1 && len(vv[2]) == 2, "lens");
  assert(vv[0][0] == 1076895760 && vv[0][1] == 1212630597 && vv[0][2] == 1347440720, "row0 {vv[0]}");
  assert(vv[1][0] == 2003195204, "row1 {vv[1]}");
  assert(vv[2][0] == 50462976 && vv[2][1] == 117835012, "row2 {vv[2]}");
  println("PASSED 71-strong-i32");
}
