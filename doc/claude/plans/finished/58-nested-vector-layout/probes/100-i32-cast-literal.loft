// @PLAN58 III-a pinpoint — explicit `as i32` on each literal element.
// If this PASSES, the bug is literal type-inference (1,2 default to wide integer,
// not coerced to declared i32).  If it FAILS, the nested TYPE itself drops forced-size.
fn main() {
  vv: vector<vector<i32>> = [[1 as i32, 2 as i32], [3 as i32]];
  assert(vv[0][0]==1 && vv[0][1]==2 && vv[1][0]==3, "cast {vv}");
  println("PASSED 100-i32-cast-literal");
}
