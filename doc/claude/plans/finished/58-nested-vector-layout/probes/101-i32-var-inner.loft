// @PLAN58 III-a pinpoint — inner built as a correctly-typed flat var, placed by literal.
// Flat vector<i32> works; if [inner] (copy) works but [[1,2]] (inline) fails, the bug is
// in INLINE inner construction, not storage.  Workaround signal.
fn main() {
  inner: vector<i32> = [1, 2];
  vv: vector<vector<i32>> = [inner];
  assert(vv[0][0]==1 && vv[0][1]==2, "var-inner {vv[0]}");
  println("PASSED 101-i32-var-inner");
}
