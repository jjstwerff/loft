// @PLAN58 cluster-V isolation — call-returned fn-ref into a FLAT vector.
// If THIS crashes too, #263 is general (not nested-vector-specific).
fn dbl(x: integer) -> integer { x * 2 }
fn getfn() -> fn(integer) -> integer { dbl }
fn main() {
  fs: vector<fn(integer) -> integer> = [getfn(), getfn()];
  assert(fs[0](5)==10 && fs[1](7)==14, "flat callret");
  println("PASSED 93-fnref-callret-flat");
}
