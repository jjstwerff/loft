// Probe 21 — Cluster IV completion: `??` returning a Vector value
//
// Tests whether the @PLAN51 closure extends to Vector value-blocks
// (probe 10 confirmed Reference; @PLAN51's S1 NRVO + paired_witness
// machinery covers Reference + Vector buffer-return paths).
//
// The shape:
//     a = vec_of_vecs[i] ?? other_vec;
//
// If 21 PASSES, @PLAN51's coverage is complete for both Vector and
// Reference value-blocks — the cluster IV closure stands.
// If 21 FAILS, Vector value-blocks have a separate dangling-store bug
// (would manifest as null DbRef or store_nr=u16::MAX panic, NOT bytes
// corruption — Vec handles are integer-typed slot indices).
//
// Pairing: diff against 10 (Reference shape).
// Status: cluster IV completion probe.

struct Inner { tag: integer }
struct Outer { lists: vector<vector<Inner>> }

fn main() {
  o = Outer { lists: [] };
  inner: vector<Inner> = [Inner { tag: 42 }];
  o.lists += [inner];
  fallback: vector<Inner> = [Inner { tag: 0 }];
  a = o.lists[0] ?? fallback;
  assert(len(a) == 1, "probe 21: len(a) = {len(a)}, want 1");
  assert(a[0].tag == 42, "probe 21: a[0].tag = {a[0].tag}, want 42");
  println("probe 21 PASSED");
}
