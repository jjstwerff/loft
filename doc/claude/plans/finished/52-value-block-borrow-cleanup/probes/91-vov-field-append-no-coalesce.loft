// Probe 91 — Cluster IV-Vec NESTED-FIELD-PUSH: baseline isolation of probes 21/36
//
// Strips ?? from probe 21 entirely.  Demonstrates the bug is in `field += inner_vec`
// for `vector<vector<X>>` STRUCT FIELDS — NOT a value-block-cleanup issue.
//
// The shape:
//     o = Outer { lists: [] };               // outer is empty vector<vector<Inner>>
//     inner: vector<Inner> = [Inner{42}];     // a vector with one element
//     o.lists += inner;                       // PUSH inner AS ONE element
//     a = o.lists[0];                          // expect vector<Inner> [Inner{42}]
//                                              // observed: len(a) = 0
//
// Mechanism (confirmed via IR trace 2026-05-29):
//   Parser lowers `field += inner_vec` to OpAppendVector(field, inner, elm_tp)
//   which is the CONCATENATE op — it reads inner.length and copies that many
//   ELEMENTS (Inner structs) onto the tail of o.lists.  Result: o.lists now
//   contains 1 spurious slot holding raw bytes from inner's Inner element,
//   read back as an inner vector with length 0.
//
// The local-var case (probe 92) takes a DIFFERENT lowering path
// (P188 branch at parser/expressions.rs:957) which uses
// OpNewRecord/OpCopyRecord/OpFinishRecord — correct single-element push.
//
// Pairing: 21 (same shape + ??), 92 (local var instead of struct field), 93 (primitive inner).
// Status: cluster IV-Vec-nested-field-push baseline.

struct Inner { tag: integer }
struct Outer { lists: vector<vector<Inner>> }

fn main() {
  o = Outer { lists: [] };
  inner: vector<Inner> = [Inner { tag: 42 }];
  o.lists += [inner];                          // single-element push (strict-rule explicit form)
  assert(len(o.lists) == 1, "probe 91: len(o.lists) = {len(o.lists)}, want 1");
  a = o.lists[0];
  assert(len(a) == 1, "probe 91: len(a) = {len(a)}, want 1");
  assert(a[0].tag == 42, "probe 91: a[0].tag = {a[0].tag}, want 42");
  println("probe 91 PASSED");
}
