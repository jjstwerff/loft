// Probe 15 — Cluster I LHS border: deep-chain `vec[i].field ?? "x"`
//
// The LHS chains a vector index with a field access.  Whether the
// `_ncc_N` materialisation lifts the WHOLE chain into the temp or only
// the final field read is the question.  Either way, the consumer reads
// text — does the cluster I shape apply?
//
// If 15 FAILS like 02, depth doesn't matter — cluster I is "any
// non-Var LHS regardless of arity."
// If 15 PASSES, deep chains route differently (perhaps the field-read
// pushes a Str pointing into a long-lived parent store, not a
// block-local).
//
// Pairing: diff against 02 (single vec-index) and 04 (single field).
// Status: cluster I LHS-border probe.

struct Item { name: text }
struct Pack { items: vector<Item> }

fn main() {
  p = Pack { items: [] };
  p.items += [Item { name: "present" }];
  a = p.items[0].name ?? "fallback";
  assert(a == "present", "probe 15: got '{a}', want 'present'");
  println("probe 15 PASSED");
}
