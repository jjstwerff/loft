// Probe 62 — IV-Spacial parser-hang isolation: spacial type WITHOUT `??`
//
// Probe 51 hangs the parser when `spacial<Point[name]>` appears with `??`.
// This probe uses the same type WITHOUT `??` — direct assignment, simple
// access.  If 62 PASSES, the hang is in `??` interaction with `spacial`.
// If 62 ALSO hangs, the parser bug is in spacial type resolution itself.
//
// Pairing: 51 (same type with `??` — hangs).
// Status: IV-Spacial isolation probe.

struct Point { name: text, x: float, y: float }
struct W { points: spacial<Point[name]> }

fn main() {
  w = W { points: [] };
  w.points["origin"] = Point { name: "origin", x: 0.0, y: 0.0 };
  e = w.points["origin"];
  assert(e.x == 0.0, "probe 62: e.x = {e.x}, want 0.0");
  println("probe 62 PASSED");
}
