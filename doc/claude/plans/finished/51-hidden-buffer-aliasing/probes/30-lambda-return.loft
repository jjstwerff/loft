// Probe 30 — lambda / closure returning a heap struct.
//
//   make_renderer = |p: P| -> Canvas { alloc_canvas(4, 5, p.tag) };
//   cv = make_renderer(p);
//
// Tests: closures / lambdas storing in fn-ref locals.  Does ref_return
// apply to lambda bodies?  How are hidden buffers set up across the
// lambda boundary?

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn main() {
  make_renderer = fn(p: P) -> Canvas {
    cv = alloc_canvas(4, 5, p.tag);
    cv
  };
  for i in 0..6 {
    p = P { tag: i };
    cv = make_renderer(p);
    assert(cv.w == 4, "iter {i}: w = {cv.w}");
    assert(cv.data[0] == i, "iter {i}: data[0] = {cv.data[0]}");
  }
  println("probe 30 PASSED");
}
