// Probe 13 — recursion through a hidden-buffer-returning fn.
//
//   fn build(n: integer) -> Canvas {
//     if n == 0 { alloc_canvas(4, 5, 0) }
//     else { build(n - 1) }     // recursive call returns Canvas
//   }
//
// Each recursive call has its own hidden buffer.  The outer caller's
// buffer must survive across nested calls.  If the pre-Set FreeRef
// pattern fires at each level, multiple nested frees of the same
// transitive store could happen.
//
// Expected: ? — never tested.  Recursive heap-returns might expose
// stack-of-buffers semantics.

struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn build(n: integer) -> Canvas {
  if n == 0 {
    alloc_canvas(4, 5, 999)
  } else {
    build(n - 1)
  }
}

fn main() {
  for i in 0..6 {
    cv = build(i);
    assert(cv.w == 4, "iter {i}: w = {cv.w}");
    assert(len(cv.data) == 5, "iter {i}: len = {len(cv.data)}");
    assert(cv.data[0] == 999, "iter {i}: data[0] = {cv.data[0]}");
  }
  println("probe 13 PASSED");
}
