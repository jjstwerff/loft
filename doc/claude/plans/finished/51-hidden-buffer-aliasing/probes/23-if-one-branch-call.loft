// Probe 23 — if-tail with only ONE branch being a heap call.
//
//   fn render(p: P, fallback: Canvas) -> Canvas {
//     if p.tag > 0 { alloc_canvas(4, 5, p.tag) } else { fallback }
//   }
//
// One branch returns a fresh heap-allocated Canvas; the other returns
// the caller-provided `fallback` arg (no allocation).  Tests whether
// the panic is when BOTH branches allocate (probe 08) vs. when only
// one does.

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render(p: P, fallback: Canvas) -> Canvas {
  if p.tag > 0 { alloc_canvas(4, 5, p.tag) } else { fallback }
}

fn main() {
  fb = Canvas { data: [], w: 0 };
  for i in 0..6 {
    p = P { tag: i };
    cv = render(p, fb);
    if i > 0 {
      assert(cv.w == 4, "iter {i}: w = {cv.w}");
      assert(cv.data[0] == i, "iter {i}: data[0] = {cv.data[0]}");
    } else {
      assert(cv.w == 0, "iter {i}: fallback w = {cv.w}");
    }
  }
  println("probe 23 PASSED");
}
