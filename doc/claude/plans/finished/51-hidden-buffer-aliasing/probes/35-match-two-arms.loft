// Probe 35 — match-tail with EXACTLY 2 arms (not 3 like probe 18).
//
//   fn render(p: P) -> Canvas {
//     match p.tag % 2 {
//       0 => alloc_canvas(4, 5, 100),
//       _ => alloc_canvas(4, 5, 200),
//     }
//   }
//
// Probe 18's match had 3 arms and produced 3 hidden buffer attrs.
// Does match with 2 arms produce 2 attrs (consistent with arm count)
// or does it engage a different lowering that produces 1 (unified)?
// If 2, confirms match's "no unification" strategy is per-arm.

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render(p: P) -> Canvas {
  match p.tag % 2 {
    0 => alloc_canvas(4, 5, 100),
    _ => alloc_canvas(4, 5, 200),
  }
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv = render(p);
    expected = if i % 2 == 0 { 100 } else { 200 };
    assert(cv.data[0] == expected, "iter {i}: data[0] = {cv.data[0]}");
  }
  println("probe 35 PASSED");
}
