// Probe 33 — if-tail using EXPLICIT returns in both branches.
//
//   fn render(p: P) -> Canvas {
//     if p.tag == 0 {
//       return alloc_canvas(4, 5, 0);
//     } else {
//       return alloc_canvas(4, 5, 1);
//     }
//   }
//
// Probe 08, 22, 27 panicked on `if c { call() } else { call() }` as
// expression-form (with the if itself being the body's tail).  This probe
// uses STATEMENT-form returns inside the if branches.  Different IR shape
// — each branch has a Value::Return statement, and the if is no longer
// the implicit tail.

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render(p: P) -> Canvas {
  if p.tag == 0 {
    return alloc_canvas(4, 5, 0);
  } else {
    return alloc_canvas(4, 5, 1);
  }
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv = render(p);
    expected = if i == 0 { 0 } else { 1 };
    assert(cv.data[0] == expected, "iter {i}: data[0] = {cv.data[0]}");
  }
  println("probe 33 PASSED");
}
