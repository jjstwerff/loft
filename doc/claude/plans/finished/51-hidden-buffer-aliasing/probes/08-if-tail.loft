// Probe 08 — if/else tail returning hidden buffer.
//
//   fn render_if(p: P) -> Canvas {
//     if p.tag % 2 == 0 {
//       alloc_canvas(4, 5, p.tag)
//     } else {
//       alloc_canvas(4, 5, p.tag * 10)
//     }
//   }
//
// The tail is `Value::If(_, then, else)` with each branch returning a call
// result.  S1's preconditions require the tail to be `Var(cv)` (or
// Return(Var(cv))), so an if-tail doesn't match the S1 pattern.  But the
// @P236 `unify_if_branches_work_refs` machinery should kick in — it
// unifies both branches' work-refs into a shared one before ref_return,
// so the function effectively has one hidden buffer that both branches
// fill.
//
// Expected: PASS on both backends if `unify_if_branches_work_refs` works
// correctly for this shape.  If FAIL, it's a new sub-class entwined
// with @P236.

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render_if(p: P) -> Canvas {
  if p.tag % 2 == 0 {
    alloc_canvas(4, 5, p.tag)
  } else {
    alloc_canvas(4, 5, p.tag * 10)
  }
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv = render_if(p);
    expected = if i % 2 == 0 { i } else { i * 10 };
    assert(cv.w == 4, "iter {i}: w = {cv.w}");
    assert(len(cv.data) == 5, "iter {i}: len = {len(cv.data)}");
    assert(cv.data[0] == expected, "iter {i}: data[0] = {cv.data[0]} (expect {expected})");
  }
  println("probe 08 PASSED");
}
