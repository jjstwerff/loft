// Probe 11 — conditional reassignment of hidden buffer.
//
//   fn render_cond(p: P) -> Canvas {
//     cv = alloc_canvas(4, 5, p.tag);
//     if p.tag > 2 {
//       cv = alloc_canvas(4, 5, p.tag * 100);
//     }
//     cv
//   }
//
// Two Sets, but the second is conditional.  Penultimate is the `if`, NOT
// a direct Set, so S1 doesn't fire.  This is the if-without-else variant
// of probe 02 (double Set).
//
// Expected: same as probe 02 — PASS with LEAK (Class II) on iters where
// the second Set fires.  Maybe more iters with leak since the if doesn't
// always trigger.

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render_cond(p: P) -> Canvas {
  cv = alloc_canvas(4, 5, p.tag);
  if p.tag > 2 {
    cv = alloc_canvas(4, 5, p.tag * 100);
  }
  cv
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv = render_cond(p);
    expected = if i > 2 { i * 100 } else { i };
    assert(cv.w == 4, "iter {i}: w = {cv.w}");
    assert(len(cv.data) == 5, "iter {i}: len = {len(cv.data)}");
    assert(cv.data[0] == expected, "iter {i}: data[0] = {cv.data[0]} (expect {expected})");
  }
  println("probe 11 PASSED");
}
