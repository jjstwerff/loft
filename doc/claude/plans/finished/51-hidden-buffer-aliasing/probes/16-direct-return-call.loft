// Probe 16 — direct return of a call result (no intermediate local).
//
//   fn forward(p: P) -> Canvas {
//     alloc_canvas(4, 5, p.tag)         // direct tail call expression
//   }
//
// No Set on cv at all.  The function body IS the call expression in tail
// position.  ref_return promotes... what?  The call's return value is the
// direct tail, no local intermediates exist.
//
// Tests: whether ref_return's body-walk can find a hidden buffer to
// promote when the body is a single call.  Expected: works (no extra
// store created beyond what alloc_canvas allocates), no leak, no
// corruption.

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn forward(p: P) -> Canvas {
  alloc_canvas(4, 5, p.tag)
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv = forward(p);
    assert(cv.w == 4, "iter {i}: w = {cv.w}");
    assert(len(cv.data) == 5, "iter {i}: len = {len(cv.data)}");
    assert(cv.data[0] == i, "iter {i}: data[0] = {cv.data[0]}");
  }
  println("probe 16 PASSED");
}
