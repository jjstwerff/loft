// Probe 20 — method-call form returning a hidden buffer.
//
//   pub fn cloned(both: Canvas) -> Canvas {
//     out = Canvas { data: both.data, w: both.w };
//     out
//   }
//
//   fn render_method(p: P) -> Canvas {
//     base = alloc_canvas(4, 5, p.tag);
//     c = base.cloned();      // method-call form
//     c
//   }
//
// Tests: the method-call dispatch path through to a hidden-buffer-returning
// fn.  `both: Canvas` makes cloned() invokable as `base.cloned()`.
// Does S1 / S2 handle the method-call ALC the same as a free-fn call?

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

pub fn cloned(both: Canvas) -> Canvas {
  out = Canvas { data: both.data, w: both.w };
  out
}

fn render_method(p: P) -> Canvas {
  base = alloc_canvas(4, 5, p.tag);
  c = base.cloned();
  c
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv = render_method(p);
    assert(cv.w == 4, "iter {i}: w = {cv.w}");
    assert(len(cv.data) == 5, "iter {i}: len = {len(cv.data)}");
    assert(cv.data[0] == i, "iter {i}: data[0] = {cv.data[0]}");
  }
  println("probe 20 PASSED");
}
