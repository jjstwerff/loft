// Probe 10 — loop that mutates hidden buffer's FIELD (no reassignment of cv).
//
//   fn render_loop_mutate(p: P) -> Canvas {
//     cv = Canvas { data: [], w: 4 };       // Set struct literal
//     for k in 0..5 { cv.data += [p.tag]; } // Mutate cv.data — NOT a Set on cv
//     cv
//   }
//
// This is the `alloc_canvas` shape — the pattern used inside lib code.
// The only Set on cv is the initial struct literal.  The for-loop appends
// to cv.data via `+=`, which is field-mutation, not Set-on-cv.
//
// Penultimate is the for-loop, so S1 doesn't fire.  The first Set's RHS
// is a struct literal (not Call), so S2 doesn't fire either.  Pre-Set
// FreeRef on cv: depends on whether the gate's `depend().is_empty()`
// check matches.
//
// Expected: PASS on both backends (this is the alloc_canvas shape — works
// today).  If FAIL, alloc_canvas itself would be broken, and the gridmesh
// tests would already fail.

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn render_loop_mutate(p: P) -> Canvas {
  cv = Canvas { data: [], w: 4 };
  for _k in 0..5 { cv.data += [p.tag]; }
  cv
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv = render_loop_mutate(p);
    assert(cv.w == 4, "iter {i}: w = {cv.w}");
    assert(len(cv.data) == 5, "iter {i}: len = {len(cv.data)}");
    assert(cv.data[0] == i, "iter {i}: data[0] = {cv.data[0]}");
  }
  println("probe 10 PASSED");
}
