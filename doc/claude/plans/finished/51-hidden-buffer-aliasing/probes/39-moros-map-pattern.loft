// Probe 39 — moros_map's map_get_hex deep-slice borrow pattern.
//
// Real-library pattern extracted from
// `lib/moros_map/src/moros_map.loft:125` and `types.loft:36-41`.
// Self-contained — no lib dependencies.
//
// Shape:
//   fn map_get_hex(m: Map, q, r, cy) -> Hex {
//     ...
//     for gh_c in m.m_chunks {
//       if gh_c.ck_cx == cx && ... {
//         if idx >= 0 && idx < len(gh_c.ck_hexes) {
//           return gh_c.ck_hexes[idx];   // <-- DEEP-SLICE BORROW
//         }
//       }
//     }
//     Hex {}    // fallback default
//   }
//
// Distinguishing features:
// - Map is `vector<Chunk>` (not the simpler probe 12 Container)
// - Chunk is a NESTED struct with its own `vector<Hex>` field
// - The return is `chunk.ck_hexes[idx]` — TWO LEVELS DEEP from the param m
// - Iterator-based access (`for gh_c in m.m_chunks`) — different IR than indexing
// - Fallback `Hex {}` default in the else-arm
//
// This shape was cited in the original @P377 history as the underlying
// mechanism the adopt-path-fix CRASHED on (8 moros_* library tests).
// Probe 12 used a simpler Container (single-level vector); this captures
// the actual two-level nesting.

struct Hex {
  h_height:        integer,
  h_material:      integer,
  h_item:          integer,
  h_item_rotation: integer,
  h_wall_n:        integer,
  h_wall_ne:       integer,
  h_wall_se:       integer,
}

struct Chunk {
  ck_cx:    integer,
  ck_cy:    integer,
  ck_cz:    integer,
  ck_hexes: vector<Hex>,
}

struct Map {
  m_name:   text,
  m_chunks: vector<Chunk>,
}

fn make_hex(height: integer, material: integer) -> Hex {
  Hex {
    h_height: height,
    h_material: material,
    h_item: 0,
    h_item_rotation: 0,
    h_wall_n: 0,
    h_wall_ne: 0,
    h_wall_se: 0,
  }
}

fn make_chunk(cx: integer, cy: integer, cz: integer, count: integer) -> Chunk {
  hexes: vector<Hex> = [];
  for i in 0..count {
    hexes += [make_hex(i + cx, i + cy)];
  }
  Chunk { ck_cx: cx, ck_cy: cy, ck_cz: cz, ck_hexes: hexes }
}

// Iterator-based deep-slice return (mirrors map_get_hex exactly).
fn map_get_hex(m: Map, target_cx: integer, target_cy: integer, target_cz: integer, idx: integer) -> Hex {
  for gh_c in m.m_chunks {
    if gh_c.ck_cx == target_cx && gh_c.ck_cy == target_cy && gh_c.ck_cz == target_cz {
      if idx >= 0 && idx < len(gh_c.ck_hexes) {
        return gh_c.ck_hexes[idx];
      }
    }
  }
  make_hex(0, 0)
}

fn main() {
  for i in 0..6 {
    chunks: vector<Chunk> = [];
    chunks += [make_chunk(0, 0, 0, 4)];
    chunks += [make_chunk(1, 0, 0, 4)];
    chunks += [make_chunk(0, 0, 1, 4)];
    m = Map { m_name: "test", m_chunks: chunks };

    // Query the FIRST chunk's third hex.  Expected: height = 2 + 0 = 2, material = 2 + 0 = 2.
    h0 = map_get_hex(m, 0, 0, 0, 2);
    assert(h0.h_height == 2, "iter {i}: h0.height = {h0.h_height} (expect 2)");
    assert(h0.h_material == 2, "iter {i}: h0.material = {h0.h_material}");

    // Query the SECOND chunk's first hex.  Expected: height = 0 + 1 = 1, material = 0 + 0 = 0.
    h1 = map_get_hex(m, 1, 0, 0, 0);
    assert(h1.h_height == 1, "iter {i}: h1.height = {h1.h_height} (expect 1)");

    // Query out-of-bounds (idx too high) → fallback Hex {}.
    hb = map_get_hex(m, 0, 0, 0, 999);
    assert(hb.h_height == 0, "iter {i}: hb.height = {hb.h_height} (expect 0 fallback)");

    // Query non-existent chunk → fallback.
    hn = map_get_hex(m, 99, 99, 99, 0);
    assert(hn.h_height == 0, "iter {i}: hn.height = {hn.h_height}");
  }
  println("probe 39 PASSED");
}
