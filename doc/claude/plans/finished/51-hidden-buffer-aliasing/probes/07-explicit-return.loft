// Probe 07 — explicit `return cv` form (vs. implicit tail).
//
//   fn render_explicit(p: P) -> Canvas {
//     cv = alloc_canvas(4, 5, p.tag);
//     return cv;
//   }
//
// S1's `tail_var` unwraps `Value::Return(Var(cv))` and treats it identically
// to a bare `Var(cv)` tail.  Expected to be equivalent to probe 01.
//
// Expected: PASS on both backends.
// Tests: does S1 correctly handle the Return-wrapped tail?

struct P { tag: integer }
struct Canvas { data: vector<integer>, w: integer }

fn alloc_canvas(w: integer, h: integer, fill: integer) -> Canvas {
  cv = Canvas { data: [], w: w };
  for _i in 0..h { cv.data += [fill]; }
  cv
}

fn render_explicit(p: P) -> Canvas {
  cv = alloc_canvas(4, 5, p.tag);
  return cv;
}

fn main() {
  for i in 0..6 {
    p = P { tag: i };
    cv = render_explicit(p);
    assert(cv.w == 4, "iter {i}: w = {cv.w}");
    assert(len(cv.data) == 5, "iter {i}: len = {len(cv.data)}");
    assert(cv.data[0] == i, "iter {i}: data[0] = {cv.data[0]}");
  }
  println("probe 07 PASSED");
}
