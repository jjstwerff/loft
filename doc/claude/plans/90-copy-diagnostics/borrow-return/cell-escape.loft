struct E { hp: integer, name: text }
enum Cell { Empty, Filled { items: vector<E> } }
fn g(e: Cell) -> vector<E> { match e { Filled { items } => { items }, _ => { [] } } }
fn h(c: Cell) -> vector<E> { g(c) }
fn main(){ ti: vector<E>=[]; for k in 0..3 { ti+=[E{hp:k,name:"t"}]; } c=Filled{items:ti}; a=h(c); assert(len(a)==3,"escape"); println("escape ok"); }
