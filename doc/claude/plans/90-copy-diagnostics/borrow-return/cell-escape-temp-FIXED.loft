// A1b — the WORKING form (the target). h binds the borrow to a local, then explicitly
// copies it into an owned buffer before returning. The owned copy is independent of the
// local Filled, so it survives the local being freed at h's scope end.
struct E { hp: integer not null, name: text }
enum Cell { Empty, Filled { items: vector<E> } }
fn g(e: Cell) -> vector<E> { match e { Filled { items } => { items }, _ => { [] } } }
fn h(seed: integer) -> vector<E> {
  inner: vector<E> = [];
  for k in 0..3 { inner += [E{hp: seed + k, name: "e"}]; }
  c = Filled { items: inner };
  r = g(c);
  out: vector<E> = [];
  out += r;
  out
}
fn main() {
  a = h(10);
  assert(len(a) == 3 && a[0].hp == 10 && a[2].hp == 12, "escape-temp");
  j: vector<E> = []; for q in 0..20 { j += [E{hp: q, name: "x"}]; }
  assert(a[0].hp == 10, "escape-temp after churn: a corrupted (UAF)");
  println("ok");
}
