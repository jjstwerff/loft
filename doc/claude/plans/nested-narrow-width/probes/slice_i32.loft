//! expect: 2:300003,400004|500005,600006
fn main() {
  v: vector<vector<i32>> = [[100001, 200002], [300003, 400004], [500005, 600006]];
  s = v[1..3];
  o = "";
  for i in 0..len(s) { if i > 0 { o += "|"; } row = s[i] ?? []; for j in 0..len(row) { if j > 0 { o += ","; } o += "{row[j] ?? 0}"; } }
  println("{len(s)}:{o}");
}
