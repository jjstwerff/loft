//! expect: 2:5,6,7,8|9,10,11,12
fn mk() -> vector<vector<u8>> {
  o: vector<vector<u8>> = [];
  for i in 0..3 { r: vector<u8> = []; for j in 0..4 { r += [ (((i * 4) + j + 1) & 255) as u8 ]; } o += [ r ]; }
  return o;
}
fn main() {
  v = mk();
  s = v[1..3];
  o = "";
  for i in 0..len(s) { if i > 0 { o += "|"; } row = s[i] ?? []; for j in 0..len(row) { if j > 0 { o += ","; } o += "{row[j] ?? 0}"; } }
  println("{len(s)}:{o}");
}
