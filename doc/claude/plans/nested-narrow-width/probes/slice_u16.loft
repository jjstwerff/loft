//! expect: 2:3003,4004|5005,6006
fn main() {
  v: vector<vector<u16>> = [[1001, 2002], [3003, 4004], [5005, 6006]];
  s = v[1..3];
  o = "";
  for i in 0..len(s) { if i > 0 { o += "|"; } row = s[i] ?? []; for j in 0..len(row) { if j > 0 { o += ","; } o += "{row[j] ?? 0}"; } }
  println("{len(s)}:{o}");
}
