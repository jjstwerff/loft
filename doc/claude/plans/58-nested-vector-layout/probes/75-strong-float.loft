// @PLAN58 STRONG probe — float (8-byte): distinct non-trivial values, all indices.
fn main() {
  vv: vector<vector<float>> = [[1.125, 2.250, 3.375], [4.5]];
  assert(len(vv[0]) == 3 && len(vv[1]) == 1, "lens");
  assert(vv[0][0] == 1.125 && vv[0][1] == 2.250 && vv[0][2] == 3.375, "row0 {vv[0]}");
  assert(vv[1][0] == 4.5, "row1 {vv[1]}");
  println("PASSED 75-strong-float");
}
