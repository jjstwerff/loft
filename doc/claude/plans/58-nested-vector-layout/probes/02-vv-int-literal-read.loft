// @PLAN58 probe 02 — vector<vector<integer>> literal + nested read.
// Cluster: stride.  Element handle is 4 bytes; construction prealloc=16,
// read=8 today.  --vec4 should align both to 4.
fn main() {
  vv: vector<vector<integer>> = [[1, 2], [3, 4], [5]];
  assert(vv[0][0] == 1 && vv[0][1] == 2, "row0: {vv[0]}");
  assert(vv[1][0] == 3 && vv[1][1] == 4, "row1: {vv[1]}");
  assert(vv[2][0] == 5, "row2: {vv[2]}");
  println("probe 02 PASSED");
}
