// @PLN94 Phase 1.3 — loop shapes the position-proxy cannot express, for the reaching-defs
// fixpoint. Dump + inspect convergence (SI-3) and loop-carried defs with:
//   LOFT_NO_CACHE=1 LOFT_OWN_ORACLE=rd loft --interpret 02-loops-rd.loft 2>&1 >/dev/null
// Verified 2026-07-07: breakout converges in 5 passes, nested in 7 (both <= n+2); the
// break-out header sees `s` from BOTH the initial store and the body (loop-carried), and the
// exit sees both (the loop may not run). The parser-free equivalents are asserted as Rust
// unit tests in src/ownership_cfg.rs (mod tests).

// break-out: a user `break` in addition to the for-exit test — two breaks target the loop.
fn breakout(n: integer) -> integer {
  s = 0;
  for i in 0..n { if i == 3 { break; } s = s + i; }
  s
}

// nested loop: inner break(0) targets the inner loop; outer break(0) the outer.
fn nested(n: integer) -> integer {
  s = 0;
  for i in 0..n { for j in 0..n { s = s + 1; } }
  s
}

fn main() { print("{breakout(10)} {nested(3)}\n"); }
