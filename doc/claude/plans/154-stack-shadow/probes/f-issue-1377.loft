//
// loft#1377 — the collection-typed twin of loft#1373: the element view is a vector.
//
fn main() {
  w: vector<vector<integer>> = [[1, 2, 3]];
  b = w[0];
  for i in 0..200 { w += [[i]]; }
  println("len={len(b)}");
}
