//
// loft#1384 — the same view, one level in: an element of a struct FIELD's vector.
//
struct S { n: integer }
struct W { a: vector<S>, b: vector<S> }
fn main() {
  w = W { a: [S { n: 1 }], b: [] };
  e = w.a[0];
  for i in 0..200 { w.a += [S { n: i }]; }
  println("e={e.n}");
}
