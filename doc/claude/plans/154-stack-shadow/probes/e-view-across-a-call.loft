// The view is handed DOWN a call and read there — the case a top-frame-only scan would miss.
struct S { n: integer }
fn show(d: S) -> integer { d.n }
fn main() {
  v: vector<S> = [S { n: 1 }];
  d: S = v[0];
  for i in 0..200 { v += [S { n: i + 10 }]; }
  println("d={show(d)}");
}
