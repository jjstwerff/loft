// The view is re-bound after every growth, so its tag is rewritten: silent.
struct S { n: integer }
fn main() {
  v: vector<S> = [S { n: 1 }];
  d: S = v[0];
  for i in 0..200 { v += [S { n: i + 10 }]; d = v[0]; }
  println("d={d.n}");
}
