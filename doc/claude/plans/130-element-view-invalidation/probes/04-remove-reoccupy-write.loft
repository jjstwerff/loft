// @PLN130 probe 04 — the severe form: the stale index is RE-OCCUPIED by a live element.
//
// CONTRACT CHANGED (F2, option 2 — signed off).  This was the worst cell in the plan: after
// `remove(0)` then an append, the view's stale index named a DIFFERENT live element, and the
// write tore it — `e2` read `99/444`, n from the stray write and tag from the real element,
// while the intended target kept `33/333`.  Cross-element corruption, silent, both backends.
//
// With `boxes` reshaped while `c` is live, `c` is materialised at the bind and the author is
// told.  The write now lands in `c` alone: no torn record, no cross-element write, and the
// appended element is untouched.

struct Box { n: integer, tag: integer = 0 }

fn main() {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
  c = boxes[2];
  boxes.remove(0);
  boxes += [Box { n: 44, tag: 444 }];
  c.n = 99;
  assert(len(boxes) == 3, "04 len {len(boxes)} want 3");
  assert(boxes[0].n == 22 && boxes[0].tag == 222, "04 e0 {boxes[0].n}/{boxes[0].tag} want 22/222");
  assert(boxes[1].n == 33 && boxes[1].tag == 333, "04 e1 {boxes[1].n}/{boxes[1].tag} want 33/333");
  // The element that used to be torn is now intact.
  assert(boxes[2].n == 44 && boxes[2].tag == 444, "04 e2 {boxes[2].n}/{boxes[2].tag} want 44/444");
  assert(c.n == 99 && c.tag == 333, "04 c {c.n}/{c.tag} want 99/333");
  println("probe 04 PASSED — no torn record; the write stayed in the copy");
}
