// @PLN130 probe 17 — REFERENCE: a loop-carried reassignment that does NOT copy.
//
// `cur = make(i)` inside a loop is the shape that would cost most if it copied — one
// manifest site, one copy per iteration.  MEASURED: zero record copies, no manifest site.
// The callee returns a fresh store, so the binding adopts it.
//
// Written expecting five copies and measured none.  Together with probe 15 this bounds
// the class from the safe side: neither the lift, nor the loop, nor the reassignment is
// what makes a copy — the callee's return is (probes 18 and 19 are the same syntax with
// `file()` as the callee, and those DO copy).
//
// Keep this probe: if a future change to return-ownership makes adopt-fresh stricter,
// this is the case that silently becomes five copies per loop, and it will start failing
// the manifest expectation below.
//
// Expected: guard reports NO site for n_main; runtime record copies = 0.

struct Rec { tag: integer, name: text }

fn make(n: integer) -> Rec {
  Rec { tag: n, name: "row-{n}" }
}

fn main() {
  total = 0;
  cur = make(0);
  for i in 1..6 {
    cur = make(i);
    total = total + cur.tag;
  }
  assert(total == 15, "17 total {total} want 15");
  assert(cur.tag == 5, "17 cur.tag {cur.tag} want 5");
  println("probe 17 PASSED — loop-carried reassign, no copy (contrast probe 19)");
}
