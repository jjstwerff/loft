// @PLN130 probe 18 — SECRET COPY: the real-world instance, in the stdlib itself.
//
// `pub fn exists(path: text) -> boolean { file(path).format != Format.NotExists }`
// (default/02_files.loft:248).  Every call deep-copies the whole `File` record — 33 flat
// bytes PLUS a reallocated copy of the `path` text (`OpCopyRecord` duplicates owned
// sub-structures) — to read one enum field and drop it.
//
// Measured: 5 calls -> 5 executed record copies on BOTH backends.  The site is uncovered
// in EVERY compile that loads the stdlib (surveyed across all 583 tests/scripts: exactly
// one uncovered site per compile, always this one).
//
// This is the probe that says the class is not academic — it is on the hot path of every
// program that touches the filesystem.
//
// Guard: InterpReassignCall / NativeCallReturn on `n_exists` binding `__lift_1`.
// Keep this probe pointed at the STDLIB, not a local copy of the shape: probe 15 isolates
// the shape, this one pins the shipped instance so a fix has to actually reach it.

fn main() {
  hits = 0;
  for i in 0..5 {
    if exists("/etc/hostname") {
      hits = hits + 1;
    }
  }
  // The path exists on any Linux CI box; on a host where it does not, the count is 0 and
  // the copy still happened — the assertion below is about the copy being reachable, so
  // accept either total rather than making the probe host-dependent.
  assert(hits == 5 || hits == 0, "18 hits {hits} want 5 or 0");
  println("probe 18 PASSED — 5 File records copied to read one field each");
}
