// @PLN130 probe 32 — cluster II matrix: producer = a TUPLE element.
//
// `gen_set_first_ref_tuple_copy` exists in the interpreter, so a tuple destructure of a
// heap value has its own emission path — the question is whether the bound name is an
// owned copy or a view of whatever the tuple element pointed at.
//
// Hand-computed: `pick` returns the element whose n is 33 alongside its index.  If the
// destructured binding is a COPY, writing through it leaves the container alone and a
// later removal cannot affect it.  If it is a VIEW, the write must follow the element to
// index 1 after `remove(0)`.  Either rule is self-consistent; what must not happen is the
// write landing on a third element or vanishing.

struct Box { n: integer, tag: integer = 0 }

fn pick(v: vector<Box>) -> (Box, integer) {
  (v[2], 2)
}

fn main() {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];

  (chosen, idx) = pick(boxes);
  assert(idx == 2, "32 idx {idx} want 2");
  assert(chosen.n == 33 && chosen.tag == 333, "32 chosen {chosen.n}/{chosen.tag} want 33/333");

  chosen.n = 99;
  copied = boxes[2].n == 33;        // true => the tuple bind copied

  boxes.remove(0);                  // the n=33 element is now index 1
  assert(len(boxes) == 2, "32 len {len(boxes)} want 2");
  assert(boxes[0].n == 22, "32 e0 {boxes[0].n} want 22");
  if copied {
    assert(boxes[1].n == 33, "32 e1 {boxes[1].n} want 33 (tuple bind copied)");
    assert(chosen.n == 99, "32 chosen {chosen.n} want 99 (independent copy)");
  } else {
    assert(boxes[1].n == 99, "32 e1 {boxes[1].n} want 99 (tuple bind aliased)");
  }
  if copied {
    println("probe 32 PASSED — the tuple element bind COPIES");
  }
  if !copied {
    println("probe 32 PASSED — the tuple element bind is a VIEW");
  }
}
