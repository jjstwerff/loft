struct Box { n: integer, tag: integer = 0 }
fn shift_plain(target: Box, all: &vector<Box>) { all.remove(0); target.n = 99; }
fn main() {
  v = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
  shift_plain(v[2], v);
  v += [Box { n: 44, tag: 444 }];
  print("X15 {v[2].n} {v[2].tag} {len(v)}\n");
}
