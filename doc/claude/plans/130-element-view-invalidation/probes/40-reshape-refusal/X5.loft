struct Box { n: integer, tag: integer = 0 }
fn shift(target: &Box, all: &vector<Box>) { all.remove(0); target.n = 99; }
fn main() {
  v = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
  w = [Box { n: 44, tag: 444 }, Box { n: 55, tag: 555 }];
  shift(w[1], v);
  print("X5 {w[1].n} {len(v)} {len(w)}\n");
}
