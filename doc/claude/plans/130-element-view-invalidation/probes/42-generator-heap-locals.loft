// @PLN130 probe 42 — the native coroutine boundary, found by MEASURING a residual.
//
// @PLN130 closed with three residuals routed to QUALITY.md.  One read "Unmeasured, not
// known-broken … the fix is a compile-time dep strip with no thread-local state, so there is
// no specific reason to expect divergence — but nobody has run it."  Running it found that
// `--native` could not compile ANY generator holding a heap local, and separately dropped
// every statement after the last `yield`.  Both pre-existing on `main`.
//
// "No specific reason to expect divergence" is not a measurement.  That is the probe's point,
// and the reason it lives in this plan rather than only in the test suite.
//
// Axes, moved together:
//   A  the KIND of local            — scalar / text (already worked) vs struct / vector / keyed
//   B  how it is PRODUCED           — a literal vs a call's return (different emitters)
//   C  whether it is RE-ESTABLISHED — bound once / reassigned / mutated through / appended
//   D  how far the generator is DRIVEN — two `next`s vs exhaustion (the tail only runs at the end)
//
// Four faults separated by those axes, each with its own chokepoint:
//   1  E0425 — a heap local `let`-bound inside one match arm, read from another (A)
//   2  E0308 — the declaration `Set(v, Null)` emitted `()` where a DbRef was expected (A+B)
//   3  a keyed local panicked in keys::mut_store with store_nr 65535: its store is allocated
//      BY the declaration, so a field left at DbRef::NULL was inserted into (A)
//   4  the TAIL was never emitted, so post-yield side effects vanished and every scope-exit
//      free was skipped — a dropped side effect, not merely a leak (D)
//
// Run with LOFT_STRICT_STORES=1: three cells leaked after fault 4 was fixed, and each had its
// own cause (a displaced store the persisted-field path excluded from the free; `null_named`
// pre-declaration allocating a store per resume; a `__vdb_*` backing store re-declared per
// resume so the tail freed a fresh null).  A cell that merely PASSES is not evidence here.
//
// CI form: tests/scripts/776-generator-heap-locals.loft.

struct P { n: integer, tag: integer = 0 }
struct Holder { v: vector<P>, m: integer = 0 }
struct Elm { key: integer, tag: integer = 0 }

fn mk(x: integer) -> P { return P { n: x, tag: x * 10 }; }

fn ok(name: text, got: integer, want: integer) {
  if got == want { print("42 {name}  {got}  want {want}   ok\n"); }
  if got != want { print("42 {name}  {got}  want {want}   BROKEN\n"); }
}

// A — bound once, never re-established.  The minimal shape; it needs no reassignment.
fn only_bound() -> iterator<integer> { s = P { n: 11, tag: 111 }; yield s.n; yield s.tag; }
// B — produced by a CALL (return buffer / NRVO), and re-established.
fn from_a_call() -> iterator<integer> { s = mk(11); yield s.n; s = mk(22); yield s.tag; }
// A+C — a vector literal, reassigned: two backing stores, one displaced.
fn vector_local() -> iterator<integer> { v = [11, 12, 13]; yield v[0]; v = [22, 23]; yield v[1]; }
// A+C — a vector of structs, APPENDED to rather than replaced.
fn vec_of_structs() -> iterator<integer> { v = [P { n: 11 }]; yield v[0].n; v += [P { n: 22 }]; yield v[1].n; }
// A — a keyed collection: its store is allocated BY the declaration, not by an IR op.
fn keyed_local() -> iterator<integer> {
  s: sorted<Elm[key]> = [Elm { key: 10, tag: 111 }];
  yield s[10].tag;
  s += [Elm { key: 30, tag: 333 }];
  yield s[30].tag;
}
// A — a nested chain, which must survive the suspension whole.
fn nested_holder() -> iterator<integer> { h = Holder { v: [P { n: 11 }, P { n: 22 }], m: 7 }; yield h.v[1].n; yield h.m; }
// A — two heap locals live at once, so no fix can be "the one local".
fn two_locals() -> iterator<integer> { a = P { n: 11 }; b = P { n: 22 }; yield a.n; yield b.n; }
// C — mutated THROUGH rather than replaced.
fn mutated() -> iterator<integer> { s = P { n: 11 }; yield s.n; s.n = 22; yield s.n; }
// D — a side effect after the last yield.  Silently dropped on native before this fix.
fn with_a_tail() -> iterator<integer> { yield 1; yield 2; print("42 tail ran\n"); }

fn drive(g: iterator<integer>, name: text, w1: integer, w2: integer) {
  a = next(g) ?? -1;
  b = next(g) ?? -1;
  done = next(g) ?? -1;          // D — exhaust, so the tail state runs
  ok(name, a * 1000 + b, w1 * 1000 + w2);
  ok("{name} exhausted", done, -1);
}

fn main() {
  drive(only_bound(), "only_bound  ", 11, 111);
  drive(from_a_call(), "from_a_call ", 11, 220);
  drive(vector_local(), "vector_local", 11, 23);
  drive(vec_of_structs(), "vec_structs ", 11, 22);
  drive(keyed_local(), "keyed_local ", 111, 333);
  drive(nested_holder(), "nested      ", 22, 7);
  drive(two_locals(), "two_locals  ", 11, 22);
  drive(mutated(), "mutated     ", 11, 22);
  drive(with_a_tail(), "with_a_tail ", 1, 2);
}
