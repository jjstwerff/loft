// @PLN130 probe 25 — cluster II matrix: producer = a `for` loop VAR captured out of the loop.
// REFERENCE — this producer does NOT mint an index-pinned view.
//
// Capturing the loop variable into an owned local COPIES the element: writing through the
// capture leaves the container's element alone, on both backends.  So a removal afterwards
// cannot invalidate it, and this producer is safe.
//
// Written expecting a view and measured a copy — the useful direction.  It also bounds the
// class: `v[i]` and `v[i].f` alias (probes 03-06) while a captured loop var does not, so
// "reading out of a container" is not one rule.
//
// NOTE: the first version of this probe initialised the capture from `a[0]` — a VIEW of the
// same container — and measured `len 0` after the loop.  That is a DIFFERENT and much worse
// bug, split out to probe 30; it was masking the case this probe means to test.

struct Box { n: integer, tag: integer = 0 }

fn main() {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];

  keep = Box { n: 0 };             // owned init — see the note above
  for b in boxes {
    if b.n == 33 {
      keep = b;
    }
  }
  assert(keep.n == 33 && keep.tag == 333, "25 keep {keep.n}/{keep.tag} want 33/333");

  keep.n = 99;                     // the capture is a COPY: the element must be untouched
  assert(boxes[2].n == 33, "25 boxes[2].n {boxes[2].n} want 33 (capture must be a copy)");

  boxes.remove(0);                 // and the removal cannot reach it
  assert(len(boxes) == 2, "25 len {len(boxes)} want 2");
  assert(keep.n == 99 && keep.tag == 333, "25 after remove keep {keep.n}/{keep.tag} want 99/333");
  assert(boxes[1].n == 33, "25 e1 {boxes[1].n} want 33");
  println("probe 25 PASSED — a captured loop var is a copy, not an index-pinned view");
}
