// @PLN130 probe 15 — REFERENCE: an expression temp that does NOT copy.
//
// `make(i).tag` lifts the call result into a compiler-generated temp, reads ONE field and
// drops it — syntactically identical to the stdlib's `file(path).format` in `exists()`
// (default/02_files.loft:248).  MEASURED: zero record copies, no manifest site.
//
// This probe was written expecting a copy and measured none.  That result is the point:
// the stdlib shape copies (probe 18, 5 calls -> 5 copies) and this one does not, so the
// copy is a property of the CALLEE's return, not of the lift or the field read.  A fix
// aimed at "expression temps" would therefore be aimed at the wrong thing.
//
// `make()` returns a struct literal; `file()` returns after `OpGetFile` mutates a local.
// Both report `return=Owned` in the ownership dump, so that fact does not discriminate
// them either — what does is @PLN130 Q5, still open.
//
// Expected: guard reports NO site for n_main; runtime record copies = 0.

struct Rec { tag: integer, name: text }

fn make(n: integer) -> Rec {
  Rec { tag: n, name: "payload-{n}" }
}

fn main() {
  hits = 0;
  for i in 0..3 {
    if make(i).tag == i {
      hits = hits + 1;
    }
  }
  assert(hits == 3, "15 hits {hits} want 3");
  println("probe 15 PASSED — expression temp, no copy (contrast probe 18)");
}
