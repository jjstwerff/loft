// @PLN130 probe 16 — SECRET COPY: reassignment between two live bindings.
//
// `b = a` where `b` ALREADY holds a record takes a different emitter from the first bind
// (probe 10) — `#306`'s reassignment path.  Instrumenting only the first-bind emitters
// left this one off the manifest entirely, which is how it stayed secret.
//
// Guard: InterpReassignVar on `b`.
// The copy is real and provable by value: the two names stay independent afterwards.

struct P { x: integer, y: integer }

fn main() {
  a = P { x: 1, y: 2 };
  b = P { x: 3, y: 4 };
  b = a;                 // reassignment, not a first bind
  b.x = 99;
  a.x = 55;
  assert(a.x == 55, "16 a.x {a.x} want 55");
  assert(b.x == 99, "16 b.x {b.x} want 99");
  assert(a.y == 2 && b.y == 2, "16 y {a.y}/{b.y} want 2/2");
  println("probe 16 PASSED — reassignment deep-copied, reported by nothing");
}
