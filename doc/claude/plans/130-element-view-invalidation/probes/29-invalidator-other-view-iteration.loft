// @PLN130 probe 29 — invalidator = removal during iteration of a DIFFERENT view.
//
// CONTRACT CHANGED (F2, option 2 — signed off).  Two live views of one container, one of
// them doing the reshaping: `held` was taken before the loop and the loop `#remove`d from
// under it, so its write went to a stale position and vanished.
//
// `boxes` is reshaped while `held` is live, so `held` materialises and the author is told.

struct Box { n: integer, tag: integer = 0 }

fn main() {
  boxes = [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 },
           Box { n: 33, tag: 333 }, Box { n: 44, tag: 444 }];
  held = boxes[3];

  for b in boxes {
    if b.n < 30 {
      b#remove;
    }
  }

  assert(len(boxes) == 2, "29 len {len(boxes)} want 2");
  held.n = 99;
  assert(boxes[0].n == 33 && boxes[0].tag == 333, "29 e0 {boxes[0].n}/{boxes[0].tag} want 33/333");
  assert(boxes[1].n == 44 && boxes[1].tag == 444, "29 e1 {boxes[1].n}/{boxes[1].tag} want 44/444");
  assert(held.n == 99 && held.tag == 444, "29 held {held.n}/{held.tag} want 99/444");
  println("probe 29 PASSED — the held view materialised; the container is intact");
}
