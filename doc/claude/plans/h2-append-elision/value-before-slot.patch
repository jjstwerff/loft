 impl Parser {
+    /// H2 — is this call handed a caller-owned `__ref_N` / `__rref_N` work-ref?
+    ///
+    /// That is the ONLY shape whose result can alias a buffer the caller still owns and
+    /// REUSES: an NRVO callee writes into the passed buffer and returns the same `DbRef`.
+    /// Appending it directly is what makes the element slot outlive its store across
+    /// iterations.  A call that allocates fresh has no such arg and keeps the existing
+    /// lowering — which matters, because the append-of-a-CALL shape is load-bearing for
+    /// the ownership analysis (`AppendSource`), so widening the hoist to every
+    /// struct-returning call rewrites far more producers than the defect touches.
+    fn call_takes_work_ref(val: &Value, vars: &crate::variables::Function) -> bool {
+        let inner = match val.unspan() {
+            Value::Insert(ops) => match ops.last() {
+                Some(last) => last.unspan(),
+                None => return false,
+            },
+            other => other,
+        };
+        let Value::Call(_, args) = inner else {
+            return false;
+        };
+        args.iter().any(|a| {
+            let v = match a.unspan() {
+                Value::Var(v) | Value::Set(v, _) => *v,
+                _ => return false,
+            };
+            let n = vars.name(v);
+            n.starts_with("__ref_") || n.starts_with("__rref_")
+        })
+    }
