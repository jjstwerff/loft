// @H2 blocker — first-assignment join-binding axis.  See run-join.sh for the axis and
// the hand-computed expectation; every cell is a FIRST Set of an owned ref from a call.
// The struct-enum spelling of j1: a heap record exactly like a struct ref, so it needs
// the same guard.  Expect `-1 -1 -1`, len=3, no leak.
struct M { hp: integer, name: text }
fn m_none() -> M { M{ hp: -1, name: "none" } }
fn seed() -> vector<M> { t: vector<M> = []; t += [M{hp:1, name:"a"}]; t += [M{hp:2, name:"b"}]; t += [M{hp:3, name:"c"}]; t }
fn show(out: vector<M>) { for j in 0..len(out) { e = out[j] ?? m_none(); print("{e.hp} "); } print("\n"); n = len(out); print("len={n}\n"); }
fn pick(t: vector<M>, i: integer) -> M { t[i] ?? m_none() }
enum Slot { Empty { hp: integer }, Full { hp: integer, name: text } }
fn s_none() -> Slot { Empty{ hp: -1 } }
fn seed_s() -> vector<Slot> { v: vector<Slot> = []; v += [Full{hp:1, name:"a"}]; v += [Full{hp:2, name:"b"}]; v += [Full{hp:3, name:"c"}]; v }
fn pick_s(v: vector<Slot>, i: integer) -> Slot { v[i] ?? s_none() }
fn show_s(out: vector<Slot>) { for j in 0..len(out) { e = out[j] ?? s_none(); print("{e.hp} "); } print("\n"); n = len(out); print("len={n}\n"); }
fn main() { v = seed_s(); out: vector<Slot> = []; for i in 0..3 { e = pick_s(v, i + 100); out += [e]; } show_s(out); }
