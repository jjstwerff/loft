//
// @PLN110 3a — the TEXT strict-index units lint corpus (DEFAULT ON, opt-out
// LOFT_NO_STRICT_INDEX_TEXT).  `len(text)` is a character count while `text[i]`
// is byte-indexed, so `for i in 0..len(s) { s[i] }` walks char-count byte
// positions and misreads multi-byte text.  Each function is FIRE (must warn) or
// OK (silent).  The oracle is tests/strict_index_text_lint.rs.

// FIRE: a loop var bounded by len(s) indexing that same text s (`s[i]` on line 15 warns).
fn fire_len_text_byte_index() {
  s = "café";
  hits = 0;
  for i in 0..len(s) {
    if s[i] == 'é' { hits += 1; }
  }
  assert(hits >= 0, "runs (advisory lint, not an error)");
}

// OK: character iteration — the correct way to visit characters.
fn ok_char_iteration() {
  s = "café";
  n = 0;
  for c in s {
    if c == 'é' { n += 1; }
  }
  assert(n == 1, "one é");
}

// OK: a genuine byte walk uses size(s) (byte count), here via byte_at.
fn ok_byte_walk_with_size() {
  s = "café";
  lead = 0;
  for i in 0..size(s) {
    if s.byte_at(i) == 195 { lead += 1; }
  }
  assert(lead == 1, "one é lead byte");
}

// OK: indexing a vector bounded by len(vector) — unaffected (this lint is text-only).
fn ok_vector_index() {
  v = [10, 20, 30];
  total = 0;
  for i in 0..len(v) { total += v[i]; }
  assert(total == 60, "vector sum");
}

// FIRE: the same units error read through `byte_at` instead of `s[i]` — `len(s)`
// bounds a BYTE read.  This is the form the published cbor encoder shipped.
fn fire_len_byte_at_inline() {
  s = "café";
  lead = 0;
  for i in 0..len(s) {
    if s.byte_at(i) == 195 { lead += 1; }
  }
  assert(lead >= 0, "runs (advisory lint, not an error)");
}

// FIRE: the bound held in a LOCAL first — `n = len(s); for i in 0..n`.  Exactly the
// cbor shape: it truncates by one byte per multi-byte character, silently.
fn fire_len_byte_at_via_local() {
  s = "café";
  n = len(s);
  lead = 0;
  for i in 0..n {
    if s.byte_at(i) == 195 { lead += 1; }
  }
  assert(lead >= 0, "runs (advisory lint, not an error)");
}

// OK: bounded by len(s) but reading a DIFFERENT text — not this lint's shape.
fn ok_byte_at_other_text() {
  s = "café";
  t = "abcdefgh";
  total = 0;
  for i in 0..len(s) { total += t.byte_at(i); }
  assert(total > 0, "reads t, not s");
}

// OK: the local no longer holds len(s) by the time the loop reads it, so the bound
// is unknown — an advisory lint must stay silent rather than guess.
fn ok_byte_at_local_reassigned() {
  s = "café";
  n = len(s);
  n = n - 1;
  total = 0;
  for i in 0..n { total += s.byte_at(i); }
  assert(total > 0, "unknown bound, no warning");
}

fn main() {
  fire_len_text_byte_index();
  ok_char_iteration();
  ok_byte_walk_with_size();
  ok_vector_index();
  fire_len_byte_at_inline();
  fire_len_byte_at_via_local();
  ok_byte_at_other_text();
  ok_byte_at_local_reassigned();
}
