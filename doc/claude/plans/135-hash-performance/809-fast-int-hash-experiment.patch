+/// EXPERIMENT (loft#809): `LOFT_FAST_INT_HASH=1` routes a single-integer key
+/// through `int_hash` instead of SipHash, so the end-to-end win can be measured.
+fn fast_int_hash_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("LOFT_FAST_INT_HASH").as_deref() == Ok("1"))
+}
+
+/// Does `type_nr` name a key that reconstructs as `Content::Long`?  The single
+/// place that answers it, so the record side (`hash`) and the lookup side
+/// (`key_hash`) cannot drift into hashing the same key two different ways.
+/// Mirrors `get_key`: 3/4 are Single/Float, 6 is Str, everything else is a Long.
+#[inline]
+fn is_long_key(type_nr: i8) -> bool {
+    !matches!(type_nr.abs(), 3 | 4 | 6)
+}
+
+/// Read a single integer key's `i64` view — exactly the value `hash_ref` feeds
+/// the hasher and `get_key` rebuilds as `Content::Long`.
+#[inline]
+fn long_key_value(r: &DbRef, stores: &[Store], key: &Key, p: u32) -> i64 {
+    let s = store(r, stores);
+    match key.type_nr.abs() {
+        1 => s.get_int(r.rec, p),
+        2 => s.get_long(r.rec, p),
+        8 => i64::from(s.get_i32_raw(r.rec, p)),
+        9 => i64::from(s.get_short(r.rec, p, 0)),
+        11 => {
+            let raw: u16 = *s.addr(r.rec, p);
+            i64::from(raw as i16)
+        }
+        _ => i64::from(s.get_byte(r.rec, p, 0)),
+    }
+}
