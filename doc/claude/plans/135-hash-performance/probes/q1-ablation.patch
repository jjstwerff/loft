+/// Which random access a `LOFT_PROBE_HASH` run is measuring the ABSENCE of (@PLN135 Q1).
+///
+/// A cache-resident lookup costs ~36 ns and a 1M one ~83 ns; the ~50 ns between them is
+/// two random accesses, and which of the two carries it decides arc D against arc H —
+/// a persisted-store format break that can only be spent once.  Subtracting the modes
+/// gives the split: `Off − SkipRecord` is the record read, `SkipRecord − Floor` is the
+/// bucket read, and `Floor` is what is left when neither can miss.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum ProbeMode {
+    /// Normal lookup.
+    Off,
+    /// Read the bucket slot, then answer it WITHOUT reading the record to compare keys.
+    SkipRecord,
+    /// Read bucket 0 — the same cache line for every key — and skip the record too, so
+    /// what remains is the per-call work that cannot miss: the header, seed and hash.
+    Floor,
+}
+
+/// `LOFT_PROBE_HASH` = `skiprec` | `floor`; anything else (and unset) is [`ProbeMode::Off`].
+fn probe_mode() -> ProbeMode {
+    static MODE: std::sync::OnceLock<ProbeMode> = std::sync::OnceLock::new();
+    *MODE.get_or_init(|| match std::env::var("LOFT_PROBE_HASH").as_deref() {
+        Ok("skiprec") => ProbeMode::SkipRecord,
+        Ok("floor") => ProbeMode::Floor,
+        _ => ProbeMode::Off,
+    })
+}
