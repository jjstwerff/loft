// MINIMAL trigger (agent-confirmed, both backends): a 2-arm `match` whose every arm
// tail-calls a __retbuf fn (head), + a temp result coexisting with a live named one.
// #437 promotes only arm-1's work-ref onto the retbuf; arm-2's __ref_N is freed at fn
// exit -> dangling DbRef -> the next coexisting call reuses the freed store -> clobber.
// current interp -> ki=3 ; current native -> ki=99 ; loft2 (pre-#437) -> ki=1.
// Boundary control: drop CNull (single-arm match) -> PASSES (one buffer, nothing to mis-unify).
enum CV { CNull, CI { value: integer not null } }
fn head(major: integer, arg: integer) -> vector<u8> {
  buf: vector<u8> = []; buf += [(major * 32 + arg) as u8]; return buf;
}
fn byte_lt(a: vector<u8>, b: vector<u8>) -> boolean { return (a[0] ?? 0) < (b[0] ?? 0); }
fn encode(v: CV) -> vector<u8> {
  match v { CNull => head(7, 22), CI { value } => head(0, value) }   // 2-arm match = the trigger
}
fn main() {
  ki = encode(CI{value:1});                 // ki LIVE
  z = byte_lt(encode(CI{value:3}), ki);     // temp encode() coexists with ki
  println("ki={ki[0] ?? 99} (EXPECT 1)  z={z} (EXPECT false)");
}
