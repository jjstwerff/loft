// Cluster I-b: a match with a BLOCK-bodied arm (cbor's CBytes/CText/CArray shape:
// `{ buf = head(..); buf += ..; buf }`). The block arm forces the whole match to
// MATERIALIZE into a `result` var, so even the firing tail-call arm bypasses the 906
// raw-match recovery. The firing keys here are CI (tail-call arms), but CB's presence
// forces materialization. If ki clobbers -> this is the materialized-match shape cbor hits.
enum CV { CNull, CI { value: integer not null }, CB { value: vector<u8> } }
fn head(major: integer, arg: integer) -> vector<u8> {
  buf: vector<u8> = []; buf += [(major * 32 + arg) as u8]; return buf;
}
fn byte_lt(a: vector<u8>, b: vector<u8>) -> boolean { return (a[0] ?? 0) < (b[0] ?? 0); }
fn encode(v: CV) -> vector<u8> {
  match v {
    CNull => head(7, 22),
    CI { value } => head(0, value),
    CB { value } => { buf = head(2, len(value)); buf += value; buf },   // BLOCK arm -> materializes
  }
}
fn main() {
  ki = encode(CI{value:1});
  z = byte_lt(encode(CI{value:3}), ki);
  println("ki={ki[0] ?? 99} (EXPECT 1)  z={z} (EXPECT false)");
}
