enum CborValue {
  CNull, CBool { value: boolean }, CInt { value: integer not null },
  CBytes { value: vector<u8> }, CText { value: text },
  CArray { items: vector<CborValue> }, CMap { entries: vector<CborEntry> },
}
struct CborEntry { key: CborValue, value: CborValue }
fn head(major: integer, arg: integer) -> vector<u8> {
  buf: vector<u8> = [];
  if arg < 24 { buf += [(major * 32 + arg) as u8]; }
  else { buf += [(major * 32 + 24) as u8]; buf += [arg as u8]; }
  return buf;
}
fn byte_lt(a: vector<u8>, b: vector<u8>) -> boolean {
  na = len(a); nb = len(b);
  m = if na < nb { na } else { nb };
  for i in 0..m { if a[i] != b[i] { return a[i] < b[i]; } }
  return na < nb;
}
fn encode_map(entries: vector<CborEntry>) -> vector<u8> {
  n = len(entries);
  buf = head(5, n);
  for target in 0..n {
    for i in 0..n {
      ki = encode(entries[i].key);
      rank = 0;
      for j in 0..n { if j != i { if byte_lt(encode(entries[j].key), ki) { rank = rank + 1; } } }
      if rank == target { buf += ki; buf += encode(entries[i].value); }
    }
  }
  return buf;
}
fn encode(v: CborValue) -> vector<u8> {
  match v {
    CNull => head(7, 22),
    CBool { value } => head(7, if value { 21 } else { 20 }),
    CInt { value } => if value >= 0 { head(0, value) } else { head(1, 0 - value - 1) },
    CBytes { value } => { buf = head(2, len(value)); buf += value; buf },
    CText { value } => { n = len(value); buf = head(3, n); for i in 0..n { buf += [value.byte_at(i) as u8]; } buf },
    CArray { items } => { buf = head(4, len(items)); for i in 0..len(items) { buf += encode(items[i]); } buf },
    CMap { entries } => encode_map(entries),
  }
}
fn main() {
  m = CMap { entries: [ CborEntry { key: CInt{value:1}, value: CInt{value:2} }, CborEntry { key: CInt{value:3}, value: CInt{value:4} } ] };
  b = encode(m);
  s = "";
  for i in 0..len(b) { s += "{b[i] ?? 255} "; }
  println("len={len(b)} bytes=[ {s}]  (EXPECT len=5 [ 162 1 2 3 4 ])");
}
