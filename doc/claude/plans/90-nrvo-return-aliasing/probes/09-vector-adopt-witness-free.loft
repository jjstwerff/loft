// Cluster I-c (agent mini6): NOT a decode bug — an encode-side O-Move breach one level
// DOWN from I-a/I-b. `buf = head(...)` adopts head's ["??"]-NRVO buffer __ref_1, but the
// witness-pairing gate (scopes.rs:956) covers only Reference/Enum, not Type::Vector — so the
// epilogue emits a plain OpFreeRef(__ref_1) instead of OpFreeRefIfDistinct(__ref_1, buf),
// freeing the store `buf` aliases -> dangling -> a coexisting encode reuses it -> clobber.
// Surfaced by ztcbor's re-encode-a-decoded-map (cbor's roundtrip never hits CMap — coverage gap).
// current: a len=2 (BUG, interp AND --native); loft2 (pre-#437): a len=4 (correct).
enum Val { VInt { value: integer not null }, VMap { entries: vector<Ent> } }
struct Ent { k: integer, v: integer }

fn head(major: integer, arg: integer) -> vector<u8> {
  buf: vector<u8> = [];
  if arg < 24 { buf += [(major * 32 + arg) as u8]; }
  else { buf += [(major * 32 + 24) as u8]; buf += [arg as u8]; }
  return buf;
}
fn encode_map(entries: vector<Ent>) -> vector<u8> {
  n = len(entries);
  buf = head(5, n);
  for i in 0..n { buf += head(0, entries[i].k); buf += head(0, entries[i].v); }
  return buf;
}
fn encode(v: Val) -> vector<u8> {
  match v { VInt { value } => head(0, value), VMap { entries } => encode_map(entries) }
}
fn main() {
  c: vector<Ent> = []; c += [ Ent { k: 3, v: 42 } ];
  a = encode(VMap { entries: c });
  b = encode(VMap { entries: c });
  println("a len={len(a)}  b len={len(b)}  (EXPECT 3 and 3)");
}
