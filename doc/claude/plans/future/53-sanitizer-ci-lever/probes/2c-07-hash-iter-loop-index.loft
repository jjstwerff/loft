//
// PLAN53 cluster 2 / sub-cluster 2c — VARIANT (`c60_hash_iter_loop_attributes`).
//
// Uses the loop-index attribute `e#index` in the body.  Ascending key order
// a,b,c with values 1,2,3 gives 1*(0+1) + 2*(1+1) + 3*(2+1) = 1+4+9 = 14.
// The phantom leading element shifts every index by one and adds a spurious
// term, so aligned mode returns 20 instead of 14.
//
// Status aligned: CURRENTLY FAIL (20) ; AFTER 2c FIX -> PASS.  Flag-OFF: PASS.

struct Ent { k: text, v: integer }
struct Bag { data: hash<Ent[k]> }

fn main() {
  b = Bag { data: [Ent{k:"c",v:3}, Ent{k:"a",v:1}, Ent{k:"b",v:2}] };
  total = 0;
  for e in b.data { total = total + e.v * (e#index + 1); }
  assert(total == 14, "2c-07: got {total}, want 14");
  println("2c-07 PASSED");
}
