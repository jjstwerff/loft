// Probe 03 — Reference baseline: `vec[i]` direct read (no `??`)
//
// Verifies that vector-index text reads work correctly OUTSIDE the `??`
// lowering.  This isolates the bug to the `_ncc_N` temp's scope-exit
// OpFreeText interleaving, NOT the vector-index machinery itself.
//
// The direct read pushes the source store's Str onto the stack and the
// consumer assigns from it without an intermediate block-local being
// freed first.
//
// Expected: PASS on both --interpret and --native.
// Status: reference baseline isolating the `??` block construction as the
//         load-bearing difference vs. probe 02.

struct H { items: vector<text> }

fn main() {
  h = H { items: [] };
  h.items += "present";
  a = h.items[0];
  assert(a == "present", "probe 03: got '{a}', want 'present'");
  println("probe 03 PASSED");
}
