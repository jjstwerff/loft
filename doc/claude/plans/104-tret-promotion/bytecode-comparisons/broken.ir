const LOFT_PROGRAM_RELATIVE: bool = true;
static LOFT_LIVE_FNS: &[&str] = &["n___add_int", "n_sum_of", "n_exhausted", ];
static LOFT_SRC: Option<&str> = None;

fn main() {
    loft::timeout::arm(loft::timeout::env_timeout_secs(), loft::timeout::env_grace_secs());
    loft::database::NATIVE_FAIL_FAST.store(true, std::sync::atomic::Ordering::Relaxed);
    let __run = || {
    let cell = std::cell::UnsafeCell::new(loft::live_dispatch::boot_stores(LOFT_LIVE_FNS, LOFT_SRC));
    { let stores: &mut Stores = unsafe { &mut *cell.get() }; stores.user_args = std::env::args().skip(1).collect(); stores.source_dir = Stores::source_dir_native(); stores.program_relative = LOFT_PROGRAM_RELATIVE; if let Ok(m) = std::env::var("LOFT_PATHS") { stores.program_relative = m.eq_ignore_ascii_case("program"); } }
    if !loft::live_dispatch::live_enabled() { init(&cell); }
    n_main(&cell);
    { let stores: &Stores = unsafe { &*cell.get() }; if stores.had_fatal { std::process::exit(1); } }
    if !loft::live_dispatch::live_enabled() {
    if std::env::var("LOFT_NATIVE_LEAK_CHECK").is_ok() {
        let stores: &Stores = unsafe { &*cell.get() };
        let leaks = stores.collect_store_leaks();
        if !leaks.is_empty() {
            let count = leaks.len();
            let preview = if count <= 5 { leaks.join(", ") } else { format!("{} ... and {} more", leaks[..5].join(", "), count - 5) };
            eprintln!("Warning: {count} stores not freed at program exit: {preview}");
        }
    }
    }
    #[cfg(not(target_arch = "wasm32"))] if std::env::var("LOFT_STORES").as_deref() == Ok("timeline") { let stores: &Stores = unsafe { &*cell.get() }; loft::database::timeline_summary(stores.collect_store_leaks().len()); }
    };
    // @PLN98 — the large-stack thread (@PLN28) is a NATIVE affordance;
    // wasm32 (wasip2 / browser) has no thread support, so run inline there.
    #[cfg(not(target_arch = "wasm32"))]
    std::thread::Builder::new().stack_size(loft::codegen_runtime::NATIVE_MAIN_STACK).spawn(__run).expect("failed to spawn main-stack thread").join().expect("main thread panicked");
    #[cfg(target_arch = "wasm32")]
    __run();
}

