# GIANT BAT — top-down, FRONT=UP, wings SPREAD mid-swoop (the unmistakable bat outline:
# angular leading edges, SCALLOPED trailing membrane between finger struts). Small furry
# body, huge ears, fang points, red eyeshine. Menace: the swoop posture + thumb-claw hooks
# on the wing bends + deep dusk tones. Wings overhang the cell (appendage rule).
# Techniques: scalloped-membrane wing poly (~ smooth dips between strut points); finger
# strut lines; tiny-body-big-wings proportion; red eyeshine (giant_rat).
#
# --- NOTE (fur): the small body is value-graded with a few short edge tufts so it reads FURRY
# vs. rubbery; fur on the body ONLY — the wings are membrane (correctly flat).
# Source for assets/sprites/giant_bat.png.
size 256x256
Background transparent

# LEFT wing — leading edge out to the tip, scalloped trailing edge back to the flank
name wingL
Poly (0.46,0.40) (0.24,0.255) (0.045,0.300) (0.115,0.415)~ (0.205,0.445) (0.255,0.525)~ (0.330,0.545) (0.385,0.625)~ (0.445,0.585) rgb=54,46,50
name wingR
Poly (0.54,0.40) (0.76,0.255) (0.955,0.300) (0.885,0.415)~ (0.795,0.445) (0.745,0.525)~ (0.670,0.545) (0.615,0.625)~ (0.555,0.585) rgb=54,46,50

# finger struts — thin dark rays from the shoulder through the membrane
name strutsL
Line (0.46,0.41) - (0.075,0.315) w=2
Line (0.46,0.43) - (0.215,0.435) w=2
Line (0.46,0.46) - (0.270,0.515) w=2
Line (0.46,0.49) - (0.340,0.540) w=2
name strutsR
Line (0.54,0.41) - (0.925,0.315) w=2
Line (0.54,0.43) - (0.785,0.435) w=2
Line (0.54,0.46) - (0.730,0.515) w=2
Line (0.54,0.49) - (0.660,0.540) w=2

# thumb-claw hooks at the wing bends (the grab)
name claws
Poly (0.245,0.262) (0.215,0.212) (0.258,0.243) rgb=216,208,186
Poly (0.755,0.262) (0.785,0.212) (0.742,0.243) rgb=216,208,186

# body — small furry teardrop between the wings (bats are tiny under all that wing): value-
# graded + a few short edge tufts so it reads FURRY not rubbery (wings stay flat membrane)
name body
Circle (0.50,0.50) r=0.082 radial=84,66,56>54,40,34 at=0.50,0.46,0.10
Circle (0.50,0.43) r=0.068 radial=84,66,56>54,40,34 at=0.50,0.40,0.085
name bodyfur
Fronds (0.50,0.45)-(0.50,0.555) n=3 len=0.045 len2=0.035 w=1.5 w2=0.7 ang=42 ang2=58 mirror=1 bow=0.1 seed=8 stroke=58,44,38
# tail membrane — a short point trailing between the wing roots
name tailm
Poly (0.455,0.565) (0.545,0.565) (0.50,0.66) rgb=54,46,50

# head — small, crowned by HUGE ears (the bat radar)
name head
Circle (0.50,0.355) r=0.054 rgb=66,52,44
name earL
Poly (0.468,0.330) (0.438,0.185) (0.508,0.318) rgb=66,52,44
Poly (0.470,0.315) (0.452,0.225) (0.498,0.312) rgb=34,26,24
name earR
Poly (0.532,0.330) (0.562,0.185) (0.492,0.318) rgb=66,52,44
Poly (0.530,0.315) (0.548,0.225) (0.502,0.312) rgb=34,26,24

# eyes — tiny RED eyeshine (dusk hunter)
name eyes
Circle (0.479,0.345) r=0.010 rgb=150,24,18
Circle (0.521,0.345) r=0.010 rgb=150,24,18
Circle (0.481,0.342) r=0.004 rgb=255,120,90

# muzzle — a small nub protruding at the head's FRONT, between the ear bases,
# with two pale fang points jutting forward (the bite, front=UP)
name muzzle
Circle (0.50,0.302) r=0.026 rgb=58,44,38
name fangs
Poly (0.490,0.295) (0.485,0.258) (0.498,0.292) rgb=230,224,204
Poly (0.510,0.295) (0.515,0.258) (0.502,0.292) rgb=230,224,204
