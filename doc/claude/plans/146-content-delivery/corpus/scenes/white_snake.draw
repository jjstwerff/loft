# WHITE SNAKE — a pale albino snake (kin of sand_adder — SAME construction). Light-on-
# light readability: a DARK UNDERLAY stroke beneath the body + head (the outline technique);
# RED albino eyes top-down, FRONT=UP, in a STRIKE-READY S-COIL (menace =
# posture: the S is a loaded spring). Identifiers: arrow/viper head WIDER than the neck,
# the adder's dark dorsal ZIGZAG, forked tongue flicking forward, fang points at the jaw.
# Dark-sand tones (true colour, darkened to read on the light stone floor).
# Techniques (the SNAKE construction — reuse for dust_viper / white_snake / ssirath):
# one tapered ~smooth S-stroke body; chevron zigzag along the spine; kite head buried
# into the neck (join discipline); slit viper eyes; forked-tongue lines.
# Source for assets/sprites/white_snake.png.
size 256x256
Background transparent

# the body — a COMPACT loaded-spring S: tight fat coils gathered low, the neck rising out
name outline
Poly (0.36,0.90)@10 (0.60,0.85)~@24 (0.66,0.71)~@33 (0.42,0.645)~@37 (0.345,0.51)~@37 (0.56,0.43)~@33 (0.525,0.335)~@26 (0.50,0.28)@22 stroke=72,66,58
name body
Poly (0.36,0.90)@6 (0.60,0.85)~@18 (0.66,0.71)~@27 (0.42,0.645)~@31 (0.345,0.51)~@31 (0.56,0.43)~@27 (0.525,0.335)~@20 (0.50,0.28)@16 stroke=212,206,194

# the adder pattern — DISCRETE dark diamond blotches at the path's control points
# (technique: discrete marks never mis-align on a smoothed path, unlike a traced zigzag)
name blotches
Poly (0.60,0.845) (0.632,0.81) (0.60,0.775) (0.568,0.81) rgb=158,152,140
Poly (0.652,0.715) (0.682,0.68) (0.652,0.645) (0.622,0.68) rgb=158,152,140
Poly (0.48,0.66) (0.515,0.628) (0.48,0.596) (0.445,0.628) rgb=158,152,140
Poly (0.36,0.525) (0.392,0.49) (0.36,0.455) (0.328,0.49) rgb=158,152,140
Poly (0.545,0.45) (0.575,0.418) (0.545,0.386) (0.515,0.418) rgb=158,152,140
Poly (0.518,0.345) (0.545,0.315) (0.518,0.285) (0.491,0.315) rgb=158,152,140

# the head — a viper KITE, wider than the neck, its base buried DEEP in the neck stroke
name head_outline
Poly (0.50,0.085) (0.594,0.205) (0.50,0.322) (0.406,0.205) rgb=72,66,58
name head
Poly (0.50,0.10) (0.578,0.205) (0.50,0.305) (0.422,0.205) rgb=200,194,182

# slit viper eyes — amber beads with a dark vertical slit, set on the head sides
name eyes
Circle (0.468,0.192) r=0.018 rgb=170,30,26
Circle (0.532,0.192) r=0.018 rgb=170,30,26
Line (0.468,0.178) - (0.468,0.206) w=2
Line (0.532,0.178) - (0.532,0.206) w=2

# fang points — two pale tips at the jaw's leading edges (the venomous bite)
name fangs
Poly (0.464,0.138) (0.452,0.095) (0.480,0.128) rgb=240,236,224
Poly (0.536,0.138) (0.548,0.095) (0.520,0.128) rgb=240,236,224

# the forked tongue — flicking dead ahead (front=UP)
name tongue
Line (0.500,0.103) - (0.500,0.048) w=2
Line (0.500,0.048) - (0.483,0.012) w=1
Line (0.500,0.048) - (0.517,0.012) w=1
