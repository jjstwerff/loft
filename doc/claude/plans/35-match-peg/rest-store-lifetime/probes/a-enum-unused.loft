// @DESC rest materialised but unused (enum)
// @EXPECT 42
// @LEAK ok
enum Detail { Ship { carrier: text }, Pickup { store: integer } }
fn f(v: vector<Detail>) -> integer { match v { [h, ..rest] => 42, _ => -1 } }
fn main() { assert(f([Ship{carrier:"A"}, Pickup{store:2}, Pickup{store:3}, Pickup{store:4}]) == 42, "n={f([Ship{carrier:"A"}, Pickup{store:2}, Pickup{store:3}, Pickup{store:4}])}"); print("PASS"); }
