// @PLN35 golden · P6 (L3.4 repetition + separator) — GREEN (slice 1).  Both prerequisites
// landed: (a) literal slice elements `[ 1, … ]` (Phase 6.3), and (b) a scalar `name:Type`
// capture + its `name:Type*` / `+` bare-postfix repetition (slice 1).  This golden now passes
// on both backends; the maintained guard is tests/scripts/35f-repetition.loft (this file stays
// as the design reference).  `(a)*` collects into a FRESH vector; `+` needs >=1.  Hand-computed
// (both backends): dispatch([1,5,6,7])=="call/3"; dispatch([1])=="call/0"; dispatch([0,42])=="set 42".

fn dispatch(v: vector<integer>) -> text {
  match v {
    [ 1, args:integer* ]   => "call/{len(args)}",   // 1, then zero-or-more integers collected into args (bare postfix, no parens)
    [ 0, one:integer ]     => "set {one}",
    _                      => "unknown",
  }
}

fn main() {
  assert(dispatch([1, 5, 6, 7]) == "call/3", "repetition collects 3");
  assert(dispatch([1]) == "call/0", "repetition zero");
  assert(dispatch([0, 42]) == "set 42", "the other sequence arm");
  assert(dispatch([9]) == "unknown", "no arm -> _");
  print("P6 repetition: PASS");
}
