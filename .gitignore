target/
Cargo.lock
result.txt
tests/dumps
tests/generated
*.rlib
.loft/
.idea/
.DS_Store
ide/assets/base-fs.json
tests/wasm/pkg/
tests/wasm/assets.json
.claude/worktrees/
.claude/settings.json
tests/test_native_pkg/
*.glb
lib/graphics/examples/*.png
# Imaging regression tests (Phase 6t Tier 5) write small round-trip
# PNGs into the package's tests/ dir.  Each test recreates its tmp
# file; leftovers are harmless but should never be committed.
lib/imaging/tests/_tmp_*.png
# Same imaging round-trip tests, fixture copy (the cwd now == source_dir,
# so save_png writes here under tests/fixtures/libs/imaging/tests/).
tests/fixtures/libs/imaging/tests/_tmp_*.png
# World save/load regression tests (Phase 6t Tier 5) write binary
# snapshots into the package's tests/ dir.  Same convention as
# imaging: each test recreates its tmp file; never commit.
lib/hex_world/tests/_tmp_*.bin
# Canvas demo writes this into its CWD (typically repo root) — gold lives at
# tests/gold/10-canvas-demo.png; the working-directory copy is transient.
/10-canvas-demo.png
test_scene_debug.loft
# Audience-demo server runtime snapshot (regenerated on each run).
tools/audience-demo/world.bin
# Project-root loft.lock left behind by tests that invoke the loft
# binary with cwd=project_root against a fixture mini-package (e.g.
# tests/codegen_emitter.rs::p310_graphics_vector_ffi_checks_clean —
# the fixture's own lockfile leaks into the runner's cwd).  Real
# consumer projects should commit their own loft.lock.
/loft.lock
# Test-fixture mini-packages' loft.lock files — each test re-resolves
# deps fresh; committing the lock would pin a specific tarball sha256
# across environments with different cache states.
tests/fixtures/*/loft.lock
tests/fixtures/libs/*/loft.lock
# Monorepo libs that declare registry deps in their loft.toml get a
# loft.lock written next to it when the parser resolves them; same
# rationale as the fixture lockfiles above.
lib/*/loft.lock
# FUSE filesystem hidden files: created when a file is deleted while still
# open by another process (e.g. an editor or watcher). They're stale OS
# artefacts, never source code.
.fuse_hidden*
*.loftc
.claude/scheduled_tasks.lock
lib/graphics/native/libloft_graphics_native.so
# Initiative 03 Phase 6: `make editor-dist` writes a shippable
# native editor bundle here.  Build artefact; regenerable from source.
dist/

# loft-view (plan-35) — frozen binary + per-build artefacts.
# Phase 07 closeout decides whether to commit the binary itself.
/tools/viewer/state/*
!/tools/viewer/state/.gitkeep
/tools/viewer/bin/*
!/tools/viewer/bin/.gitkeep
/tools/viewer/BUILD_NOTES.md

# tracker-tag index (plan-37) — generated by tools/indexer/scan.sh
/index/*
!/index/.gitkeep
# @PLN92 strand 3: the feature-catalogue snapshot IS committed (deterministic,
# offline generator input for `make features-gen` / `features-check`); tags.json
# stays generated/ignored.  index/ is not a scan root, so this adds no tag noise.
!/index/features.json

# Python __pycache__ from tools/indexer/migrate.py.
__pycache__/
*.pyc

# Registry trust-root tooling — loft-keygen outputs.  The canonical
# embedding is in src/registry_keys.rs.  These files (if generated
# at repo root by `loft-keygen generate` for ad-hoc inspection) are
# scratch artefacts, not source.  The real private key MUST live
# at ~/.loft/trust-root/, never in the repo.
registry-signing-key.pub
registry-signing-key.bin

# Transient lib-test artifact-isolation dirs (tests/wrap.rs run_lib_test_in_temp_cwd)
lib/.loft_test_tmp_*
native-auto/
/target-da/
/*.bin
test_loft_*.bin
