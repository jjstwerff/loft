//
// Formatter Step 4 (first cut): the CONTENT-AWARE container rules.  Replaces Step 3's
// transparent Group resolver with the owner's rule:
//   a container breaks MULTI-LINE iff any element OWNS A LINE (is/contains a `{…}`
//   object/block); otherwise it stays INLINE.
// So: vector of numbers -> inline; vector of objects -> multi-line (one per line);
//     object with simple fields -> inline; object with a nested object field -> multi-line.
// Plus a WIDTH fallback: a simple container that overruns breaks anyway ("unless too
// long").  Spacing re-derived (subset of src/formatter.rs need_space); indent = depth*2;
// broken containers get a trailing comma.  Demo: the canonical cases + width + empty.
// Next: comment column alignment + whole-file integration.

// ── lexer + CST (Steps 1-2) ──────────────────────────────────────────────────

fn is_ws(c: character) -> boolean { c == ' ' || c == '\t' || c == '\r' }
fn is_word(c: character) -> boolean { c.is_alphanumeric() || c == '_' }

fn slice(chars: vector<character>, a: integer, b: integer) -> text {
  s = "";
  k = a;
  while k < b { s += (chars[k] ?? ' '); k += 1; }
  s
}

fn scan_string(chars: vector<character>, i: integer, n: integer) -> integer {
  j = i + 1;
  while j < n {
    c = chars[j] ?? '"';
    if c == '\\' { j += 2; }
    else if c == '{' {
      if j + 1 < n && (chars[j + 1] ?? ' ') == '{' { j += 2; }
      else { j = scan_slot(chars, j + 1, n); }
    } else if c == '"' { return j + 1; }
    else if c == '\n' { return j; }
    else { j += 1; }
  }
  j
}

fn scan_slot(chars: vector<character>, i: integer, n: integer) -> integer {
  j = i;
  depth = 1;
  while j < n {
    c = chars[j] ?? '}';
    if c == '{' { depth += 1; j += 1; }
    else if c == '}' { depth -= 1; j += 1; if depth == 0 { return j; } }
    else if c == '"' { j = scan_string(chars, j, n); }
    else if c == '\\' { j += 2; }
    else { j += 1; }
  }
  j
}

fn scan_char(chars: vector<character>, i: integer, n: integer) -> integer {
  j = i + 1;
  while j < n {
    c = chars[j] ?? '\'';
    if c == '\\' { j += 2; }
    else if c == '\'' { return j + 1; }
    else { j += 1; }
  }
  j
}

fn lex(src: text) -> vector<text> {
  chars: vector<character> = [];
  for c in src { chars += [c]; }
  n = len(chars);
  toks: vector<text> = [];
  i = 0;
  while i < n {
    c = chars[i] ?? ' ';
    start = i;
    if c == '\n' { i += 1; }
    else if is_ws(c) { while i < n && is_ws(chars[i] ?? '\n') { i += 1; } }
    else if c == '/' && i + 1 < n && (chars[i + 1] ?? ' ') == '/' {
      while i < n && (chars[i] ?? '\n') != '\n' { i += 1; }
    } else if c == '"' { i = scan_string(chars, i, n); }
    else if c == '\'' { i = scan_char(chars, i, n); }
    else if is_word(c) { while i < n && is_word(chars[i] ?? ' ') { i += 1; } }
    else { i += 1; }
    toks += [slice(chars, start, i)];
  }
  toks
}

enum Node {
  Leaf { tok: text },
  Group { open: text, kids: vector<Node>, close: text },
}
struct Seq { nodes: vector<Node>, next: integer, closed: text }

fn is_open(t: text) -> boolean { t == "[" || t == "{{" || t == "(" }
fn is_close(t: text) -> boolean { t == "]" || t == "}}" || t == ")" }
fn close_for(open: text) -> text {
  if open == "[" { "]" } else if open == "{{" { "}}" } else { ")" }
}

fn parse_seq(toks: vector<text>, start: integer, expect: text) -> Seq {
  kids: vector<Node> = [];
  j = start;
  n = len(toks);
  while j < n {
    t = toks[j] ?? "";
    if is_close(t) {
      if t == expect { return Seq { nodes: kids, next: j + 1, closed: t }; }
      else { kids += [Leaf { tok: t }]; j += 1; }
    } else if is_open(t) {
      sub = parse_seq(toks, j + 1, close_for(t));
      kids += [Group { open: t, kids: sub.nodes, close: sub.closed }];
      j = sub.next;
    } else { kids += [Leaf { tok: t }]; j += 1; }
  }
  Seq { nodes: kids, next: j, closed: "" }
}

fn parse(toks: vector<text>) -> vector<Node> {
  r = parse_seq(toks, 0, "");
  r.nodes
}

// ── Step 4: content-aware rules ──────────────────────────────────────────────

fn is_trivia_tok(t: text) -> boolean { t.is_whitespace() || t.starts_with("//") }

fn spaces(n: integer) -> text {
  s = "";
  k = 0;
  while k < n { s += " "; k += 1; }
  s
}

// Space between the previous real token and the next?  A pragmatic subset of
// src/formatter.rs need_space, enough for the data-container forms.
fn sp(prev: text, tok: text) -> boolean {
  if prev == "" { return false; }
  if prev == "(" || prev == "[" { return false; }
  if tok == ")" || tok == "]" || tok == "," || tok == ";" || tok == ":" { return false; }
  if tok == "(" || tok == "[" { return false; }
  if tok == "." || prev == "." || tok == "::" || prev == "::" { return false; }
  if tok == "{{" { return true; }
  if prev == "{{" { return true; }
  if tok == "}}" { return true; }
  if prev == "," || prev == ":" { return true; }
  // two wordish tokens, or an operator context → space
  pw = prev.is_alphanumeric() || prev == "\"" || prev.starts_with("\"");
  tw = tok.is_alphanumeric() || tok.starts_with("\"") || tok.starts_with("'");
  if pw && tw { return true; }
  // assignment / comparison / arrow operators get spaces
  if tok == "=" || prev == "=" || tok == "==" || prev == "==" || tok == "->" || prev == "->"
     || tok == "=>" || prev == "=>" || tok == "+" || prev == "+" || tok == "??" || prev == "??" {
    return true;
  }
  false
}

// Any real node in kids[a..b]?
fn has_real(kids: vector<Node>, a: integer, b: integer) -> boolean {
  k = a;
  while k < b {
    nd = kids[k] ?? Leaf { tok: "" };
    match nd {
      Leaf { tok } => { if !is_trivia_tok(tok) { return true; } },
      Group { open, kids, close } => { return true; },
    }
    k += 1;
  }
  false
}

// The line-width budget — the "unless too long" fallback (owner dial).
fn width() -> integer { (env_variable("LOFT_FMT_WIDTH") ?? "100") as integer ?? 100 }

// The column after appending `g` at column `before`: `before + len` on the same line,
// or the length of `g`'s LAST line if it broke.
fn last_line_len(g: text, before: integer) -> integer {
  chars: vector<character> = [];
  for c in g { chars += [c]; }
  n = len(chars);
  last_nl = 0 - 1;
  k = 0;
  while k < n { if (chars[k] ?? 'x') == '\n' { last_nl = k; } k += 1; }
  if last_nl < 0 { before + n } else { n - last_nl - 1 }
}

// Render kids[a..b] INLINE starting at column `col0` — spacing via `sp`, nested
// groups via render_group (which may itself break, tracked through `col`).
fn render_range(kids: vector<Node>, a: integer, b: integer, col0: integer, indent: integer) -> text {
  s = "";
  prev = "";
  col = col0;
  k = a;
  while k < b {
    nd = kids[k] ?? Leaf { tok: "" };
    match nd {
      Leaf { tok } => {
        if !is_trivia_tok(tok) {
          if sp(prev, tok) { s += " "; col += 1; }
          s += tok;
          col += tok.size();
          prev = tok;
        }
      },
      Group { open, kids, close } => {
        if sp(prev, open) { s += " "; col += 1; }
        g = render_group(open, kids, close, col, indent);
        s += g;
        col = last_line_len(g, col);
        prev = close;
      },
    }
    k += 1;
  }
  s
}

// A container.  BREAK (one element per line, trailing comma) iff any direct-child
// element is a `{…}` object/block ("owns a line") OR the inline form does not fit the
// width budget from column `col`.  Otherwise INLINE.  Empty -> `open close`.
fn render_group(open: text, kids: vector<Node>, close: text, col: integer, indent: integer) -> text {
  n = len(kids);
  if !has_real(kids, 0, n) {
    s = open;
    s += close;
    return s;
  }
  brk = false;
  k = 0;
  while k < n {
    nd = kids[k] ?? Leaf { tok: "" };
    match nd {
      Leaf { tok } => {},
      Group { open, kids, close } => { if open == "{{" { brk = true; } },
    }
    k += 1;
  }
  if !brk {
    inner = if open == "{{" { " " } else { "" };
    inline = open;
    inline += inner;
    inline += render_range(kids, 0, n, col + open.size() + inner.size(), indent);
    inline += inner;
    inline += close;
    if col + inline.size() <= width() {
      return inline;
    }
    brk = true;
  }
  s = open;
  s += "\n";
  start = 0;
  k = 0;
  while k <= n {
    at_end = k == n;
    is_comma = false;
    if !at_end {
      nd = kids[k] ?? Leaf { tok: "" };
      match nd {
        Leaf { tok } => { if tok == "," { is_comma = true; } },
        Group { open, kids, close } => {},
      }
    }
    if is_comma || at_end {
      if has_real(kids, start, k) {
        s += spaces(indent + 2);
        s += render_range(kids, start, k, indent + 2, indent + 2);
        s += ",\n";
      }
      start = k + 1;
    }
    k += 1;
  }
  s += spaces(indent);
  s += close;
  s
}

fn fmt_expr(src: text) -> text {
  nodes = parse(lex(src));
  render_range(nodes, 0, len(nodes), 0, 0)
}

fn main() {
  // NB: `{{`/`}}` are literal-brace escapes in these loft input strings.
  print("[width budget = {width()}]\n\n");
  a = fmt_expr("[1, 2, 3]");
  print("vec of numbers (short):\n{a}\n\n");
  b = fmt_expr("[P {{ x: 1, y: 2 }}, P {{ x: 3, y: 4 }}]");
  print("vec of objects:\n{b}\n\n");
  c = fmt_expr("P {{ x: 1, y: 2 }}");
  print("simple object:\n{c}\n\n");
  d = fmt_expr("Widget {{ pos: Coord {{ x: 1, y: 2 }}, size: 5 }}");
  print("object w/ nested object field:\n{d}\n\n");
  e = fmt_expr("[111, 222, 333, 444, 555, 666, 777, 888, 999, 1010, 1111, 1212]");
  print("vec of numbers (too long -> width fallback):\n{e}\n\n");
  f = fmt_expr("[]");
  print("empty vector:\n{f}\n\n");
  // idempotency: re-formatting a formatted output must be a fixpoint
  ok = (fmt_expr(a) == a) && (fmt_expr(b) == b) && (fmt_expr(c) == c)
    && (fmt_expr(d) == d) && (fmt_expr(e) == e) && (fmt_expr(f) == f);
  print("idempotent on all cases: {ok}\n");
}
