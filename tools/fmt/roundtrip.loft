//
// Formatter groundwork — Step 1: a LOSSLESS lexer for loft source, in loft, with a
// round-trip validator.  The whole safety argument rests on totality: concatenating
// every token's text must reproduce the source byte-for-byte.  Run over the corpus:
//   for f in tests/scripts/*.loft; do LOFT_FMT_FILE=$f loft --interpret roundtrip.loft; done
// A DIFF line means the lexer mis-delimited something.
//
// String delimiting mirrors src/lexer.rs `string()`/`string_nested()`: a `{` opens a
// FORMAT SLOT lexed as code (balancing `{}` and nested strings), `{{`/`}}` are literal
// braces, nested strings use bare `"`.  A string is kept as ONE opaque token — the
// formatter never rewrites string interiors.

fn is_ws(c: character) -> boolean { c == ' ' || c == '\t' || c == '\r' }
fn is_word(c: character) -> boolean { c.is_alphanumeric() || c == '_' }

fn slice(chars: vector<character>, a: integer, b: integer) -> text {
  s = "";
  k = a;
  while k < b {
    s += (chars[k] ?? ' ');
    k += 1;
  }
  s
}

// `i` at the opening `"`; returns the index just past the closing `"`.  Mirrors the
// mode-switch in src/lexer.rs: `\`-escape, `{{`/`}}` literals, `{expr}` format slots.
fn scan_string(chars: vector<character>, i: integer, n: integer) -> integer {
  j = i + 1;
  while j < n {
    c = chars[j] ?? '"';
    if c == '\\' {
      j += 2;
    } else if c == '{' {
      if j + 1 < n && (chars[j + 1] ?? ' ') == '{' {
        j += 2;
      } else {
        j = scan_slot(chars, j + 1, n);
      }
    } else if c == '"' {
      return j + 1;
    } else if c == '\n' {
      return j;
    } else {
      j += 1;
    }
  }
  j
}

// `i` just past the opening `{` of a format slot; returns the index past the matching
// `}`.  The slot body is CODE — balance `{}`, and recurse into nested `"…"` strings.
fn scan_slot(chars: vector<character>, i: integer, n: integer) -> integer {
  j = i;
  depth = 1;
  while j < n {
    c = chars[j] ?? '}';
    if c == '{' {
      depth += 1;
      j += 1;
    } else if c == '}' {
      depth -= 1;
      j += 1;
      if depth == 0 {
        return j;
      }
    } else if c == '"' {
      j = scan_string(chars, j, n);
    } else if c == '\\' {
      j += 2;
    } else {
      j += 1;
    }
  }
  j
}

// `i` at the opening `'`; returns the index past the closing `'`.
fn scan_char(chars: vector<character>, i: integer, n: integer) -> integer {
  j = i + 1;
  while j < n {
    c = chars[j] ?? '\'';
    if c == '\\' {
      j += 2;
    } else if c == '\'' {
      return j + 1;
    } else {
      j += 1;
    }
  }
  j
}

// Tokenise `src` into a flat vector of token texts.  Lossless: join(lex(src)) == src.
fn lex(src: text) -> vector<text> {
  chars: vector<character> = [];
  for c in src { chars += [c]; }
  n = len(chars);
  toks: vector<text> = [];
  i = 0;
  while i < n {
    c = chars[i] ?? ' ';
    start = i;
    if c == '\n' {
      i += 1;
    } else if is_ws(c) {
      while i < n && is_ws(chars[i] ?? '\n') {
        i += 1;
      }
    } else if c == '/' && i + 1 < n && (chars[i + 1] ?? ' ') == '/' {
      while i < n && (chars[i] ?? '\n') != '\n' {
        i += 1;
      }
    } else if c == '"' {
      i = scan_string(chars, i, n);
    } else if c == '\'' {
      i = scan_char(chars, i, n);
    } else if is_word(c) {
      while i < n && is_word(chars[i] ?? ' ') {
        i += 1;
      }
    } else {
      i += 1;
    }
    toks += [slice(chars, start, i)];
  }
  toks
}

// @FTR-063 — the formatter's safety argument, checked: concatenating every token's text
// must reproduce the source byte-for-byte, over the whole corpus
fn main() {
  path = env_variable("LOFT_FMT_FILE") ?? "";
  src = file(path).content() ?? "";
  toks = lex(src);
  rebuilt = "";
  for t in toks { rebuilt += t; }
  if rebuilt == src {
    print("OK   {size(src)}b {len(toks)}tok  {path}\n");
  } else {
    sc: vector<character> = [];
    for c in src { sc += [c]; }
    rc: vector<character> = [];
    for c in rebuilt { rc += [c]; }
    m = if len(sc) < len(rc) { len(sc) } else { len(rc) };
    at = 0;
    while at < m && (sc[at] ?? ' ') == (rc[at] ?? ' ') { at += 1; }
    print("DIFF {size(src)}b -> {size(rebuilt)}b  first@{at}  {path}\n");
  }
}
