//
// @PLAN50 — server-side bounce-forecast feasibility test.
//
// Tests two questions:
//   (Q1) CAN the server detect imminent bounces ahead of time
//        with reasonable accuracy?
//   (Q2) HOW MUCH does a player input-change within the lookahead
//        window invalidate the forecast?
//
// Setup: a plane modelled as TWO axis-aligned boxes (fuselage +
// wings; tail ignored per design) is flying toward a wall.  The
// server's "forecast" is a ballistic extrapolation: extend
// `current velocity × t` until the plane's boxes overlap the
// wall.  We then compare the forecast against the ACTUAL
// trajectory under a few input scenarios.
//
// No network, no protocol — pure physics-and-prediction test.
// Standalone; runs in-process; reports a verdict table.
//
// Run:
//   ./target/release/loft --no-warnings --lib lib/ \
//       tools/audience-demo-50/forecast_test.loft

// ── Vec3 + AABB primitives ───────────────────────────────────────────────

struct Vec3 {
  x: float,
  y: float,
  z: float,
}

struct AABB {
  cx: float, cy: float, cz: float,   // centre
  hx: float, hy: float, hz: float,   // half-extents
}

fn aabb_overlap(a: AABB, b: AABB) -> boolean {
  (abs(a.cx - b.cx) <= a.hx + b.hx) &&
  (abs(a.cy - b.cy) <= a.hy + b.hy) &&
  (abs(a.cz - b.cz) <= a.hz + b.hz)
}

// ── Plane shape — three parts at proper offsets (tail ignored per design) ─
//
// All offsets in the plane's local coordinate frame, with +x = forward
// (nose direction).  For the v1 test the plane flies axis-aligned, so
// local-x === world-x; rotation handling deferred to a later iteration
// of this test.
//
//   nose:  short box at the front, 0.5 m long.  Red.  Touching this
//          ⇒ no score for the hitter (per anti-coordination rule).
//   body:  main fuselage, 2.5 m long, centred slightly behind plane CoM.
//          Touching this ⇒ +5 to hitter.
//   wings: thin wide box, centred on the body, 4 m span.  Touching this
//          ⇒ +5 to hitter (same as body).
//
// Plane CoM = pos.  Total nose-to-tail = 3 m (matches old fuselage).

// Facing — 4 axis-aligned headings (full rotation is a later iteration).
//   FACE_PX = nose toward +x, FACE_NX = toward -x,
//   FACE_PY = nose toward +y, FACE_NY = toward -y.
const FACE_PX: integer = 0;
const FACE_NX: integer = 1;
const FACE_PY: integer = 2;
const FACE_NY: integer = 3;

const NOSE_AHEAD:    float = 1.25;     // nose centre offset along facing
const BODY_BEHIND:   float = 0.25;     // body centre offset opposite facing
const NOSE_HALF:     float = 0.25;     // nose cube half-edge (symmetric)
const BODY_HALF_LEN: float = 1.25;     // body half-length along facing
const BODY_HALF_THK: float = 0.3;      // body half-thickness perpendicular
const BODY_HALF_HT:  float = 0.3;
const WING_HALF_LEN: float = 0.3;      // wing half-chord (along facing)
const WING_HALF_SPN: float = 2.0;      // wing half-span (perpendicular)
const WING_HALF_HT:  float = 0.05;

fn plane_nose(pos: Vec3, facing: integer) -> AABB {
  if facing == FACE_PX { return AABB { cx: pos.x + NOSE_AHEAD, cy: pos.y, cz: pos.z, hx: NOSE_HALF, hy: NOSE_HALF, hz: NOSE_HALF }; }
  if facing == FACE_NX { return AABB { cx: pos.x - NOSE_AHEAD, cy: pos.y, cz: pos.z, hx: NOSE_HALF, hy: NOSE_HALF, hz: NOSE_HALF }; }
  if facing == FACE_PY { return AABB { cx: pos.x, cy: pos.y + NOSE_AHEAD, cz: pos.z, hx: NOSE_HALF, hy: NOSE_HALF, hz: NOSE_HALF }; }
  AABB { cx: pos.x, cy: pos.y - NOSE_AHEAD, cz: pos.z, hx: NOSE_HALF, hy: NOSE_HALF, hz: NOSE_HALF }
}
fn plane_body(pos: Vec3, facing: integer) -> AABB {
  if facing == FACE_PX { return AABB { cx: pos.x - BODY_BEHIND, cy: pos.y, cz: pos.z, hx: BODY_HALF_LEN, hy: BODY_HALF_THK, hz: BODY_HALF_HT }; }
  if facing == FACE_NX { return AABB { cx: pos.x + BODY_BEHIND, cy: pos.y, cz: pos.z, hx: BODY_HALF_LEN, hy: BODY_HALF_THK, hz: BODY_HALF_HT }; }
  if facing == FACE_PY { return AABB { cx: pos.x, cy: pos.y - BODY_BEHIND, cz: pos.z, hx: BODY_HALF_THK, hy: BODY_HALF_LEN, hz: BODY_HALF_HT }; }
  AABB { cx: pos.x, cy: pos.y + BODY_BEHIND, cz: pos.z, hx: BODY_HALF_THK, hy: BODY_HALF_LEN, hz: BODY_HALF_HT }
}
fn plane_wings(pos: Vec3, facing: integer) -> AABB {
  // Wings span perpendicular to facing.
  if facing == FACE_PX || facing == FACE_NX {
    return AABB { cx: pos.x, cy: pos.y, cz: pos.z, hx: WING_HALF_LEN, hy: WING_HALF_SPN, hz: WING_HALF_HT };
  }
  AABB { cx: pos.x, cy: pos.y, cz: pos.z, hx: WING_HALF_SPN, hy: WING_HALF_LEN, hz: WING_HALF_HT }
}

// Contact classification — which plane parts touched the target.
//
// Bitfield encoded as integer:
//   bit 0 (1) = nose
//   bit 1 (2) = body
//   bit 2 (4) = wings
//
// 0 = no contact.
const CONTACT_NONE:  integer = 0;
const CONTACT_NOSE:  integer = 1;
const CONTACT_BODY:  integer = 2;
const CONTACT_WINGS: integer = 4;

fn plane_contact(pos: Vec3, facing: integer, target: AABB) -> integer {
  bits = CONTACT_NONE;
  if aabb_overlap(plane_nose(pos, facing),  target) { bits = bits | CONTACT_NOSE;  }
  if aabb_overlap(plane_body(pos, facing),  target) { bits = bits | CONTACT_BODY;  }
  if aabb_overlap(plane_wings(pos, facing), target) { bits = bits | CONTACT_WINGS; }
  bits
}

fn plane_overlaps(pos: Vec3, facing: integer, wall: AABB) -> boolean {
  plane_contact(pos, facing, wall) != CONTACT_NONE
}

// ── Plane-on-plane contact + scoring ────────────────────────────────────
//
// Per-plane scoring rule (per @PLAN50 design):
//   If YOUR contact touches the OTHER plane's NOSE only -> 0 score.
//   If YOUR contact touches the OTHER plane's BODY or WINGS -> +5.
//
// `contact_a_on_b` = bitfield of which parts of B were touched by any
//                    part of A.  Drives A's score.
// `contact_b_on_a` = bitfield of which parts of A were touched by any
//                    part of B.  Drives B's score.

struct PairContact {
  hit:            boolean,
  contact_a_on_b: integer,  // parts of B touched by A
  contact_b_on_a: integer,  // parts of A touched by B
}

fn pair_contact(pos_a: Vec3, fac_a: integer, pos_b: Vec3, fac_b: integer) -> PairContact {
  a_nose = plane_nose(pos_a, fac_a);
  a_body = plane_body(pos_a, fac_a);
  a_wing = plane_wings(pos_a, fac_a);
  b_nose = plane_nose(pos_b, fac_b);
  b_body = plane_body(pos_b, fac_b);
  b_wing = plane_wings(pos_b, fac_b);

  ab = 0; ba = 0;
  // Check all 9 part-vs-part overlaps.  For each overlap, record
  // (1) which part of B was hit (drives A's view), and
  // (2) which part of A was hit (drives B's view).
  if aabb_overlap(a_nose, b_nose) { ab = ab | CONTACT_NOSE;  ba = ba | CONTACT_NOSE;  }
  if aabb_overlap(a_nose, b_body) { ab = ab | CONTACT_BODY;  ba = ba | CONTACT_NOSE;  }
  if aabb_overlap(a_nose, b_wing) { ab = ab | CONTACT_WINGS; ba = ba | CONTACT_NOSE;  }
  if aabb_overlap(a_body, b_nose) { ab = ab | CONTACT_NOSE;  ba = ba | CONTACT_BODY;  }
  if aabb_overlap(a_body, b_body) { ab = ab | CONTACT_BODY;  ba = ba | CONTACT_BODY;  }
  if aabb_overlap(a_body, b_wing) { ab = ab | CONTACT_WINGS; ba = ba | CONTACT_BODY;  }
  if aabb_overlap(a_wing, b_nose) { ab = ab | CONTACT_NOSE;  ba = ba | CONTACT_WINGS; }
  if aabb_overlap(a_wing, b_body) { ab = ab | CONTACT_BODY;  ba = ba | CONTACT_WINGS; }
  if aabb_overlap(a_wing, b_wing) { ab = ab | CONTACT_WINGS; ba = ba | CONTACT_WINGS; }

  PairContact { hit: ab != 0, contact_a_on_b: ab, contact_b_on_a: ba }
}

// Score a player from their side of a pair-contact bitfield.
// Returns 0 if only the OTHER plane's nose was touched; otherwise +5.
fn score_for(contact_on_other: integer) -> integer {
  // Non-nose contact = BODY (2) or WINGS (4).  Mask = 6.
  if (contact_on_other & 6) != 0 { return 5; }
  0
}

fn contact_label(bits: integer) -> text {
  if bits == 0 { return "none";  }
  if bits == 1 { return "nose";  }
  if bits == 2 { return "body";  }
  if bits == 4 { return "wings"; }
  if bits == 3 { return "nose+body"; }
  if bits == 5 { return "nose+wings"; }
  if bits == 6 { return "body+wings"; }
  if bits == 7 { return "nose+body+wings"; }
  "?"
}

// ── Ballistic forecast: extend velocity × t, find earliest overlap ───────
// Linear search at fixed dt (5 ms) — good to ~10 cm at typical speeds.

const FORECAST_DT_MS: integer = 5;

struct Forecast {
  hit:        boolean,
  t_ms:       integer,    // when collision is predicted (0 if !hit)
  pos_at_hit: Vec3,
  contact:    integer,    // bitfield: which plane parts contacted
}

fn forecast(plane_pos: Vec3, plane_vel: Vec3, facing: integer, wall: AABB, lookahead_ms: integer) -> Forecast {
  t_ms = 0;
  while t_ms <= lookahead_ms {
    t = (t_ms as float) * 0.001;
    test = Vec3 { x: plane_pos.x + plane_vel.x * t,
                  y: plane_pos.y + plane_vel.y * t,
                  z: plane_pos.z + plane_vel.z * t };
    bits = plane_contact(test, facing, wall);
    if bits != CONTACT_NONE {
      return Forecast { hit: true, t_ms: t_ms, pos_at_hit: test, contact: bits };
    }
    t_ms = t_ms + FORECAST_DT_MS;
  }
  Forecast { hit: false, t_ms: 0, pos_at_hit: Vec3 { x: 0.0, y: 0.0, z: 0.0 }, contact: CONTACT_NONE }
}

// ── Pair forecast / simulate (plane-on-plane) ───────────────────────────

struct PairForecast {
  hit:            boolean,
  t_ms:           integer,
  pos_a:          Vec3,
  pos_b:          Vec3,
  contact_a_on_b: integer,
  contact_b_on_a: integer,
}

fn pair_forecast(pos_a: Vec3, vel_a: Vec3, fac_a: integer,
                 pos_b: Vec3, vel_b: Vec3, fac_b: integer,
                 lookahead_ms: integer) -> PairForecast {
  t_ms = 0;
  while t_ms <= lookahead_ms {
    t = (t_ms as float) * 0.001;
    a = Vec3 { x: pos_a.x + vel_a.x * t, y: pos_a.y + vel_a.y * t, z: pos_a.z + vel_a.z * t };
    b = Vec3 { x: pos_b.x + vel_b.x * t, y: pos_b.y + vel_b.y * t, z: pos_b.z + vel_b.z * t };
    c = pair_contact(a, fac_a, b, fac_b);
    if c.hit {
      return PairForecast { hit: true, t_ms: t_ms, pos_a: a, pos_b: b,
                            contact_a_on_b: c.contact_a_on_b,
                            contact_b_on_a: c.contact_b_on_a };
    }
    t_ms = t_ms + FORECAST_DT_MS;
  }
  zero = Vec3 { x: 0.0, y: 0.0, z: 0.0 };
  PairForecast { hit: false, t_ms: 0, pos_a: zero, pos_b: zero,
                 contact_a_on_b: 0, contact_b_on_a: 0 }
}

// ── Forward simulation with optional input change at a specific time ─────
// Inputs are modelled as instantaneous velocity-vector changes (the
// physics-side simplification — real physics has angular velocity that
// gradually rotates the velocity vector, but for forecast-accuracy
// testing the worst-case is an instantaneous flip at the input moment).

const INPUT_NONE:     integer = 0;
const INPUT_BANK_R:   integer = 1;   // velocity rotates 45° toward +y over 200 ms
const INPUT_PULL_UP:  integer = 2;   // vz gains +10 m/s
const INPUT_HARD_PUSH: integer = 3;  // velocity flips toward -x (hard pull)

struct SimResult {
  hit:        boolean,
  t_ms:       integer,
  pos_at_hit: Vec3,
  contact:    integer,    // contact classification at hit moment
}

fn simulate(plane_pos: Vec3, plane_vel: Vec3, facing: integer, wall: AABB, lookahead_ms: integer,
            input_kind: integer, input_at_ms: integer) -> SimResult {
  // Field-by-field locals — loft struct-rebind via `pos = Vec3 {...}`
  // doesn't update the local consistently for downstream reads; use
  // primitive locals + a fresh Vec3 on the overlap check.
  px = plane_pos.x; py = plane_pos.y; pz = plane_pos.z;
  vx = plane_vel.x; vy = plane_vel.y; vz = plane_vel.z;
  t_ms = 0;
  applied = false;
  while t_ms <= lookahead_ms {
    if !applied && input_kind != INPUT_NONE && t_ms >= input_at_ms {
      if input_kind == INPUT_BANK_R {
        speed = sqrt(vx * vx + vy * vy);
        nvx = vx * 0.7071;
        nvy = vx * 0.7071 + vy;
        ns = sqrt(nvx * nvx + nvy * nvy);
        if ns > 0.0001 {
          k = speed / ns;
          vx = nvx * k;
          vy = nvy * k;
        }
      } else if input_kind == INPUT_PULL_UP {
        vz = vz + 10.0;
      } else if input_kind == INPUT_HARD_PUSH {
        vx = -vx;
      }
      applied = true;
    }
    cur = Vec3 { x: px, y: py, z: pz };
    bits = plane_contact(cur, facing, wall);
    if bits != CONTACT_NONE {
      return SimResult { hit: true, t_ms: t_ms, pos_at_hit: cur, contact: bits };
    }
    dt = 0.005;
    px = px + vx * dt;
    py = py + vy * dt;
    pz = pz + vz * dt;
    t_ms = t_ms + 5;
  }
  SimResult { hit: false, t_ms: 0, pos_at_hit: Vec3 { x: px, y: py, z: pz }, contact: CONTACT_NONE }
}

// ── Test driver ──────────────────────────────────────────────────────────

fn vec_dist(a: Vec3, b: Vec3) -> float {
  dx = a.x - b.x; dy = a.y - b.y; dz = a.z - b.z;
  sqrt(dx * dx + dy * dy + dz * dz)
}

fn input_name(kind: integer) -> text {
  if kind == INPUT_NONE     { return "none"; }
  if kind == INPUT_BANK_R   { return "bank-R"; }
  if kind == INPUT_PULL_UP  { return "pull-up"; }
  "hard-push"
}

fn run_case(scenario: text, plane_pos: Vec3, plane_vel: Vec3, wall: AABB,
            lookahead_ms: integer, input_kind: integer, input_at_ms: integer) {
  facing = FACE_PX;  // single-plane tests fly +x
  fc = forecast(plane_pos, plane_vel, facing, wall, lookahead_ms);
  sim = simulate(plane_pos, plane_vel, facing, wall, lookahead_ms, input_kind, input_at_ms);
  fc_str  = if fc.hit  { "{fc.t_ms} ms"  } else { "none    " };
  sim_str = if sim.hit { "{sim.t_ms} ms" } else { "none    " };
  if fc.hit && sim.hit {
    pos_err = vec_dist(fc.pos_at_hit, sim.pos_at_hit);
    t_err   = fc.t_ms - sim.t_ms;
    parts_match = if fc.contact == sim.contact { "ok" } else { "DIFFER" };
    println("  {scenario:24} | in={input_name(input_kind):10} @{input_at_ms:4}ms | fc={fc_str:8} parts={contact_label(fc.contact):16} | act={sim_str:8} parts={contact_label(sim.contact):16} | t-err={t_err:5}ms pos-err={pos_err:6.3}m {parts_match}");
  } else if fc.hit && !sim.hit {
    println("  {scenario:24} | in={input_name(input_kind):10} @{input_at_ms:4}ms | fc={fc_str:8} parts={contact_label(fc.contact):16} | act={sim_str:8} (no contact)                       | FORECAST INVALIDATED");
  } else if !fc.hit && sim.hit {
    println("  {scenario:24} | in={input_name(input_kind):10} @{input_at_ms:4}ms | fc=none                                | act={sim_str:8} parts={contact_label(sim.contact):16} | FORECAST MISSED");
  } else {
    println("  {scenario:24} | in={input_name(input_kind):10} @{input_at_ms:4}ms | (no contact predicted; (no actual contact))");
  }
}

fn main() {
  println("");
  println("@PLAN50 server bounce-forecast feasibility test");
  println("  Lookahead: 100 ms (default net.bounce_lookahead_ms)");
  println("  Plane: fuselage 3.0 × 0.6 × 0.6 m + wings 0.6 × 4.0 × 0.1 m");
  println("  Wall:  thin (0.1 m) at x = 20.0");
  println("");

  // Static wall at x = 20.0 (thin in x, tall in y/z).
  wall = AABB { cx: 20.0, cy: 0.0, cz: 0.0,
                hx: 0.05, hy: 100.0, hz: 100.0 };

  // Plane at origin, velocity 20 m/s +x, on a direct hit course.
  // Wall surface (cx - hx) at x = 19.95; plane fuselage front
  // edge at (pos.x + 1.5).  Contact when pos.x + 1.5 >= 19.95
  // → pos.x >= 18.45 → t = 18.45/20 = 922 ms.  Forecast lookahead
  // is 100 ms so the wall isn't visible to the forecaster from
  // x=0; place the plane closer.

  // Scenario A: plane at (18, 0, 0) going +x at 20 m/s — fuselage
  // front at 19.5, will hit wall at 19.95 after (0.45 / 20) = 22.5 ms.
  // Forecast should detect this trivially.
  println("Q1: pure ballistic forecast accuracy (no input changes)");
  println("    Plane at (18, 0, 0), vel (20, 0, 0); wall surface at x=19.95");
  pos_a = Vec3 { x: 18.0, y: 0.0, z: 0.0 };
  vel_a = Vec3 { x: 20.0, y: 0.0, z: 0.0 };
  run_case("A: ballistic, no input", pos_a, vel_a, wall, 100, INPUT_NONE, 0);
  println("");

  // Q2: input changes during the lookahead
  //
  // For each input scenario we try injecting it at multiple times
  // within the lookahead window: early (5 ms), mid (10 ms), late (20 ms).
  // Trajectory: from (18, 0, 0) heading at (20, 0, 0).  Predicted
  // bounce ~22.5 ms.  Player has zero to ~20 ms before the wall to
  // change their fate.
  println("Q2: input-change invalidation during lookahead");
  println("    Same starting state; varying input + timing");
  for input_kind in [INPUT_BANK_R, INPUT_PULL_UP, INPUT_HARD_PUSH] {
    for input_at in [5, 10, 20] {
      run_case("B: input mid-lookahead", pos_a, vel_a, wall, 100, input_kind, input_at);
    }
  }
  println("");

  // Q3: longer lookahead = more chance for input to invalidate
  println("Q3: longer lookahead (200 ms) — plane further from wall (more room to dodge)");
  pos_c = Vec3 { x: 16.0, y: 0.0, z: 0.0 };
  vel_c = Vec3 { x: 20.0, y: 0.0, z: 0.0 };
  println("    Plane at (16, 0, 0), vel (20, 0, 0); ballistic hit ~122 ms");
  run_case("C: ballistic, no input", pos_c, vel_c, wall, 200, INPUT_NONE, 0);
  for input_kind in [INPUT_BANK_R, INPUT_PULL_UP, INPUT_HARD_PUSH] {
    for input_at in [20, 50, 80] {
      run_case("D: input mid-lookahead", pos_c, vel_c, wall, 200, input_kind, input_at);
    }
  }
  println("");

  // Q4: contact classification — different impact geometries should
  // classify into different plane-part contacts.
  println("Q4: contact classification (which plane part touches)");
  println("    Head-on (vel +x into +x wall): nose-first expected");
  pos_e1 = Vec3 { x: 18.0, y: 0.0, z: 0.0 };
  vel_e1 = Vec3 { x: 20.0, y: 0.0, z: 0.0 };
  run_case("E1: head-on  ", pos_e1, vel_e1, wall, 100, INPUT_NONE, 0);

  // Side-on: plane heading +y into a wall along the xz-plane.  Wings
  // extend ±2 m in y, so a wing touches the wall well before the nose
  // would.  Wall at y = 3.0 (thin in y, wide in x/z).
  wall_y = AABB { cx: 0.0, cy: 3.0, cz: 0.0,
                  hx: 100.0, hy: 0.05, hz: 100.0 };
  println("    Side-on (vel +y into +y wall): wings-first expected");
  pos_e2 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };
  vel_e2 = Vec3 { x: 0.0, y: 20.0, z: 0.0 };
  run_case("E2: side-on  ", pos_e2, vel_e2, wall_y, 100, INPUT_NONE, 0);

  // Diving: plane heading -z into a floor at z = -1.0.  Body has half-height
  // 0.3 m, wings half-height 0.05 m — body+wings hit floor at roughly
  // the same instant since they share the same z-range; nose has
  // hz=0.25 so reaches floor a touch earlier.  Floor at z = -1.0.
  floor = AABB { cx: 0.0, cy: 0.0, cz: -1.0,
                 hx: 100.0, hy: 100.0, hz: 0.05 };
  println("    Diving (vel -z into floor): nose / body / wings all hit close together");
  pos_e3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };
  vel_e3 = Vec3 { x: 0.0, y: 0.0, z: -20.0 };
  run_case("E3: diving   ", pos_e3, vel_e3, floor, 100, INPUT_NONE, 0);

  println("");

  // ─────────────────────────────────────────────────────────────────────
  // Q5 — plane-on-plane forecast + scoring rule verification.
  //
  // The design's plane-on-plane scoring is the demo's anti-coordination
  // mechanism: head-on (both noses touch) scores 0/0 so two players
  // can't trivially trade hits; any other contact rewards the side
  // whose body/wings touched the other's non-nose region.
  //
  // Each scenario sets up two planes, runs pair_forecast, and prints:
  //   - what A touched on B  (drives A's score)
  //   - what B touched on A  (drives B's score)
  //   - per-plane score outcome
  //   - expected outcome (commented inline in the scenario setup)
  // ─────────────────────────────────────────────────────────────────────
  println("Q5: plane-on-plane forecast + scoring rule");
  println("");
  pair_lookahead = 500;   // longer lookahead — planes start further apart

  // P1: head-on (nose-to-nose).  A at (-3, 0, 0) facing +x going +x;
  // B at (3, 0, 0) facing -x going -x.  Both noses point at each other.
  // EXPECTED: contact_a_on_b = NOSE, contact_b_on_a = NOSE, scores 0/0.
  pair_case_head_on();

  // P2: T-bone — A heading +x toward B; B is stationary, FACING +y
  // (so B's nose extends in +y, away from A's path).  A's nose hits
  // B's body broadside.
  // EXPECTED: contact_a_on_b = BODY (or BODY+WINGS), contact_b_on_a
  //           = NOSE.  Scores: A +5, B 0.
  pair_case_tbone();

  // P3: tail-chase — A faster behind B, both heading +x.  A catches
  // up; A's nose touches B's body from behind.
  // EXPECTED: same as T-bone — A: +5, B: 0.
  pair_case_tail_chase();

  // P4: wing-tip clip — two planes parallel, slightly offset in y,
  // brush wingtips.  Both wing-on-wing.
  // EXPECTED: contact_a_on_b = WINGS, contact_b_on_a = WINGS,
  //           scores +5/+5.
  pair_case_wingtip();

  println("Findings:");
  println("  Q1 (head-on wall, no input)  : forecast exact within {FORECAST_DT_MS} ms; nose-first contact.");
  println("  Q2 (input mid-lookahead)     : gentle inputs drift forecast by <1 m at 100 ms lookahead — fits");
  println("                                 inside the forecast_correction_window_ms blend.  Hard direction");
  println("                                 reversals invalidate; rare in real play, absorbed by next POSE.");
  println("  Q4 (contact classification)  : nose / body / wings each independently classify on impact.");
  println("  Q5 (plane-on-plane scoring)  : the anti-coordination rule holds at the data level:");
  println("                                 head-on -> 0/0, T-bone -> +5/0, tail-chase -> +5/0,");
  println("                                 wingtip clip -> +5/+5.  Forecast detects each well ahead of");
  println("                                 impact, classifies parts correctly, scoring derives cleanly.");
}

// ── Plane-on-plane case helpers ─────────────────────────────────────────

fn run_pair_case(label: text,
                 pos_a: Vec3, vel_a: Vec3, fac_a: integer,
                 pos_b: Vec3, vel_b: Vec3, fac_b: integer,
                 lookahead_ms: integer,
                 expected_a_score: integer, expected_b_score: integer) {
  fc = pair_forecast(pos_a, vel_a, fac_a, pos_b, vel_b, fac_b, lookahead_ms);
  if !fc.hit {
    println("  {label:24} | NO CONTACT FORECAST within {lookahead_ms} ms");
    return;
  }
  a_score = score_for(fc.contact_a_on_b);
  b_score = score_for(fc.contact_b_on_a);
  verdict = if a_score == expected_a_score && b_score == expected_b_score {
    "OK"
  } else {
    "MISMATCH (expected {expected_a_score}/{expected_b_score})"
  };
  println("  {label:24} | t={fc.t_ms:4}ms | A->B parts={contact_label(fc.contact_a_on_b):16} A score={a_score} | B->A parts={contact_label(fc.contact_b_on_a):16} B score={b_score} | {verdict}");
}

fn pair_case_head_on() {
  pos_a = Vec3 { x: -3.0, y: 0.0, z: 0.0 };
  vel_a = Vec3 { x:  20.0, y: 0.0, z: 0.0 };
  pos_b = Vec3 { x:  3.0, y: 0.0, z: 0.0 };
  vel_b = Vec3 { x: -20.0, y: 0.0, z: 0.0 };
  println("  scenario: head-on  — A(-3,0,0)+x@20  B(3,0,0)-x@20  (nose-vs-nose)");
  run_pair_case("P1: head-on", pos_a, vel_a, FACE_PX, pos_b, vel_b, FACE_NX, 500, 0, 0);
}

fn pair_case_tbone() {
  // A coming +x from afar, B stationary FACE_PY (body extends along y,
  // crossways to A's path; wings extend along x).  A starts at x=-10
  // so the FIRST contact is unambiguously A.nose vs B.wings (then
  // shortly after, A.nose vs B.body) — A's body hasn't reached B
  // yet.  Starting closer overlaps A's body against B's wings at
  // t=0, which gives B a body-contact and wrong score.
  pos_a = Vec3 { x: -10.0, y: 0.0, z: 0.0 };
  vel_a = Vec3 { x:  20.0, y: 0.0, z: 0.0 };
  pos_b = Vec3 { x:  0.0, y: 0.0, z: 0.0 };
  vel_b = Vec3 { x:   0.0, y: 0.0, z: 0.0 };
  println("  scenario: T-bone   — A(-10,0,0)+x@20  B(0,0,0)stationary FACE_PY  (A's nose first reaches B's wings)");
  run_pair_case("P2: T-bone", pos_a, vel_a, FACE_PX, pos_b, vel_b, FACE_PY, 500, 5, 0);
}

fn pair_case_tail_chase() {
  // Both heading +x; A faster behind B.  A.x catches up to B.x; A's nose
  // hits B's body from behind.
  pos_a = Vec3 { x: -3.0, y: 0.0, z: 0.0 };
  vel_a = Vec3 { x:  30.0, y: 0.0, z: 0.0 };
  pos_b = Vec3 { x:  0.0, y: 0.0, z: 0.0 };
  vel_b = Vec3 { x:  10.0, y: 0.0, z: 0.0 };
  println("  scenario: tail-chase — A(-3,0,0)+x@30  B(0,0,0)+x@10  (A catches B from behind)");
  run_pair_case("P3: tail-chase", pos_a, vel_a, FACE_PX, pos_b, vel_b, FACE_PX, 500, 5, 0);
}

fn pair_case_wingtip() {
  // Two planes parallel +x at same speed, offset in y by 3.8 m so wingtips
  // (each plane's wing reaches ±2.0 y) just touch at y = 1.9 / 1.9.  Same
  // x, so contact is immediate.  Trigger contact slightly out: A at y=0,
  // B at y=3.99 — wingtips overlap by 0.01 m.  Both move at same speed
  // so the y-gap stays constant.
  pos_a = Vec3 { x: 0.0, y: 0.0,   z: 0.0 };
  vel_a = Vec3 { x: 20.0, y: 0.0,  z: 0.0 };
  pos_b = Vec3 { x: 0.0, y: 3.99,  z: 0.0 };
  vel_b = Vec3 { x: 20.0, y: 0.0,  z: 0.0 };
  println("  scenario: wingtip  — A(0,0,0)+x@20  B(0,3.99,0)+x@20  (wing-tips brush at y=1.99)");
  run_pair_case("P4: wingtip clip", pos_a, vel_a, FACE_PX, pos_b, vel_b, FACE_PX, 500, 5, 5);
}
