//
// loft-view: branch-aware doc + code review viewer.
//
// Frozen binary built deliberately via `make view-build` from the
// loft repo root.  See doc/claude/plans/35-branch-review-viewer/
// for the full design + per-phase plans.
//
// Phase 01: HTTP server + project tree + raw file serving.
// Routes:
//   GET /                   landing page (entry-point links)
//   GET /tree/<path>        directory listing
//   GET /raw/<path>         raw file bytes (text/plain)
//   GET /static/style.css   minimal stylesheet
//   GET *                   404
//
// Project root = current working directory when the binary runs;
// loft sandboxes file I/O via valid_path() so paths can't escape.

use server;

const PORT: integer = 8765;

fn main() {
    // Future: read LOFT_VIEW_PORT once a stable env_variable + parse
    // path is settled.  Today: hard-coded.

    srv = server::listen(PORT);
    // Note: println at startup triggers a native-codegen dispatch-table
    // bug (see PROBLEMS § P262); silent for now.  Revisit when P262 is
    // closed.

    while true {
        req = srv.next();
        if req == null { continue; }
        route(req);
    }
}

fn route(req: server::Request) {
    p = req.path;
    if p == "/" {
        body = page_landing();
        req.respond_html(body);
    } else if p == "/static/style.css" {
        // Bind to local — works around a native codegen quirk that
        // takes &<call-result> when a text constant is passed inline.
        css = BASE_CSS;
        req.respond_css(css);
    } else if p == "/favicon.ico" {
        req.respond_404();
    } else if p.starts_with("/tree/") {
        rel = p[6..len(p)];
        body = page_tree(rel);
        req.respond_html(body);
    } else if p == "/tree" {
        body = page_tree("");
        req.respond_html(body);
    } else if p.starts_with("/raw/") {
        rel = p[5..len(p)];
        respond_raw(req, rel);
    } else if p.starts_with("/file/") {
        rel = p[6..len(p)];
        respond_file(req, rel);
    } else if p.starts_with("/tag/") {
        tag = p[5..len(p)];
        body = page_tag(tag);
        req.respond_html(body);
    } else {
        serve_404_page(req, p);
    }
}

// ── HTML escape ──────────────────────────────────────────────

fn escape(s: text) -> text {
    out = "";
    for c in s {
        if c == '&' {
            out += "&amp;";
        } else if c == '<' {
            out += "&lt;";
        } else if c == '>' {
            out += "&gt;";
        } else if c == '"' {
            out += "&quot;";
        } else {
            out += "{c}";
        }
    }
    out
}

// ── Page templates ───────────────────────────────────────────

fn page_landing() -> text {
    body = "<h1>loft-view <small>phase 02 + 04a</small></h1>";
    body += "<p>Branch-aware doc + code review viewer.";
    body += " Phase 04 (git dashboard) + phase 03 (markdown) still pending;";
    body += " phase 04a (tracker-tag references) shipped.</p>";
    body += "<h2>Browse the project</h2>";
    body += "<ul>";
    body += "<li><a href=\"/tree/doc\">doc/</a></li>";
    body += "<li><a href=\"/tree/lib\">lib/</a></li>";
    body += "<li><a href=\"/tree/src\">src/</a></li>";
    body += "<li><a href=\"/tree/tests\">tests/</a></li>";
    body += "<li><a href=\"/tree/tools\">tools/</a></li>";
    body += "<li><a href=\"/tree/default\">default/</a></li>";
    body += "<li><a href=\"/tree/examples\">examples/</a></li>";
    body += "</ul>";
    body += "<p><a href=\"/file/README.md\">README.md</a> ";
    body += "(<a href=\"/raw/README.md\">raw</a>)</p>";
    body += "<h2>Tracker tags</h2>";
    body += "<p>Lookup form: <code>/tag/&lt;bare-name&gt;</code>.  Examples:";
    body += " <a href=\"/tag/P259\">/tag/P259</a>,";
    body += " <a href=\"/tag/P262\">/tag/P262</a>,";
    body += " <a href=\"/tag/PLAN35\">/tag/PLAN35</a>,";
    body += " <a href=\"/tag/PLAN37\">/tag/PLAN37</a>.</p>";
    page("loft-view", body)
}

fn page_tree(rel: text) -> text {
    f = file(rel);
    if f.format == Format.NotExists {
        // Caller (route()) wraps with respond_html which uses 200 OK;
        // /tree/<missing> is presented as a regular missing page.
        // For the dedicated 404 status code, /raw/ uses serve_404_page.
        return page_404("/tree/{rel}");
    }
    if f.format != Format.Directory {
        // Not a dir — redirect-style: link to /raw/<path>.
        esc_rel = escape(rel);
        body = "<h1>{esc_rel}</h1>";
        body += "<p>Not a directory.";
        body += " <a href=\"/raw/{esc_rel}\">View raw</a>.</p>";
        return page(rel, body);
    }

    // Bind nested text calls to locals — works around P262 (native
    // codegen quirk: text-returning calls passed inline get an extra
    // `&` wrap in the generated Rust, fail to compile).
    body = breadcrumbs(rel, "tree");
    esc_rel = escape(rel);
    body += "<h1>{esc_rel}/</h1>";
    body += "<ul class=\"dir\">";
    if rel != "" {
        parent = parent_of(rel);
        esc_parent = escape(parent);
        body += "<li><a href=\"/tree/{esc_parent}\">..</a></li>";
    }

    // Two passes: dirs then files; alphabetical within.
    entries = f.files();
    for e in entries {
        if e.format == Format.Directory && !skip(e.path) {
            name = basename(e.path);
            joined = rel_join(rel, name);
            esc_joined = escape(joined);
            esc_name = escape(name);
            body += "<li><a class=\"d\" href=\"/tree/{esc_joined}\">{esc_name}/</a></li>";
        }
    }
    for e in entries {
        if e.format != Format.Directory && !skip(e.path) {
            name = basename(e.path);
            joined = rel_join(rel, name);
            esc_joined = escape(joined);
            esc_name = escape(name);
            sz = e.size;
            // Link to /file/ for rendered view; /raw/ available from
            // the file page itself for "give me the bytes."
            body += "<li><a class=\"f\" href=\"/file/{esc_joined}\">{esc_name}</a> <span class=\"sz\">{sz}</span></li>";
        }
    }
    body += "</ul>";
    title = "{rel}/";
    page(title, body)
}

fn respond_raw(req: server::Request, rel: text) {
    f = file(rel);
    if f.format == Format.NotExists {
        serve_404_page(req, "/raw/{rel}");
        return;
    }
    if f.format == Format.Directory {
        body = page_tree(rel);
        req.respond_html(body);
        return;
    }
    body = f.content();
    req.respond_typed(200, body, "text/plain; charset=utf-8");
}

// ── /file/<path> — phase 02: rendered code with line numbers ──

fn respond_file(req: server::Request, rel: text) {
    f = file(rel);
    if f.format == Format.NotExists {
        serve_404_page(req, "/file/{rel}");
        return;
    }
    if f.format == Format.Directory {
        // Directories: redirect-style — show the tree page.
        body = page_tree(rel);
        req.respond_html(body);
        return;
    }
    // For now: every file is rendered as code (HTML-escaped + line
    // numbers).  Markdown gets a stub link to phase 03's renderer
    // when it lands; binary detection is a v1.5 polish.
    body = page_file(rel, f);
    req.respond_html(body);
}

// File-extension classifier.  Markdown gets a special path; .png /
// .jpg / .gif fall into Binary so we don't try to render bytes as
// text.  Everything else renders as code.
fn is_markdown(rel: text) -> boolean {
    rel.ends_with(".md")
}
fn is_binary_ext(rel: text) -> boolean {
    rel.ends_with(".png")
        || rel.ends_with(".jpg")
        || rel.ends_with(".jpeg")
        || rel.ends_with(".gif")
        || rel.ends_with(".webp")
        || rel.ends_with(".ico")
        || rel.ends_with(".pdf")
        || rel.ends_with(".zip")
        || rel.ends_with(".gz")
        || rel.ends_with(".tar")
        || rel.ends_with(".wasm")
}

fn page_file(rel: text, f: File) -> text {
    body = breadcrumbs(rel, "file");
    esc_rel = escape(rel);
    sz = f.size;
    body += "<h1>{esc_rel} <small>{sz} bytes</small></h1>";

    if is_binary_ext(rel) {
        esc2 = escape(rel);
        body += "<p>Binary file ({sz} bytes).  ";
        body += "<a href=\"/raw/{esc2}\">download raw</a></p>";
        return page(rel, body);
    }

    esc2 = escape(rel);
    body += "<p><a href=\"/raw/{esc2}\">View raw</a></p>";

    src = f.content();
    if is_markdown(rel) {
        body += md_render(src, rel);
    } else {
        body += render_code(src);
    }
    page(rel, body)
}

// ── Markdown renderer (plan-35 phase 03) ─────────────────────
//
// Minimal subset: headings, paragraphs, fenced code blocks,
// inline code, bold/italic, links with relative-path rewriting.
// Lists / tables / block quotes deferred to a follow-up phase.
//
// Walks source line-by-line; tracks fenced-code context as the
// only stateful block.  Inline rendering iterates per character
// and accumulates output, slicing the source only at known-safe
// boundaries (after a `\n` split) — avoids the "Invalid index
// on string" failure mode the original attempt hit on
// substring-position arithmetic.

fn md_render(src: text, current_rel: text) -> text {
    out = "";
    in_code = false;
    code_buf = "";
    code_lang = "";
    para_buf = "";
    // List state: list_kind = "" (no list), "ul" or "ol".
    // list_item_buf holds the in-progress item's text — flushed as
    // <li>...</li> when the next item starts or the list closes.
    list_kind = "";
    list_item_buf = "";
    // Table state: table_rows accumulates header + body lines while
    // we're inside a table.  table_state = 0 idle, 1 saw header
    // (waiting on separator), 2 in body.
    table_state = 0;
    table_header = "";

    lines = src.split('\n');
    for line in lines {
        if in_code {
            if line.starts_with("```") {
                esc_code = escape(code_buf);
                esc_lang = escape(code_lang);
                if len(esc_lang) > 0 {
                    out += "<pre><code class=\"language-{esc_lang}\">{esc_code}</code></pre>";
                } else {
                    out += "<pre><code>{esc_code}</code></pre>";
                }
                code_buf = "";
                code_lang = "";
                in_code = false;
            } else {
                code_buf += "{line}\n";
            }
            continue;
        }
        // ── Table state machine ─────────────────────────────────
        // table_state == 1: expecting the |---|---| separator
        // table_state == 2: in table body — accumulate <tr> rows
        if table_state == 1 {
            if md_is_table_separator(line) {
                // Confirm header — emit <table><thead> for the saved
                // header line, then start body.
                out += "<table><thead>{md_render_table_row(table_header, true, current_rel)}</thead><tbody>";
                table_state = 2;
                continue;
            } else {
                // Header without separator → not a table after all.
                // Replay the saved header line as a paragraph.
                table_state = 0;
                if len(para_buf) > 0 {
                    para_buf += " {table_header}";
                } else {
                    para_buf = table_header;
                }
                table_header = "";
                // fall through to normal handling for `line`
            }
        } else if table_state == 2 {
            if md_is_table_row(line) {
                out += md_render_table_row(line, false, current_rel);
                continue;
            } else {
                out += "</tbody></table>";
                table_state = 0;
                // fall through to normal handling for `line`
            }
        }
        // ── List state machine ─────────────────────────────────
        // Each list item is buffered in `list_item_buf` until a
        // boundary closes it: next item, blank line, non-list non-
        // indented line, or end-of-input.  Indented continuation
        // lines (3+ leading spaces) append to the current item
        // with a single space — same shape as Markdown spec.
        if list_kind != "" {
            ul_item = md_is_ul_item(line);
            ol_item = md_is_ol_item(line);
            if ul_item || ol_item {
                // Flush previous item, start a new one.
                out += "<li>{md_inline(list_item_buf, current_rel)}</li>";
                list_item_buf = md_strip_list_marker(line);
                continue;
            }
            if line == "" {
                // Blank line — keep list open across the blank;
                // the next list item will append.  But we must
                // flush the in-progress item now so its content
                // is already in the output if the list ends.
                continue;
            }
            if line.starts_with(" ") {
                // Indented continuation — strip leading whitespace
                // and append to current item with a single space.
                // Plan READMEs use 2-space indent; the spec usually
                // demands 3+ but real-world docs aren't strict.
                trimmed = line.trim();
                if list_item_buf == "" {
                    list_item_buf = trimmed;
                } else {
                    list_item_buf += " {trimmed}";
                }
                continue;
            }
            // Non-list, non-indented, non-blank — close the list.
            out += "<li>{md_inline(list_item_buf, current_rel)}</li>";
            list_item_buf = "";
            out += "</{list_kind}>";
            list_kind = "";
            // fall through to normal handling for `line`
        }
        if line.starts_with("```") {
            if len(para_buf) > 0 {
                out += "<p>{md_inline(para_buf, current_rel)}</p>";
                para_buf = "";
            }
            n = len(line);
            if n > 3 { code_lang = line[3..n]; }
            in_code = true;
            continue;
        }
        if line.starts_with("<!--") {
            continue;
        }
        if line == "---" || line == "***" || line == "___" {
            if len(para_buf) > 0 {
                out += "<p>{md_inline(para_buf, current_rel)}</p>";
                para_buf = "";
            }
            out += "<hr>";
            continue;
        }
        hlevel = md_heading_level(line);
        if hlevel > 0 {
            if len(para_buf) > 0 {
                out += "<p>{md_inline(para_buf, current_rel)}</p>";
                para_buf = "";
            }
            ln = len(line);
            start = hlevel + 1;
            heading_text = "";
            if start < ln { heading_text = line[start..ln]; }
            slug = md_slugify(heading_text);
            esc_slug = escape(slug);
            inline = md_inline(heading_text, current_rel);
            out += "<h{hlevel} id=\"{esc_slug}\">{inline}</h{hlevel}>";
            continue;
        }
        // ── List opens? ────────────────────────────────────────
        if md_is_ul_item(line) {
            if len(para_buf) > 0 {
                out += "<p>{md_inline(para_buf, current_rel)}</p>";
                para_buf = "";
            }
            list_kind = "ul";
            out += "<ul>";
            list_item_buf = md_strip_list_marker(line);
            continue;
        }
        if md_is_ol_item(line) {
            if len(para_buf) > 0 {
                out += "<p>{md_inline(para_buf, current_rel)}</p>";
                para_buf = "";
            }
            list_kind = "ol";
            out += "<ol>";
            list_item_buf = md_strip_list_marker(line);
            continue;
        }
        // ── Table opens? ───────────────────────────────────────
        if md_is_table_row(line) {
            if len(para_buf) > 0 {
                out += "<p>{md_inline(para_buf, current_rel)}</p>";
                para_buf = "";
            }
            table_header = line;
            table_state = 1;
            continue;
        }
        if line == "" {
            if len(para_buf) > 0 {
                out += "<p>{md_inline(para_buf, current_rel)}</p>";
                para_buf = "";
            }
            continue;
        }
        if len(para_buf) > 0 {
            para_buf += " {line}";
        } else {
            para_buf = line;
        }
    }
    if list_kind != "" {
        out += "<li>{md_inline(list_item_buf, current_rel)}</li>";
        out += "</{list_kind}>";
        list_item_buf = "";
    }
    if table_state == 2 { out += "</tbody></table>"; }
    if in_code {
        esc_code = escape(code_buf);
        out += "<pre><code>{esc_code}</code></pre>";
    } else if len(para_buf) > 0 {
        out += "<p>{md_inline(para_buf, current_rel)}</p>";
    }
    out
}

// True for `- item` / `* item` (one-space-after-marker).
fn md_is_ul_item(line: text) -> boolean {
    line.starts_with("- ") || line.starts_with("* ")
}

// True for `N. item` (one-or-more digits + period + space).
fn md_is_ol_item(line: text) -> boolean {
    n = line.len();
    if n < 3 { return false; }
    i = 0;
    while i < n && line[i] >= '0' && line[i] <= '9' {
        i = i + 1;
    }
    if i == 0 { return false; }
    if i + 1 >= n { return false; }
    line[i] == '.' && line[i + 1] == ' '
}

// Strip the `- ` / `* ` / `N. ` prefix from a list line.
fn md_strip_list_marker(line: text) -> text {
    n = line.len();
    if line.starts_with("- ") || line.starts_with("* ") {
        return line[2..n];
    }
    // Ordered: skip digits + `.` + ` `
    i = 0;
    while i < n && line[i] >= '0' && line[i] <= '9' {
        i = i + 1;
    }
    if i + 1 < n && line[i] == '.' && line[i + 1] == ' ' {
        return line[i + 2..n];
    }
    line
}

// True if the line starts with `|` and contains at least one more
// `|` — minimum-shape detection for a table row.
fn md_is_table_row(line: text) -> boolean {
    if !line.starts_with("|") { return false; }
    n = line.len();
    if n < 3 { return false; }
    i = 1;
    while i < n {
        if line[i] == '|' { return true; }
        i = i + 1;
    }
    false
}

// True if the line is the table header/body separator: `|---|---|`
// or `|:--|--:|` etc.  Cells must contain only `-`, `:`, and
// optional spaces.
fn md_is_table_separator(line: text) -> boolean {
    if !md_is_table_row(line) { return false; }
    n = line.len();
    i = 0;
    while i < n {
        c = line[i];
        if c != '|' && c != '-' && c != ':' && c != ' ' { return false; }
        i = i + 1;
    }
    true
}

// Render one table row as `<tr><th>...</th>...</tr>` or
// `<tr><td>...</td>...</tr>`.  Cells split on `|`; leading/trailing
// empty cells (from leading/trailing `|`) are dropped.
fn md_render_table_row(line: text, is_header: boolean, current_rel: text) -> text {
    cells = line.split('|');
    out = "<tr>";
    tag = "td";
    if is_header { tag = "th"; }
    for cell in cells {
        trimmed = cell.trim();
        if trimmed == "" { continue; }
        out += "<{tag}>{md_inline(trimmed, current_rel)}</{tag}>";
    }
    out += "</tr>";
    out
}

// Count the leading `#` characters of a line.  Returns 1..=6 for a
// valid heading (must be followed by a space or end-of-line), 0
// otherwise.
fn md_heading_level(line: text) -> integer {
    n = len(line);
    if n == 0 { return 0; }
    count = 0;
    i = 0;
    while i < n && line[i] == '#' {
        count = count + 1;
        i = i + 1;
    }
    if count < 1 || count > 6 { return 0; }
    // Must be followed by a space (or EOL).  `# title` valid;
    // `#tag` invalid (treated as paragraph).
    if i < n && line[i] != ' ' { return 0; }
    count
}

// GitHub-compatible heading slug: lowercase, spaces → `-`, drop
// any char outside [a-z0-9_-].  ASCII subset only — covers all
// loft docs.  Multi-byte chars pass through `for c in heading`
// as their UTF-8 bytes, which the filter then drops; that's
// the desired behaviour.
fn md_slugify(heading: text) -> text {
    out = "";
    for c in heading {
        if c == ' ' {
            out += "-";
        } else if c >= 'a' && c <= 'z' {
            out += "{c}";
        } else if c >= 'A' && c <= 'Z' {
            // ASCII lowercase: c + ('a' - 'A')
            shifted = (c - 'A') + 'a';
            out += "{shifted}";
        } else if c >= '0' && c <= '9' {
            out += "{c}";
        } else if c == '-' || c == '_' {
            out += "{c}";
        }
        // else: drop punctuation / non-ASCII
    }
    out
}

// Inline renderer: walks the source character-by-character,
// emitting HTML for `**bold**`, `*italic*`, `` `code` ``, and
// `[text](url)` link forms.  Everything else is HTML-escaped
// passthrough.  Stateful via a small flag set; no recursion.
fn md_inline(src: text, current_rel: text) -> text {
    out = "";
    n = len(src);
    i = 0;
    while i < n {
        c = src[i];
        if c == '`' {
            // Inline code: scan to next backtick.  P272: collect the
            // run via a single SLICE rather than per-byte accumulation,
            // because src[i] returns the codepoint at byte i — for a
            // multi-byte char, accumulating "{src[i]}" once per byte
            // re-emits the codepoint N times.  Slice preserves bytes.
            i = i + 1;
            code_start = i;
            while i < n && src[i] != '`' {
                i = i + 1;
            }
            code = src[code_start..i];
            if i < n { i = i + 1; }  // consume closing `
            esc_code = escape(code);
            out += "<code>{esc_code}</code>";
            continue;
        }
        if c == '*' && i + 1 < n && src[i + 1] == '*' {
            // Bold: scan to next `**`.  Inner text via SLICE (P272).
            i = i + 2;
            inner_start = i;
            while i + 1 < n && !(src[i] == '*' && src[i + 1] == '*') {
                i = i + 1;
            }
            inner = src[inner_start..i];
            if i + 1 < n { i = i + 2; }  // consume closing **
            esc_inner = escape(inner);
            out += "<strong>{esc_inner}</strong>";
            continue;
        }
        if c == '*' || c == '_' {
            // Italic: scan to matching delimiter.  `_` only opens
            // italic at non-alnum start to avoid `snake_case` false
            // positives.  Inner text via SLICE (P272).
            open = c;
            looks_like_italic = true;
            if open == '_' && i > 0 {
                prev = src[i - 1];
                if (prev >= 'a' && prev <= 'z') || (prev >= 'A' && prev <= 'Z') || (prev >= '0' && prev <= '9') {
                    looks_like_italic = false;
                }
            }
            if looks_like_italic {
                i = i + 1;
                inner_start = i;
                while i < n && src[i] != open {
                    i = i + 1;
                }
                inner = src[inner_start..i];
                if i < n { i = i + 1; }
                esc_inner = escape(inner);
                out += "<em>{esc_inner}</em>";
                continue;
            }
            // Else fall through to plain emit.
        }
        if c == '[' {
            // Link: [text](url) — find ](
            text_start = i + 1;
            j = text_start;
            depth = 1;
            while j < n && depth > 0 {
                if src[j] == ']' { depth = depth - 1; if depth == 0 { break; } }
                else if src[j] == '[' { depth = depth + 1; }
                j = j + 1;
            }
            if j < n && j + 1 < n && src[j + 1] == '(' {
                link_text = src[text_start..j];
                url_start = j + 2;
                k = url_start;
                while k < n && src[k] != ')' {
                    k = k + 1;
                }
                if k < n {
                    url = src[url_start..k];
                    // Inline md_rewrite_link to avoid the codegen
                    // work-buffer accounting issue when a text-
                    // returning helper is called from inside another
                    // text-returning function.
                    is_abs = url.starts_with("http://")
                        || url.starts_with("https://")
                        || url.starts_with("mailto:")
                        || url.starts_with("#");
                    rewritten = url;
                    if !is_abs {
                        base = parent_of(current_rel);
                        anchor = "";
                        target = url;
                        hash_at = url.find("#");
                        if hash_at >= 0 {
                            ulen = url.len();
                            target = url[0..hash_at];
                            anchor = url[hash_at..ulen];
                        }
                        // Strip leading "./"
                        cleaned = target;
                        while cleaned.starts_with("./") {
                            cl = cleaned.len();
                            cleaned = cleaned[2..cl];
                        }
                        // Apply "../" segments
                        cur_base = base;
                        while cleaned.starts_with("../") {
                            cur_base = parent_of(cur_base);
                            cl = cleaned.len();
                            cleaned = cleaned[3..cl];
                        }
                        if cur_base == "" {
                            rewritten = "/file/{cleaned}{anchor}";
                        } else {
                            rewritten = "/file/{cur_base}/{cleaned}{anchor}";
                        }
                    }
                    esc_url = escape(rewritten);
                    esc_text = escape(link_text);
                    out += "<a href=\"{esc_url}\">{esc_text}</a>";
                    i = k + 1;
                    continue;
                }
            }
        }
        // Default: HTML-escape the single codepoint and advance i
        // by its UTF-8 byte length (P272 — advancing by 1 would
        // re-emit a multi-byte codepoint N times since src[i]
        // returns the codepoint at byte i, the same for all N
        // bytes of the codepoint).  ASCII chars (incl. the four
        // entity-escape special cases) are 1 byte so the special
        // branches keep i + 1.
        if c == '&' { out += "&amp;"; i = i + 1; }
        else if c == '<' { out += "&lt;"; i = i + 1; }
        else if c == '>' { out += "&gt;"; i = i + 1; }
        else if c == '"' { out += "&quot;"; i = i + 1; }
        else {
            char_str = "{c}";
            out += char_str;
            i = i + len(char_str);
        }
    }
    out
}

// Render a text blob as line-numbered, HTML-escaped <pre><code>.
// Each line wrapped in <a id="L<n>"> so #L42 fragment scrolls.
fn render_code(src: text) -> text {
    out = "<pre class=\"code-pre\"><code>";
    line_no = 1;
    line_buf = "";
    for c in src {
        if c == '\n' {
            esc = escape_with_tabs(line_buf);
            out += "<a id=\"L{line_no}\" class=\"line\"><span class=\"lineno\">{line_no}</span><span class=\"src\">{esc}</span></a>";
            line_buf = "";
            line_no = line_no + 1;
        } else if c == '\r' {
            // Drop \r — handles CRLF line endings.
        } else {
            line_buf += "{c}";
        }
    }
    if len(line_buf) > 0 {
        esc = escape_with_tabs(line_buf);
        out += "<a id=\"L{line_no}\" class=\"line\"><span class=\"lineno\">{line_no}</span><span class=\"src\">{esc}</span></a>";
    }
    out += "</code></pre>";
    out
}

// Like escape() but expands tabs to 4 spaces so indentation
// renders consistently regardless of browser default tab width.
fn escape_with_tabs(s: text) -> text {
    out = "";
    for c in s {
        if c == '&' {
            out += "&amp;";
        } else if c == '<' {
            out += "&lt;";
        } else if c == '>' {
            out += "&gt;";
        } else if c == '"' {
            out += "&quot;";
        } else if c == '\t' {
            out += "    ";
        } else {
            out += "{c}";
        }
    }
    out
}

// ── /tag/<bare_name> — phase 04a: tracker-tag references ──
//
// Reads index/tags.json (produced by `make index`) and lists every
// reference to a tag.  URL form is `/tag/P259` or `/tag/PLAN35-01`
// (bare name); the page surfaces BOTH the `@P259` and the legacy
// `legacy:P259` buckets together so the user sees the full footprint
// during the migration.

fn page_tag(tag: text) -> text {
    f = file("index/tags.json");
    if f.format == Format.NotExists {
        body = "<h1>Tracker tag <code>{escape(tag)}</code></h1>";
        body += "<p class=\"warn\">No index found at <code>index/tags.json</code>.";
        body += " Run <code>make index</code> from the repo root to build it.</p>";
        body += "<p><a href=\"/\">back to landing</a></p>";
        title = "@{tag}";
        return page(title, body);
    }

    raw = f.content();
    root = json_parse(raw);

    // Two buckets: @-prefixed (canonical) + legacy (bare-name).  Both
    // get rendered together so the page is the full reference list
    // regardless of which form authors used in any given file.
    at_key = "@{tag}";
    legacy_key = "legacy:{tag}";
    at_arr = root.field(at_key);
    legacy_arr = root.field(legacy_key);

    at_count = 0;
    if at_arr.kind() == "JArray" { at_count = at_arr.len(); }
    legacy_count = 0;
    if legacy_arr.kind() == "JArray" { legacy_count = legacy_arr.len(); }
    total = at_count + legacy_count;

    body = "<h1>Tracker tag <code>{escape(tag)}</code> <small>{total} references</small></h1>";

    if total == 0 {
        body += "<p>No references found.</p>";
        body += "<p><a href=\"/\">back to landing</a></p>";
        title = "@{tag}";
        return page(title, body);
    }

    if at_count > 0 {
        body += "<h2><code>@{escape(tag)}</code> (canonical) — {at_count}</h2>";
        body += render_refs(at_arr);
    }
    if legacy_count > 0 {
        body += "<h2><code>{escape(tag)}</code> (legacy bare-name) — {legacy_count}</h2>";
        body += render_refs(legacy_arr);
    }

    body += "<p><a href=\"/\">back to landing</a></p>";
    title = "@{tag}";
    page(title, body)
}

// Render a JArray of {file, line, context} entries as <ul>.  Each
// entry links to /file/<path>#L<line> so the line viewer scrolls
// directly to the cited line (phase 02 emits the L<n> anchors).
fn render_refs(arr: JsonValue) -> text {
    out = "<ul class=\"refs\">";
    n = arr.len();
    i = 0;
    while i < n {
        ref_v = arr.item(i);
        file_path = ref_v.field("file").as_text();
        line_n = ref_v.field("line").as_long();
        ctx = ref_v.field("context").as_text();
        esc_file = escape(file_path);
        esc_ctx = escape(ctx);
        out += "<li><a href=\"/file/{esc_file}#L{line_n}\">{esc_file}:{line_n}</a><br><code>{esc_ctx}</code></li>";
        i = i + 1;
    }
    out += "</ul>";
    out
}

fn serve_404_page(req: server::Request, p: text) {
    body = page_404(p);
    req.respond_typed(404, body, "text/html; charset=utf-8");
}

fn page_404(p: text) -> text {
    esc_p = escape(p);
    body = "<h1>404 — not found</h1>";
    body += "<p>No route matches <code>{esc_p}</code>.</p>";
    body += "<p><a href=\"/\">back to landing</a></p>";
    page("404", body)
}

// ── Layout shell ─────────────────────────────────────────────

fn page(title: text, body: text) -> text {
    esc_title = escape(title);
    out = "<!doctype html>";
    out += "<html lang=\"en\"><head>";
    out += "<meta charset=\"utf-8\">";
    out += "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">";
    out += "<title>{esc_title} — loft-view</title>";
    out += "<link rel=\"stylesheet\" href=\"/static/style.css\">";
    out += "</head><body>";
    out += "<header><a href=\"/\" class=\"home\">loft-view</a></header>";
    out += "<main>";
    out += body;
    out += "</main>";
    out += "<footer>plan-35 phase 02 · "
        + "<a href=\"/tree/doc/claude/plans/35-branch-review-viewer\">design</a>"
        + "</footer>";
    out += "</body></html>";
    out
}

fn breadcrumbs(rel: text, kind: text) -> text {
    if rel == "" { return ""; }
    out = "<nav class=\"crumbs\">";
    out += "<a href=\"/\">/</a>";
    parts = rel.split('/');
    acc = "";
    for p in parts {
        if p == "" { continue; }
        if acc == "" { acc = p; } else { acc = "{acc}/{p}"; }
        esc_acc = escape(acc);
        esc_p = escape(p);
        out += " / <a href=\"/{kind}/{esc_acc}\">{esc_p}</a>";
    }
    out += "</nav>";
    out
}

// ── Path utilities ───────────────────────────────────────────

fn parent_of(rel: text) -> text {
    last_slash = rel.rfind("/");
    if last_slash < 0 { return ""; }
    rel[0..last_slash]
}

fn basename(path: text) -> text {
    last_slash = path.rfind("/");
    if last_slash < 0 { return path; }
    path[last_slash + 1..len(path)]
}

fn rel_join(base: text, name: text) -> text {
    if base == "" { return name; }
    "{base}/{name}"
}

// Skip-list for tree walks.  Keeps the listing focused.
fn skip(path: text) -> boolean {
    name = basename(path);
    name == ".git"
        || name == "target"
        || name == ".loft"
        || name == "node_modules"
        || name == ".cache"
        || name.starts_with(".fuse_hidden")
}

