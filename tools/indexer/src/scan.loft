//
// @PLAN37 phase 07 — loft-native tracker-index scanner.
//
// Single-shot mode: walks a fixed set of source roots, finds
// every `@P<n>` and `@PLAN<n>(-<seg>)*` reference in indexable
// files, and prints one JSON-Lines record per match to stdout.
// Each line is a self-contained object:
//
//   {"tag":"@P259","file":"a.md","line":42,"context":"..."}
//
// Bucketing into the `index/tags.json` per-tag-array shape
// happens downstream via jq (one liner; cheaper than building
// the nested structure in loft and easier to test).  Matches
// the bash scanner's tag set on committed code (asserted by
// `tests/index_hygiene.rs::index_hygiene_clean`).
//
// Still-open follow-ups (each its own commit): full
// `tags.json` emission (legacy buckets, broken validation,
// markdown links, problems_*, plans_*), `lib/fs_watch/` for
// `--watch` mode, WebSocket daemon, CLI client, standalone
// binary build.
//
// The bash scanner remains the canonical bootstrap path —
// `make index` still drives `scan.sh`.  This binary is the
// loft-side equivalent that `make index-loft` runs.

// Roots returned from a fn rather than a `const vector<text>`
// because the native backend doesn't yet wire module-scope
// vector consts into `stores.const_refs` — emit reads index 565
// from a zero-length slice and crashes.  Pre-existing native
// gap; will file a P-issue separately.  The fn-local literal
// works in both backends and the call cost is one allocation
// per `main()` invocation, which is fine for a single-shot
// scanner.
fn source_roots() -> vector<text> {
    // Match the set bash's `git ls-files` enumerates.  `examples`
    // is included optimistically (currently empty); `.claude` and
    // `.config` are dot-dirs that git tracks intentionally.
    [".claude", ".config", "bench", "default", "doc", "lib", "scripts", "src", "tests", "tools", "examples"]
}

// ── Leaf helpers (declared first so the validators below can
// resolve their return types without depending on loft's
// two-pass forward-resolution — @P281 workaround).
//
// `basename_leaf` removed in @PLAN37 phase 10.16: the stdlib
// `text.basename()` method (added in 10.9) replaces it.

// True for ASCII digits.
fn is_digit_leaf(c: character) -> boolean {
    c >= '0' && c <= '9'
}

// True for `[a-zA-Z0-9_]` — the boundary class that the bash
// scanner's `\B` / `\b` checks effectively gate against.
fn is_word_char_leaf(c: character) -> boolean {
    if c >= '0' && c <= '9' { return true; }
    if c >= 'a' && c <= 'z' { return true; }
    if c >= 'A' && c <= 'Z' { return true; }
    c == '_'
}

// Build the set of valid P-issue numbers from PROBLEMS.md.
// Each row starts `| <num> | **@P<num>** — ...`; the leading
// `^| <digits> |` is the source of truth for which P-ids
// exist.  Returned as a `vector<text>` of bare numeric strings
// (no `@P` prefix) — same shape scan.sh's `VALID_PIDS` uses.
fn read_valid_pids() -> vector<text> {
    out: vector<text> = [];
    f = file("doc/claude/PROBLEMS.md");
    if f.format == Format.NotExists { return out; }
    src = f.content();
    n = src.len();
    line_start = 0;
    i = 0;
    while i <= n {
        if i == n || src[i] == '\n' {
            line = src[line_start..i];
            // Match `^| <digits> |`.  Pull the digits between
            // the two pipes.
            ll = line.len();
            if ll > 4 && line[0] == '|' && line[1] == ' '
                && ll > 2 && is_digit_leaf(line[2]) {
                j = 2;
                while j < ll && is_digit_leaf(line[j]) { j = j + 1; }
                if j + 2 <= ll && line[j] == ' ' && line[j + 1] == '|' {
                    pid = line[2..j];
                    out += [pid];
                }
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    out
}

// Build the set of valid plan numbers by walking the plan
// directories under `doc/claude/plans/` and `doc/claude/lib_plans/`.
// Each plan's directory name starts with digits then `-` then
// a slug (e.g., `37-tracker-index`).  Returned as bare numeric
// strings — same shape scan.sh's `VALID_PLANS` uses.  Walks
// the four sub-buckets (top-level / future / deferred /
// finished) to match scan.sh.
fn read_valid_plans() -> vector<text> {
    out: vector<text> = [];
    walk_plan_dirs("doc/claude/plans", out);
    walk_plan_dirs("doc/claude/plans/future", out);
    walk_plan_dirs("doc/claude/plans/deferred", out);
    walk_plan_dirs("doc/claude/plans/finished", out);
    walk_plan_dirs("doc/claude/lib_plans", out);
    walk_plan_dirs("doc/claude/lib_plans/future", out);
    walk_plan_dirs("doc/claude/lib_plans/deferred", out);
    walk_plan_dirs("doc/claude/lib_plans/finished", out);
    out
}

fn walk_plan_dirs(root: text, out: vector<text>) {
    f = file(root);
    if f.format == Format.NotExists { return; }
    if f.format != Format.Directory { return; }
    children = f.files();
    for child in children {
        if child.format != Format.Directory { continue; }
        // Plan dir basenames start with digits, then `-`.
        cp = child.path;
        base = cp.basename();
        bl = base.len();
        if bl < 2 { continue; }
        first_c = base[0];
        if !is_digit_leaf(first_c) { continue; }
        j = 0;
        while j < bl && is_digit_leaf(base[j]) { j = j + 1; }
        if j < bl {
            sep_c = base[j];
            if sep_c == '-' {
                pid = base[0..j];
                out += [pid];
            }
        }
    }
}

// Linear "is in" check.  `valid_set` holds <300 entries; a
// vector + linear scan is fine and avoids needing a hash type.
fn set_contains(valid_set: vector<text>, needle: text) -> boolean {
    for v in valid_set {
        if v == needle { return true; }
    }
    false
}

// Classify a tag as valid (resolves to an existing PROBLEMS
// row or plan dir) or broken.  Mirrors scan.sh's broken-tag
// validator: `@P<n>[<letter>]` validates against PROBLEMS.md
// row IDs (with optional letter stripped); `@PLAN<n>(-...)`
// validates against the plan-dir number prefix (sub-phase
// suffixes like `-04-iii.a` ignored — matches scan.sh's "v1
// rule" of parent-plan-only validation).  Legacy bare-name
// refs (`legacy:P<n>`, `legacy:plan-<n>`) are accepted as-is
// (the migration index doesn't gate them — same as scan.sh).
fn tag_is_valid(tag: text, valid_pids: vector<text>, valid_plans: vector<text>) -> boolean {
    tlen = tag.len();
    if tlen == 0 { return true; }
    // Legacy refs are never marked broken.
    if tag.starts_with("legacy:") { return true; }
    if tag.starts_with("@PLAN") {
        // Extract the digit prefix immediately after @PLAN.
        i = 5;
        if i >= tlen || !is_digit_leaf(tag[i]) { return true; }
        j = i;
        while j < tlen && is_digit_leaf(tag[j]) { j = j + 1; }
        num = tag[i..j];
        return set_contains(valid_plans, num);
    }
    if tag.starts_with("@P") {
        // Extract the digit prefix; strip an optional trailing
        // letter (`@P229b` → `229`).
        i = 2;
        if i >= tlen || !is_digit_leaf(tag[i]) { return true; }
        j = i;
        while j < tlen && is_digit_leaf(tag[j]) { j = j + 1; }
        num = tag[i..j];
        return set_contains(valid_pids, num);
    }
    true
}

// Scratch struct used by the bucketed emission path —
// `sorted<TagSlot[name]>` gives us a distinct, alphabetically
// sorted set of tag names that we can iterate to produce the
// per-tag arrays in `index/tags.json`-shape JSON.  Same trick
// for link targets.  Slot is a one-field wrapper because loft
// `sorted<>` keys must come from a struct field.
struct TagSlot { name: text not null }

// Wrapper so the `sorted` collection can be a STRUCT FIELD —
// loft's two-pass parser infers `sorted<TagSlot[name]>` more
// reliably for struct fields than for plain locals (a local
// `distinct_tags: sorted<TagSlot[name]> = [];` paired with a
// later `+= [TagSlot{...}]` raised "cannot change type from
// sorted<...> to vector<...>" because the literal append was
// re-typed as vector mid-flight).
struct DistinctSets {
    tags: sorted<TagSlot[name]>,
    links: sorted<TagSlot[name]>
}

// File extensions worth scanning.  Matches scan.sh's grep
// surface (markdown + Rust + loft + manifest files + scripts).
fn is_indexable_ext(name: text) -> boolean {
    if name.ends_with(".md") { return true; }
    if name.ends_with(".rs") { return true; }
    if name.ends_with(".loft") { return true; }
    if name.ends_with(".toml") { return true; }
    if name.ends_with(".sh") { return true; }
    if name.ends_with(".py") { return true; }
    false
}

// Raw row collected during the scan.  emitted to stdout as a
// JSON Lines record AFTER cross-referencing the tag against
// the valid-IDs sets — at which point we can attach the
// `valid` field directly without a re-parse round trip.
struct RawRef {
    tag: text not null,
    file: text not null,
    line: integer not null,
    ctx_escaped: text not null
}

// Markdown-link row collected during the scan.  Mirrors the
// per-link entries scan.sh emits into the `links` bucket of
// `index/tags.json` (`{target: [{file, line, anchor, context}, …]}`).
// Emitted as a JSON Lines record with `link` (instead of `tag`)
// so downstream filters (`jq 'select(.link)'`) can fan out
// without parsing back to typed structs.  `target` is the
// resolved repo-relative path; `anchor` is the optional
// `#fragment` portion (empty when absent).
struct LinkRef {
    target: text not null,
    file: text not null,
    line: integer not null,
    anchor: text not null,
    ctx_escaped: text not null
}

// Directory names to skip during the recursive walk.  Any
// match (basename equality) prunes the entire subtree.
fn is_skipped_dir(name: text) -> boolean {
    if name == "target" { return true; }
    if name == ".git" { return true; }
    if name == "node_modules" { return true; }
    if name == ".loft" { return true; }
    // `bin` and `state` show up under tools/viewer/ and
    // tools/indexer/ as build-output / runtime-state dirs but
    // ALSO as legit code dirs (e.g., src/state/codegen.rs).
    // The bin dirs hold non-indexable binaries; the state dirs
    // hold non-indexable JSON.  Neither has indexable
    // extensions, so we don't actually need to skip them — the
    // is_indexable_ext filter does the work.  Kept the previous
    // exclusion of generated test artefacts (tests/generated/
    // is .gitignored) since loft otherwise picks up their
    // tag refs and bash doesn't.
    if name == "generated" { return true; }
    // Git worktree dirs (`.claude/worktrees/`) are local-only
    // copies of in-flight work; bash's `git ls-files` skips
    // them because they're untracked, but the loft walker would
    // descend into them and re-index every loft source twice.
    if name == "worktrees" { return true; }
    // `pkg` directories hold WASM / package build output
    // (`loft.js` / `loft_bg.wasm` / generated README).  The
    // generated README contains relative links anchored to
    // the wrong root and would surface as false-positive
    // broken links — bash's `git ls-files` skips these
    // (they're gitignored); loft mirrors via the dir name.
    if name == "pkg" { return true; }
    false
}

// Aliases that resolve to the leaf helpers near the top of
// the file.  Kept distinct names so older callers below didn't
// have to be renamed when the validators were added — both
// names compile to the same body.
fn is_digit(c: character) -> boolean { is_digit_leaf(c) }
fn is_word_char(c: character) -> boolean { is_word_char_leaf(c) }

// Walks the tree rooted at `path`, calling visit on every
// indexable file.  Pruning happens at directory boundaries
// (is_skipped_dir).  visit receives the relative path so
// downstream code can write it as-is into the index.
fn walk_tree(root: text) -> vector<text> {
    out: vector<text> = [];
    walk_into(root, out);
    out
}

fn walk_into(path: text, out: vector<text>) {
    f = file(path);
    if f.format == Format.NotExists { return; }
    if f.format == Format.Directory {
        for child in f.files() {
            cp = child.path;
            base = cp.basename();
            if child.format == Format.Directory {
                if is_skipped_dir(base) { continue; }
                walk_into(cp, out);
            } else if is_indexable_ext(cp) {
                out += [cp];
            }
        }
    } else if is_indexable_ext(path) {
        out += [path];
    }
}

// `basename_of` removed in @PLAN37 phase 10.16 — call sites
// updated to `cp.basename()` (stdlib method shipped in 10.9).

// True when a line carries the `<!--noindex-->` opt-out comment
// the bash scanner uses to mute prose mentions of fake tags
// (regex examples, doc explainers).  Lightweight contains-check;
// formal HTML-comment parsing isn't required because the
// convention is a single inline marker.
fn is_noindex_line(line: text) -> boolean {
    line.find("<!--noindex-->") >= 0
}

// Scan one line for tracker tags, append `<file>:<line>:<tag>`
// rows to out.  Two pattern families:
//
//   @PLAN<digits>(-<segment>)*    where <segment> = [a-zA-Z0-9._]+
//   @P<digits>[a-z]?              not preceded by [a-zA-Z0-9_]
//
// `@PLAN` is checked first so `@PLAN35` doesn't fall into the
// `@P<digit>` branch (where `LAN35` would be left over as the
// digit-prefix would fail).  Both patterns require a non-word
// char (or string boundary) BEFORE the `@` to mirror the bash
// regex's `\B` boundary check.
fn scan_line(file_path: text, line_no: integer, line: text, out: vector<RawRef>) {
    if is_noindex_line(line) { return; }
    n = line.len();
    if n < 3 { return; }
    // Compute the JSON-escaped context once per line that has any
    // potential match — the inner loop emits one row per tag, and
    // they share the same context string.  Building the JSON
    // record is then literal concat (no per-row escape work).
    ctx_esc = "";
    ctx_escaped = false;
    i = 0;
    while i < n {
        c = line[i];
        // The pre-@-tag legacy bare-name forms (`P<n>`, `plan-<n>`)
        // start with a different prefix character — the per-char
        // dispatch below only enters the `@`-prefixed branches
        // when c == '@', otherwise it falls through to the legacy
        // checks at the bottom of the loop.  Note: scan.sh's
        // `@`-prefix regex is `@P\d+...\b` — the trailing `\b` is
        // enforced by our digit-then-non-alpha consume, but the
        // LEADING `@` has no boundary constraint.  So
        // `user@P259.com` matches by design.
        if c == '@' {
        // Try @PLAN first.
        if i + 6 <= n && (line[i + 1]) == 'P' && (line[i + 2]) == 'L'
            && (line[i + 3]) == 'A' && (line[i + 4]) == 'N' && is_digit(line[i + 5]) {
            // Consume @PLAN<digits>(-<segment>)*
            j = i + 5;
            while j < n && is_digit(line[j]) { j = j + 1; }
            // Optional `-<segment>` repeats.
            while j + 1 < n && (line[j]) == '-' && is_segment_char(line[j + 1]) {
                j = j + 1;
                while j < n && is_segment_char(line[j]) { j = j + 1; }
            }
            // Trailing `\b` check: the next char (if any) must
            // be a non-word char.  `@PLAN37foo` has `f` (word)
            // after the digits with no `-` separator → no
            // boundary, no match.
            if j == n || !is_word_char(line[j]) {
                tag = line[i..j];
                if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                i = j;
                continue;
            }
            // Trailing boundary failed; skip past `@PLAN` and resume.
            i = i + 5;
            continue;
        }
        // Fall back to @P<digits>[a-z]?
        if i + 3 <= n && (line[i + 1]) == 'P' && is_digit(line[i + 2]) {
            j = i + 2;
            while j < n && is_digit(line[j]) { j = j + 1; }
            // Mirror bash regex `@P[0-9]+[a-z]?\b`.  After the
            // digits there are three possibilities:
            //   1. Next char is non-word → match `@P<digits>`.
            //   2. Next char is `[a-z]` and the char AFTER that
            //      is non-word → match `@P<digits><letter>`.
            //   3. Otherwise → no match (`@P229bing` and `@P229_x`
            //      both fail because `\b` can't be satisfied).
            matched = false;
            if j == n {
                matched = true;
            } else if !is_word_char(line[j]) {
                matched = true;
            } else if line[j] >= 'a' && line[j] <= 'z'
                && (j + 1 == n || !is_word_char(line[j + 1])) {
                j = j + 1;
                matched = true;
            }
            if matched {
                tag = line[i..j];
                if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                i = j;
                continue;
            }
            // Failed: skip past the `@P` and resume scanning.
            i = i + 2;
            continue;
        }
        }  // end if c == '@'
        // Legacy bare-name `P<digits>[a-z]?\b` — the pre-`@`-tag
        // form that scan.sh keeps indexing under `legacy:P<n>`.
        // Combined leading + trailing boundary check matches the
        // bash GREP filter regex
        //     \bP[0-9]+[a-z]?\b
        // (the awk extraction is lazier — uses
        // `(^|[^@a-zA-Z0-9])P[0-9]+[a-z]?` without trailing
        // `\b` — but anything not surviving grep never reaches
        // awk anyway, so the effective semantics is the strict
        // `\b...\b` form).  Without the trailing boundary we'd
        // incorrectly emit `legacy:P204` for `P204_S` (struct
        // names follow that shape in the loft suite).
        if c == 'P' && i + 1 < n && is_digit(line[i + 1]) {
            // Leading boundary: position 0, or previous char is
            // not in `[@a-zA-Z0-9_]`.  Specifically reject `@`
            // (the @-form was already handled above).
            ok = i == 0;
            if !ok && i > 0 {
                pc = line[i - 1];
                ok = pc != '@' && !is_word_char(pc);
            }
            if ok {
                j = i + 1;
                while j < n && is_digit(line[j]) { j = j + 1; }
                // Optional trailing letter, same as @P-form.
                end_with_letter = false;
                if j < n && line[j] >= 'a' && line[j] <= 'z'
                    && (j + 1 == n || !is_word_char(line[j + 1])) {
                    j = j + 1;
                    end_with_letter = true;
                }
                // Trailing `\b`: next char (if any) must be
                // non-word.  Without this, `P204_S` slips
                // through as `legacy:P204`.
                trailing_ok = j == n || !is_word_char(line[j]);
                // If the trailing-letter branch already moved j
                // past a known non-word boundary, trailing_ok
                // is automatic.
                if !trailing_ok && end_with_letter { trailing_ok = true; }
                if trailing_ok {
                    bare = line[i..j];
                    tag = "legacy:{bare}";
                    if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                    out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                    i = j;
                    continue;
                }
            }
        }
        // Legacy bare-name `plan-<digits>` — the pre-`@PLAN`
        // form, indexed under `legacy:plan-<n>`.  Bash regex:
        //     \bplan-[0-9]+
        // Word boundary on the leading `p`; no trailing
        // boundary (greedy digits to first non-digit).
        if c == 'p' && i + 6 <= n && line[i + 1] == 'l' && line[i + 2] == 'a'
            && line[i + 3] == 'n' && line[i + 4] == '-' && is_digit(line[i + 5]) {
            ok = i == 0 || !is_word_char(line[i - 1]);
            if ok {
                j = i + 5;
                while j < n && is_digit(line[j]) { j = j + 1; }
                bare = line[i..j];
                tag = "legacy:{bare}";
                if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                i = j;
                continue;
            }
        }
        i = i + 1;
    }
}

// Build one JSON-Lines record.  `ctx_escaped` is already passed
// through `json_escape`; tag and file_path can't contain JSON-
// hostile chars (tags are alphanumeric + `.-`; paths in this
// repo are ASCII without quotes/backslashes), so they go in
// raw.  The `valid` field is the broken-tag validator's verdict
// (true = resolves to a real PROBLEMS row or plan dir; false
// = `broken:` material).  Default-true for legacy refs (the
// migration index doesn't gate them).
// Build one JSON Lines record for a markdown link.  Same
// shape as `emit_row` for tag refs, but keyed on `link`
// (the resolved target path) instead of `tag`.  `anchor` is
// emitted even when empty so the field is structurally
// stable for downstream consumers.  `valid` is the broken-
// link validator's verdict — true = target file exists,
// false = `broken_links:` material.
fn emit_link(target: text, file_path: text, line_no: integer, anchor: text, ctx_escaped: text, valid: boolean) -> text {
    valid_str = "true";
    if !valid { valid_str = "false"; }
    "{{\"link\":\"{target}\",\"file\":\"{file_path}\",\"line\":{line_no},\"anchor\":\"{anchor}\",\"context\":\"{ctx_escaped}\",\"valid\":{valid_str}}}"
}

// True when the link's resolved target file exists on disk.
// Anchor (`#fragment`) is ignored — only the path is checked
// (matches scan.sh's broken_links behaviour, which validates
// the file's presence but doesn't try to validate the
// fragment against the target's heading slugs).  Empty
// targets (intra-file `#anchor` links the scanner already
// filters out) wouldn't reach here, but defaulting to true
// keeps the function total.
fn link_target_exists(target: text) -> boolean {
    if target == "" { return true; }
    file(target).format != Format.NotExists
}

// `dir_of` and `resolve_link_path` removed in @PLAN37 phase 10.16.
// Replaced by the stdlib `text.dir()` and `text.resolve()` methods
// added in phase 10.9.  Call sites below use `file_path.dir()` and
// `base_dir.resolve(target_raw)`.

// Scan one line of a markdown source for `[text](target.md)` or
// `[text](target.md#anchor)` patterns.  Skips http:// / https://
// / mailto: / `#`-only / leading-slash absolute-from-root paths
// (those last get a special treatment below).  Limitations of
// this single-pass walker (deferred to a follow-up commit):
//
//   - No fenced-code-block state tracking.  Example links
//     inside ```...``` blocks WILL pollute the output.  Bash
//     scanner suppresses these by tracking ``` opens/closes
//     per file; loft port stays single-line for now.
//   - Only `.md` targets are matched (matches scan.sh's
//     `\.md(#…)?` regex).
fn scan_link_line(file_path: text, line_no: integer, line: text, base_dir: text, out: vector<LinkRef>) {
    if is_noindex_line(line) { return; }
    n = line.len();
    if n < 6 { return; }
    ctx_esc = "";
    ctx_escaped = false;
    i = 0;
    while i + 5 < n {
        // Match `](`
        if line[i] != ']' || line[i + 1] != '(' {
            i = i + 1;
            continue;
        }
        // Find the closing `)` — bounded scan; bail at first
        // whitespace, `(`, or end-of-line within the URL.
        j = i + 2;
        while j < n && line[j] != ')' && line[j] != ' ' && line[j] != '\t' { j = j + 1; }
        if j == n || line[j] != ')' { i = i + 1; continue; }
        inner = line[i + 2..j];
        ilen = inner.len();
        if ilen < 4 {
            i = j + 1;
            continue;
        }
        // Split on `#` for optional anchor.
        anchor = "";
        target_raw = inner;
        h = 0;
        found_hash = false;
        while h < ilen {
            if inner[h] == '#' {
                target_raw = inner[0..h];
                anchor = inner[h + 1..ilen];
                found_hash = true;
                break;
            }
            h = h + 1;
        }
        // Skip non-`.md` targets: scan.sh's regex is
        // `\.md(#…)?`, so every link target must end `.md`
        // before the optional `#`.  Avoids picking up `.png`
        // / `.html` / arbitrary URL paths.
        tlen = target_raw.len();
        if tlen < 3 || !(target_raw[tlen - 3] == '.'
            && target_raw[tlen - 2] == 'm' && target_raw[tlen - 1] == 'd') {
            i = j + 1;
            continue;
        }
        // Skip URL schemes.
        if target_raw.starts_with("http://") || target_raw.starts_with("https://")
            || target_raw.starts_with("mailto:") {
            i = j + 1;
            continue;
        }
        // Resolve.  Leading `/` means repo-rooted (strip slash);
        // otherwise resolve against base_dir.
        resolved = "";
        if tlen > 0 && target_raw[0] == '/' {
            resolved = target_raw[1..tlen];
        } else {
            resolved = base_dir.resolve(target_raw);
        }
        if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
        // Inline the anchor escape — the previous `anchor_esc =
        // json_escape(anchor); ...` form tripped a type-inference
        // quirk where `anchor` ended up as `unknown(0)` from the
        // `if`-arm reassignment, even though every assignment to
        // `anchor` produced text.  Inline call works because the
        // typer evaluates the call's return type independently.
        a_esc: text = json_escape(anchor);
        out += [LinkRef{target: resolved, file: file_path, line: line_no, anchor: a_esc, ctx_escaped: ctx_esc}];
        i = j + 1;
    }
}

fn emit_row(tag: text, file_path: text, line_no: integer, ctx_escaped: text, valid: boolean) -> text {
    // `{{` and `}}` produce literal `{` and `}` in a loft format
    // string (loft uses doubled braces for the brace escape).
    valid_str = "true";
    if !valid { valid_str = "false"; }
    "{{\"tag\":\"{tag}\",\"file\":\"{file_path}\",\"line\":{line_no},\"context\":\"{ctx_escaped}\",\"valid\":{valid_str}}}"
}

// JSON-escape a text: backslash, double-quote, control chars
// → `\\`, `\"`, `\n`, `\t`, `\r`, or `\u00XX`.  Loft text is
// UTF-8 so non-ASCII codepoints pass through verbatim — JSON
// allows raw UTF-8 in strings.
fn json_escape(s: text) -> text {
    out = "";
    n = s.len();
    i = 0;
    while i < n {
        c = s[i];
        if c == '\\' {
            out += "\\\\";
        } else if c == '"' {
            out += "\\\"";
        } else if c == '\n' {
            out += "\\n";
        } else if c == '\t' {
            out += "\\t";
        } else if c == '\r' {
            out += "\\r";
        } else {
            // Control chars below 0x20 (excluding the three above)
            // are rare in source text but JSON requires the `\u`
            // escape if they appear.  All other chars (including
            // multi-byte UTF-8) pass through verbatim.
            cn = c as integer;
            if cn < 32 {
                out += "\\u00";
                out += hex_byte(cn);
            } else {
                out += "{c}";
            }
        }
        i = i + 1;
    }
    out
}

// Two-hex-digit string for `n` in [0, 255].  Used by json_escape's
// `\u00XX` path; two-byte hex is enough because the only chars
// hitting the escape are 0x00–0x1F (control characters).
fn hex_byte(n: integer) -> text {
    hi = n / 16;
    lo = n - (hi * 16);
    "{hex_digit(hi)}{hex_digit(lo)}"
}

fn hex_digit(n: integer) -> text {
    if n < 10 { return "{n}"; }
    if n == 10 { return "a"; }
    if n == 11 { return "b"; }
    if n == 12 { return "c"; }
    if n == 13 { return "d"; }
    if n == 14 { return "e"; }
    "f"
}

// Segment-char class for `@PLAN-<segment>` continuations.  Bash
// scanner uses `[a-zA-Z0-9._]+`.
fn is_segment_char(c: character) -> boolean {
    if is_word_char(c) { return true; }
    c == '.'
}

// Read a file's lines and scan each.  Files that fail to read
// (binary, permissions, transient races) are silently skipped —
// this matches scan.sh's `|| true` resilience.
fn scan_file(file_path: text, out: vector<RawRef>, links_out: vector<LinkRef>) {
    f = file(file_path);
    if f.format == Format.NotExists { return; }
    if f.format == Format.Directory { return; }
    src = f.content();
    // Markdown link extraction is .md-only; computing base_dir
    // once outside the loop avoids per-line allocation for the
    // 99% of source files that aren't markdown.  Fenced-code-
    // block state (`in_fence`) is also .md-only; tracked here
    // so example links inside ```...``` or ~~~ blocks (which
    // illustrate syntax, not real refs) don't pollute the
    // links bucket.  Mirrors scan.sh's `in_fence` awk variable
    // — a fence opens on a stripped line starting with ``` or
    // ~~~, closes on a matching marker, and absorbs every
    // intermediate line.  Tag scanning (`scan_line`) is NOT
    // gated on fence state — code-block tag refs like
    // `// @P259 fix lands here` inside a Rust snippet ARE
    // intentional indices.
    is_md = file_path.ends_with(".md");
    base_dir = "";
    if is_md { base_dir = file_path.dir(); }
    in_fence = false;
    fence_marker = "";
    line_no = 1;
    start = 0;
    n = src.len();
    i = 0;
    while i < n {
        if src[i] == '\n' {
            ln = src[start..i];
            scan_line(file_path, line_no, ln, out);
            if is_md {
                stripped = lstrip_ws(ln);
                fence_open_close = is_fence_marker(stripped);
                if in_fence {
                    if fence_open_close == fence_marker {
                        in_fence = false;
                        fence_marker = "";
                    }
                } else {
                    if fence_open_close != "" {
                        in_fence = true;
                        fence_marker = fence_open_close;
                    } else {
                        scan_link_line(file_path, line_no, ln, base_dir, links_out);
                    }
                }
            }
            line_no = line_no + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if start < n {
        ln = src[start..n];
        scan_line(file_path, line_no, ln, out);
        if is_md && !in_fence {
            stripped = lstrip_ws(ln);
            if is_fence_marker(stripped) == "" {
                scan_link_line(file_path, line_no, ln, base_dir, links_out);
            }
        }
    }
}

// Strip leading ASCII whitespace (spaces + tabs).  Cheap;
// only used for fence-marker detection.
fn lstrip_ws(s: text) -> text {
    n = s.len();
    i = 0;
    while i < n && (s[i] == ' ' || s[i] == '\t') { i = i + 1; }
    if i == 0 { return s; }
    s[i..n]
}

// Returns "```" or "~~~" if `stripped` opens or closes a
// fenced code block (line begins with three or more of
// either character); "" otherwise.  Mirrors scan.sh's
// `substr(stripped, 1, 3) == "\`\`\`"` check.
fn is_fence_marker(stripped: text) -> text {
    n = stripped.len();
    if n < 3 { return ""; }
    if stripped[0] == '`' && stripped[1] == '`' && stripped[2] == '`' { return "```"; }
    if stripped[0] == '~' && stripped[1] == '~' && stripped[2] == '~' { return "~~~"; }
    ""
}

// Emit the bucketed `index/tags.json`-shape JSON object on
// stdout.  Sorts tag names + link targets alphabetically (jq's
// `keys[]` always sorts so this matches scan.sh's output
// order).  Uses sorted<TagSlot[name]> for cheap dedup +
// alphabetical iteration.  O(N × M) per-bucket walk where
// N = total rows (~5200) and M = distinct keys (~370 tags +
// ~250 link targets) — sub-second on the warm-cache path.
//
// Schema: matches scan.sh's tags.json shape for the buckets
// loft already produces — per-tag arrays for `@P*` / `@PLAN*` /
// `legacy:*`, plus a `links` map of `{target: [...]}`.  Other
// buckets (broken / broken_links / problems_open / plans_*)
// stay in the bash post-processor for now and merge over
// the loft output via `jq +` when the full pipeline is wired.
fn emit_bucketed(rows: vector<RawRef>, links: vector<LinkRef>,
                 valid_pids: vector<text>, valid_plans: vector<text>) {
    sets = DistinctSets {};
    for r in rows {
        if sets.tags[r.tag] == null {
            sets.tags += [TagSlot{name: r.tag}];
        }
    }
    for lr in links {
        if sets.links[lr.target] == null {
            sets.links += [TagSlot{name: lr.target}];
        }
    }
    println("{{");
    // Per-tag buckets.  Comma management: emit the leading
    // comma BEFORE each entry except the first.
    first = true;
    for slot in sets.tags {
        if !first { println(","); }
        first = false;
        // The per-row `valid` field is intentionally omitted
        // from the bucketed shape — every ref to a broken tag
        // is itself broken (the validity is a property of the
        // KEY, not the ref).  Same shape scan.sh's tags.json
        // uses; downstream consumers (`./scripts/idx broken`,
        // viewer's red-banner surface) reconstruct the broken
        // set by intersecting bucket keys with valid_pids /
        // valid_plans.
        emit_tag_bucket(slot.name, rows);
    }
    // Links bucket — wrapped in `"links": { ... }`.  Mirrors
    // scan.sh's `links` field.
    if sets.links.len() > 0 {
        if !first { println(","); }
        first = false;
        println("  \"links\": {{");
        first_link = true;
        for slot in sets.links {
            if !first_link { println(","); }
            first_link = false;
            emit_link_bucket(slot.name, links);
        }
        println("");
        println("  }}");
    }
    // Broken @-tag refs.  Always emit (matches scan.sh, which
    // unconditionally merges `{broken: [...]}` even when empty).
    if !first { println(","); }
    first = false;
    println("  \"broken\": [");
    emit_broken_array(rows, valid_pids, valid_plans);
    println("");
    println("  ]");
    // Broken markdown links.  Same always-emit discipline.
    println(",");
    println("  \"broken_links\": [");
    emit_broken_links_array(links);
    println("");
    println("  ]");
    println("");
    println("}}");
}

fn emit_tag_bucket(tag: text, rows: vector<RawRef>) {
    print("  \"{tag}\": [");
    inner_first = true;
    for r in rows {
        if r.tag == tag {
            if !inner_first { print(","); }
            inner_first = false;
            print("{{\"file\":\"{r.file}\",\"line\":{r.line},\"context\":\"{r.ctx_escaped}\"}}");
        }
    }
    print("]");
}

fn emit_link_bucket(target: text, links: vector<LinkRef>) {
    print("    \"{target}\": [");
    inner_first = true;
    for lr in links {
        if lr.target == target {
            if !inner_first { print(","); }
            inner_first = false;
            print("{{\"file\":\"{lr.file}\",\"line\":{lr.line},\"anchor\":\"{lr.anchor}\",\"context\":\"{lr.ctx_escaped}\"}}");
        }
    }
    print("]");
}

// True when the tag's underlying P-issue / plan ID is not present
// in the valid sets.  Handles both `@P*` / `@PLAN*` (the canonical
// form) AND `legacy:P*` / `legacy:plan-*` (the transition-metering
// bare-name form).  `tag_is_valid` above defaults legacy refs to
// `true` because the per-row `valid` field in JSON Lines is for
// the canonical `@`-tag form only; the `broken` bucket below
// treats both symmetrically (mirrors scan.sh's REF_PIDS / REF_PLANS
// extraction, which strips the optional `legacy:` prefix before
// the set-diff against VALID_PIDS / VALID_PLANS).
fn tag_is_broken(tag: text, valid_pids: vector<text>, valid_plans: vector<text>) -> boolean {
    tlen = tag.len();
    work = tag;
    wlen = tlen;
    if tag.starts_with("legacy:") {
        work = tag[7..tlen];
        wlen = tlen - 7;
    }
    is_plan = false;
    digit_start = 0;
    if work.starts_with("@PLAN") {
        digit_start = 5;
        is_plan = true;
    } else if work.starts_with("plan-") {
        digit_start = 5;
        is_plan = true;
    } else if work.starts_with("@P") {
        digit_start = 2;
    } else if wlen > 1 && work[0] == 'P' && is_digit_leaf(work[1]) {
        digit_start = 1;
    } else {
        return false;
    }
    if digit_start >= wlen || !is_digit_leaf(work[digit_start]) { return false; }
    j = digit_start;
    while j < wlen && is_digit_leaf(work[j]) { j = j + 1; }
    num = work[digit_start..j];
    if is_plan { return !set_contains(valid_plans, num); }
    return !set_contains(valid_pids, num);
}

// Emit the `broken` array contents: one `{tag, refs: ["file:line", ...]}`
// object per distinct broken tag.  Caller writes the surrounding
// `"broken": [ ... ]` brackets so this prints only the inner
// objects, comma-separated.  Mirrors scan.sh's BROKEN_JSON shape.
fn emit_broken_array(rows: vector<RawRef>, valid_pids: vector<text>,
                     valid_plans: vector<text>) {
    distinct = DistinctSets {};
    for r in rows {
        if !tag_is_broken(r.tag, valid_pids, valid_plans) { continue; }
        // scan.sh's broken bucket lists only the canonical `@P*` /
        // `@PLAN*` keys.  Legacy `legacy:P*` / `legacy:plan-*` refs
        // are tracked in their own buckets and the migration metering
        // (`make problems` summary) doesn't surface them as broken
        // even when their underlying ID isn't in the valid set.
        // Mirror that — filter out tags with the `legacy:` prefix.
        if r.tag.starts_with("legacy:") { continue; }
        if distinct.tags[r.tag] == null {
            distinct.tags += [TagSlot{name: r.tag}];
        }
    }
    first = true;
    for slot in distinct.tags {
        if !first { print(","); }
        first = false;
        print("    {{\"tag\":\"{slot.name}\",\"refs\":[");
        ref_first = true;
        for r in rows {
            if r.tag != slot.name { continue; }
            if !ref_first { print(","); }
            ref_first = false;
            print("\"{r.file}:{r.line}\"");
        }
        print("]}}");
    }
}

// Emit the `broken_links` array contents: one `{target, refs: ["file:line", ...]}`
// object per distinct missing-target.  Caller writes the surrounding
// `"broken_links": [ ... ]` brackets.  Mirrors scan.sh's
// BROKEN_LINKS_JSON shape.
fn emit_broken_links_array(links: vector<LinkRef>) {
    distinct = DistinctSets {};
    for lr in links {
        if link_target_exists(lr.target) { continue; }
        if distinct.tags[lr.target] == null {
            distinct.tags += [TagSlot{name: lr.target}];
        }
    }
    first = true;
    for slot in distinct.tags {
        if !first { print(","); }
        first = false;
        print("    {{\"target\":\"{slot.name}\",\"refs\":[");
        ref_first = true;
        for lr in links {
            if lr.target != slot.name { continue; }
            if !ref_first { print(","); }
            ref_first = false;
            print("\"{lr.file}:{lr.line}\"");
        }
        print("]}}");
    }
}

fn main() {
    // Phase 03 broken-tag validator: load valid PROBLEMS row IDs
    // and plan-dir number prefixes upfront, then check each scanned
    // ref against them.  Sets are passed to emit-time so each
    // JSON-Lines record carries a `valid` boolean — downstream
    // tooling (`./scripts/idx broken`, the viewer's red-banner
    // surface) filters via `select(.valid == false)`.
    valid_pids = read_valid_pids();
    valid_plans = read_valid_plans();

    rows: vector<RawRef> = [];
    links: vector<LinkRef> = [];
    // Top-level indexable files (CLAUDE.md, README.md,
    // CHANGELOG.md, Cargo.toml, etc.) — iterate explicitly so
    // they don't require the recursive walker to descend from
    // `.` (which would re-walk every source root and double-count).
    // file(".").files() returns paths with a leading `./`; strip
    // it so the output matches the bash scanner's bare-relative
    // shape (`CLAUDE.md`, not `./CLAUDE.md`).
    root = file(".");
    if root.format == Format.Directory {
        for entry in root.files() {
            if entry.format != Format.Directory && is_indexable_ext(entry.path) {
                p = entry.path;
                if p.starts_with("./") { p = p[2..p.len()]; }
                scan_file(p, rows, links);
            }
        }
    }
    for src_root in source_roots() {
        files = walk_tree(src_root);
        for fp in files {
            scan_file(fp, rows, links);
        }
    }
    // Output mode dispatch.  `LOFT_INDEX_BUCKETED=1` switches
    // to the `index/tags.json`-shape JSON object emission
    // (per-tag arrays + `links` map); the default stays JSON
    // Lines (one record per match) so the existing test gate
    // and downstream consumers (`./scripts/idx`, the viewer's
    // disk fallback) keep working unchanged.
    bucketed = env_variable("LOFT_INDEX_BUCKETED");
    if bucketed == "1" {
        emit_bucketed(rows, links, valid_pids, valid_plans);
        return;
    }
    // Second pass: emit JSON Lines with validity.  Validity is
    // O(N × M) where N = rows (~4000) and M = valid set size
    // (~270 pids + ~50 plans).  ~1.3M comparisons on the loft
    // suite — well under a second on the warm-cache path.
    for r in rows {
        v = tag_is_valid(r.tag, valid_pids, valid_plans);
        println(emit_row(r.tag, r.file, r.line, r.ctx_escaped, v));
    }
    // Emit markdown link rows after the tag rows.  Downstream
    // jq filters on the presence of the `link` field
    // (`select(.link)` vs `select(.tag)`) to fan out — the
    // mixed JSON-Lines stream stays compact enough for stdio.
    // Validity here is per-row file existence: the target was
    // already resolved repo-relative by scan_link_line, so
    // `file(target).format != NotExists` is the same check
    // scan.sh's broken_links pass uses.  Cached lookups would
    // help (~1300 links over ~250 distinct targets) but for an
    // MVP the per-row file() call is fast enough — the loft
    // file() primitive's stat path is sub-microsecond on a
    // warm cache.
    for lr in links {
        v = link_target_exists(lr.target);
        println(emit_link(lr.target, lr.file, lr.line, lr.anchor, lr.ctx_escaped, v));
    }
}
