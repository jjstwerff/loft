//
// @PLAN36 phase 3 MVP — pure-OpenGL projector view (basis for the beamer).
//
// Connects as a WebSocket client to the multi-client audience server
// (tools/audience-demo/server.loft, ws://127.0.0.1:18083/), receives
// every `4:x,y,color` delta the server broadcasts, and renders the
// painted hexes live in a desktop GL window.
//
// MVP scope:
//   - Single OpenGL window, 1280x800.
//   - Flat 2D pointy-top hex grid (no 3D crystal mesh yet).
//   - 9-colour palette matching doc/audience-demo/index.html.
//   - No auto-camera, no input — pure passive viewer.
//   - Hardcoded server URL.  Future projector adds CLI flags + auto-
//     camera + 3D crystal mesh per `03-projector-view.md`.
//
// Run:
//   # Terminal A — start the multi-client server.
//   ./target/release/loft --no-warnings --lib lib/ tools/audience-demo/server.loft
//
//   # Terminal B — start the projector.
//   ./target/release/loft --no-warnings --lib lib/ tools/audience-demo/projector.loft
//
//   # Now any seed/clear event hitting the server appears as a coloured
//   # hex in the projector window within a frame.

use graphics;
use math;
use web;
use audience_crystal::*;   // CellSnap, CrystalMesh, CrystalState, crystal_segments_aged,
                           // update_state, pick_centers, palette_r/g/b, cell_wx/wz,
                           // HEX_SIZE, SQRT3, KIND_MAIN/SIDE, GROWTH_TICKS, …

// ── Constants ────────────────────────────────────────────────────────────────

WIN_W = 1280;
WIN_H = 800;

// Server URL (hard-coded for the MVP — separate binary per the user's
// scope decision).  Multi-client `server.loft` listens on 18083 and
// broadcasts every paint event over text frames `4:x,y,color`.
SERVER_URL = "ws://127.0.0.1:18083/ws";

// ── Helpers — leaves first (per @P281: pass-1 fn return-type inference) ─────

// One cell in the world.  Hash key is the formatted "x,y" — same key
// scheme as the server side so a `4:x,y,c` delta updates the right
// record by parsing back the integers.
struct Cell {
  ck:          text not null,    // "x,y" — primary key
  x:           integer not null, // offset coord (matches phone client)
  y:           integer not null,
  color:       integer not null, // 1..9 (palette index; 0 means deleted)
  paint_tick:  integer not null, // monotonic per-paint counter for ORDER —
                                 // used to build the CellSnap in placement
                                 // order so audience_crystal's centre-vs-
                                 // supporter rules see the right first-paint.
  birth_frame: integer not null, // render-frame number when the cell was
                                 // painted.  Drives the GPU growth shader
                                 // (the crystal blooms from this cell's
                                 // centre over GROWTH_FRAMES); set in
                                 // apply_frame, in the same clock as the
                                 // loop's `frames` / the uNow uniform.
}

// Format a "x,y" key.  Inverse of parse_xy.
fn cell_key(x: integer, y: integer) -> text {
  "{x},{y}"
}

// Parse the "x,y,c" payload of a `4:` delta into three integers.
// Returns a tuple via expression-form (early-returning a tuple trips
// the typer — same workaround used in server.loft).
fn parse_xyc(payload: text) -> (integer, integer, integer) {
  i = payload.find(",");
  if i == null {
    (0, 0, 0)
  } else {
    x = payload[..i] as integer;
    rest = payload[i + 1..];
    j = rest.find(",");
    if j == null {
      (x, 0, 0)
    } else {
      y = rest[..j] as integer;
      c = rest[j + 1..] as integer;
      (x, y, c)
    }
  }
}

// ── 3D rendering — step 1: hex ground in 3D space ──────────────────────────
//
// Phase 3 of @PLAN36 — the 3D crystal mesh.  Step 1 swaps the 2D ortho
// painter for a real 3D perspective pipeline so the camera (pos +
// rotation + tilt) becomes a literal FPS-style eye in world space.
// Visuals stay close to the 2D version for now: flat hex tiles
// sitting on the y=0 ground plane.  Crystal prisms with height,
// bridges, ridges, and the colour mosaic land in subsequent steps.

// ── Shaders — two pipelines: solid-coloured ground + per-vertex coloured lines ──
//
// CELL_VERT/FRAG: stride 6 (pos + per-vertex colour) — shared by
// the ground layer (filled hex triangles at y=0 in the painted
// colour) and the crystal layer (line-wireframe top edges at y=h).
// Empty cells render nothing.  Both VBOs rebuild only when
// `world.cells` changes (apply_frame increments `world.version`);
// the main loop checks the version and re-bakes only on change.
// Per-frame cost = one draw call per VBO, zero mat4 alloc per cell.

// Per-vertex RGBA throughout.  The native gl_upload_vertices layout puts
// a vec4 colour at location 2 when stride == 10 (pos.xyz + normal.xyz +
// rgba); we don't use the normal slot (location 1) here, just pad it with
// zeros.  Carrying alpha on every vertex lets any cell fade — used now for
// the removal fade-out, and ready for the "old paints recede" effect.
CELL_VERT = `
#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 2) in vec4 aColor;
uniform mat4 uMVP;
out vec4 vColor;
void main() {{
    gl_Position = uMVP * vec4(aPos, 1.0);
    vColor = aColor;
}}
`;

CELL_FRAG = `
#version 330 core
in vec4 vColor;
out vec4 FragColor;
void main() {{
    FragColor = vColor;
}}
`;

// Frames for a freshly-painted cell's crystal to fully bloom in
// (~1.5 s at 60 fps).  The mesh carries each cell's birth_frame; the
// crystal shader scales every vertex out from the cell centre by the
// cell's age, so growth is GPU-side and the mesh stays cached (PF1).
GROWTH_FRAMES = 90.0;

// CRYSTAL_VERT/FRAG — stride 14: pos(0) + normal(1, pad) + rgba(2) +
// bloom-anchor(3) + birth-frame(4).  Each vertex eases out from its
// cell's centre to its full position over GROWTH_FRAMES, so a new paint
// GROWS in instead of popping.  No per-frame CPU rebuild — only the
// `uNow` uniform advances each frame.
CRYSTAL_VERT = `
#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 2) in vec4 aColor;
layout (location = 3) in vec3 aCenter;
layout (location = 4) in float aBirth;
uniform mat4 uMVP;
uniform float uNow;
uniform float uGrowth;
out vec4 vColor;
void main() {{
    float age = clamp((uNow - aBirth) / uGrowth, 0.0, 1.0);
    age = age * (2.0 - age);                 // ease-out for a soft settle
    vec3 p = aCenter + age * (aPos - aCenter);
    gl_Position = uMVP * vec4(p, 1.0);
    vColor = aColor;
}}
`;

CRYSTAL_FRAG = `
#version 330 core
in vec4 vColor;
out vec4 FragColor;
void main() {{
    FragColor = vColor;
}}
`;

// World — declared up-front so the build_*_vbo functions below can
// be type-checked in pass 1.  All mutation goes through `apply_frame`,
// which bumps `version` on every cell add / remove / colour change
// so the main loop knows when to re-bake the VBOs.  `paint_tick_next`
// is a monotonic counter stamped onto each new Cell at paint-time so
// snapshot_cells can produce a placement-ordered CellSnap.
// A cell that was just removed and is fading out.  Holds the colour it
// had at removal + the frame the fade began, so the ground footprint can
// be re-emitted at decreasing alpha for FADE_FRAMES.  Keyed by "x,y" (same
// scheme as Cell) so a re-paint can cancel an in-flight fade by key.
struct FadeCell {
  ck:    text not null,
  x:     integer not null,
  y:     integer not null,
  color: integer not null,
  start: integer not null,    // frame number when the fade began
}

// Removal fade duration in frames (~600 ms at 60 fps — matches the
// browser client's FADE_MS so both views fade at the same rate).
FADE_FRAMES = 36;

struct World {
  cells:           hash<Cell[ck]>,
  version:         integer not null,
  paint_tick_next: integer not null,
  fades:           hash<FadeCell[ck]>,
}

// Scratch struct used by snapshot_cells — the four parallel arrays
// kept together carry their vector<integer> field types through the
// bubble sort, which a locally-typed `xs: vector<integer> = []` loses
// after iterating `world.cells` (a hash).
struct TickSnap {
  ticks:  vector<integer>,
  xs:     vector<integer>,
  ys:     vector<integer>,
  colors: vector<integer>,
  births: vector<integer>,    // birth_frame per cell, carried through the sort
}

// snapshot_cells output: the lib CellSnap plus a parallel `births` array
// (birth_frame per cell, in the same placement order as the CellSnap's
// xs/ys/colors).  build_crystal_vbo uses births[cell_ix] to drive the
// GPU growth shader.
struct Snapshot {
  snap:   CellSnap,
  births: vector<integer>,
}

// Snapshot world.cells → audience_crystal::CellSnap sorted by
// paint_tick (oldest first).  The crystal lib's assign_cells walks
// in vector order, so the placement order needs to be preserved
// here to get the right centre-vs-supporter assignments.
//
// A local TickSnap (struct with explicit field types) carries the
// parallel ticks/xs/ys/colors arrays through the bubble sort — using
// struct fields sidesteps the loft type-inference issue where locally
// `vector<integer>`-annotated variables sometimes lose their vector
// nature after iterating a hash (`for cell in world.cells`).
fn snapshot_cells(world: World) -> Snapshot {
  buf = TickSnap{ticks: [], xs: [], ys: [], colors: [], births: []};
  for cell in world.cells {
    buf.ticks  += [cell.paint_tick];
    buf.xs     += [cell.x];
    buf.ys     += [cell.y];
    buf.colors += [cell.color];
    buf.births += [cell.birth_frame];
  }
  // In-place bubble sort by paint_tick ascending (n is small, and
  // see @P292 for why we avoid vector-reassign-from-loop-local).
  n = len(buf.ticks);
  for sc_pass in 0..n {
    for sc_j in 0..(n - 1) {
      if buf.ticks[sc_j] > buf.ticks[sc_j + 1] {
        ta = buf.ticks[sc_j];  buf.ticks[sc_j]  = buf.ticks[sc_j + 1];  buf.ticks[sc_j + 1]  = ta;
        xa = buf.xs[sc_j];     buf.xs[sc_j]     = buf.xs[sc_j + 1];     buf.xs[sc_j + 1]     = xa;
        ya = buf.ys[sc_j];     buf.ys[sc_j]     = buf.ys[sc_j + 1];     buf.ys[sc_j + 1]     = ya;
        ca = buf.colors[sc_j]; buf.colors[sc_j] = buf.colors[sc_j + 1]; buf.colors[sc_j + 1] = ca;
        ba = buf.births[sc_j]; buf.births[sc_j] = buf.births[sc_j + 1]; buf.births[sc_j + 1] = ba;
      }
    }
  }
  Snapshot{snap: CellSnap{xs: buf.xs, ys: buf.ys, colors: buf.colors}, births: buf.births}
}

// Bake the ground hex tiles — one filled hex per PAINTED cell, in
// that cell's palette colour.  Empty cells render nothing.  Stride 6
// (pos + per-vertex RGB).  18 verts per cell (6 triangles fanning
// from centre).  Returns (vao, vertex_count).
//
// Future: extend the per-vertex layout to stride 7 (pos + RGBA) and
// have the shader sample alpha so old paints fade out — gradual
// "ground recedes into history while crystals stay foreground" effect.
// Stays at stride 6 + full opacity for now per the v1 design.
// Append one filled ground hex (18 verts, stride 10: pos.xyz + zero
// normal pad + rgba) for cell (cell_x, cell_y) in palette colour cell_c
// at the given alpha.  Shared by the opaque ground bake (alpha 1) and the
// fade bake (alpha < 1).
fn push_ground_hex(verts: &vector<single>, cell_x: integer, cell_y: integer,
                   cell_c: integer, alpha: single) {
  r = HEX_SIZE * 0.97;
  bg_parity = cell_y - (cell_y / 2) * 2;
  if bg_parity < 0 { bg_parity = bg_parity + 2; }
  bg_shift = 0.0;
  if bg_parity == 1 { bg_shift = SQRT3 / 2.0 * HEX_SIZE; }
  wx = cell_x as float * SQRT3 * HEX_SIZE + bg_shift;
  wz = cell_y as float * 1.5 * HEX_SIZE;
  cr = palette_r(cell_c) as single;
  cg = palette_g(cell_c) as single;
  cb = palette_b(cell_c) as single;
  for i in 0..6 {
    a0 = (60.0 * i as float - 30.0) * PI / 180.0;
    a1 = (60.0 * (i + 1) as float - 30.0) * PI / 180.0;
    verts += [wx as single,                 0.0f, wz as single,                 0.0f, 0.0f, 0.0f, cr, cg, cb, alpha];
    verts += [(wx + r * cos(a0)) as single, 0.0f, (wz + r * sin(a0)) as single, 0.0f, 0.0f, 0.0f, cr, cg, cb, alpha];
    verts += [(wx + r * cos(a1)) as single, 0.0f, (wz + r * sin(a1)) as single, 0.0f, 0.0f, 0.0f, cr, cg, cb, alpha];
  }
}

// Ground hexes render at 20% alpha (GROUND_ALPHA) so they read as a faint
// backdrop and the 3D crystal beams above them stay the dominant feature.
GROUND_ALPHA = 0.2;

fn build_ground_vbo(snap: CellSnap) -> (integer, integer) {
  verts: vector<single> = [];
  for ix in 0..len(snap.xs) {
    push_ground_hex(verts, snap.xs[ix], snap.ys[ix], snap.colors[ix], GROUND_ALPHA as single);
  }
  ground_count = len(verts) / 10;
  ground_vao = graphics::gl_upload_vertices(verts, 10);
  (ground_vao, ground_count)
}

// Bake the translucent ground footprints of cells that are fading out.
// Each fading cell's alpha ramps from 1 → 0 across FADE_FRAMES.  Returns
// (0, 0) when nothing is fading (caller skips the draw).
fn build_fading_vbo(world: World, tick: integer) -> (integer, integer) {
  verts: vector<single> = [];
  for f in world.fades {
    elapsed = tick - f.start;
    if elapsed < FADE_FRAMES {
      a = GROUND_ALPHA * (1.0 - elapsed as float / FADE_FRAMES as float);
      push_ground_hex(verts, f.x, f.y, f.color, a as single);
    }
  }
  fading_count = len(verts) / 10;
  fading_vao: integer = 0;
  if fading_count > 0 { fading_vao = graphics::gl_upload_vertices(verts, 10); }
  (fading_vao, fading_count)
}

// Drop fades that have run their course (collect-then-remove so the hash
// is not mutated mid-iteration — same shape as the server's decay sweep).
fn prune_fades(world: World, tick: integer) {
  done: vector<text> = [];
  for f in world.fades {
    if tick - f.start >= FADE_FRAMES { done += [f.ck]; }
  }
  for k in done {
    if world.fades[k] != null { world.fades[k] = null; }
  }
}

// ── Frost crystal pattern (ice-on-window) ────────────────────────────
//
// Pattern logic lives in `audience_crystal` (centre selection, axis-
// based main growth, side branches, height assignment, per-segment
// colour mosaic, aging).  This file only renders the resulting mesh
// as 3D ribbons; widths below are renderer-specific.

MAIN_WIDTH = 0.18;  // cross-section of MAIN crystal beams (HEX_SIZE units).
SIDE_WIDTH = 0.08;  // cross-section of SIDE beams — clearly thinner than the
                    // main so the branches read as lacy feathering rather
                    // than filling the cell solid.

// Emit one quad (a→b→c→d) as two triangles in stride-14 form:
// pos.xyz + zero normal pad + rgba + bloom-anchor.xyz + birth-frame.
// The crystal vertex shader blooms each vertex out from the anchor
// (its cell's centre) by the cell's age, so the mesh stays static and
// the growth animates on the GPU.  `bcx,bcy,bcz` = anchor (world XYZ),
// `birth` = the cell's birth_frame.
fn push_quad(verts: &vector<single>,
             ax: float, ay: float, az: float,
             bx: float, by: float, bz: float,
             cx: float, cy: float, cz: float,
             dx: float, dy: float, dz: float,
             cr: single, cg: single, cb: single, ca: single,
             bcx: single, bcy: single, bcz: single, birth: single) {
  axs = ax as single; ays = ay as single; azs = az as single;
  bxs = bx as single; bys = by as single; bzs = bz as single;
  cxs = cx as single; cys = cy as single; czs = cz as single;
  dxs = dx as single; dys = dy as single; dzs = dz as single;
  verts += [axs, ays, azs, 0.0f, 0.0f, 0.0f, cr, cg, cb, ca, bcx, bcy, bcz, birth];
  verts += [bxs, bys, bzs, 0.0f, 0.0f, 0.0f, cr, cg, cb, ca, bcx, bcy, bcz, birth];
  verts += [cxs, cys, czs, 0.0f, 0.0f, 0.0f, cr, cg, cb, ca, bcx, bcy, bcz, birth];
  verts += [axs, ays, azs, 0.0f, 0.0f, 0.0f, cr, cg, cb, ca, bcx, bcy, bcz, birth];
  verts += [cxs, cys, czs, 0.0f, 0.0f, 0.0f, cr, cg, cb, ca, bcx, bcy, bcz, birth];
  verts += [dxs, dys, dzs, 0.0f, 0.0f, 0.0f, cr, cg, cb, ca, bcx, bcy, bcz, birth];
}

// Emit a solid 3D BEAM (rectangular box prism) following the segment
// (x0,z0,y0)→(x1,z1,y1) with a square `width`×`width` cross-section.
// Four long faces (24 verts), each tinted by a fixed brightness — the
// shader has no lighting pass, so the per-face shade is what makes the
// beam read as a chunky 3D strut rather than a flat ribbon.
fn emit_beam(verts: &vector<single>,
             x0: float, z0: float, y0: float,
             x1: float, z1: float, y1: float,
             width: float,
             cr: float, cg: float, cb: float, ca: single,
             bcx: single, bcy: single, bcz: single, birth: single) {
  dx = x1 - x0;
  dz = z1 - z0;
  ln = sqrt(dx * dx + dz * dz);
  if ln < 0.0001 { return; }
  hw = width * 0.5;          // half perp-width (horizontal, in XZ)
  th = width * 0.5;          // half vertical thickness → square section
  px = (0.0 - dz) / ln * hw;
  pz = dx / ln * hw;
  // +perp (a) / -perp (b) edges at each endpoint; top (+th) / bottom (-th).
  a0x = x0 + px; a0z = z0 + pz;  b0x = x0 - px; b0z = z0 - pz;
  a1x = x1 + px; a1z = z1 + pz;  b1x = x1 - px; b1z = z1 - pz;
  y0t = y0 + th; y0b = y0 - th;  y1t = y1 + th; y1b = y1 - th;
  // brightness per face → fake directional light
  tr = cr as single; tg = cg as single; tb = cb as single;            // top  1.0
  sr = (cr * 0.7) as single; sg = (cg * 0.7) as single; sb = (cb * 0.7) as single;  // side 0.7
  dr = (cr * 0.45) as single; dg = (cg * 0.45) as single; db = (cb * 0.45) as single; // bottom 0.45
  // top
  push_quad(verts, a0x, y0t, a0z, b0x, y0t, b0z, b1x, y1t, b1z, a1x, y1t, a1z, tr, tg, tb, ca, bcx, bcy, bcz, birth);
  // bottom
  push_quad(verts, a0x, y0b, a0z, a1x, y1b, a1z, b1x, y1b, b1z, b0x, y0b, b0z, dr, dg, db, ca, bcx, bcy, bcz, birth);
  // +perp side
  push_quad(verts, a0x, y0t, a0z, a1x, y1t, a1z, a1x, y1b, a1z, a0x, y0b, a0z, sr, sg, sb, ca, bcx, bcy, bcz, birth);
  // -perp side
  push_quad(verts, b0x, y0t, b0z, b0x, y0b, b0z, b1x, y1b, b1z, b1x, y1t, b1z, sr, sg, sb, ca, bcx, bcy, bcz, birth);
}

// Bake the crystal mesh — generate the segment list via the
// audience_crystal library, then emit a flat horizontal ribbon for
// each segment.  Width is per-kind (MAIN ribbons thicker than SIDE)
// so the spines read as the dominant structure.
fn build_crystal_vbo(snap: CellSnap, births: vector<integer>,
                     state: CrystalState, tick: integer) -> (integer, integer) {
  verts: vector<single> = [];
  cm = crystal_segments_aged(snap, state, tick);
  main_w = MAIN_WIDTH * HEX_SIZE;
  side_w = SIDE_WIDTH * HEX_SIZE;
  // Per-cell bloom anchor (cell centre) + birth, computed ONCE; each
  // segment then looks these up by its owning cell index, so the GPU
  // growth shader blooms every cell's crystal out from its centre.
  // PF2: build the coord→index hash inline (a helper that RETURNS the
  // hash trips @P300) and use cell_h_at so the height precompute is O(N),
  // not O(N²).
  ncells = len(snap.xs);
  pidx: hash<audience_crystal::CellRef[ck]> = [];
  for pi in 0..ncells {
    pidx += [audience_crystal::CellRef{ck: audience_crystal::enc_coord(snap.xs[pi], snap.ys[pi]), ix: pi}];
  }
  cxs: vector<single> = []; cys: vector<single> = []; czs: vector<single> = [];
  cbirth: vector<single> = [];
  for ci in 0..ncells {
    cxs += [cell_wx(snap.xs[ci], snap.ys[ci]) as single];
    cys += [cell_h_at(snap, pidx, ci) as single];
    czs += [cell_wz(snap.ys[ci]) as single];
    cbirth += [births[ci] as single];
  }
  for bcv_i in 0..len(cm.kinds) {
    seg_c = cm.colors[bcv_i];
    cr = palette_r(seg_c);
    cg = palette_g(seg_c);
    cb = palette_b(seg_c);
    w = side_w;
    if cm.kinds[bcv_i] == KIND_MAIN { w = main_w; }
    own = cm.cell_ix[bcv_i];
    emit_beam(verts,
      cm.x0s[bcv_i], cm.z0s[bcv_i], cm.y0s[bcv_i],
      cm.x1s[bcv_i], cm.z1s[bcv_i], cm.y1s[bcv_i],
      w, cr, cg, cb, 1.0f,
      cxs[own], cys[own], czs[own], cbirth[own]);
  }
  crystal_count = len(verts) / 14;
  crystal_vao = graphics::gl_upload_vertices(verts, 14);
  (crystal_vao, crystal_count)
}

// Hex world coordinates — convert offset (x, y) hex coords to world XZ
// position on the ground plane.  HEX_SIZE = world units per hex
// circumradius; identical layout to the 2D screen pos (just dropped
// into the 3D world's XZ plane with Y up).  World X = hex column
// direction, world Z = hex row direction.
fn hex_world_x(hx: integer, hy: integer) -> float {
  parity = hy - (hy / 2) * 2;
  if parity < 0 { parity = parity + 2; }
  shift = 0.0;
  if parity == 1 { shift = SQRT3 / 2.0 * HEX_SIZE; }
  hx as float * SQRT3 * HEX_SIZE + shift
}
fn hex_world_z(hy: integer) -> float {
  hy as float * 1.5 * HEX_SIZE
}

// build_view_matrix is defined LATER — must appear after the AutoCam
// struct so loft's pass-1 type inference knows the field types.

// Auto-camera state — a single "end-pose" model.  On every paint
// event we snapshot the destination pose the camera should land at
// (position = edit, rotation = direction toward edit, tilt = 0 for
// the resting top-down view).  Every frame, the current pose
// lerps toward the end-pose at ONE common rate.  No phased gating,
// no rotation-then-translation sequence — the simultaneous lerp
// is the "smoothest transition" the user asked for.
//
// Tilt receives an immediate kick on each new edit so the
// anticipation lean reads as a clear gesture; from there it
// decays back to 0 over the same lerp as the position.
struct AutoCam {
  pos_x:    float,
  pos_y:    float,
  end_x:    float,           // destination position (= latest edit)
  end_y:    float,
  rotation: float,           // current rotation, radians
  end_rot:  float,           // destination rotation (= direction toward last edit, frozen at edit-time)
  tilt:     float,           // current tilt, 0..1
  edit_tick:  integer not null, // frame number when the latest edit was recorded (drives the fade-in)
  ready_tick: integer not null, // frame when rotation + tilt first reached "settled" after the latest edit;
                                // -1 while not yet settled.  Position only lerps once
                                // (tick - ready_tick) >= CAMERA_PAUSE_FRAMES.
}

// Build the view matrix from the AutoCam.  Lives below the struct so
// pass-1 type inference knows the field types.  The cam.pos/end/
// rotation/tilt fields drive an FPS-style eye:
//   - focal point = look-at shift: pos + tilt * (end - pos)
//   - eye = focal + tilt * back_offset (in -yaw direction) + height
//     where height drops as tilt rises (camera drops from "directly
//     above looking down" at tilt=0 to "lower behind looking forward
//     at the focal" at tilt=1).
fn build_view_matrix(cam: AutoCam) -> math::Mat4 {
  bvm_dx: float = cam.end_x - cam.pos_x;
  bvm_dy: float = cam.end_y - cam.pos_y;
  bvm_view_hx: float = cam.pos_x + cam.tilt * bvm_dx;
  bvm_view_hy: float = cam.pos_y + cam.tilt * bvm_dy;
  bvm_iy = bvm_view_hy as integer;
  bvm_parity = bvm_iy - (bvm_iy / 2) * 2;
  if bvm_parity < 0 { bvm_parity = bvm_parity + 2; }
  bvm_shift = 0.0;
  if bvm_parity == 1 { bvm_shift = SQRT3 / 2.0 * HEX_SIZE; }
  focal_wx = bvm_view_hx * SQRT3 * HEX_SIZE + bvm_shift;
  focal_wz = bvm_view_hy * 1.5 * HEX_SIZE;
  // Eye = focal + back_dir * tilt * BACK_OFFSET, at HEIGHT(tilt).
  // back_dir = (sin(cam.rotation), 0, cos(cam.rotation)) — so at
  // cam.rotation=0 the eye is at +Z from focal (camera looks toward
  // -Z = "north" = the screen-up direction at rest).
  back_x = sin(cam.rotation);
  back_z = cos(cam.rotation);
  back_offset = 22.0 * HEX_SIZE * cam.tilt;
  height = (28.0 * (1.0 - cam.tilt) + 10.0 * cam.tilt) * HEX_SIZE;
  eye_x = focal_wx + back_x * back_offset;
  eye_z = focal_wz + back_z * back_offset;
  eye_y = height;
  // Up vector = world -Z ("north") rather than +Y, so a top-down view
  // (eye directly above focal) doesn't hit gimbal lock — at tilt=0
  // forward=(0,-1,0) and up=(0,1,0) would be parallel and produce a
  // degenerate view matrix (whole screen renders black).  (0,0,-1)
  // also fixes "screen up" to always equal world-north — natural for
  // a map / overhead view.
  math::mat4_look_at(
    math::vec3(eye_x, eye_y, eye_z),
    math::vec3(focal_wx, 0.0, focal_wz),
    math::vec3(0.0, 0.0, 0.0 - 1.0)
  )
}

// Tuning knobs — rotation + tilt converge at CAMERA_LERP; the actual
// translation (fly-to) uses the slower CAMERA_LERP_POS so the camera
// turns briskly but drifts to the new spot gently.
CAMERA_LERP        = 0.07;
CAMERA_LERP_POS    = 0.025;  // position fly-to rate (slower than the turn)
CAMERA_TILT_KICK   = 0.25;   // tilt jumps to this on every new edit so the
                             // anticipation reads as a quick gesture before
                             // the distance-based desired_tilt takes over
CAMERA_LOOKAT_DIST = 8.0;    // distance (in hex coords) at which desired tilt
                             // hits 1.0 — i.e. how close the edit can be before
                             // the view stops shifting and you see the
                             // top-down approach
CAMERA_FADE_FRAMES = 12;     // ~0.2 s @ 60 fps: lerp speed eases in from
                             // 0 over this many frames after each edit so
                             // the camera doesn't jolt forward on a fresh
                             // event — gives the eye time to register the
                             // tilt kick + the new orientation before the
                             // translation actually starts moving
CAMERA_SETTLED_RAD = 0.10;   // rotation must be within this many radians of
                             // its end value (≈ 5.7°) AND tilt must be
                             // below this many units of 0 before position
                             // is allowed to start lerping
CAMERA_PAUSE_FRAMES = 6;     // ~0.1 s @ 60 fps: hold after rotation + tilt
                             // settle before position begins moving — gives
                             // a clean "orient — pause — translate" beat

// Record a fresh paint event by computing the END POSE the camera
// should land at, then storing it so cam_step can lerp toward it.
// The end pose: position = edit, rotation = direction from current
// position toward the edit (frozen at edit time, doesn't update as we
// move so the rotation lerp is a single smooth arc), tilt = 0 (the
// resting top-down view).  Tilt also receives an immediate kick to
// CAMERA_TILT_KICK so the anticipation lean reads as one gesture
// that decays during the trip.
fn cam_record(cam: AutoCam, x: integer, y: integer, tick: integer) {
  cam.end_x       = x as float;
  cam.end_y       = y as float;
  cam.tilt        = CAMERA_TILT_KICK;
  cam.edit_tick   = tick;
  cam.ready_tick  = 0 - 1;     // reset: must re-settle rotation+tilt before
                               // position can lerp again toward the new end
  // end_rot is NOT set here — `cam_step` recomputes it each frame from
  // (end - current_pos) so the rotation tracks the target during motion
  // too (user spec: "it is fine to rotate the camera during the actual
  // move so the goals stays in view").
}

// Wrap an angular difference into (-π, π] so a lerp from near +π to
// near -π takes the SHORT route instead of spinning all the way
// around the long way.  Returned `diff` has the same sign as the
// direction the lerp should move.
fn angle_diff(desired: float, current: float) -> float {
  d = desired - current;
  while d >  PI { d = d - 2.0 * PI; }
  while d < 0.0 - PI { d = d + 2.0 * PI; }
  d
}

fn lerp_angle(current: float, desired: float, factor: float) -> float {
  current + angle_diff(desired, current) * factor
}

// Step the camera one frame.  Simple synchronised lerp: pos,
// rotation, and tilt all chase their end values at one common rate
// (CAMERA_LERP).  No phases, no gating.  The end values are set in
// `cam_record` whenever a new paint event arrives:
//   - end_x / end_y = the latest paint's position
//   - end_rot       = rotation that puts the (frozen at edit-time)
//                     travel direction at the top of the screen
//   - tilt's end    = 0 (top-down at rest); tilt is kicked up to
//                     CAMERA_TILT_KICK at edit-time and then lerps
//                     back down through the trip
// All three values converge together: by the time pos has settled
// on the edit, rotation has landed at its target and tilt has
// returned to 0.  Single smooth arc through (rotation, tilt) space,
// concurrent with the translation through (x, y) space.
fn cam_step(cam: AutoCam, tick: integer) {
  // Refresh the desired rotation from CURRENT position toward the
  // destination — so rotation tracks the target during the translation
  // phase too.  Skip the update when distance is tiny (atan2 on a
  // near-zero vector produces jitter) so the rotation holds steady at
  // the arrival.
  dx = cam.end_x - cam.pos_x;
  dy = cam.end_y - cam.pos_y;
  dist_sq = dx * dx + dy * dy;
  if dist_sq > 0.25 {
    travel_angle = atan2(dy, dx);
    cam.end_rot  = 0.0 - (PI / 2.0) - travel_angle;
  }

  // Ease-in: lerp factor ramps from 0 to full over CAMERA_FADE_FRAMES
  // after the latest edit.  Quadratic so the very first frames after
  // an edit have ~zero motion; ramps up to full speed by the time the
  // fade frames are done; stays at full speed thereafter.
  elapsed = tick - cam.edit_tick;
  if elapsed < 0 { elapsed = 0; }
  t = elapsed as float / CAMERA_FADE_FRAMES as float;
  if t > 1.0 { t = 1.0; }
  k = CAMERA_LERP * t * t;

  // Rotation lerps toward end_rot.
  cam.rotation = lerp_angle(cam.rotation, cam.end_rot, k);

  // Tilt is DISTANCE-driven so the look-at view-shift always brings
  // the edit into the frame: full tilt for any edit ≥ CAMERA_LOOKAT_DIST
  // hexes away, scaling linearly down as the camera approaches.  Both
  // rotation + tilt lerp at the same `k` so they reach their settled
  // values together — one combined gesture, ending when the goal is
  // centred and the camera is oriented.
  desired_tilt = sqrt((cam.end_x - cam.pos_x) * (cam.end_x - cam.pos_x)
                    + (cam.end_y - cam.pos_y) * (cam.end_y - cam.pos_y))
               / CAMERA_LOOKAT_DIST;
  if desired_tilt > 1.0 { desired_tilt = 1.0; }
  cam.tilt = cam.tilt + (desired_tilt - cam.tilt) * k;

  // Position is GATED on rotation being settled, plus a brief
  // CAMERA_PAUSE_FRAMES hold — gives a clean "orient + tilt — pause —
  // translate" beat.  Tilt convergence isn't gated on; it tracks
  // distance and naturally relaxes as the camera approaches.
  rot_off = angle_diff(cam.end_rot, cam.rotation);
  if rot_off < 0.0 { rot_off = 0.0 - rot_off; }
  if rot_off >= CAMERA_SETTLED_RAD {
    cam.ready_tick = 0 - 1;
  } else {
    if cam.ready_tick < 0 { cam.ready_tick = tick; }
    if tick - cam.ready_tick >= CAMERA_PAUSE_FRAMES {
      pos_k = CAMERA_LERP_POS * t * t;   // slower than the turn rate `k`
      cam.pos_x = cam.pos_x + (cam.end_x - cam.pos_x) * pos_k;
      cam.pos_y = cam.pos_y + (cam.end_y - cam.pos_y) * pos_k;
    }
  }
}

// Apply a single incoming text frame to the world.  Format inherited
// from server.loft: `<msg_id>:<payload>`.  We only care about msg 4
// (world delta).  msg 5 (active-player signal) is ignored in the MVP
// — phase 0.8 (jump-to-active) is desktop UI, not projector spectacle.
fn apply_frame(world: World, cam: AutoCam, tick: integer, frame: text) {
  colon = frame.find(":");
  if colon == null {
    println("projector: dropped malformed frame {frame}");
    return;
  }
  msg_id = frame[..colon] as integer;
  payload = frame[colon + 1..];
  if msg_id != 4 {
    if msg_id != 5 { println("projector: ignoring msg_id={msg_id} payload={payload}"); }
    return;
  }
  (x, y, c) = parse_xyc(payload);
  k = cell_key(x, y);
  if c == 0 {
    // erase — start a ground-footprint fade from the cell's current
    // colour, then remove it from the live world (the crystal + opaque
    // ground rebuild without it; the fade VBO carries the dwindling tile).
    existing = world.cells[k];
    if existing != null {
      if world.fades[k] != null { world.fades[k] = null; }   // clear any stale fade
      world.fades += [FadeCell{ck: k, x: x, y: y, color: existing.color, start: tick}];
      world.cells[k] = null;
      world.version = world.version + 1;
    }
    println("projector: erase ({x},{y}) — total cells={len(world.cells)}");
    // Erases count as activity too — the camera should swing to a
    // newly-cleared area same as it does to a new paint.
    cam_record(cam, x, y, tick);
  } else {
    if world.fades[k] != null { world.fades[k] = null; }   // a re-paint cancels an in-flight fade
    existing = world.cells[k];
    if existing == null {
      world.cells += [Cell{ck: k, x: x, y: y, color: c,
                           paint_tick: world.paint_tick_next,
                           birth_frame: tick}];
      world.paint_tick_next = world.paint_tick_next + 1;
      world.version = world.version + 1;
      println("projector: paint ({x},{y}) c={c} — total cells={len(world.cells)}");
    } else {
      if existing.color != c {
        existing.color = c;
        world.version = world.version + 1;
      }
      println("projector: repaint ({x},{y}) c={c} — total cells={len(world.cells)}");
    }
    cam_record(cam, x, y, tick);
  }
}

fn main() {
  // LOFT_PROJ_FULLSCREEN=1 opens borderless fullscreen at the monitor's
  // native resolution; otherwise a 1280x800 window.
  fullscreen = env_variable("LOFT_PROJ_FULLSCREEN") != "";
  ok = if fullscreen {
    graphics::gl_create_fullscreen_window("Audience Projector — @PLAN36")
  } else {
    graphics::gl_create_window(WIN_W, WIN_H, "Audience Projector — @PLAN36")
  };
  if !ok {
    println("projector: FAILED to create OpenGL window");
    return;
  }
  // Use the ACTUAL window size (fullscreen = native res) for projection,
  // 2D ortho, and overlay placement — falling back to the windowed hint.
  win_w = graphics::gl_window_width();
  if win_w <= 0 { win_w = WIN_W; }
  win_h = graphics::gl_window_height();
  if win_h <= 0 { win_h = WIN_H; }
  println("projector: window {win_w}x{win_h} open (fullscreen={fullscreen})");

  // 3D pipeline — two baked VBOs (ground triangles + crystal lines)
  // sharing one per-vertex-colour shader.  VBOs are rebuilt only when
  // world.version changes (paint / erase event), NOT every frame;
  // the steady-state render cost is one gl_draw_mode per VBO + one
  // set_uniform_mat4 per layer.
  graphics::gl_enable(graphics::GL_DEPTH_TEST);
  // Alpha blending — opaque cells bake alpha 1.0 (no visual change), but
  // fading cells ramp their ground footprint to transparent over the fade.
  graphics::gl_enable(graphics::GL_BLEND);
  graphics::gl_blend_func(graphics::BLEND_SRC_ALPHA, graphics::BLEND_ONE_MINUS_SRC_ALPHA);
  cell_shader = graphics::gl_create_shader(CELL_VERT, CELL_FRAG);
  crystal_shader = graphics::gl_create_shader(CRYSTAL_VERT, CRYSTAL_FRAG);
  graphics::gl_line_width(2.0);    // ~2 px wide crystal lines — readable
                                   // at projector distance
  proj_matrix   = math::mat4_perspective(0.9, win_w as float / win_h as float, 1.0, 4000.0);
  println("projector: 3D cell shader + perspective projection ready");

  // Optional "scan to join" QR overlay in the top-right corner.  Pass a
  // pre-rendered QR PNG path via LOFT_PROJ_QR (e.g. of the audience page
  // URL); it's loaded as a texture and drawn screen-space each frame.
  qr_path = env_variable("LOFT_PROJ_QR");
  qr_tex: integer = 0;
  qr_painter = graphics::create_painter_2d(win_w as float, win_h as float);
  if qr_path != "" {
    qr_tex = graphics::gl_load_texture(qr_path);
    if qr_tex == 0 { println("projector: QR load failed for {qr_path}"); }
    else { println("projector: QR overlay from {qr_path}"); }
  }

  // Server URL: LOFT_PROJ_SERVER overrides the local default, so the same
  // projector can point at a remote audience server (e.g. a public demo).
  server_url = env_variable("LOFT_PROJ_SERVER");
  if server_url == "" { server_url = SERVER_URL; }
  println("projector: connecting to {server_url}");
  ws = web::ws_handler(server_url);
  if ws == null {
    println("projector: FAILED ws_handler({server_url})");
    graphics::gl_destroy_window();
    return;
  }
  println("projector: ws session opened (auto-reconnects on drop)");

  world = World{cells: [], version: 0, paint_tick_next: 0, fades: []};

  // Optional one-shot framebuffer capture (LOFT_PROJ_SHOT=<path>): grab the
  // GL back-buffer once the world has replayed + the camera has settled, so
  // the live 3D output can be inspected on a headless / Wayland desktop.
  shot_path = env_variable("LOFT_PROJ_SHOT");
  shot_done = false;
  // Persistent crystal aging state — owned by main, updated whenever
  // world.version changes.  `lookup_main_birth(state, …)` is queried by
  // crystal_segments_aged to scale side-branch length by main age.
  crystal_state = CrystalState{
    main_x: [], main_y: [], main_d: [], birth_tick: [],
  };
  // Mesh state — rebuilt lazily when world.version changes.  Start at
  // -1 / 0 so the first frame after the snapshot arrives triggers an
  // initial build (an empty world bakes empty VBOs, harmless).
  last_built_version: integer = 0 - 1;
  ground_vao: integer = 0;
  ground_vert_count: integer = 0;
  crystal_vao: integer = 0;
  crystal_vert_count: integer = 0;
  fading_vao: integer = 0;
  auto_cam = AutoCam{
    pos_x: 0.0, pos_y: 0.0,
    end_x: 0.0, end_y: 0.0,
    rotation: 0.0, end_rot: 0.0,
    tilt: 0.0,
    edit_tick: 0,
    ready_tick: 0 - 1,
  };

  // Ask the server for a full snapshot.  Catches the case where the
  // initial connect-time replay missed frames (lib/web buffer ramp-up,
  // WS handshake race, mid-show reconnect, etc.).  Re-requested below
  // every 2 seconds while world is still empty.
  ws.send("6:");
  snapshot_retry_at = 120;          // frame number; re-request if still empty
  snapshot_retries  = 0;            // capped at 3 attempts; see watchdog below

  // Dark-blue background — matches doc/audience-demo/index.html --bg.
  bg = graphics::rgba(10, 10, 20, 255);

  frames = 0;
  delta_count = 0;
  while graphics::gl_poll_events() {
    // 1. Drain any pending server frames into world state.
    while true {
      msg = ws.try_recv();
      if msg == null { break; }
      apply_frame(world, auto_cam, frames, msg);
      delta_count = delta_count + 1;
    }

    // 2. Step the auto-camera: heat-field decay + lerp toward the
    //    exp-weighted centroid of recent activity.  Cheap when
    //    `recent` is small; bounded by CAMERA_MAX_HIST in the worst
    //    case.  Runs every frame so the motion stays smooth at 60 fps.
    cam_step(auto_cam, frames);
    // Log camera position every ~2 seconds so an outside observer
    // (tail -f the projector log) can see it swing without needing
    // to read pixels off the screen.
    if frames - (frames / 120) * 120 == 0 && frames > 0 {
      println("projector: cam pos=({auto_cam.pos_x}, {auto_cam.pos_y}) end=({auto_cam.end_x}, {auto_cam.end_y}) rot={auto_cam.rotation}/{auto_cam.end_rot} tilt={auto_cam.tilt}");
    }

    // 3. Rebuild VBOs on world change.  ground_vbo covers every chunk
    //    that has at least one painted cell (extends as new chunks
    //    come alive); crystal_vbo holds the line-wireframe top of
    //    every filled cell.  Both are baked here only when the
    //    world has actually mutated since last frame — between
    //    edits, render is one draw call per VBO.
    if world.version != last_built_version {
      if ground_vao != 0  { graphics::gl_delete_vao(ground_vao);  }
      if crystal_vao != 0 { graphics::gl_delete_vao(crystal_vao); }
      ss = snapshot_cells(world);
      snap = ss.snap;
      // The crystal lib renders every main at DEFAULT_AGE (static geometry);
      // the GROW-IN animation is GPU-side: build_crystal_vbo tags each vertex
      // with its cell's centre + birth_frame, and the crystal shader blooms
      // it out from the centre over GROWTH_FRAMES.  So the mesh stays cached
      // (rebuilt only here on world change) while growth animates per frame
      // via the uNow uniform — no per-frame CPU rebuild.
      gres = build_ground_vbo(snap);
      ground_vao        = gres.0;
      ground_vert_count = gres.1;
      cres = build_crystal_vbo(snap, ss.births, crystal_state, frames);
      crystal_vao        = cres.0;
      crystal_vert_count = cres.1;
      last_built_version = world.version;
    }

    // (Crystal growth animation disabled — crystals render statically at
    // DEFAULT_AGE, so there's no per-cadence rebuild.  The VBO is rebuilt
    // only on world.version change above.)

    // 4. Clear + draw — two passes, single draw call each.
    graphics::gl_clear(bg);
    view_matrix = build_view_matrix(auto_cam);
    proj_view = math::mat4_mul(proj_matrix, view_matrix);
    graphics::gl_use_shader(cell_shader);
    graphics::gl_set_uniform_mat4(cell_shader, "uMVP", proj_view.m);
    // (a) Ground layer — filled hex per painted cell, in the cell's
    //     palette colour.  Empty cells render nothing.
    if ground_vert_count > 0 {
      graphics::gl_draw(ground_vao, ground_vert_count);
    }
    // (b) Crystal layer — 3D beams, GROWN in by the crystal shader:
    //     each vertex eases out from its cell's centre over GROWTH_FRAMES,
    //     so a new paint blooms in.  Mesh is cached; only uNow advances.
    graphics::gl_use_shader(crystal_shader);
    graphics::gl_set_uniform_mat4(crystal_shader, "uMVP", proj_view.m);
    graphics::gl_set_uniform_float(crystal_shader, "uNow", frames as float);
    graphics::gl_set_uniform_float(crystal_shader, "uGrowth", GROWTH_FRAMES);
    if crystal_vert_count > 0 {
      graphics::gl_draw(crystal_vao, crystal_vert_count);
    }
    // (c) Fade layer — translucent ground footprints of recently-erased
    //     cells, alpha-ramped to zero over FADE_FRAMES.  Rebuilt every
    //     frame while any fade is active (few cells, cheap) and drawn last
    //     so the blend sits correctly over the opaque layers.  Skipped —
    //     and the VAO released — when nothing is fading.  Stride-10 VBO →
    //     switch back to cell_shader (the crystal layer left crystal_shader
    //     bound, which expects the stride-14 growth attributes).
    if len(world.fades) > 0 {
      graphics::gl_use_shader(cell_shader);
      graphics::gl_set_uniform_mat4(cell_shader, "uMVP", proj_view.m);
      if fading_vao != 0 { graphics::gl_delete_vao(fading_vao); }
      fres = build_fading_vbo(world, frames);
      fading_vao = fres.0;
      fading_count = fres.1;
      if fading_count > 0 {
        graphics::gl_draw(fading_vao, fading_count);
      }
      prune_fades(world, frames);
    } else if fading_vao != 0 {
      graphics::gl_delete_vao(fading_vao);
      fading_vao = 0;
    }
    // "Scan to join" QR overlay, top-right corner (screen-space, on top of
    // the 3D scene).  Depth test off so it always draws over the crystals.
    if qr_tex != 0 {
      qr_size = win_h as float * 0.22;     // scales with the window
      qr_margin = win_h as float * 0.03;
      qr_pad = qr_size * 0.06;
      qr_x = win_w as float - qr_size - qr_margin;
      graphics::gl_disable(graphics::GL_DEPTH_TEST);
      // white backing card (also the QR quiet-zone) then the QR on top
      graphics::draw_rect_at(qr_painter, qr_x - qr_pad, qr_margin - qr_pad,
                             qr_size + qr_pad * 2.0, qr_size + qr_pad * 2.0,
                             1.0, 1.0, 1.0, 1.0);
      graphics::draw_texture_at(qr_painter, qr_tex, qr_x, qr_margin, qr_size, qr_size);
      graphics::gl_enable(graphics::GL_DEPTH_TEST);
    }

    // One-shot capture (before swap → reads the freshly-drawn GL_BACK).
    // Fire after ~3 s so the world has replayed and the camera has settled.
    if shot_path != "" && !shot_done && frames > 180 {
      graphics::gl_screenshot(win_w, win_h, shot_path);
      shot_done = true;
      println("projector: screenshot -> {shot_path}");
    }
    graphics::gl_swap_buffers();
    frames = frames + 1;

    // Watchdog: re-request snapshot a small number of times while the
    // world is still empty (covers the case where the initial replay
    // missed frames).  Capped at 3 attempts so a genuinely empty world
    // doesn't spam the server / log forever.
    if len(world.cells) == 0 && frames >= snapshot_retry_at && snapshot_retries < 3 {
      println("projector: still empty after {frames} frames; re-requesting snapshot");
      ws.send("6:");
      snapshot_retry_at = frames + 120;
      snapshot_retries = snapshot_retries + 1;
    }
  }

  println("projector: window closed after {frames} frames, {delta_count} deltas applied");
  ws.close();
  graphics::gl_destroy_window();
}
