// @PLAN36 sub-task 1.8 — multi-client load test for the audience
// single-port server.  A single driver process opens N real WebSocket
// connections, has each paint a disjoint column of cells, drains the
// broadcast fan-out so the server's per-socket send buffers keep
// flowing, and reports the metrics that tell you whether the server
// kept up: connect time, paints sent, deltas received vs the expected
// fan-out, and throughput.
//
// Usage — start the server first, then run this against it:
//   ./target/release/loft --interpret --no-warnings --lib lib/ \
//       tools/audience-demo/single_port_server.loft &
//   ./target/release/loft --interpret --no-warnings --lib lib/ \
//       tools/audience-demo/load_test.loft
//
// Tip: `rm -f tools/audience-demo/world.bin` before starting the server
// for a clean run (no saved-world replay noise; the load test drains and
// discards any replay it does see, so this only affects connect time).
//
// Env:
//   LOFT_AUD_PORT     — server port (default 18083)
//   LOFT_AUD_PAINTS   — paints per client per tier (default 25)
//   LOFT_AUD_CLIENTS  — if set > 0, run a SINGLE tier of this many
//                       clients instead of the default 3 → 12 → 30 ramp.

use web;

fn env_int(name: text, dflt: integer) -> integer {
  raw = env_variable(name);
  if raw == "" { dflt } else { raw as integer }
}

// Drive one load tier: connect `n` clients, paint `paints` rounds, drain
// the fan-out, print the metrics.  `y_base` separates tiers in world
// space so every paint lands on a fresh (and thus broadcast-worthy) cell
// even as cells accumulate across tiers.
fn run_tier(port: integer, n: integer, paints: integer, y_base: integer) {
  url = "ws://127.0.0.1:{port}/ws";
  println("");
  println("=== tier: {n} clients x {paints} paints ===");

  // 1. Connect.  ws_handler only returns null on a malformed URL, so a
  //    null here is a bug, not "server down" (a down server surfaces
  //    later as send failures + zero deltas).
  clients: vector<web::WsHandler> = [];
  t_connect0 = ticks();
  connected = 0;
  for _ in 0..n {
    wh = web::ws_handler(url);
    if wh == null { println("load: ws_handler returned null (malformed url?)"); continue; }
    clients += [wh];
    connected = connected + 1;
  }
  // Let the server register all upgrades + send its connect-time replay.
  web::sleep_ms(300);

  // 2. Drain (and discard) the initial world replay so it does not count
  //    toward the paint-phase fan-out.
  replay = 0;
  for h in clients {
    while true { m = h.try_recv(); if m == null { break; } replay = replay + 1; }
  }
  connect_ms = (ticks() - t_connect0) / 1000;
  println("load: connected={connected}/{n} in {connect_ms} ms; discarded {replay} replay frames");

  // 3. Paint + drain in rounds.  Each client i paints column x=i so every
  //    (client, round) is a distinct new cell — the server broadcasts one
  //    delta per paint to every active client.  Draining each round keeps
  //    the server's blocking per-socket sends from stalling on a full buf.
  t_paint0 = ticks();
  sent = 0;
  send_fail = 0;
  received = 0;
  for round in 0..paints {
    ci = 0;
    for h in clients {
      x = ci;
      y = y_base + round * 2;
      c = (ci - (ci / 9) * 9) + 1;     // 1..9, integer-only modulo
      if h.send("1:{x},{y},{c}") { sent = sent + 1; } else { send_fail = send_fail + 1; }
      ci = ci + 1;
    }
    for h in clients {
      while true {
        m = h.try_recv();
        if m == null { break; }
        if m.starts_with("4:") { received = received + 1; }
      }
    }
  }

  // 4. Final drain — collect stragglers until ~0.5 s of consecutive quiet
  //    (hard-capped at ~15 s so a misbehaving server can't hang the test).
  quiet = 0;
  guard = 0;
  while quiet < 100 && guard < 3000 {
    got = 0;
    for h in clients {
      while true {
        m = h.try_recv();
        if m == null { break; }
        if m.starts_with("4:") { received = received + 1; got = got + 1; }
      }
    }
    guard = guard + 1;
    if got == 0 { quiet = quiet + 1; web::sleep_ms(5); } else { quiet = 0; }
  }
  paint_ms = (ticks() - t_paint0) / 1000;

  // 5. Report.  Each successful new-cell paint echoes to all `connected`
  //    clients (sender included), so a healthy fan-out is ~100%.  A low
  //    percentage means the server dropped clients or fell behind.
  //
  //    The two numbers that matter for "does the server keep up":
  //      - fanout%  — correctness of the broadcast (should stay 100%).
  //      - connect_ms (printed above) — the real scaling wall: it grows
  //        super-linearly because the single-threaded loop is busy
  //        polling + replaying and slow to accept new sockets.
  //    `paints/s` is END-TO-END wall time including the ~0.5 s drain
  //    settle below, NOT raw server capacity — read it as a coarse
  //    "did the round trip finish promptly", not a throughput benchmark.
  expected = sent * connected;
  pct = if expected > 0 { received * 100 / expected } else { 0 };
  rate = if paint_ms > 0 { sent * 1000 / paint_ms } else { 0 };
  println("load: sent={sent} send_fail={send_fail} received={received} expected~{expected} fanout={pct}%");
  println("load: paint+drain wall {paint_ms} ms (~{rate} paints/s end-to-end, incl. settle)");

  // 6. Tear down.
  for h in clients { h.close(); }
  web::sleep_ms(200);
}

fn main() {
  port = env_int("LOFT_AUD_PORT", 18083);
  paints = env_int("LOFT_AUD_PAINTS", 25);
  single = env_int("LOFT_AUD_CLIENTS", 0);
  println("audience load test -> ws://127.0.0.1:{port}/ws  (paints/client={paints})");
  if single > 0 {
    run_tier(port, single, paints, 0);
  } else {
    run_tier(port, 3,  paints, 0);
    run_tier(port, 12, paints, 1000);
    run_tier(port, 30, paints, 2000);
  }
  println("");
  println("load: done");
}
