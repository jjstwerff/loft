// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// @PLAN36 — combined HTTP + multi-client WebSocket server.
//
// One port, one process, serves both:
//   GET /                → doc/audience-demo/index.html  (page)
//   GET /index.html      → doc/audience-demo/index.html
//   ws://.../ws          → multi-client WebSocket session
//
// Each new WS client gets:
//   1. A full replay of the current world (one `4:x,y,c` per cell).
//   2. Real-time broadcast of every paint / clear from every other
//      client.
// And handles:
//   - msg 1 (seed)         from client  →  paint cell, broadcast 4:
//   - msg 2 (clear)        from client  →  empty cell, broadcast 4: with c=0
//   - msg 3 (color_select) from client  →  record + broadcast 5:
//   - msg 6 (snapshot)     from client  →  re-replay world to that client
//
// Phone URL on the same WiFi (no `?ws=` override needed — the page
// auto-derives WS from location.host):
//   http://<lan-ip>:18083/
//
// Run:
//   ./target/release/loft --interpret --no-warnings --lib lib/ \
//       tools/audience-demo/single_port_server.loft
//
// Implementation note: lib/server's multi-client `srv.run(on_event)`
// is a blocking event pump that doesn't expose HTTP requests, so this
// program drives the loop manually using the non-blocking single-
// client primitives (`srv.next()` + `WebSocket.next()`).  Each
// connection is either an HTTP request (served + closed) or a WS
// upgrade (registered into the pool).  The pool is polled every
// loop iteration with a 2 ms idle sleep when there's no work.

use server;
use web;       // sleep_ms

PORT = 18083;

// ── World + client state ─────────────────────────────────────────────────────

struct Cell {
  ck:         text not null,
  x:          i32 not null,    // typed at field declaration → `f += c.x` writes 4 bytes
  y:          i32 not null,    // automatically, no `as i32` cast at the write site
  color:      u8 not null,
  birth_tick: u32 not null,    // world.tick at creation — age = world.tick - birth_tick.
                               // 10 Hz tick rate ⇒ u32 won't wrap for ~13 years of
                               // continuous run.  Reset on a true re-paint (seed
                               // that creates a brand-new Cell); preserved across
                               // server restarts via the persisted snapshot.
}

struct Client {
  ws:     server::WebSocket,
  active: boolean not null,         // false → drop on next sweep
  color:  integer not null,         // last colour_select (1-9, 0 = cleared)
  lx:     integer not null,         // last-painted x
  ly:     integer not null,
  last_active_tick: integer not null,  // world.tick of this client's last
                                       // paint — 0 = never painted.  Drives
                                       // the active-player heartbeat (1.7)
  // Incremental replay (Tier A / @PLAN36-1.8): on connect we snapshot the
  // current cell keys here and stream them a budget at a time from the main
  // loop, so the accept path never blocks on a full O(cells) world dump.
  replay_keys: vector<text>,
  replay_pos:  integer not null,       // next index into replay_keys to send
}

struct World {
  cells:        hash<Cell[ck]>,
  clients:      vector<Client>,
  dirty:        boolean not null,    // mutated since last snapshot?
  last_save_us: integer not null,    // ticks() (µs, i32) of last successful save
                                     // — wraps every ~35 min, harmless for a 5 s
                                     // window: a wrap during the window just skips
                                     // one snapshot until the next dirty event
  tick:         integer not null,    // monotonic 10 Hz wall-clock counter (sub-task
                                     // 1.4 partial — growth/age only; decay deferred).
                                     // Each non-empty cell records its birth_tick so
                                     // age = world.tick - birth_tick (in 100 ms units).
  last_tick_us: integer not null,    // ticks() of the most recent tick-advance —
                                     // same wrap caveat as last_save_us; a wrap
                                     // simply delays the next tick by one window.
  last_active_us: integer not null,  // ticks() of the last active-player
                                     // heartbeat emit (sub-task 1.7, 1 Hz)
}

// ── Wire helpers — leaves first (@P281) ─────────────────────────────────────

fn cell_key(x: integer, y: integer) -> text { "{x},{y}" }

fn delta_frame(x: integer, y: integer, color: integer) -> text {
  "4:{x},{y},{color}"
}
fn active_frame(x: integer, y: integer) -> text {
  "5:{x},{y}"
}

// Parse "x,y,c"
fn parse_xyc(payload: text) -> (integer, integer, integer) {
  i = payload.find(",");
  if i == null {
    (0, 0, 0)
  } else {
    x = payload[..i] as integer;
    rest = payload[i + 1..];
    j = rest.find(",");
    if j == null {
      (x, 0, 0)
    } else {
      y = rest[..j] as integer;
      c = rest[j + 1..] as integer;
      (x, y, c)
    }
  }
}

// Parse "x,y"
fn parse_xy(payload: text) -> (integer, integer) {
  i = payload.find(",");
  if i == null {
    (0, 0)
  } else {
    x = payload[..i] as integer;
    y = payload[i + 1..] as integer;
    (x, y)
  }
}

fn read_index() -> text {
  // Re-read every request — edit + refresh works with no restart.
  f = file("doc/audience-demo/index.html");
  if f.format == Format.NotExists {
    return "<!DOCTYPE html><html><body><h1>500 — doc/audience-demo/index.html missing</h1>"
         + "<p>Run from the loft repo root.</p></body></html>";
  }
  body = f.content();
  body
}

// ── Periodic snapshot — minimum-viable fallback for the full design ────────
//
// Full design in `doc/claude/plans/36-audience-generative-art/01-server-state.md`
// § Persistence — snapshot + change log.  This is the "fallback if blockers
// don't unblock" subset: whole-world dump on a 5-second timer, no change
// log, no CRC, no atomic rename.  Bounded loss = 5 s of paints if killed
// mid-window.  Costs O(N) per snapshot, fires from the main loop only
// when the timer elapses (NOT on every paint), so the per-event hot path
// stays free of disk I/O.
//
// File layout (little-endian, versioned).  v2 adds the world tick +
// per-cell birth_tick so age survives a server restart (sub-task 1.4).
//
//   v1 (legacy — written by commits prior to the tick loop):
//     [4B u32 count]
//     count × { [4B i32 x] [4B i32 y] [1B u8 color] }
//
//   v2 (current):
//     [4B u32 magic = 'WRLD' = 0x444C5257 little-endian]
//     [4B u32 version = 2]
//     [4B u32 world.tick]
//     [4B u32 count]
//     count × { [4B i32 x] [4B i32 y] [1B u8 color] [4B u32 birth_tick] }
//
// world_load auto-detects by peeking the first 4 bytes — if it matches
// the magic we read v2; otherwise we fall back to v1 (no tick, all
// cells get birth_tick = 0 so the loaded world reads as "fully grown"
// to renderers that compute age via world.tick - birth_tick).
WORLD_FILE = "tools/audience-demo/world.bin";
WORLD_FILE_MAGIC   = 0x444C5257;    // 'WRLD' as little-endian u32
WORLD_FILE_VERSION = 2;
SNAPSHOT_INTERVAL_US = 5000000;      // 5 s in µs (fits in i32; ticks() diff promoted to long at the compare site)
// Tick cadence — 10 Hz (resolved in 01-server-state.md § Tick loop).
// The main loop advances world.tick by `(now - last_tick_us) / TICK_INTERVAL_US`
// every iteration so a long sleep / GC pause catches up rather than
// silently dropping ticks.
TICK_INTERVAL_US = 100000;           // 100 ms in µs

// ── Decay (sub-task 1.4) ─────────────────────────────────────────────────────
// Automatic erosion: a non-empty cell is fully removed once its age
// (world.tick - birth_tick, in 100 ms units) passes its lease.  The lease
// grows with filled-neighbour count, so cluster EDGES (fewest neighbours)
// cross the threshold first and decay works inward — "inverse growth" back
// toward empty with no audience effort.  Timing per 01-server-state.md §
// Tick loop (base 5 min, +1 min per neighbour, 30 s window).  All three are
// env-tunable (in ticks) so a load / visual test can speed erosion up:
//   DECAY_BASE / DECAY_LEASE / DECAY_WINDOW.
//
// NOTE: the eligible-but-not-yet-removed shrink ANIMATION the design
// describes needs per-cell age on the wire; the current text wire
// (`4:x,y,color`) carries only colour, so this MVP does a hard removal at
// full expiry and the client treats it like any other clear.  Wiring age
// through is phase 1 step 2 (JSON-in / binary-out migration).
DECAY_BASE_DEFAULT   = 3000;          // 5 min @ 10 Hz
DECAY_LEASE_DEFAULT  = 600;           // +1 min per filled neighbour
DECAY_WINDOW_DEFAULT = 300;           // 30 s eligible → removed
ACTIVE_HEARTBEAT_US  = 1000000;       // 1 s — active-player signal cadence (1.7)

// ── Connect-storm tuning (Tier A / @PLAN36-1.8) ──────────────────────────────
// A1: cells streamed to one mid-replay client per loop iteration.  Bounds the
//     per-connect cost so a big world doesn't stall the accept path.
// A2: connections accepted per loop iteration, so a burst of phones is
//     absorbed in a few passes instead of one-per-iteration.
// A3 (OS backlog) needs no change: the native listener is Rust std
//     `TcpListener::bind`, which already uses a 128-deep accept backlog —
//     ample for a meetup; raise via socket2 only past that.
REPLAY_BUDGET = 64;
ACCEPT_BUDGET = 8;

fn env_int(name: text, dflt: integer) -> integer {
  raw = env_variable(name);
  if raw == "" { dflt } else { raw as integer }
}

// Byte widths come from each field's declared type — `c.x: i32`
// writes 4 bytes automatically, `c.color: u8` writes 1.  The only
// remaining explicit cast is on `n` because it's a loose local
// integer (i64 storage).
fn world_save(world: World) {
  n: integer = 0;
  for _ in world.cells { n = n + 1; }
  {
    f = file(WORLD_FILE);
    f#format = LittleEndian;
    // Snapshot semantics: each save replaces the previous file.  Make
    // the truncation explicit so the sequence keeps working once `+=`
    // is append-only (rather than truncating on first reopen).
    f.set_file_size(0);
    f += (WORLD_FILE_MAGIC   as u32);
    f += (WORLD_FILE_VERSION as u32);
    f += (world.tick as u32);
    f += (n as u32);
    for c in world.cells {
      f += c.x;
      f += c.y;
      f += c.color;
      f += c.birth_tick;
    }
    f.sync();
  }
  world.dirty = false;
  world.last_save_us = ticks();
  println("single-port: [snapshot saved] tick={world.tick} cells={n} → {WORLD_FILE}");
}

fn world_load(world: World) {
  if !exists(WORLD_FILE) {
    println("single-port: no world snapshot at {WORLD_FILE} — starting empty");
    return;
  }
  f = file(WORLD_FILE);
  f#format = LittleEndian;
  // Auto-detect v1 vs v2 by peeking the first 4 bytes against the magic.
  // v1 puts a count there; counts < magic in practice so a magic match
  // unambiguously means v2.
  head = f#read as u32;
  loaded = 0;
  if head == WORLD_FILE_MAGIC {
    version = f#read as u32;
    if version != WORLD_FILE_VERSION {
      println("single-port: snapshot version {version} not understood (expected {WORLD_FILE_VERSION}) — starting empty");
      return;
    }
    world.tick = f#read as u32;
    n = f#read as u32;
    i = 0;
    while i < n {
      x          = f#read as i32;
      y          = f#read as i32;
      c          = f#read as u8;
      birth_tick = f#read as u32;
      if c >= 1 && c <= 9 {
        k = cell_key(x, y);
        if world.cells[k] == null {
          world.cells += [Cell{ck: k, x: x, y: y, color: c, birth_tick: birth_tick}];
          loaded = loaded + 1;
        }
      }
      i = i + 1;
    }
    println("single-port: loaded {loaded} cells (v2) from {WORLD_FILE} — resuming at tick={world.tick}");
  } else {
    // v1 — head was the cell count.  No tick was persisted, so the
    // restored world reads as "always existed" (every birth_tick = 0).
    n = head;
    i = 0;
    while i < n {
      x = f#read as i32;
      y = f#read as i32;
      c = f#read as u8;
      if c >= 1 && c <= 9 {
        k = cell_key(x, y);
        if world.cells[k] == null {
          world.cells += [Cell{ck: k, x: x, y: y, color: c, birth_tick: 0}];
          loaded = loaded + 1;
        }
      }
      i = i + 1;
    }
    println("single-port: loaded {loaded} cells (v1 legacy) from {WORLD_FILE} — birth_tick reset to 0");
  }
}

// Broadcast a frame to every client that's still marked active.  send()
// returns false when the underlying socket is closed — flag the client
// for removal on the next sweep.
fn broadcast(world: World, msg: text) {
  for c in world.clients {
    if c.active {
      if !c.ws.send(msg) {
        c.active = false;
      }
    }
  }
}

// Queue a full-world replay for `target` (Tier A): append the current cell
// keys to its replay list; the main loop streams them via advance_replays.
// Used for the snapshot-request (msg 6) re-replay; the connect path seeds
// replay_keys at construction instead.  Append (not reassign) so a repeat
// request just extends the list — advance_replays reads each cell's CURRENT
// value at send time, so re-replaying is always consistent.
fn queue_replay(world: World, target: Client) {
  for cell in world.cells { target.replay_keys += [cell.ck]; }
}

// Stream up to REPLAY_BUDGET cells to every client that still has replay
// pending.  Each cell's colour is read at send time (skipping any since
// emptied), so replay never overwrites a fresher live delta with a stale
// snapshot value.  Bounds the per-iteration cost so a connect storm keeps
// the accept path responsive.
fn advance_replays(world: World) {
  for c in world.clients {
    if !c.active { continue; }
    budget = REPLAY_BUDGET;
    while c.replay_pos < len(c.replay_keys) && budget > 0 {
      rk = c.replay_keys[c.replay_pos];
      c.replay_pos = c.replay_pos + 1;
      cell = world.cells[rk];
      if cell != null {
        if !c.ws.send(delta_frame(cell.x, cell.y, cell.color)) { c.active = false; break; }
        budget = budget - 1;
      }
    }
  }
}

// Apply one parsed message from a client.  May mutate world.cells and
// world.clients, may broadcast.
fn handle_message(world: World, sender: Client, msg_id: integer, payload: text) {
  if msg_id == 1 {
    // seed "x,y,color"
    (x, y, c) = parse_xyc(payload);
    if c < 1 || c > 9 { return; }
    k = cell_key(x, y);
    existing = world.cells[k];
    if existing != null {
      if existing.color == c {
        // own-colour tap → erase
        world.cells[k] = null;
        broadcast(world, delta_frame(x, y, 0));
        world.dirty = true;
        return;
      }
      // other-colour tap → ignore
      return;
    }
    world.cells += [Cell{ck: k, x: x, y: y, color: c,
                         birth_tick: world.tick}];
    sender.lx = x;
    sender.ly = y;
    sender.last_active_tick = world.tick;
    broadcast(world, delta_frame(x, y, c));
    world.dirty = true;
  } else if msg_id == 2 {
    // clear "x,y" (unconditional)
    (x, y) = parse_xy(payload);
    k = cell_key(x, y);
    if world.cells[k] != null {
      world.cells[k] = null;
      broadcast(world, delta_frame(x, y, 0));
      world.dirty = true;
    }
  } else if msg_id == 3 {
    // color_select "color" — record only.  The active-player signal is now
    // emitted by the 1 Hz heartbeat in main() (sub-task 1.7), not per-change
    // (per-change was rejected as overwhelming during busy periods — see
    // 01-server-state.md § Active-player signal).
    c = payload as integer;
    sender.color = c;
  } else if msg_id == 6 {
    // snapshot request — queue an incremental re-replay to this sender
    // (streamed by advance_replays, same as the connect path).
    println("single-port: [snapshot req] cells={len(world.cells)}");
    queue_replay(world, sender);
  }
}

// Drain all pending messages on every active client.  Drops clients
// whose send/recv suggests a closed socket.  Returns the number of
// messages processed this sweep (caller uses it to decide whether to
// idle-sleep).
fn poll_clients(world: World) -> integer {
  processed = 0;
  for c in world.clients {
    if !c.active { continue; }
    while true {
      msg = c.ws.next();
      if msg == null { break; }
      // Parse "<msg_id>:<payload>"
      colon = msg.find(":");
      if colon == null {
        println("single-port: dropped malformed frame: {msg}");
        continue;
      }
      msg_id  = msg[..colon] as integer;
      payload = msg[colon + 1..];
      handle_message(world, c, msg_id, payload);
      processed = processed + 1;
    }
  }
  processed
}

// Count filled hex neighbours of (x, y) by probing the cell hash for the 6
// adjacent keys.  Mirrors audience_crystal::is_hex_nbr's odd-row offset rule
// (same-row x±1; rows y±1 shift by parity) so server erosion matches the
// renderer's adjacency.  O(6) per cell, not O(N).
fn filled_nbr_count(world: World, x: integer, y: integer) -> integer {
  parity = y - (y / 2) * 2;
  if parity < 0 { parity = parity + 2; }
  n = 0;
  if world.cells[cell_key(x - 1, y)] != null { n = n + 1; }
  if world.cells[cell_key(x + 1, y)] != null { n = n + 1; }
  if parity == 0 {
    if world.cells[cell_key(x - 1, y - 1)] != null { n = n + 1; }
    if world.cells[cell_key(x,     y - 1)] != null { n = n + 1; }
    if world.cells[cell_key(x - 1, y + 1)] != null { n = n + 1; }
    if world.cells[cell_key(x,     y + 1)] != null { n = n + 1; }
  } else {
    if world.cells[cell_key(x,     y - 1)] != null { n = n + 1; }
    if world.cells[cell_key(x + 1, y - 1)] != null { n = n + 1; }
    if world.cells[cell_key(x,     y + 1)] != null { n = n + 1; }
    if world.cells[cell_key(x + 1, y + 1)] != null { n = n + 1; }
  }
  n
}

// One decay pass.  Removes every cell whose age has passed its neighbour-
// extended lease, broadcasting a removal delta for each.  Neighbour counts
// are read from the pre-removal snapshot so a single sweep peels one edge
// layer; the next sweep re-evaluates with the reduced counts, eroding
// inward.  Expired coords are collected first, then removed, so the hash is
// not mutated mid-iteration.
fn decay_sweep(world: World, base: integer, lease: integer, window: integer) {
  expired: vector<text> = [];
  for cell in world.cells {
    age = world.tick - (cell.birth_tick as integer);
    eff = base + lease * filled_nbr_count(world, cell.x as integer, cell.y as integer);
    if age >= eff + window {
      expired += [cell.ck];
    }
  }
  for k in expired {
    if world.cells[k] != null {
      world.cells[k] = null;
      (rx, ry) = parse_xy(k);    // ck is "x,y" — re-derive for the delta
      broadcast(world, delta_frame(rx, ry, 0));
      world.dirty = true;
    }
  }
}

fn main() {
  srv = server::listen(PORT);
  if srv.handle < 0 {
    println("single-port: FAILED to listen on port {PORT}");
    return;
  }
  println("single-port server: listening on port {PORT}");
  println("  GET /                → audience-demo page");
  println("  GET /ws              → WebSocket (multi-client)");
  println("");
  println("  load on phone (same WiFi):");
  println("    http://<lan-ip>:{PORT}/");
  println("  the page auto-derives ws://<lan-ip>:{PORT}/ws from location.host,");
  println("  so no `?ws=` override is needed.");

  world = World{
    cells: [],
    clients: [],
    dirty: false,
    last_save_us: ticks(),
    tick:         0,         // overwritten by world_load if a v2 snapshot exists
    last_tick_us: ticks(),
    last_active_us: ticks(),
  };
  decay_base   = env_int("DECAY_BASE",   DECAY_BASE_DEFAULT);
  decay_lease  = env_int("DECAY_LEASE",  DECAY_LEASE_DEFAULT);
  decay_window = env_int("DECAY_WINDOW", DECAY_WINDOW_DEFAULT);
  println("single-port: decay base={decay_base} lease/nbr={decay_lease} window={decay_window} (ticks @ 10 Hz)");
  world_load(world);
  world.last_tick_us = ticks();    // reset the cadence clock to "now" after
                                   // load so a tick doesn't fire mid-init

  while true {
    work = 0;

    // 1. Accept new connections (non-blocking).  A2: drain up to
    //    ACCEPT_BUDGET per iteration so a burst of phones is absorbed in a
    //    few passes rather than one-per-iteration.
    accepts = 0;
    while accepts < ACCEPT_BUDGET {
      req = srv.next_nonblocking();
      if req == null { break; }
      accepts = accepts + 1;
      work = work + 1;
      if req.path == "/ws" {
        ws = server::ws_upgrade();
        if ws == null {
          println("single-port: ws_upgrade() failed");
        } else {
          // A1: seed the new client's replay cursor with a snapshot of the
          // current cell keys; the loop streams them via advance_replays
          // instead of dumping the whole world here in the accept path.
          ks: vector<text> = [];
          for cell in world.cells { ks += [cell.ck]; }
          world.clients += [Client{
            ws:     ws,
            active: true,
            color:  0,
            lx:     0,
            ly:     0,
            last_active_tick: 0,
            replay_keys: ks,
            replay_pos:  0,
          }];
          println("single-port: ws client connected — total active={len(world.clients)}, replay={len(ks)} cells queued");
        }
      } else if req.path == "/" || req.path == "/index.html" {
        println("single-port: GET {req.path} → 200 (index.html)");
        req.respond_html(read_index());
      } else {
        println("single-port: GET {req.path} → 404");
        req.respond_404();
      }
    }

    // 2. Poll each WS client for pending messages.
    work = work + poll_clients(world);

    // 2b. A1: stream queued world-replay to any client mid-replay, a
    //     bounded budget at a time (keeps the accept path responsive).
    advance_replays(world);

    // 3. Tick advance — fixed-rate wall clock @ 10 Hz (sub-task 1.4).
    //    Every iteration we check `ticks() - world.last_tick_us` and
    //    advance as many ticks as fit in the elapsed window — so a long
    //    pause catches up rather than dropping ticks silently.  Renderers
    //    read `world.tick - cell.birth_tick` (in 100 ms units) as the
    //    cell's age and scale visual growth from that.  After the clock
    //    turns we run one decay sweep (automatic edge-first erosion).
    now_us = ticks();
    elapsed = now_us - world.last_tick_us;
    if elapsed >= TICK_INTERVAL_US {
      ticks_due = elapsed / TICK_INTERVAL_US;
      world.tick = world.tick + ticks_due;
      world.last_tick_us = world.last_tick_us + ticks_due * TICK_INTERVAL_US;
      // Heartbeat log every 600 ticks (= ~1 min @ 10 Hz) so the loop's
      // liveness is visible without spamming.  Modulo via subtract-
      // and-divide because loft's `%` is integer-only and the wrap
      // shape needs no edge-case handling for u32-bounded ticks.
      cycle = world.tick - (world.tick / 600) * 600;
      if cycle < ticks_due {
        ncells: integer = 0;
        for _ in world.cells { ncells = ncells + 1; }
        println("single-port: [tick] world.tick={world.tick} cells={ncells}");
      }
      // Decay sweep — cheap (O(6N)) and only on a tick boundary.  Removals
      // are rare and edge-first because lifetimes are minutes, so this does
      // not burst the wire.
      decay_sweep(world, decay_base, decay_lease, decay_window);
    }

    // 3b. Active-player heartbeat (sub-task 1.7) — once per second, re-pulse
    //     the most-recently-active painter's cell to all clients so late
    //     joiners / clients that missed the instant delta still get a
    //     "where's the action" hint.  1 Hz was the validated cadence
    //     (01-server-state.md § Active-player signal).
    if ticks() - world.last_active_us >= ACTIVE_HEARTBEAT_US {
      world.last_active_us = ticks();
      best_tick = 0;
      best_x = 0;
      best_y = 0;
      found = false;
      for hb in world.clients {
        if hb.active && hb.last_active_tick > best_tick {
          best_tick = hb.last_active_tick;
          best_x = hb.lx;
          best_y = hb.ly;
          found = true;
        }
      }
      if found {
        broadcast(world, active_frame(best_x, best_y));
      }
    }

    // 4. Persistence — periodic snapshot.  Fires from the main loop
    //    only when (a) state changed since last save, AND (b) at least
    //    SNAPSHOT_INTERVAL_US has elapsed.  A4: skip it on any iteration
    //    that accepted a connection, so a synchronous O(cells) write never
    //    delays a connect during a burst (it just waits for a quiet pass).
    //    Background-thread snapshot is the fuller fix (Tier B).
    if accepts == 0 && world.dirty && ticks() - world.last_save_us > SNAPSHOT_INTERVAL_US {
      world_save(world);
    }

    // 5. Idle yield when no work — keeps CPU low.  2 ms keeps the
    //    accept-loop latency under 5 ms which is well below the user-
    //    perceptible threshold for paint roundtrips.  Also tight
    //    enough that a 100 ms tick window can't drift more than a
    //    couple of ms behind in practice.
    if work == 0 { web::sleep_ms(2); }
  }
}
